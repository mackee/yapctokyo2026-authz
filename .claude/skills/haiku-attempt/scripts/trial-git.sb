;; sandbox-exec profile for running git on an UNTRUSTED trial repo (read-only).
;; Params: HOME, R (trial dir; readable), W (scratch; the only writable place).
(version 1)
(allow default)
(deny network*)
(deny file-read* (subpath (param "HOME")))
(allow file-read* (subpath (param "R")))
(deny file-write*)
(allow file-write* (subpath (param "W")) (literal "/dev/null"))
(deny appleevent-send)
(deny mach-lookup
  (global-name "com.apple.coreservices.launchservicesd")
  (global-name "com.apple.lsd.mapdb") (global-name "com.apple.lsd.modifydb")
  (global-name-prefix "com.apple.pasteboard")
  (global-name "com.apple.securityd.xpc") (global-name "com.apple.SecurityServer"))
;; exec is deny-by-default: only the git binary and its own helpers may run, so a
;; planted filter/diff driver/hook/fsmonitor cannot even start.
(deny process-exec)
(allow process-exec
  (literal (param "GIT"))
  (subpath "/Library/Developer/CommandLineTools/usr/libexec/git-core"))
