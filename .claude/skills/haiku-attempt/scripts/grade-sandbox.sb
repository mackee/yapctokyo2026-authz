;; sandbox-exec profile for running untrusted submission code (go build/vet/test).
;; Params: HOME (user home), W (per-run work dir; the only writable place).
;; Base is allow-default (the Go toolchain needs broad system reads); the rules below
;; remove network, $HOME reads, writes outside W, and the IPC/exec paths that could
;; hand work to an unsandboxed process (LaunchServices, Apple Events, pasteboard).
(version 1)
(allow default)
(deny network*)
(allow network* (local unix-socket))
(deny file-read* (subpath (param "HOME")))
(deny file-read* (regex #"^/private/tmp/grade\."))
(allow file-read* (subpath (param "W")))
(deny signal)
(allow signal (target same-sandbox))
(deny file-write*)
(allow file-write*
  (subpath (param "W"))
  (literal "/dev/null") (literal "/dev/tty") (regex #"^/dev/fd/"))
(deny appleevent-send)
(deny mach-lookup
  (global-name "com.apple.coreservices.launchservicesd")
  (global-name "com.apple.coreservices.quarantine-resolver")
  (global-name "com.apple.lsd.mapdb")
  (global-name "com.apple.lsd.modifydb")
  (global-name-prefix "com.apple.pasteboard")
  (global-name "com.apple.windowserver.active")
  (global-name "com.apple.securityd.xpc")
  (global-name "com.apple.SecurityServer"))
(deny process-exec
  (literal "/usr/bin/open") (literal "/usr/bin/osascript")
  (literal "/usr/bin/pbcopy") (literal "/usr/bin/pbpaste")
  (literal "/usr/bin/security") (literal "/bin/launchctl"))
