+func TestSetMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, project, target, role string
+		want                              int
+	}{
+		{"manager demotes contributor", "ann", "web", "ben", "viewer", 200},
+		{"manager promotes viewer", "ann", "web", "dan", "contributor", 200},
+		{"manager promotes to manager", "ann", "web", "cat", "manager", 200},
+		{"contributor caller", "ben", "web", "cat", "viewer", 403},
+		{"viewer caller", "dan", "web", "ben", "viewer", 403},
+		{"org admin caller", "eve", "web", "ben", "viewer", 403},
+		{"non member caller", "hal", "web", "ben", "viewer", 404},
+		{"other org caller", "gus", "web", "ben", "viewer", 404},
+		{"anonymous", "", "web", "ben", "viewer", 401},
+		{"unknown user", "zed", "web", "ben", "viewer", 401},
+		{"target not a member", "ann", "web", "hal", "viewer", 404},
+		{"target member of other project only", "ann", "web", "gus", "viewer", 404},
+		{"missing project", "ann", "missing", "ben", "viewer", 404},
+		{"archived", "ann", "legacy", "ben", "viewer", 409},
+		{"unknown role", "ann", "web", "ben", "boss", 400},
+		{"empty role", "ann", "web", "ben", "", 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members/"+c.target, c.user, `{"role":"`+c.role+`"}`)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMemberRoleResponseAndAssignees(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+	var got memberResponse
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.UserID != "ben" || got.Role != "viewer" {
+		t.Fatalf("body %s", body)
+	}
+
+	// ben's task in web is unassigned; cat's task in web and ben's task in legacy are untouched.
+	assignee := func(path string) string {
+		t.Helper()
+		code, body := do(t, h, "GET", path, "ann", "")
+		if code != 200 {
+			t.Fatalf("GET %s: got %d", path, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		return task.Assignee
+	}
+	if a := assignee("/projects/web/tasks/t1"); a != "" {
+		t.Fatalf("t1 assignee %q, want unassigned", a)
+	}
+	if a := assignee("/projects/web/tasks/t2"); a != "cat" {
+		t.Fatalf("t2 assignee %q, want cat", a)
+	}
+	if a := assignee("/projects/legacy/tasks/t5"); a != "ben" {
+		t.Fatalf("t5 assignee %q, want ben", a)
+	}
+
+	// As a viewer, ben can no longer write.
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 403 {
+		t.Fatalf("viewer PATCH got %d want 403", code)
+	}
+}
