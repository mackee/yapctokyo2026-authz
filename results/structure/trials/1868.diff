--- /dev/null
+++ b/freeze.go
@@ -0,0 +1,89 @@
+package main
+
+import "net/http"
+
+// freezeProject turns every member of the project (managers included) into a
+// viewer, so nobody can change its tasks any more. Only a manager may do it.
+// Because assignees must be contributors or managers, all tasks of the project
+// are unassigned as part of the same transaction.
+func (s *server) freezeProject(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role, err := findRole(ctx, s.db, project.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+	if _, err := tx.ExecContext(ctx, `UPDATE memberships SET role = ? WHERE project_id = ?`, RoleViewer, project.ID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if _, err := tx.ExecContext(ctx, `UPDATE tasks SET assignee = '' WHERE project_id = ?`, project.ID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	rows, err := tx.QueryContext(ctx, `SELECT user_id, role FROM memberships WHERE project_id = ? ORDER BY user_id`, project.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer rows.Close()
+	type memberOut struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	members := []memberOut{}
+	for rows.Next() {
+		var m memberOut
+		if err := rows.Scan(&m.UserID, &m.Role); err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+		members = append(members, m)
+	}
+	if err := rows.Err(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	rows.Close()
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, members)
+}
diff --git a/freeze_test.go b/freeze_test.go
new file mode 100644
index 0000000..b7a6b25
--- /dev/null
+++ b/freeze_test.go
@@ -0,0 +1,138 @@
+package main
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+type member struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func TestFreezeReturnsAllMembersAsViewers(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]bool{"ann": true, "ben": true, "cat": true, "dan": true, "ivy": true}
+	if len(got) != len(want) {
+		t.Fatalf("want %d members, got %v", len(want), got)
+	}
+	for _, m := range got {
+		if !want[m.UserID] || m.Role != "viewer" {
+			t.Fatalf("unexpected member %+v", m)
+		}
+	}
+	if !strings.Contains(body, `"userId"`) || !strings.Contains(body, `"role":"viewer"`) {
+		t.Fatalf("bad JSON shape: %s", body)
+	}
+}
+
+func TestFreezeDoesNotTouchOtherProjects(t *testing.T) {
+	h := newServer()
+	do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	// ops is unaffected: cat is still a contributor and may edit her own task.
+	code, _ := do(t, h, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"doing"}`)
+	if code != 200 {
+		t.Fatalf("ops should be unaffected, got %d", code)
+	}
+}
+
+func TestFreezeBlocksAllTaskWrites(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: %d %s", code, body)
+	}
+	cases := []struct {
+		name, method, path, user, body string
+	}{
+		{"manager creates", "POST", "/projects/web/tasks", "ann", `{"title":"x"}`},
+		{"other manager creates", "POST", "/projects/web/tasks", "ivy", `{"title":"x"}`},
+		{"contributor creates", "POST", "/projects/web/tasks", "ben", `{"title":"x"}`},
+		{"manager updates", "PATCH", "/projects/web/tasks/t1", "ann", `{"status":"done"}`},
+		{"contributor updates own", "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`},
+		{"manager deletes", "DELETE", "/projects/web/tasks/t1", "ann", ""},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, h, c.method, c.path, c.user, c.body)
+			if code != 403 {
+				t.Fatalf("got %d want 403", code)
+			}
+		})
+	}
+	// Reads still work.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("read after freeze: %d", code)
+	}
+}
+
+func TestFreezeUnassignsTasks(t *testing.T) {
+	// Nobody is a contributor/manager any more, so no task may stay assigned
+	// (do() also checks the model rules after the request).
+	h := newServer()
+	do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	_, body := do(t, h, "GET", "/projects/web/tasks", "ann", "")
+	var tasks []Task
+	json.Unmarshal([]byte(body), &tasks)
+	if len(tasks) != 3 {
+		t.Fatalf("tasks must be kept, got %d", len(tasks))
+	}
+	for _, task := range tasks {
+		if task.Assignee != "" {
+			t.Fatalf("task %s still assigned to %s", task.ID, task.Assignee)
+		}
+	}
+}
+
+func TestFreezeIsIdempotent(t *testing.T) {
+	h := newServer()
+	do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	// ann is now a viewer, so a second freeze by her is forbidden, not a crash.
+	code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 403 {
+		t.Fatalf("got %d want 403", code)
+	}
+}
+
+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ivy", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"missing project", "ann", "nope", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeDeniedChangesNothing(t *testing.T) {
+	h := newServer()
+	do(t, h, "POST", "/projects/web/freeze", "ben", "")
+	code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`)
+	if code != 200 {
+		t.Fatalf("denied freeze must not change roles, got %d", code)
+	}
+}
