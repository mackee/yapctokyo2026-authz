+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"other manager", "ivy", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+		{"missing project", "ann", "nope", 404},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResponse(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var members []struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &members); err != nil {
+		t.Fatal(err)
+	}
+	got := map[string]string{}
+	for _, m := range members {
+		got[m.UserID] = m.Role
+	}
+	want := map[string]string{"ann": "viewer", "ben": "viewer", "cat": "viewer", "dan": "viewer", "ivy": "viewer"}
+	if len(members) != len(want) || len(got) != len(want) {
+		t.Fatalf("want %d members, got %s", len(want), body)
+	}
+	for u, r := range want {
+		if got[u] != r {
+			t.Fatalf("member %s: got %q want %q", u, got[u], r)
+		}
+	}
+}
+
+func TestFreezeBlocksWrites(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: %d", code)
+	}
+	writes := []struct {
+		name, user, method, path, body string
+	}{
+		{"manager create", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"manager update", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"manager delete", "ann", "DELETE", "/projects/web/tasks/t2", ""},
+		{"other manager update", "ivy", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"contributor create", "ben", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"contributor update own", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"freeze again", "ann", "POST", "/projects/web/freeze", ""},
+	}
+	for _, w := range writes {
+		if code, _ := do(t, h, w.method, w.path, w.user, w.body); code != 403 {
+			t.Errorf("%s: got %d want 403", w.name, code)
+		}
+	}
+	// Reads still work, and the tasks are untouched.
+	code, body := do(t, h, "GET", "/projects/web/tasks", "ann", "")
+	if code != 200 {
+		t.Fatalf("list: %d", code)
+	}
+	var tasks []Task
+	json.Unmarshal([]byte(body), &tasks)
+	if len(tasks) != 3 {
+		t.Fatalf("want 3 tasks, got %d", len(tasks))
+	}
+	for _, task := range tasks {
+		if task.ID == "t1" && task.Status != "open" || task.ID == "t2" && task.Status != "doing" {
+			t.Fatalf("task %s was modified: %+v", task.ID, task)
+		}
+	}
+}
