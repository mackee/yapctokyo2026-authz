+
+// removeOrgUser takes uid out of every project of org oid (offboarding). Tasks
+// uid was assigned to in those projects become unassigned, so no assignee is left
+// without a role in its project.
+func (s *server) removeOrgUser(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	orgID := r.PathValue("oid")
+	if orgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	if !user.OrgAdmin {
+		writeError(w, 403, "only org admins may remove users from the organization")
+		return
+	}
+	target, err := findUser(ctx, s.db, r.PathValue("uid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if target == nil || target.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+	const orgProjects = `SELECT id FROM projects WHERE org_id = ?`
+	if _, err := tx.ExecContext(ctx, `UPDATE tasks SET assignee = '' WHERE assignee = ? AND project_id IN (`+orgProjects+`)`,
+		target.ID, orgID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if _, err := tx.ExecContext(ctx, `DELETE FROM memberships WHERE user_id = ? AND project_id IN (`+orgProjects+`)`,
+		target.ID, orgID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	w.WriteHeader(204)
+}
diff --git a/orgs_test.go b/orgs_test.go
new file mode 100644
index 0000000..1a4e5f5
--- /dev/null
+++ b/orgs_test.go
@@ -0,0 +1,94 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+// DELETE /orgs/{orgID}/users/{uid} removes uid from every project of the org.
+// Only an org admin of that org may call it.
+
+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes user without memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"manager is not an org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"viewer is not an org admin", "dan", "/orgs/acme/users/ben", 403},
+		{"user of another org", "gus", "/orgs/acme/users/ben", 404},
+		{"org admin asks about another org", "eve", "/orgs/globex/users/gus", 404},
+		{"target belongs to another org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserRemovesAccess(t *testing.T) {
+	h := newServer()
+
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+
+	// ben is gone from web and from the archived legacy project alike.
+	for _, path := range []string{"/projects/web/tasks", "/projects/web/tasks/t1", "/projects/legacy/tasks", "/projects/legacy/tasks/t5"} {
+		if code, _ := do(t, h, "GET", path, "ben", ""); code != 404 {
+			t.Errorf("ben GET %s: got %d want 404", path, code)
+		}
+	}
+	// ...and can no longer write anywhere.
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 404 {
+		t.Errorf("ben PATCH t1: got %d want 404", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 404 {
+		t.Errorf("ben POST task: got %d want 404", code)
+	}
+
+	// Tasks ben was assigned to are unassigned; their other fields are untouched.
+	for _, c := range []struct{ path, title, status string }{
+		{"/projects/web/tasks/t1", "Fix header", "open"},
+		{"/projects/legacy/tasks/t5", "Old bug", "open"},
+	} {
+		code, body := do(t, h, "GET", c.path, "eve", "")
+		if code != 200 {
+			t.Fatalf("eve GET %s: got %d want 200", c.path, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.Assignee != "" || task.Title != c.title || task.Status != c.status {
+			t.Errorf("%s: got %+v, want assignee unset, title %q, status %q", c.path, task, c.title, c.status)
+		}
+	}
+
+	// Other members keep their access and their assignments.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Errorf("cat GET web tasks: got %d want 200", code)
+	}
+	code, body := do(t, h, "GET", "/projects/web/tasks/t2", "eve", "")
+	if code != 200 {
+		t.Fatalf("eve GET t2: got %d want 200", code)
+	}
+	var t2 Task
+	json.Unmarshal([]byte(body), &t2)
+	if t2.Assignee != "cat" {
+		t.Errorf("t2 assignee: got %q want %q", t2.Assignee, "cat")
+	}
+
+	// Removing the same user again is harmless.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Errorf("second remove: got %d want 204", code)
+	}
+}
