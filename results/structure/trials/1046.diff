+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"contributor other's task", "ben", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 403},
+		{"viewer", "dan", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"org admin", "eve", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 403},
+		{"non member source", "hal", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 401},
+		{"cross project id", "ivy", "/projects/ops/tasks/t1", `{"toProjectId":"web"}`, 404},
+		{"target other org", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"gx"}`, 404},
+		{"target not member", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"legacy"}`, 404},
+		{"target unknown", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"nope"}`, 404},
+		{"target viewer", "ann", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"target archived", "ann", "/projects/web/tasks/t1", `{"toProjectId":"legacy"}`, 409},
+		{"source archived", "ann", "/projects/legacy/tasks/t5", `{"toProjectId":"web"}`, 409},
+		{"assignee not in target", "ivy", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 400},
+		{"same project", "ann", "/projects/web/tasks/t1", `{"toProjectId":"web"}`, 400},
+		{"empty body", "ivy", "/projects/web/tasks/t1", `{}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+// A move keeps the task's ID, title, status and assignee, and changes only its project.
+func TestMoveKeepsTask(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d body=%s", code, body)
+	}
+	var moved Task
+	if err := json.Unmarshal([]byte(body), &moved); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", AssigneeID: "cat"}
+	if moved != want {
+		t.Fatalf("moved task = %+v, want %+v", moved, want)
+	}
+
+	code, body = do(t, h, "GET", "/projects/ops/tasks/t2", "ivy", "")
+	if code != 200 {
+		t.Fatalf("get in target: got %d body=%s", code, body)
+	}
+	code, _ = do(t, h, "GET", "/projects/web/tasks/t2", "ivy", "")
+	if code != 404 {
+		t.Fatalf("get in source: got %d want 404", code)
+	}
+}
+
+// A refused move changes nothing.
+func TestMoveRefusedLeavesTask(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/tasks/t1/move", "ivy", `{"toProjectId":"ops"}`); code != 400 {
+		t.Fatalf("move: got %d want 400", code)
+	}
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ivy", "")
+	if code != 200 {
+		t.Fatalf("task after refused move: got %d body=%s", code, body)
+	}
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.ProjectID != "web" || task.AssigneeID != "ben" {
+		t.Fatalf("task changed by refused move: %+v", task)
+	}
+}
