+// ---- operations -----------------------------------------------------------------------
+
+// RemoveFromOrg removes the user from every project of the organization (for
+// example when the user leaves the company), all or nothing. It deletes the
+// user's memberships in those projects; the user's tasks are not changed.
+// Only org admins may do it (else ErrForbidden). The user must belong to the
+// organization (else ErrNotFound). Removing a user who is in none of the
+// organization's projects succeeds and changes nothing.
+func (*UserTable) RemoveFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanManageUsers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveOrgUser(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
