+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+
+	// Before: ben is a contributor in web and legacy (archived), in acme.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 200 {
+		t.Fatalf("before: ben creates in web: got %d want 200", code)
+	}
+
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove ben: got %d want 204", code)
+	}
+	// Removing again changes nothing and still succeeds.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove ben again: got %d want 204", code)
+	}
+
+	// After: ben is in no project of acme, so no project of acme is readable to ben.
+	for _, p := range []string{"/projects/web/tasks", "/projects/legacy/tasks/t5"} {
+		if code, _ := do(t, h, "GET", p, "ben", ""); code != 404 {
+			t.Fatalf("after: ben GET %s: got %d want 404", p, code)
+		}
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 404 {
+		t.Fatalf("after: ben creates in web: got %d want 404", code)
+	}
+
+	// Other members are untouched.
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "cat", ""); code != 200 {
+		t.Fatalf("after: cat still reads ops: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatalf("after: gus still reads gx: got %d want 200", code)
+	}
+
+	// Ben's tasks are not changed by the removal (they stay assigned to ben).
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "eve", "")
+	if code != 200 || !strings.Contains(body, `"assignee":"ben"`) {
+		t.Fatalf("after: t1 got %d body=%s, want 200 still assigned to ben", code, body)
+	}
+}
