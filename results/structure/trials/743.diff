+		{"manager of the org's projects", "ann", "/orgs/acme/users/ben", 403},
+		{"plain member", "hal", "/orgs/acme/users/ben", 403},
+		{"org admin of other org", "gus", "/orgs/acme/users/ben", 404},
+		{"other org's user", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ben", 404},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
