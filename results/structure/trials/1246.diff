+			t.Fatalf("got %v want %v", got, want)
+		}
+	}
+}
+
+func TestMoveMemberEffects(t *testing.T) {
+	srv := newServer()
+
+	// ben is a contributor in web and holds t1 there.
+	if code, body := do(t, srv, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`); code != 200 {
+		t.Fatalf("move: got %d: %s", code, body)
+	}
+
+	// ben left web: no access to it.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("old project read: got %d want 404", code)
+	}
+	// ben joined ops with his role: he can read and write there.
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+		t.Fatalf("new project read: got %d want 200", code)
+	}
+	if code, body := do(t, srv, "POST", "/projects/ops/tasks", "ben", `{"title":"x","assignee":"ben"}`); code != 200 {
+		t.Fatalf("new project create: got %d: %s", code, body)
+	}
+
+	// t1 was ben's task in web; it is unassigned now and still in web.
+	code, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("get t1: got %d: %s", code, body)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "" || task.ProjectID != "web" {
+		t.Fatalf("t1 after move: %+v, want unassigned in web", task)
+	}
+
+	// Other tasks of ops are untouched.
+	code, body = do(t, srv, "GET", "/projects/ops/tasks/t4", "cat", "")
+	if code != 200 {
+		t.Fatalf("get t4: got %d: %s", code, body)
+	}
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "cat" {
+		t.Fatalf("t4 assignee %q, want cat", task.AssigneeID)
+	}
+
+	// ben can move back from ops to web, and then he is no longer in ops.
+	if code, body := do(t, srv, "POST", "/projects/ops/members/ben/move", "ivy", `{"toProjectId":"web"}`); code != 200 {
+		t.Fatalf("move back: got %d: %s", code, body)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ops read after move back: got %d want 404", code)
+	}
+}
