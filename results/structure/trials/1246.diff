+// Move moves the user from the project of from into the project of to, with
+// the same role. The actor must be a manager of both projects (from and to
+// are built by NewProjectAuthz, so both are readable by the actor). The user's
+// tasks in the source project are unassigned, because an assignee must be a
+// member of the task's project. The change is all or nothing.
+func (mt *MembershipTable) Move(ctx context.Context, db DB, from, to ProjectAuthz, userID string) (*Membership, error) {
+	if err := from.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if err := to.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if from.ProjectID() == to.ProjectID() {
+		return nil, deny(ErrInvalid, "member is already in the destination project")
+	}
+	var moved *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveMember(ctx, tx, from.ProjectID(), to.ProjectID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		moved, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return moved, nil
+}
