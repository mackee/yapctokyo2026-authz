+func moveMember(ctx tanukirpc.Context[*projectRegistry], req moveRequest) (*memberResponse, error) {
+	reg := ctx.Registry()
+	to, err := model.NewProjectAuthz(ctx, reg.db, reg.authz.Actor(), req.ToProjectID)
+	if err != nil {
+		return nil, err
+	}
+	m, err := model.NewMembershipTable().Move(ctx, reg.db, reg.authz, to, chi.URLParam(ctx.Request(), "uid"))
+	if err != nil {
+		return nil, err
+	}
+	return &memberResponse{UserID: m.UserID, ProjectID: m.ProjectID, Role: m.Role}, nil
+}
