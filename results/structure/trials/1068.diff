+// memberJSON is the JSON shape of a project member in the freeze response.
+type memberJSON struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// freezeProject makes every member of the project a viewer and returns the
+// members after the change.
+func freezeProject(ctx tanukirpc.Context[*projectRegistry], _ struct{}) ([]memberJSON, error) {
+	reg := ctx.Registry()
+	members, err := model.NewProjectTable().Freeze(ctx, reg.db, reg.authz)
+	if err != nil {
+		return nil, err
+	}
+	out := make([]memberJSON, 0, len(members))
+	for _, m := range members {
+		out = append(out, memberJSON{UserID: m.UserID, Role: m.Role})
+	}
+	return out, nil
+}
