+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ivy", "ops", 200},
+		{"contributor", "cat", "ops", 403},
+		{"viewer", "ann", "ops", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeMakesProjectReadOnly(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("freeze: got %d body=%s", code, body)
+	}
+	want := `[{"userId":"ann","role":"viewer"},{"userId":"ben","role":"viewer"},{"userId":"cat","role":"viewer"},{"userId":"dan","role":"viewer"},{"userId":"ivy","role":"viewer"}]`
+	if got := strings.TrimSpace(body); got != want {
+		t.Fatalf("freeze body:\n got %s\nwant %s", got, want)
+	}
+
+	// Nobody can change the project's tasks any more, managers included.
+	writes := []struct {
+		name, user, method, path, body string
+	}{
+		{"manager create", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"manager update", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"manager delete", "ann", "DELETE", "/projects/web/tasks/t1", ""},
+		{"contributor update own", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"contributor create", "cat", "POST", "/projects/web/tasks", `{"title":"x"}`},
+	}
+	for _, w := range writes {
+		t.Run(w.name, func(t *testing.T) {
+			code, body := do(t, h, w.method, w.path, w.user, w.body)
+			if code != 403 {
+				t.Fatalf("got %d want 403 body=%s", code, body)
+			}
+		})
+	}
+
+	// Reads still work.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("read after freeze: got %d want 200", code)
+	}
+	// Freezing again is refused: the manager is a viewer now.
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 403 {
+		t.Fatalf("second freeze: got %d want 403", code)
+	}
+	// Other projects are not affected.
+	if code, _ := do(t, h, "POST", "/projects/ops/tasks", "cat", `{"title":"x"}`); code != 200 {
+		t.Fatalf("other project write: got %d want 200", code)
+	}
+}
