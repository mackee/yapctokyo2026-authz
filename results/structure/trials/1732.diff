+// Move moves the task to the project dest, keeping its ID, title, status and
+// assignee. The actor must manage the task in its current project and be able
+// to write in dest.
+func (*TaskTable) Move(ctx context.Context, db DB, authz TaskAuthz, dest ProjectAuthz) (*Task, error) {
+	if err := authz.CanManage(); err != nil {
+		return nil, err
+	}
+	if err := dest.CanWrite(); err != nil {
+		return nil, err
+	}
+	var t *Task
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveTask(ctx, tx, authz.TaskID(), dest.ProjectID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if t, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return t, nil
+}
