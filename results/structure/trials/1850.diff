+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestMoveStatusCodes(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager of both, assignee member of dest", "ivy", "/projects/web/tasks/t2/move", `{"toProjectId":"ops"}`, 200},
+		{"manager of both, unassigned", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 200},
+		{"assignee not a member of dest", "ivy", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 400},
+		{"manager of source but only viewer in dest", "ann", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 403},
+		{"contributor (even own task)", "ben", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer", "dan", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin", "eve", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 403},
+		{"non member of source", "hal", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 404},
+		{"other org user", "gus", "/projects/web/tasks/t1/move", `{"toProjectId":"gx"}`, 404},
+		{"anonymous", "", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 401},
+		{"unknown user", "zed", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 401},
+		{"task in another project", "ivy", "/projects/web/tasks/t4/move", `{"toProjectId":"ops"}`, 404},
+		{"missing task", "ivy", "/projects/web/tasks/t99/move", `{"toProjectId":"ops"}`, 404},
+		{"source archived", "ann", "/projects/legacy/tasks/t5/move", `{"toProjectId":"web"}`, 409},
+		{"dest archived", "ann", "/projects/web/tasks/t3/move", `{"toProjectId":"legacy"}`, 409},
+		{"dest missing", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"nope"}`, 404},
+		{"dest in other org", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"gx"}`, 404},
+		{"dest not visible to user", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"legacy"}`, 404},
+		{"same project", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"web"}`, 400},
+		{"empty toProjectId", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":""}`, 400},
+		{"missing toProjectId", "ivy", "/projects/web/tasks/t3/move", `{}`, 400},
+		{"bad json", "ivy", "/projects/web/tasks/t3/move", `nope`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d (%s)", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestMoveCarriesTaskOver(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d (%s)", code, body)
+	}
+	var moved Task
+	if err := json.Unmarshal([]byte(body), &moved); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", Assignee: "cat"}
+	if moved != want {
+		t.Fatalf("got %+v want %+v", moved, want)
+	}
+
+	// The task now lives in ops, no longer in web.
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks/t2", "ivy", ""); code != 200 {
+		t.Fatalf("task not readable in destination: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t2", "ivy", ""); code != 404 {
+		t.Fatalf("task still readable in source: %d", code)
+	}
+	_, list := do(t, h, "GET", "/projects/web/tasks", "ivy", "")
+	var tasks []Task
+	json.Unmarshal([]byte(list), &tasks)
+	if len(tasks) != 2 {
+		t.Fatalf("source should have 2 tasks left, got %d", len(tasks))
+	}
+}
+
+func TestMoveRejectedLeavesTaskInPlace(t *testing.T) {
+	h := newServer()
+	// ben is not a member of ops, so t1 cannot move there.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks/t1/move", "ivy", `{"toProjectId":"ops"}`); code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ivy", "")
+	if code != 200 {
+		t.Fatalf("task left its project: %d (%s)", code, body)
+	}
+}
