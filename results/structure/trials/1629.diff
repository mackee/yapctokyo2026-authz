+
+func TestFreezeDowngradesAllMembersToViewer(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got []member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("bad body %q: %v", body, err)
+	}
+	// web members: ann (manager), ben, cat (contributors), dan (viewer), ivy (manager)
+	want := []member{
+		{"ann", "viewer"},
+		{"ben", "viewer"},
+		{"cat", "viewer"},
+		{"dan", "viewer"},
+		{"ivy", "viewer"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+}
+
+func TestFreezeRefused(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"missing project", "ann", "nope", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			srv := newServer()
+			code, _ := do(t, srv, "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+			// A refused freeze must not change anyone's role: ann is still a manager.
+			code, _ = do(t, srv, "PATCH", "/projects/web/tasks/t2", "ann", `{"status":"done"}`)
+			if c.project == "web" && code != 200 {
+				t.Fatalf("roles changed by refused freeze: manager update got %d", code)
+			}
+		})
+	}
+}
+
+func TestFreezeBlocksTaskWrites(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze got %d want 200: %s", code, body)
+	}
+	cases := []struct {
+		name, user, method, path, body string
+		want                           int
+	}{
+		{"manager update", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"contributor own update", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`, 403},
+		{"create", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"delete", "ann", "DELETE", "/projects/web/tasks/t1", "", 403},
+		{"read still allowed", "dan", "GET", "/projects/web/tasks/t1", "", 200},
+		{"other project unaffected", "ivy", "PATCH", "/projects/ops/tasks/t4", `{"status":"done"}`, 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, srv, c.method, c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+		})
+	}
+	// Everyone in web is now a viewer, so nobody can freeze it again.
+	if code, _ := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != 403 {
+		t.Fatalf("second freeze got %d want 403", code)
+	}
+}
