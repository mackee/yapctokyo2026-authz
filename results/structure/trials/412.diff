+// Remove removes the user from the project and unassigns the user's tasks in
+// it, all or nothing. Only managers may remove members (else ErrForbidden);
+// an archived project rejects it (ErrArchived); a user who is not a member is
+// ErrNotFound.
+func (*MembershipTable) Remove(ctx context.Context, db DB, authz ProjectAuthz, userID string) error {
+	if err := authz.CanManageMembers(); err != nil {
+		return err
+	}
+	return db.update(ctx, func(x *Tx) error {
+		agg, err := loadRemoveMember(ctx, x, authz.ProjectID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, x)
+	})
+}
