+
+// removeMemberAggregate removes one member from one project. The member's
+// tasks in the project are unassigned in the same transaction, so no task is
+// left assigned to someone who is no longer an assignee-eligible member.
+type removeMemberAggregate struct {
+	membership *Membership
+	assigned   []*Task // the project's tasks assigned to the member
+}
+
+func loadRemoveMember(ctx context.Context, x *Tx, projectID, userID string) (*removeMemberAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, x, projectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	tasks, err := m.AssignedTasks(ctx, x)
+	if err != nil {
+		return nil, err
+	}
+	return &removeMemberAggregate{membership: m, assigned: tasks}, nil
+}
+
+func (a *removeMemberAggregate) validate() error { return nil }
+
+func (a *removeMemberAggregate) apply(ctx context.Context, x *Tx) error {
+	for _, t := range a.assigned {
+		if err := t.unassign(ctx, x); err != nil {
+			return err
+		}
+	}
+	return a.membership.destroy(ctx, x)
+}
