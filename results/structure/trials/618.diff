+func TestUpdateMember(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager changes role", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 200},
+		{"manager promotes", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"demote one of two managers", "ann", "/projects/web/members/ivy", `{"role":"viewer"}`, 200},
+		{"last manager", "ann", "/projects/legacy/members/ann", `{"role":"viewer"}`, 409},
+		{"contributor", "ben", "/projects/web/members/cat", `{"role":"viewer"}`, 403},
+		{"viewer", "dan", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"org admin", "eve", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"non member", "hal", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"other org", "gus", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"anonymous", "", "/projects/web/members/ben", `{"role":"viewer"}`, 401},
+		{"target not member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"invalid role", "ann", "/projects/web/members/ben", `{"role":"boss"}`, 400},
+		{"missing role", "ann", "/projects/web/members/ben", `{}`, 400},
+		{"bad json", "ann", "/projects/web/members/ben", `nope`, 400},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberResponseAndEffects(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got map[string]string
+	json.Unmarshal([]byte(body), &got)
+	if got["userId"] != "ben" || got["role"] != "viewer" {
+		t.Fatalf("bad response %v", got)
+	}
+	// New role takes effect: ben can no longer create tasks.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Fatalf("demoted user create: got %d want 403", code)
+	}
+	// Demoted viewer is unassigned from their tasks (t1 was ben's).
+	_, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" {
+		t.Fatalf("t1 assignee = %q, want unassigned", task.Assignee)
+	}
+	// Other projects are untouched: ben's role in legacy is unchanged.
+	if code, _ := do(t, h, "PATCH", "/projects/legacy/tasks/t5", "ben", `{"status":"done"}`); code != 409 {
+		t.Fatalf("got %d", code)
+	}
+}
