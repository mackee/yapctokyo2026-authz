+// Member is the JSON shape of a project member in the roles response.
+type Member struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+type updateMembersRequest struct {
+	// Roles maps user IDs to roles. A missing/null map and a bad role value are
+	// checked here, before any access decision (400). An empty map is rejected
+	// by UpdateRoles.
+	Roles map[string]string `json:"roles" validate:"required,dive,oneof=manager contributor viewer"`
+}
+
+func updateMembers(ctx tanukirpc.Context[*projectRegistry], req updateMembersRequest) ([]Member, error) {
+	reg := ctx.Registry()
+	ms, err := model.NewMembershipTable().UpdateRoles(ctx, reg.db, reg.authz, model.MembershipTableUpdateRolesInput{Roles: req.Roles})
+	if err != nil {
+		return nil, err
+	}
+	out := make([]Member, 0, len(ms))
+	for _, m := range ms {
+		out = append(out, Member{UserID: m.UserID, Role: m.Role})
+	}
+	return out, nil
+}
