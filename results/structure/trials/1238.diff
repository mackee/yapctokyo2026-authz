diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..bd1407e
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,129 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"reflect"
+	"testing"
+)
+
+// webMembersInitial is the seed membership of "web", ordered by user ID.
+var webMembersInitial = []Member{
+	{"ann", "manager"}, {"ben", "contributor"}, {"cat", "contributor"},
+	{"dan", "viewer"}, {"ivy", "manager"},
+}
+
+func decodeMembers(t *testing.T, body string) []Member {
+	t.Helper()
+	var ms []Member
+	if err := json.Unmarshal([]byte(body), &ms); err != nil {
+		t.Fatalf("decode %q: %v", body, err)
+	}
+	return ms
+}
+
+func TestUpdateMembersResponse(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != http.StatusOK {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	want := []Member{
+		{"ann", "manager"}, {"ben", "viewer"}, {"cat", "contributor"},
+		{"dan", "contributor"}, {"ivy", "manager"},
+	}
+	if got := decodeMembers(t, body); !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+	// The response must have exactly the userId and role keys.
+	var raw []map[string]any
+	if err := json.Unmarshal([]byte(body), &raw); err != nil {
+		t.Fatal(err)
+	}
+	for _, m := range raw {
+		if len(m) != 2 || m["userId"] == nil || m["role"] == nil {
+			t.Fatalf("unexpected member shape: %v", m)
+		}
+	}
+}
+
+func TestUpdateMembersTakesEffect(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`); code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	// ben is now a viewer: cannot write. dan is now a contributor: can write.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Fatalf("ben: got %d want 403", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("dan: got %d want 200", code)
+	}
+}
+
+func TestUpdateMembersCases(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager", "ann", "web", `{"roles":{"ben":"viewer"}}`, 200},
+		{"manager sets own role", "ann", "web", `{"roles":{"ann":"contributor"}}`, 200},
+		{"contributor caller", "ben", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"viewer caller", "dan", "web", `{"roles":{"ben":"viewer"}}`, 403},
+		{"org admin without role", "eve", "web", `{"roles":{"ben":"viewer"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"ben":"viewer"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"ben":"viewer"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"ben":"viewer"}}`, 401},
+		{"unknown user", "zed", "web", `{"roles":{"ben":"viewer"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"invalid role", "ann", "web", `{"roles":{"ben":"owner"}}`, 400},
+		{"empty role", "ann", "web", `{"roles":{"ben":""}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"null roles", "ann", "web", `{"roles":null}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"bad json", "ann", "web", `{"roles":`, 400},
+		{"non member target", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"other org target", "ann", "web", `{"roles":{"gus":"viewer"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+		})
+	}
+}
+
+// A batch with one target that cannot change rejects the whole call, and no
+// role of the batch changes.
+func TestUpdateMembersAllOrNothing(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","hal":"viewer"}}`)
+	if code != 400 {
+		t.Fatalf("got %d want 400: %s", code, body)
+	}
+	// ben is still a contributor, so can still write.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 200 {
+		t.Fatalf("ben: got %d want 200 (role must not have changed)", code)
+	}
+	// hal is still not a member.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "hal", ""); code != 404 {
+		t.Fatalf("hal: got %d want 404", code)
+	}
+}
+
+func TestUpdateMembersListUnchangedOnError(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "PUT", "/projects/web/members", "ben", `{"roles":{"cat":"viewer"}}`); code != 403 {
+		t.Fatalf("got %d want 403", code)
+	}
+	// The member list is unchanged: a read by the manager still shows the seed roles.
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ivy":"manager"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	if got := decodeMembers(t, body); !reflect.DeepEqual(got, webMembersInitial) {
+		t.Fatalf("got %+v want %+v", got, webMembersInitial)
+	}
+}
