+// ---- membership capabilities -----------------------------------------------------
+
+// MemberView is the public representation of a project membership.
+type MemberView struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// MemberScope is bound to one actor, one project ID and one user ID.
+type MemberScope interface {
+	Manage() (ManageMember, error)
+}
+
+// ManageMember may change the project role of one member.
+type ManageMember interface {
+	// SetRole sets the member's role. The role must be manager, contributor or
+	// viewer (else 400).
+	SetRole(role string) (MemberView, error)
+}
+
+type memberScope struct {
+	ps  *projectScope
+	uid string
+}
+
+// Manage applies the membership rule: the project is readable by the actor,
+// the actor is a project manager (else 403; org admins are not managers), the
+// project is not archived (else 409), and the user is a member of the project
+// (else 404). Non-managers get 403 whether or not the target is a member, so
+// they cannot probe the membership list.
+func (s *memberScope) Manage() (ManageMember, error) {
+	err := s.ps.as.a.st.read(func(st *state) error {
+		p, r, err := readable(st, s.ps.as.actor, s.ps.pid)
+		if err != nil {
+			return err
+		}
+		if r != RoleManager {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if p.archived {
+			return deny(ErrArchived, "project is archived")
+		}
+		if st.role(s.ps.pid, s.uid) == "" {
+			return deny(ErrNotFound, "not found")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &manageMember{ms: s}, nil
+}
+
+type manageMember struct{ ms *memberScope }
+
+func (m *manageMember) SetRole(role string) (MemberView, error) {
+	if role != RoleManager && role != RoleContributor && role != RoleViewer {
+		return MemberView{}, deny(ErrInvalid, "invalid role")
+	}
+	var v MemberView
+	err := m.ms.ps.as.a.st.tx(func(s *state) error {
+		pid, uid := m.ms.ps.pid, m.ms.uid
+		if s.role(pid, uid) == "" {
+			return deny(ErrNotFound, "not found")
+		}
+		s.members[pid][uid] = role
+		v = MemberView{UserID: uid, Role: role}
+		return nil
+	})
+	return v, err
+}
