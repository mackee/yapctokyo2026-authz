+// Move moves the member userID out of the authorized project and into
+// toProjectID, keeping the role. The actor must be a manager of both projects.
+// The move runs in a transaction, so a rejected move changes nothing.
+func (*MembershipTable) Move(ctx context.Context, db DB, from ProjectAuthz, userID, toProjectID string) (*Membership, error) {
+	if !from.CanRead() {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	var moved *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveMember(ctx, tx, from.ProjectID(), userID, toProjectID)
+		if err != nil {
+			return err
+		}
+		to, err := NewProjectAuthz(ctx, tx, from.Actor(), toProjectID)
+		if err != nil {
+			return err
+		}
+		if toProjectID == from.ProjectID() {
+			return deny(ErrInvalid, "the destination must be a different project")
+		}
+		if err := from.CanManageMembers(); err != nil {
+			return err
+		}
+		if err := to.CanManageMembers(); err != nil {
+			return err
+		}
+		if from.archived || to.archived {
+			return deny(ErrArchived, "project is archived")
+		}
+		if err := agg.validate(ctx, tx); err != nil {
+			return err
+		}
+		moved, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return moved, nil
+}
