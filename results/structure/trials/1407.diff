+// moveMemberAggregate moves one member from the source project to the
+// destination project with the same role. The member's tasks in the source
+// project are unassigned, so every assignee stays a member of its task's project.
+type moveMemberAggregate struct {
+	from  *Membership // the member in the source project
+	tasks []*Task     // the member's tasks in the source project
+	to    string      // destination project ID
+}
+
+func loadMoveMember(ctx context.Context, tx DB, fromProjectID, userID, toProjectID string) (*moveMemberAggregate, error) {
+	from, err := NewMembershipTable().Find(ctx, tx, fromProjectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	tasks, err := from.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &moveMemberAggregate{from: from, tasks: tasks, to: toProjectID}, nil
+}
+
+func (a *moveMemberAggregate) validate(ctx context.Context, tx DB) error {
+	_, err := NewMembershipTable().Find(ctx, tx, a.to, a.from.UserID)
+	if err == nil {
+		return deny(ErrConflict, "the member is already in the destination project")
+	} else if !errors.Is(err, ErrNoRows) {
+		return err
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.from.remove(ctx, tx); err != nil {
+		return nil, err
+	}
+	to := &Membership{ProjectID: a.to, UserID: a.from.UserID, Role: a.from.Role}
+	if err := to.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return to, nil
+}
