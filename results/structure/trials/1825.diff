+// ---- operations -----------------------------------------------------------------------
+
+// RemoveFromOrg removes the user from every project of the authorization
+// object's organization, all or nothing. The tasks the user is assigned to in
+// those projects are unassigned. The user row itself is kept.
+func (*UserTable) RemoveFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanManageMembers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveOrgUser(ctx, tx, authz.Org(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
