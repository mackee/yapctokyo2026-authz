@@ -0,0 +1,85 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+// DELETE /orgs/{orgID}/users/{uid} removes the user from every project of the
+// organization (offboarding). Only an org admin of that organization may do it.
+func TestDeleteOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes user without projects", "eve", "/orgs/acme/users/hal", 204},
+		{"org member is not admin", "ann", "/orgs/acme/users/ben", 403},
+		{"contributor is not admin", "ben", "/orgs/acme/users/cat", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown actor", "zed", "/orgs/acme/users/ben", 401},
+		{"actor in other org", "gus", "/orgs/acme/users/ben", 404},
+		{"organization is not the actor's", "eve", "/orgs/globex/users/gus", 404},
+		{"user in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+// After the removal, the user has no access to the organization's projects,
+// the tasks assigned to the user in those projects are unassigned, and other
+// members are unchanged.
+func TestDeleteOrgUserRemovesAccess(t *testing.T) {
+	h := newServer()
+
+	if code, body := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("delete: got %d %s", code, body)
+	}
+
+	for _, path := range []string{"/projects/web/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, h, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("ben GET %s: got %d want 404", path, code)
+		}
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 404 {
+		t.Fatalf("ben PATCH t1: got %d want 404", code)
+	}
+
+	// t1 (web) and t5 (legacy) were assigned to ben.
+	for _, path := range []string{"/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		code, body := do(t, h, "GET", path, "ann", "")
+		if code != 200 {
+			t.Fatalf("ann GET %s: got %d", path, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.AssigneeID != "" {
+			t.Fatalf("%s: still assigned to %q", path, task.AssigneeID)
+		}
+	}
+
+	// cat's assignment in web is untouched, and ivy (manager of web) still writes there.
+	if code, body := do(t, h, "GET", "/projects/web/tasks/t2", "ann", ""); code != 200 {
+		t.Fatalf("ann GET t2: got %d", code)
+	} else {
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.AssigneeID != "cat" {
+			t.Fatalf("t2: assignee %q, want cat", task.AssigneeID)
+		}
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ivy", `{"title":"x"}`); code != 200 {
+		t.Fatalf("ivy POST web/tasks: got %d want 200", code)
+	}
+}
