+// ---- org scopes ---------------------------------------------------------------
+
+// OrgScope is bound to one actor and one organization ID.
+type OrgScope interface {
+	ID() string
+	// Admin acquires the org-admin capability for this organization.
+	Admin() (AdminOrg, error)
+}
+
+// AdminOrg may manage the users of one organization.
+type AdminOrg interface {
+	ID() string
+	// Transfer moves a user of this organization to toOrgID. The user's project
+	// memberships outside toOrgID are removed and their task assignments in those
+	// projects are cleared, all in the same commit. The user loses org-admin
+	// rights. Unknown user or target org, or a target equal to the current org,
+	// is rejected.
+	Transfer(userID, toOrgID string) (UserView, error)
+}
+
+type orgScope struct {
+	as  *actorScope
+	oid string
+}
+
+func (s *orgScope) ID() string { return s.oid }
+
+// Admin applies the org-admin rule: the organization must be the actor's own
+// (else 404, like other-org projects), and the actor must be its org admin
+// (else 403).
+func (s *orgScope) Admin() (AdminOrg, error) {
+	err := s.as.a.st.read(func(st *state) error {
+		if s.oid != s.as.actor.org || !st.orgs[s.oid] {
+			return deny(ErrNotFound, "not found")
+		}
+		if !s.as.actor.orgAdmin {
+			return deny(ErrForbidden, "forbidden")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &adminOrg{os: s}, nil
+}
+
+type adminOrg struct{ os *orgScope }
+
+func (o *adminOrg) ID() string { return o.os.oid }
+
+func (o *adminOrg) Transfer(userID, toOrgID string) (UserView, error) {
+	if toOrgID == "" {
+		return UserView{}, deny(ErrInvalid, "toOrgId is required")
+	}
+	var v UserView
+	err := o.os.as.a.st.tx(func(s *state) error {
+		if !s.orgs[toOrgID] {
+			return deny(ErrInvalid, "unknown target organization")
+		}
+		if toOrgID == o.os.oid {
+			return deny(ErrInvalid, "user is already in that organization")
+		}
+		u, ok := s.users[userID]
+		if !ok || u.org != o.os.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		u.org = toOrgID
+		u.orgAdmin = false
+		s.users[userID] = u
+
+		// Memberships are only valid within the member's organization.
+		for pid, m := range s.members {
+			if s.projects[pid].org != toOrgID {
+				delete(m, userID)
+			}
+		}
+		// Clear assignments the user no longer holds a writer role for.
+		for id, t := range s.tasks {
+			if t.assignee.user == userID && !isWriterRole(s.role(t.project, userID)) {
+				t.assignee = Assignee{project: t.project}
+				s.tasks[id] = t
+			}
+		}
+		v = UserView{ID: u.id, OrgID: u.org}
+		return nil
+	})
+	return v, err
+}
