+func TestTransfer(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 200},
+		{"manager is not org admin", "ann", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 403},
+		{"contributor", "ben", "/orgs/acme/users/cat/transfer", `{"toOrgId":"globex"}`, 403},
+		{"anonymous", "", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 401},
+		{"admin of other org", "gus", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 404},
+		{"admin path is other org", "eve", "/orgs/globex/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"user not in org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"globex"}`, 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"unknown target org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"initech"}`, 400},
+		{"same org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"acme"}`, 400},
+		{"missing toOrgId", "eve", "/orgs/acme/users/ben/transfer", `{}`, 400},
+		{"malformed body", "eve", "/orgs/acme/users/ben/transfer", `not json`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferResponseBody(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatal(code)
+	}
+	var u User
+	if err := json.Unmarshal([]byte(body), &u); err != nil {
+		t.Fatal(err)
+	}
+	if u.ID != "ben" || u.OrgID != "globex" {
+		t.Fatalf("got %+v", u)
+	}
+	if !strings.Contains(body, `"id":"ben"`) || !strings.Contains(body, `"orgId":"globex"`) {
+		t.Fatalf("unexpected body %s", body)
+	}
+}
+
+func TestTransferEffects(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: %d %s", code, body)
+	}
+
+	// The transferred user loses access to the old org's projects.
+	for _, path := range []string{"/projects/web/tasks", "/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		if code, _ := do(t, h, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("GET %s as ben: got %d want 404", path, code)
+		}
+	}
+	// ...and gains nothing in the new org beyond what it was granted there.
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "ben", ""); code != 404 {
+		t.Fatalf("GET gx as ben: got %d want 404", code)
+	}
+
+	// Task assignments to the transferred user are cleared; others are kept.
+	tasks := listAs(t, h, "ann", "/projects/web/tasks")
+	if tasks["t1"] != "" {
+		t.Fatalf("t1 still assigned to %q", tasks["t1"])
+	}
+	if tasks["t2"] != "cat" {
+		t.Fatalf("t2 assignee changed to %q", tasks["t2"])
+	}
+	if legacy := listAs(t, h, "ann", "/projects/legacy/tasks"); legacy["t5"] != "" {
+		t.Fatalf("t5 still assigned to %q", legacy["t5"])
+	}
+
+	// The transferred user is no longer a member of acme, so cannot transfer
+	// others out of it, and cannot be transferred again from it.
+	if code, _ := do(t, h, "POST", "/orgs/acme/users/cat/transfer", "ben", `{"toOrgId":"globex"}`); code != 404 {
+		t.Fatalf("ben transferring cat: got %d want 404", code)
+	}
+	if code, _ := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 404 {
+		t.Fatalf("second transfer of ben: got %d want 404", code)
+	}
+
+	// Other members of the old org are unaffected.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "cat", `{"title":"x"}`); code != 201 {
+		t.Fatalf("cat create in web: got %d want 201", code)
+	}
+}
+
+// listAs returns the task ID -> assignee map for a project listing.
+func listAs(t *testing.T, h http.Handler, user, path string) map[string]string {
+	t.Helper()
+	code, body := do(t, h, "GET", path, user, "")
+	if code != 200 {
+		t.Fatalf("GET %s as %s: %d", path, user, code)
+	}
+	var tasks []Task
+	if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+		t.Fatal(err)
+	}
+	out := map[string]string{}
+	for _, task := range tasks {
+		out[task.ID] = task.Assignee
+	}
+	return out
+}
