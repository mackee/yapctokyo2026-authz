+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"anonymous", "", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 401},
+		{"non member source", "hal", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 404},
+		{"viewer source", "dan", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin", "eve", "/projects/ops/tasks/t4/move", `{"toProjectId":"web"}`, 403},
+		{"contributor others' task", "cat", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer target", "ann", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"contributor not member of target", "ben", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 404},
+		{"target in other org", "ann", "/projects/web/tasks/t1/move", `{"toProjectId":"gx"}`, 404},
+		{"target missing", "ann", "/projects/web/tasks/t1/move", `{"toProjectId":"nope"}`, 404},
+		{"task in other project", "ann", "/projects/web/tasks/t4/move", `{"toProjectId":"legacy"}`, 404},
+		{"archived source", "ann", "/projects/legacy/tasks/t5/move", `{"toProjectId":"web"}`, 409},
+		{"archived target", "ann", "/projects/web/tasks/t1/move", `{"toProjectId":"legacy"}`, 409},
+		{"same project", "ann", "/projects/web/tasks/t1/move", `{"toProjectId":"web"}`, 400},
+		{"missing target", "ann", "/projects/web/tasks/t1/move", `{}`, 400},
+		{"bad body", "ann", "/projects/web/tasks/t1/move", `not json`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsTaskAndChangesProject(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/tasks/t1/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t1", ProjectID: "ops", Title: "Fix header", Status: "open", Assignee: "ben"}
+	if task != want {
+		t.Fatalf("got %+v want %+v", task, want)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t1", "ann", ""); code != 404 {
+		t.Fatalf("task still in source project: got %d", code)
+	}
+	// ann is a viewer of ops, so she can read the task there.
+	code, body = do(t, h, "GET", "/projects/ops/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("task not in target project: got %d body=%s", code, body)
+	}
+}
