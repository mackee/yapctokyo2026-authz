+type moveRequest struct {
+	ToProjectID string `json:"toProjectId"`
+}
+
+// moveTask moves a task from the path project to toProjectId. The task keeps
+// its ID, title, status and assignee.
+func (s *server) moveTask(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	src, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if src == nil || src.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	srcRole, err := findRole(ctx, s.db, src.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if srcRole == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	task, err := findTask(ctx, s.db, r.PathValue("tid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if task == nil || task.ProjectID != src.ID {
+		writeError(w, 404, "not found")
+		return
+	}
+	if srcRole != RoleManager && srcRole != RoleContributor {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if src.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req moveRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || req.ToProjectID == "" {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	if req.ToProjectID == src.ID {
+		writeError(w, 400, "task is already in that project")
+		return
+	}
+	dst, err := findProject(ctx, s.db, req.ToProjectID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if dst == nil || dst.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	dstRole, err := findRole(ctx, s.db, dst.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if dstRole == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if dstRole != RoleManager && dstRole != RoleContributor {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if !(srcRole == RoleManager && dstRole == RoleManager) && task.Assignee != user.ID {
+		writeError(w, 403, "may only move tasks assigned to yourself unless you are a manager of both projects")
+		return
+	}
+	if dst.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	res, err := s.db.ExecContext(ctx, `UPDATE tasks SET project_id = ? WHERE id = ? AND project_id = ?`,
+		dst.ID, task.ID, src.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	n, err := res.RowsAffected()
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if n == 0 {
+		// The task left the source project between the lookup and the update.
+		writeError(w, 404, "not found")
+		return
+	}
+	task.ProjectID = dst.ID
+	writeJSON(w, 200, task)
+}
