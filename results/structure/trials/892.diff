+// updateMemberRoleAggregate changes the role of one project member.
+type updateMemberRoleAggregate struct {
+	membership *Membership
+	role       string
+	assigned   []*Task // the member's tasks in the project, loaded for the viewer rule
+}
+
+func loadUpdateMemberRole(ctx context.Context, tx DB, projectID, userID, role string) (*updateMemberRoleAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &updateMemberRoleAggregate{membership: m, role: role}
+	if role == RoleViewer {
+		a.assigned, err = m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+	}
+	return a, nil
+}
+
+func (a *updateMemberRoleAggregate) validate() error {
+	if a.role != RoleManager && a.role != RoleContributor && a.role != RoleViewer {
+		return deny(ErrInvalid, "invalid role")
+	}
+	if a.role == RoleViewer && len(a.assigned) > 0 {
+		return deny(ErrInvalid, "member has assigned tasks; reassign them before making the member a viewer")
+	}
+	return nil
+}
+
+func (a *updateMemberRoleAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.membership.setRole(ctx, tx, a.role); err != nil {
+		return nil, err
+	}
+	return a.membership, nil
+}
