+func TestUpdateMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager promotes contributor", "ann", "/projects/web/members/ben", `{"role":"manager"}`, 200},
+		{"manager demotes manager", "ann", "/projects/web/members/ivy", `{"role":"viewer"}`, 200},
+		{"manager promotes to same role", "ann", "/projects/web/members/cat", `{"role":"contributor"}`, 200},
+		{"manager demotes contributor with tasks", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 400},
+		{"manager demotes contributor with tasks (other)", "ann", "/projects/web/members/cat", `{"role":"viewer"}`, 400},
+		{"contributor", "ben", "/projects/web/members/cat", `{"role":"manager"}`, 403},
+		{"contributor self promote", "ben", "/projects/web/members/ben", `{"role":"manager"}`, 403},
+		{"viewer", "dan", "/projects/web/members/ben", `{"role":"manager"}`, 403},
+		{"org admin", "eve", "/projects/web/members/ben", `{"role":"manager"}`, 403},
+		{"manager of other project", "ann", "/projects/ops/members/cat", `{"role":"manager"}`, 403},
+		{"non member", "hal", "/projects/web/members/ben", `{"role":"manager"}`, 404},
+		{"other org", "gus", "/projects/web/members/ben", `{"role":"manager"}`, 404},
+		{"anonymous", "", "/projects/web/members/ben", `{"role":"manager"}`, 401},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"manager"}`, 404},
+		{"target in other org", "ann", "/projects/web/members/gus", `{"role":"manager"}`, 404},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"manager"}`, 409},
+		{"invalid role", "ann", "/projects/web/members/ben", `{"role":"owner"}`, 400},
+		{"missing role", "ann", "/projects/web/members/ben", `{}`, 400},
+		{"bad body before access", "hal", "/projects/web/members/ben", `{"role":"owner"}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRoleResponseAndPersistence(t *testing.T) {
+	srv := newServer()
+
+	code, body := do(t, srv, "PUT", "/projects/web/members/ben", "ann", `{"role":"manager"}`)
+	if code != 200 {
+		t.Fatalf("promote: got %d %s", code, body)
+	}
+	var got struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.UserID != "ben" || got.Role != "manager" {
+		t.Fatalf("body %s", body)
+	}
+
+	// ben is a manager now, so ben may change roles.
+	if code, _ := do(t, srv, "PUT", "/projects/web/members/dan", "ben", `{"role":"contributor"}`); code != 200 {
+		t.Fatalf("promoted manager: got %d", code)
+	}
+
+	// ann demotes ivy (no tasks); ivy, now a viewer, may no longer change roles.
+	if code, _ := do(t, srv, "PUT", "/projects/web/members/ivy", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote: got %d", code)
+	}
+	if code, _ := do(t, srv, "PUT", "/projects/web/members/ben", "ivy", `{"role":"contributor"}`); code != 403 {
+		t.Fatalf("demoted manager: got %d want 403", code)
+	}
+
+	// The demoted viewer's write rights are gone too: ivy cannot create a task.
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "ivy", `{"title":"x"}`); code != 403 {
+		t.Fatalf("demoted viewer create: got %d want 403", code)
+	}
+}
