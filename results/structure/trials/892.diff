+// UpdateRole changes the role of a project member. Only managers may do it
+// (CanManageMembers). The member must belong to the project (else ErrNotFound).
+func (mt *MembershipTable) UpdateRole(ctx context.Context, db DB, authz ProjectAuthz, userID, role string) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadUpdateMemberRole(ctx, tx, authz.ProjectID(), userID, role)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if m, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
