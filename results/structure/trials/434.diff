+// setRolesAggregate changes the roles of several members of one project.
+type setRolesAggregate struct {
+	project *Project
+	changes []memberRoleChange // ordered by user ID
+}
+
+// memberRoleChange is one member's new role, with the number of the project's
+// tasks assigned to the member (a viewer may not be an assignee).
+type memberRoleChange struct {
+	member        *Membership
+	role          string
+	assignedTasks int
+}
+
+func loadSetRoles(ctx context.Context, x *Tx, projectID string, in MembershipTableSetRolesInput) (*setRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, x, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	userIDs := make([]string, 0, len(in.Roles))
+	for uid := range in.Roles {
+		userIDs = append(userIDs, uid)
+	}
+	sort.Strings(userIDs)
+	a := &setRolesAggregate{project: p}
+	for _, uid := range userIDs {
+		m, err := p.Membership(ctx, x, uid)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "user "+uid+" is not a member of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		tasks, err := m.AssignedTasks(ctx, x)
+		if err != nil {
+			return nil, err
+		}
+		a.changes = append(a.changes, memberRoleChange{member: m, role: in.Roles[uid], assignedTasks: len(tasks)})
+	}
+	return a, nil
+}
+
+func (a *setRolesAggregate) validate() error {
+	for _, c := range a.changes {
+		if !isRole(c.role) {
+			return deny(ErrInvalid, "invalid role")
+		}
+		if c.role == RoleViewer && c.assignedTasks > 0 {
+			return deny(ErrInvalid, "user "+c.member.UserID+" has tasks assigned in the project; a viewer cannot be an assignee")
+		}
+	}
+	return nil
+}
+
+// apply changes the roles and returns the project's members after the change.
+func (a *setRolesAggregate) apply(ctx context.Context, x *Tx) ([]*Membership, error) {
+	for _, c := range a.changes {
+		if err := c.member.changeRole(ctx, x, c.role); err != nil {
+			return nil, err
+		}
+	}
+	return NewMembershipTable().ListByProject(ctx, x, a.project.ID)
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
