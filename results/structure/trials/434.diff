diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..a13b4f1
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,110 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestSetMemberRoles(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager changes roles", "ann", "web", `{"roles":{"dan":"contributor"}}`, 200},
+		{"manager demotes member without tasks", "ann", "web", `{"roles":{"ivy":"viewer"}}`, 200},
+		{"manager sets same role", "ann", "web", `{"roles":{"ben":"contributor"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"unknown project", "ann", "nope", `{"roles":{"dan":"contributor"}}`, 404},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"unknown role", "ann", "web", `{"roles":{"dan":"owner"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"malformed body", "ann", "web", `{"roles":`, 400},
+		{"target not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"viewer with assigned task", "ann", "web", `{"roles":{"ben":"viewer"}}`, 400},
+		{"one bad entry rejects batch", "ann", "web", `{"roles":{"dan":"contributor","hal":"viewer"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMemberRolesResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","cat":"manager"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	type member struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	var got []member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []member{
+		{"ann", "manager"},
+		{"ben", "contributor"},
+		{"cat", "manager"},
+		{"dan", "contributor"},
+		{"ivy", "manager"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %d members, want %d: %s", len(got), len(want), body)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("member %d: got %+v want %+v", i, got[i], want[i])
+		}
+	}
+}
+
+func TestSetMemberRolesTakesEffect(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor"}}`); code != 200 {
+		t.Fatalf("set roles: got %d: %s", code, body)
+	}
+	if code, body := do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("dan as contributor: got %d: %s", code, body)
+	}
+}
+
+func TestSetMemberRolesAllOrNothing(t *testing.T) {
+	srv := newServer()
+	for _, body := range []string{
+		`{"roles":{"dan":"contributor","hal":"viewer"}}`, // hal is not a member
+		`{"roles":{"dan":"contributor","ben":"viewer"}}`, // ben is assigned t1
+	} {
+		if code, _ := do(t, srv, "PUT", "/projects/web/members", "ann", body); code != 400 {
+			t.Fatalf("%s: got %d want 400", body, code)
+		}
+		// dan is still a viewer.
+		if code, _ := do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 403 {
+			t.Fatalf("after %s: dan got %d want 403", body, code)
+		}
+		// ben still holds t1 as a contributor.
+		if code, _ := do(t, srv, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"doing"}`); code != 200 {
+			t.Fatalf("after %s: ben got %d want 200", body, code)
+		}
+	}
+}
+
+func TestSetMemberRolesDemoteAfterUnassign(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "PATCH", "/projects/web/tasks/t1", "ann", `{"assignee":""}`); code != 200 {
+		t.Fatalf("unassign: got %d: %s", code, body)
+	}
+	if code, body := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer"}}`); code != 200 {
+		t.Fatalf("demote: got %d: %s", code, body)
+	}
+}
