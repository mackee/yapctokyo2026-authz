+
+type membersRequest struct {
+	Roles map[string]string `json:"roles"`
+}
+
+type memberRole struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+var validRoles = map[string]bool{RoleManager: true, RoleContributor: true, RoleViewer: true}
+
+// setMemberRoles changes several members' roles at once. Either every change
+// applies or none does. It answers with the project's members after the change.
+func (s *server) setMemberRoles(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role, err := findRole(ctx, s.db, project.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req membersRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || len(req.Roles) == 0 {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+
+	// Check the whole batch before changing anything. Sorted order keeps the
+	// error message stable.
+	userIDs := slices.Sorted(maps.Keys(req.Roles))
+	for _, uid := range userIDs {
+		if !validRoles[req.Roles[uid]] {
+			writeError(w, 400, "invalid role")
+			return
+		}
+		current, err := findRole(ctx, tx, project.ID, uid)
+		if err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+		if current == "" {
+			writeError(w, 400, "user is not a member of the project: "+uid)
+			return
+		}
+	}
+	// A member who is assigned tasks must stay a contributor or manager.
+	for _, uid := range userIDs {
+		if req.Roles[uid] != RoleViewer {
+			continue
+		}
+		var n int
+		if err := tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM tasks WHERE project_id = ? AND assignee = ?`, project.ID, uid).Scan(&n); err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+		if n > 0 {
+			writeError(w, 409, "user has assigned tasks in this project and cannot become a viewer: "+uid)
+			return
+		}
+	}
+
+	for _, uid := range userIDs {
+		if _, err := tx.ExecContext(ctx, `UPDATE memberships SET role = ? WHERE project_id = ? AND user_id = ?`,
+			req.Roles[uid], project.ID, uid); err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+	}
+	rows, err := tx.QueryContext(ctx, `SELECT user_id, role FROM memberships WHERE project_id = ? ORDER BY user_id`, project.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer rows.Close()
+	members := []memberRole{}
+	for rows.Next() {
+		var m memberRole
+		if err := rows.Scan(&m.UserID, &m.Role); err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+		members = append(members, m)
+	}
+	if err := rows.Err(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, members)
+}
diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..9179efc
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,96 @@
+package main
+
+import (
+	"encoding/json"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestSetMemberRoles(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager promotes viewer", "ann", "web", `{"roles":{"dan":"contributor"}}`, 200},
+		{"manager demotes unassigned manager", "ann", "web", `{"roles":{"ivy":"viewer"}}`, 200},
+		{"manager batch", "ann", "web", `{"roles":{"dan":"contributor","ivy":"contributor"}}`, 200},
+		{"contributor caller", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer caller", "dan", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"org admin caller", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member caller", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org caller", "gus", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"unknown user caller", "zed", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"contributor"}}`, 409},
+		{"demote member with tasks", "ann", "web", `{"roles":{"ben":"viewer"}}`, 409},
+		{"batch with one blocked change", "ann", "web", `{"roles":{"dan":"contributor","ben":"viewer"}}`, 409},
+		{"non member target", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"unknown target", "ann", "web", `{"roles":{"zed":"viewer"}}`, 400},
+		{"bad role", "ann", "web", `{"roles":{"dan":"owner"}}`, 400},
+		{"empty role", "ann", "web", `{"roles":{"dan":""}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"bad body", "ann", "web", `not json`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMemberRolesResponse(t *testing.T) {
+	srv := newServer()
+	code, body := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"ivy":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got []memberRole
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []memberRole{
+		{"ann", "manager"},
+		{"ben", "contributor"},
+		{"cat", "contributor"},
+		{"dan", "contributor"},
+		{"ivy", "viewer"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("members = %+v, want %+v", got, want)
+	}
+	// The change is in effect: dan can now create tasks.
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("promoted dan create: got %d want 200", code)
+	}
+}
+
+func TestSetMemberRolesIsAllOrNothing(t *testing.T) {
+	cases := []struct {
+		name, body string
+		want       int
+	}{
+		{"blocked viewer demotion", `{"roles":{"dan":"contributor","ben":"viewer"}}`, 409},
+		{"non member target", `{"roles":{"dan":"contributor","hal":"contributor"}}`, 400},
+		{"bad role", `{"roles":{"dan":"contributor","cat":"owner"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			srv := newServer()
+			if code, _ := do(t, srv, "PUT", "/projects/web/members", "ann", c.body); code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+			// dan must still be a viewer, so he cannot create tasks.
+			if code, _ := do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 403 {
+				t.Fatalf("dan create after failed batch: got %d want 403", code)
+			}
+			// ben must still be a contributor and keep his task.
+			if code, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ben", ""); code != 200 || !strings.Contains(body, `"assignee":"ben"`) {
+				t.Fatalf("ben task after failed batch: got %d %s", code, body)
+			}
+		})
+	}
+}
