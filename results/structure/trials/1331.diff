+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager moves", "ivy", "/projects/ops/tasks/t4/move", `{"toProjectId":"web"}`, 200},
+		{"viewer in target", "ann", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 403},
+		{"manager of both", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 200},
+		{"assignee not in target", "ivy", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 400},
+		{"contributor", "ben", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer in source", "ann", "/projects/ops/tasks/t4/move", `{"toProjectId":"web"}`, 403},
+		{"org admin", "eve", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 403},
+		{"non member source", "hal", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 401},
+		{"task not in project", "ivy", "/projects/web/tasks/t4/move", `{"toProjectId":"ops"}`, 404},
+		{"archived source", "ann", "/projects/legacy/tasks/t5/move", `{"toProjectId":"web"}`, 409},
+		{"archived target", "ann", "/projects/web/tasks/t3/move", `{"toProjectId":"legacy"}`, 409},
+		{"unreadable target", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"legacy"}`, 404},
+		{"other org target", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"gx"}`, 404},
+		{"missing target", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"nope"}`, 404},
+		{"no body", "ivy", "/projects/web/tasks/t3/move", ``, 400},
+		{"empty target", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":""}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsFields(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/ops/tasks/t4/move", "ivy", `{"toProjectId":"web"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var moved Task
+	json.Unmarshal([]byte(body), &moved)
+	want := Task{ID: "t4", ProjectID: "web", Title: "Rotate keys", Status: "open", Assignee: "cat"}
+	if moved != want {
+		t.Fatalf("got %+v want %+v", moved, want)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t4", "ann", ""); code != 200 {
+		t.Fatalf("task not in web: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks/t4", "ivy", ""); code != 404 {
+		t.Fatalf("task still in ops: %d", code)
+	}
+}
