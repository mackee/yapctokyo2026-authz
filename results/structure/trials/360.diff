index af9c3c6..2f88b3b 100644
--- a/internal/capability/aggregate.go
+++ b/internal/capability/aggregate.go
@@ -108,3 +108,75 @@ func loadDeleteTask(x *tx, taskID string) (*deleteTaskAggregate, error) {
 func (a *deleteTaskAggregate) validate() error { return nil }
 
 func (a *deleteTaskAggregate) save(x *tx) { a.task.destroy(x) }
+
+// moveMemberAggregate moves one member from one project to another. It removes
+// the source membership, adds a destination membership with the same role, and
+// unassigns the member's tasks in the source project, because the member is no
+// longer a contributor or manager there.
+type moveMemberAggregate struct {
+	user     userRecord
+	to       projectRecord
+	remove   membershipRecord // source membership, destroyed on save
+	add      membershipRecord // destination membership, saved on save
+	unassign []taskRecord     // source tasks assigned to the member, unassigned on save
+}
+
+func loadMoveMember(x *tx, actor Actor, fromPID, userID, toPID string) (*moveMemberAggregate, error) {
+	if toPID == fromPID {
+		return nil, deny(ErrInvalid, "member is already in this project")
+	}
+	// The destination must be readable by the actor and managed by them. An
+	// unreadable destination is 404; a readable one they do not manage is 403.
+	to, role, err := readable(x, actor, toPID)
+	if err != nil {
+		return nil, err
+	}
+	if role != RoleManager {
+		return nil, deny(ErrForbidden, "forbidden")
+	}
+	if to.Archived {
+		return nil, deny(ErrArchived, "project is archived")
+	}
+	m, ok := x.findMembership(fromPID, userID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if _, exists := x.findMembership(toPID, userID); exists {
+		return nil, deny(ErrConflict, "user is already a member of the destination project")
+	}
+	u, _ := x.findUser(userID)
+	a := &moveMemberAggregate{
+		user:   u,
+		to:     to,
+		remove: m,
+		add:    membershipRecord{ProjectID: toPID, UserID: userID, Role: m.Role},
+	}
+	for _, t := range x.tasksIn(fromPID) {
+		if t.AssigneeID == userID {
+			t.AssigneeID = ""
+			a.unassign = append(a.unassign, t)
+		}
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.user.Org != a.to.Org {
+		return deny(ErrInvalid, "member must belong to the project's organization")
+	}
+	switch a.add.Role {
+	case RoleManager, RoleContributor, RoleViewer:
+	default:
+		return deny(ErrInvalid, "invalid role")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) save(x *tx) MembershipView {
+	for _, t := range a.unassign {
+		t.save(x)
+	}
+	a.remove.destroy(x)
+	a.add.save(x)
+	return MembershipView{UserID: a.add.UserID, ProjectID: a.add.ProjectID, Role: a.add.Role}
+}
