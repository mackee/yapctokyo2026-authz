+func TestMoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager of both moves contributor", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 200},
+		{"manager of both moves viewer", "ivy", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 200},
+		{"source manager only", "ann", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 403},
+		{"contributor", "ben", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer", "dan", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin", "eve", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 403},
+		{"non member actor", "hal", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 404},
+		{"unknown user", "zed", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 401},
+		{"anonymous", "", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 401},
+		{"not a member of source", "ivy", "/projects/web/members/hal/move", `{"toProjectId":"ops"}`, 404},
+		{"unknown target user", "ivy", "/projects/web/members/zed/move", `{"toProjectId":"ops"}`, 404},
+		{"destination not readable (other org)", "ivy", "/projects/web/members/cat/move", `{"toProjectId":"gx"}`, 404},
+		{"destination missing", "ivy", "/projects/web/members/cat/move", `{"toProjectId":"nope"}`, 404},
+		{"destination archived", "ann", "/projects/web/members/ben/move", `{"toProjectId":"legacy"}`, 409},
+		{"source archived", "ann", "/projects/legacy/members/ben/move", `{"toProjectId":"web"}`, 409},
+		{"already in destination", "ivy", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 409},
+		{"already in destination (self)", "ivy", "/projects/web/members/ivy/move", `{"toProjectId":"ops"}`, 409},
+		{"same project", "ivy", "/projects/web/members/cat/move", `{"toProjectId":"web"}`, 400},
+		{"missing target", "ivy", "/projects/web/members/cat/move", `{}`, 400},
+		{"empty body", "ivy", "/projects/web/members/cat/move", ``, 400},
+	}
+	for _, c := range cases {
