+func TestMoveMemberEffects(t *testing.T) {
+	s := newServer()
+
+	code, body := do(t, s, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d: %s", code, body)
+	}
+	var got capability.MembershipView
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if want := (capability.MembershipView{UserID: "ben", ProjectID: "ops", Role: "contributor"}); got != want {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+
+	// ben left web: no longer readable there.
+	if code, _ := do(t, s, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads web after move: got %d want 404", code)
+	}
+	// ben joined ops with the same role: can read, and can create as a contributor.
+	if code, _ := do(t, s, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben reads ops after move: got %d want 200", code)
+	}
+	if code, _ := do(t, s, "POST", "/projects/ops/tasks", "ben", `{"title":"x","assignee":"ben"}`); code != 201 {
+		t.Fatalf("ben creates in ops after move: got %d want 201", code)
+	}
+	// ben's membership elsewhere is untouched.
+	if code, _ := do(t, s, "GET", "/projects/legacy/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben reads legacy after move: got %d want 200", code)
+	}
+	// ben's task in web is unassigned; other members' tasks are untouched.
+	_, body = do(t, s, "GET", "/projects/web/tasks/t1", "ivy", "")
+	if !strings.Contains(body, `"assignee":""`) {
+		t.Fatalf("t1 should be unassigned after ben moved: %s", body)
+	}
+	_, body = do(t, s, "GET", "/projects/web/tasks/t2", "ivy", "")
+	if !strings.Contains(body, `"assignee":"cat"`) {
+		t.Fatalf("t2 should still be assigned to cat: %s", body)
+	}
+}
