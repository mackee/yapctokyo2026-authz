+
+// ---- member capabilities -------------------------------------------------------
+
+// ManageMember may move one member out of the project and into another
+// project the actor manages.
+type ManageMember interface {
+	// Move removes the member from this project and adds them to toProjectID
+	// with the same role. The move is atomic.
+	Move(toProjectID string) (MembershipView, error)
+}
+
+type memberScope struct {
+	ps  *projectScope
+	uid string
+}
+
+// Manage applies the membership rule for the source project: readable (else
+// 404), manager (else 403), not archived (else 409), and the user is a member
+// (else 404).
+func (s *memberScope) Manage() (ManageMember, error) {
+	err := s.ps.as.a.db.view(func(x *tx) error {
+		p, r, err := readable(x, s.ps.as.actor, s.ps.pid)
+		if err != nil {
+			return err
+		}
+		if r != RoleManager {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if p.Archived {
+			return deny(ErrArchived, "project is archived")
+		}
+		if x.role(s.ps.pid, s.uid) == "" {
+			return deny(ErrNotFound, "not found")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &manageMember{ms: s}, nil
+}
+
+type manageMember struct{ ms *memberScope }
+
+func (m *manageMember) Move(toProjectID string) (MembershipView, error) {
+	var v MembershipView
+	err := m.ms.ps.as.a.db.update(func(x *tx) error {
+		agg, err := loadMoveMember(x, m.ms.ps.as.actor, m.ms.ps.pid, m.ms.uid, toProjectID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		v = agg.save(x)
+		return nil
+	})
+	return v, err
+}
