 func isWriterRole(role string) bool { return role == RoleManager || role == RoleContributor }
 
+func validRole(role string) bool {
+	return role == RoleManager || role == RoleContributor || role == RoleViewer
+}
+
+// membersIn returns the members of a project sorted by user ID.
+func (s *state) membersIn(projectID string) []MemberView {
+	out := []MemberView{}
+	for uid, role := range s.members[projectID] {
+		out = append(out, MemberView{UserID: uid, Role: role})
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].UserID < out[j].UserID })
+	return out
+}
