+// Manage applies the member-management rule: readable, manager (else 403; org
+// admins without a project role are 403), not archived (else 409).
+func (s *projectScope) Manage() (ManageProject, error) {
+	err := s.as.a.st.read(func(st *state) error {
+		p, r, err := readable(st, s.as.actor, s.pid)
+		if err != nil {
+			return err
+		}
+		if r != RoleManager {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if p.archived {
+			return deny(ErrArchived, "project is archived")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &manageProject{readProject{ps: s}}, nil
+}
+
+// ---- member capabilities -------------------------------------------------------
+
+// MemberView is one project member and the member's project role.
+type MemberView struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// ManageProject may change the project roles of its members. Only managers.
+type ManageProject interface {
+	ReadProject
+	// SetRoles changes the roles of the given members as one all-or-nothing
+	// change and returns the project's members afterwards, sorted by user ID.
+	// If any user is not a member, any role is invalid, or the result would
+	// break a model invariant (for example, demoting an assignee of a task to
+	// viewer), it returns ErrInvalid and changes nothing.
+	SetRoles(roles map[string]string) ([]MemberView, error)
+}
+
+type manageProject struct{ readProject }
+
+func (p *manageProject) SetRoles(roles map[string]string) ([]MemberView, error) {
+	if len(roles) == 0 {
+		return nil, deny(ErrInvalid, "roles must not be empty")
+	}
+	userIDs := make([]string, 0, len(roles))
+	for uid := range roles {
+		userIDs = append(userIDs, uid)
+	}
+	sort.Strings(userIDs)
+	for _, uid := range userIDs {
+		if !validRole(roles[uid]) {
+			return nil, deny(ErrInvalid, "invalid role for "+uid)
+		}
+	}
+	var out []MemberView
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		for _, uid := range userIDs {
+			if _, ok := s.members[p.ps.pid][uid]; !ok {
+				return deny(ErrInvalid, uid+" is not a member of the project")
+			}
+		}
+		for _, uid := range userIDs {
+			s.members[p.ps.pid][uid] = roles[uid]
+		}
+		out = s.membersIn(p.ps.pid)
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return out, nil
+}
