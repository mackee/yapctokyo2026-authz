+func TestSetMembers(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager promotes viewer", "ann", "web", `{"roles":{"dan":"contributor"}}`, 200},
+		{"manager batch", "ivy", "ops", `{"roles":{"ann":"contributor","cat":"contributor"}}`, 200},
+		{"viewer-only manager of ops is not manager", "ann", "ops", `{"roles":{"ann":"contributor"}}`, 403},
+		{"manager same role", "ann", "web", `{"roles":{"ann":"manager"}}`, 200},
+		{"demote assignee breaks invariant", "ann", "web", `{"roles":{"ben":"viewer"}}`, 400},
+		{"seed example rejected: ben holds t1", "ann", "web", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 400},
+		{"contributor cannot", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer cannot", "dan", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"org admin cannot", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"anonymous", "", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"invalid role", "ann", "web", `{"roles":{"dan":"owner"}}`, 400},
+		{"target not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"target in other org", "ann", "web", `{"roles":{"gus":"viewer"}}`, 400},
+		{"one bad entry fails batch", "ann", "web", `{"roles":{"dan":"contributor","hal":"viewer"}}`, 400},
+		{"malformed body", "ann", "web", `not json`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+type memberJSON struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func TestSetMembersResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []memberJSON
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []memberJSON{
+		{"ann", "manager"},
+		{"ben", "contributor"},
+		{"cat", "contributor"},
+		{"dan", "contributor"},
+		{"ivy", "manager"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %s", body)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("entry %d: got %+v want %+v (body %s)", i, got[i], want[i], body)
+		}
+	}
+}
+
+func TestSetMembersIsAllOrNothing(t *testing.T) {
+	srv := newServer()
+
+	// dan's valid change is paired with an invalid target: nothing changes.
+	code, _ := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","hal":"viewer"}}`)
+	if code != 400 {
+		t.Fatalf("mixed batch: got %d want 400", code)
+	}
+	// ben is assigned t1, so demoting him breaks the assignee invariant.
+	code, _ = do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","ben":"viewer"}}`)
+	if code != 400 {
+		t.Fatalf("invariant-breaking batch: got %d want 400", code)
+	}
+	code, _ = do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`)
+	if code != 403 {
+		t.Fatalf("dan should still be a viewer after failed batches: got %d", code)
+	}
+
+	code, _ = do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("valid batch: got %d want 200", code)
+	}
+	code, _ = do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`)
+	if code != 201 {
+		t.Fatalf("dan should be a contributor now: got %d", code)
+	}
+}
