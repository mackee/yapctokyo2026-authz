+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben", 204},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"non admin", "ann", "/orgs/acme/users/ben", 403},
+		{"admin of other org", "gus", "/orgs/acme/users/ben", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatal(code)
+	}
+	// ben was a member of web and archived legacy; now gone entirely.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 401 {
+		t.Fatalf("removed user got %d want 401", code)
+	}
+	// his tasks are unassigned, including in the archived project.
+	for _, p := range []string{"/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		code, body := do(t, h, "GET", p, "eve", "")
+		var task Task
+		json.Unmarshal([]byte(body), &task)
+		if code != 200 || task.Assignee != "" {
+			t.Fatalf("%s: code %d assignee %q", p, code, task.Assignee)
+		}
+	}
+	// other users and other orgs are untouched.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatal(code)
+	}
+	if code, body := do(t, h, "GET", "/projects/web/tasks/t2", "ann", ""); code != 200 || !strings.Contains(body, `"cat"`) {
+		t.Fatal(code, body)
+	}
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatal(code)
+	}
+	// second removal: user no longer exists.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 404 {
+		t.Fatalf("got %d want 404", code)
+	}
+}
