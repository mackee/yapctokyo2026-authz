--- a/internal/model/authz.go
+++ b/internal/model/authz.go
@@ -67,6 +67,18 @@ func (a ProjectAuthz) CanAssign(userID string) error {
 	return nil
 }
 
+// CanFreeze returns nil if the actor may freeze the project: managers only (else
+// ErrForbidden) and not archived (else ErrArchived).
+func (a ProjectAuthz) CanFreeze() error {
+	if !a.CanRead() || a.role != RoleManager {
+		return deny(ErrForbidden, "forbidden")
+	}
+	if a.archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	return nil
+}
+
 // TaskAuthz is what the actor may do with one task of one project.
 type TaskAuthz struct {
 	project    ProjectAuthz
