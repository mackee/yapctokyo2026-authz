@@ -0,0 +1,99 @@
+package main
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+		{"archived", "ann", "legacy", 409},
+		{"missing project", "ann", "missing", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeReturnsViewers(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+	want := `[{"userId":"ann","role":"viewer"},{"userId":"ben","role":"viewer"},` +
+		`{"userId":"cat","role":"viewer"},{"userId":"dan","role":"viewer"},` +
+		`{"userId":"ivy","role":"viewer"}]`
+	if got := strings.TrimSpace(body); got != want {
+		t.Fatalf("got %s\nwant %s", got, want)
+	}
+}
+
+func TestFrozenProjectRejectsWrites(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d want 200", code)
+	}
+	cases := []struct {
+		name, user, method, path, body string
+		want                           int
+	}{
+		{"create by former manager", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"create by former contributor", "ben", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"update own task", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`, 403},
+		{"update by former manager", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"delete by former manager", "ann", "DELETE", "/projects/web/tasks/t1", "", 403},
+		{"freeze again", "ann", "POST", "/projects/web/freeze", "", 403},
+		{"read still works", "dan", "GET", "/projects/web/tasks", "", 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, h, c.method, c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+
+	t.Run("tasks are unassigned", func(t *testing.T) {
+		_, body := do(t, h, "GET", "/projects/web/tasks/t1", "dan", "")
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.AssigneeID != "" {
+			t.Fatalf("t1 still assigned to %q", task.AssigneeID)
+		}
+	})
+
+	t.Run("other projects are untouched", func(t *testing.T) {
+		code, _ := do(t, h, "POST", "/projects/ops/tasks", "cat", `{"title":"x"}`)
+		if code != 200 {
+			t.Fatalf("got %d want 200", code)
+		}
+		_, body := do(t, h, "GET", "/projects/ops/tasks/t4", "cat", "")
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.AssigneeID != "cat" {
+			t.Fatalf("ops t4 assignee %q, want cat", task.AssigneeID)
+		}
+	})
+}
