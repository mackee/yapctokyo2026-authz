+// RemoveFromOrg removes the user from every project of the organization. Their
+// memberships in those projects are deleted, and the tasks they were assigned
+// there are unassigned, all in one transaction. The user row itself stays.
+// Projects are changed even when archived. Only org admins may do this (else
+// ErrForbidden); a user outside the organization is ErrNotFound.
+func (*UserTable) RemoveFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanRemoveMembers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveOrgUser(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
