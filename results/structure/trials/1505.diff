 func (a *deleteTaskAggregate) apply(ctx context.Context, tx DB) error { return a.task.destroy(ctx, tx) }
+
+// removeOrgUserAggregate removes one user from every project of one organization.
+type removeOrgUserAggregate struct {
+	memberships []*Membership // the user's memberships in projects of the organization
+}
+
+func loadRemoveOrgUser(ctx context.Context, tx DB, org, userID string) (*removeOrgUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) || (err == nil && u.Org != org) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	all, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	a := &removeOrgUserAggregate{}
+	for _, m := range all {
+		p, err := m.Project(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		if p.Org == org {
+			a.memberships = append(a.memberships, m)
+		}
+	}
+	return a, nil
+}
+
+func (a *removeOrgUserAggregate) validate() error { return nil }
+
+// apply unassigns the user's tasks in each project and then removes the
+// membership, so no task is left assigned to a non-member.
+func (a *removeOrgUserAggregate) apply(ctx context.Context, tx DB) error {
+	for _, m := range a.memberships {
+		tasks, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return err
+		}
+		for _, t := range tasks {
+			if err := t.unassign(ctx, tx); err != nil {
+				return err
+			}
+		}
+		if err := m.destroy(ctx, tx); err != nil {
+			return err
+		}
+	}
+	return nil
+}
