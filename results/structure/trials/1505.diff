diff --git a/org_test.go b/org_test.go
new file mode 100644
index 0000000..1f180b6
--- /dev/null
+++ b/org_test.go
@@ -0,0 +1,101 @@
+package main
+
+import (
+	"net/http"
+	"testing"
+)
+
+func TestRemoveUserFromOrg(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes user without memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"org admin removes self", "eve", "/orgs/acme/users/eve", 204},
+		{"member of the org is not admin", "ann", "/orgs/acme/users/ben", 403},
+		{"non member of the org is not admin", "hal", "/orgs/acme/users/ben", 403},
+		{"admin of another org", "gus", "/orgs/acme/users/ben", 404},
+		{"org admin asks for another org", "eve", "/orgs/globex/users/gus", 404},
+		{"user in another org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed", 404},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown actor", "zed", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+// count runs a query that returns one number on the database behind h.
+func count(t *testing.T, h http.Handler, query string, args ...any) int {
+	t.Helper()
+	app, ok := h.(*appHandler)
+	if !ok {
+		t.Fatalf("%T is not the handler built by newServer", h)
+	}
+	var n int
+	if err := app.db.QueryRow(query, args...).Scan(&n); err != nil {
+		t.Fatal(err)
+	}
+	return n
+}
+
+func TestRemoveUserFromOrgEffects(t *testing.T) {
+	h := newServer()
+	if n := count(t, h, `SELECT COUNT(*) FROM memberships WHERE user_id = 'ben'`); n != 2 {
+		t.Fatalf("seed: ben has %d memberships, want 2", n)
+	}
+
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("got %d want 204", code)
+	}
+
+	// ben leaves every project of the org ...
+	if n := count(t, h, `SELECT COUNT(*) FROM memberships WHERE user_id = 'ben'`); n != 0 {
+		t.Fatalf("ben still has %d memberships", n)
+	}
+	// ... and the tasks assigned to ben there are unassigned, not deleted.
+	for _, id := range []string{"t1", "t5"} {
+		if n := count(t, h, `SELECT COUNT(*) FROM tasks WHERE id = ? AND assignee = ''`, id); n != 1 {
+			t.Fatalf("task %s is still assigned to ben", id)
+		}
+	}
+	if n := count(t, h, `SELECT COUNT(*) FROM tasks`); n != 6 {
+		t.Fatalf("tasks: got %d want 6", n)
+	}
+	// Other people's memberships and tasks are untouched.
+	if n := count(t, h, `SELECT COUNT(*) FROM memberships WHERE user_id = 'ann'`); n != 3 {
+		t.Fatalf("ann has %d memberships, want 3", n)
+	}
+	if n := count(t, h, `SELECT COUNT(*) FROM tasks WHERE id = 't2' AND assignee = 'cat'`); n != 1 {
+		t.Fatal("task t2 changed")
+	}
+	// The user row stays.
+	if n := count(t, h, `SELECT COUNT(*) FROM users WHERE id = 'ben' AND org_id = 'acme'`); n != 1 {
+		t.Fatal("ben's user row was changed or removed")
+	}
+
+	// ben can no longer read the projects.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads web: got %d want 404", code)
+	}
+}
+
+func TestRemoveUserFromOrgDeniedChangesNothing(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "ann", ""); code != 403 {
+		t.Fatalf("got %d want 403", code)
+	}
+	if n := count(t, h, `SELECT COUNT(*) FROM memberships WHERE user_id = 'ben'`); n != 2 {
+		t.Fatalf("ben has %d memberships after a denied request, want 2", n)
+	}
+	if n := count(t, h, `SELECT COUNT(*) FROM tasks WHERE id = 't1' AND assignee = 'ben'`); n != 1 {
+		t.Fatal("task t1 changed after a denied request")
+	}
+}
