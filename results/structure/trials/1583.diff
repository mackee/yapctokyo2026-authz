@@ -0,0 +1,117 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"testing"
+)
+
+func TestRemoveOrgUserAuthz(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben", 204},
+		{"no memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"manager is not admin", "ann", "/orgs/acme/users/ben", 403},
+		{"contributor is not admin", "ben", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"other org's admin", "gus", "/orgs/acme/users/ben", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ben", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserRemovesAllMemberships(t *testing.T) {
+	h := newServer()
+	// ben: web contributor (t1 assigned), legacy contributor (archived, t5 assigned).
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("got %d want 204", code)
+	}
+	for _, p := range []string{"web", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ben", ""); code != 404 {
+			t.Errorf("ben still reads %s: %d", p, code)
+		}
+	}
+	// Their tasks are unassigned, not deleted.
+	for _, c := range []struct{ path, id string }{
+		{"/projects/web/tasks/t1", "t1"},
+		{"/projects/legacy/tasks/t5", "t5"},
+	} {
+		code, body := do(t, h, "GET", c.path, "eve", "")
+		if code != 200 {
+			t.Fatalf("%s: got %d", c.path, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.AssigneeID != "" {
+			t.Errorf("%s still assigned to %q", c.id, task.AssigneeID)
+		}
+	}
+}
+
+func TestRemoveOrgUserLeavesOthersAlone(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/cat", "eve", ""); code != 204 {
+		t.Fatalf("got %d want 204", code)
+	}
+	// cat's tasks in web (t2) and ops (t4) are unassigned; ben's t1 is untouched.
+	code, body := do(t, h, "GET", "/projects/web/tasks", "ann", "")
+	if code != 200 {
+		t.Fatal(code)
+	}
+	var tasks []Task
+	if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+		t.Fatal(err)
+	}
+	for _, task := range tasks {
+		switch task.ID {
+		case "t1":
+			if task.AssigneeID != "ben" {
+				t.Errorf("t1 assignee = %q, want ben", task.AssigneeID)
+			}
+		case "t2":
+			if task.AssigneeID != "" {
+				t.Errorf("t2 assignee = %q, want unassigned", task.AssigneeID)
+			}
+		}
+	}
+	// Other members keep access; the globex org is unaffected.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != http.StatusOK {
+		t.Errorf("ben lost access: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "gus", ""); code != http.StatusOK {
+		t.Errorf("gus lost access: %d", code)
+	}
+}
+
+func TestRemoveOrgUserTwice(t *testing.T) {
+	h := newServer()
+	for i := 0; i < 2; i++ {
+		if code, _ := do(t, h, "DELETE", "/orgs/acme/users/dan", "eve", ""); code != 204 {
+			t.Fatalf("call %d: got %d want 204", i+1, code)
+		}
+	}
+}
+
+func TestRemoveOrgUserDeniedChangesNothing(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "ann", ""); code != 403 {
+		t.Fatalf("got %d want 403", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t1", "ben", ""); code != 200 {
+		t.Fatalf("ben lost access after a denied request: %d", code)
+	}
+}
