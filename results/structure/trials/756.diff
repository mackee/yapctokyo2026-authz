diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..993ee93
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,113 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+// TestUpdateMembersDenied lists calls to PUT /members that must be refused.
+// Each row runs on a fresh server.
+func TestUpdateMembersDenied(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"contributor", "ben", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"ben":"viewer"}}`, 403},
+		{"org admin without role", "eve", "web", `{"roles":{"ben":"viewer"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"ben":"viewer"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"ben":"viewer"}}`, 404},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"anonymous", "", "web", `{"roles":{"ben":"viewer"}}`, 401},
+		{"unknown role", "ann", "web", `{"roles":{"ben":"owner"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"bad json", "ann", "web", `{"roles":`, 400},
+		{"non member target", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"demotes a manager and a contributor", "ann", "web", `{"roles":{"ivy":"viewer","cat":"viewer"}}`, 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+// TestUpdateMembersAllOrNothing checks that a batch with one target that is
+// not a member changes none of the roles.
+func TestUpdateMembersAllOrNothing(t *testing.T) {
+	srv := newServer()
+	code, body := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","hal":"viewer"}}`)
+	if code != 400 {
+		t.Fatalf("got %d want 400 body=%s", code, body)
+	}
+	code, body = do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200 body=%s", code, body)
+	}
+	got := roleOf(t, body, "ben")
+	if got != "contributor" {
+		t.Fatalf("ben's role changed by a refused batch: %s", got)
+	}
+}
+
+// TestUpdateMembersResponse checks the members list returned after a change.
+func TestUpdateMembersResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann",
+		`{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var members []struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &members); err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]string{"ann": "manager", "ben": "viewer", "cat": "contributor", "dan": "contributor", "ivy": "manager"}
+	if len(members) != len(want) {
+		t.Fatalf("want %d members, got %d: %s", len(want), len(members), body)
+	}
+	for _, m := range members {
+		if want[m.UserID] != m.Role {
+			t.Fatalf("%s: want role %q, got %q", m.UserID, want[m.UserID], m.Role)
+		}
+	}
+}
+
+// TestDemotedMemberLosesWriteAccess checks that a change takes effect on the
+// next request: a demoted contributor can no longer create tasks.
+func TestDemotedMemberLosesWriteAccess(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 200 {
+		t.Fatalf("before: got %d body=%s", code, body)
+	}
+	if code, body := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer"}}`); code != 200 {
+		t.Fatalf("change: got %d body=%s", code, body)
+	}
+	if code, body := do(t, srv, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Fatalf("after: got %d want 403 body=%s", code, body)
+	}
+}
+
+func roleOf(t *testing.T, body, userID string) string {
+	t.Helper()
+	var members []struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &members); err != nil {
+		t.Fatal(err)
+	}
+	for _, m := range members {
+		if m.UserID == userID {
+			return m.Role
+		}
+	}
+	t.Fatalf("%s not in members: %s", userID, body)
+	return ""
+}
