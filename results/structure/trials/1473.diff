+// orgExists reports whether any user or project belongs to the org. Orgs have no
+// table of their own.
+func orgExists(ctx context.Context, db *sql.DB, id string) (bool, error) {
+	var ok bool
+	err := db.QueryRowContext(ctx, `SELECT EXISTS (SELECT 1 FROM users WHERE org_id = ?) OR EXISTS (SELECT 1 FROM projects WHERE org_id = ?)`, id, id).Scan(&ok)
+	return ok, err
+}
