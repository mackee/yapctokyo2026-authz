+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes viewer only user", "eve", "/orgs/acme/users/dan", 204},
+		{"user with no memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"non admin", "ann", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"caller not in org", "eve", "/orgs/globex/users/gus", 404},
+		{"other org caller", "gus", "/orgs/acme/users/ben", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d", code)
+	}
+	// The removed user can no longer act (web, and archived legacy).
+	for _, p := range []string{"/projects/web/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, h, "GET", p, "ben", ""); code != 401 {
+			t.Fatalf("removed user GET %s: got %d want 401", p, code)
+		}
+	}
+	// Removing again: already gone.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 404 {
+		t.Fatalf("second remove: got %d want 404", code)
+	}
+	// Tasks assigned to them (including in the archived project) are unassigned.
+	for _, p := range []string{"/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		code, body := do(t, h, "GET", p, "eve", "")
+		if code != 200 {
+			t.Fatalf("get %s: %d", p, code)
+		}
+		var task Task
+		json.Unmarshal([]byte(body), &task)
+		if task.Assignee != "" {
+			t.Fatalf("%s still assigned to %q", p, task.Assignee)
+		}
+	}
+	// A removed user can no longer be assigned work.
+	code, _ := do(t, h, "POST", "/projects/web/tasks", "ann", `{"title":"x","assignee":"ben"}`)
+	if code != 400 {
+		t.Fatalf("assign removed user: got %d want 400", code)
+	}
+	// Other members are untouched.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("other member: got %d", code)
+	}
+	// Removing an org admin revokes their org-wide read access.
+	h2 := newServer()
+	if code, _ := do(t, h2, "DELETE", "/orgs/acme/users/eve", "eve", ""); code != 204 {
+		t.Fatalf("admin self remove: got %d", code)
+	}
+	if code, _ := do(t, h2, "GET", "/projects/ops/tasks", "eve", ""); code != 401 {
+		t.Fatalf("removed admin read: got %d want 401", code)
+	}
+}
