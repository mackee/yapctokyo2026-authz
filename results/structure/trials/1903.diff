@@ -0,0 +1,110 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"testing"
+)
+
+func tasksOf(t *testing.T, h http.Handler, project string) map[string]Task {
+	t.Helper()
+	code, body := do(t, h, "GET", "/projects/"+project+"/tasks", "eve", "")
+	if code != 200 {
+		t.Fatalf("list %s: %d", project, code)
+	}
+	var tasks []Task
+	if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+		t.Fatal(err)
+	}
+	m := map[string]Task{}
+	for _, task := range tasks {
+		m[task.ID] = task
+	}
+	return m
+}
+
+func TestRemoveUserFromOrg(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes user without memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"org admin removes another admin", "eve", "/orgs/acme/users/eve", 204},
+		{"manager is not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"plain user", "hal", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"target in another org", "eve", "/orgs/acme/users/gus", 404},
+		{"another org", "eve", "/orgs/globex/users/gus", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ben", 404},
+		{"other org's caller", "gus", "/orgs/acme/users/ben", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveUserDropsEveryProjectMembership(t *testing.T) {
+	h := newServer()
+	// ann is a member of web, ops and legacy (archived).
+	for _, p := range []string{"web", "ops", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ann", ""); code != 200 {
+			t.Fatalf("before: ann reads %s: %d", p, code)
+		}
+	}
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ann", "eve", ""); code != 204 {
+		t.Fatalf("got %d want 204", code)
+	}
+	for _, p := range []string{"web", "ops", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ann", ""); code != 404 {
+			t.Fatalf("after: ann reads %s: got %d want 404", p, code)
+		}
+	}
+	// Other members are untouched.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben lost access: %d", code)
+	}
+}
+
+// A removed member can no longer be an assignee (model rule), so their tasks,
+// archived projects included, become unassigned; everyone else's stay.
+func TestRemoveUserUnassignsTheirTasks(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("got %d want 204", code)
+	}
+	web := tasksOf(t, h, "web")
+	if web["t1"].AssigneeID != "" {
+		t.Fatalf("t1 still assigned to %q", web["t1"].AssigneeID)
+	}
+	if web["t2"].AssigneeID != "cat" {
+		t.Fatalf("t2 assignee changed to %q", web["t2"].AssigneeID)
+	}
+	if web["t1"].Title != "Fix header" || web["t1"].Status != "open" {
+		t.Fatalf("t1 otherwise modified: %+v", web["t1"])
+	}
+	if legacy := tasksOf(t, h, "legacy"); legacy["t5"].AssigneeID != "" {
+		t.Fatalf("t5 (archived project) still assigned to %q", legacy["t5"].AssigneeID)
+	}
+}
+
+func TestRemoveUserKeepsOtherOrgsAndIsRepeatable(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/cat", "eve", ""); code != 204 {
+		t.Fatalf("got %d want 204", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatalf("globex affected: %d", code)
+	}
+	// Removing again is still a success: the user is gone from every project.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/cat", "eve", ""); code != 204 {
+		t.Fatalf("second removal: got %d want 204", code)
+	}
+}
