+// OrgAuthz is what the actor may do in one organization: administer it, if
+// the actor is one of its org admins.
+type OrgAuthz struct {
+	actor Actor
+	org   string
+}
+
+// OrgID returns the organization the object is bound to.
+func (a OrgAuthz) OrgID() string { return a.org }
+
+// CanAdminister returns nil if the actor may administer the organization
+// (remove its users): org admins of that organization only (else ErrForbidden).
+func (a OrgAuthz) CanAdminister() error {
+	if a.org == "" || a.actor.org != a.org || !a.actor.orgAdmin {
+		return deny(ErrForbidden, "only org admins may do this")
+	}
+	return nil
+}
+
 // ---- building authorization objects -------------------------------------------------
 
+// NewOrgAuthz builds the actor's authorization object for one organization.
+// Only the actor's own organization is visible; any other is ErrNotFound.
+// Whether the actor may administer it is asked through CanAdminister.
+func NewOrgAuthz(_ context.Context, _ DB, act Actor, orgID string) (OrgAuthz, error) {
+	if orgID == "" || orgID != act.org {
+		return OrgAuthz{}, deny(ErrNotFound, "not found")
+	}
+	return OrgAuthz{actor: act, org: orgID}, nil
+}
+
