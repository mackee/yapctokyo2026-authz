+// removeUserAggregate takes one user out of every project of their
+// organization. Tasks assigned to the user are unassigned first, so that no
+// task is left with an assignee who is not a member (model rule).
+type removeUserAggregate struct {
+	user        *User
+	memberships []*Membership
+	assigned    []*Task // the user's tasks in those projects
+}
+
+func loadRemoveUser(ctx context.Context, tx DB, orgID, userID string) (*removeUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &removeUserAggregate{user: u}
+	if u.Org != orgID {
+		return a, nil // validate rejects it
+	}
+	if a.memberships, err = u.Memberships(ctx, tx); err != nil {
+		return nil, err
+	}
+	for _, m := range a.memberships {
+		tasks, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.assigned = append(a.assigned, tasks...)
+	}
+	return a, nil
+}
+
+func (a *removeUserAggregate) validate(orgID string) error {
+	if a.user.Org != orgID {
+		return deny(ErrNotFound, "not found")
+	}
+	return nil
+}
+
+func (a *removeUserAggregate) apply(ctx context.Context, tx DB) error {
+	for _, t := range a.assigned {
+		if err := t.unassign(ctx, tx); err != nil {
+			return err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
