+// RemoveFromOrg removes the user from the organization (offboarding): they
+// leave every project, archived ones included, and their tasks become
+// unassigned. The user must belong to the organization (else ErrNotFound).
+// Removing a user who has no memberships succeeds.
+func (*UserTable) RemoveFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanAdminister(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveUser(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(authz.OrgID()); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
