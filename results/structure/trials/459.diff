+func TestRemoveUserFromOrgRevokesAccess(t *testing.T) {
+	srv := newServer()
+
+	// Before: ben can read web and the archived legacy project.
+	for _, p := range []string{"/projects/web/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, srv, "GET", p, "ben", ""); code != 200 {
+			t.Fatalf("before: ben GET %s got %d want 200", p, code)
+		}
+	}
+
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove ben: got %d want 204", code)
+	}
+
+	// After: ben is out of every acme project, including the archived one.
+	for _, p := range []string{"/projects/web/tasks", "/projects/legacy/tasks", "/projects/web/tasks/t1"} {
+		if code, _ := do(t, srv, "GET", p, "ben", ""); code != 404 {
+			t.Fatalf("after: ben GET %s got %d want 404", p, code)
+		}
+	}
+	if code, _ := do(t, srv, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 404 {
+		t.Fatalf("after: ben PATCH got %d want 404", code)
+	}
+
+	// Other memberships are untouched.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ann", ""); code != 200 {
+		t.Fatalf("ann web got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat ops got %d want 200", code)
+	}
+
+	// The user record itself is kept, so the removal can be repeated.
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("repeat remove ben: got %d want 204", code)
+	}
+}
