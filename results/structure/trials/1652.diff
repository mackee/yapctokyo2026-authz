+// moveTaskAggregate moves one task to another project.
+type moveTaskAggregate struct {
+	task     *Task
+	target   *Project
+	assignee *Membership // the assignee's membership in the target; nil when unassigned
+}
+
+func loadMoveTask(ctx context.Context, tx DB, taskID, targetID string) (*moveTaskAggregate, error) {
+	t, err := NewTaskTable().Find(ctx, tx, taskID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	target, err := NewProjectTable().Find(ctx, tx, targetID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveTaskAggregate{task: t, target: target}
+	if t.AssigneeID != "" {
+		m, err := target.Membership(ctx, tx, t.AssigneeID)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "assignee must be a contributor or manager of the target project")
+		} else if err != nil {
+			return nil, err
+		}
+		a.assignee = m
+	}
+	return a, nil
+}
+
+func (a *moveTaskAggregate) validate() error {
+	if a.task.ProjectID == a.target.ID {
+		return deny(ErrInvalid, "task already belongs to the project")
+	}
+	if a.assignee != nil && !isWriterRole(a.assignee.Role) {
+		return deny(ErrInvalid, "assignee must be a contributor or manager of the target project")
+	}
+	return nil
+}
+
+func (a *moveTaskAggregate) apply(ctx context.Context, tx DB) (*Task, error) {
+	if err := a.task.moveTo(ctx, tx, a.target); err != nil {
+		return nil, err
+	}
+	return a.task, nil
+}
