+func TestUpdateMemberRoles(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager changes several", "ann", "/projects/web/members", `{"roles":{"ivy":"viewer","dan":"contributor"}}`, 200},
+		{"contributor forbidden", "ben", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer forbidden", "dan", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin forbidden", "eve", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 401},
+		{"archived", "ann", "/projects/legacy/members", `{"roles":{"ben":"manager"}}`, 409},
+		{"invalid role", "ann", "/projects/web/members", `{"roles":{"dan":"owner"}}`, 400},
+		{"empty roles", "ann", "/projects/web/members", `{"roles":{}}`, 400},
+		{"malformed", "ben", "/projects/web/members", `{`, 400},
+		{"not a member", "ann", "/projects/web/members", `{"roles":{"hal":"viewer"}}`, 400},
+		{"assignee demoted", "ann", "/projects/web/members", `{"roles":{"ben":"viewer"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRolesResponseAndAtomic(t *testing.T) {
+	decode := func(body string) map[string]string {
+		var ms []struct {
+			UserID string `json:"userId"`
+			Role   string `json:"role"`
+		}
+		if err := json.Unmarshal([]byte(body), &ms); err != nil {
+			t.Fatalf("decode %q: %v", body, err)
+		}
+		out := map[string]string{}
+		for _, m := range ms {
+			out[m.UserID] = m.Role
+		}
+		return out
+	}
+
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ivy":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	got := decode(body)
+	want := map[string]string{"ann": "manager", "ben": "contributor", "cat": "contributor", "dan": "contributor", "ivy": "viewer"}
+	if len(got) != len(want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	for k, v := range want {
+		if got[k] != v {
+			t.Fatalf("got %v want %v", got, want)
+		}
+	}
+
+	// One change that cannot be applied (ben is an assignee) rolls back the
+	// valid one (dan -> manager).
+	code, _ = do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"manager","ben":"viewer"}}`)
+	if code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	// dan is still a contributor: dan can create a task assigned to self.
+	code, body = do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x","assignee":"dan"}`)
+	if code != 200 {
+		t.Fatalf("dan should still be contributor: %d %s", code, body)
+	}
+	// ivy was demoted to viewer and can no longer write.
+	code, _ = do(t, h, "POST", "/projects/web/tasks", "ivy", `{"title":"y"}`)
+	if code != 403 {
+		t.Fatalf("got %d want 403", code)
+	}
+}
