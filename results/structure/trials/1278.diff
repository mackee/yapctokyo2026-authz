+// setRolesAggregate changes the roles of several members of one project.
+type setRolesAggregate struct {
+	project  *Project
+	roles    map[string]string      // user ID -> new role
+	members  map[string]*Membership // project.Membership(user)
+	assigned map[string][]*Task     // member.AssignedTasks()
+}
+
+func loadSetRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*setRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "project must exist")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &setRolesAggregate{
+		project:  p,
+		roles:    roles,
+		members:  map[string]*Membership{},
+		assigned: map[string][]*Task{},
+	}
+	for uid := range roles {
+		m, err := p.Membership(ctx, tx, uid)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, uid+" is not a member of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		tasks, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.members[uid] = m
+		a.assigned[uid] = tasks
+	}
+	return a, nil
+}
+
+func (a *setRolesAggregate) validate() error {
+	for uid, role := range a.roles {
+		if role != RoleManager && role != RoleContributor && role != RoleViewer {
+			return deny(ErrInvalid, "invalid role for "+uid)
+		}
+		if !isWriterRole(role) && len(a.assigned[uid]) > 0 {
+			return deny(ErrInvalid, uid+" has assigned tasks; an assignee must be a contributor or manager")
+		}
+	}
+	return nil
+}
+
+func (a *setRolesAggregate) apply(ctx context.Context, tx DB) error {
+	for uid, role := range a.roles {
+		if err := a.members[uid].setRole(ctx, tx, role); err != nil {
+			return err
+		}
+	}
+	return nil
+}
