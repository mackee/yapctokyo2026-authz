+// Remove removes the user from the project. The user's tasks in the project
+// are unassigned in the same transaction, so no task keeps an assignee who is
+// no longer a member. It returns ErrNotFound when the user is not a member, and
+// it is all-or-nothing.
+func (*MembershipTable) Remove(ctx context.Context, db DB, authz ProjectAuthz, userID string) error {
+	if err := authz.CanManageMembers(); err != nil {
+		return err
+	}
+	return db.update(ctx, func(x *Tx) error {
+		agg, err := loadRemoveMember(ctx, x, authz.ProjectID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, x)
+	})
+}
