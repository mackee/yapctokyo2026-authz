+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager of both", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 200},
+		{"manager, assignee kept", "ivy", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 200},
+		{"assignee not in target", "ivy", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 400},
+		{"manager of source, viewer of target", "ann", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 403},
+		{"contributor cannot manage", "ben", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"viewer", "dan", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 403},
+		{"org admin without role", "eve", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"non member of source", "hal", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 404},
+		{"other org source", "gus", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 404},
+		{"target in other org", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"gx"}`, 404},
+		{"target missing", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"nope"}`, 404},
+		{"target archived", "ann", "/projects/web/tasks/t3", `{"toProjectId":"legacy"}`, 409},
+		{"source archived", "ann", "/projects/legacy/tasks/t5", `{"toProjectId":"web"}`, 409},
+		{"cross project id", "ivy", "/projects/web/tasks/t4", `{"toProjectId":"ops"}`, 404},
+		{"same project", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"web"}`, 400},
+		{"missing target", "ivy", "/projects/web/tasks/t3", `{}`, 400},
+		{"bad body", "ivy", "/projects/web/tasks/t3", `not json`, 400},
+		{"unknown user", "zed", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 401},
+		{"anonymous", "", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsTaskFields(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d %s", code, body)
+	}
+	var moved Task
+	if err := json.Unmarshal([]byte(body), &moved); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", Assignee: "cat"}
+	if moved != want {
+		t.Fatalf("moved task = %+v, want %+v", moved, want)
+	}
+
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks/t2", "ivy", ""); code != 200 {
+		t.Fatalf("task not readable in target: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t2", "ivy", ""); code != 404 {
+		t.Fatalf("task still readable in source: %d", code)
+	}
+}
+
+func TestFailedMoveLeavesTaskInPlace(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/tasks/t1/move", "ivy", `{"toProjectId":"ops"}`); code != 400 {
+		t.Fatalf("move: got %d want 400", code)
+	}
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ivy", "")
+	if code != 200 {
+		t.Fatalf("task gone from source: %d", code)
+	}
+	var got Task
+	json.Unmarshal([]byte(body), &got)
+	if got.ProjectID != "web" || got.Assignee != "ben" {
+		t.Fatalf("task changed by failed move: %+v", got)
+	}
+}
