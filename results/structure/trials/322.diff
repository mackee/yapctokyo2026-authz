+// moveTaskAggregate moves one task into another project. The ID, title, status
+// and assignee are kept, so the assignee must still be a writer of the target.
+type moveTaskAggregate struct {
+	task     taskRecord
+	assignee *membershipRecord // nil means unassigned
+}
+
+func loadMoveTask(x *tx, taskID, toProjectID string) (*moveTaskAggregate, error) {
+	t, ok := x.findTask(taskID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if _, ok := x.findProject(toProjectID); !ok {
+		return nil, deny(ErrInvalid, "task must belong to an existing project")
+	}
+	a := &moveTaskAggregate{task: t}
+	a.task.ProjectID = toProjectID
+	if t.AssigneeID != "" {
+		m, ok := x.findMembership(toProjectID, t.AssigneeID)
+		if !ok {
+			return nil, deny(ErrInvalid, "assignee must be a contributor or manager of the target project")
+		}
+		a.assignee = &m
+	}
+	return a, nil
+}
+
+func (a *moveTaskAggregate) validate() error {
+	if a.assignee != nil && !isWriterRole(a.assignee.Role) {
+		return deny(ErrInvalid, "assignee must be a contributor or manager of the target project")
+	}
+	return nil
+}
+
+func (a *moveTaskAggregate) save(x *tx) TaskView {
+	a.task.save(x)
+	return a.task.view()
+}
