+
+func (t *manageTask) Move(toProjectID string) (TaskView, error) {
+	if toProjectID == "" {
+		return TaskView{}, deny(ErrInvalid, "toProjectId is required")
+	}
+	if toProjectID == t.ts.ps.pid {
+		return TaskView{}, deny(ErrInvalid, "task is already in that project")
+	}
+	// Acquiring write access to the target applies the full write rule there:
+	// readable (else 404), contributor or manager (else 403), not archived (else 409).
+	if _, err := t.ts.ps.as.Project(toProjectID).Write(); err != nil {
+		return TaskView{}, err
+	}
+	var v TaskView
+	err := t.ts.ps.as.a.db.update(func(x *tx) error {
+		agg, err := loadMoveTask(x, t.ts.tid, toProjectID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		v = agg.save(x)
+		return nil
+	})
+	return v, err
+}
