+func TestSetMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"contributor cannot promote self", "ben", "/projects/web/members/ben", `{"role":"manager"}`, 403},
+		{"contributor cannot change others", "ben", "/projects/web/members/cat", `{"role":"viewer"}`, 403},
+		{"viewer cannot change roles", "dan", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"org admin cannot change roles", "eve", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"manager of other project", "ann", "/projects/ops/members/cat", `{"role":"viewer"}`, 403},
+		{"non member", "hal", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"other org", "gus", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"anonymous", "", "/projects/web/members/ben", `{"role":"viewer"}`, 401},
+		{"unknown user", "zed", "/projects/web/members/ben", `{"role":"viewer"}`, 401},
+		{"project missing", "ann", "/projects/nope/members/ben", `{"role":"viewer"}`, 404},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"invalid role", "ann", "/projects/web/members/ben", `{"role":"owner"}`, 400},
+		{"missing role", "ann", "/projects/web/members/ben", `{}`, 400},
+		{"empty role", "ann", "/projects/web/members/ben", `{"role":""}`, 400},
+		{"bad body", "ann", "/projects/web/members/ben", `not json`, 400},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"target in other project", "ann", "/projects/web/members/gus", `{"role":"viewer"}`, 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestSetMemberRoleResponseAndEffect(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["userId"] != "ben" || got["role"] != "viewer" {
+		t.Fatalf("unexpected body %s", body)
+	}
+	// ben was a contributor; now a viewer, so creating a task must be refused.
+	code, body = do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`)
+	if code != 403 {
+		t.Fatalf("demoted user create: got %d body=%s", code, body)
+	}
+	// and a promoted user can now delete tasks.
+	if code, _ := do(t, h, "PUT", "/projects/web/members/cat", "ann", `{"role":"manager"}`); code != 200 {
+		t.Fatalf("promote cat: got %d", code)
+	}
+	if code, body := do(t, h, "DELETE", "/projects/web/tasks/t1", "cat", ""); code != 204 {
+		t.Fatalf("promoted user delete: got %d body=%s", code, body)
+	}
+}
