+
+type moveRequest struct {
+	ToProjectID string `json:"toProjectId"`
+}
+
+type moveResponse struct {
+	UserID    string `json:"userId"`
+	ProjectID string `json:"projectId"`
+	Role      string `json:"role"`
+}
+
+// moveMember removes a member from the path project and adds them to
+// toProjectId with the same role. Nothing changes unless every check passes.
+func (s *server) moveMember(w http.ResponseWriter, r *http.Request) {
+	s.store.mu.Lock()
+	defer s.store.mu.Unlock()
+
+	user := s.store.User(r.Header.Get("X-User"))
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	src := s.store.Project(r.PathValue("pid"))
+	if src == nil || src.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role := s.store.Role(src.ID, user.ID)
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if src.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req moveRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || req.ToProjectID == "" {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	if req.ToProjectID == src.ID {
+		writeError(w, 400, "destination must differ from the source project")
+		return
+	}
+	dst := s.store.Project(req.ToProjectID)
+	if dst == nil || dst.OrgID != user.OrgID {
+		writeError(w, 404, "destination project not found")
+		return
+	}
+	dstRole := s.store.Role(dst.ID, user.ID)
+	if dstRole == "" && !user.OrgAdmin {
+		writeError(w, 404, "destination project not found")
+		return
+	}
+	if dstRole != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if dst.Archived {
+		writeError(w, 409, "destination project is archived")
+		return
+	}
+	uid := r.PathValue("uid")
+	memberRole := s.store.Role(src.ID, uid)
+	if memberRole == "" {
+		writeError(w, 404, "member not found")
+		return
+	}
+	if s.store.Role(dst.ID, uid) != "" {
+		writeError(w, 409, "user is already a member of the destination project")
+		return
+	}
+	s.store.RemoveMember(src.ID, uid)
+	s.store.AddMember(dst.ID, uid, memberRole)
+	writeJSON(w, 200, moveResponse{UserID: uid, ProjectID: dst.ID, Role: memberRole})
+}
