+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, from, task, body string
+		want                         int
+	}{
+		{"contributor moves own task", "cat", "web", "t2", `{"toProjectId":"ops"}`, 200},
+		{"contributor moves own task back", "cat", "ops", "t4", `{"toProjectId":"web"}`, 200},
+		{"contributor moves others task", "cat", "web", "t1", `{"toProjectId":"ops"}`, 403},
+		{"contributor cannot move unassigned", "cat", "web", "t3", `{"toProjectId":"ops"}`, 403},
+		{"manager in both moves any", "ivy", "web", "t1", `{"toProjectId":"ops"}`, 200},
+		{"manager in both moves unassigned", "ivy", "web", "t3", `{"toProjectId":"ops"}`, 200},
+		{"archived source rejects even for manager", "ann", "legacy", "t5", `{"toProjectId":"web"}`, 409},
+		{"not member of dest", "ben", "web", "t1", `{"toProjectId":"ops"}`, 404},
+		{"viewer in dest", "ann", "web", "t1", `{"toProjectId":"ops"}`, 403},
+		{"org admin cannot write", "eve", "web", "t1", `{"toProjectId":"ops"}`, 403},
+		{"viewer in source", "dan", "web", "t1", `{"toProjectId":"ops"}`, 404},
+		{"non member of source", "hal", "web", "t1", `{"toProjectId":"ops"}`, 404},
+		{"archived dest", "ann", "web", "t1", `{"toProjectId":"legacy"}`, 409},
+		{"archived source", "ann", "legacy", "t5", `{"toProjectId":"web"}`, 409},
+		{"other org dest", "ann", "web", "t1", `{"toProjectId":"gx"}`, 404},
+		{"missing dest", "ivy", "web", "t1", `{"toProjectId":"nope"}`, 404},
+		{"same project", "ivy", "web", "t1", `{"toProjectId":"web"}`, 400},
+		{"bad body", "ivy", "web", "t1", `{}`, 400},
+		{"task in other project", "ivy", "web", "t4", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "web", "t1", `{"toProjectId":"ops"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.from+"/tasks/"+c.task+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsFields(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got Task
+	json.Unmarshal([]byte(body), &got)
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", Assignee: "cat"}
+	if got != want {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks/t2", "ivy", ""); code != 200 {
+		t.Fatalf("task not in ops: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t2", "ivy", ""); code != 404 {
+		t.Fatalf("task still in web: %d", code)
+	}
+}
