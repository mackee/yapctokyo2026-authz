+// transferUserAggregate moves one user to another organization. Project members
+// and assignees must belong to the project's organization, so the memberships
+// and assigned tasks the user has in projects outside the new organization go
+// with the move: the memberships are removed and the tasks unassigned.
+type transferUserAggregate struct {
+	user        *User
+	toOrg       string
+	memberships []*Membership // memberships in projects outside toOrg
+	tasks       []*Task       // tasks assigned to the user in projects outside toOrg
+}
+
+func loadTransferUser(ctx context.Context, tx DB, fromOrg, userID, toOrg string) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != fromOrg {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	a := &transferUserAggregate{user: u, toOrg: toOrg}
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, m := range ms {
+		outside, err := projectOutside(ctx, tx, m.ProjectID, toOrg)
+		if err != nil {
+			return nil, err
+		}
+		if outside {
+			a.memberships = append(a.memberships, m)
+		}
+	}
+	ts, err := u.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, t := range ts {
+		outside, err := projectOutside(ctx, tx, t.ProjectID, toOrg)
+		if err != nil {
+			return nil, err
+		}
+		if outside {
+			a.tasks = append(a.tasks, t)
+		}
+	}
+	return a, nil
+}
+
+// projectOutside reports whether the project is not in organization org. A
+// project that does not exist is outside every organization.
+func projectOutside(ctx context.Context, tx DB, projectID, org string) (bool, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return true, nil
+	} else if err != nil {
+		return false, err
+	}
+	return p.Org != org, nil
+}
+
+func (a *transferUserAggregate) validate() error { return nil }
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	a.user.Org = a.toOrg
+	a.user.OrgAdmin = false
+	if err := a.user.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
