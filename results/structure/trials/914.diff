+
+// UserTransferInput is the input of UserTable.Transfer.
+type UserTransferInput struct {
+	ToOrgID string
+}
+
+// Transfer moves the user from the organization of authz to ToOrgID. The
+// user's memberships and task assignments in projects outside the new
+// organization are removed in the same transaction, and the user's org admin
+// right does not follow them. Only org admins of the organization may do this
+// (else ErrForbidden); a user outside that organization is ErrNotFound.
+func (*UserTable) Transfer(ctx context.Context, db DB, authz OrgAuthz, userID string, in UserTransferInput) (*User, error) {
+	if err := authz.CanTransferUsers(); err != nil {
+		return nil, err
+	}
+	if in.ToOrgID == "" {
+		return nil, deny(ErrInvalid, "toOrgId must not be empty")
+	}
+	if in.ToOrgID == authz.Org() {
+		return nil, deny(ErrInvalid, "user already belongs to that organization")
+	}
+	var u *User
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadTransferUser(ctx, tx, authz.Org(), userID, in.ToOrgID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if u, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return u, nil
+}
