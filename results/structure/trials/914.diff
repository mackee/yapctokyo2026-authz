+func TestTransferUserCleansAcmeRows(t *testing.T) {
+	ctx := context.Background()
+	db, err := Open()
+	if err != nil {
+		t.Fatal(err)
+	}
+	authz, err := NewOrgAuthz(Actor{id: "eve", org: "acme", orgAdmin: true}, "acme")
+	if err != nil {
+		t.Fatal(err)
+	}
+	// ben: contributor in web and legacy (archived), assigned t1 (web), t5 (legacy).
+	u, err := NewUserTable().Transfer(ctx, db, authz, "ben", UserTransferInput{ToOrgID: "globex"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if u.Org != "globex" || u.OrgAdmin {
+		t.Fatalf("got %+v", u)
+	}
+	ms, err := NewMembershipTable().ListByUser(ctx, db, "ben")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(ms) != 0 {
+		t.Fatalf("ben still has %d memberships", len(ms))
+	}
+	ts, err := NewTaskTable().ListByAssignee(ctx, db, "ben")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(ts) != 0 {
+		t.Fatalf("ben still assigned to %d tasks", len(ts))
+	}
+	// cat's acme assignments are not touched.
+	ts, err = NewTaskTable().ListByAssignee(ctx, db, "cat")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(ts) != 2 {
+		t.Fatalf("cat has %d tasks, want 2", len(ts))
+	}
+}
+
+func TestTransferUserKeepsSameOrgMembershipsOfOthers(t *testing.T) {
+	ctx := context.Background()
+	db, err := Open()
+	if err != nil {
+		t.Fatal(err)
+	}
+	authz, err := NewOrgAuthz(Actor{id: "eve", org: "acme", orgAdmin: true}, "acme")
+	if err != nil {
+		t.Fatal(err)
+	}
+	// ivy: manager in web and ops (both acme); moving her touches both.
+	if _, err := NewUserTable().Transfer(ctx, db, authz, "ivy", UserTransferInput{ToOrgID: "globex"}); err != nil {
+		t.Fatal(err)
+	}
+	ms, err := NewMembershipTable().ListByProject(ctx, db, "web")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, m := range ms {
+		if m.UserID == "ivy" {
+			t.Fatal("ivy still a member of web")
+		}
+	}
+	// ann keeps her web membership.
+	m, err := NewMembershipTable().Find(ctx, db, "web", "ann")
+	if err != nil || m.Role != RoleManager {
+		t.Fatalf("ann's web membership changed: %v %+v", err, m)
+	}
+}
