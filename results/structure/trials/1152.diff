+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"second manager", "ivy", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"unknown user", "zed", "web", 401},
+		{"anonymous", "", "web", 401},
+		{"missing project", "ann", "missing", 404},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	want := `[{"userId":"ann","role":"viewer"},{"userId":"ben","role":"viewer"},{"userId":"cat","role":"viewer"},{"userId":"dan","role":"viewer"},{"userId":"ivy","role":"viewer"}]`
+	if got := strings.TrimSpace(body); got != want {
+		t.Fatalf("got body\n%s\nwant\n%s", got, want)
+	}
+}
+
+func TestFrozenProjectRejectsTaskWrites(t *testing.T) {
+	s := newServer()
+	if code, body := do(t, s, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze got %d: %s", code, body)
+	}
+
+	cases := []struct {
+		name, method, user, path, body string
+		want                           int
+	}{
+		{"create by former manager", "POST", "ann", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"create by former second manager", "POST", "ivy", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"create by former contributor", "POST", "ben", "/projects/web/tasks", `{"title":"x","assignee":"ben"}`, 403},
+		{"update own task", "PATCH", "ben", "/projects/web/tasks/t1", `{"status":"done"}`, 403},
+		{"update by former manager", "PATCH", "ann", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"delete by former manager", "DELETE", "ann", "/projects/web/tasks/t1", "", 403},
+		{"freeze again", "POST", "ann", "/projects/web/freeze", "", 403},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, s, c.method, c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+
+	// Reads still work, and the rejected writes changed nothing.
+	code, body := do(t, s, "GET", "/projects/web/tasks/t1", "dan", "")
+	if code != 200 {
+		t.Fatalf("read got %d", code)
+	}
+	if !strings.Contains(body, `"status":"open"`) {
+		t.Fatalf("t1 changed: %s", body)
+	}
+}
+
+func TestFreezeOnlyAffectsThatProject(t *testing.T) {
+	s := newServer()
+	if code, body := do(t, s, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze got %d: %s", code, body)
+	}
+	// ivy is a manager of ops, which was not frozen.
+	if code, body := do(t, s, "POST", "/projects/ops/tasks", "ivy", `{"title":"x"}`); code != 200 {
+		t.Fatalf("ops create got %d: %s", code, body)
+	}
+}
