+// changeRoleAggregate changes the role of one member of one project.
+type changeRoleAggregate struct {
+	member   *Membership
+	role     string
+	assigned []*Task // member.AssignedTasks: tasks that need the member to stay a writer
+}
+
+func loadChangeRole(ctx context.Context, tx DB, projectID, userID, role string) (*changeRoleAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	m, err := p.Membership(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	tasks, err := m.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &changeRoleAggregate{member: m, role: role, assigned: tasks}, nil
+}
+
+func (a *changeRoleAggregate) validate() error {
+	if !validRoles[a.role] {
+		return deny(ErrInvalid, "invalid role")
+	}
+	if !isWriterRole(a.role) && len(a.assigned) > 0 {
+		return deny(ErrInvalid, "member has assigned tasks and must remain a contributor or manager")
+	}
+	return nil
+}
+
+func (a *changeRoleAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.member.changeRole(ctx, tx, a.role); err != nil {
+		return nil, err
+	}
+	return a.member, nil
+}
