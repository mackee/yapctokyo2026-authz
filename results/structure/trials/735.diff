+func TestUpdateMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, project, target, body string
+		want                              int
+	}{
+		{"contributor cannot change roles", "ben", "web", "dan", `{"role":"contributor"}`, 403},
+		{"viewer cannot change roles", "dan", "web", "ben", `{"role":"viewer"}`, 403},
+		{"org admin cannot change roles", "eve", "web", "dan", `{"role":"contributor"}`, 403},
+		{"manager of another project cannot", "ann", "ops", "cat", `{"role":"viewer"}`, 403},
+		{"non member", "hal", "web", "dan", `{"role":"contributor"}`, 404},
+		{"other org", "gus", "web", "dan", `{"role":"contributor"}`, 404},
+		{"target not a member", "ann", "web", "hal", `{"role":"contributor"}`, 404},
+		{"target in other project only", "ann", "web", "gus", `{"role":"contributor"}`, 404},
+		{"archived project", "ann", "legacy", "ben", `{"role":"viewer"}`, 409},
+		{"demote contributor with assigned task", "ann", "web", "ben", `{"role":"viewer"}`, 400},
+		{"demote contributor with assigned task to viewer", "ann", "web", "cat", `{"role":"viewer"}`, 400},
+		{"invalid role", "ann", "web", "dan", `{"role":"owner"}`, 400},
+		{"missing role", "ann", "web", "dan", `{}`, 400},
+		{"bad json", "ann", "web", "dan", `{"role":`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members/"+c.target, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRoleResponseAndEffect(t *testing.T) {
+	srv := newServer()
+
+	code, body := do(t, srv, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatalf("promote: got %d body=%s", code, body)
+	}
+	var got struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.UserID != "dan" || got.Role != "contributor" {
+		t.Fatalf("response = %+v", got)
+	}
+
+	// dan was a viewer and could not create tasks; as a contributor he can.
+	if code, body := do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("promoted member create: got %d body=%s", code, body)
+	}
+
+	// Demoting dan again removes the right to write.
+	if code, body := do(t, srv, "PUT", "/projects/web/members/dan", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote: got %d body=%s", code, body)
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"y"}`); code != 403 {
+		t.Fatalf("demoted member create: got %d want 403", code)
+	}
+}
