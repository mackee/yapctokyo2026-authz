+// updateMembershipAggregate changes one member's role in one project.
+type updateMembershipAggregate struct {
+	membership *Membership
+	role       string
+	assigned   []*Task // the member's tasks in the project; loaded only when the new role cannot hold tasks
+}
+
+func loadUpdateMembership(ctx context.Context, tx DB, projectID, userID, role string) (*updateMembershipAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &updateMembershipAggregate{membership: m, role: role}
+	if !isWriterRole(role) {
+		a.assigned, err = m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+	}
+	return a, nil
+}
+
+func (a *updateMembershipAggregate) validate() error {
+	if !isWriterRole(a.role) && len(a.assigned) > 0 {
+		return deny(ErrInvalid, "member still has tasks assigned in the project; reassign or unassign them first")
+	}
+	return nil
+}
+
+func (a *updateMembershipAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.membership.setRole(ctx, tx, a.role); err != nil {
+		return nil, err
+	}
+	return a.membership, nil
+}
