 }
+
+// OrgExists reports whether the organization has any user or project.
+func (*UserTable) OrgExists(ctx context.Context, db DB, org string) (bool, error) {
+	var n int
+	if err := db.QueryRowContext(ctx,
+		`SELECT (SELECT COUNT(*) FROM users WHERE org_id = ?) + (SELECT COUNT(*) FROM projects WHERE org_id = ?)`,
+		org, org).Scan(&n); err != nil {
+		return false, err
+	}
+	return n > 0, nil
+}
+
+// Transfer moves a user of the authorization object's organization to another
+// organization. The user loses their project memberships and task assignments
+// (they belong to the old organization's projects) and their org admin flag.
+func (*UserTable) Transfer(ctx context.Context, db DB, authz OrgAuthz, userID, toOrg string) (*User, error) {
+	if err := authz.CanManageUsers(); err != nil {
+		return nil, err
+	}
+	if toOrg == "" {
+		return nil, deny(ErrInvalid, "toOrgId must not be empty")
+	}
+	var u *User
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadTransferUser(ctx, tx, authz.OrgID(), userID, toOrg)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		u, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return u, nil
+}
