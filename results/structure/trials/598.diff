+// changeRolesAggregate changes the roles of several members of one project.
+type changeRolesAggregate struct {
+	project     *Project
+	members     []*Membership // in user ID order, one per entry of roles
+	roles       map[string]string
+	hasAssigned map[string]bool // members who are assignees of tasks of the project
+}
+
+func loadChangeRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*changeRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	ids := make([]string, 0, len(roles))
+	for id := range roles {
+		ids = append(ids, id)
+	}
+	sort.Strings(ids)
+	a := &changeRolesAggregate{project: p, roles: roles, hasAssigned: map[string]bool{}}
+	for _, id := range ids {
+		m, err := p.Membership(ctx, tx, id)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "user "+id+" is not a member of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		a.members = append(a.members, m)
+		if roles[id] == RoleViewer {
+			tasks, err := m.AssignedTasks(ctx, tx)
+			if err != nil {
+				return nil, err
+			}
+			a.hasAssigned[id] = len(tasks) > 0
+		}
+	}
+	return a, nil
+}
+
+func (a *changeRolesAggregate) validate() error {
+	for _, m := range a.members {
+		if !validRoles[a.roles[m.UserID]] {
+			return deny(ErrInvalid, "invalid role for "+m.UserID)
+		}
+		if a.hasAssigned[m.UserID] {
+			return deny(ErrInvalid, m.UserID+" has assigned tasks and cannot become a viewer")
+		}
+	}
+	return nil
+}
+
+// apply saves the new roles and returns the project's members.
+func (a *changeRolesAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for _, m := range a.members {
+		if err := m.setRole(ctx, tx, a.roles[m.UserID]); err != nil {
+			return nil, err
+		}
+	}
+	return a.project.Memberships(ctx, tx)
+}
+
