 // NewMembershipTable returns the memberships table.
 func NewMembershipTable() *MembershipTable { return &MembershipTable{} }
 
+var validRoles = map[string]bool{RoleManager: true, RoleContributor: true, RoleViewer: true}
+
+// MemberRole is the JSON shape of a project member.
+type MemberRole struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func toMemberRoles(ms []*Membership) []MemberRole {
+	out := make([]MemberRole, 0, len(ms))
+	for _, m := range ms {
+		out = append(out, MemberRole{UserID: m.UserID, Role: m.Role})
+	}
+	return out
+}
+
+// ChangeRoles changes the roles of several members of the project, all or
+// nothing, and returns the project's members. roles maps user ID to the new
+// role (manager, contributor or viewer).
+func (*MembershipTable) ChangeRoles(ctx context.Context, db DB, authz ProjectAuthz, roles map[string]string) ([]MemberRole, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if len(roles) == 0 {
+		return nil, deny(ErrInvalid, "roles must not be empty")
+	}
+	var ms []*Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadChangeRoles(ctx, tx, authz.ProjectID(), roles)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		ms, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return toMemberRoles(ms), nil
+}
+
