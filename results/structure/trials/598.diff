+func members(t *testing.T, h http.Handler) map[string]string {
+	t.Helper()
+	// Members are only exposed by PUT; an empty-change read is not available,
+	// so read the roles back through a no-op change of a manager.
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ann":"manager"}}`)
+	if code != 200 {
+		t.Fatalf("read back: got %d %s", code, body)
+	}
+	var list []struct{ UserID, Role string }
+	if err := json.Unmarshal([]byte(body), &list); err != nil {
+		t.Fatal(err)
+	}
+	out := map[string]string{}
+	for _, m := range list {
+		out[m.UserID] = m.Role
+	}
+	return out
+}
+
+func TestChangeRoles(t *testing.T) {
+	t.Run("success returns members", func(t *testing.T) {
+		h := newServer()
+		code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","ivy":"viewer"}}`)
+		if code != 200 {
+			t.Fatalf("got %d %s", code, body)
+		}
+		var list []map[string]string
+		if err := json.Unmarshal([]byte(body), &list); err != nil {
+			t.Fatal(err)
+		}
+		got := map[string]string{}
+		for _, m := range list {
+			got[m["userId"]] = m["role"]
+		}
+		want := map[string]string{"ann": "manager", "ben": "contributor", "cat": "contributor", "dan": "contributor", "ivy": "viewer"}
+		if len(got) != len(want) {
+			t.Fatalf("got %v want %v", got, want)
+		}
+		for k, v := range want {
+			if got[k] != v {
+				t.Fatalf("got %v want %v", got, want)
+			}
+		}
+	})
+
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"viewer with assigned tasks", "ann", "/projects/web/members", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 400},
+		{"unknown role", "ann", "/projects/web/members", `{"roles":{"dan":"admin"}}`, 400},
+		{"non member", "ann", "/projects/web/members", `{"roles":{"dan":"contributor","hal":"viewer"}}`, 400},
+		{"empty roles", "ann", "/projects/web/members", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "/projects/web/members", `{}`, 400},
+		{"contributor", "ben", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin", "eve", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 403},
+		{"archived", "ann", "/projects/legacy/members", `{"roles":{"ben":"manager"}}`, 409},
+		{"other org", "gus", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 404},
+		{"unauthenticated", "", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+
+	t.Run("all or nothing", func(t *testing.T) {
+		h := newServer()
+		code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"manager","ben":"viewer"}}`)
+		if code != 400 {
+			t.Fatalf("got %d want 400", code)
+		}
+		if got := members(t, h)["dan"]; got != "viewer" {
+			t.Fatalf("dan changed to %q despite the failure", got)
+		}
+	})
+}
