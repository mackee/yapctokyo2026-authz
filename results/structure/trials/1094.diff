diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..33c7896
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,54 @@
+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestChangeRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"contributor forbidden", "ben", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"viewer forbidden", "dan", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"org admin forbidden", "eve", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"archived project", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"unknown member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"unreadable project", "hal", "/projects/web/members/dan", `{"role":"viewer"}`, 404},
+		{"other org", "ann", "/projects/gx/members/gus", `{"role":"viewer"}`, 404},
+		{"unauthenticated", "", "/projects/web/members/dan", `{"role":"viewer"}`, 401},
+		{"invalid role", "ann", "/projects/web/members/dan", `{"role":"boss"}`, 400},
+		{"missing role", "ann", "/projects/web/members/dan", `{}`, 400},
+		{"bad json before access", "ben", "/projects/web/members/dan", `{`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestChangeRoleResponseAndEffect(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`)
+	if code != 200 || strings.TrimSpace(body) != `{"userId":"ben","role":"viewer"}` {
+		t.Fatalf("got %d %s", code, body)
+	}
+	// ben is now a viewer: cannot write, and his task was unassigned.
+	if code, body := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 403 {
+		t.Fatalf("viewer patch: got %d %s", code, body)
+	}
+	_, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if !strings.Contains(body, `"assignee":""`) {
+		t.Fatalf("task should be unassigned: %s", body)
+	}
+	// other projects are untouched
+	_, body = do(t, h, "GET", "/projects/ops/tasks/t4", "ann", "")
+	if !strings.Contains(body, `"assignee":"cat"`) {
+		t.Fatalf("other project changed: %s", body)
+	}
+}
