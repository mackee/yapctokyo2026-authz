+
+// removeOrgUserAggregate removes one user from every project of the
+// organization: their memberships go, and the tasks they were assigned in those
+// projects are unassigned (an assignee must be a member of the task's project).
+type removeOrgUserAggregate struct {
+	memberships []*Membership // the user's memberships, all in the organization
+	assigned    []*Task       // the tasks assigned to the user in those projects
+}
+
+func loadRemoveOrgUser(ctx context.Context, tx DB, orgID, userID string) (*removeOrgUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != orgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	a := &removeOrgUserAggregate{}
+	if a.memberships, err = u.Memberships(ctx, tx); err != nil {
+		return nil, err
+	}
+	for _, m := range a.memberships {
+		tasks, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.assigned = append(a.assigned, tasks...)
+	}
+	return a, nil
+}
+
+func (a *removeOrgUserAggregate) validate() error { return nil }
+
+func (a *removeOrgUserAggregate) apply(ctx context.Context, tx DB) error {
+	for _, t := range a.assigned {
+		if err := t.unassign(ctx, tx); err != nil {
+			return err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return err
+		}
+	}
+	return nil
+}
