+// RemoveFromOrgProjects removes the user from every project of the
+// organization (offboarding). Org admins only. The user must belong to the
+// organization, otherwise ErrNotFound. Removing a user who is no longer a member
+// anywhere succeeds and changes nothing. Archived projects are not refused: the
+// membership must be removable there too.
+func (*UserTable) RemoveFromOrgProjects(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanManageMembers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveOrgUser(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
