+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes member of archived project", "eve", "/orgs/acme/users/ann", 204},
+		{"org admin removes user with no memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"manager of a project is not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"user removes self", "ben", "/orgs/acme/users/ben", 403},
+		{"other org caller", "gus", "/orgs/acme/users/ben", 404},
+		{"organization not visible", "eve", "/orgs/nowhere/users/ben", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	srv := newServer()
+
+	// Before: ben is a contributor of web and legacy, and is assigned t1 (web) and t5 (legacy).
+	if code, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ann", ""); code != 200 || !strings.Contains(body, `"assignee":"ben"`) {
+		t.Fatalf("before: got %d %s", code, body)
+	}
+
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+
+	// ben can no longer read the projects, in any state.
+	for _, path := range []string{"/projects/web/tasks", "/projects/legacy/tasks", "/projects/legacy/tasks/t5"} {
+		if code, _ := do(t, srv, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("ben GET %s: got %d want 404", path, code)
+		}
+	}
+
+	// ben's assignments are cleared, in web and in the archived legacy project.
+	if code, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ann", ""); code != 200 || !strings.Contains(body, `"assignee":""`) {
+		t.Fatalf("t1 after removal: got %d %s", code, body)
+	}
+	if code, body := do(t, srv, "GET", "/projects/legacy/tasks/t5", "ann", ""); code != 200 || !strings.Contains(body, `"assignee":""`) {
+		t.Fatalf("t5 after removal: got %d %s", code, body)
+	}
+
+	// Other members and assignments are untouched.
+	if code, body := do(t, srv, "GET", "/projects/web/tasks/t2", "ann", ""); code != 200 || !strings.Contains(body, `"assignee":"cat"`) {
+		t.Fatalf("t2 after removal: got %d %s", code, body)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat GET web: got %d want 200", code)
+	}
+
+	// Removing again is still a success and changes nothing.
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("second remove: got %d want 204", code)
+	}
+}
