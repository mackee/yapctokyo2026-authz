+// frozenMember is the JSON shape of a member in the freeze response.
+type frozenMember struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func freezeProject(ctx tanukirpc.Context[*projectRegistry], _ struct{}) ([]frozenMember, error) {
+	reg := ctx.Registry()
+	members, err := model.NewProjectTable().Freeze(ctx, reg.db, reg.authz)
+	if err != nil {
+		return nil, err
+	}
+	out := make([]frozenMember, 0, len(members))
+	for _, m := range members {
+		out = append(out, frozenMember{UserID: m.UserID, Role: m.Role})
+	}
+	return out, nil
+}
