+func TestFreezeDenied(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"manager of other project only", "ann", "ops", 403}, // ann is a viewer in ops
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreeze(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got []map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []string{"ann", "ben", "cat", "dan", "ivy"}
+	if len(got) != len(want) {
+		t.Fatalf("got %v", got)
+	}
+	for i, m := range got {
+		if len(m) != 2 || m["userId"] != want[i] || m["role"] != "viewer" {
+			t.Fatalf("member %d: %v", i, m)
+		}
+	}
+
+	// Nobody can change tasks any more, managers included.
+	for _, c := range []struct{ user, method, path, body string }{
+		{"ann", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"ivy", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"ann", "DELETE", "/projects/web/tasks/t3", ""},
+		{"ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+	} {
+		if code, _ := do(t, h, c.method, c.path, c.user, c.body); code != 403 {
+			t.Fatalf("%s %s by %s: got %d want 403", c.method, c.path, c.user, code)
+		}
+	}
+	// A frozen project cannot be frozen again (no manager is left).
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 403 {
+		t.Fatalf("refreeze: got %d want 403", code)
+	}
+	// Reads still work, and other projects are untouched.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("read: got %d", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/ops/tasks", "cat", `{"title":"x"}`); code != 200 {
+		t.Fatalf("other project: got %d want 200", code)
+	}
+}
+
