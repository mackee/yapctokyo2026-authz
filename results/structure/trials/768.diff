index 89224a1..f3b2cdd 100644
--- a/internal/model/authz.go
+++ b/internal/model/authz.go
@@ -121,6 +121,24 @@ func (a TaskAuthz) CanManage() error {
 	return nil
 }
 
+// CanMove returns nil if the actor may move the task to the project dest:
+// contributor or manager in both projects (else ErrForbidden); when the actor
+// is not a manager in both, only a task assigned to the actor (else
+// ErrForbidden); neither project archived (else ErrArchived).
+func (a TaskAuthz) CanMove(dest ProjectAuthz) error {
+	if !a.CanRead() || !dest.CanRead() || !isWriterRole(a.project.role) || !isWriterRole(dest.role) {
+		return deny(ErrForbidden, "forbidden")
+	}
+	bothManager := a.project.role == RoleManager && dest.role == RoleManager
+	if !bothManager && !a.isAssignee {
+		return deny(ErrForbidden, "only managers of both projects may move tasks assigned to others")
+	}
+	if a.project.archived || dest.archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	return nil
+}
