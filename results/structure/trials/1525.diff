-// MembershipTable reads the memberships table.
+// MembershipTable is the memberships table.
+//
+// Find and List* read rows. Move is an API operation: it takes the database,
+// the authorization object of the source project and an input; it asks the
+// authorization objects whether the actor may perform it, then runs the
+// operation's aggregate (aggregate.go) in a transaction.
 type MembershipTable struct{}
 
 // NewMembershipTable returns the memberships table.
 func NewMembershipTable() *MembershipTable { return &MembershipTable{} }
 
+// MembershipTableMoveInput is the input of MembershipTable.Move.
+type MembershipTableMoveInput struct {
+	UserID      string // the member to move, from the source project
+	ToProjectID string // the destination project
+}
+
+// Move moves a member out of the source project (from's project) into the
+// destination project, keeping the member's role. The actor must manage both
+// projects. The member's tasks in the source project are unassigned, since
+// they are no longer members there.
+func (*MembershipTable) Move(ctx context.Context, db DB, from ProjectAuthz, in MembershipTableMoveInput) (*Membership, error) {
+	if err := from.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	to, err := NewProjectAuthz(ctx, db, from.Actor(), in.ToProjectID)
+	if err != nil {
+		return nil, err
+	}
+	if err := to.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if to.ProjectID() == from.ProjectID() {
+		return nil, deny(ErrInvalid, "member is already in the project")
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveMember(ctx, tx, from.ProjectID(), to.ProjectID(), in.UserID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if m, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
+
