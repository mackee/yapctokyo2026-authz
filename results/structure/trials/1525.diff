+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager of both", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 200},
+		{"viewer keeps role", "ivy", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 200},
+		{"already in destination", "ivy", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 400},
+		{"same project", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"web"}`, 400},
+		{"not a member of source", "ivy", "/projects/ops/members/dan/move", `{"toProjectId":"web"}`, 404},
+		{"unknown member", "ivy", "/projects/web/members/zed/move", `{"toProjectId":"ops"}`, 404},
+		{"destination missing", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"nope"}`, 404},
+		{"destination in other org", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"gx"}`, 404},
+		{"manager of source only", "ann", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer of source", "dan", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"contributor of source", "ben", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin", "eve", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"non member of source", "hal", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"other org", "gus", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 401},
+		{"archived destination", "ann", "/projects/web/members/ben/move", `{"toProjectId":"legacy"}`, 409},
+		{"archived source", "ann", "/projects/legacy/members/ben/move", `{"toProjectId":"web"}`, 409},
+		{"missing destination", "ivy", "/projects/web/members/ben/move", `{}`, 400},
+		{"empty destination", "ivy", "/projects/web/members/ben/move", `{"toProjectId":""}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveResponseAndEffects(t *testing.T) {
+	h := newServer()
+
+	code, body := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]string{"userId": "ben", "projectId": "ops", "role": "contributor"}
+	if len(got) != len(want) {
+		t.Fatalf("response %s, want keys %v", body, want)
+	}
+	for k, v := range want {
+		if got[k] != v {
+			t.Fatalf("response %s: %s = %q, want %q", body, k, got[k], v)
+		}
+	}
+
+	// ben is no longer in web and is now a contributor in ops.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads web after move: got %d want 404", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben reads ops after move: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/ops/tasks", "ben", `{"title":"x","assignee":"ben"}`); code != 200 {
+		t.Fatalf("ben creates in ops after move: got %d want 200", code)
+	}
+
+	// ben's task in web (t1) is unassigned, not left pointing at a non-member.
+	code, body = do(t, h, "GET", "/projects/web/tasks/t1", "ivy", "")
+	if code != 200 {
+		t.Fatalf("get t1: got %d", code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "" {
+		t.Fatalf("t1 still assigned to %q after move", task.AssigneeID)
+	}
+}
