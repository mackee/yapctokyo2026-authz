new file mode 100644
index 0000000..d71b70c
--- /dev/null
+++ b/members.go
@@ -0,0 +1,129 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+)
+
+type memberJSON struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+type bulkRolesRequest struct {
+	Roles map[string]string `json:"roles"`
+}
+
+var validRoles = map[string]bool{RoleManager: true, RoleContributor: true, RoleViewer: true}
+
+// setMemberRoles changes the roles of several existing project members at once.
+// Only managers may do it. It is all-or-nothing: if any entry is invalid the
+// request fails and nothing changes. A member who becomes a viewer loses their
+// task assignments in the project, and the project must keep at least one manager.
+func (s *server) setMemberRoles(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role, err := findRole(ctx, s.db, project.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req bulkRolesRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || len(req.Roles) == 0 {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	for _, newRole := range req.Roles {
+		if !validRoles[newRole] {
+			writeError(w, 400, "invalid role")
+			return
+		}
+	}
+
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+	for uid, newRole := range req.Roles {
+		res, err := tx.ExecContext(ctx, `UPDATE memberships SET role = ? WHERE project_id = ? AND user_id = ?`, newRole, project.ID, uid)
+		if err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+		if n, err := res.RowsAffected(); err != nil || n != 1 {
+			writeError(w, 400, "not a member of the project: "+uid)
+			return
+		}
+		if newRole == RoleViewer {
+			if _, err := tx.ExecContext(ctx, `UPDATE tasks SET assignee = '' WHERE project_id = ? AND assignee = ?`, project.ID, uid); err != nil {
+				writeError(w, 500, "internal error")
+				return
+			}
+		}
+	}
+	var managers int
+	if err := tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM memberships WHERE project_id = ? AND role = ?`, project.ID, RoleManager).Scan(&managers); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if managers == 0 {
+		writeError(w, 409, "project must keep at least one manager")
+		return
+	}
+	rows, err := tx.QueryContext(ctx, `SELECT user_id, role FROM memberships WHERE project_id = ? ORDER BY user_id`, project.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	list := []memberJSON{}
+	for rows.Next() {
+		var m memberJSON
+		if err := rows.Scan(&m.UserID, &m.Role); err != nil {
+			rows.Close()
+			writeError(w, 500, "internal error")
+			return
+		}
+		list = append(list, m)
+	}
+	rows.Close()
+	if err := rows.Err(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, list)
+}
diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..8722f47
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,109 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+type member struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// roleSnapshot returns "user:role" for every membership of the project, via the
+// handler's database, so tests can prove that a rejected request changed nothing.
+func roleSnapshot(t *testing.T, h *appHandler, project string) map[string]string {
+	t.Helper()
+	rows, err := h.db.Query(`SELECT user_id, role FROM memberships WHERE project_id = ?`, project)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer rows.Close()
+	m := map[string]string{}
+	for rows.Next() {
+		var u, r string
+		if err := rows.Scan(&u, &r); err != nil {
+			t.Fatal(err)
+		}
+		m[u] = r
+	}
+	return m
+}
+
+func TestBulkRolesSuccess(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []member{{"ann", "manager"}, {"ben", "viewer"}, {"cat", "contributor"}, {"dan", "contributor"}, {"ivy", "manager"}}
+	if len(got) != len(want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("got %v want %v", got, want)
+		}
+	}
+	// ben was assigned t1 and is now a viewer: the task must be unassigned (model rule).
+	_, tb := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(tb), &task)
+	if task.Assignee != "" {
+		t.Fatalf("t1 still assigned to %q", task.Assignee)
+	}
+}
+
+func TestBulkRolesRejected(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"missing project", "ann", "nope", `{"roles":{"dan":"contributor"}}`, 404},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"invalid role", "ann", "web", `{"roles":{"ben":"viewer","dan":"boss"}}`, 400},
+		{"non member target", "ann", "web", `{"roles":{"ben":"viewer","hal":"viewer"}}`, 400},
+		{"other org target", "ann", "web", `{"roles":{"ben":"viewer","gus":"viewer"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"bad json", "ann", "web", `nope`, 400},
+		{"removes last manager", "ann", "web", `{"roles":{"ann":"viewer","ivy":"contributor"}}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			before := roleSnapshot(t, h.(*appHandler), c.project)
+			code, body := do(t, h, "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+			after := roleSnapshot(t, h.(*appHandler), c.project)
+			if len(before) != len(after) {
+				t.Fatalf("memberships changed: %v -> %v", before, after)
+			}
+			for u, r := range before {
+				if after[u] != r {
+					t.Fatalf("memberships changed: %v -> %v", before, after)
+				}
+			}
+		})
+	}
+}
+
+func TestBulkRolesKeepsOneManager(t *testing.T) {
+	// Swapping managers in a single request is fine as long as one remains.
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann", `{"roles":{"ann":"viewer","ben":"manager"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+}
