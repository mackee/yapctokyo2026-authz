@@ -0,0 +1,113 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestRemoveOrgUserStatus(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes user without projects", "eve", "/orgs/acme/users/hal", 204},
+		{"org admin removes self", "eve", "/orgs/acme/users/eve", 204},
+		{"manager is not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"member is not org admin", "ben", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"other org path", "eve", "/orgs/globex/users/gus", 404},
+		{"other org admin cannot touch acme", "gus", "/orgs/acme/users/ben", 404},
+		{"user of another org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserRemovesAllMemberships(t *testing.T) {
+	h := newServer()
+	// cat: web contributor (t2), ops contributor (t4).
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/cat", "eve", ""); code != 204 {
+		t.Fatalf("got %d want 204", code)
+	}
+	// cat can no longer read either project.
+	for _, p := range []string{"web", "ops"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "cat", ""); code != 404 {
+			t.Fatalf("%s: cat still reads project: %d", p, code)
+		}
+	}
+	// Other members are untouched.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben lost access: %d", code)
+	}
+	// Tasks cat held are unassigned, not deleted.
+	for _, tid := range []string{"t2", "t4"} {
+		path := "/projects/web/tasks/" + tid
+		if tid == "t4" {
+			path = "/projects/ops/tasks/t4"
+		}
+		code, body := do(t, h, "GET", path, "ivy", "")
+		if code != 200 {
+			t.Fatalf("%s: got %d", tid, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.AssigneeID != "" {
+			t.Fatalf("%s still assigned to %q", tid, task.AssigneeID)
+		}
+	}
+}
+
+func TestRemoveOrgUserIncludesArchivedProject(t *testing.T) {
+	h := newServer()
+	// ben: web contributor, legacy (archived) contributor with t5.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("got %d want 204", code)
+	}
+	// eve (org admin) can still read the archived project; ben cannot.
+	if code, _ := do(t, h, "GET", "/projects/legacy/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben still reads legacy: %d", code)
+	}
+	code, body := do(t, h, "GET", "/projects/legacy/tasks/t5", "eve", "")
+	if code != 200 {
+		t.Fatalf("got %d", code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "" {
+		t.Fatalf("t5 still assigned to %q", task.AssigneeID)
+	}
+}
+
+func TestRemoveOrgUserOtherOrgUntouched(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/gus", "eve", ""); code != 404 {
+		t.Fatalf("got %d want 404", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks/t6", "gus", ""); code != 200 {
+		t.Fatalf("gus lost access: %d", code)
+	}
+}
+
+func TestRemoveOrgUserTwice(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("first: got %d want 204", code)
+	}
+	// Idempotent: the user is still in the org, just without projects.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("second: got %d want 204", code)
+	}
+}
