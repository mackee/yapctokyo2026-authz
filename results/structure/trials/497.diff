new file mode 100644
index 0000000..0753503
--- /dev/null
+++ b/org_test.go
@@ -0,0 +1,92 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"testing"
+)
+
+func taskAssignee(t *testing.T, srv http.Handler, user, path string) string {
+	t.Helper()
+	code, body := do(t, srv, "GET", path, user, "")
+	if code != 200 {
+		t.Fatalf("GET %s as %s: got %d", path, user, code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	return task.AssigneeID
+}
+
+func TestRemoveUserFromOrg(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin, user in no project", "eve", "/orgs/acme/users/hal", 204},
+		{"org admin, unknown user", "eve", "/orgs/acme/users/zed", 404},
+		{"org admin, user of another org", "eve", "/orgs/acme/users/gus", 404},
+		{"org admin, other org", "gus", "/orgs/acme/users/ben", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ben", 404},
+		{"org member, not admin", "ann", "/orgs/acme/users/ben", 403},
+		{"org member with no project roles", "hal", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown actor", "zed", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveUserFromOrgEffects(t *testing.T) {
+	srv := newServer()
+
+	if code, body := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d %s", code, body)
+	}
+	// Removing again changes nothing and still succeeds.
+	if code, body := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove again: got %d %s", code, body)
+	}
+
+	// ben is no longer a member of web or legacy, so cannot read or write them.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads web: got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/legacy/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads legacy: got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 404 {
+		t.Fatalf("ben writes web: got %d want 404", code)
+	}
+
+	// Tasks ben was assigned in those projects are unassigned, including in the
+	// archived legacy project (t5).
+	if got := taskAssignee(t, srv, "ann", "/projects/web/tasks/t1"); got != "" {
+		t.Fatalf("web t1 assignee: got %q want unassigned", got)
+	}
+	if got := taskAssignee(t, srv, "ann", "/projects/legacy/tasks/t5"); got != "" {
+		t.Fatalf("legacy t5 assignee: got %q want unassigned", got)
+	}
+
+	// Other members and their tasks are untouched.
+	if got := taskAssignee(t, srv, "ann", "/projects/web/tasks/t2"); got != "cat" {
+		t.Fatalf("web t2 assignee: got %q want cat", got)
+	}
+	if got := taskAssignee(t, srv, "ann", "/projects/ops/tasks/t4"); got != "cat" {
+		t.Fatalf("ops t4 assignee: got %q want cat", got)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat reads ops after ben's removal: got %d", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat reads web after ben's removal: got %d", code)
+	}
+}
