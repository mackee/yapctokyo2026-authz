+
+// RemoveFromOrg removes the user from every project of the organization: their
+// memberships there are deleted, and the tasks they were assigned in those
+// projects are unassigned, all in one transaction. Removing a user who is in no
+// project of the organization succeeds and changes nothing. Only org admins may
+// do this (else ErrForbidden); a user who is not in the organization is
+// ErrNotFound.
+func (*UserTable) RemoveFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanManageMembers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveUserFromOrg(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
