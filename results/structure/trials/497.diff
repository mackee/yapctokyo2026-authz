 func (a *deleteTaskAggregate) validate() error { return nil }
 
 func (a *deleteTaskAggregate) apply(ctx context.Context, tx DB) error { return a.task.destroy(ctx, tx) }
+
+// removeUserFromOrgAggregate takes one user out of every project of one
+// organization. It starts from the user (found through the users table) and
+// loads the user's memberships in that organization's projects and the tasks
+// assigned to the user in those projects. Unassigning those tasks keeps the
+// model rule that an assignee is a member of the task's project.
+type removeUserFromOrgAggregate struct {
+	memberships []*Membership
+	assigned    []*Task
+}
+
+func loadRemoveUserFromOrg(ctx context.Context, tx DB, orgID, userID string) (*removeUserFromOrgAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != orgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	a := &removeUserFromOrgAggregate{}
+	for _, m := range ms {
+		p, err := m.Project(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		if p.Org != orgID {
+			continue
+		}
+		a.memberships = append(a.memberships, m)
+		ts, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.assigned = append(a.assigned, ts...)
+	}
+	return a, nil
+}
+
+func (a *removeUserFromOrgAggregate) validate() error { return nil }
+
+func (a *removeUserFromOrgAggregate) apply(ctx context.Context, tx DB) error {
+	for _, t := range a.assigned {
+		if err := t.unassign(ctx, tx); err != nil {
+			return err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return err
+		}
+	}
+	return nil
+}
