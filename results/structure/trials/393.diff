+// setRolesAggregate changes the roles of existing members of one project. All
+// changes are validated before any is applied.
+type setRolesAggregate struct {
+	project projectRecord
+	changes []membershipRecord // existing memberships with their new role
+}
+
+func loadSetRoles(x *tx, projectID string, roles map[string]string) (*setRolesAggregate, error) {
+	p, ok := x.findProject(projectID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	userIDs := make([]string, 0, len(roles))
+	for userID := range roles {
+		userIDs = append(userIDs, userID)
+	}
+	sort.Strings(userIDs) // deterministic error for the first unknown member
+	a := &setRolesAggregate{project: p}
+	for _, userID := range userIDs {
+		m, ok := p.Membership(x, userID)
+		if !ok {
+			return nil, deny(ErrInvalid, "roles can only be changed for existing members")
+		}
+		m.Role = roles[userID]
+		a.changes = append(a.changes, m)
+	}
+	return a, nil
+}
+
+func (a *setRolesAggregate) validate() error {
+	if len(a.changes) == 0 {
+		return deny(ErrInvalid, "roles must not be empty")
+	}
+	for _, m := range a.changes {
+		if !isValidRole(m.Role) {
+			return deny(ErrInvalid, "role must be manager, contributor or viewer")
+		}
+	}
+	return nil
+}
+
+func (a *setRolesAggregate) apply(x *tx) []MemberView {
+	for _, m := range a.changes {
+		m.save(x)
+	}
+	out := []MemberView{}
+	for _, m := range a.project.Memberships(x) {
+		out = append(out, MemberView{UserID: m.UserID, Role: m.Role})
+	}
+	return out
+}
