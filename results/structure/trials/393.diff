+// ManageProject may change the roles of the existing members of one project.
+type ManageProject interface {
+	// SetRoles maps user IDs to new roles. It is all-or-nothing: if any user is
+	// not a member or any role is invalid, nothing changes and an error (400) is
+	// returned. On success it returns the full member list after the change.
+	SetRoles(roles map[string]string) ([]MemberView, error)
+}
+
+type manageProject struct{ readProject }
+
+func (p *manageProject) SetRoles(roles map[string]string) ([]MemberView, error) {
+	var out []MemberView
+	err := p.ps.as.a.db.update(func(x *tx) error {
+		agg, err := loadSetRoles(x, p.ps.pid, roles)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		out = agg.apply(x)
+		return nil
+	})
+	return out, err
+}
