+func TestChangeMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"demote unassigned manager", "ann", "/projects/web/members/ivy", `{"role":"viewer"}`, 200},
+		{"promote", "ann", "/projects/web/members/dan", `{"role":"manager"}`, 200},
+		{"demote to contributor with tasks", "ann", "/projects/web/members/ben", `{"role":"contributor"}`, 200},
+		{"viewer with assigned tasks", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 400},
+		{"contributor caller", "ben", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"viewer caller", "dan", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"org admin non member", "eve", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"manager elsewhere only viewer here", "ann", "/projects/ops/members/cat", `{"role":"viewer"}`, 403},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"non member caller", "hal", "/projects/web/members/dan", `{"role":"viewer"}`, 404},
+		{"other org", "gus", "/projects/web/members/dan", `{"role":"viewer"}`, 404},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"invalid role", "ann", "/projects/web/members/dan", `{"role":"boss"}`, 400},
+		{"missing role", "ann", "/projects/web/members/dan", `{}`, 400},
+		{"anonymous", "", "/projects/web/members/dan", `{"role":"viewer"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestChangeMemberRoleResponseAndEffect(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 || strings.TrimSpace(body) != `{"userId":"dan","role":"contributor"}` {
+		t.Fatalf("got %d %s", code, body)
+	}
+	// dan can now create tasks.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 201 && code != 200 {
+		t.Fatalf("dan create: %d", code)
+	}
+	// ben, once promoted, may change roles; and a demoted manager loses that right.
+	do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"manager"}`)
+	if code, _ := do(t, h, "PUT", "/projects/web/members/dan", "ben", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("promoted manager: %d", code)
+	}
+	do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"contributor"}`)
+	if code, _ := do(t, h, "PUT", "/projects/web/members/dan", "ben", `{"role":"manager"}`); code != 403 {
+		t.Fatalf("demoted manager: %d", code)
+	}
+}
