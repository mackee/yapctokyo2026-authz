+// Delete removes the user from the project. The user's tasks in the project are
+// unassigned in the same transaction, so no task keeps an assignee who is no
+// longer a member. Only managers may remove members (CanManageMembers); a user
+// who is not a member of the project is ErrNotFound.
+func (mt *MembershipTable) Delete(ctx context.Context, db DB, authz ProjectAuthz, userID string) error {
+	if err := authz.CanManageMembers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveMember(ctx, tx, authz.ProjectID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
