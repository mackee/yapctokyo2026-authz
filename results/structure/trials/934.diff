+func TestChangeMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"promote", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"demote manager", "ivy", "/projects/web/members/ann", `{"role":"contributor"}`, 200},
+		{"demote self", "ann", "/projects/web/members/ann", `{"role":"viewer"}`, 200},
+		{"contributor", "ben", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"viewer", "dan", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"manager of other project", "ivy", "/projects/legacy/members/ben", `{"role":"viewer"}`, 404},
+		{"org admin", "eve", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"viewer elsewhere", "ann", "/projects/ops/members/cat", `{"role":"viewer"}`, 403},
+		{"actor not in project", "dan", "/projects/ops/members/cat", `{"role":"viewer"}`, 404},
+		{"non-member target", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"viewer with tasks", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 400},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"contributor"}`, 409},
+		{"bad role", "ann", "/projects/web/members/dan", `{"role":"boss"}`, 400},
+		{"missing role", "ann", "/projects/web/members/dan", `{}`, 400},
+		{"unauthenticated", "", "/projects/web/members/dan", `{"role":"manager"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+
+	t.Run("response and effect", func(t *testing.T) {
+		h := newServer()
+		code, body := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+		if code != 200 {
+			t.Fatalf("got %d", code)
+		}
+		var got map[string]string
+		if err := json.Unmarshal([]byte(body), &got); err != nil {
+			t.Fatal(err)
+		}
+		if len(got) != 2 || got["userId"] != "dan" || got["role"] != "contributor" {
+			t.Fatalf("body %s", body)
+		}
+		// dan can now write.
+		if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 201 && code != 200 {
+			t.Fatalf("dan create got %d", code)
+		}
+	})
+}
