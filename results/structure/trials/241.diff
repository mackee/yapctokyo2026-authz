+		cur := s.tasks[t.ts.tid]
+		a, err := admit(s, d.ps.pid, cur.assignee.user)
+		if err != nil {
+			return err
+		}
+		if d.role == RoleContributor && a.user != "" && a.user != d.ps.as.actor.id {
+			return deny(ErrForbidden, "contributors may only receive tasks assigned to themselves")
+		}
+		cur.project = d.ps.pid
+		cur.assignee = a
+		s.tasks[cur.id] = cur
+		v = cur.view()
+		return nil
+	})
+	return v, err
+}
