+func (t *manageTask) MoveTo(dest WriteProject) (TaskView, error) {
+	d, ok := dest.(*writeProject)
+	if !ok {
+		return TaskView{}, deny(ErrInvalid, "invalid destination")
+	}
+	if d.ps.as.a != t.ts.ps.as.a {
+		return TaskView{}, deny(ErrInvalid, "invalid destination")
