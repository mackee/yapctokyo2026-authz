+type moveRequest struct {
+	ToProjectID string `json:"toProjectId"`
+}
+
+// moveTask requires manager on the source project (like delete) and write
+// access on the destination project.
+func moveTask(ctx tanukirpc.Context[*taskRegistry], _ struct{}) (*Task, error) {
+	scope := ctx.Registry().scope
+	t, err := scope.Manage()
+	if err != nil {
+		return nil, err
+	}
+	var req moveRequest
+	if err := decodeBody(ctx.Request(), &req); err != nil || req.ToProjectID == "" {
+		return nil, errInvalidBody
+	}
+	dest, err := scope.Project().Actor().Project(req.ToProjectID).Write()
+	if err != nil {
+		return nil, err
+	}
+	v, err := t.MoveTo(dest)
+	if err != nil {
+		return nil, err
+	}
+	return &v, nil
+}
