+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin, user with no memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"manager is not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"contributor is not org admin", "ben", "/orgs/acme/users/cat", 403},
+		{"org user without roles", "hal", "/orgs/acme/users/ben", 403},
+		{"other org admin", "gus", "/orgs/acme/users/ben", 404},
+		{"org path of other org", "eve", "/orgs/globex/users/gus", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserRevokesAccess(t *testing.T) {
+	s := newServer()
+	if code, body := do(t, s, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove ben: got %d %s", code, body)
+	}
+	// ben was a contributor in web and in the archived legacy project; both must be gone.
+	gone := []struct{ name, method, path, body string }{
+		{"list web", "GET", "/projects/web/tasks", ""},
+		{"get web task", "GET", "/projects/web/tasks/t1", ""},
+		{"create in web", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"list archived legacy", "GET", "/projects/legacy/tasks", ""},
+	}
+	for _, c := range gone {
+		t.Run("ben "+c.name, func(t *testing.T) {
+			if code, _ := do(t, s, c.method, c.path, "ben", c.body); code != 404 {
+				t.Fatalf("got %d want 404", code)
+			}
+		})
+	}
+	// Other members are unaffected.
+	kept := []struct{ name, user, path string }{
+		{"ann lists web", "ann", "/projects/web/tasks"},
+		{"cat lists web", "cat", "/projects/web/tasks"},
+		{"ann still in legacy", "ann", "/projects/legacy/tasks"},
+		{"gus still in globex", "gus", "/projects/gx/tasks"},
+	}
+	for _, c := range kept {
+		t.Run(c.name, func(t *testing.T) {
+			if code, _ := do(t, s, "GET", c.path, c.user, ""); code != 200 {
+				t.Fatalf("got %d want 200", code)
+			}
+		})
+	}
+	// Repeating the call is still 204.
+	if code, body := do(t, s, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("repeat remove ben: got %d %s", code, body)
+	}
+}
