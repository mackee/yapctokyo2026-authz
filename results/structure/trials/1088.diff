+// Move moves the task to another project of the actor's organization. The
+// actor must be allowed to remove the task from its project (CanManage) and to
+// create it in the destination (CanWrite, CanAssign). A destination the actor
+// cannot read is ErrNotFound.
+func (*TaskTable) Move(ctx context.Context, db DB, authz TaskAuthz, toProjectID string) (*Task, error) {
+	if err := authz.CanManage(); err != nil {
+		return nil, err
+	}
+	if toProjectID == "" {
+		return nil, deny(ErrInvalid, "toProjectId must not be empty")
+	}
+	if toProjectID == authz.Project().ProjectID() {
+		return nil, deny(ErrInvalid, "task is already in that project")
+	}
+	var t *Task
+	if err := inTx(ctx, db, func(tx DB) error {
+		dest, err := NewProjectAuthz(ctx, tx, authz.Project().Actor(), toProjectID)
+		if err != nil {
+			return err
+		}
+		if err := dest.CanWrite(); err != nil {
+			return err
+		}
+		agg, err := loadMoveTask(ctx, tx, authz.TaskID(), dest.ProjectID())
+		if err != nil {
+			return err
+		}
+		if err := dest.CanAssign(agg.task.AssigneeID); err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		t, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return t, nil
+}
