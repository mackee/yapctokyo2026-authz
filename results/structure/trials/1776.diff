+
+type memberRoleRequest struct {
+	Role string `json:"role"`
+}
+
+type memberRoleResponse struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func (s *server) updateMemberRole(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role, err := findRole(ctx, s.db, project.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req memberRoleRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	if req.Role != RoleManager && req.Role != RoleContributor && req.Role != RoleViewer {
+		writeError(w, 400, "invalid role")
+		return
+	}
+	targetID := r.PathValue("uid")
+	targetRole, err := findRole(ctx, s.db, project.ID, targetID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if targetRole == "" {
+		writeError(w, 404, "not found")
+		return
+	}
+	// Tasks may only be assigned to contributors and managers, so a member who
+	// still has tasks cannot become a viewer.
+	if req.Role == RoleViewer {
+		var assigned int
+		if err := s.db.QueryRowContext(ctx, `SELECT COUNT(*) FROM tasks WHERE project_id = ? AND assignee = ?`, project.ID, targetID).Scan(&assigned); err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+		if assigned > 0 {
+			writeError(w, 409, "member is assigned tasks and must stay a contributor or manager")
+			return
+		}
+	}
+	if _, err := s.db.ExecContext(ctx, `UPDATE memberships SET role = ? WHERE project_id = ? AND user_id = ?`,
+		req.Role, project.ID, targetID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, memberRoleResponse{UserID: targetID, Role: req.Role})
+}
diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..37029c0
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,97 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"testing"
+)
+
+// roleOf reads a user's role in a project straight from the database, because
+// the API has no endpoint that returns a membership.
+func roleOf(t *testing.T, h http.Handler, projectID, userID string) string {
+	t.Helper()
+	app, ok := h.(*appHandler)
+	if !ok {
+		t.Fatalf("roleOf: %T is not the handler built by newServer", h)
+	}
+	role, err := findRole(t.Context(), app.db, projectID, userID)
+	if err != nil {
+		t.Fatalf("roleOf: %v", err)
+	}
+	return role
+}
+
+func TestUpdateMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		// Success: a manager changes a member's role.
+		{"manager demotes member without tasks", "ann", "/projects/web/members/ivy", `{"role":"viewer"}`, 200},
+		{"manager promotes viewer", "ann", "/projects/web/members/dan", `{"role":"manager"}`, 200},
+		{"manager promotes contributor", "ann", "/projects/web/members/ben", `{"role":"manager"}`, 200},
+
+		// The caller's role in the project decides.
+		{"contributor caller", "ben", "/projects/web/members/cat", `{"role":"viewer"}`, 403},
+		{"viewer caller", "dan", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"org admin cannot write", "eve", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"manager of another project only", "ann", "/projects/ops/members/cat", `{"role":"viewer"}`, 403},
+		{"non member caller", "hal", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"other org caller", "gus", "/projects/web/members/ivy", `{"role":"viewer"}`, 404},
+		{"anonymous", "", "/projects/web/members/ivy", `{"role":"viewer"}`, 401},
+		{"unknown user", "zed", "/projects/web/members/ivy", `{"role":"viewer"}`, 401},
+
+		// The path must name a real project and a current member of it.
+		{"unknown project", "ann", "/projects/nope/members/ivy", `{"role":"viewer"}`, 404},
+		{"target is not a member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"target in another org", "ann", "/projects/web/members/gus", `{"role":"viewer"}`, 404},
+
+		// Request validation.
+		{"invalid role", "ann", "/projects/web/members/dan", `{"role":"owner"}`, 400},
+		{"empty role", "ann", "/projects/web/members/dan", `{"role":""}`, 400},
+		{"invalid body", "ann", "/projects/web/members/dan", `not json`, 400},
+
+		// Archived projects reject all writes.
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"manager"}`, 409},
+
+		// Demoting a member who is assigned tasks would leave those tasks assigned
+		// to a viewer, which breaks the model rule, so it is refused.
+		{"demote assignee", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRoleResponseAndEffect(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members/ivy", "ann", `{"role":"viewer"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("response is not JSON: %v: %s", err, body)
+	}
+	if got["userId"] != "ivy" || got["role"] != "viewer" || len(got) != 2 {
+		t.Fatalf("got body %s, want {\"userId\":\"ivy\",\"role\":\"viewer\"}", body)
+	}
+	if role := roleOf(t, h, "web", "ivy"); role != "viewer" {
+		t.Fatalf("stored role is %q, want %q", role, "viewer")
+	}
+}
+
+func TestUpdateMemberRoleRefusedLeavesRoleUnchanged(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 409 {
+		t.Fatalf("got %d want 409", code)
+	}
+	if role := roleOf(t, h, "web", "ben"); role != "contributor" {
+		t.Fatalf("stored role is %q after refused change, want %q", role, "contributor")
+	}
+}
