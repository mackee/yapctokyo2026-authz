+
+type memberRoleRequest struct {
+	Role string `json:"role"`
+}
+
+type memberRoleResponse struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+var validRoles = map[string]bool{RoleManager: true, RoleContributor: true, RoleViewer: true}
+
+// updateMemberRole changes the role of an existing project member. Only managers
+// may do so. A member who still has tasks assigned in the project cannot be
+// demoted to viewer, because assignees must be contributors or managers.
+func (s *server) updateMemberRole(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role, err := findRole(ctx, s.db, project.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req memberRoleRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || !validRoles[req.Role] {
+		writeError(w, 400, "invalid request body: role must be manager, contributor or viewer")
+		return
+	}
+	targetID := r.PathValue("uid")
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+	var current string
+	err = tx.QueryRowContext(ctx, `SELECT role FROM memberships WHERE project_id = ? AND user_id = ?`, project.ID, targetID).Scan(&current)
+	if errors.Is(err, sql.ErrNoRows) {
+		writeError(w, 404, "not found")
+		return
+	}
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if req.Role != RoleManager && req.Role != RoleContributor {
+		var assigned int
+		if err := tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM tasks WHERE project_id = ? AND assignee = ?`, project.ID, targetID).Scan(&assigned); err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+		if assigned > 0 {
+			writeError(w, 409, "user is assigned to tasks in this project; reassign them before changing the role to viewer")
+			return
+		}
+	}
+	if _, err := tx.ExecContext(ctx, `UPDATE memberships SET role = ? WHERE project_id = ? AND user_id = ?`, req.Role, project.ID, targetID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, memberRoleResponse{UserID: targetID, Role: req.Role})
+}
diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..9c017e9
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,107 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestUpdateMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager demotes member", "ann", "/projects/web/members/ivy", `{"role":"viewer"}`, 200},
+		{"manager promotes viewer", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"manager promotes to manager", "ann", "/projects/web/members/dan", `{"role":"manager"}`, 200},
+		{"manager sets same role", "ann", "/projects/web/members/ben", `{"role":"contributor"}`, 200},
+		{"assignee demoted to viewer", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 409},
+		{"contributor caller", "ben", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"viewer caller", "dan", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"org admin caller", "eve", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"non member caller", "hal", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"other org caller", "gus", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"anonymous", "", "/projects/web/members/ben", `{"role":"viewer"}`, 401},
+		{"unknown user", "zed", "/projects/web/members/ben", `{"role":"viewer"}`, 401},
+		{"archived project", "ann", "/projects/legacy/members/ben", `{"role":"manager"}`, 409},
+		{"invalid role", "ann", "/projects/web/members/dan", `{"role":"owner"}`, 400},
+		{"empty role", "ann", "/projects/web/members/dan", `{"role":""}`, 400},
+		{"missing role", "ann", "/projects/web/members/dan", `{}`, 400},
+		{"malformed body", "ann", "/projects/web/members/dan", `{"role":`, 400},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"target unknown user", "ann", "/projects/web/members/zed", `{"role":"viewer"}`, 404},
+		{"target member of other project", "ivy", "/projects/ops/members/ben", `{"role":"viewer"}`, 404},
+		{"missing project", "ann", "/projects/nope/members/ben", `{"role":"viewer"}`, 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRoleResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["userId"] != "dan" || got["role"] != "contributor" || len(got) != 2 {
+		t.Fatalf("unexpected body: %s", body)
+	}
+}
+
+func TestUpdateMemberRoleTakesEffect(t *testing.T) {
+	h := newServer()
+
+	// dan is a viewer: cannot create tasks.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 403 {
+		t.Fatalf("before promotion: got %d want 403", code)
+	}
+	if code, _ := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`); code != 200 {
+		t.Fatalf("promote: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("after promotion: got %d want 200", code)
+	}
+
+	// ivy is a manager with no assigned tasks: demote to viewer, then cannot write.
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ivy", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t3", "ivy", `{"status":"done"}`); code != 403 {
+		t.Fatalf("after demotion: got %d want 403", code)
+	}
+	// ivy can still read the project as a viewer.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ivy", ""); code != 200 {
+		t.Fatalf("viewer read: got %d want 200", code)
+	}
+}
+
+func TestUpdateMemberRoleConflictLeavesRoleUnchanged(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 409 {
+		t.Fatalf("got %d want 409", code)
+	}
+	// ben is still a contributor and can still modify his own task t1.
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+}
+
+func TestUpdateMemberRoleOnlyManagersChange(t *testing.T) {
+	h := newServer()
+	// A manager of another project has no say in web.
+	if code, _ := do(t, h, "PUT", "/projects/web/members/dan", "gus", `{"role":"manager"}`); code != 404 {
+		t.Fatalf("got %d want 404", code)
+	}
+	// ann is a viewer of ops: cannot change roles there.
+	if code, _ := do(t, h, "PUT", "/projects/ops/members/cat", "ann", `{"role":"viewer"}`); code != 403 {
+		t.Fatalf("got %d want 403", code)
+	}
+}
