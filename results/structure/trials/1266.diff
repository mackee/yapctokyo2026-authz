 // NewUserTable returns the users table.
 func NewUserTable() *UserTable { return &UserTable{} }
 
+// RemoveFromOrg removes the user from every project of the organization (the
+// retirement process) and unassigns their tasks there. The user must belong to
+// the organization (else ErrNotFound). Removing a user with no memberships
+// succeeds.
+func (*UserTable) RemoveFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanManageUsers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveUser(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
