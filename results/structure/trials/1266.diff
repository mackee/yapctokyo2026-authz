+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/cat", 204},
+		{"no memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"manager is not org admin", "ann", "/orgs/acme/users/cat", 403},
+		{"plain member", "ben", "/orgs/acme/users/cat", 403},
+		{"anonymous", "", "/orgs/acme/users/cat", 401},
+		{"unknown actor", "zed", "/orgs/acme/users/cat", 401},
+		{"other org as admin target", "eve", "/orgs/globex/users/gus", 404},
+		{"user of other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+	// ben: web contributor (t1 assigned), legacy contributor (t5 assigned, archived).
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d", code)
+	}
+	for _, p := range []string{"/projects/web/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, h, "GET", p, "ben", ""); code != 404 {
+			t.Errorf("ben reads %s: got %d want 404", p, code)
+		}
+	}
+	// Their tasks are unassigned, in the archived project too.
+	for _, p := range []string{"/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		code, body := do(t, h, "GET", p, "ann", "")
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil || code != 200 {
+			t.Fatalf("get %s: %d %s", p, code, body)
+		}
+		if task.AssigneeID != "" {
+			t.Errorf("%s still assigned to %q", p, task.AssigneeID)
+		}
+	}
+	// Other members and tasks are untouched.
+	if code, body := do(t, h, "GET", "/projects/web/tasks/t2", "ann", ""); code != 200 || !strings.Contains(body, `"cat"`) {
+		t.Errorf("t2 changed: %d %s", code, body)
+	}
+	// The user can no longer be a task assignee.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ann", `{"title":"x","assignee":"ben"}`); code != 400 {
+		t.Errorf("assign removed user: got %d want 400", code)
+	}
+	// Removing again still succeeds: the user belongs to the org.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Errorf("second remove: got %d", code)
+	}
+}
