+// FreezeProject sets every member's role to viewer and returns the members
+// sorted by user ID.
+func (s *Store) FreezeProject(projectID string) []memberView {
+	out := []memberView{}
+	for uid := range s.members[projectID] {
+		s.members[projectID][uid] = RoleViewer
+		out = append(out, memberView{UserID: uid, Role: RoleViewer})
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].UserID < out[j].UserID })
+	return out
+}
