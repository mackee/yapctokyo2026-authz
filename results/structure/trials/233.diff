+func TestFreeze(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"archived", "ann", "legacy", 409},
+		{"missing project", "ann", "nope", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeEffect(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("freeze: %d %s", code, body)
+	}
+	var got []map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []string{"ann", "ben", "cat", "dan", "ivy"}
+	if len(got) != len(want) {
+		t.Fatalf("got %v", got)
+	}
+	for i, m := range got {
+		if m["userId"] != want[i] || m["role"] != "viewer" {
+			t.Fatalf("member %d: %v", i, m)
+		}
+	}
+	// Nobody can write any more, managers included.
+	for _, u := range []string{"ann", "ivy", "ben", "cat"} {
+		if c, _ := do(t, h, "POST", "/projects/web/tasks", u, `{"title":"x"}`); c != 403 {
+			t.Errorf("%s create: got %d want 403", u, c)
+		}
+		if c, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", u, `{"status":"done"}`); c != 403 {
+			t.Errorf("%s update: got %d want 403", u, c)
+		}
+		if c, _ := do(t, h, "DELETE", "/projects/web/tasks/t1", u, ""); c != 403 {
+			t.Errorf("%s delete: got %d want 403", u, c)
+		}
+	}
+	// Reads still work, and other projects are unaffected.
+	if c, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); c != 200 {
+		t.Errorf("read after freeze: %d", c)
+	}
+	if c, _ := do(t, h, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`); c != 200 {
+		t.Errorf("other project affected: %d", c)
+	}
+	// Frozen projects can't be re-frozen (no manager left).
+	if c, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); c != 403 {
+		t.Errorf("refreeze: %d", c)
+	}
+}
