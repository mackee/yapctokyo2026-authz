 // ProjectScope is bound to one actor and one project ID. It grants nothing by
@@ -139,6 +146,67 @@ func (s *actorScope) Actor() Actor { return s.actor }
 func (s *actorScope) Project(projectID string) ProjectScope {
 	return &projectScope{as: s, pid: projectID}
 }
+func (s *actorScope) Org(orgID string) OrgScope {
+	return &orgScope{as: s, oid: orgID}
+}
+
+type orgScope struct {
+	as  *actorScope
+	oid string
+}
+
+// ---- organization capabilities -----------------------------------------------
+
+// ManageOrg is the org-admin capability for one organization.
+type ManageOrg interface {
+	// RemoveUser removes a user of the organization from every project of the
+	// organization, unassigning that user's tasks in those projects. It is
+	// idempotent: removing a user who is in no project is not an error.
+	RemoveUser(userID string) error
+}
+
+// Admin applies the org admin rule: the organization must be the actor's own
+// (else 404), and the actor must be an org admin of it (else 403).
+func (s *orgScope) Admin() (ManageOrg, error) {
+	err := s.as.a.st.read(func(st *state) error {
+		if s.oid != s.as.actor.org {
+			return deny(ErrNotFound, "not found")
+		}
+		if !s.as.actor.orgAdmin {
+			return deny(ErrForbidden, "forbidden")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &manageOrg{os: s}, nil
+}
+
+type manageOrg struct{ os *orgScope }
+
+func (m *manageOrg) RemoveUser(userID string) error {
+	return m.os.as.a.st.tx(func(s *state) error {
+		u, ok := s.users[userID]
+		if !ok || u.org != m.os.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		for pid, p := range s.projects {
+			if p.org == m.os.oid {
+				delete(s.members[pid], userID)
+			}
+		}
+		for id, t := range s.tasks {
+			if t.assignee.user != userID {
+				continue
+			}
+			// Only tasks of this organization's projects can name a user of it.
+			t.assignee = Assignee{project: t.project}
+			s.tasks[id] = t
+		}
+		return nil
+	})
+}
 
