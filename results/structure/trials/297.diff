diff --git a/org_test.go b/org_test.go
new file mode 100644
index 0000000..6ba4e42
--- /dev/null
+++ b/org_test.go
@@ -0,0 +1,100 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes manager", "eve", "/orgs/acme/users/ivy", 204},
+		{"org admin removes user with no roles", "eve", "/orgs/acme/users/hal", 204},
+		{"org member is not admin", "ann", "/orgs/acme/users/ben", 403},
+		{"viewer is not admin", "dan", "/orgs/acme/users/ben", 403},
+		{"other org admin", "gus", "/orgs/acme/users/ben", 404},
+		{"org not the actor's", "eve", "/orgs/globex/users/gus", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ben", 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed", 404},
+		{"user of another org", "eve", "/orgs/acme/users/gus", 404},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	srv := newServer()
+
+	// Before: ben is a contributor of web and legacy, and is assigned t1 and t5.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks/t1", "ann", ""); code != 200 {
+		t.Fatalf("setup: got %d", code)
+	}
+
+	// A user of another org is not touched by an acme request: nothing changes.
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/gus", "eve", ""); code != 404 {
+		t.Fatalf("cross-org remove: got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben lost access after rejected remove: got %d", code)
+	}
+
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove ben: got %d want 204", code)
+	}
+
+	// ben is no longer a member of any project, so every project path is 404
+	// for ben, including the archived one and writes.
+	for _, c := range []struct {
+		name, method, path, body string
+	}{
+		{"list web", "GET", "/projects/web/tasks", ""},
+		{"list legacy", "GET", "/projects/legacy/tasks", ""},
+		{"create in web", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"edit old task", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+	} {
+		if code, _ := do(t, srv, c.method, c.path, "ben", c.body); code != 404 {
+			t.Fatalf("%s: got %d want 404", c.name, code)
+		}
+	}
+
+	// ben's assigned tasks are unassigned, not deleted.
+	for _, tid := range []string{"/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		code, body := do(t, srv, "GET", tid, "ann", "")
+		if code != 200 {
+			t.Fatalf("%s: got %d", tid, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.Assignee != "" {
+			t.Fatalf("%s: still assigned to %q", tid, task.Assignee)
+		}
+	}
+
+	// Other members are untouched.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat lost access: got %d", code)
+	}
+
+	// ben cannot be assigned back into a project he has left.
+	if code, _ := do(t, srv, "PATCH", "/projects/web/tasks/t1", "ann", `{"assignee":"ben"}`); code != 400 {
+		t.Fatalf("reassign to removed user: got %d want 400", code)
+	}
+
+	// Removing again is idempotent.
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("second remove: got %d want 204", code)
+	}
+}
