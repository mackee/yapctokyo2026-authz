+// updateMembershipRoleAggregate changes the role of one project member.
+type updateMembershipRoleAggregate struct {
+	membership *Membership
+	assigned   []*Task // the member's tasks in the project
+	in         MembershipTableUpdateRoleInput
+}
+
+func loadUpdateMembershipRole(ctx context.Context, tx DB, projectID, userID string, in MembershipTableUpdateRoleInput) (*updateMembershipRoleAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if err != nil {
+		return nil, err
+	}
+	m, err := p.Membership(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	assigned, err := m.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &updateMembershipRoleAggregate{membership: m, assigned: assigned, in: in}, nil
+}
+
+func (a *updateMembershipRoleAggregate) validate() error {
+	// Tasks may only be assigned to contributors or managers, so a member who
+	// still has assigned tasks cannot become a viewer.
+	if !isWriterRole(a.in.Role) && len(a.assigned) > 0 {
+		return deny(ErrInvalid, "member has assigned tasks; reassign them before making them a viewer")
+	}
+	return nil
+}
+
+func (a *updateMembershipRoleAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.membership.setRole(ctx, tx, a.in.Role); err != nil {
+		return nil, err
+	}
+	return a.membership, nil
+}
