+func TestTransfer(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin transfers user", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 200},
+		{"non admin in same org", "ann", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 403},
+		{"anonymous", "", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 401},
+		{"caller in other org", "gus", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 404},
+		{"path org is not caller's org", "eve", "/orgs/globex/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"target not in path org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"globex"}`, 404},
+		{"unknown target user", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"missing toOrgId", "eve", "/orgs/acme/users/ben/transfer", `{}`, 400},
+		{"malformed body", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":`, 400},
+		{"unknown destination org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"initech"}`, 400},
+		{"same org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"acme"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestTransferResponseAndAccess(t *testing.T) {
+	srv := newServer()
+	code, body := do(t, srv, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got transferResponse
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.ID != "ben" || got.OrgID != "globex" {
+		t.Fatalf("got %+v", got)
+	}
+
+	// ben's acme project access is gone once he is in globex.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads acme project after transfer: got %d want 404", code)
+	}
+	// ben has no globex membership, so the transfer grants him no globex access.
+	if code, _ := do(t, srv, "GET", "/projects/gx/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads globex project: got %d want 404", code)
+	}
+}
+
+func TestTransferClearsOrgAdmin(t *testing.T) {
+	srv := newServer()
+	// eve is an acme org admin; moving her must not keep admin rights in globex.
+	if code, body := do(t, srv, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: got %d body=%s", code, body)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/gx/tasks", "eve", ""); code != 404 {
+		t.Fatalf("eve reads globex project as former admin: got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "POST", "/orgs/globex/users/gus/transfer", "eve", `{"toOrgId":"acme"}`); code != 403 {
+		t.Fatalf("eve transfers in globex: got %d want 403", code)
+	}
+}
