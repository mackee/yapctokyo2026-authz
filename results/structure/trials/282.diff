+
+func (t *manageTask) MoveTo(toProjectID string) (TaskView, error) {
+	if toProjectID == "" || toProjectID == t.ts.ps.pid {
+		return TaskView{}, deny(ErrInvalid, "invalid destination project")
+	}
+	// The destination is acquired like any other project: readable (else 404),
+	// writable by this actor (else 403), not archived (else 409).
+	if _, err := t.ts.ps.as.Project(toProjectID).Write(); err != nil {
+		return TaskView{}, err
+	}
+	var v TaskView
+	err := t.ts.ps.as.a.st.tx(func(s *state) error {
+		cur, ok := s.tasks[t.ts.tid]
+		if !ok || cur.project != t.ts.ps.pid {
+			return deny(ErrNotFound, "not found")
+		}
+		// Re-admit the assignee for the destination; it fails (400) when the
+		// assignee is not a contributor or manager there.
+		a, err := admit(s, toProjectID, cur.assignee.user)
+		if err != nil {
+			return err
+		}
+		cur.project = toProjectID
+		cur.assignee = a
+		s.tasks[cur.id] = cur
+		v = cur.view()
+		return nil
+	})
+	return v, err
+}
