+func TestSearchTasks(t *testing.T) {
+	// Seed data: t1 "Fix header" (web), t4 "Rotate keys" (ops),
+	// t5 "Old bug" (legacy, archived), t6 "Globex secret plan" (gx, globex).
+	projectOf := map[string]string{"t1": "web", "t4": "ops", "t5": "legacy", "t6": "gx"}
+	cases := []struct {
+		name, user, query string
+		want              int
+		ids               []string
+	}{
+		{"member finds across own project", "ben", "q=header", 200, []string{"t1"}},
+		{"viewer member finds", "dan", "q=header", 200, []string{"t1"}},
+		{"case insensitive", "dan", "q=HEADER", 200, []string{"t1"}},
+		{"viewer of ops finds ops task", "ann", "q=keys", 200, []string{"t4"}},
+		{"archived project is readable", "ann", "q=old", 200, []string{"t5"}},
+		{"org admin finds any acme project", "eve", "q=keys", 200, []string{"t4"}},
+		{"non member finds nothing", "hal", "q=keys", 200, []string{}},
+		{"other org finds nothing in acme", "gus", "q=header", 200, []string{}},
+		{"other org finds own project", "gus", "q=secret", 200, []string{"t6"}},
+		{"no match is empty array", "ben", "q=zzz", 200, []string{}},
+		{"missing q", "ben", "", 400, nil},
+		{"empty q", "ben", "q=", 400, nil},
+		{"anonymous", "", "q=header", 401, nil},
+		{"unknown user", "zed", "q=header", 401, nil},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "GET", "/search/tasks?"+c.query, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d (body %s)", code, c.want, body)
+			}
+			if c.want != 200 {
+				return
+			}
+			var tasks []Task
+			if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+				t.Fatalf("decode: %v (body %s)", err, body)
+			}
+			if tasks == nil {
+				t.Fatalf("want a JSON array, got %s", body)
+			}
+			var got []string
+			for _, task := range tasks {
+				got = append(got, task.ID)
+				if task.ProjectID != projectOf[task.ID] {
+					t.Fatalf("task %s: projectId %q, want %q", task.ID, task.ProjectID, projectOf[task.ID])
+				}
+			}
+			if strings.Join(got, ",") != strings.Join(c.ids, ",") {
+				t.Fatalf("got ids %v want %v", got, c.ids)
+			}
+		})
+	}
+}
