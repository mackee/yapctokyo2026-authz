+func (s *actorScope) Search() SearchTasks { return &searchTasks{as: s} }
+
+// SearchTasks may search the tasks of every project the actor can read.
+type SearchTasks interface {
+	// Find returns the tasks whose title contains q (case-insensitive), across
+	// all projects that pass the read rule, sorted by ID. Projects the actor
+	// cannot read contribute nothing. An empty q is 400.
+	Find(q string) ([]TaskView, error)
+}
+
+type searchTasks struct{ as *actorScope }
+
+func (s *searchTasks) Find(q string) ([]TaskView, error) {
+	if q == "" {
+		return nil, deny(ErrInvalid, "q is required")
+	}
+	needle := strings.ToLower(q)
+	out := []TaskView{}
+	err := s.as.a.st.read(func(st *state) error {
+		for _, t := range st.tasks {
+			if _, _, err := readable(st, s.as.actor, t.project); err != nil {
+				continue
+			}
+			if strings.Contains(strings.ToLower(t.title), needle) {
+				out = append(out, t.view())
+			}
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].ID < out[j].ID })
+	return out, nil
+}
 
