+// Freeze runs the freeze aggregate in one transaction, so either every member
+// is demoted or none is.
+func (p *manageProject) Freeze() ([]MemberView, error) {
+	var out []MemberView
+	err := p.ps.as.a.db.update(func(x *tx) error {
+		agg, err := loadFreezeProject(x, p.ps.pid)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		out = agg.apply(x)
+		return nil
+	})
+	return out, err
+}
