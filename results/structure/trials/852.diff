+func TestUpdateMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager demotes", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 200},
+		{"manager promotes", "ann", "/projects/web/members/dan", `{"role":"manager"}`, 200},
+		{"manager demotes manager", "ann", "/projects/web/members/ivy", `{"role":"contributor"}`, 200},
+		{"contributor forbidden", "ben", "/projects/web/members/cat", `{"role":"viewer"}`, 403},
+		{"viewer forbidden", "dan", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"manager of other project", "ann", "/projects/ops/members/cat", `{"role":"viewer"}`, 403},
+		{"org admin forbidden", "eve", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"non member", "hal", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"other org", "gus", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"anonymous", "", "/projects/web/members/ben", `{"role":"viewer"}`, 401},
+		{"target not member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"invalid role", "ann", "/projects/web/members/ben", `{"role":"owner"}`, 400},
+		{"bad body", "ann", "/projects/web/members/ben", `nope`, 400},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRoleEffect(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got memberResponse
+	json.Unmarshal([]byte(body), &got)
+	if got.UserID != "ben" || got.Role != "viewer" {
+		t.Fatalf("bad response %s", body)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Fatalf("demoted user can still write: %d", code)
+	}
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ben", "dan", `{"role":"manager"}`); code != 403 {
+		t.Fatalf("viewer changed a role: %d", code)
+	}
+	do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"manager"}`)
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ben", "dan", `{"role":"contributor"}`); code != 200 {
+		t.Fatalf("promoted manager cannot change roles: %d", code)
+	}
+}
