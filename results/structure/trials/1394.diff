+// transferUserAggregate moves one user from their organization to another.
+type transferUserAggregate struct {
+	user        *User
+	from        string        // the organization the user leaves
+	toOrg       string        // the organization the user joins
+	memberships []*Membership // the user's memberships in projects of from
+	tasks       []*Task       // the user's tasks in projects of from
+}
+
+func loadTransferUser(ctx context.Context, tx DB, from string, in UserTableTransferInput) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, in.UserID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != from {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if _, err := NewOrgTable().Find(ctx, tx, in.ToOrgID); errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "unknown organization")
+	} else if err != nil {
+		return nil, err
+	}
+	if in.ToOrgID == from {
+		return nil, deny(ErrInvalid, "user already belongs to that organization")
+	}
+	a := &transferUserAggregate{user: u, from: from, toOrg: in.ToOrgID}
+
+	memberships, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, m := range memberships {
+		p, err := m.Project(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		if p.Org == from {
+			a.memberships = append(a.memberships, m)
+		}
+	}
+
+	tasks, err := u.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, t := range tasks {
+		p, err := t.Project(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		if p.Org == from {
+			a.tasks = append(a.tasks, t)
+		}
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error { return nil }
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	a.user.Org = a.toOrg
+	a.user.OrgAdmin = false
+	if err := a.user.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
