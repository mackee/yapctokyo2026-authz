+      assert(transferOutcome("eve", "acme", "gus", "globex") == 404),
+      assert(transferOutcome("eve", "acme", "ben", "nowhere") == 400),
+      assert(transferOutcome("eve", "acme", "ben", "acme") == 400),
+      assert(transferOutcome("nobody", "acme", "ben", "globex") == 401),
       unchanged,
     })
+
+  // A successful transfer moves the user, drops the admin flag, removes the
+  // memberships in the old organization and clears the assignments there.
+  run transferEffectTest =
+    init.then(transferUser("eve", "acme", "ben", "globex"))
+      .then(all {
+        assert(users.get("ben") == { org: "globex", orgAdmin: false }),
+        assert(not(members.keys().contains(("web", "ben")))),
+        assert(not(members.keys().contains(("legacy", "ben")))),
+        assert(tasks.get(1).assignee == ""),
+        assert(tasks.get(5).assignee == ""),
+        assert(tasks.get(2).assignee == "cat"),
+        assert(tasks.get(6).assignee == "gus"),
+        assert(invariants),
+        unchanged,
+      })
+
+  // Admin rights do not follow the user: eve moved to globex is no admin there.
+  run transferAdminNotKeptTest =
+    init.then(transferUser("eve", "acme", "eve", "globex"))
+      .then(all {
+        assert(transferOutcome("eve", "globex", "gus", "acme") == 403),
