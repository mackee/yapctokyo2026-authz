 // ---- project capabilities ----------------------------------------------------
 
 // ReadProject may list and read the tasks of one project.
@@ -219,6 +248,37 @@ type WriteProject interface {
 	CreateTask(title string, assignee Assignee) (TaskView, error)
 }
 
+// ManageProject may freeze one project.
+type ManageProject interface {
+	// Freeze moves every member of the project to the viewer role, so nobody can
+	// change the project's tasks any more. Tasks lose their assignees, because an
+	// assignee must be a contributor or manager of the project. It returns the
+	// members after the change, sorted by user ID. Freezing an already frozen
+	// project is refused with 403, since no manager remains.
+	Freeze() ([]MemberView, error)
+}
+
+type manageProject struct{ ps *projectScope }
+
+func (p *manageProject) Freeze() ([]MemberView, error) {
+	var out []MemberView
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		pid := p.ps.pid
+		for uid := range s.members[pid] {
+			s.members[pid][uid] = RoleViewer
+		}
+		for tid, t := range s.tasks {
+			if t.project == pid && t.assignee.user != "" {
+				t.assignee = Assignee{project: pid}
+				s.tasks[tid] = t
+			}
+		}
+		out = s.memberViews(pid)
+		return nil
+	})
+	return out, err
+}
+
 type readProject struct{ ps *projectScope }
 
 func (p *readProject) ID() string { return p.ps.pid }
