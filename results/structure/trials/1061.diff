+// RemoveFromOrg removes the user from every project of the organization: their
+// memberships in those projects are deleted, and their tasks in those projects
+// are unassigned (an assignee must be a member). The user stays in the
+// organization. Only org admins may do this (else ErrForbidden); a user outside
+// the organization is ErrNotFound.
+func (*UserTable) RemoveFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanManageUsers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveOrgUser(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
