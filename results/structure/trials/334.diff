+// ManageProject may remove members from one project. Managers only.
+type ManageProject interface {
+	ReadProject
+	// RemoveMember removes a member from the project. The user's tasks in the
+	// project become unassigned. A user who is not a member is 404.
+	RemoveMember(userID string) error
+}
+
+type manageProject struct{ readProject }
+
+func (p *manageProject) RemoveMember(userID string) error {
+	return p.ps.as.a.db.update(func(x *tx) error {
+		agg, err := loadRemoveMember(x, p.ps.pid, userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		agg.save(x)
+		return nil
+	})
+}
