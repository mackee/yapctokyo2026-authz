+// removeMemberAggregate removes one user from one project. The user's tasks in
+// that project are unassigned, so no task keeps an assignee who is no longer a
+// member.
+type removeMemberAggregate struct {
+	membership membershipRecord
+	tasks      []taskRecord // tasks in the project that were assigned to the member, already unassigned
+}
+
+func loadRemoveMember(x *tx, projectID, userID string) (*removeMemberAggregate, error) {
+	m, ok := x.findMembership(projectID, userID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	a := &removeMemberAggregate{membership: m}
+	for _, t := range x.tasksIn(projectID) {
+		if t.AssigneeID == userID {
+			t.AssigneeID = ""
+			a.tasks = append(a.tasks, t)
+		}
+	}
+	return a, nil
+}
+
+func (a *removeMemberAggregate) validate() error { return nil }
+
+func (a *removeMemberAggregate) save(x *tx) {
+	for _, t := range a.tasks {
+		t.save(x)
+	}
+	a.membership.destroy(x)
+}
