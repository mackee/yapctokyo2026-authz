+// MembershipTableChangeRoleInput is the input of MembershipTable.ChangeRole.
+type MembershipTableChangeRoleInput struct {
+	UserID string
+	Role   string // manager, contributor or viewer
+}
+
+var validRoles = map[string]bool{RoleManager: true, RoleContributor: true, RoleViewer: true}
+
+// ChangeRole changes the role of a project member. The project must be
+// managed by the actor (CanManageMembers); the target must already be a member
+// (else ErrNotFound). A member who holds assigned tasks cannot become a viewer
+// (else ErrInvalid).
+func (mt *MembershipTable) ChangeRole(ctx context.Context, db DB, authz ProjectAuthz, in MembershipTableChangeRoleInput) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if !validRoles[in.Role] {
+		return nil, deny(ErrInvalid, "role must be manager, contributor or viewer")
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadChangeRole(ctx, tx, authz.ProjectID(), in)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if m, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
