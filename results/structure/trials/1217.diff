+func TestChangeRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager promotes viewer", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"manager demotes member without tasks", "ann", "/projects/web/members/ivy", `{"role":"viewer"}`, 200},
+		{"manager demotes member with assigned task", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 400},
+		{"contributor changes other", "ben", "/projects/web/members/cat", `{"role":"viewer"}`, 403},
+		{"contributor changes self", "ben", "/projects/web/members/ben", `{"role":"manager"}`, 403},
+		{"viewer", "dan", "/projects/web/members/ben", `{"role":"manager"}`, 403},
+		{"org admin", "eve", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"non member", "hal", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"other org", "gus", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"anonymous", "", "/projects/web/members/ben", `{"role":"viewer"}`, 401},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"target in other org", "ann", "/projects/web/members/gus", `{"role":"viewer"}`, 404},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"manager"}`, 409},
+		{"unknown role", "ann", "/projects/web/members/dan", `{"role":"owner"}`, 400},
+		{"empty role", "ann", "/projects/web/members/dan", `{"role":""}`, 400},
+		{"missing role", "ann", "/projects/web/members/dan", `{}`, 400},
+		{"bad json", "ann", "/projects/web/members/dan", `{"role":`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestChangeRoleResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["userId"] != "dan" || got["role"] != "contributor" || len(got) != 2 {
+		t.Fatalf("got %s", body)
+	}
+}
+
+// A changed role takes effect for the member's later requests, and a refused
+// change leaves the role as it was. The steps run in order on one server.
+func TestChangeRoleEffects(t *testing.T) {
+	srv := newServer()
+	steps := []struct {
+		name, method, user, path, body string
+		want                           int
+	}{
+		{"viewer cannot create", "POST", "dan", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"promote viewer", "PUT", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"promoted member can create", "POST", "dan", "/projects/web/tasks", `{"title":"x"}`, 200},
+		{"demote member without tasks", "PUT", "ann", "/projects/web/members/dan", `{"role":"viewer"}`, 200},
+		{"demoted member cannot create", "POST", "dan", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"refused demotion", "PUT", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 400},
+		{"refused demotion leaves role", "PATCH", "ben", "/projects/web/tasks/t1", `{"status":"doing"}`, 200},
+	}
+	for _, s := range steps {
+		t.Run(s.name, func(t *testing.T) {
+			code, body := do(t, srv, s.method, s.path, s.user, s.body)
+			if code != s.want {
+				t.Fatalf("got %d want %d: %s", code, s.want, body)
+			}
+		})
+	}
+}
