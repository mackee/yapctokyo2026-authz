+// changeRoleAggregate changes the role of one project member.
+type changeRoleAggregate struct {
+	membership *Membership
+	role       string
+	tasks      []*Task // the member's tasks in the project; checked when the role stops being a writer
+}
+
+func loadChangeRole(ctx context.Context, tx DB, projectID string, in MembershipTableChangeRoleInput) (*changeRoleAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, projectID, in.UserID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "member not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &changeRoleAggregate{membership: m, role: in.Role}
+	if !isWriterRole(in.Role) {
+		tasks, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.tasks = tasks
+	}
+	return a, nil
+}
+
+func (a *changeRoleAggregate) validate() error {
+	// An assignee must be a contributor or manager of the task's project, so a
+	// member who still holds tasks cannot become a viewer.
+	if len(a.tasks) > 0 {
+		return deny(ErrInvalid, "member has assigned tasks; reassign or unassign them before changing the role to viewer")
+	}
+	return nil
+}
+
+func (a *changeRoleAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.membership.changeRole(ctx, tx, a.role); err != nil {
+		return nil, err
+	}
+	return a.membership, nil
+}
