+func TestRenameUserToFreedID(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "PUT", "/orgs/acme/users/ben", "eve", `{"id":"benjamin"}`); code != 200 {
+		t.Fatalf("first rename got %d", code)
