+}
+
+func TestRenameUserEffects(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "PUT", "/orgs/acme/users/ben", "eve", `{"id":"benjamin"}`); code != 200 {
+		t.Fatalf("rename got %d", code)
+	}
+
+	// The old ID no longer identifies anyone.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 401 {
+		t.Fatalf("old id: got %d want 401", code)
+	}
+
+	// The new ID keeps the project memberships (contributor in web and legacy).
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "benjamin", ""); code != 200 {
+		t.Fatalf("new id list web: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/legacy/tasks", "benjamin", ""); code != 200 {
+		t.Fatalf("new id list legacy: got %d want 200", code)
+	}
+
+	// Task assignments follow the user.
+	_, body := do(t, srv, "GET", "/projects/web/tasks/t1", "benjamin", "")
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "benjamin" {
+		t.Fatalf("t1 assignee = %q, want benjamin", task.Assignee)
+	}
+	_, body = do(t, srv, "GET", "/projects/legacy/tasks/t5", "benjamin", "")
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "benjamin" {
+		t.Fatalf("t5 assignee = %q, want benjamin", task.Assignee)
+	}
+
+	// Contributor rights still work under the new ID.
+	if code, _ := do(t, srv, "PATCH", "/projects/web/tasks/t1", "benjamin", `{"status":"done"}`); code != 200 {
+		t.Fatalf("update own task: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "PATCH", "/projects/web/tasks/t2", "benjamin", `{"status":"done"}`); code != 403 {
+		t.Fatalf("update other's task: got %d want 403", code)
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "benjamin", `{"title":"x","assignee":"benjamin"}`); code != 201 {
+		t.Fatalf("create self-assigned: got %d want 201", code)
+	}
+
+	// Other users are untouched.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat: got %d want 200", code)
+	}
+}
