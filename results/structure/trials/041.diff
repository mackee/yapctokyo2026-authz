+// RenameUser changes a user's ID everywhere it is referenced: the user record,
+// project memberships, and task assignees. Callers must hold s.mu and have
+// already checked that oldID exists and newID is free.
+func (s *Store) RenameUser(oldID, newID string) {
+	u := s.users[oldID]
+	delete(s.users, oldID)
+	u.ID = newID
+	s.users[newID] = u
+
+	for _, members := range s.members {
+		if role, ok := members[oldID]; ok {
+			delete(members, oldID)
+			members[newID] = role
+		}
+	}
+	for _, t := range s.tasks {
+		if t.Assignee == oldID {
+			t.Assignee = newID
+		}
+	}
+}
+
 func (s *Store) DeleteTask(id string) { delete(s.tasks, id) }
 
