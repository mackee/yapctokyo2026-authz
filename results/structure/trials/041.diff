+func TestRenameUser(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin renames", "eve", "/orgs/acme/users/ben", `{"id":"benjamin"}`, 200},
+		{"same id is no-op", "eve", "/orgs/acme/users/ben", `{"id":"ben"}`, 200},
+		{"not org admin", "ann", "/orgs/acme/users/ben", `{"id":"benjamin"}`, 403},
+		{"anonymous", "", "/orgs/acme/users/ben", `{"id":"benjamin"}`, 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", `{"id":"benjamin"}`, 401},
+		{"caller in other org", "gus", "/orgs/acme/users/ben", `{"id":"benjamin"}`, 404},
+		{"org in path is not caller's", "eve", "/orgs/globex/users/gus", `{"id":"gus2"}`, 404},
+		{"target missing", "eve", "/orgs/acme/users/zed", `{"id":"zed2"}`, 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", `{"id":"gus2"}`, 404},
+		{"id taken", "eve", "/orgs/acme/users/ben", `{"id":"cat"}`, 409},
+		{"empty id", "eve", "/orgs/acme/users/ben", `{"id":""}`, 400},
+		{"invalid chars", "eve", "/orgs/acme/users/ben", `{"id":"a/b"}`, 400},
+		{"missing id field", "eve", "/orgs/acme/users/ben", `{}`, 400},
+		{"bad json", "eve", "/orgs/acme/users/ben", `{"id":`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRenameUserResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/orgs/acme/users/ben", "eve", `{"id":"benjamin"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
