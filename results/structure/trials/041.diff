+type userIDRequest struct {
+	ID string `json:"id"`
+}
+
+// validUserID reports whether id is usable as a user ID: non-empty and made
+// only of letters, digits, '-', '_' and '.', so it is safe in headers and paths.
+func validUserID(id string) bool {
+	if id == "" {
+		return false
+	}
+	for _, c := range id {
+		switch {
+		case c >= 'a' && c <= 'z', c >= 'A' && c <= 'Z', c >= '0' && c <= '9',
+			c == '-', c == '_', c == '.':
+		default:
+			return false
+		}
+	}
+	return true
+}
+
+func (s *server) renameUser(w http.ResponseWriter, r *http.Request) {
+	s.store.mu.Lock()
+	defer s.store.mu.Unlock()
+
+	caller := s.store.User(r.Header.Get("X-User"))
+	if caller == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	if caller.OrgID != r.PathValue("orgID") {
+		writeError(w, 404, "not found")
+		return
+	}
+	if !caller.OrgAdmin {
+		writeError(w, 403, "only org admins may change user IDs")
+		return
+	}
+	target := s.store.User(r.PathValue("uid"))
+	if target == nil || target.OrgID != caller.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	var req userIDRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || !validUserID(req.ID) {
+		writeError(w, 400, "invalid user id")
+		return
+	}
+	if req.ID == target.ID {
+		writeJSON(w, 200, userIDRequest{ID: req.ID})
+		return
+	}
+	if s.store.User(req.ID) != nil {
+		writeError(w, 409, "user id already in use")
+		return
+	}
+	s.store.RenameUser(target.ID, req.ID)
+	writeJSON(w, 200, userIDRequest{ID: req.ID})
+}
+
 func writeJSON(w http.ResponseWriter, code int, v any) {
 	w.Header().Set("Content-Type", "application/json")
 	w.WriteHeader(code)
