+func TestFreeze(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "ops", 403}, // ann is only a viewer of ops
+		{"manager of web", "ann", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "ops", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResponseListsViewers(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []string{"ann", "ben", "cat", "dan", "ivy"}
+	if len(got) != len(want) {
+		t.Fatalf("want %d members, got %s", len(want), body)
+	}
+	for i, m := range got {
+		if m.UserID != want[i] || m.Role != "viewer" {
+			t.Fatalf("member %d: got %+v, want {%s viewer}", i, m, want[i])
+		}
+	}
+}
+
+func TestFreezeSingleMemberReturnsJSONArray(t *testing.T) {
+	// gx has one member (gus); the response is still a JSON array.
+	code, body := do(t, newServer(), "POST", "/projects/gx/freeze", "gus", "")
+	if code != 200 || body != "[{\"userId\":\"gus\",\"role\":\"viewer\"}]\n" {
+		t.Fatalf("got %d %q", code, body)
+	}
+}
+
+func TestFreezeBlocksTaskWrites(t *testing.T) {
+	s := newServer()
+	if code, _ := do(t, s, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d", code)
+	}
+	cases := []struct {
+		name, user, method, path, body string
+		want                           int
+	}{
+		{"manager patch", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 409},
+		{"contributor own patch", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`, 409},
+		{"manager create", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`, 409},
+		{"contributor create", "cat", "POST", "/projects/web/tasks", `{"title":"x"}`, 409},
+		{"manager delete", "ann", "DELETE", "/projects/web/tasks/t3", "", 409},
+		{"reads still work", "dan", "GET", "/projects/web/tasks/t1", "", 200},
+		{"former manager cannot freeze again", "ann", "POST", "/projects/web/freeze", "", 403},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, s, c.method, c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestFreezeIsScopedToProject(t *testing.T) {
+	s := newServer()
