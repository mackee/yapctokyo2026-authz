@@ -108,3 +108,38 @@ func loadDeleteTask(x *tx, taskID string) (*deleteTaskAggregate, error) {
 func (a *deleteTaskAggregate) validate() error { return nil }
 
 func (a *deleteTaskAggregate) save(x *tx) { a.task.destroy(x) }
+
+// freezeProjectAggregate freezes one project: every member becomes a viewer
+// and the project is marked frozen, in one transaction.
+type freezeProjectAggregate struct {
+	project projectRecord
+	members []membershipRecord
+}
+
+func loadFreezeProject(x *tx, projectID string) (*freezeProjectAggregate, error) {
+	p, ok := x.findProject(projectID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	return &freezeProjectAggregate{project: p, members: x.membershipsOf(projectID)}, nil
+}
+
+func (a *freezeProjectAggregate) validate() error {
+	if a.project.Archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	return nil
+}
+
+// save returns the members after the freeze, sorted by user ID.
+func (a *freezeProjectAggregate) save(x *tx) []MemberView {
+	a.project.Frozen = true
+	a.project.save(x)
+	out := make([]MemberView, 0, len(a.members))
+	for _, m := range a.members {
+		m.Role = RoleViewer
+		m.save(x)
+		out = append(out, m.view())
+	}
+	return out
+}
