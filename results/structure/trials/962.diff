+// Move moves the user from the project of authz to another project, keeping
+// the role. The actor must be a manager of both projects (the target must be
+// readable by the actor, else ErrNotFound).
+func (*MembershipTable) Move(ctx context.Context, db DB, authz ProjectAuthz, userID, toProjectID string) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if toProjectID == "" {
+		return nil, deny(ErrInvalid, "toProjectId is required")
+	}
+	var moved *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		target, err := NewProjectAuthz(ctx, tx, authz.Actor(), toProjectID)
+		if err != nil {
+			return err
+		}
+		if err := target.CanManageMembers(); err != nil {
+			return err
+		}
+		agg, err := loadMoveMember(ctx, tx, authz.ProjectID(), toProjectID, userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		moved, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return moved, nil
+}
