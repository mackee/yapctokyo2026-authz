+func TestMoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager of both", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 200},
+		{"viewer in target", "ann", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"not manager of source", "ben", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 403},
+		{"archived target", "ann", "/projects/web/members/ben/move", `{"toProjectId":"legacy"}`, 409},
+		{"archived source", "ann", "/projects/legacy/members/ben/move", `{"toProjectId":"web"}`, 409},
+		{"unreadable target", "ann", "/projects/web/members/ben/move", `{"toProjectId":"gx"}`, 404},
+		{"missing target", "ann", "/projects/web/members/ben/move", `{"toProjectId":"nope"}`, 404},
+		{"not a member", "ivy", "/projects/web/members/hal/move", `{"toProjectId":"ops"}`, 404},
+		{"already in target", "ivy", "/projects/ops/members/cat/move", `{"toProjectId":"web"}`, 400},
+		{"same project", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"web"}`, 400},
+		{"bad body", "ivy", "/projects/web/members/ben/move", `{}`, 400},
+		{"anonymous", "", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+
+	t.Run("effects", func(t *testing.T) {
+		h := newServer()
+		code, body := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+		if code != 200 {
+			t.Fatalf("got %d: %s", code, body)
+		}
+		var got map[string]string
+		if err := json.Unmarshal([]byte(body), &got); err != nil {
+			t.Fatal(err)
+		}
+		if got["userId"] != "ben" || got["projectId"] != "ops" || got["role"] != "contributor" {
+			t.Fatalf("unexpected response %v", got)
+		}
+		// ben is no longer a member of web, so ben can't read it.
+		if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+			t.Fatalf("ben reads web: got %d want 404", code)
+		}
+		if code, _ := do(t, h, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+			t.Fatalf("ben reads ops: got %d want 200", code)
+		}
+		// t1 was assigned to ben; it is unassigned now.
+		_, body = do(t, h, "GET", "/projects/web/tasks/t1", "ivy", "")
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.AssigneeID != "" {
+			t.Fatalf("t1 assignee = %q, want unassigned", task.AssigneeID)
+		}
+	})
+}
