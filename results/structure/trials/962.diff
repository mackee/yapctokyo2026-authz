+// moveMemberAggregate moves one member from a project to another project of the
+// same organization, keeping the role. Tasks assigned to the member in the
+// source project are unassigned (an assignee must be a member of the task's
+// project).
+type moveMemberAggregate struct {
+	source   *Project
+	target   *Project
+	member   *Membership // the member in the source project
+	existing *Membership // the user's membership in the target; nil when none
+	tasks    []*Task     // tasks of the source assigned to the member
+}
+
+func loadMoveMember(ctx context.Context, tx DB, sourceID, targetID, userID string) (*moveMemberAggregate, error) {
+	pt := NewProjectTable()
+	src, err := pt.Find(ctx, tx, sourceID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	dst, err := pt.Find(ctx, tx, targetID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	m, err := src.Membership(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveMemberAggregate{source: src, target: dst, member: m}
+	if e, err := dst.Membership(ctx, tx, userID); err == nil {
+		a.existing = e
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	if a.tasks, err = m.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.source.ID == a.target.ID {
+		return deny(ErrInvalid, "target project must differ from the current project")
+	}
+	if a.source.Org != a.target.Org {
+		return deny(ErrInvalid, "target project must be in the same organization")
+	}
+	if a.existing != nil {
+		return deny(ErrInvalid, "user is already a member of the target project")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.member.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	moved := &Membership{ProjectID: a.target.ID, UserID: a.member.UserID, Role: a.member.Role}
+	if err := moved.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return moved, nil
+}
