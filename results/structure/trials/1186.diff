+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes admin", "eve", "/orgs/acme/users/eve", 204},
+		{"non admin", "ann", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"other org caller", "gus", "/orgs/acme/users/ben", 404},
+		{"user in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatal(code)
+	}
+	// Ben was a member of web and legacy; no longer authenticates.
+	for _, p := range []string{"web", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ben", ""); code != 401 {
+			t.Fatalf("%s: got %d want 401", p, code)
+		}
+	}
+	// Assignments are cleared.
+	_, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" {
+		t.Fatalf("assignee not cleared: %q", task.Assignee)
+	}
+	_, body = do(t, h, "GET", "/projects/legacy/tasks/t5", "ann", "")
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" {
+		t.Fatalf("archived assignee not cleared: %q", task.Assignee)
+	}
+	// Other users and orgs are untouched; second removal is 404.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatal(code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatal(code)
+	}
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 404 {
+		t.Fatalf("repeat: got %d want 404", code)
+	}
+}
+
+func TestRemovedAdminLosesAccess(t *testing.T) {
+	h := newServer()
+	do(t, h, "DELETE", "/orgs/acme/users/eve", "eve", "")
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "eve", ""); code != 401 {
+		t.Fatalf("got %d want 401", code)
+	}
+}
