+// setMemberRoleAggregate changes the role of one project member.
+type setMemberRoleAggregate struct {
+	member   *Membership
+	role     string
+	assigned []*Task // the tasks of the member's project assigned to the member
+}
+
+func loadSetMemberRole(ctx context.Context, tx DB, m *Membership, role string) (*setMemberRoleAggregate, error) {
+	assigned, err := m.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &setMemberRoleAggregate{member: m, role: role, assigned: assigned}, nil
+}
+
+func (a *setMemberRoleAggregate) validate() error {
+	if !isWriterRole(a.role) && len(a.assigned) > 0 {
+		return deny(ErrInvalid, "member has assigned tasks and must stay a contributor or manager")
+	}
+	return nil
+}
+
+func (a *setMemberRoleAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.member.setRole(ctx, tx, a.role); err != nil {
+		return nil, err
+	}
+	return a.member, nil
+}
