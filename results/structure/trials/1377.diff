+// SetRole changes the role of a member of the project. It asks the
+// authorization object whether the actor may manage members, then runs the
+// operation's aggregate (aggregate.go) in a transaction. A member who would
+// stop being a contributor or manager must have no tasks assigned in the
+// project (ErrInvalid).
+func (mt *MembershipTable) SetRole(ctx context.Context, db DB, authz ProjectAuthz, userID, role string) (*Membership, error) {
+	if !isProjectRole(role) {
+		return nil, deny(ErrInvalid, "role must be manager, contributor or viewer")
+	}
+	m, err := mt.Find(ctx, db, authz.ProjectID(), userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var out *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadSetMemberRole(ctx, tx, m, role)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		out, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
+
