 package capability
 
+import (
+	"fmt"
+	"sort"
+)
+
 // Aggregates: one per operation. An aggregate is built inside a transaction
 // for a single operation. It loads the records that operation needs,
 // validates the model rules that operation touches, and saves the records.
@@ -108,3 +113,44 @@ func loadDeleteTask(x *tx, taskID string) (*deleteTaskAggregate, error) {
 func (a *deleteTaskAggregate) validate() error { return nil }
 
 func (a *deleteTaskAggregate) save(x *tx) { a.task.destroy(x) }
+
+// setRolesAggregate changes the roles of several members of one project. Every
+// named user must already be a member, and every new role must be valid; the
+// whole change is rejected otherwise.
+type setRolesAggregate struct {
+	members []membershipRecord // memberships as they will be saved
+}
+
+func loadSetRoles(x *tx, projectID string, roles map[string]string) (*setRolesAggregate, error) {
+	userIDs := make([]string, 0, len(roles))
+	for uid := range roles {
+		userIDs = append(userIDs, uid)
+	}
+	sort.Strings(userIDs) // deterministic error messages
+
+	a := &setRolesAggregate{}
+	for _, uid := range userIDs {
+		m, ok := x.findMembership(projectID, uid)
+		if !ok {
+			return nil, deny(ErrInvalid, fmt.Sprintf("%s is not a member of the project", uid))
+		}
+		m.Role = roles[uid]
+		a.members = append(a.members, m)
+	}
+	return a, nil
+}
+
+func (a *setRolesAggregate) validate() error {
+	for _, m := range a.members {
+		if !isRole(m.Role) {
+			return deny(ErrInvalid, fmt.Sprintf("invalid role %q for %s", m.Role, m.UserID))
+		}
+	}
+	return nil
+}
+
+func (a *setRolesAggregate) save(x *tx) {
+	for _, m := range a.members {
+		m.save(x)
+	}
+}
