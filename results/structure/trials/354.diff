diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..7155b9b
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,117 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"reflect"
+	"testing"
+
+	"taskboard/internal/capability"
+)
+
+// webSeed is the seeded member list of the web project (ordered by user ID).
+var webSeed = []capability.MemberView{
+	{UserID: "ann", Role: "manager"},
+	{UserID: "ben", Role: "contributor"},
+	{UserID: "cat", Role: "contributor"},
+	{UserID: "dan", Role: "viewer"},
+	{UserID: "ivy", Role: "manager"},
+}
+
+func putMembers(t *testing.T, h http.Handler, user, project, body string) (int, string) {
+	t.Helper()
+	return do(t, h, "PUT", "/projects/"+project+"/members", user, body)
+}
+
+func decodeMembers(t *testing.T, body string) []capability.MemberView {
+	t.Helper()
+	var got []capability.MemberView
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("response is not a member list: %q: %v", body, err)
+	}
+	return got
+}
+
+func TestSetRolesBulk(t *testing.T) {
+	code, body := putMembers(t, newServer(), "ann", "web", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	want := []capability.MemberView{
+		{UserID: "ann", Role: "manager"},
+		{UserID: "ben", Role: "viewer"},
+		{UserID: "cat", Role: "contributor"},
+		{UserID: "dan", Role: "contributor"},
+		{UserID: "ivy", Role: "manager"},
+	}
+	if got := decodeMembers(t, body); !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+}
+
+func TestSetRolesTakesEffect(t *testing.T) {
+	h := newServer()
+	if code, body := putMembers(t, h, "ann", "web", `{"roles":{"ben":"viewer","dan":"contributor"}}`); code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Fatalf("demoted ben: got %d want 403", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 201 {
+		t.Fatalf("promoted dan: got %d want 201", code)
+	}
+}
+
+func TestSetRolesAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager", "ann", "web", `{"roles":{"ben":"viewer"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"org admin is not a manager", "eve", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"cat":"viewer"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"cat":"viewer"}}`, 404},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"anonymous", "", "web", `{"roles":{"cat":"viewer"}}`, 401},
+		{"unknown user", "zed", "web", `{"roles":{"cat":"viewer"}}`, 401},
+		{"malformed body", "ann", "web", `{"roles":`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := putMembers(t, newServer(), c.user, c.project, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestSetRolesIsAllOrNothing(t *testing.T) {
+	cases := []struct{ name, body string }{
+		{"non member among valid ones", `{"roles":{"ben":"viewer","dan":"contributor","hal":"viewer"}}`},
+		{"unknown user", `{"roles":{"ben":"viewer","zed":"viewer"}}`},
+		{"invalid role", `{"roles":{"ben":"viewer","dan":"owner"}}`},
+		{"empty role", `{"roles":{"ben":"viewer","dan":""}}`},
+		{"empty roles", `{"roles":{}}`},
+		{"missing roles", `{}`},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			if code, body := putMembers(t, h, "ann", "web", c.body); code != 400 {
+				t.Fatalf("got %d want 400: %s", code, body)
+			}
+			// Nothing changed: a valid request on another member returns the
+			// full seeded list, so ben and dan still have their seed roles.
+			code, body := putMembers(t, h, "ann", "web", `{"roles":{"cat":"contributor"}}`)
+			if code != 200 {
+				t.Fatalf("got %d: %s", code, body)
+			}
+			if got := decodeMembers(t, body); !reflect.DeepEqual(got, webSeed) {
+				t.Fatalf("roles changed despite 400: got %+v", got)
+			}
+		})
+	}
+}
