+// Manage applies the member-management rule: readable, manager (else 403; org
+// admins are not managers), not archived (else 409).
+func (s *projectScope) Manage() (ManageProject, error) {
+	err := s.as.a.db.view(func(x *tx) error {
+		p, r, err := readable(x, s.as.actor, s.pid)
+		if err != nil {
+			return err
+		}
+		if r != RoleManager {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if p.Archived {
+			return deny(ErrArchived, "project is archived")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &manageProject{readProject: readProject{ps: s}}, nil
+}
+
 // ---- project capabilities ----------------------------------------------------
 
 // ReadProject may list and read the tasks of one project.
@@ -230,6 +253,59 @@ func (p *readProject) Tasks() []TaskView {
 	return out
 }
 
+// MemberView is the public representation of a project member.
+type MemberView struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// ManageProject may manage the members of one project. It is acquired only by
+// managers of a non-archived project.
+type ManageProject interface {
+	ReadProject
+	// Members lists the project's members, ordered by user ID.
+	Members() []MemberView
+	// SetRoles changes the roles of several members at once and returns the
+	// member list after the change. It is all-or-nothing: if any user is not a
+	// member of the project, or any role is not manager/contributor/viewer, it
+	// returns ErrInvalid (400) and nothing changes. An empty map is also 400.
+	SetRoles(roles map[string]string) ([]MemberView, error)
+}
+
+type manageProject struct{ readProject }
+
+func (p *manageProject) Members() []MemberView {
+	out := []MemberView{}
+	_ = p.ps.as.a.db.view(func(x *tx) error {
+		for _, m := range x.membershipsOf(p.ps.pid) {
+			out = append(out, m.view())
+		}
+		return nil
+	})
+	return out
+}
+
+func (p *manageProject) SetRoles(roles map[string]string) ([]MemberView, error) {
+	if len(roles) == 0 {
+		return nil, deny(ErrInvalid, "roles must not be empty")
+	}
+	err := p.ps.as.a.db.update(func(x *tx) error {
+		agg, err := loadSetRoles(x, p.ps.pid, roles)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		agg.save(x)
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return p.Members(), nil
+}
+
 type writeProject struct {
 	readProject
 	role string
