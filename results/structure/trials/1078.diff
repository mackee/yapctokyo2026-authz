--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,90 @@
+package main
+
+import (
+	"encoding/json"
+	"reflect"
+	"testing"
+)
+
+func TestUpdateMembersResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann",
+		`{"roles":{"ivy":"contributor","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got []Member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []Member{
+		{UserID: "ann", Role: "manager"},
+		{UserID: "ben", Role: "contributor"},
+		{UserID: "cat", Role: "contributor"},
+		{UserID: "dan", Role: "contributor"},
+		{UserID: "ivy", Role: "contributor"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+}
+
+func TestUpdateMembers(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager changes roles", "ann", "web", `{"roles":{"dan":"contributor"}}`, 200},
+		{"manager changes roles of several", "ivy", "ops", `{"roles":{"ann":"contributor","cat":"manager"}}`, 200},
+		{"manager sets same role", "ann", "web", `{"roles":{"ben":"contributor"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"manager"}}`, 409},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"null roles", "ann", "web", `{"roles":null}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"unknown role", "ann", "web", `{"roles":{"dan":"admin"}}`, 400},
+		{"user not in project", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"user in other project", "ann", "web", `{"roles":{"gus":"viewer"}}`, 400},
+		{"viewer would hold assigned task", "ann", "web", `{"roles":{"ben":"viewer"}}`, 400},
+		{"contributor with task to viewer", "ann", "web", `{"roles":{"cat":"viewer"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+// A batch with one change that cannot apply changes nothing: dan's role
+// change in the same request must not be kept.
+func TestUpdateMembersIsAllOrNothing(t *testing.T) {
+	srv := newServer()
+	code, body := do(t, srv, "PUT", "/projects/web/members", "ann",
+		`{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 400 {
+		t.Fatalf("got %d want 400 body=%s", code, body)
+	}
+	// dan is still a viewer, so assigning him a task is still rejected.
+	code, body = do(t, srv, "POST", "/projects/web/tasks", "ann", `{"title":"x","assignee":"dan"}`)
+	if code != 400 {
+		t.Fatalf("dan changed despite failed batch: got %d body=%s", code, body)
+	}
+}
+
+// A successful batch is visible to the next request.
+func TestUpdateMembersPersists(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor"}}`); code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	if code, body := do(t, srv, "POST", "/projects/web/tasks", "ann", `{"title":"x","assignee":"dan"}`); code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+}
