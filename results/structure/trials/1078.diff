+// updateRolesAggregate changes the roles of several members of one project.
+type updateRolesAggregate struct {
+	projectID string
+	changes   []roleChange // ordered by user ID
+}
+
+type roleChange struct {
+	member   *Membership
+	newRole  string
+	assigned []*Task // the member's tasks in the project; loaded when newRole is not a writer role
+}
+
+func loadUpdateRoles(ctx context.Context, tx DB, projectID string, in MembershipTableUpdateRolesInput) (*updateRolesAggregate, error) {
+	userIDs := make([]string, 0, len(in.Roles))
+	for id := range in.Roles {
+		userIDs = append(userIDs, id)
+	}
+	sort.Strings(userIDs)
+	a := &updateRolesAggregate{projectID: projectID}
+	for _, userID := range userIDs {
+		m, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "every user must be a member of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		c := roleChange{member: m, newRole: in.Roles[userID]}
+		if !isWriterRole(c.newRole) {
+			c.assigned, err = m.AssignedTasks(ctx, tx)
+			if err != nil {
+				return nil, err
+			}
+		}
+		a.changes = append(a.changes, c)
+	}
+	return a, nil
+}
+
+func (a *updateRolesAggregate) validate() error {
+	for _, c := range a.changes {
+		if len(c.assigned) > 0 {
+			return deny(ErrInvalid, "a member with assigned tasks must stay a contributor or manager of the project")
+		}
+	}
+	return nil
+}
+
+func (a *updateRolesAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for _, c := range a.changes {
+		if err := c.member.changeRole(ctx, tx, c.newRole); err != nil {
+			return nil, err
+		}
+	}
+	return NewMembershipTable().ListByProject(ctx, tx, a.projectID)
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
