@@ -0,0 +1,67 @@
+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestTransfer(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 || strings.TrimSpace(body) != `{"id":"ben","orgId":"globex"}` {
+		t.Fatalf("got %d %s", code, body)
+	}
+	// ben left acme's projects: no longer readable, tasks unassigned.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("old project still readable: %d", code)
+	}
+	if _, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", ""); !strings.Contains(body, `"assignee":""`) {
+		t.Fatalf("task still assigned: %s", body)
+	}
+	if _, body := do(t, h, "GET", "/projects/legacy/tasks/t5", "ann", ""); !strings.Contains(body, `"assignee":""`) {
+		t.Fatalf("archived task still assigned: %s", body)
+	}
+}
+
+func TestTransferDropsOrgAdmin(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatal(code, body)
+	}
+	// eve is no longer an admin of anything: cannot read gx, cannot transfer.
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "eve", ""); code != 404 {
+		t.Fatalf("got %d", code)
+	}
+	if code, _ := do(t, h, "POST", "/orgs/globex/users/gus/transfer", "eve", `{"toOrgId":"acme"}`); code != 403 {
+		t.Fatalf("got %d", code)
+	}
+}
+
+func TestTransferDenied(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"anonymous", "", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 401},
+		{"non admin", "ann", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 403},
+		{"manager of project", "ivy", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 403},
+		{"admin of other org via own org", "eve", "/orgs/globex/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"user of other org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"unknown org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"nowhere"}`, 400},
+		{"same org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"acme"}`, 400},
+		{"missing body field", "eve", "/orgs/acme/users/ben/transfer", `{}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			if code, body := do(t, h, "POST", c.path, c.user, c.body); code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+			// nothing changed
+			if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+				t.Fatalf("ben was moved: %d", code)
+			}
+		})
+	}
+}
