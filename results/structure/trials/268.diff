@@ -111,6 +111,81 @@ func (a *Authorizer) Authenticate(userID string) (ActorScope, error) {
 type ActorScope interface {
 	Actor() Actor
 	Project(projectID string) ProjectScope
+	Org(orgID string) OrgScope
+}
+
+// OrgScope is bound to one actor and one organization ID. It grants nothing by
+// itself; call Admin to acquire a capability.
+type OrgScope interface {
+	Admin() (AdminOrg, error)
+}
+
+// UserView is the public representation of a user.
+type UserView struct {
+	ID    string `json:"id"`
+	OrgID string `json:"orgId"`
+}
+
+// AdminOrg is the org-admin capability for one organization.
+type AdminOrg interface {
+	// TransferUser moves a user of this organization to another existing
+	// organization. The user loses their project memberships (and task
+	// assignments) in the old organization and any org-admin flag.
+	TransferUser(userID, toOrgID string) (UserView, error)
+}
+
+type orgScope struct {
+	as  *actorScope
+	org string
+}
+
+// Admin applies the org-admin rule: the organization must be the actor's own
+// (else 404) and the actor must be its org admin (else 403).
+func (s *orgScope) Admin() (AdminOrg, error) {
+	act := s.as.actor
+	if act.org != s.org {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if !act.orgAdmin {
+		return nil, deny(ErrForbidden, "forbidden")
+	}
+	return &adminOrg{os: s}, nil
+}
+
+type adminOrg struct{ os *orgScope }
+
+func (o *adminOrg) TransferUser(userID, toOrgID string) (UserView, error) {
+	if toOrgID == "" || toOrgID == o.os.org {
+		return UserView{}, deny(ErrInvalid, "toOrgId must be another organization")
+	}
+	var v UserView
+	err := o.os.as.a.st.tx(func(s *state) error {
+		u, ok := s.users[userID]
+		if !ok || u.org != o.os.org {
+			return deny(ErrNotFound, "not found")
+		}
+		if !s.orgExists(toOrgID) {
+			return deny(ErrInvalid, "unknown destination organization")
+		}
+		u.org = toOrgID
+		u.orgAdmin = false
+		s.users[userID] = u
+		// Memberships and assignments only make sense inside one organization.
+		for pid, m := range s.members {
+			if s.projects[pid].org != toOrgID {
+				delete(m, userID)
+			}
+		}
+		for id, t := range s.tasks {
+			if t.assignee.user == userID && s.projects[t.project].org != toOrgID {
+				t.assignee = Assignee{project: t.project}
+				s.tasks[id] = t
+			}
+		}
+		v = UserView{ID: u.id, OrgID: u.org}
+		return nil
+	})
+	return v, err
 }
 
