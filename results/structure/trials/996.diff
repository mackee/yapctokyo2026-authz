+// ---- member roles ----------------------------------------------------------------
+
+// Member is one project membership as returned by PUT /projects/{pid}/members.
+type Member struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+type memberRolesRequest struct {
+	Roles map[string]string `json:"roles"`
+}
+
+var validRoles = map[string]bool{RoleManager: true, RoleContributor: true, RoleViewer: true}
+
+// setMemberRoles changes the roles of several members at once. Either every
+// change applies or none does. On success it returns the project's full member
+// list after the change.
+func (s *server) setMemberRoles(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role, err := findRole(ctx, s.db, project.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req memberRolesRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || len(req.Roles) == 0 {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	// Sorted so that the same bad request always reports the same error.
+	userIDs := make([]string, 0, len(req.Roles))
+	for id := range req.Roles {
+		userIDs = append(userIDs, id)
+	}
+	sort.Strings(userIDs)
+	for _, id := range userIDs {
+		if !validRoles[req.Roles[id]] {
+			writeError(w, 400, "invalid role for user "+id)
+			return
+		}
+	}
+
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+	for _, id := range userIDs {
+		res, err := tx.ExecContext(ctx, `UPDATE memberships SET role = ? WHERE project_id = ? AND user_id = ?`,
+			req.Roles[id], project.ID, id)
+		if err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+		n, err := res.RowsAffected()
+		if err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+		if n == 0 {
+			writeError(w, 400, "user "+id+" is not a member of the project")
+			return
+		}
+	}
+	rows, err := tx.QueryContext(ctx, `SELECT user_id, role FROM memberships WHERE project_id = ? ORDER BY user_id`, project.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer rows.Close()
+	members := []Member{}
+	for rows.Next() {
+		var m Member
+		if err := rows.Scan(&m.UserID, &m.Role); err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+		members = append(members, m)
+	}
+	if err := rows.Err(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	rows.Close()
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, members)
+}
