+func TestUpdateMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager promotes viewer", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"manager demotes member without tasks", "ann", "/projects/web/members/ivy", `{"role":"viewer"}`, 200},
+		{"manager sets same role", "ann", "/projects/web/members/ann", `{"role":"manager"}`, 200},
+		{"manager demotes assignee", "ann", "/projects/web/members/cat", `{"role":"viewer"}`, 400},
+		{"contributor cannot", "ben", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"viewer cannot", "dan", "/projects/web/members/ivy", `{"role":"viewer"}`, 403},
+		{"manager of other project cannot", "ann", "/projects/ops/members/cat", `{"role":"viewer"}`, 403},
+		{"org admin cannot", "eve", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"non member", "hal", "/projects/web/members/dan", `{"role":"contributor"}`, 404},
+		{"other org", "gus", "/projects/web/members/dan", `{"role":"contributor"}`, 404},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"contributor"}`, 404},
+		{"target in other org", "ann", "/projects/web/members/gus", `{"role":"viewer"}`, 404},
+		{"unknown target", "ann", "/projects/web/members/nobody", `{"role":"viewer"}`, 404},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"bad role", "ann", "/projects/web/members/dan", `{"role":"admin"}`, 400},
+		{"empty role", "ann", "/projects/web/members/dan", `{"role":""}`, 400},
+		{"missing role", "ann", "/projects/web/members/dan", `{}`, 400},
+		{"malformed body", "ann", "/projects/web/members/dan", `{"role":`, 400},
+		{"anonymous", "", "/projects/web/members/dan", `{"role":"contributor"}`, 401},
+		{"unknown user", "zed", "/projects/web/members/dan", `{"role":"contributor"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRoleResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("response is not JSON: %v: %s", err, body)
+	}
+	if got.UserID != "dan" || got.Role != "contributor" {
+		t.Fatalf("got %s, want userId dan and role contributor", body)
+	}
+}
+
+// A role change takes effect on the next request: a promoted viewer can write,
+// and a demoted manager cannot.
+func TestUpdateMemberRoleChangesAccess(t *testing.T) {
+	h := newServer()
+	const task = `{"title":"x"}`
+
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", task); code != 403 {
+		t.Fatalf("viewer create: got %d want 403", code)
+	}
+	if code, _ := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`); code != 200 {
+		t.Fatalf("promote dan: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", task); code != 200 {
+		t.Fatalf("promoted create: got %d want 200", code)
+	}
+
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ivy", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote ivy: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ivy", task); code != 403 {
+		t.Fatalf("demoted create: got %d want 403", code)
+	}
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ivy", "ivy", `{"role":"manager"}`); code != 403 {
+		t.Fatalf("demoted user changes own role: got %d want 403", code)
+	}
+}
