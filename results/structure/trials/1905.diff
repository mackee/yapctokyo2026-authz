+// removeUserAggregate takes one user out of every project of their organization.
+// Because an assignee must be a contributor or manager of the task's project,
+// the tasks assigned to the user are unassigned too (archived projects included:
+// leaving the organization is not a write to the project by a member).
+type removeUserAggregate struct {
+	user        *User
+	memberships []*Membership
+	tasks       []*Task // assigned to the user, in any project
+}
+
+func loadRemoveUser(ctx context.Context, tx DB, orgID, userID string) (*removeUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != orgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	ts, err := u.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &removeUserAggregate{user: u, memberships: ms, tasks: ts}, nil
+}
+
+func (a *removeUserAggregate) validate() error { return nil }
+
+func (a *removeUserAggregate) apply(ctx context.Context, tx DB) error {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
