+
+// RemoveFromOrg takes the user out of the organization's projects (offboarding):
+// the user is removed from every project's members, archived ones included, and
+// the tasks assigned to them become unassigned. The user must be in the
+// organization (else ErrNotFound). Removing a user who has no memberships is
+// not an error.
+func (*UserTable) RemoveFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanAdmin(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveUser(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
