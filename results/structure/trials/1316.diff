+type transferRequest struct {
+	ToOrgID string `json:"toOrgId"`
+}
+
+type transferResponse struct {
+	ID    string `json:"id"`
+	OrgID string `json:"orgId"`
+}
+
+// transferUser moves a user from the org in the path to toOrgId. Only an org
+// admin of that org may do it. The user keeps no project memberships (they all
+// belong to the old org's projects), tasks assigned to them are unassigned, and
+// the org admin flag is cleared so admin rights do not follow the user.
+func (s *server) transferUser(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	caller, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if caller == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	orgID := r.PathValue("orgID")
+	if caller.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	if !caller.OrgAdmin {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	target, err := findUser(ctx, s.db, r.PathValue("uid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if target == nil || target.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	var req transferRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	if req.ToOrgID == orgID {
+		writeError(w, 400, "user is already in that organization")
+		return
+	}
+	exists, err := orgExists(ctx, s.db, req.ToOrgID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if !exists {
+		writeError(w, 400, "unknown organization")
+		return
+	}
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+	stmts := []string{
+		`UPDATE users SET org_id = ?, org_admin = 0 WHERE id = ?`,
+		`DELETE FROM memberships WHERE user_id = ?`,
+		`UPDATE tasks SET assignee = '' WHERE assignee = ?`,
+	}
+	args := [][]any{{req.ToOrgID, target.ID}, {target.ID}, {target.ID}}
+	for i, stmt := range stmts {
+		if _, err := tx.ExecContext(ctx, stmt, args[i]...); err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, transferResponse{ID: target.ID, OrgID: req.ToOrgID})
+}
