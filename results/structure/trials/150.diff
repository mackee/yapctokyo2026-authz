+
+// Transfer applies the org admin rule: the org in the path must be the actor's
+// own organization (else 404), the actor must be an org admin of it (else 403),
+// and the user must belong to it (else 404).
+func (s *userScope) Transfer() (TransferUser, error) {
+	err := s.os.as.a.st.read(func(st *state) error {
+		act := s.os.as.actor
+		if s.os.oid != act.org {
+			return deny(ErrNotFound, "not found")
+		}
+		if !act.orgAdmin {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if u, ok := st.users[s.uid]; !ok || u.org != s.os.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &transferUser{us: s}, nil
+}
+
+// ---- organization capabilities ------------------------------------------------
+
+// UserView is the public representation of a user's organization membership.
+type UserView struct {
+	ID    string `json:"id"`
+	OrgID string `json:"orgId"`
+}
+
+// TransferUser may move one user from the acquired organization to another.
+type TransferUser interface {
+	// To moves the user to toOrgID. The user's org admin right does not follow
+	// them: it is per organization. The move is committed only if the model
+	// invariants still hold, so a user who still holds project roles in the
+	// old organization cannot be moved (400) until those roles are gone.
+	To(toOrgID string) (UserView, error)
+}
+
+type transferUser struct{ us *userScope }
+
+func (t *transferUser) To(toOrgID string) (UserView, error) {
+	var v UserView
+	err := t.us.os.as.a.st.tx(func(s *state) error {
+		u, ok := s.users[t.us.uid]
+		if !ok || u.org != t.us.os.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		if !orgExists(s, toOrgID) {
+			return deny(ErrInvalid, "unknown organization")
+		}
+		if toOrgID == u.org {
+			return deny(ErrInvalid, "user already belongs to that organization")
+		}
+		u.org = toOrgID
+		u.orgAdmin = false
+		s.users[u.id] = u
+		v = UserView{ID: u.id, OrgID: u.org}
+		return nil
+	})
+	return v, err
+}
+
