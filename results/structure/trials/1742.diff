+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager removes viewer", "ann", "/projects/web/members/dan", 204},
+		{"manager removes contributor", "ann", "/projects/web/members/ben", 204},
+		{"manager removes self", "ann", "/projects/web/members/ann", 204},
+		{"contributor", "ben", "/projects/web/members/cat", 403},
+		{"contributor removes self", "ben", "/projects/web/members/ben", 403},
+		{"viewer", "dan", "/projects/web/members/cat", 403},
+		{"org admin", "eve", "/projects/web/members/dan", 403},
+		{"non member", "hal", "/projects/web/members/dan", 404},
+		{"other org", "gus", "/projects/web/members/dan", 404},
+		{"anonymous", "", "/projects/web/members/dan", 401},
+		{"unknown user", "zed", "/projects/web/members/dan", 401},
+		{"unknown project", "ann", "/projects/nope/members/dan", 404},
+		{"target not a member", "ann", "/projects/web/members/hal", 404},
+		{"target not a member of this project", "ann", "/projects/web/members/gus", 404},
+		{"target unknown user", "ann", "/projects/web/members/zed", 404},
+		{"archived", "ann", "/projects/legacy/members/ben", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveMemberTakesEffect(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "dan", ""); code != 200 {
+		t.Fatalf("before: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/dan", "ann", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+	// The removed user can no longer read the project.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "dan", ""); code != 404 {
+		t.Fatalf("after: got %d want 404", code)
+	}
+	// Removing again: the user is no longer a member.
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/dan", "ann", ""); code != 404 {
+		t.Fatalf("again: got %d want 404", code)
+	}
+	// Other members are untouched.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("other member: got %d want 200", code)
+	}
+}
+
+func TestRemoveMemberOnlyThisProject(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ann", "ann", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+	// ann is still a member of ops and legacy.
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "ann", ""); code != 200 {
+		t.Fatalf("ops: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/legacy/tasks", "ann", ""); code != 200 {
+		t.Fatalf("legacy: got %d want 200", code)
+	}
+}
