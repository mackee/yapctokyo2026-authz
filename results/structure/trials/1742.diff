+// An assignee must be a contributor or manager of the task's project, so
+// removing a member unassigns their tasks in that project (and only there).
+func TestRemoveMemberUnassignsTasks(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/cat", "ann", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+	assignee := func(project, tid string) string {
+		t.Helper()
+		code, body := do(t, h, "GET", "/projects/"+project+"/tasks/"+tid, "ann", "")
+		if code != 200 {
+			t.Fatalf("get %s: %d", tid, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		return task.AssigneeID
+	}
+	if got := assignee("web", "t2"); got != "" {
+		t.Fatalf("t2 (web, was cat) assignee = %q, want unassigned", got)
+	}
+	if got := assignee("web", "t1"); got != "ben" {
+		t.Fatalf("t1 assignee = %q, want ben (unrelated)", got)
+	}
+	// cat is still a member of ops and keeps the task there.
+	if got := assignee("ops", "t4"); got != "cat" {
+		t.Fatalf("t4 (ops) assignee = %q, want cat", got)
+	}
+}
