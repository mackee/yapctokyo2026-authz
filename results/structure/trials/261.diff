+func TestFreezeAuthz(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"archived", "ann", "legacy", 409},
+		{"unknown project", "ann", "nope", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeEffect(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("freeze: %d %s", code, body)
+	}
+	var members []map[string]string
+	if err := json.Unmarshal([]byte(body), &members); err != nil {
+		t.Fatal(err)
+	}
+	want := []string{"ann", "ben", "cat", "dan", "ivy"}
+	if len(members) != len(want) {
+		t.Fatalf("members: %s", body)
+	}
+	for i, m := range members {
+		if m["userId"] != want[i] || m["role"] != "viewer" || len(m) != 2 {
+			t.Fatalf("unexpected member %v", m)
+		}
+	}
+
+	// Nobody can modify tasks any more, including the former manager.
+	for _, user := range []string{"ann", "ben", "cat", "dan", "ivy", "eve"} {
+		for _, c := range []struct{ method, path, body string }{
+			{"POST", "/projects/web/tasks", `{"title":"x"}`},
+			{"PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+			{"PATCH", "/projects/web/tasks/t3", `{"status":"done"}`},
+			{"DELETE", "/projects/web/tasks/t1", ""},
+			{"POST", "/projects/web/freeze", ""},
+		} {
+			if code, _ := do(t, h, c.method, c.path, user, c.body); code != 403 {
+				t.Fatalf("%s %s %s: got %d want 403", user, c.method, c.path, code)
+			}
+		}
+	}
+
+	// Members can still read, and tasks are intact.
+	code, body = do(t, h, "GET", "/projects/web/tasks", "ben", "")
+	if code != 200 {
+		t.Fatal(code)
+	}
+	var tasks []Task
+	json.Unmarshal([]byte(body), &tasks)
+	if len(tasks) != 3 || tasks[0].Assignee != "ben" || tasks[0].Status != "open" {
+		t.Fatalf("tasks changed: %s", body)
+	}
+
+	// Other projects are unaffected.
+	if code, _ := do(t, h, "POST", "/projects/ops/tasks", "ivy", `{"title":"x"}`); code != 201 {
+		t.Fatalf("ops should be writable, got %d", code)
+	}
+}
