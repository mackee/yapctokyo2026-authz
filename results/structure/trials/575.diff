+// changeRoleAggregate changes the role of one project member.
+type changeRoleAggregate struct {
+	member   *Membership
+	role     string
+	assigned []*Task       // member.AssignedTasks (only loaded when the role is not a writer role)
+	members  []*Membership // project members, to keep at least one manager
+}
+
+func loadChangeRole(ctx context.Context, tx DB, projectID, userID, role string) (*changeRoleAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	m, err := p.Membership(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &changeRoleAggregate{member: m, role: role}
+	if !isWriterRole(role) {
+		if a.assigned, err = m.AssignedTasks(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if m.Role == RoleManager && role != RoleManager {
+		if a.members, err = p.Memberships(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	return a, nil
+}
+
+func (a *changeRoleAggregate) validate() error {
+	if !validRoles[a.role] {
+		return deny(ErrInvalid, "invalid role")
+	}
+	if len(a.assigned) > 0 {
+		return deny(ErrInvalid, "member has assigned tasks; reassign them before making the member a viewer")
+	}
+	if a.members != nil {
+		managers := 0
+		for _, m := range a.members {
+			if m.Role == RoleManager {
+				managers++
+			}
+		}
+		if managers <= 1 {
+			return deny(ErrInvalid, "project must keep at least one manager")
+		}
+	}
+	return nil
+}
+
+func (a *changeRoleAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.member.changeRole(ctx, tx, a.role); err != nil {
+		return nil, err
+	}
+	return a.member, nil
+}
