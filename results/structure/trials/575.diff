--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,77 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestChangeMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager promotes viewer", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"manager demotes manager", "ann", "/projects/web/members/ivy", `{"role":"viewer"}`, 200},
+		{"manager demotes self when another manager exists", "ann", "/projects/web/members/ann", `{"role":"contributor"}`, 200},
+		{"contributor forbidden", "ben", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"viewer forbidden", "dan", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"org admin forbidden", "eve", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"non member", "hal", "/projects/web/members/dan", `{"role":"viewer"}`, 404},
+		{"other org", "gus", "/projects/web/members/dan", `{"role":"viewer"}`, 404},
+		{"anonymous", "", "/projects/web/members/dan", `{"role":"viewer"}`, 401},
+		{"target is not a member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"target member of other project only", "ann", "/projects/web/members/gus", `{"role":"viewer"}`, 404},
+		{"archived project", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"unknown role", "ann", "/projects/web/members/dan", `{"role":"owner"}`, 400},
+		{"missing role", "ann", "/projects/web/members/dan", `{}`, 400},
+		{"bad json", "ann", "/projects/web/members/dan", `{`, 400},
+		{"bad body beats access check", "hal", "/projects/web/members/dan", `{"role":"owner"}`, 400},
+		{"member with assigned tasks cannot become viewer", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 400},
+		{"last manager cannot be demoted", "ivy", "/projects/ops/members/ivy", `{"role":"contributor"}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestChangeMemberRoleResponseAndEffect(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 2 || got["userId"] != "dan" || got["role"] != "contributor" {
+		t.Fatalf("unexpected response %v", got)
+	}
+	// dan is now a contributor: he can create a task and be assigned one.
+	if code, body := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x","assignee":"dan"}`); code != 200 {
+		t.Fatalf("dan create after promotion: %d %s", code, body)
+	}
+	// A demoted manager loses manager rights.
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ivy", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote ivy: %d", code)
+	}
+	if code, _ := do(t, h, "DELETE", "/projects/web/tasks/t3", "ivy", ""); code != 403 {
+		t.Fatalf("ivy delete after demotion: %d", code)
+	}
+}
+
+func TestChangeMemberRoleRejectedChangeIsNotSaved(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 400 {
+		t.Fatalf("got %d", code)
+	}
+	// ben is still a contributor and can still edit his task.
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"doing"}`); code != 200 {
+		t.Fatalf("ben edit: %d", code)
+	}
+}
