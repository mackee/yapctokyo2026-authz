--- /dev/null
+++ b/internal/capability/org.go
@@ -0,0 +1,98 @@
+package capability
+
+// Organization administration: moving a user from one organization to another
+// (for example between group companies).
+
+// OrgScope is bound to one actor and one organization ID. It grants nothing by
+// itself; call Admin to acquire the org-admin capability.
+type OrgScope interface {
+	ID() string
+	Actor() ActorScope
+	Admin() (AdminOrg, error)
+}
+
+// AdminOrg may administer users of one organization. It is only acquirable by
+// an org admin of that organization.
+type AdminOrg interface {
+	ID() string
+	// TransferUser moves a user of this organization to toOrgID. The user loses
+	// the organization's roles and assignments: their project memberships are
+	// removed and tasks they were assigned to become unassigned. They also stop
+	// being an org admin. The whole transfer is one atomic commit.
+	TransferUser(userID, toOrgID string) (UserView, error)
+}
+
+// UserView is the public representation of a user's organization membership.
+type UserView struct {
+	ID    string `json:"id"`
+	OrgID string `json:"orgId"`
+}
+
+type orgScope struct {
+	as  *actorScope
+	oid string
+}
+
+func (s *orgScope) ID() string        { return s.oid }
+func (s *orgScope) Actor() ActorScope { return s.as }
+
+// Admin applies the org-admin rule: the org must be the actor's own (else 404),
+// and the actor must be an org admin of it (else 403).
+func (s *orgScope) Admin() (AdminOrg, error) {
+	err := s.as.a.st.read(func(st *state) error {
+		if !st.orgs[s.oid] || s.as.actor.org != s.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		if !s.as.actor.orgAdmin {
+			return deny(ErrForbidden, "forbidden")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &adminOrg{orgScope: orgScope{as: s.as, oid: s.oid}}, nil
+}
+
+type adminOrg struct {
+	orgScope
+}
+
+func (o *adminOrg) TransferUser(userID, toOrgID string) (UserView, error) {
+	var v UserView
+	err := o.as.a.st.tx(func(s *state) error {
+		u, ok := s.users[userID]
+		if !ok || u.org != o.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		if toOrgID == "" || !s.orgs[toOrgID] {
+			return deny(ErrInvalid, "unknown target organization")
+		}
+		if toOrgID == u.org {
+			return deny(ErrInvalid, "user already belongs to the target organization")
+		}
+
+		u.org = toOrgID
+		u.orgAdmin = false
+		s.users[userID] = u
+
+		// Roles are per project and projects belong to an organization, so the
+		// user's memberships in the old organization no longer apply.
+		for pid, m := range s.members {
+			delete(m, userID)
+			s.members[pid] = m
+		}
+		// Assignees must be members of the task's project, so release the
+		// user's tasks.
+		for id, t := range s.tasks {
+			if t.assignee.user == userID {
+				t.assignee = Assignee{project: t.project}
+				s.tasks[id] = t
+			}
+		}
+
+		v = UserView{ID: u.id, OrgID: u.org}
+		return nil
+	})
+	return v, err
+}
