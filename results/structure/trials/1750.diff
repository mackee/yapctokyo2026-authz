+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"testing"
+)
+
+type memberView struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func TestFreeze(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"other manager", "ivy", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+		{"unknown project", "ann", "nope", 404},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResponseListsAllMembersAsViewers(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got []memberView
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err, body)
+	}
+	want := []string{"ann", "ben", "cat", "dan", "ivy"}
+	if len(got) != len(want) {
+		t.Fatalf("got %+v", got)
+	}
+	for i, m := range got {
+		if m.UserID != want[i] || m.Role != "viewer" {
+			t.Fatalf("member %d: %+v", i, m)
+		}
+	}
+	// exactly userId and role, nothing else
+	var raw []map[string]any
+	json.Unmarshal([]byte(body), &raw)
+	for _, m := range raw {
+		if len(m) != 2 {
+			t.Fatalf("unexpected fields: %v", m)
+		}
+	}
+}
+
+func TestFreezeBlocksAllTaskChanges(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatal(code, body)
+	}
+	cases := []struct {
+		name, method, user, path, body string
+	}{
+		{"manager creates", "POST", "ann", "/projects/web/tasks", `{"title":"x"}`},
+		{"manager updates", "PATCH", "ann", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"manager deletes", "DELETE", "ann", "/projects/web/tasks/t1", ""},
+		{"other manager updates", "PATCH", "ivy", "/projects/web/tasks/t3", `{"title":"y"}`},
+		{"former contributor updates", "PATCH", "cat", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"former contributor creates", "POST", "ben", "/projects/web/tasks", `{"title":"x"}`},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			if code, _ := do(t, srv, c.method, c.path, c.user, c.body); code != http.StatusForbidden {
+				t.Fatalf("got %d want 403", code)
+			}
+		})
+	}
+	// freezing again is not possible: nobody is a manager any more
+	if code, _ := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != 403 {
+		t.Fatalf("second freeze got %d want 403", code)
+	}
+}
+
+func TestFreezeKeepsTasksReadableAndKeepsRuleThatAssigneesCanWrite(t *testing.T) {
+	srv := newServer()
+	do(t, srv, "POST", "/projects/web/freeze", "ann", "")
+	code, body := do(t, srv, "GET", "/projects/web/tasks", "dan", "")
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var tasks []Task
+	json.Unmarshal([]byte(body), &tasks)
+	if len(tasks) != 3 {
+		t.Fatalf("want 3 tasks, got %d", len(tasks))
+	}
+	for _, task := range tasks {
+		// no member can write any more, so no task may keep an assignee
+		if task.AssigneeID != "" {
+			t.Fatalf("task %s still assigned to %s", task.ID, task.AssigneeID)
+		}
+	}
+}
+
+func TestFreezeAffectsOnlyThatProject(t *testing.T) {
+	srv := newServer()
+	do(t, srv, "POST", "/projects/web/freeze", "ann", "")
+	if code, body := do(t, srv, "POST", "/projects/ops/tasks", "ivy", `{"title":"x"}`); code != 200 {
+		t.Fatalf("ops should be unaffected: %d %s", code, body)
+	}
+	if code, body := do(t, srv, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ops should be unaffected: %d %s", code, body)
+	}
+	code, body := do(t, srv, "GET", "/projects/ops/tasks/t4", "ann", "")
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+}
