+func TestFreeze(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin non-member", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"missing project", "ann", "nope", 404},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			code, _ := do(t, h, "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+			// a rejected freeze must not change anything
+			if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t3", "ann", `{"title":"still works"}`); code != 200 {
+				t.Fatalf("project unexpectedly frozen: %d", code)
+			}
+		})
+	}
+}
+
+func TestFreezeSuccess(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ivy", "")
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var members []map[string]string
+	if err := json.Unmarshal([]byte(body), &members); err != nil {
+		t.Fatal(err)
+	}
+	if len(members) != 5 {
+		t.Fatalf("want 5 members, got %v", members)
+	}
+	for _, m := range members {
+		if len(m) != 2 || m["role"] != "viewer" || m["userId"] == "" {
+			t.Fatalf("bad member %v", m)
+		}
+	}
+	// other projects are untouched
+	if code, _ := do(t, h, "PATCH", "/projects/ops/tasks/t4", "ivy", `{"status":"doing"}`); code != 200 {
+		t.Fatalf("ops affected: %d", code)
+	}
+	// nobody can write to the frozen project any more
+	for _, u := range []string{"ann", "ben", "cat", "dan", "ivy", "eve"} {
+		if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", u, `{"title":"x"}`); code != 403 {
+			t.Fatalf("%s patch: got %d", u, code)
+		}
+		if code, _ := do(t, h, "POST", "/projects/web/tasks", u, `{"title":"x"}`); code != 403 {
+			t.Fatalf("%s create: got %d", u, code)
+		}
+		if code, _ := do(t, h, "DELETE", "/projects/web/tasks/t1", u, ""); code != 403 {
+			t.Fatalf("%s delete: got %d", u, code)
+		}
+	}
+	// still readable
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "dan", ""); code != 200 {
+		t.Fatal(code)
+	}
+}
