+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"reflect"
+	"testing"
+)
+
+func TestFreezeStatus(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager freezes", "ann", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+		{"missing project", "ann", "nope", 404},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResponseListsMembersAsViewers(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+	var got []map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("body is not a JSON array of objects: %v: %s", err, body)
+	}
+	want := []map[string]string{
+		{"userId": "ann", "role": "viewer"},
+		{"userId": "ben", "role": "viewer"},
+		{"userId": "cat", "role": "viewer"},
+		{"userId": "dan", "role": "viewer"},
+		{"userId": "ivy", "role": "viewer"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %v\nwant %v", got, want)
+	}
+}
+
+func TestFreezeBlocksTaskWrites(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze got %d want 200", code)
+	}
+	cases := []struct {
+		name, user, method, path, body string
+	}{
+		{"manager patch", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"contributor own patch", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"manager create", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"contributor create", "ben", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"manager delete", "ann", "DELETE", "/projects/web/tasks/t1", ""},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, h, c.method, c.path, c.user, c.body)
+			if code != 403 {
+				t.Fatalf("got %d want 403", code)
+			}
+		})
+	}
+
+	// The rejected patch must not have changed the task.
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ben", "")
+	if code != 200 {
+		t.Fatalf("get got %d want 200", code)
+	}
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Status != "open" {
+		t.Fatalf("task status changed to %q after frozen write", task.Status)
+	}
+
+	// Reads still work after freezing.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "dan", ""); code != http.StatusOK {
+		t.Fatalf("list after freeze got %d want 200", code)
+	}
+}
+
+func TestFreezeIsScopedToOneProject(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze got %d want 200", code)
+	}
+	// ivy is a manager of ops, which was not frozen.
+	if code, _ := do(t, h, "PATCH", "/projects/ops/tasks/t4", "ivy", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ops patch got %d want 200", code)
+	}
+}
