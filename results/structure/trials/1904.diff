+// OrgAuthz is what the actor may do in one organization.
+type OrgAuthz struct {
+	actor Actor
+	org   string
+}
+
+// Actor returns the authenticated actor.
+func (a OrgAuthz) Actor() Actor { return a.actor }
+
+// OrgID returns the organization the object is bound to.
+func (a OrgAuthz) OrgID() string { return a.org }
+
+// CanRead reports whether the actor belongs to the organization. NewOrgAuthz
+// only returns objects that can read.
+func (a OrgAuthz) CanRead() bool { return a.org != "" && a.actor.org == a.org }
+
+// CanManage returns nil if the actor may manage the organization's users:
+// org admins only (else ErrForbidden).
+func (a OrgAuthz) CanManage() error {
+	if !a.CanRead() || !a.actor.orgAdmin {
+		return deny(ErrForbidden, "forbidden")
+	}
+	return nil
+}
+
 // ---- building authorization objects -------------------------------------------------
 
+// NewOrgAuthz builds the actor's authorization object for one organization.
+// The actor must belong to it; otherwise ErrNotFound.
+func NewOrgAuthz(act Actor, orgID string) (OrgAuthz, error) {
+	if orgID == "" || act.org != orgID {
+		return OrgAuthz{}, deny(ErrNotFound, "not found")
+	}
+	return OrgAuthz{actor: act, org: orgID}, nil
+}
