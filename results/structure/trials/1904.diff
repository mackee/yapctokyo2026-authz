diff --git a/offboard_test.go b/offboard_test.go
new file mode 100644
index 0000000..543a792
--- /dev/null
+++ b/offboard_test.go
@@ -0,0 +1,138 @@
+package main
+
+import (
+	"net/http"
+	"testing"
+)
+
+// memberships returns the project IDs the user is a member of, and the IDs of
+// the tasks assigned to the user, read straight from the database behind h.
+func memberships(t *testing.T, h http.Handler, user string) (projects, tasks []string) {
+	t.Helper()
+	app := h.(*appHandler)
+	collect := func(query string) []string {
+		rows, err := app.db.Query(query, user)
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer rows.Close()
+		var out []string
+		for rows.Next() {
+			var s string
+			if err := rows.Scan(&s); err != nil {
+				t.Fatal(err)
+			}
+			out = append(out, s)
+		}
+		return out
+	}
+	return collect(`SELECT project_id FROM memberships WHERE user_id = ? ORDER BY project_id`),
+		collect(`SELECT id FROM tasks WHERE assignee = ? ORDER BY id`)
+}
+
+func TestRemoveUserFromOrg(t *testing.T) {
+	cases := []struct {
+		name, actor, path string
+		want              int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes user without projects", "eve", "/orgs/acme/users/hal", 204},
+		{"manager is not an org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"contributor is not an org admin", "ben", "/orgs/acme/users/cat", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown actor", "zed", "/orgs/acme/users/ben", 401},
+		{"unknown target user", "eve", "/orgs/acme/users/zed", 404},
+		{"target in another org", "eve", "/orgs/acme/users/gus", 404},
+		{"actor's org is not the path org", "eve", "/orgs/globex/users/gus", 404},
+		{"non admin of another org gets 404", "gus", "/orgs/acme/users/ben", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.actor, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveUserFromOrgRemovesAllMemberships(t *testing.T) {
+	h := newServer()
+
+	// ann is a member of web, ops and legacy (archived).
+	projects, _ := memberships(t, h, "ann")
+	if len(projects) != 3 {
+		t.Fatalf("seed: ann is in %v", projects)
+	}
+
+	if code, body := do(t, h, "DELETE", "/orgs/acme/users/ann", "eve", ""); code != 204 {
+		t.Fatalf("got %d %s", code, body)
+	}
+
+	projects, _ = memberships(t, h, "ann")
+	if len(projects) != 0 {
+		t.Fatalf("ann is still a member of %v", projects)
+	}
+	// The ex-member can no longer read any project.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ann", ""); code != 404 {
+		t.Fatalf("former member can still read web: %d", code)
+	}
+}
+
+// Removing a member must leave the data consistent (do() checks the model
+// rules): the tasks assigned to the user, including those in an archived
+// project, become unassigned.
+func TestRemoveUserFromOrgUnassignsTasks(t *testing.T) {
+	h := newServer()
+
+	// ben: t1 (web) and t5 (legacy, archived).
+	if _, tasks := memberships(t, h, "ben"); len(tasks) != 2 {
+		t.Fatalf("seed: ben has tasks %v", tasks)
+	}
+
+	if code, body := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("got %d %s", code, body)
+	}
+
+	if _, tasks := memberships(t, h, "ben"); len(tasks) != 0 {
+		t.Fatalf("ben still has tasks %v", tasks)
+	}
+	// The tasks themselves are kept.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t1", "ann", ""); code != 200 {
+		t.Fatalf("t1 should still exist: %d", code)
+	}
+}
+
+func TestRemoveUserFromOrgLeavesOthersAlone(t *testing.T) {
+	h := newServer()
+
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("got %d", code)
+	}
+
+	projects, tasks := memberships(t, h, "cat")
+	if len(projects) != 2 || len(tasks) != 2 {
+		t.Fatalf("cat was affected: projects %v tasks %v", projects, tasks)
+	}
+	if projects, _ := memberships(t, h, "gus"); len(projects) != 1 {
+		t.Fatalf("gus was affected: %v", projects)
+	}
+}
+
+func TestRemoveUserFromOrgDeniedChangesNothing(t *testing.T) {
+	h := newServer()
+
+	for _, c := range []struct{ actor, path string }{
+		{"ann", "/orgs/acme/users/ben"},
+		{"eve", "/orgs/acme/users/gus"},
+		{"gus", "/orgs/acme/users/ben"},
+	} {
+		do(t, h, "DELETE", c.path, c.actor, "")
+	}
+	if projects, tasks := memberships(t, h, "ben"); len(projects) != 2 || len(tasks) != 2 {
+		t.Fatalf("ben changed: projects %v tasks %v", projects, tasks)
+	}
+	if projects, _ := memberships(t, h, "gus"); len(projects) != 1 {
+		t.Fatalf("gus changed: %v", projects)
+	}
+}
