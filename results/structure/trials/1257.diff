+func TestChangeRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager promotes viewer", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"manager demotes unassigned member", "ann", "/projects/web/members/ivy", `{"role":"viewer"}`, 200},
+		{"manager demotes self", "ann", "/projects/web/members/ann", `{"role":"viewer"}`, 200},
+		{"viewer target stays viewer", "ann", "/projects/web/members/dan", `{"role":"viewer"}`, 200},
+		{"contributor forbidden", "ben", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"viewer forbidden", "dan", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"org admin forbidden", "eve", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"manager elsewhere but viewer here", "ann", "/projects/ops/members/cat", `{"role":"viewer"}`, 403},
+		{"non member sees 404", "hal", "/projects/web/members/dan", `{"role":"contributor"}`, 404},
+		{"other org 404", "gus", "/projects/web/members/dan", `{"role":"contributor"}`, 404},
+		{"anonymous", "", "/projects/web/members/dan", `{"role":"contributor"}`, 401},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"contributor"}`, 404},
+		{"unknown target", "ann", "/projects/web/members/zed", `{"role":"contributor"}`, 404},
+		{"invalid role", "ann", "/projects/web/members/dan", `{"role":"owner"}`, 400},
+		{"missing role", "ann", "/projects/web/members/dan", `{}`, 400},
+		{"malformed body", "ann", "/projects/web/members/dan", `{`, 400},
+		{"assigned tasks block viewer", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 400},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"manager"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestChangeRoleResponseAndEffect(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got struct{ UserID, Role string }
+	if err := json.Unmarshal([]byte(body), &got); err != nil || got.UserID != "dan" || got.Role != "contributor" {
+		t.Fatalf("unexpected response %s", body)
+	}
+	if !strings.Contains(body, `"userId"`) || !strings.Contains(body, `"role"`) {
+		t.Fatalf("unexpected keys %s", body)
+	}
+	// The new role takes effect: dan can now create tasks, and was a viewer before.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 201 && code != 200 {
+		t.Fatalf("dan should be able to write, got %d", code)
+	}
+	// Demoting back is blocked only if tasks are assigned; assign one to dan, then try.
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t3", "ann", `{"assignee":"dan"}`); code != 200 {
+		t.Fatalf("assign got %d", code)
+	}
+	if code, _ := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"viewer"}`); code != 400 {
+		t.Fatalf("demote with tasks got %d want 400", code)
+	}
+	// Role unchanged after the rejected change: dan can still write.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"y"}`); code != 201 && code != 200 {
+		t.Fatalf("rejected change must not apply, got %d", code)
+	}
+}
