+func TestFreeze(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var members []struct{ UserID, Role string }
+	if err := json.Unmarshal([]byte(body), &members); err != nil {
+		t.Fatal(err)
+	}
+	if len(members) != 5 {
+		t.Fatalf("want 5 members, got %v", members)
+	}
+	for _, m := range members {
+		if m.Role != "viewer" {
+			t.Fatalf("%s is %s", m.UserID, m.Role)
+		}
+	}
+	if !strings.Contains(body, `"userId":"ann","role":"viewer"`) {
+		t.Fatalf("unexpected JSON shape: %s", body)
+	}
+
+	// Nobody can change tasks any more, including the former manager.
+	for _, u := range []string{"ann", "ivy", "ben", "cat", "dan", "eve"} {
+		if code, _ := do(t, h, "POST", "/projects/web/tasks", u, `{"title":"x"}`); code != 403 {
+			t.Errorf("%s create: got %d", u, code)
+		}
+		if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", u, `{"status":"done"}`); code != 403 {
+			t.Errorf("%s update: got %d", u, code)
+		}
+		if code, _ := do(t, h, "DELETE", "/projects/web/tasks/t1", u, ""); code != 403 {
+			t.Errorf("%s delete: got %d", u, code)
+		}
+	}
+	// Members can still read, and assignees are preserved.
+	code, body = do(t, h, "GET", "/projects/web/tasks/t1", "ben", "")
+	if code != 200 || !strings.Contains(body, `"assignee":"ben"`) {
+		t.Fatalf("read after freeze: %d %s", code, body)
+	}
+	// A second freeze is refused (nobody is a manager any more).
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 403 {
+		t.Fatalf("second freeze: got %d", code)
+	}
+	// Other projects are untouched.
+	if code, _ := do(t, h, "POST", "/projects/ops/tasks", "cat", `{"title":"x"}`); code != 201 {
+		t.Fatalf("ops create: got %d", code)
+	}
+}
