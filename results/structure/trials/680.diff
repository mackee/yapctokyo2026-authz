+func TestUpdateMemberRolesDenied(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"contributor", "ben", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"org admin cannot write", "eve", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"cat":"viewer"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"cat":"viewer"}}`, 404},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"invalid role", "ann", "web", `{"roles":{"ben":"owner"}}`, 400},
+		{"target not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"target in other project", "ann", "web", `{"roles":{"cat":"viewer","ivy":"viewer","gus":"viewer"}}`, 400},
+		{"bad body", "ann", "web", `not json`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRolesBatch(t *testing.T) {
+	s := newServer()
+
+	// A batch with one bad target changes nothing: ben stays a contributor.
+	code, body := do(t, s, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","hal":"viewer"}}`)
+	if code != 400 {
+		t.Fatalf("got %d want 400 body=%s", code, body)
+	}
+	if code, _ := do(t, s, "POST", "/projects/web/tasks", "ben", `{"title":"x","assignee":"ben"}`); code != 200 {
+		t.Fatalf("failed batch changed ben's role: create got %d", code)
+	}
+
+	// A valid batch returns the full member list ordered by userId.
+	code, body = do(t, s, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200 body=%s", code, body)
+	}
+	var members []memberRole
+	if err := json.Unmarshal([]byte(body), &members); err != nil {
+		t.Fatal(err)
+	}
+	want := []memberRole{
+		{"ann", "manager"}, {"ben", "viewer"}, {"cat", "contributor"}, {"dan", "contributor"}, {"ivy", "manager"},
+	}
+	if len(members) != len(want) {
+		t.Fatalf("got %d members want %d: %s", len(members), len(want), body)
+	}
+	for i := range want {
+		if members[i] != want[i] {
+			t.Fatalf("member %d: got %+v want %+v", i, members[i], want[i])
+		}
+	}
+
+	// The change takes effect: ben can no longer create tasks, dan now can.
+	if code, _ := do(t, s, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Fatalf("demoted ben create got %d want 403", code)
+	}
+	if code, _ := do(t, s, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("promoted dan create got %d want 200", code)
+	}
+}
