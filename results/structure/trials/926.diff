+// CanMove returns nil if the actor may move the task to the destination
+// project: contributor or manager in both projects (else ErrForbidden);
+// contributors in either project only for tasks assigned to themselves, while
+// a manager in both may move any task (else ErrForbidden); neither project is
+// archived (else ErrArchived).
+func (a TaskAuthz) CanMove(dest ProjectAuthz) error {
+	if !a.CanRead() || !dest.CanRead() || !isWriterRole(a.project.role) || !isWriterRole(dest.role) {
+		return deny(ErrForbidden, "forbidden")
+	}
+	bothManagers := a.project.role == RoleManager && dest.role == RoleManager
+	if !bothManagers && !a.isAssignee {
+		return deny(ErrForbidden, "contributors may only move their own tasks")
+	}
+	if a.project.archived || dest.archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	return nil
+}
+
