+func TestSetRolesStatus(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager changes roles", "ann", "web", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 200},
+		{"manager promotes to manager", "ann", "web", `{"roles":{"cat":"manager"}}`, 200},
+		{"contributor caller", "ben", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"viewer caller", "dan", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"org admin caller", "eve", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"non member caller", "hal", "web", `{"roles":{"cat":"viewer"}}`, 404},
+		{"other org caller", "gus", "web", `{"roles":{"cat":"viewer"}}`, 404},
+		{"unknown caller", "zed", "web", `{"roles":{"cat":"viewer"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"bad json", "ann", "web", `{"roles":`, 400},
+		{"invalid role", "ann", "web", `{"roles":{"ben":"owner"}}`, 400},
+		{"target not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"org admin is not a member", "ann", "web", `{"roles":{"eve":"viewer"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetRolesResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var members []memberRole
+	if err := json.Unmarshal([]byte(body), &members); err != nil {
+		t.Fatal(err)
+	}
+	want := []memberRole{
+		{"ann", "manager"},
+		{"ben", "viewer"},
+		{"cat", "contributor"},
+		{"dan", "contributor"},
+		{"ivy", "manager"},
+	}
+	if len(members) != len(want) {
+		t.Fatalf("got %v want %v", members, want)
+	}
+	for i := range want {
+		if members[i] != want[i] {
+			t.Fatalf("member %d: got %v want %v", i, members[i], want[i])
+		}
+	}
+}
+
+func TestSetRolesTakesEffect(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor"}}`); code != 200 {
+		t.Fatalf("role change: got %d: %s", code, body)
+	}
+	// dan was a viewer; as a contributor he may now create tasks.
+	if code, body := do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("create after promotion: got %d: %s", code, body)
+	}
+}
+
+func TestSetRolesAllOrNothing(t *testing.T) {
+	srv := newServer()
+	// cat is valid, hal is not a member: the whole request must be refused.
+	if code, _ := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"cat":"viewer","hal":"viewer"}}`); code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	// cat is still a contributor (and so can still update own task t2).
+	code, body := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"ivy":"manager"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	if !strings.Contains(body, `{"userId":"cat","role":"contributor"}`) {
+		t.Fatalf("cat's role changed by a refused request: %s", body)
+	}
+	if code, _ := do(t, srv, "PATCH", "/projects/web/tasks/t2", "cat", `{"status":"done"}`); code != 200 {
+		t.Fatalf("cat lost write access: got %d", code)
+	}
+}
+
+func TestDemotedAssigneeIsUnassigned(t *testing.T) {
+	srv := newServer()
+	// ben is assigned to t1 in web; demoting him to viewer unassigns it.
+	if code, body := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer"}}`); code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	code, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" {
+		t.Fatalf("t1 still assigned to %q", task.Assignee)
+	}
+	// Tasks in other projects keep their assignee: ben is still assigned to t5 in legacy.
+	code, body = do(t, srv, "GET", "/projects/legacy/tasks/t5", "ann", "")
+	if code != 200 || !strings.Contains(body, `"assignee":"ben"`) {
+		t.Fatalf("t5 changed: %d %s", code, body)
+	}
+}
