+type setRolesRequest struct {
+	Roles map[string]string `json:"roles"`
+}
+
+type memberRole struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// setMemberRoles changes the roles of several project members at once.
+// Either every change applies or none does; the response lists the members
+// after the change.
+//
+// A member whose new role is not contributor or manager loses the tasks of
+// this project assigned to them: those tasks become unassigned.
+func (s *server) setMemberRoles(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role, err := findRole(ctx, s.db, project.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "only managers may change member roles")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req setRolesRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	if len(req.Roles) == 0 {
+		writeError(w, 400, "roles must not be empty")
+		return
+	}
+	userIDs := make([]string, 0, len(req.Roles))
+	for id := range req.Roles {
+		userIDs = append(userIDs, id)
+	}
+	sort.Strings(userIDs)
+
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+
+	// Validate every change before applying any of them.
+	for _, id := range userIDs {
+		newRole := req.Roles[id]
+		if newRole != RoleManager && newRole != RoleContributor && newRole != RoleViewer {
+			writeError(w, 400, "invalid role for "+id)
+			return
+		}
+		var current string
+		err := tx.QueryRowContext(ctx, `SELECT role FROM memberships WHERE project_id = ? AND user_id = ?`, project.ID, id).Scan(&current)
+		if errors.Is(err, sql.ErrNoRows) {
+			writeError(w, 400, id+" is not a member of the project")
+			return
+		}
+		if err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+	}
+
+	for _, id := range userIDs {
+		newRole := req.Roles[id]
+		if _, err := tx.ExecContext(ctx, `UPDATE memberships SET role = ? WHERE project_id = ? AND user_id = ?`, newRole, project.ID, id); err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+		if newRole != RoleManager && newRole != RoleContributor {
+			if _, err := tx.ExecContext(ctx, `UPDATE tasks SET assignee = '' WHERE project_id = ? AND assignee = ?`, project.ID, id); err != nil {
+				writeError(w, 500, "internal error")
+				return
+			}
+		}
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+
+	rows, err := s.db.QueryContext(ctx, `SELECT user_id, role FROM memberships WHERE project_id = ? ORDER BY user_id`, project.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer rows.Close()
+	members := []memberRole{}
+	for rows.Next() {
+		var m memberRole
+		if err := rows.Scan(&m.UserID, &m.Role); err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+		members = append(members, m)
+	}
+	if err := rows.Err(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, members)
+}
