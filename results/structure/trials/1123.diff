+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestMoveMember(t *testing.T) {
+	cases := []struct {
+		name, path, user, body string
+		want                   int
+	}{
+		{"manager of both", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`, 200},
+		{"viewer in destination", "/projects/web/members/ben/move", "ann", `{"toProjectId":"ops"}`, 403},
+		{"contributor source", "/projects/web/members/dan/move", "cat", `{"toProjectId":"ops"}`, 403},
+		{"org admin non-member", "/projects/web/members/ben/move", "eve", `{"toProjectId":"ops"}`, 403},
+		{"no auth", "/projects/web/members/ben/move", "", `{"toProjectId":"ops"}`, 401},
+		{"bad body", "/projects/web/members/ben/move", "ivy", `{}`, 400},
+		{"unknown destination", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"nope"}`, 404},
+		{"other org destination", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"gx"}`, 404},
+		{"archived destination", "/projects/web/members/ben/move", "ann", `{"toProjectId":"legacy"}`, 409},
+		{"archived source", "/projects/legacy/members/ben/move", "ann", `{"toProjectId":"web"}`, 409},
+		{"already member", "/projects/web/members/cat/move", "ivy", `{"toProjectId":"ops"}`, 400},
+		{"same project", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"web"}`, 400},
+		{"not a member of source", "/projects/web/members/hal/move", "ivy", `{"toProjectId":"ops"}`, 404},
+		{"unreadable source", "/projects/web/members/ben/move", "hal", `{"toProjectId":"ops"}`, 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d, want %d (%s)", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestMoveMemberEffects(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d (%s)", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]string{"userId": "ben", "projectId": "ops", "role": "contributor"}
+	for k, v := range want {
+		if got[k] != v {
+			t.Errorf("%s = %q, want %q", k, got[k], v)
+		}
+	}
+	// ben left web and joined ops.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Errorf("ben still reads web: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+		t.Errorf("ben cannot read ops: %d", code)
+	}
+	// his web task is unassigned, so the assignee rule still holds.
+	_, tb := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	if err := json.Unmarshal([]byte(tb), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "" {
+		t.Errorf("t1 assignee = %q, want unassigned", task.AssigneeID)
+	}
+	// moving again fails: no longer a member of web.
+	if code, _ := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`); code != 404 {
+		t.Errorf("second move: %d", code)
+	}
+}
