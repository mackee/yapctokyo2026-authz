+type membership struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+type rolesRequest struct {
+	Roles map[string]string `json:"roles"`
+}
+
+// setRoles changes the roles of several project members at once. It is
+// all-or-nothing: if any change is refused, nothing is written.
+// Responds with the project's full member list after the change, ordered by userId.
+func (s *server) setRoles(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role, err := findRole(ctx, s.db, project.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "only managers may change member roles")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req rolesRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || len(req.Roles) == 0 {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	userIDs := make([]string, 0, len(req.Roles))
+	for uid := range req.Roles {
+		userIDs = append(userIDs, uid)
+	}
+	sort.Strings(userIDs)
+	for _, uid := range userIDs {
+		if newRole := req.Roles[uid]; newRole != RoleManager && newRole != RoleContributor && newRole != RoleViewer {
+			writeError(w, 400, fmt.Sprintf("invalid role for %s", uid))
+			return
+		}
+	}
+
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+	for _, uid := range userIDs {
+		newRole := req.Roles[uid]
+		current, err := findRole(ctx, tx, project.ID, uid)
+		if err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+		if current == "" {
+			writeError(w, 400, fmt.Sprintf("%s is not a member of the project", uid))
+			return
+		}
+		// Assignees must stay contributors or managers, so a member with
+		// assigned tasks cannot become a viewer.
+		if newRole == RoleViewer {
+			var assigned int
+			if err := tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM tasks WHERE project_id = ? AND assignee = ?`, project.ID, uid).Scan(&assigned); err != nil {
+				writeError(w, 500, "internal error")
+				return
+			}
+			if assigned > 0 {
+				writeError(w, 409, fmt.Sprintf("%s is assigned tasks and cannot become a viewer", uid))
+				return
+			}
+		}
+	}
+	for _, uid := range userIDs {
+		if _, err := tx.ExecContext(ctx, `UPDATE memberships SET role = ? WHERE project_id = ? AND user_id = ?`, req.Roles[uid], project.ID, uid); err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+	}
+	rows, err := tx.QueryContext(ctx, `SELECT user_id, role FROM memberships WHERE project_id = ? ORDER BY user_id`, project.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer rows.Close()
+	members := []membership{}
+	for rows.Next() {
+		var m membership
+		if err := rows.Scan(&m.UserID, &m.Role); err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+		members = append(members, m)
+	}
+	if err := rows.Err(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	rows.Close()
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, members)
+}
