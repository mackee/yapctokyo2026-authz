+func TestSetRoles(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager changes roles", "ann", "web", `{"roles":{"dan":"contributor","ivy":"contributor"}}`, 200},
+		{"manager demotes unassigned", "ann", "web", `{"roles":{"ivy":"viewer"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"org admin without role", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"unknown user", "zed", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"project missing", "ann", "missing", `{"roles":{"dan":"contributor"}}`, 404},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"contributor"}}`, 409},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"bad json", "ann", "web", `nope`, 400},
+		{"invalid role", "ann", "web", `{"roles":{"dan":"owner"}}`, 400},
+		{"target not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"assigned member to viewer", "ann", "web", `{"roles":{"ben":"viewer"}}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetRolesResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann",
+		`{"roles":{"dan":"contributor","ivy":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []membership
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []membership{
+		{"ann", "manager"},
+		{"ben", "contributor"},
+		{"cat", "contributor"},
+		{"dan", "contributor"},
+		{"ivy", "contributor"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+}
+
+func TestSetRolesIsAllOrNothing(t *testing.T) {
+	srv := newServer()
+	// One refused change (hal is not a member) must leave dan's role alone.
+	if code, _ := do(t, srv, "PUT", "/projects/web/members", "ann",
+		`{"roles":{"dan":"contributor","hal":"viewer"}}`); code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	// Same for a refused demotion of an assignee (ben holds t1).
+	if code, _ := do(t, srv, "PUT", "/projects/web/members", "ann",
+		`{"roles":{"dan":"contributor","ben":"viewer"}}`); code != 409 {
+		t.Fatalf("got %d want 409", code)
+	}
+	// A no-op write returns the current list, showing nothing changed.
+	code, body := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"ann":"manager"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []membership
+	json.Unmarshal([]byte(body), &got)
+	for _, m := range got {
+		if m.UserID == "dan" && m.Role != "viewer" {
+			t.Fatalf("dan changed to %s despite refused batch", m.Role)
+		}
+	}
+}
+
+func TestSetRolesKeepsTasksValid(t *testing.T) {
+	// Demoting ben to viewer is refused while he is assigned t1; after
+	// reassigning t1 to a manager the same demotion succeeds.
+	srv := newServer()
+	if code, _ := do(t, srv, "PATCH", "/projects/web/tasks/t1", "ann", `{"assignee":"ann"}`); code != 200 {
+		t.Fatalf("reassign got %d", code)
+	}
+	if code, body := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer"}}`); code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+}
