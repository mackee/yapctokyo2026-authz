+// ManageProject may change the membership of one project.
+type ManageProject interface {
+	// RemoveMember removes userID from the project. Tasks in the project that
+	// were assigned to that user become unassigned in the same commit. A user
+	// who is not a member of the project is 404.
+	RemoveMember(userID string) error
+}
+
+type manageProject struct{ ps *projectScope }
+
+func (m *manageProject) RemoveMember(userID string) error {
+	return m.ps.as.a.st.tx(func(s *state) error {
+		if _, ok := s.members[m.ps.pid][userID]; !ok {
+			return deny(ErrNotFound, "not found")
+		}
+		delete(s.members[m.ps.pid], userID)
+		for id, t := range s.tasks {
+			if t.project == m.ps.pid && t.assignee.user == userID {
+				t.assignee = Assignee{project: m.ps.pid}
+				s.tasks[id] = t
+			}
+		}
+		return nil
+	})
+}
