+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager removes contributor", "ann", "/projects/web/members/ben", 204},
+		{"manager removes manager", "ann", "/projects/web/members/ivy", 204},
+		{"contributor", "ben", "/projects/web/members/cat", 403},
+		{"viewer", "dan", "/projects/web/members/cat", 403},
+		{"org admin is not a manager", "eve", "/projects/web/members/cat", 403},
+		{"non member", "hal", "/projects/web/members/cat", 404},
+		{"other org", "gus", "/projects/web/members/ben", 404},
+		{"anonymous", "", "/projects/web/members/cat", 401},
+		{"unknown user", "zed", "/projects/web/members/cat", 401},
+		{"target not a member", "ann", "/projects/web/members/hal", 404},
+		{"target member of another project only", "ivy", "/projects/ops/members/ben", 404},
+		{"archived", "ann", "/projects/legacy/members/ben", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveMemberEffects(t *testing.T) {
+	srv := newServer()
+
+	if code, body := do(t, srv, "DELETE", "/projects/web/members/cat", "ann", ""); code != 204 {
+		t.Fatalf("remove: got %d: %s", code, body)
+	}
+
+	// cat's assigned task in web is unassigned, not deleted.
+	code, body := do(t, srv, "GET", "/projects/web/tasks/t2", "ann", "")
+	if code != 200 {
+		t.Fatalf("get task: got %d: %s", code, body)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.Assignee != "" || task.Status != "doing" {
+		t.Fatalf("want t2 unassigned with status doing, got %+v", task)
+	}
+
+	// cat can no longer read web.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "cat", ""); code != 404 {
+		t.Fatalf("removed member read web: got %d want 404", code)
+	}
+
+	// Membership in other projects is untouched.
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks/t4", "cat", ""); code != 200 {
+		t.Fatalf("cat in ops: got %d want 200", code)
+	}
+
+	// Other assignments in web are untouched.
+	code, body = do(t, srv, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("get t1: got %d", code)
+	}
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "ben" {
+		t.Fatalf("t1 assignee changed to %q", task.Assignee)
+	}
+
+	// Removing again is 404.
+	if code, _ := do(t, srv, "DELETE", "/projects/web/members/cat", "ann", ""); code != 404 {
+		t.Fatalf("second remove: got %d want 404", code)
+	}
+}
