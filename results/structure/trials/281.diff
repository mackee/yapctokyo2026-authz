+// writable applies the write rule: readable, contributor or manager (else 403),
+// not archived (else 409).
+func writable(s *state, act Actor, pid string) (project, string, error) {
+	p, r, err := readable(s, act, pid)
+	if err != nil {
+		return project{}, "", err
+	}
+	if !isWriterRole(r) {
+		return project{}, "", deny(ErrForbidden, "forbidden")
+	}
+	if p.archived {
+		return project{}, "", deny(ErrArchived, "project is archived")
+	}
+	return p, r, nil
+}
