+func (t *manageTask) MoveTo(toProjectID string) (TaskView, error) {
+	if toProjectID == "" {
+		return TaskView{}, deny(ErrInvalid, "toProjectId is required")
+	}
+	var v TaskView
+	err := t.ts.ps.as.a.st.tx(func(s *state) error {
+		cur := s.tasks[t.ts.tid]
+		if toProjectID == cur.project {
+			return deny(ErrInvalid, "task is already in that project")
+		}
+		if _, _, err := writable(s, t.ts.ps.as.actor, toProjectID); err != nil {
+			return err
+		}
+		if u := cur.assignee.user; u != "" && !isWriterRole(s.role(toProjectID, u)) {
+			return deny(ErrInvalid, "assignee is not a contributor or manager of the destination project")
+		}
+		cur.project = toProjectID
+		cur.assignee = Assignee{project: toProjectID, user: cur.assignee.user}
+		s.tasks[cur.id] = cur
+		v = cur.view()
+		return nil
+	})
+	return v, err
+}
