+package main
+
+import (
+	"encoding/json"
+	"reflect"
+	"testing"
+)
+
+// TestFreezeDenied: only the project's managers may freeze it.
+func TestFreezeDenied(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin without membership", "eve", "ops", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"archived", "ann", "legacy", 409},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+// TestFreezeResponse: the response lists the members after the change, ordered
+// by user ID, every one of them a viewer (managers included).
+func TestFreezeResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got []map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("bad body %s: %v", body, err)
+	}
+	want := []map[string]string{
+		{"userId": "ann", "role": "viewer"},
+		{"userId": "ben", "role": "viewer"},
+		{"userId": "cat", "role": "viewer"},
+		{"userId": "dan", "role": "viewer"},
+		{"userId": "ivy", "role": "viewer"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+}
+
+// TestFreezeBlocksWrites: after a freeze nobody changes the project's tasks,
+// while reads and other projects keep working.
+func TestFreezeBlocksWrites(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze got %d body=%s", code, body)
+	}
+
+	denied := []struct {
+		name, user, method, path, body string
+	}{
+		{"former manager updates", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"former manager deletes", "ann", "DELETE", "/projects/web/tasks/t1", ""},
+		{"former manager creates", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"former manager reassigns", "ann", "PATCH", "/projects/web/tasks/t2", `{"assignee":"ben"}`},
+		{"former manager freezes again", "ann", "POST", "/projects/web/freeze", ""},
+		{"former contributor updates own task", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"former contributor creates", "cat", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"second former manager creates", "ivy", "POST", "/projects/web/tasks", `{"title":"x"}`},
+	}
+	for _, c := range denied {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, srv, c.method, c.path, c.user, c.body)
+			if code != 403 {
+				t.Fatalf("got %d want 403 body=%s", code, body)
+			}
+		})
+	}
+
+	t.Run("reads still work", func(t *testing.T) {
+		if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+			t.Fatalf("got %d want 200", code)
+		}
+	})
+	t.Run("other project unaffected", func(t *testing.T) {
+		if code, body := do(t, srv, "POST", "/projects/ops/tasks", "ivy", `{"title":"x"}`); code != 200 {
+			t.Fatalf("got %d want 200 body=%s", code, body)
+		}
+	})
+}
