+// RemoveUserFromOrg removes the user from all projects of the organization
+// (offboarding) and unassigns their tasks there. The user must belong to the
+// organization (else ErrNotFound).
+func (*MembershipTable) RemoveUserFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanManageMembers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveUser(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
