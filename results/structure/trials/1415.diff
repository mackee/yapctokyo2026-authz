+func TestSetMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager promotes", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"manager demotes unassigned", "ann", "/projects/web/members/ivy", `{"role":"viewer"}`, 200},
+		{"demote assignee", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 400},
+		{"assignee to manager", "ann", "/projects/web/members/ben", `{"role":"manager"}`, 200},
+		{"contributor", "ben", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"viewer self", "dan", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"org admin", "eve", "/projects/web/members/dan", `{"role":"viewer"}`, 403},
+		{"target not member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"manager"}`, 409},
+		{"unreadable", "hal", "/projects/web/members/dan", `{"role":"viewer"}`, 404},
+		{"other org", "gus", "/projects/web/members/dan", `{"role":"viewer"}`, 404},
+		{"anonymous", "", "/projects/web/members/dan", `{"role":"viewer"}`, 401},
+		{"invalid role", "ann", "/projects/web/members/dan", `{"role":"boss"}`, 400},
+		{"missing role", "ann", "/projects/web/members/dan", `{}`, 400},
+		{"bad body before access", "hal", "/projects/web/members/dan", `{"role":"boss"}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMemberRoleResponseAndEffect(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 2 || got["userId"] != "dan" || got["role"] != "contributor" {
+		t.Fatalf("unexpected body %s", body)
+	}
+	// dan can now write.
+	if code, body := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x","assignee":"dan"}`); code != 200 {
+		t.Fatalf("dan create got %d: %s", code, body)
+	}
+	// A rejected demotion changes nothing: ben keeps writing.
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ben update got %d want 200", code)
+	}
+}
