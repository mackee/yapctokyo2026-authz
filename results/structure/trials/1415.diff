+// SetRole changes the role of a member of the project, all or nothing. Only
+// managers may do it; the member must exist (else ErrNotFound, checked before
+// the permission, like a task of another project).
+func (mt *MembershipTable) SetRole(ctx context.Context, db DB, authz ProjectAuthz, userID, role string) (*Membership, error) {
+	if !authz.CanRead() {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if !validRoles[role] {
+		return nil, deny(ErrInvalid, "invalid role")
+	}
+	if _, err := mt.Find(ctx, db, authz.ProjectID(), userID); errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadSetRole(ctx, tx, authz.ProjectID(), userID, role)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		m, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
