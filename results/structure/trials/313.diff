+// Manage acquires the manager-only capability for the project. It applies the
+// read rule (else 404), requires the manager role (else 403), and rejects
+// archived projects (409).
+func (s *projectScope) Manage() (ManageProject, error) {
+	err := s.as.a.st.read(func(st *state) error {
+		p, r, err := readable(st, s.as.actor, s.pid)
+		if err != nil {
+			return err
+		}
+		if r != RoleManager {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if p.archived {
+			return deny(ErrArchived, "project is archived")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &manageProject{ps: s}, nil
+}
