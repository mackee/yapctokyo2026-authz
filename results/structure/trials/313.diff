+// MemberView is one project membership.
+type MemberView struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// ManageProject may change the project membership roles. Managers only.
+type ManageProject interface {
+	ReadProject
+	// SetRoles changes the roles of several existing members at once. It
+	// validates the whole batch first and applies it atomically: if any entry
+	// is invalid (unknown role, or a user who is not a member of this project)
+	// nothing changes. Assignments that would no longer be valid because an
+	// assignee lost the contributor or manager role are cleared in the same
+	// commit. It returns the members after the change, sorted by user ID.
+	SetRoles(roles map[string]string) ([]MemberView, error)
+}
+
+type manageProject struct{ ps *projectScope }
+
+func (p *manageProject) ID() string { return p.ps.pid }
+func (p *manageProject) Tasks() []TaskView {
+	var out []TaskView
+	_ = p.ps.as.a.st.read(func(s *state) error { out = s.tasksIn(p.ps.pid); return nil })
+	return out
+}
+
+func (p *manageProject) SetRoles(roles map[string]string) ([]MemberView, error) {
+	if len(roles) == 0 {
+		return nil, deny(ErrInvalid, "roles must not be empty")
+	}
+	userIDs := make([]string, 0, len(roles))
+	for uid := range roles {
+		userIDs = append(userIDs, uid)
+	}
+	sort.Strings(userIDs)
+
+	var out []MemberView
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		members := s.members[p.ps.pid]
+		for _, uid := range userIDs {
+			role := roles[uid]
+			if role != RoleManager && role != RoleContributor && role != RoleViewer {
+				return deny(ErrInvalid, fmt.Sprintf("invalid role for %s", uid))
+			}
+			if _, ok := members[uid]; !ok {
+				return deny(ErrInvalid, fmt.Sprintf("%s is not a member of this project", uid))
+			}
+		}
+		for _, uid := range userIDs {
+			members[uid] = roles[uid]
+		}
+		for id, t := range s.tasks {
+			if t.project != p.ps.pid || t.assignee.user == "" {
+				continue
+			}
+			if !isWriterRole(members[t.assignee.user]) {
+				t.assignee = Assignee{project: p.ps.pid}
+				s.tasks[id] = t
+			}
+		}
+		out = s.membersIn(p.ps.pid)
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return out, nil
+}
