+func TestSetMemberRolesIsAtomic(t *testing.T) {
+	h := newServer()
+	before := memberList(t, h, "web")
+
+	// Each batch has at least one entry that cannot be applied.
+	for _, body := range []string{
+		`{"roles":{"ben":"viewer","dan":"owner"}}`,
+		`{"roles":{"ben":"viewer","hal":"contributor"}}`,
+		`{"roles":{"ben":"viewer","gus":"viewer"}}`,
+	} {
+		if code, _ := do(t, h, "PUT", "/projects/web/members", "ann", body); code != 400 {
+			t.Fatalf("%s: got %d want 400", body, code)
+		}
+	}
+	if after := memberList(t, h, "web"); after != before {
+		t.Fatalf("membership changed by rejected batch:\nbefore %s\nafter  %s", before, after)
+	}
+}
+
+func TestSetMemberRolesClearsInvalidAssignments(t *testing.T) {
+	h := newServer()
+
+	// ben is the assignee of t1 (web) and is a contributor there.
+	if code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer"}}`); code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" {
+		t.Fatalf("t1 still assigned to %q after ben became a viewer", task.Assignee)
+	}
+
+	// Tasks in other projects are untouched: ben still holds t5 in legacy.
+	code, body = do(t, h, "GET", "/projects/legacy/tasks/t5", "ann", "")
+	if code != 200 || !strings.Contains(body, `"assignee":"ben"`) {
+		t.Fatalf("legacy task changed: %d %s", code, body)
+	}
+}
