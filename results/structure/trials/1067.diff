+func TestFreeze(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager", "ann", "/projects/web/freeze", 200},
+		{"contributor", "ben", "/projects/web/freeze", 403},
+		{"viewer", "dan", "/projects/web/freeze", 403},
+		{"org admin", "eve", "/projects/web/freeze", 403},
+		{"non member", "hal", "/projects/web/freeze", 404},
+		{"other org", "gus", "/projects/web/freeze", 404},
+		{"anonymous", "", "/projects/web/freeze", 401},
+		{"archived", "ann", "/projects/legacy/freeze", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got []map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []map[string]string{
+		{"userId": "ann", "role": "viewer"},
+		{"userId": "ben", "role": "viewer"},
+		{"userId": "cat", "role": "viewer"},
+		{"userId": "dan", "role": "viewer"},
+		{"userId": "ivy", "role": "viewer"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %d members, want %d: %s", len(got), len(want), body)
+	}
+	for i := range want {
+		if got[i]["userId"] != want[i]["userId"] || got[i]["role"] != want[i]["role"] || len(got[i]) != 2 {
+			t.Fatalf("member %d: got %v want %v", i, got[i], want[i])
+		}
+	}
+}
+
+func TestFreezeBlocksTaskWrites(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze got %d body=%s", code, body)
+	}
+	cases := []struct {
+		name, user, method, path, body string
+	}{
+		{"manager creates", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"manager updates", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"manager deletes", "ann", "DELETE", "/projects/web/tasks/t1", ""},
+		{"former contributor creates", "ben", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"former contributor updates own", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"former manager ivy updates", "ivy", "PATCH", "/projects/web/tasks/t3", `{"title":"y"}`},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, srv, c.method, c.path, c.user, c.body)
+			if code != 403 {
+				t.Fatalf("got %d want 403 body=%s", code, body)
+			}
+		})
+	}
+	// Reads still work.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ann", ""); code != 200 {
+		t.Fatalf("read after freeze got %d", code)
+	}
+}
