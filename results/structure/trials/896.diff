+// ---- operations -----------------------------------------------------------------------
+
+// Remove removes the user from the project. The actor must be a manager of the
+// project (else ErrForbidden) and the project must not be archived (else
+// ErrArchived). The user must be a member (else ErrNotFound). The user's tasks
+// in the project are unassigned.
+func (*MembershipTable) Remove(ctx context.Context, db DB, authz ProjectAuthz, userID string) error {
+	if err := authz.CanManageMembers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveMember(ctx, tx, authz.ProjectID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
