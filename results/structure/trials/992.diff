+func TestTransfer(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"anonymous", "", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown user", "zed", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 401},
+		{"caller in other org", "gus", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 404},
+		{"path org not caller's", "eve", "/orgs/globex/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"non admin manager", "ann", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 403},
+		{"non admin contributor", "ben", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 403},
+		{"missing body", "eve", "/orgs/acme/users/hal/transfer", ``, 400},
+		{"empty toOrgId", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":""}`, 400},
+		{"same org", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"acme"}`, 400},
+		{"target not found", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"initech"}`, 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestTransferResponseAndAccess(t *testing.T) {
+	srv := newServer()
+	code, body := do(t, srv, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["id"] != "ben" || got["orgId"] != "globex" {
+		t.Fatalf("unexpected response %s", body)
+	}
+	// ben lost access to acme projects he was a member of.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("transferred user still reads old org project: %d", code)
+	}
+}
+
+func TestTransferClearsOrgAdmin(t *testing.T) {
+	srv := newServer()
+	// eve moves herself to globex; she was an acme org admin.
+	if code, body := do(t, srv, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	// As a globex user she must not keep admin rights there.
+	if code, _ := do(t, srv, "POST", "/orgs/globex/users/gus/transfer", "eve", `{"toOrgId":"acme"}`); code != 403 {
+		t.Fatalf("former org admin kept admin rights: got %d", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/gx/tasks", "eve", ""); code != 404 {
+		t.Fatalf("former org admin reads globex project: %d", code)
+	}
+}
