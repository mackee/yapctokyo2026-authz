+// changeRolesAggregate changes the roles of several members of one project.
+type changeRolesAggregate struct {
+	members []*Membership // the members to change, in user ID order
+	roles   map[string]string
+	// blocked is the set of members who still have tasks assigned to them.
+	blocked map[string]bool
+}
+
+func loadChangeRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*changeRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &changeRolesAggregate{roles: roles, blocked: map[string]bool{}}
+	ids := make([]string, 0, len(roles))
+	for id := range roles {
+		ids = append(ids, id)
+	}
+	sort.Strings(ids)
+	for _, id := range ids {
+		m, err := p.Membership(ctx, tx, id)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "not a member of the project: "+id)
+		} else if err != nil {
+			return nil, err
+		}
+		a.members = append(a.members, m)
+		if !isWriterRole(roles[id]) {
+			tasks, err := m.AssignedTasks(ctx, tx)
+			if err != nil {
+				return nil, err
+			}
+			a.blocked[id] = len(tasks) > 0
+		}
+	}
+	return a, nil
+}
+
+func (a *changeRolesAggregate) validate() error {
+	for _, m := range a.members {
+		role := a.roles[m.UserID]
+		if role != RoleManager && role != RoleContributor && role != RoleViewer {
+			return deny(ErrInvalid, "invalid role for "+m.UserID)
+		}
+		if a.blocked[m.UserID] {
+			return deny(ErrInvalid, m.UserID+" still has assigned tasks; reassign them first")
+		}
+	}
+	return nil
+}
+
+func (a *changeRolesAggregate) apply(ctx context.Context, tx DB) error {
+	for _, m := range a.members {
+		if m.Role == a.roles[m.UserID] {
+			continue
+		}
+		if err := m.setRole(ctx, tx, a.roles[m.UserID]); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
