diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..3c346cb
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,92 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"testing"
+)
+
+func roleMap(t *testing.T, body string) map[string]string {
+	t.Helper()
+	var ms []struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &ms); err != nil {
+		t.Fatalf("bad body %q: %v", body, err)
+	}
+	out := map[string]string{}
+	for _, m := range ms {
+		out[m.UserID] = m.Role
+	}
+	return out
+}
+
+func TestChangeRolesAllowed(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","cat":"manager","ivy":"viewer"}}`)
+	if code != http.StatusOK {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	got := roleMap(t, body)
+	want := map[string]string{"ann": "manager", "ben": "contributor", "cat": "manager", "dan": "contributor", "ivy": "viewer"}
+	if len(got) != len(want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	for k, v := range want {
+		if got[k] != v {
+			t.Fatalf("got %v want %v", got, want)
+		}
+	}
+	// A manager may demote (even themselves) and the change persists.
+	code, body = do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ann":"viewer"}}`)
+	if code != http.StatusOK || roleMap(t, body)["ann"] != "viewer" {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+}
+
+func TestChangeRolesDenied(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"contributor", "ben", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin", "eve", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 403},
+		{"manager of other project", "ann", "/projects/ops/members", `{"roles":{"cat":"viewer"}}`, 403},
+		{"archived", "ann", "/projects/legacy/members", `{"roles":{"ben":"manager"}}`, 409},
+		{"other org", "ann", "/projects/gx/members", `{"roles":{"gus":"viewer"}}`, 404},
+		{"unknown user", "nobody", "/projects/web/members", `{"roles":{"dan":"viewer"}}`, 401},
+		{"non-member", "ann", "/projects/web/members", `{"roles":{"hal":"viewer"}}`, 400},
+		{"invalid role", "ann", "/projects/web/members", `{"roles":{"dan":"boss"}}`, 400},
+		{"empty roles", "ann", "/projects/web/members", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "/projects/web/members", `{}`, 400},
+		{"member with tasks to viewer", "ann", "/projects/web/members", `{"roles":{"ben":"viewer"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+// One bad entry rejects the whole request and nothing changes.
+func TestChangeRolesAllOrNothing(t *testing.T) {
+	for _, body := range []string{
+		`{"roles":{"dan":"contributor","hal":"viewer"}}`, // hal is not a member
+		`{"roles":{"dan":"contributor","cat":"boss"}}`,   // invalid role
+		`{"roles":{"dan":"contributor","ben":"viewer"}}`, // ben still has a task
+	} {
+		h := newServer()
+		if code, b := do(t, h, "PUT", "/projects/web/members", "ann", body); code != http.StatusBadRequest {
+			t.Fatalf("%s: got %d body=%s", body, code, b)
+		}
+		// dan is still a viewer: promoting nothing happened, so he still cannot create tasks.
+		if code, b := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != http.StatusForbidden {
+			t.Fatalf("%s: dan changed anyway: %d %s", body, code, b)
+		}
+	}
+}
