@@ -0,0 +1,57 @@
+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestMemberRoleDenied(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"unauthenticated", "", "/projects/web/members/ben", `{"role":"viewer"}`, 401},
+		{"unknown user", "zed", "/projects/web/members/ben", `{"role":"viewer"}`, 401},
+		{"contributor", "ben", "/projects/web/members/cat", `{"role":"viewer"}`, 403},
+		{"viewer", "dan", "/projects/web/members/ben", `{"role":"manager"}`, 403},
+		{"contributor self-promote", "ben", "/projects/web/members/ben", `{"role":"manager"}`, 403},
+		{"org admin without role", "eve", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"manager of another project", "ann", "/projects/ops/members/cat", `{"role":"viewer"}`, 403},
+		{"non member", "hal", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"other org", "gus", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"missing project", "ann", "/projects/nope/members/ben", `{"role":"viewer"}`, 404},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"archived project", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"invalid role", "ann", "/projects/web/members/ben", `{"role":"admin"}`, 400},
+		{"missing role", "ann", "/projects/web/members/ben", `{}`, 400},
+		{"bad json", "ann", "/projects/web/members/ben", `nope`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestMemberRoleEffect(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`)
+	if code != 200 || strings.TrimSpace(body) != `{"role":"viewer","userId":"ben"}` {
+		t.Fatalf("got %d %s", code, body)
+	}
+	// ben is now a viewer: can still read, can no longer write.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("read after demotion: %d", code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 403 {
+		t.Fatalf("write after demotion: %d", code)
+	}
+	// dan promoted to manager can now change roles.
+	do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"manager"}`)
+	if code, _ := do(t, h, "PUT", "/projects/web/members/cat", "dan", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("promoted manager change: %d", code)
+	}
+}
