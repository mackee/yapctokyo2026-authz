+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes user with no memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"manager", "ann", "/orgs/acme/users/ben", 403},
+		{"contributor", "ben", "/orgs/acme/users/cat", 403},
+		{"viewer", "dan", "/orgs/acme/users/ben", 403},
+		{"other org admin", "gus", "/orgs/acme/users/ben", 404},
+		{"other org path", "eve", "/orgs/globex/users/gus", 404},
+		{"user in another org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed", 404},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func findTask(t *testing.T, body, id string) Task {
+	t.Helper()
+	var tasks []Task
+	if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+		t.Fatal(err)
+	}
+	for _, task := range tasks {
+		if task.ID == id {
+			return task
+		}
+	}
+	t.Fatalf("task %s not in %s", id, body)
+	return Task{}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("got %d want 204", code)
+	}
+
+	// ben is out of every project of acme, the archived one included.
+	for _, path := range []string{"/projects/web/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, srv, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("GET %s as ben: got %d want 404", path, code)
+		}
+	}
+
+	// Tasks ben was assigned in those projects are unassigned; others are kept.
+	_, web := do(t, srv, "GET", "/projects/web/tasks", "ann", "")
+	if a := findTask(t, web, "t1").AssigneeID; a != "" {
+		t.Fatalf("t1 assignee: got %q want unassigned", a)
+	}
+	if a := findTask(t, web, "t2").AssigneeID; a != "cat" {
+		t.Fatalf("t2 assignee: got %q want cat", a)
+	}
+	_, legacy := do(t, srv, "GET", "/projects/legacy/tasks", "ann", "")
+	if a := findTask(t, legacy, "t5").AssigneeID; a != "" {
+		t.Fatalf("t5 assignee: got %q want unassigned", a)
+	}
+
+	// Memberships of other users are untouched.
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "cat", `{"title":"x"}`); code != 200 {
+		t.Fatalf("cat create in web: got %d want 200", code)
+	}
+
+	// Another organization is untouched.
+	if code, _ := do(t, srv, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatalf("gus read gx: got %d want 200", code)
+	}
+
+	// Removing again is a no-op that still answers 204.
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("second remove: got %d want 204", code)
+	}
+}
