+
+// removeUserFromOrgAggregate removes one user from every project of an
+// organization.
+type removeUserFromOrgAggregate struct {
+	user        *User
+	memberships []*Membership // the user's memberships in the organization's projects
+	tasks       []*Task       // tasks assigned to the user in those projects
+}
+
+func loadRemoveUserFromOrg(ctx context.Context, tx DB, org, userID string) (*removeUserFromOrgAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != org {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	a := &removeUserFromOrgAggregate{user: u}
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, m := range ms {
+		p, err := m.Project(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		if p.Org != org {
+			continue
+		}
+		tasks, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.memberships = append(a.memberships, m)
+		a.tasks = append(a.tasks, tasks...)
+	}
+	return a, nil
+}
+
+func (a *removeUserFromOrgAggregate) validate() error { return nil }
+
+func (a *removeUserFromOrgAggregate) apply(ctx context.Context, tx DB) error {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return err
+		}
+	}
+	return nil
+}
