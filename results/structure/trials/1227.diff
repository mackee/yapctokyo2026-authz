+// ---- operations -----------------------------------------------------------------------
+
+// RemoveFromOrg removes the user from every project of the organization (for
+// offboarding): the user's memberships there are deleted, and the tasks
+// assigned to the user in those projects are unassigned, so the assignee rule
+// still holds. Archived projects are included, so archiving does not block
+// offboarding. The user must belong to the organization (else ErrNotFound).
+// Repeating the call is a no-op.
+func (*UserTable) RemoveFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanRemoveUsers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveUserFromOrg(ctx, tx, authz.Org(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
