+func TestBulkRoles(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"unauthenticated", "", "/projects/web/members", `{"roles":{"ben":"viewer"}}`, 401},
+		{"manager ok", "ann", "/projects/web/members", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 200},
+		{"promote", "ivy", "/projects/web/members", `{"roles":{"ben":"manager"}}`, 200},
+		{"contributor", "ben", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 403},
+		{"viewer", "dan", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin non member", "eve", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 403},
+		{"non member", "hal", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 404},
+		{"other org", "gus", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 404},
+		{"manager of other project", "ann", "/projects/ops/members", `{"roles":{"cat":"viewer"}}`, 403},
+		{"archived", "ann", "/projects/legacy/members", `{"roles":{"ben":"viewer"}}`, 409},
+		{"invalid role", "ann", "/projects/web/members", `{"roles":{"ben":"boss"}}`, 400},
+		{"non member target", "ann", "/projects/web/members", `{"roles":{"hal":"viewer"}}`, 400},
+		{"empty", "ann", "/projects/web/members", `{"roles":{}}`, 400},
+		{"bad json", "ann", "/projects/web/members", `nope`, 400},
+		{"last manager", "ivy", "/projects/ops/members", `{"roles":{"ivy":"viewer"}}`, 400},
+		{"viewer of other project", "ann", "/projects/ops/members", `{"roles":{"ivy":"viewer"}}`, 403},
+		{"no manager left", "ann", "/projects/web/members", `{"roles":{"ann":"viewer","ivy":"viewer"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+
+	t.Run("response", func(t *testing.T) {
+		code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+		if code != 200 {
+			t.Fatalf("got %d", code)
+		}
+		var got []map[string]string
+		if err := json.Unmarshal([]byte(body), &got); err != nil {
+			t.Fatal(err)
+		}
+		want := map[string]string{"ann": "manager", "ben": "viewer", "cat": "contributor", "dan": "contributor", "ivy": "manager"}
+		if len(got) != len(want) {
+			t.Fatalf("got %v", got)
+		}
+		for _, m := range got {
+			if want[m["userId"]] != m["role"] {
+				t.Fatalf("got %v", got)
+			}
+		}
+	})
+
+	t.Run("atomic", func(t *testing.T) {
+		h := newServer()
+		if code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","hal":"viewer"}}`); code != 400 {
+			t.Fatalf("got %d", code)
+		}
+		// ben must still be a contributor: he can modify his own task.
+		if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 200 {
+			t.Fatalf("ben lost his role: %d", code)
+		}
+	})
+}
