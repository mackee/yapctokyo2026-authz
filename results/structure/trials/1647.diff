@@ -0,0 +1,142 @@
+package main
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"net/http"
+)
+
+// POST /projects/{pid}/members/{uid}/move {"toProjectId": "..."}
+//
+// Removes the user from the path project and adds them to the destination
+// project with the same role. Access rules are described in main.go and
+// README.md; the caller must be a manager of both projects.
+
+type moveRequest struct {
+	ToProjectID string `json:"toProjectId"`
+}
+
+type moveResponse struct {
+	UserID    string `json:"userId"`
+	ProjectID string `json:"projectId"`
+	Role      string `json:"role"`
+}
+
+func (s *server) moveMember(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	caller, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if caller == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	src, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if src == nil || src.OrgID != caller.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	callerRole, err := findRole(ctx, s.db, src.ID, caller.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if callerRole == "" && !caller.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if callerRole != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if src.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	targetID := r.PathValue("uid")
+	targetRole, err := findRole(ctx, s.db, src.ID, targetID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if targetRole == "" {
+		writeError(w, 404, "not found")
+		return
+	}
+
+	var req moveRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || req.ToProjectID == "" {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	if req.ToProjectID == src.ID {
+		writeError(w, 400, "destination must differ from the source project")
+		return
+	}
+
+	dst, err := findProject(ctx, s.db, req.ToProjectID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if dst == nil || dst.OrgID != caller.OrgID {
+		writeError(w, 404, "destination not found")
+		return
+	}
+	dstCallerRole, err := findRole(ctx, s.db, dst.ID, caller.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if dstCallerRole == "" && !caller.OrgAdmin {
+		writeError(w, 404, "destination not found")
+		return
+	}
+	if dstCallerRole != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if dst.Archived {
+		writeError(w, 409, "destination project is archived")
+		return
+	}
+	existing, err := findRole(ctx, s.db, dst.ID, targetID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if existing != "" {
+		writeError(w, 409, "user is already a member of the destination project")
+		return
+	}
+
+	if err := moveMembership(ctx, s.db, src.ID, dst.ID, targetID, targetRole); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, moveResponse{UserID: targetID, ProjectID: dst.ID, Role: targetRole})
+}
+
+// moveMembership removes the source membership and adds the destination one
+// in a single transaction.
+func moveMembership(ctx context.Context, db *sql.DB, srcID, dstID, userID, role string) error {
+	tx, err := db.BeginTx(ctx, nil)
+	if err != nil {
+		return err
+	}
+	defer tx.Rollback()
+	if _, err := tx.ExecContext(ctx, `DELETE FROM memberships WHERE project_id = ? AND user_id = ?`, srcID, userID); err != nil {
+		return err
+	}
+	if _, err := tx.ExecContext(ctx, `INSERT INTO memberships (project_id, user_id, role) VALUES (?, ?, ?)`, dstID, userID, role); err != nil {
+		return err
+	}
+	return tx.Commit()
+}
diff --git a/move_test.go b/move_test.go
