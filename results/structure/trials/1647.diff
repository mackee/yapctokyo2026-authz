index 0000000..eb5392b
--- /dev/null
+++ b/move_test.go
@@ -0,0 +1,100 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+// Moving a member: POST /projects/{pid}/members/{uid}/move {"toProjectId":...}
+// removes the user from {pid} and adds them to the destination with the same role.
+//
+// Rules (chosen to match the existing access rules):
+//   - unknown or missing caller                                   -> 401
+//   - source project missing / other org / not readable by caller -> 404
+//   - target user is not a member of the source project           -> 404
+//   - destination missing / other org / not readable by caller    -> 404
+//   - caller is not a manager of the source project               -> 403
+//   - caller is not a manager of the destination project          -> 403
+//   - source or destination archived                              -> 409
+//   - target user is already a member of the destination          -> 409
+//   - malformed body, empty toProjectId, or toProjectId == {pid}  -> 400
+
+func TestMoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager of both moves contributor", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 200},
+		{"manager moves viewer", "ivy", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 200},
+		{"contributor cannot move", "ben", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer cannot move", "dan", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin cannot move", "eve", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"non member caller", "hal", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"other org caller", "gus", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 401},
+		{"unknown user", "zed", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 401},
+		{"source project missing", "ann", "/projects/nope/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"target not a member of source", "ann", "/projects/web/members/hal/move", `{"toProjectId":"ops"}`, 404},
+		{"destination missing", "ann", "/projects/web/members/ben/move", `{"toProjectId":"nope"}`, 404},
+		{"destination in other org", "ann", "/projects/web/members/ben/move", `{"toProjectId":"gx"}`, 404},
+		{"destination archived", "ann", "/projects/web/members/ben/move", `{"toProjectId":"legacy"}`, 409},
+		{"source archived", "ann", "/projects/legacy/members/ben/move", `{"toProjectId":"ops"}`, 409},
+		{"caller not manager of destination", "ann", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 403},
+		{"target already in destination", "ivy", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 409},
+		{"empty destination", "ann", "/projects/web/members/ben/move", `{"toProjectId":""}`, 400},
+		{"missing destination", "ann", "/projects/web/members/ben/move", `{}`, 400},
+		{"same project", "ann", "/projects/web/members/ben/move", `{"toProjectId":"web"}`, 400},
+		{"invalid json", "ann", "/projects/web/members/ben/move", `not json`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveMemberResponseAndEffects(t *testing.T) {
+	srv := newServer()
+
+	code, body := do(t, srv, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got struct {
+		UserID    string `json:"userId"`
+		ProjectID string `json:"projectId"`
+		Role      string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("bad response %q: %v", body, err)
+	}
+	if got.UserID != "ben" || got.ProjectID != "ops" || got.Role != "contributor" {
+		t.Fatalf("got %+v, want {ben ops contributor}", got)
+	}
+
+	// ben is no longer a member of web ...
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben still reads web: got %d want 404", code)
+	}
+	// ... and is now a contributor of ops.
+	if code, _ := do(t, srv, "POST", "/projects/ops/tasks", "ben", `{"title":"x","assignee":"ben"}`); code != 200 {
+		t.Fatalf("ben cannot write ops after move: got %d want 200", code)
+	}
+}
+
+func TestMoveMemberKeepsViewerRole(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/members/dan/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got struct {
+		Role string `json:"role"`
+	}
+	json.Unmarshal([]byte(body), &got)
+	if got.Role != "viewer" {
+		t.Fatalf("role %q, want viewer", got.Role)
+	}
+}
