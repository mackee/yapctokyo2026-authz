+
+// freezeProjectAggregate freezes one project.
+type freezeProjectAggregate struct {
+	members  []*Membership
+	assigned []*Task // the project's tasks that have an assignee
+}
+
+func loadFreezeProject(ctx context.Context, tx DB, projectID string) (*freezeProjectAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	members, err := p.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	tasks, err := p.Tasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	a := &freezeProjectAggregate{members: members}
+	for _, t := range tasks {
+		if t.AssigneeID != "" {
+			a.assigned = append(a.assigned, t)
+		}
+	}
+	return a, nil
+}
+
+func (a *freezeProjectAggregate) validate() error { return nil }
+
+// apply makes every member a viewer and unassigns the tasks. Once no member is a
+// contributor or manager, no task may keep an assignee (model rule).
+func (a *freezeProjectAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for _, m := range a.members {
+		if err := m.changeRole(ctx, tx, RoleViewer); err != nil {
+			return nil, err
+		}
+	}
+	for _, t := range a.assigned {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	return a.members, nil
+}
