+// ---- operations -----------------------------------------------------------------------
+
+// Freeze freezes the project: every member becomes a viewer, so nobody can
+// change its tasks any more. Tasks lose their assignees, because an assignee
+// must be a contributor or manager. It returns the members after the change,
+// ordered by user ID. Managers only.
+func (*ProjectTable) Freeze(ctx context.Context, db DB, authz ProjectAuthz) ([]*Membership, error) {
+	if err := authz.CanFreeze(); err != nil {
+		return nil, err
+	}
+	var members []*Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadFreezeProject(ctx, tx, authz.ProjectID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		members, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return members, nil
+}
