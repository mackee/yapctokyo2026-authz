+// moveMemberAggregate moves one member from the source project to the
+// destination project.
+type moveMemberAggregate struct {
+	from     *Membership // the member's row in the source project
+	to       *Membership // the member's new row in the destination project (unsaved)
+	assigned []*Task     // the member's tasks in the source project
+}
+
+func loadMoveMember(ctx context.Context, tx DB, fromProjectID, userID, toProjectID string) (*moveMemberAggregate, error) {
+	from, err := NewMembershipTable().Find(ctx, tx, fromProjectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "user is not a member of this project")
+	} else if err != nil {
+		return nil, err
+	}
+	_, err = NewMembershipTable().Find(ctx, tx, toProjectID, userID)
+	if err == nil {
+		return nil, deny(ErrInvalid, "user is already a member of the destination project")
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	assigned, err := from.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &moveMemberAggregate{
+		from:     from,
+		to:       &Membership{ProjectID: toProjectID, UserID: userID, Role: from.Role},
+		assigned: assigned,
+	}, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	switch a.to.Role {
+	case RoleManager, RoleContributor, RoleViewer:
+		return nil
+	}
+	return deny(ErrInvalid, "invalid role")
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	// Tasks cannot stay assigned to someone who is no longer a member of their
+	// project, so they are unassigned; the tasks themselves are kept.
+	for _, t := range a.assigned {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.from.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	if err := a.to.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a.to, nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
