+++ b/internal/model/membership_table.go
@@ -2,12 +2,60 @@ package model
 
 import "context"
 
-// MembershipTable reads the memberships table.
+// MembershipTable is the memberships table.
+//
+// Find and List* read rows. Move is the API operation: it takes the database,
+// the authorization object of the source project and an input, asks the
+// authorization objects whether the actor may move members, then runs the
+// operation's aggregate (aggregate.go) in a transaction.
 type MembershipTable struct{}
 
 // NewMembershipTable returns the memberships table.
 func NewMembershipTable() *MembershipTable { return &MembershipTable{} }
 
+// MembershipTableMoveInput is the input of MembershipTable.Move.
+type MembershipTableMoveInput struct {
+	UserID      string
+	ToProjectID string
+}
+
+// Move moves a member from the authorized project to another project, keeping
+// the role. The member leaves the source project; any tasks the member had
+// there become unassigned. The actor must be a manager of both projects, and
+// neither may be archived. It returns the membership in the destination.
+func (mt *MembershipTable) Move(ctx context.Context, db DB, authz ProjectAuthz, in MembershipTableMoveInput) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	dest, err := NewProjectAuthz(ctx, db, authz.Actor(), in.ToProjectID)
+	if err != nil {
+		return nil, err
+	}
+	if err := dest.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if in.ToProjectID == authz.ProjectID() {
+		return nil, deny(ErrInvalid, "destination must be a different project")
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveMember(ctx, tx, authz.ProjectID(), in.UserID, in.ToProjectID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if m, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
+
 // Find returns the membership of the user in the project, or ErrNoRows.
 func (*MembershipTable) Find(ctx context.Context, db DB, projectID, userID string) (*Membership, error) {
 	var m Membership
