+func TestTransfer(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin moves member", "eve", "/orgs/acme/users/dan/transfer", `{"toOrgId":"globex"}`, 200},
+		{"project manager is not org admin", "ann", "/orgs/acme/users/dan/transfer", `{"toOrgId":"globex"}`, 403},
+		{"anonymous", "", "/orgs/acme/users/dan/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown user", "zed", "/orgs/acme/users/dan/transfer", `{"toOrgId":"globex"}`, 401},
+		{"other org admin", "gus", "/orgs/acme/users/dan/transfer", `{"toOrgId":"globex"}`, 404},
+		{"user not in path org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"unknown user id", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"unknown target org", "eve", "/orgs/acme/users/dan/transfer", `{"toOrgId":"initech"}`, 400},
+		{"same org", "eve", "/orgs/acme/users/dan/transfer", `{"toOrgId":"acme"}`, 400},
+		{"missing target", "eve", "/orgs/acme/users/dan/transfer", `{}`, 400},
+		{"bad body", "eve", "/orgs/acme/users/dan/transfer", `not json`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/dan/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got struct {
+		ID    string `json:"id"`
+		OrgID string `json:"orgId"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.ID != "dan" || got.OrgID != "globex" {
+		t.Fatalf("got %+v", got)
+	}
+}
+
+func TestTransferDetachesFromOldOrg(t *testing.T) {
+	srv := newServer()
+	// ben is a contributor on web and legacy, and is assigned t1 (web) and t5 (legacy).
+	if code, body := do(t, srv, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: got %d: %s", code, body)
+	}
+
+	// ben's task in web is released, not deleted.
+	code, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("get t1: got %d: %s", code, body)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.Assignee != "" {
+		t.Fatalf("t1 still assigned to %q", task.Assignee)
+	}
+
+	// ben has lost access to the old org's projects and cannot write there.
+	for _, c := range []struct {
+		method, path, body string
+	}{
+		{"GET", "/projects/web/tasks", ""},
+		{"POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"GET", "/projects/legacy/tasks", ""},
+		{"PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+	} {
+		if code, _ := do(t, srv, c.method, c.path, "ben", c.body); code != 404 {
+			t.Fatalf("%s %s as ben: got %d want 404", c.method, c.path, code)
+		}
+	}
+}
+
+func TestTransferClearsOrgAdmin(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: got %d: %s", code, body)
+	}
+	// eve is now a globex user without org-admin rights, so she cannot move globex users.
+	if code, _ := do(t, srv, "POST", "/orgs/globex/users/gus/transfer", "eve", `{"toOrgId":"acme"}`); code != 403 {
+		t.Fatalf("got %d want 403", code)
+	}
+	// and she no longer sees acme projects.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "eve", ""); code != 404 {
+		t.Fatalf("got %d want 404", code)
+	}
+}
