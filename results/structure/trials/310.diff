+// ---- user transfer capability --------------------------------------------------
+
+// UserView is the public representation of a user.
+type UserView struct {
+	ID    string `json:"id"`
+	OrgID string `json:"orgId"`
+}
+
+// TransferUser may move one user out of the organization it belongs to.
+type TransferUser interface {
+	// MoveTo moves the user to toOrgID. The user loses org-admin rights, is
+	// removed from every project of the old organization, and is unassigned from
+	// tasks in those projects, so the model invariants keep holding.
+	MoveTo(toOrgID string) (UserView, error)
+}
+
+// Transfer applies the transfer rule: the actor must belong to this
+// organization (else 404), the user must belong to it (else 404), and the actor
+// must be an org admin (else 403).
+func (s *userScope) Transfer() (TransferUser, error) {
+	err := s.os.as.a.st.read(func(st *state) error {
+		act := s.os.as.actor
+		if act.org != s.os.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		u, ok := st.users[s.uid]
+		if !ok || u.org != s.os.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		if !act.orgAdmin {
+			return deny(ErrForbidden, "forbidden")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &transferUser{us: s}, nil
+}
+
+type transferUser struct{ us *userScope }
+
+func (t *transferUser) MoveTo(toOrgID string) (UserView, error) {
+	if toOrgID == "" {
+		return UserView{}, deny(ErrInvalid, "toOrgId is required")
+	}
+	var v UserView
+	err := t.us.os.as.a.st.tx(func(s *state) error {
+		u, ok := s.users[t.us.uid]
+		if !ok {
+			return deny(ErrNotFound, "not found")
+		}
+		fromOrg := u.org
+		if toOrgID == fromOrg {
+			return deny(ErrInvalid, "user already belongs to that organization")
+		}
+		if !s.orgExists(toOrgID) {
+			return deny(ErrInvalid, "unknown organization")
+		}
+
+		// Leave the old organization's projects and release the user's tasks there.
+		for pid, p := range s.projects {
+			if p.org == fromOrg {
+				delete(s.members[pid], u.id)
+			}
+		}
+		for id, tk := range s.tasks {
+			if tk.assignee.user == u.id && s.projects[tk.project].org == fromOrg {
+				tk.assignee = Assignee{project: tk.project}
+				s.tasks[id] = tk
+			}
+		}
+
+		u.org = toOrgID
+		u.orgAdmin = false
+		s.users[u.id] = u
+		v = UserView{ID: u.id, OrgID: u.org}
+		return nil
+	})
+	return v, err
+}
