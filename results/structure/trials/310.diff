+// orgExists reports whether any user or project belongs to the organization.
+// Organizations have no table of their own; they exist through their members.
+func (s *state) orgExists(orgID string) bool {
+	for _, u := range s.users {
+		if u.org == orgID {
+			return true
+		}
+	}
+	for _, p := range s.projects {
+		if p.org == orgID {
+			return true
+		}
+	}
+	return false
+}
