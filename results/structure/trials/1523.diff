+func TestMoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+		userID, role           string // checked on 200; the target is ops
+	}{
+		{"manager of both moves member", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 200, "ben", "contributor"},
+		{"role is kept", "ivy", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 200, "dan", "viewer"},
+		{"manager of source only", "ann", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403, "", ""},
+		{"contributor", "ben", "/projects/web/members/dan/move", `{"toProjectId":"legacy"}`, 403, "", ""},
+		{"viewer", "ann", "/projects/ops/members/cat/move", `{"toProjectId":"legacy"}`, 403, "", ""},
+		{"org admin", "eve", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403, "", ""},
+		{"non member of source", "hal", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404, "", ""},
+		{"other org", "gus", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404, "", ""},
+		{"anonymous", "", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 401, "", ""},
+		{"unknown user", "zed", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 401, "", ""},
+		{"user not in source", "ivy", "/projects/web/members/hal/move", `{"toProjectId":"ops"}`, 404, "", ""},
+		{"target missing", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"nope"}`, 404, "", ""},
+		{"target in other org", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"gx"}`, 404, "", ""},
+		{"target not readable", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"legacy"}`, 404, "", ""},
+		{"target archived", "ann", "/projects/web/members/dan/move", `{"toProjectId":"legacy"}`, 409, "", ""},
+		{"source archived", "ann", "/projects/legacy/members/ben/move", `{"toProjectId":"web"}`, 409, "", ""},
+		{"already in target", "ivy", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 400, "", ""},
+		{"same project", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"web"}`, 400, "", ""},
+		{"missing target", "ivy", "/projects/web/members/ben/move", `{}`, 400, "", ""},
+		{"bad json", "ivy", "/projects/web/members/ben/move", `{"toProjectId":`, 400, "", ""},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d (%s)", code, c.want, body)
+			}
+			if c.want != 200 {
+				return
+			}
+			var got moveMemberResponse
+			if err := json.Unmarshal([]byte(body), &got); err != nil {
+				t.Fatal(err)
+			}
+			if want := (moveMemberResponse{UserID: c.userID, ProjectID: "ops", Role: c.role}); got != want {
+				t.Fatalf("got %+v want %+v", got, want)
+			}
+		})
+	}
+}
+
+func TestMoveMemberEffects(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`); code != 200 {
+		t.Fatal(code, body)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben still reads web: got %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben cannot read ops: got %d", code)
+	}
+	// ben's task in web is unassigned; the other web tasks are untouched.
+	_, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "" {
+		t.Fatalf("t1 still assigned to %q", task.AssigneeID)
+	}
+	_, body = do(t, h, "GET", "/projects/web/tasks/t2", "ann", "")
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "cat" {
+		t.Fatalf("t2 assignee changed to %q", task.AssigneeID)
+	}
+}
