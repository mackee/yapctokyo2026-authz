+func TestRemoveUserFromOrg(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes user without memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"org admin removes manager", "eve", "/orgs/acme/users/ann", 204},
+		{"project manager", "ann", "/orgs/acme/users/ben", 403},
+		{"viewer", "dan", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"other org caller", "gus", "/orgs/acme/users/ben", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ben", 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed", 404},
+		{"user of other org", "eve", "/orgs/acme/users/gus", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveUserFromOrgEffects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("got %d want 204", code)
+	}
+	// ben was a member of web and legacy: he can no longer read either.
+	for _, p := range []string{"/projects/web/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, h, "GET", p, "ben", ""); code != 404 {
+			t.Fatalf("%s: ben got %d want 404", p, code)
+		}
+	}
+	// Tasks that were assigned to ben (t1 in web, t5 in archived legacy) are
+	// unassigned, so no task is left assigned to a non-member.
+	for _, p := range []string{"/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		code, body := do(t, h, "GET", p, "eve", "")
+		if code != 200 {
+			t.Fatalf("%s: got %d", p, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.AssigneeID != "" {
+			t.Fatalf("%s still assigned to %q", p, task.AssigneeID)
+		}
+	}
+	// Other users are untouched.
+	code, body := do(t, h, "GET", "/projects/web/tasks/t2", "eve", "")
+	var t2 Task
+	json.Unmarshal([]byte(body), &t2)
+	if code != 200 || t2.AssigneeID != "cat" {
+		t.Fatalf("t2 changed: %d %q", code, t2.AssigneeID)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ann", ""); code != 200 {
+		t.Fatalf("ann lost access: %d", code)
+	}
+}
+
+func TestRemoveUserFromOrgDenied(t *testing.T) {
