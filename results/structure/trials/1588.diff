+// Freeze makes every member of the project (managers included) a viewer and
+// returns the resulting memberships. Viewers cannot be assignees, so the
+// project's tasks are unassigned too. It runs in one transaction.
+func (*ProjectTable) Freeze(ctx context.Context, db DB, authz ProjectAuthz) ([]*Membership, error) {
+	if err := authz.CanFreeze(); err != nil {
+		return nil, err
+	}
+	var ms []*Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		p, err := NewProjectTable().Find(ctx, tx, authz.ProjectID())
+		if err != nil {
+			return err
+		}
+		if ms, err = p.Memberships(ctx, tx); err != nil {
+			return err
+		}
+		for _, m := range ms {
+			if err := m.demote(ctx, tx); err != nil {
+				return err
+			}
+		}
+		ts, err := p.Tasks(ctx, tx)
+		if err != nil {
+			return err
+		}
+		for _, t := range ts {
+			if t.AssigneeID == "" {
+				continue
+			}
+			if err := t.unassign(ctx, tx); err != nil {
+				return err
+			}
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return ms, nil
+}
