+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestFreezePermissions(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"contributor", "ben", "/projects/web/freeze", 403},
+		{"viewer", "dan", "/projects/web/freeze", 403},
+		{"org admin non member", "eve", "/projects/web/freeze", 403},
+		{"non member", "hal", "/projects/web/freeze", 404},
+		{"other org", "gus", "/projects/web/freeze", 404},
+		{"anonymous", "", "/projects/web/freeze", 401},
+		{"archived", "ann", "/projects/legacy/freeze", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreeze(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 5 {
+		t.Fatalf("want 5 members, got %d: %s", len(got), body)
+	}
+	for _, m := range got {
+		if m["role"] != "viewer" || m["userId"] == "" || len(m) != 2 {
+			t.Fatalf("bad member %v", m)
+		}
+	}
+
+	// Nobody, managers included, can change tasks afterwards.
+	for _, user := range []string{"ann", "ivy", "ben", "cat", "dan"} {
+		for _, c := range []struct{ method, path, body string }{
+			{"POST", "/projects/web/tasks", `{"title":"x"}`},
+			{"PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+			{"DELETE", "/projects/web/tasks/t1", ""},
+			{"POST", "/projects/web/freeze", ""},
+		} {
+			if code, _ := do(t, h, c.method, c.path, user, c.body); code != 403 {
+				t.Errorf("%s %s %s: got %d want 403", user, c.method, c.path, code)
+			}
+		}
+	}
+	// Still readable, and other projects are untouched.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "dan", ""); code != 200 {
+		t.Fatalf("read after freeze: %d", code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`); code != 200 {
+		t.Fatalf("other project affected: %d", code)
+	}
+}
