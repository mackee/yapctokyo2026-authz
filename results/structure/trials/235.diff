+// OrgExists reports whether any user or project belongs to the org.
+func (s *Store) OrgExists(orgID string) bool {
+	for _, u := range s.users {
+		if u.OrgID == orgID {
+			return true
+		}
+	}
+	for _, p := range s.projects {
+		if p.OrgID == orgID {
+			return true
+		}
+	}
+	return false
+}
+
+// TransferUser moves a user to another org. Because roles and admin rights
+// are scoped to an org, the user's project memberships, task assignments and
+// OrgAdmin flag from the old org are all dropped.
+func (s *Store) TransferUser(u *User, toOrgID string) {
+	for _, members := range s.members {
+		delete(members, u.ID)
+	}
+	for _, t := range s.tasks {
+		if t.Assignee == u.ID {
+			t.Assignee = ""
+		}
+	}
+	u.OrgID = toOrgID
+	u.OrgAdmin = false
+}
