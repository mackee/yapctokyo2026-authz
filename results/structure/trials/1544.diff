+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben", 204},
+		{"no projects", "eve", "/orgs/acme/users/hal", 204},
+		{"non admin", "ann", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"other org admin path", "eve", "/orgs/globex/users/gus", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatal(code)
+	}
+	app := h.(*appHandler)
+	var n int
+	app.db.QueryRow(`SELECT COUNT(*) FROM memberships WHERE user_id = 'ben'`).Scan(&n)
+	if n != 0 {
+		t.Fatalf("ben still has %d memberships", n)
+	}
+	app.db.QueryRow(`SELECT COUNT(*) FROM tasks WHERE assignee = 'ben'`).Scan(&n)
+	if n != 0 {
+		t.Fatalf("ben still assigned %d tasks", n)
+	}
+	app.db.QueryRow(`SELECT COUNT(*) FROM memberships WHERE user_id <> 'ben'`).Scan(&n)
+	if n != 9 {
+		t.Fatalf("other memberships changed: %d", n)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben should lose access, got %d", code)
+	}
+}
