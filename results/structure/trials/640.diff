+// changeRoleAggregate changes one member's role in one project. Viewers cannot
+// be assignees, so a member demoted to viewer is unassigned from their tasks;
+// the last manager cannot be demoted.
+type changeRoleAggregate struct {
+	member   *Membership
+	managers []*Membership // the project's managers
+	tasks    []*Task       // tasks of the project assigned to the member
+	role     string
+}
+
+func loadChangeRole(ctx context.Context, tx DB, projectID, userID, role string) (*changeRoleAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	m, err := p.Membership(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	all, err := p.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	a := &changeRoleAggregate{member: m, role: role}
+	for _, o := range all {
+		if o.Role == RoleManager {
+			a.managers = append(a.managers, o)
+		}
+	}
+	if role == RoleViewer {
+		if a.tasks, err = m.AssignedTasks(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	return a, nil
+}
+
+func (a *changeRoleAggregate) validate() error {
+	if a.member.Role == RoleManager && a.role != RoleManager && len(a.managers) <= 1 {
+		return deny(ErrInvalid, "a project must keep at least one manager")
+	}
+	return nil
+}
+
+func (a *changeRoleAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.member.setRole(ctx, tx, a.role); err != nil {
+		return nil, err
+	}
+	return a.member, nil
+}
+
