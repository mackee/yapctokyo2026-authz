+// ChangeRole changes the role of a project member. The user must already be a
+// member of the project (else ErrNotFound).
+func (mt *MembershipTable) ChangeRole(ctx context.Context, db DB, authz ProjectAuthz, userID, role string) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if role != RoleManager && role != RoleContributor && role != RoleViewer {
+		return nil, deny(ErrInvalid, "invalid role")
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		var err error
+		if m, err = mt.Find(ctx, tx, authz.ProjectID(), userID); errors.Is(err, ErrNoRows) {
+			return deny(ErrNotFound, "not found")
+		} else if err != nil {
+			return err
+		}
+		return m.changeRole(ctx, tx, role)
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
