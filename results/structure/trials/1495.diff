+func TestSetMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager demotes member without tasks", "ann", "/projects/web/members/ivy", `{"role":"contributor"}`, 200},
+		{"manager promotes viewer", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"manager sets viewer on member without tasks", "ivy", "/projects/web/members/ann", `{"role":"viewer"}`, 200},
+		{"manager demotes member with assigned task", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 400},
+		{"contributor", "ben", "/projects/web/members/cat", `{"role":"viewer"}`, 403},
+		{"viewer", "dan", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"org admin", "eve", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"non member", "hal", "/projects/web/members/dan", `{"role":"contributor"}`, 404},
+		{"other org", "gus", "/projects/web/members/dan", `{"role":"contributor"}`, 404},
+		{"anonymous", "", "/projects/web/members/dan", `{"role":"contributor"}`, 401},
+		{"unknown user", "zed", "/projects/web/members/dan", `{"role":"contributor"}`, 401},
+		{"target is not a member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"target in another project", "ivy", "/projects/ops/members/ben", `{"role":"viewer"}`, 404},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"unknown role", "ann", "/projects/web/members/ivy", `{"role":"owner"}`, 400},
+		{"missing role", "ann", "/projects/web/members/ivy", `{}`, 400},
+		{"malformed body", "ann", "/projects/web/members/ivy", `{`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMemberRoleResponseAndStorage(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.UserID != "dan" || got.Role != "contributor" {
+		t.Fatalf("got %+v", got)
+	}
+	if role := memberRole(t, h, "web", "dan"); role != "contributor" {
+		t.Fatalf("stored role %q, want contributor", role)
+	}
+}
+
+func TestSetMemberRoleRejectedKeepsRole(t *testing.T) {
+	h := newServer()
+	// ben is assigned t1 in web, so he cannot become a viewer.
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	if role := memberRole(t, h, "web", "ben"); role != "contributor" {
+		t.Fatalf("stored role %q after rejected change, want contributor", role)
+	}
+}
+
+// memberRole reads the stored role of a membership straight from the database.
+func memberRole(t *testing.T, h http.Handler, projectID, userID string) string {
+	t.Helper()
+	app, ok := h.(*appHandler)
+	if !ok {
+		t.Fatalf("%T is not the handler built by newServer", h)
+	}
+	var role string
+	if err := app.db.QueryRow(`SELECT role FROM memberships WHERE project_id = ? AND user_id = ?`, projectID, userID).Scan(&role); err != nil {
+		t.Fatal(err)
+	}
+	return role
+}
