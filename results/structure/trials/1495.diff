+// setMemberRoleAggregate changes the role of one membership of a project.
+type setMemberRoleAggregate struct {
+	membership    *Membership
+	role          string
+	assignedTasks []*Task // the member's tasks in the project
+}
+
+func loadSetMemberRole(ctx context.Context, tx DB, projectID, userID, role string) (*setMemberRoleAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "membership not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &setMemberRoleAggregate{membership: m, role: role}
+	if !isWriterRole(role) {
+		a.assignedTasks, err = m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+	}
+	return a, nil
+}
+
+func (a *setMemberRoleAggregate) validate() error {
+	if !isWriterRole(a.role) && len(a.assignedTasks) > 0 {
+		return deny(ErrInvalid, "member has assigned tasks in the project; unassign them before making the member a viewer")
+	}
+	return nil
+}
+
+func (a *setMemberRoleAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.membership.setRole(ctx, tx, a.role); err != nil {
+		return nil, err
+	}
+	return a.membership, nil
+}
