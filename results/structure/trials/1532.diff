+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager moves", "ivy", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 200},
+		{"archived destination", "ann", "/projects/web/tasks/t3", `{"toProjectId":"legacy"}`, 409},
+		{"assignee not in destination", "ivy", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 400},
+		{"destination viewer", "ann", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 403},
+		{"contributor source", "cat", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 403},
+		{"viewer source", "dan", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 403},
+		{"org admin", "eve", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 403},
+		{"archived source", "ann", "/projects/legacy/tasks/t5", `{"toProjectId":"web"}`, 409},
+		{"other org destination", "ann", "/projects/web/tasks/t3", `{"toProjectId":"gx"}`, 404},
+		{"missing destination", "ann", "/projects/web/tasks/t3", `{"toProjectId":"nope"}`, 404},
+		{"same project", "ann", "/projects/web/tasks/t3", `{"toProjectId":"web"}`, 400},
+		{"empty destination", "ann", "/projects/web/tasks/t3", `{"toProjectId":""}`, 400},
+		{"cross project id", "ann", "/projects/web/tasks/t4", `{"toProjectId":"ops"}`, 404},
+		{"non member", "hal", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsFields(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", Assignee: "cat"}
+	var got Task
+	json.Unmarshal([]byte(body), &got)
+	if got != want {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t2", "ivy", ""); code != 404 {
+		t.Fatalf("old location: got %d want 404", code)
+	}
+	code, body = do(t, h, "GET", "/projects/ops/tasks/t2", "ivy", "")
+	json.Unmarshal([]byte(body), &got)
+	if code != 200 || got != want {
+		t.Fatalf("new location: %d %+v", code, got)
+	}
+}
+
+func TestMoveToContributorDestination(t *testing.T) {
+	// hal: manager in web, contributor in ops (not in the seed). A destination
+	// contributor may only receive tasks assigned to themselves or to nobody.
+	h := newServer()
+	app := h.(*appHandler)
+	if _, err := app.db.Exec(`INSERT INTO memberships VALUES ('web','hal','manager'), ('ops','hal','contributor')`); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := app.db.Exec(`INSERT INTO tasks VALUES ('t7','web','Mine','open','hal')`); err != nil {
+		t.Fatal(err)
+	}
+	for _, c := range []struct {
+		tid  string
+		want int
+	}{{"t2", 403}, {"t3", 200}, {"t7", 200}} {
+		code, body := do(t, h, "POST", "/projects/web/tasks/"+c.tid+"/move", "hal", `{"toProjectId":"ops"}`)
+		if code != c.want {
+			t.Fatalf("%s: got %d want %d: %s", c.tid, code, c.want, body)
+		}
+	}
+}
