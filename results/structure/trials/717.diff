@@ -0,0 +1,71 @@
+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestSetMemberRoles(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	for _, want := range []string{`{"userId":"ben","role":"viewer"}`, `{"userId":"dan","role":"contributor"}`, `{"userId":"ann","role":"manager"}`} {
+		if !strings.Contains(body, want) {
+			t.Errorf("missing %s in %s", want, body)
+		}
+	}
+	// the change is visible: ben is now a viewer and cannot create tasks
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Errorf("demoted ben create: got %d want 403", code)
+	}
+	// promotion works too
+	if code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"cat":"manager"}}`); code != 200 {
+		t.Errorf("promote: got %d", code)
+	}
+}
+
+func TestSetMemberRolesRejected(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"no user", "", "/projects/web/members", `{"roles":{"ben":"viewer"}}`, 401},
+		{"contributor", "ben", "/projects/web/members", `{"roles":{"ben":"viewer"}}`, 403},
+		{"viewer", "dan", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin", "eve", "/projects/web/members", `{"roles":{"ben":"viewer"}}`, 403},
+		{"non-member", "hal", "/projects/web/members", `{"roles":{"ben":"viewer"}}`, 404},
+		{"other org", "gus", "/projects/web/members", `{"roles":{"ben":"viewer"}}`, 404},
+		{"manager of other project", "ann", "/projects/gx/members", `{"roles":{"gus":"viewer"}}`, 404},
+		{"archived", "ann", "/projects/legacy/members", `{"roles":{"ben":"viewer"}}`, 409},
+		{"bad role", "ann", "/projects/web/members", `{"roles":{"ben":"owner"}}`, 400},
+		{"unknown member", "ann", "/projects/web/members", `{"roles":{"hal":"viewer"}}`, 400},
+		{"empty", "ann", "/projects/web/members", `{"roles":{}}`, 400},
+		{"bad json", "ann", "/projects/web/members", `nope`, 400},
+		{"demote every manager", "ann", "/projects/web/members", `{"roles":{"ann":"viewer","ivy":"viewer"}}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestSetMemberRolesAtomic(t *testing.T) {
+	h := newServer()
+	// ben is valid, hal is not a member: nothing may change.
+	if code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","hal":"viewer"}}`); code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 200 {
+		t.Fatalf("ben should still be a contributor, got %d", code)
+	}
+	// managers may demote themselves while another manager remains.
+	if code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ann":"viewer"}}`); code != 200 {
+		t.Fatalf("self-demote got %d want 200", code)
+	}
+}
