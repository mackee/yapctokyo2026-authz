+// moveMemberAggregate moves one member from one project to another.
+type moveMemberAggregate struct {
+	from     *Membership
+	fromProj *Project
+	toProj   *Project
+	toAuthz  ProjectAuthz // the actor's authorization in the destination
+	assigned []*Task      // from.AssignedTasks: unassigned when the member leaves
+}
+
+func loadMoveMember(ctx context.Context, tx DB, authz ProjectAuthz, userID string, in MembershipTableMoveInput) (*moveMemberAggregate, error) {
+	notFound := deny(ErrInvalid, "destination project not found")
+	fromProj, err := NewProjectTable().Find(ctx, tx, authz.ProjectID())
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	from, err := fromProj.Membership(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveMemberAggregate{from: from, fromProj: fromProj}
+	if in.ToProjectID == fromProj.ID {
+		return nil, deny(ErrInvalid, "destination must be a different project")
+	}
+	a.toProj, err = NewProjectTable().Find(ctx, tx, in.ToProjectID)
+	if errors.Is(err, ErrNoRows) || (err == nil && a.toProj.Org != fromProj.Org) {
+		return nil, notFound
+	} else if err != nil {
+		return nil, err
+	}
+	a.toAuthz, err = NewProjectAuthz(ctx, tx, authz.Actor(), a.toProj.ID)
+	if errors.Is(err, ErrNotFound) {
+		return nil, notFound
+	} else if err != nil {
+		return nil, err
+	}
+	if a.assigned, err = from.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if err := a.toAuthz.CanManageMembers(); err != nil {
+		return err
+	}
+	if a.toProj.Org != a.fromProj.Org {
+		return deny(ErrInvalid, "project members must belong to the project's organization")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	// Rejected here rather than in validate so the read of the destination
+	// membership stays next to the write.
+	if _, err := a.toProj.Membership(ctx, tx, a.from.UserID); err == nil {
+		return nil, deny(ErrInvalid, "user is already a member of the destination project")
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	for _, t := range a.assigned {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.from.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	m := &Membership{ProjectID: a.toProj.ID, UserID: a.from.UserID, Role: a.from.Role}
+	if err := m.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
+
 // deleteTaskAggregate removes one task.
