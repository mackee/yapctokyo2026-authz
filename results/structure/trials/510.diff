+}
+
+// A transferred user loses its acme memberships and the assignments in acme
+// projects; other users are not affected.
+func TestTransferRemovesAccess(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer got %d: %s", code, body)
+	}
+
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads web: got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/legacy/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads legacy: got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ann", ""); code != 200 {
+		t.Fatalf("ann reads web: got %d want 200", code)
+	}
+
+	// t1 (web) and t5 (legacy) were assigned to ben; they are unassigned now.
+	for _, path := range []string{"/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		code, body := do(t, srv, "GET", path, "ann", "")
+		if code != 200 {
+			t.Fatalf("%s: got %d", path, code)
+		}
+		if !strings.Contains(body, `"assignee":""`) {
+			t.Fatalf("%s still assigned: %s", path, body)
+		}
+	}
+}
