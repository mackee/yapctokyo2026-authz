+// transferUserAggregate moves one user of an organization to another one.
+type transferUserAggregate struct {
+	user        *User
+	toOrg       string
+	memberships []*Membership // the user's memberships in projects outside toOrg
+	tasks       []*Task       // the user's assigned tasks in projects outside toOrg
+}
+
+func loadTransferUser(ctx context.Context, tx DB, fromOrg string, in UserTableTransferInput) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, in.UserID)
+	if errors.Is(err, ErrNoRows) || (err == nil && u.Org != fromOrg) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	exists, err := NewOrgTable().Exists(ctx, tx, in.ToOrgID)
+	if err != nil {
+		return nil, err
+	}
+	if !exists {
+		return nil, deny(ErrInvalid, "unknown organization")
+	}
+	a := &transferUserAggregate{user: u, toOrg: in.ToOrgID}
+
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, m := range ms {
+		outside, err := a.outside(ctx, tx, m.ProjectID)
+		if err != nil {
+			return nil, err
+		}
+		if outside {
+			a.memberships = append(a.memberships, m)
+		}
+	}
+
+	ts, err := u.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, t := range ts {
+		outside, err := a.outside(ctx, tx, t.ProjectID)
+		if err != nil {
+			return nil, err
+		}
+		if outside {
+			a.tasks = append(a.tasks, t)
+		}
+	}
+	return a, nil
+}
+
+// outside reports whether the project is not in the target organization. A
+// project that does not exist is outside it too.
+func (a *transferUserAggregate) outside(ctx context.Context, tx DB, projectID string) (bool, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return true, nil
+	} else if err != nil {
+		return false, err
+	}
+	return p.Org != a.toOrg, nil
+}
+
+func (a *transferUserAggregate) validate() error { return nil }
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.user.moveTo(ctx, tx, a.toOrg); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
