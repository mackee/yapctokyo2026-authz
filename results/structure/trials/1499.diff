+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager removes member", "ann", "/projects/web/members/cat", 204},
+		{"manager removes viewer", "ann", "/projects/web/members/dan", 204},
+		{"contributor", "ben", "/projects/web/members/cat", 403},
+		{"viewer", "dan", "/projects/web/members/ben", 403},
+		{"org admin", "eve", "/projects/web/members/ben", 403},
+		{"non member actor", "hal", "/projects/web/members/ben", 404},
+		{"other org actor", "gus", "/projects/web/members/ben", 404},
+		{"anonymous", "", "/projects/web/members/ben", 401},
+		{"target not a member", "ann", "/projects/web/members/hal", 404},
+		{"manager removes self", "ann", "/projects/web/members/ann", 204},
+		{"archived", "ann", "/projects/legacy/members/ben", 409},
+		{"unknown project", "ann", "/projects/nope/members/ben", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveMemberEffects(t *testing.T) {
+	srv := newServer()
+
+	// ben is a web contributor assigned t1; removing him unassigns t1 and
+	// ends his access to web.
+	if code, body := do(t, srv, "DELETE", "/projects/web/members/ben", "ann", ""); code != 204 {
+		t.Fatalf("remove ben: got %d %s", code, body)
+	}
+	code, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("get t1: got %d %s", code, body)
+	}
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.AssigneeID != "" {
+		t.Fatalf("t1 still assigned to %q", task.AssigneeID)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("removed member still reads project: got %d", code)
+	}
+
+	// cat's membership in ops is removed; her web membership and web task t2 stay.
+	if code, body := do(t, srv, "DELETE", "/projects/ops/members/cat", "ivy", ""); code != 204 {
+		t.Fatalf("remove cat from ops: got %d %s", code, body)
+	}
+	if code, body := do(t, srv, "GET", "/projects/ops/tasks/t4", "ann", ""); code != 200 {
+		t.Fatalf("get ops t4: got %d %s", code, body)
+	} else {
+		json.Unmarshal([]byte(body), &task)
+		if task.AssigneeID != "" {
+			t.Fatalf("ops t4 still assigned to %q", task.AssigneeID)
+		}
+	}
+	if code, body := do(t, srv, "GET", "/projects/web/tasks/t2", "ann", ""); code != 200 {
+		t.Fatalf("get web t2: got %d %s", code, body)
+	} else {
+		json.Unmarshal([]byte(body), &task)
+		if task.AssigneeID != "cat" {
+			t.Fatalf("web t2 assignee changed to %q", task.AssigneeID)
+		}
+	}
+
+	// Removing again is 404: the membership is gone.
+	if code, _ := do(t, srv, "DELETE", "/projects/web/members/ben", "ann", ""); code != 404 {
+		t.Fatalf("second remove: got %d want 404", code)
+	}
+}
