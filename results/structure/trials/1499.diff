+// Delete removes the user from the project. The project's tasks assigned to
+// the user are unassigned in the same transaction, all or nothing. It returns
+// ErrNotFound when the user is not a member.
+func (*MembershipTable) Delete(ctx context.Context, db DB, authz ProjectAuthz, userID string) error {
+	if err := authz.CanManageMembers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveMember(ctx, tx, authz.ProjectID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
