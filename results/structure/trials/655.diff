+func TestUpdateMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, project, target, body string
+		want                              int
+	}{
+		{"manager promotes viewer", "ann", "web", "dan", `{"role":"contributor"}`, 200},
+		{"manager demotes contributor", "ann", "web", "ben", `{"role":"viewer"}`, 200},
+		{"manager demotes self", "ann", "web", "ann", `{"role":"viewer"}`, 200},
+		{"contributor", "ben", "web", "cat", `{"role":"viewer"}`, 403},
+		{"viewer", "dan", "web", "ben", `{"role":"viewer"}`, 403},
+		{"org admin", "eve", "web", "ben", `{"role":"viewer"}`, 403},
+		{"non member", "hal", "web", "ben", `{"role":"viewer"}`, 404},
+		{"other org", "gus", "web", "ben", `{"role":"viewer"}`, 404},
+		{"anonymous", "", "web", "ben", `{"role":"viewer"}`, 401},
+		{"unknown user", "zed", "web", "ben", `{"role":"viewer"}`, 401},
+		{"archived", "ann", "legacy", "ben", `{"role":"viewer"}`, 409},
+		{"invalid role", "ann", "web", "dan", `{"role":"owner"}`, 400},
+		{"missing role", "ann", "web", "dan", `{}`, 400},
+		{"target not a member", "ann", "web", "hal", `{"role":"viewer"}`, 404},
+		{"target in other org", "ann", "web", "gus", `{"role":"viewer"}`, 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "PUT", "/projects/"+c.project+"/members/"+c.target, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRoleResponse(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"viewer"}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["userId"] != "dan" || got["role"] != "viewer" {
+		t.Fatalf("got %v", got)
+	}
+}
