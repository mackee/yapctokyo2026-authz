+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager removes viewer", "ann", "/projects/web/members/dan", 204},
+		{"manager removes manager", "ann", "/projects/web/members/ivy", 204},
+		{"manager, member has assigned tasks", "ann", "/projects/web/members/ben", 400},
+		{"manager, not a member", "ann", "/projects/web/members/gus", 404},
+		{"manager, unknown user", "ann", "/projects/web/members/zed", 404},
+		{"manager, archived project", "ann", "/projects/legacy/members/ben", 409},
+		{"contributor", "ben", "/projects/web/members/dan", 403},
+		{"viewer", "dan", "/projects/web/members/ivy", 403},
+		{"org admin", "eve", "/projects/web/members/dan", 403},
+		{"non member", "hal", "/projects/web/members/dan", 404},
+		{"other org", "gus", "/projects/web/members/dan", 404},
+		{"anonymous", "", "/projects/web/members/dan", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveMemberTakesEffect(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "DELETE", "/projects/web/members/dan", "ann", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "dan", ""); code != 404 {
+		t.Fatalf("removed member still reads the project: got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "DELETE", "/projects/web/members/dan", "ann", ""); code != 404 {
+		t.Fatalf("second remove: got %d want 404", code)
+	}
+}
