+// Delete removes the user from the project. Only managers may do it (else
+// ErrForbidden), and not in an archived project (else ErrArchived). A user who
+// is not a member is ErrNotFound. A member who is assigned tasks in the project
+// cannot be removed: the assignee rule would break, so the write is rejected
+// (ErrInvalid) and nothing changes.
+func (mt *MembershipTable) Delete(ctx context.Context, db DB, authz ProjectAuthz, userID string) error {
+	if err := authz.CanManageMembers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveMember(ctx, tx, authz.ProjectID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
