+// updateRolesAggregate changes the roles of several members of one project.
+type updateRolesAggregate struct {
+	members  []*Membership      // the members being changed, ordered by user ID
+	newRoles map[string]string  // user ID -> new role
+	assigned map[string][]*Task // user ID -> tasks assigned to them in the project
+}
+
+func loadUpdateRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*updateRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "membership must belong to an existing project")
+	} else if err != nil {
+		return nil, err
+	}
+	all, err := p.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	a := &updateRolesAggregate{newRoles: roles, assigned: map[string][]*Task{}}
+	for _, m := range all {
+		if _, ok := roles[m.UserID]; ok {
+			a.members = append(a.members, m)
+		}
+	}
+	if len(a.members) != len(roles) {
+		return nil, deny(ErrInvalid, "every user must be a member of the project")
+	}
+	for _, m := range a.members {
+		ts, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.assigned[m.UserID] = ts
+	}
+	return a, nil
+}
+
+func (a *updateRolesAggregate) validate() error {
+	for _, m := range a.members {
+		role := a.newRoles[m.UserID]
+		if role != RoleManager && role != RoleContributor && role != RoleViewer {
+			return deny(ErrInvalid, "role must be manager, contributor or viewer")
+		}
+	}
+	return nil
+}
+
+// apply changes the roles. A member who becomes a viewer can no longer be an
+// assignee, so their tasks in the project are unassigned.
+func (a *updateRolesAggregate) apply(ctx context.Context, tx DB) error {
+	for _, m := range a.members {
+		role := a.newRoles[m.UserID]
+		if !isWriterRole(role) {
+			for _, t := range a.assigned[m.UserID] {
+				if err := t.unassign(ctx, tx); err != nil {
+					return err
+				}
+			}
+		}
+		if err := m.setRole(ctx, tx, role); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
