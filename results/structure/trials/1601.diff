diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..e2af829
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,108 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"reflect"
+	"testing"
+)
+
+type memberJSON struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func members(t *testing.T, h http.Handler, project string) []memberJSON {
+	t.Helper()
+	app := h.(*appHandler)
+	rows, err := app.db.Query(`SELECT user_id, role FROM memberships WHERE project_id = ? ORDER BY user_id`, project)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer rows.Close()
+	var out []memberJSON
+	for rows.Next() {
+		var m memberJSON
+		if err := rows.Scan(&m.UserID, &m.Role); err != nil {
+			t.Fatal(err)
+		}
+		out = append(out, m)
+	}
+	return out
+}
+
+func TestUpdateRolesSuccess(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []memberJSON
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []memberJSON{
+		{"ann", "manager"}, {"ben", "viewer"}, {"cat", "contributor"}, {"dan", "contributor"}, {"ivy", "manager"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	// ben became a viewer, so t1 is unassigned (model rule: assignees can write).
+	code, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if code != 200 || task.AssigneeID != "" {
+		t.Fatalf("t1: %d %+v", code, task)
+	}
+}
+
+func TestUpdateRolesErrors(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"invalid role", "ann", "web", `{"roles":{"dan":"boss"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"bad json", "ann", "web", `{`, 400},
+		{"non member target", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"other org target", "ann", "web", `{"roles":{"gus":"viewer"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			before := members(t, h, c.project)
+			code, body := do(t, h, "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+			if after := members(t, h, c.project); !reflect.DeepEqual(before, after) {
+				t.Fatalf("members changed: %v -> %v", before, after)
+			}
+		})
+	}
+}
+
+// One bad entry rejects the whole request and changes nothing.
+func TestUpdateRolesAllOrNothing(t *testing.T) {
+	for _, body := range []string{
+		`{"roles":{"ben":"viewer","hal":"viewer"}}`,
+		`{"roles":{"ben":"viewer","dan":"boss"}}`,
+	} {
+		h := newServer()
+		before := members(t, h, "web")
+		code, _ := do(t, h, "PUT", "/projects/web/members", "ann", body)
+		if code != 400 {
+			t.Fatalf("%s: got %d want 400", body, code)
+		}
+		if after := members(t, h, "web"); !reflect.DeepEqual(before, after) {
+			t.Fatalf("%s: members changed: %v -> %v", body, before, after)
+		}
+	}
+}
