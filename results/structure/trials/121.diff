 }
 
 // ProjectScope is bound to one actor and one project ID. It grants nothing by
@@ -139,6 +146,68 @@ func (s *actorScope) Actor() Actor { return s.actor }
 func (s *actorScope) Project(projectID string) ProjectScope {
 	return &projectScope{as: s, pid: projectID}
 }
+func (s *actorScope) Org(orgID string) OrgScope {
+	return &orgScope{as: s, oid: orgID}
+}
+
+type orgScope struct {
+	as  *actorScope
+	oid string
+}
+
+// ---- org capabilities ---------------------------------------------------------
+
+// AdminOrg may manage the members of one organization. Only org admins of that
+// organization can acquire it.
+type AdminOrg interface {
+	// RemoveUser removes a user from the organization: they are removed from
+	// the members of every project in the organization, and tasks they were
+	// assigned to in those projects become unassigned. The user record itself
+	// is kept. Removing a user who is already out of the organization succeeds
+	// as a no-op; a user that is not a user of this organization is 404.
+	RemoveUser(userID string) error
+}
+
+// Admin applies the org rule: the organization must be the actor's own (else
+// 404), and the actor must be an org admin (else 403).
+func (s *orgScope) Admin() (AdminOrg, error) {
+	err := s.as.a.st.read(func(st *state) error {
+		if s.oid != s.as.actor.org {
+			return deny(ErrNotFound, "not found")
+		}
+		if !s.as.actor.orgAdmin {
+			return deny(ErrForbidden, "forbidden")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &adminOrg{os: s}, nil
+}
+
+type adminOrg struct{ os *orgScope }
+
+func (o *adminOrg) RemoveUser(userID string) error {
+	return o.os.as.a.st.tx(func(s *state) error {
+		u, ok := s.users[userID]
+		if !ok || u.org != o.os.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		for pid, p := range s.projects {
+			if p.org == o.os.oid {
+				delete(s.members[pid], userID)
+			}
+		}
+		for tid, t := range s.tasks {
+			if t.assignee.user == userID && s.projects[t.project].org == o.os.oid {
+				t.assignee = Assignee{project: t.project}
+				s.tasks[tid] = t
+			}
+		}
+		return nil
+	})
+}
 
