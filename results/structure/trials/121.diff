+func TestRemoveOrgUserAccess(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/hal", 204},
+		{"same org non admin", "ann", "/orgs/acme/users/hal", 403},
+		{"contributor non admin", "ben", "/orgs/acme/users/hal", 403},
+		{"other org admin on this org", "gus", "/orgs/acme/users/hal", 404},
+		{"org admin on other org", "eve", "/orgs/globex/users/gus", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"anonymous", "", "/orgs/acme/users/hal", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/hal", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+
+	// Before: ben is a contributor of web and legacy, and is assigned t1 (web) and t5 (legacy).
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("before: ben read web got %d", code)
+	}
+
+	// A refused attempt by a non-admin changes nothing.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "ann", ""); code != 403 {
+		t.Fatalf("non-admin remove got %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("after refused remove: ben read web got %d", code)
+	}
+
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove ben got %d", code)
+	}
+
+	// ben is no longer a member of any project: reads are 404 and writes are refused.
+	for _, p := range []string{"/projects/web/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, h, "GET", p, "ben", ""); code != 404 {
+			t.Fatalf("removed ben read %s got %d", p, code)
+		}
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 404 {
+		t.Fatalf("removed ben patch got %d", code)
+	}
+
+	// Tasks ben was assigned to are unassigned; the tasks themselves remain.
+	var task Task
+	_, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" || task.Title != "Fix header" {
+		t.Fatalf("t1 after removal: %+v", task)
+	}
+	_, body = do(t, h, "GET", "/projects/legacy/tasks/t5", "ann", "")
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" || task.Title != "Old bug" {
+		t.Fatalf("t5 after removal: %+v", task)
+	}
+
+	// Other members are untouched.
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t2", "ann", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ann patch after removal got %d", code)
+	}
+
+	// Removing again is a no-op success.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("second remove got %d", code)
+	}
+}
