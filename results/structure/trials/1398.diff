new file mode 100644
index 0000000..180e89f
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,115 @@
+package main
+
+import (
+	"encoding/json"
+	"reflect"
+	"testing"
+)
+
+func TestSetMemberRoles(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager changes a viewer", "ann", "web", `{"roles":{"dan":"contributor"}}`, 200},
+		{"one change breaks a rule, all rejected", "ann", "web", `{"roles":{"dan":"contributor","cat":"viewer"}}`, 400},
+		{"contributor caller", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer caller", "dan", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"org admin caller", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member caller", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org caller", "gus", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"unknown user", "zed", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"anonymous", "", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"unknown role", "ann", "web", `{"roles":{"dan":"owner"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"malformed body", "ann", "web", `{"roles":`, 400},
+		{"target not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"assignee would stop being a writer", "ann", "web", `{"roles":{"ben":"viewer"}}`, 400},
+		{"assignee of another task", "ann", "web", `{"roles":{"cat":"viewer"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMemberRolesResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []Member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []Member{
+		{UserID: "ann", Role: "manager"},
+		{UserID: "ben", Role: "contributor"},
+		{UserID: "cat", Role: "contributor"},
+		{UserID: "dan", Role: "contributor"},
+		{UserID: "ivy", Role: "manager"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+}
+
+// A rejected batch changes nothing, even the members in it that would be valid
+// on their own. Each response lists the members after the call, so a later
+// no-op call shows the state.
+func TestSetMemberRolesAllOrNothing(t *testing.T) {
+	h := newServer()
+	for _, body := range []string{
+		`{"roles":{"dan":"contributor","hal":"viewer"}}`, // hal is not a member
+		`{"roles":{"dan":"contributor","ben":"viewer"}}`, // ben holds t1
+	} {
+		if code, _ := do(t, h, "PUT", "/projects/web/members", "ann", body); code != 400 {
+			t.Fatalf("%s: got %d want 400", body, code)
+		}
+	}
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ann":"manager"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []Member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	for _, m := range got {
+		if m.UserID == "dan" && m.Role != "viewer" {
+			t.Fatalf("dan changed to %s by a rejected batch", m.Role)
+		}
+		if m.UserID == "ben" && m.Role != "contributor" {
+			t.Fatalf("ben changed to %s by a rejected batch", m.Role)
+		}
+	}
+}
+
+// Ben holds t1 on web, so he can move to viewer only after t1 is unassigned.
+func TestSetMemberRolesAfterUnassigning(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "PATCH", "/projects/web/tasks/t1", "ann", `{"assignee":""}`); code != 200 {
+		t.Fatalf("unassign: got %d: %s", code, body)
+	}
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []Member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	roles := map[string]string{}
+	for _, m := range got {
+		roles[m.UserID] = m.Role
+	}
+	if roles["ben"] != "viewer" || roles["dan"] != "contributor" {
+		t.Fatalf("roles after change: %v", roles)
+	}
+}
