+  // PUT /projects/{pid}/members {"roles": {uid: role}}
+  // roles maps user IDs to their new role. A role outside ROLES is a malformed
+  // body (400, checked before any rule). Only managers may change roles;
+  // archived projects reject it (409). Every named user must already be a
+  // member (400), and the change must not leave a task assigned to someone who
+  // is no longer a contributor or manager of the task's project (400).
+  def membersOutcome(u: UserId, p: ProjectId, roles: UserId -> Role): int =
+    if (not(roles.keys().forall(x => ROLES.contains(roles.get(x))))) 400
+    else if (not(userExists(u))) 401
+    else if (not(canRead(u, p))) 404
+    else if (roleOf(p, u) != "manager") 403
+    else if (projects.get(p).archived) 409
+    else if (not(roles.keys().forall(x => roleOf(p, x) != ""))) 400
+    else if (tasks.keys().exists(t => and {
+      tasks.get(t).project == p,
+      tasks.get(t).assignee != "",
+      not(writerAfter(p, roles, tasks.get(t).assignee)),
+    })) 400
+    else 200
+
+  // The role a member has once the change is applied.
+  def roleAfter(p: ProjectId, roles: UserId -> Role, x: UserId): Role =
+    if (roles.keys().contains(x)) roles.get(x) else roleOf(p, x)
+
+  def writerAfter(p: ProjectId, roles: UserId -> Role, x: UserId): bool =
+    Set("contributor", "manager").contains(roleAfter(p, roles, x))
+
