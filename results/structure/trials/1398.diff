+// setRolesAggregate changes the roles of some members of one project.
+type setRolesAggregate struct {
+	project *Project
+	members map[string]*Membership // every member of the project, by user ID, before the change
+	tasks   []*Task                // every task of the project
+	roles   map[string]string      // the requested role of each named member
+}
+
+func loadSetRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*setRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	ms, err := p.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	members := make(map[string]*Membership, len(ms))
+	for _, m := range ms {
+		members[m.UserID] = m
+	}
+	tasks, err := p.Tasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &setRolesAggregate{project: p, members: members, tasks: tasks, roles: roles}, nil
+}
+
+// sortedUserIDs returns the keys of roles in order, so errors are deterministic.
+func (a *setRolesAggregate) sortedUserIDs() []string {
+	ids := make([]string, 0, len(a.roles))
+	for id := range a.roles {
+		ids = append(ids, id)
+	}
+	sort.Strings(ids)
+	return ids
+}
+
+// roleAfter is the member's role once the change is applied.
+func (a *setRolesAggregate) roleAfter(userID string) string {
+	if role, ok := a.roles[userID]; ok {
+		return role
+	}
+	if m, ok := a.members[userID]; ok {
+		return m.Role
+	}
+	return ""
+}
+
+// validate checks the model rules on the state the change would produce: every
+// named user is a member with a valid role, and every task's assignee is still
+// a contributor or manager of the project.
+func (a *setRolesAggregate) validate() error {
+	for _, id := range a.sortedUserIDs() {
+		if _, ok := a.members[id]; !ok {
+			return deny(ErrInvalid, "user "+id+" is not a member of the project")
+		}
+		if !isValidRole(a.roles[id]) {
+			return deny(ErrInvalid, "invalid role "+a.roles[id])
+		}
+	}
+	for _, t := range a.tasks {
+		if t.AssigneeID == "" {
+			continue
+		}
+		if !isWriterRole(a.roleAfter(t.AssigneeID)) {
+			return deny(ErrInvalid, "task "+t.ID+" is assigned to "+t.AssigneeID+", who would no longer be a contributor or manager of the project")
+		}
+	}
+	return nil
+}
+
+func (a *setRolesAggregate) apply(ctx context.Context, tx DB) error {
+	for _, id := range a.sortedUserIDs() {
+		if err := a.members[id].changeRole(ctx, tx, a.roles[id]); err != nil {
+			return err
+		}
+	}
+	return nil
+}
