+// setMemberRoles changes the roles of the named members, all or nothing, and
+// answers with the project's members after the change.
+func setMemberRoles(ctx tanukirpc.Context[*projectRegistry], req setRolesRequest) ([]Member, error) {
+	reg := ctx.Registry()
+	ms, err := model.NewMembershipTable().SetRoles(ctx, reg.db, reg.authz, req.Roles)
+	if err != nil {
+		return nil, err
+	}
+	out := make([]Member, 0, len(ms))
+	for _, m := range ms {
+		out = append(out, Member{UserID: m.UserID, Role: m.Role})
+	}
+	return out, nil
+}
