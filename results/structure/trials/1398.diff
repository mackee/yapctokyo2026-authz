+// ---- operations -----------------------------------------------------------------------
+
+// SetRoles changes the roles of several members of the project, all or nothing,
+// and returns the project's members after the change (ordered by user ID).
+// roles maps user IDs to their new role. It asks the authorization object
+// whether the actor may manage members, then runs setRolesAggregate in a
+// transaction.
+func (mt *MembershipTable) SetRoles(ctx context.Context, db DB, authz ProjectAuthz, roles map[string]string) ([]*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var out []*Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadSetRoles(ctx, tx, authz.ProjectID(), roles)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if err := agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		out, err = mt.ListByProject(ctx, tx, authz.ProjectID())
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
