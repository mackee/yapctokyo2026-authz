+func TestTransfer(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/cat/transfer", `{"toOrgId":"globex"}`, 200},
+		{"not org admin", "ann", "/orgs/acme/users/cat/transfer", `{"toOrgId":"globex"}`, 403},
+		{"anonymous", "", "/orgs/acme/users/cat/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown caller", "zed", "/orgs/acme/users/cat/transfer", `{"toOrgId":"globex"}`, 401},
+		{"caller in other org", "gus", "/orgs/acme/users/cat/transfer", `{"toOrgId":"globex"}`, 404},
+		{"path org is not caller's", "eve", "/orgs/globex/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"user in other org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"archived membership", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 409},
+		{"same org", "eve", "/orgs/acme/users/cat/transfer", `{"toOrgId":"acme"}`, 400},
+		{"unknown target", "eve", "/orgs/acme/users/cat/transfer", `{"toOrgId":"nowhere"}`, 400},
+		{"missing target", "eve", "/orgs/acme/users/cat/transfer", `{}`, 400},
+		{"bad body", "eve", "/orgs/acme/users/cat/transfer", `{"toOrgId":`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/cat/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+	var got transferResponse
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got != (transferResponse{ID: "cat", OrgID: "globex"}) {
+		t.Fatalf("got %+v", got)
+	}
+}
+
+func TestTransferEffects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/orgs/acme/users/cat/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: got %d want 200", code)
+	}
+
+	// cat's acme projects are gone and cat's tasks there are unassigned.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 404 {
+		t.Fatalf("cat reads web: got %d want 404", code)
+	}
+	for _, path := range []string{"/projects/web/tasks/t2", "/projects/ops/tasks/t4"} {
+		code, body := do(t, h, "GET", path, "ann", "")
+		if code != 200 {
+			t.Fatalf("%s: got %d want 200", path, code)
+		}
+		var task Task
+		json.Unmarshal([]byte(body), &task)
+		if task.Assignee != "" {
+			t.Fatalf("%s: assignee %q want unassigned", path, task.Assignee)
+		}
+	}
+	// Other people's assignments are untouched.
+	if _, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", ""); !strings.Contains(body, `"assignee":"ben"`) {
+		t.Fatalf("t1 assignee changed: %s", body)
+	}
+
+	// cat is no longer in acme, so acme's admin cannot move cat again.
+	if code, _ := do(t, h, "POST", "/orgs/acme/users/cat/transfer", "eve", `{"toOrgId":"globex"}`); code != 404 {
+		t.Fatalf("second transfer: got %d want 404", code)
+	}
+}
+
+func TestTransferClearsOrgAdmin(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: got %d want 200", code)
+	}
+	// eve is a globex user now, without admin rights there: gx is not readable.
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "eve", ""); code != 404 {
+		t.Fatalf("eve reads gx: got %d want 404", code)
+	}
+}
