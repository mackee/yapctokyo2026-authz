@@ -0,0 +1,147 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"reflect"
+	"testing"
+)
+
+// dbRoles reads the memberships of a project straight from the database.
+func dbRoles(t *testing.T, h http.Handler, project string) map[string]string {
+	t.Helper()
+	app := h.(*appHandler)
+	rows, err := app.db.Query(`SELECT user_id, role FROM memberships WHERE project_id = ?`, project)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer rows.Close()
+	out := map[string]string{}
+	for rows.Next() {
+		var u, r string
+		if err := rows.Scan(&u, &r); err != nil {
+			t.Fatal(err)
+		}
+		out[u] = r
+	}
+	return out
+}
+
+func taskAssignee(t *testing.T, h http.Handler, id string) string {
+	t.Helper()
+	var a string
+	if err := h.(*appHandler).db.QueryRow(`SELECT assignee FROM tasks WHERE id = ?`, id).Scan(&a); err != nil {
+		t.Fatal(err)
+	}
+	return a
+}
+
+func TestBulkRolesSuccess(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []memberView
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []memberView{
+		{"ann", "manager"}, {"ben", "viewer"}, {"cat", "contributor"}, {"dan", "contributor"}, {"ivy", "manager"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	if r := dbRoles(t, h, "web"); r["ben"] != "viewer" || r["dan"] != "contributor" {
+		t.Fatalf("not persisted: %v", r)
+	}
+	// ben was demoted: his task must not stay assigned to a viewer (checkModelRules also covers this).
+	if a := taskAssignee(t, h, "t1"); a != "" {
+		t.Fatalf("t1 still assigned to %q", a)
+	}
+	// untouched tasks keep their assignee
+	if a := taskAssignee(t, h, "t2"); a != "cat" {
+		t.Fatalf("t2 assignee changed to %q", a)
+	}
+}
+
+func TestBulkRolesPromoteKeepsTasks(t *testing.T) {
+	h := newServer()
+	code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"manager"}}`)
+	if code != 200 {
+		t.Fatal(code)
+	}
+	if a := taskAssignee(t, h, "t1"); a != "ben" {
+		t.Fatalf("t1 assignee %q", a)
+	}
+}
+
+func TestBulkRolesErrors(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"anonymous", "", "/projects/web/members", `{"roles":{"dan":"viewer"}}`, 401},
+		{"unknown user", "zed", "/projects/web/members", `{"roles":{"dan":"viewer"}}`, 401},
+		{"non member", "hal", "/projects/web/members", `{"roles":{"dan":"viewer"}}`, 404},
+		{"other org", "gus", "/projects/web/members", `{"roles":{"dan":"viewer"}}`, 404},
+		{"missing project", "ann", "/projects/nope/members", `{"roles":{"dan":"viewer"}}`, 404},
+		{"contributor", "ben", "/projects/web/members", `{"roles":{"dan":"viewer"}}`, 403},
+		{"viewer", "dan", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin", "eve", "/projects/web/members", `{"roles":{"dan":"viewer"}}`, 403},
+		{"archived", "ann", "/projects/legacy/members", `{"roles":{"ben":"viewer"}}`, 409},
+		{"bad json", "ann", "/projects/web/members", `nope`, 400},
+		{"no roles", "ann", "/projects/web/members", `{}`, 400},
+		{"empty roles", "ann", "/projects/web/members", `{"roles":{}}`, 400},
+		{"invalid role", "ann", "/projects/web/members", `{"roles":{"dan":"admin"}}`, 400},
+		{"empty role", "ann", "/projects/web/members", `{"roles":{"dan":""}}`, 400},
+		{"non member target", "ann", "/projects/web/members", `{"roles":{"hal":"viewer"}}`, 400},
+		{"other org target", "ann", "/projects/web/members", `{"roles":{"gus":"viewer"}}`, 400},
+		{"removes last manager", "ivy", "/projects/ops/members", `{"roles":{"ivy":"viewer"}}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestBulkRolesAllOrNothing(t *testing.T) {
+	h := newServer()
+	before := dbRoles(t, h, "web")
+	// dan is valid, hal is not a member: nothing may change, including dan.
+	code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor","hal":"viewer"}}`)
+	if code != 400 {
+		t.Fatalf("got %d", code)
+	}
+	if after := dbRoles(t, h, "web"); !reflect.DeepEqual(before, after) {
+		t.Fatalf("changed: %v -> %v", before, after)
+	}
+	if a := taskAssignee(t, h, "t1"); a != "ben" {
+		t.Fatalf("t1 assignee changed to %q", a)
+	}
+}
+
+func TestBulkRolesLastManagerAllOrNothing(t *testing.T) {
+	h := newServer()
+	before := dbRoles(t, h, "ops")
+	code, _ := do(t, h, "PUT", "/projects/ops/members", "ivy", `{"roles":{"cat":"viewer","ivy":"contributor"}}`)
+	if code != 409 {
+		t.Fatalf("got %d", code)
+	}
+	if after := dbRoles(t, h, "ops"); !reflect.DeepEqual(before, after) {
+		t.Fatalf("changed: %v -> %v", before, after)
+	}
+}
+
+func TestBulkRolesSwapManagers(t *testing.T) {
+	// Handing the manager role over is fine as long as a manager remains.
+	h := newServer()
+	code, _ := do(t, h, "PUT", "/projects/ops/members", "ivy", `{"roles":{"cat":"manager","ivy":"viewer"}}`)
+	if code != 200 {
+		t.Fatalf("got %d", code)
+	}
+}
