@@ -118,3 +118,53 @@ func loadDeleteTask(x *tx, taskID string) (*deleteTaskAggregate, error) {
 func (a *deleteTaskAggregate) validate() error { return nil }
 
 func (a *deleteTaskAggregate) apply(x *tx) { a.task.Destroy(x) }
+
+// moveMemberAggregate moves one member from a source project to a target
+// project, keeping the role. The member leaves the source project.
+type moveMemberAggregate struct {
+	from     membershipRecord  // the member's membership in the source project
+	to       projectRecord     // the target project
+	user     userRecord        // the member
+	existing *membershipRecord // the member's membership in the target, if any
+	assigned []taskRecord      // tasks the member holds in the source project
+}
+
+func loadMoveMember(x *tx, fromProjectID, userID, toProjectID string) (*moveMemberAggregate, error) {
+	from, ok := x.findMembership(fromProjectID, userID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	u, ok := x.findUser(userID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	to, ok := x.findProject(toProjectID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	a := &moveMemberAggregate{from: from, to: to, user: u, assigned: from.AssignedTasks(x)}
+	if m, ok := to.Membership(x, userID); ok {
+		a.existing = &m
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.user.Org != a.to.Org {
+		return deny(ErrInvalid, "member must belong to the target project's organization")
+	}
+	if a.existing != nil {
+		return deny(ErrConflict, "user is already a member of the target project")
+	}
+	if len(a.assigned) > 0 {
+		return deny(ErrConflict, "user still has assigned tasks in this project; reassign them first")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(x *tx) MemberView {
+	a.from.Destroy(x)
+	m := membershipRecord{ProjectID: a.to.ID, UserID: a.from.UserID, Role: a.from.Role}
+	m.save(x)
+	return MemberView{UserID: m.UserID, ProjectID: m.ProjectID, Role: m.Role}
+}
