index 0000000..6ed8af1
--- /dev/null
+++ b/internal/capability/member.go
@@ -0,0 +1,99 @@
+package capability
+
+// Member capabilities. Moving a member is the one operation that touches two
+// projects: the source (the scope's project) and the target. The target is
+// reached through the same actor and gets the same rules applied to it.
+//
+//	ProjectScope -> Member(uid) MemberScope -> Manage() ManageMember -> MoveTo(pid) MemberView
+
+// MemberView is the public representation of a project membership.
+type MemberView struct {
+	UserID    string `json:"userId"`
+	ProjectID string `json:"projectId"`
+	Role      string `json:"role"`
+}
+
+// MemberScope is bound to one actor, one project ID and one user ID.
+type MemberScope interface {
+	Manage() (ManageMember, error)
+}
+
+// ManageMember may move one member out of the project.
+type ManageMember interface {
+	// MoveTo moves the member to toProjectID with the same role. The member
+	// leaves the source project. The actor must manage the target project too.
+	MoveTo(toProjectID string) (MemberView, error)
+}
+
+type memberScope struct {
+	ps  *projectScope
+	uid string
+}
+
+func (s *projectScope) Member(userID string) MemberScope {
+	return &memberScope{ps: s, uid: userID}
+}
+
+// Manage applies the manager rule to the source project: readable (else 404),
+// manager (else 403), not archived (else 409), and the user is a member of it
+// (else 404).
+func (s *memberScope) Manage() (ManageMember, error) {
+	err := s.ps.as.a.db.view(func(x *tx) error {
+		p, r, err := readable(x, s.ps.as.actor, s.ps.pid)
+		if err != nil {
+			return err
+		}
+		if r != RoleManager {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if p.Archived {
+			return deny(ErrArchived, "project is archived")
+		}
+		if _, ok := x.findMembership(s.ps.pid, s.uid); !ok {
+			return deny(ErrNotFound, "not found")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &manageMember{ms: s}, nil
+}
+
+type manageMember struct{ ms *memberScope }
+
+// MoveTo checks the target with the same read rule as any project (else 404),
+// manager (else 403) and not archived (else 409), then moves the membership in
+// one transaction through moveMemberAggregate.
+func (m *manageMember) MoveTo(toProjectID string) (MemberView, error) {
+	if toProjectID == "" {
+		return MemberView{}, deny(ErrInvalid, "toProjectId is required")
+	}
+	if toProjectID == m.ms.ps.pid {
+		return MemberView{}, deny(ErrInvalid, "member is already in that project")
+	}
+	act := m.ms.ps.as.actor
+	var v MemberView
+	err := m.ms.ps.as.a.db.update(func(x *tx) error {
+		tp, tr, err := readable(x, act, toProjectID)
+		if err != nil {
+			return err
+		}
+		if tr != RoleManager {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if tp.Archived {
+			return deny(ErrArchived, "project is archived")
+		}
+		agg, err := loadMoveMember(x, m.ms.ps.pid, m.ms.uid, toProjectID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		v = agg.apply(x)
+		return nil
+	})
+	return v, err
+}
