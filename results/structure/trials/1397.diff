+// transferUserAggregate moves one user from the organization in the path to
+// another organization.
+type transferUserAggregate struct {
+	user        *User
+	fromOrg     string
+	toOrg       *Org          // nil when the target organization does not exist
+	memberships []*Membership // the user's project memberships; must be none
+	in          UserTableTransferInput
+}
+
+func loadTransferUser(ctx context.Context, tx DB, fromOrg string, in UserTableTransferInput) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, in.UserID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != fromOrg {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	a := &transferUserAggregate{user: u, fromOrg: fromOrg, in: in}
+	o, err := NewOrgTable().Find(ctx, tx, in.ToOrgID)
+	if err != nil && !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	a.toOrg = o
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	a.memberships = ms
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if a.toOrg == nil || a.toOrg.ID == a.fromOrg {
+		return deny(ErrInvalid, "toOrgId must be another existing organization")
+	}
+	if len(a.memberships) > 0 {
+		return deny(ErrInvalid, "user has project memberships; they cannot be transferred")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	if err := a.user.transfer(ctx, tx, a.toOrg.ID); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
