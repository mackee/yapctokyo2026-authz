+// OrgAuthz is what the actor may do in one organization.
+type OrgAuthz struct {
+	actor Actor
+	org   string
+}
+
+// OrgID returns the organization the object is bound to.
+func (a OrgAuthz) OrgID() string { return a.org }
+
+// CanManageUsers returns nil if the actor may remove users from the
+// organization's projects: org admins of the organization only (else
+// ErrForbidden). Call it after NewOrgAuthz has bound the object to the actor's
+// own organization.
+func (a OrgAuthz) CanManageUsers() error {
+	if a.org == "" || !a.actor.orgAdmin {
+		return deny(ErrForbidden, "only org admins may remove users from the organization")
+	}
+	return nil
+}
