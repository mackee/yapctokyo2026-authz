+func TestRemoveUserFromOrg(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/cat", 204},
+		{"manager", "ann", "/orgs/acme/users/cat", 403},
+		{"contributor", "ben", "/orgs/acme/users/cat", 403},
+		{"viewer", "dan", "/orgs/acme/users/cat", 403},
+		{"non member of org", "hal", "/orgs/acme/users/cat", 403},
+		{"anonymous", "", "/orgs/acme/users/cat", 401},
+		{"unknown user", "zed", "/orgs/acme/users/cat", 401},
+		{"other org admin", "gus", "/orgs/acme/users/cat", 404},
+		{"other org", "eve", "/orgs/globex/users/gus", 404},
+		{"no such org", "eve", "/orgs/nope/users/cat", 404},
+		{"user in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"no such user", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
