+// ---- operations -----------------------------------------------------------------------
+
+// RemoveFromOrg removes the user from every project of the organization (the
+// offboarding step when someone leaves) and unassigns the tasks the user held in
+// those projects. Only org admins of the organization may do it (else
+// ErrForbidden); a user who is not in the organization is ErrNotFound. Archived
+// projects are included: leaving the user in them would keep their access.
+// A user with no projects in the organization is a no-op.
+func (*UserTable) RemoveFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanManageUsers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveUserFromOrg(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
