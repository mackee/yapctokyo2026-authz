+func TestRemoveUserFromOrgEffects(t *testing.T) {
+	h := newServer()
+
+	// ben is a contributor in web and legacy (archived) and holds t1, t5.
+	if code, body := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d body=%s", code, body)
+	}
+	// Repeating it is a no-op.
+	if code, body := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("repeat remove: got %d body=%s", code, body)
+	}
+
+	// ben loses access to every project of the organization.
+	for _, path := range []string{"/projects/web/tasks", "/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		if code, _ := do(t, h, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("ben GET %s: got %d want 404", path, code)
+		}
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 404 {
+		t.Fatalf("ben POST: got %d want 404", code)
+	}
+
+	// The tasks ben held are unassigned, in active and archived projects alike.
+	for _, path := range []string{"/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		code, body := do(t, h, "GET", path, "ann", "")
+		if code != 200 {
+			t.Fatalf("ann GET %s: got %d", path, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.AssigneeID != "" {
+			t.Fatalf("%s still assigned to %q", path, task.AssigneeID)
+		}
+	}
+
+	// Other members and their tasks are untouched.
+	code, body := do(t, h, "GET", "/projects/web/tasks/t2", "ann", "")
+	if code != 200 {
+		t.Fatalf("GET t2: got %d", code)
+	}
+	var t2 Task
+	json.Unmarshal([]byte(body), &t2)
+	if t2.AssigneeID != "cat" {
+		t.Fatalf("t2 assignee changed to %q", t2.AssigneeID)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat lost access to web: got %d", code)
+	}
+}
