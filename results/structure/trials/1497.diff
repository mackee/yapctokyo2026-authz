 func (a *deleteTaskAggregate) apply(ctx context.Context, tx DB) error { return a.task.destroy(ctx, tx) }
+
+// updateMembershipAggregate changes the role of one project member.
+type updateMembershipAggregate struct {
+	membership *Membership
+	in         MembershipTableUpdateRoleInput
+	assigned   []*Task // the member's tasks in the project
+}
+
+func loadUpdateMembership(ctx context.Context, tx DB, projectID string, in MembershipTableUpdateRoleInput) (*updateMembershipAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, projectID, in.UserID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	assigned, err := m.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &updateMembershipAggregate{membership: m, in: in, assigned: assigned}, nil
+}
+
+func (a *updateMembershipAggregate) validate() error {
+	if !isWriterRole(a.in.Role) && len(a.assigned) > 0 {
+		return deny(ErrInvalid, "member has assigned tasks in the project; unassign or reassign them before making them a viewer")
+	}
+	return nil
+}
+
+func (a *updateMembershipAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.membership.setRole(ctx, tx, a.in.Role); err != nil {
+		return nil, err
+	}
+	return a.membership, nil
+}
