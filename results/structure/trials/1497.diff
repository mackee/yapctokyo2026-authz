new file mode 100644
index 0000000..1860b30
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,88 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestUpdateMember(t *testing.T) {
+	cases := []struct {
+		name, user, project, target, body string
+		want                              int
+	}{
+		{"manager promotes viewer", "ann", "web", "dan", `{"role":"contributor"}`, 200},
+		{"manager demotes member without tasks", "ann", "web", "ivy", `{"role":"viewer"}`, 200},
+		{"manager in other project", "ivy", "ops", "ann", `{"role":"contributor"}`, 200},
+		{"demote member with assigned task", "ann", "web", "ben", `{"role":"viewer"}`, 400},
+		{"contributor", "ben", "web", "dan", `{"role":"contributor"}`, 403},
+		{"viewer", "dan", "web", "ben", `{"role":"viewer"}`, 403},
+		{"manager in other project is viewer", "ann", "ops", "ivy", `{"role":"viewer"}`, 403},
+		{"org admin", "eve", "web", "dan", `{"role":"contributor"}`, 403},
+		{"non member", "hal", "web", "dan", `{"role":"contributor"}`, 404},
+		{"other org", "gus", "web", "dan", `{"role":"contributor"}`, 404},
+		{"anonymous", "", "web", "dan", `{"role":"contributor"}`, 401},
+		{"unknown project", "ann", "nope", "dan", `{"role":"contributor"}`, 404},
+		{"archived", "ann", "legacy", "ben", `{"role":"viewer"}`, 409},
+		{"target not a member", "ann", "web", "hal", `{"role":"contributor"}`, 404},
+		{"target member of other project only", "ivy", "ops", "ben", `{"role":"contributor"}`, 404},
+		{"invalid role", "ann", "web", "dan", `{"role":"admin"}`, 400},
+		{"missing role", "ann", "web", "dan", `{}`, 400},
+		{"malformed body", "ann", "web", "dan", `{"role":`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			path := "/projects/" + c.project + "/members/" + c.target
+			code, _ := do(t, newServer(), "PUT", path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["userId"] != "dan" || got["role"] != "contributor" || len(got) != 2 {
+		t.Fatalf("got body %s", body)
+	}
+}
+
+func TestUpdateMemberTakesEffect(t *testing.T) {
+	s := newServer()
+
+	// dan is a viewer at the start: cannot create tasks.
+	if code, _ := do(t, s, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 403 {
+		t.Fatalf("viewer create: got %d want 403", code)
+	}
+	if code, _ := do(t, s, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`); code != 200 {
+		t.Fatalf("promote: got %d want 200", code)
+	}
+	if code, _ := do(t, s, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("contributor create: got %d want 200", code)
+	}
+	if code, _ := do(t, s, "PUT", "/projects/web/members/dan", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote: got %d want 200", code)
+	}
+	if code, _ := do(t, s, "POST", "/projects/web/tasks", "dan", `{"title":"y"}`); code != 403 {
+		t.Fatalf("demoted create: got %d want 403", code)
+	}
+}
+
+func TestUpdateMemberRejectedChangeChangesNothing(t *testing.T) {
+	s := newServer()
+
+	if code, _ := do(t, s, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 400 {
+		t.Fatalf("demote with assigned task: got %d want 400", code)
+	}
+	// ben is still a contributor, so he can still edit his own task t1.
+	if code, _ := do(t, s, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ben edit after rejected demotion: got %d want 200", code)
+	}
+}
