+// MembershipTableUpdateRoleInput is the input of MembershipTable.UpdateRole.
+type MembershipTableUpdateRoleInput struct {
+	UserID string // the member whose role changes; must already be a member
+	Role   string // manager, contributor or viewer
+}
+
+// UpdateRole changes the role of a member of the project. Managers only. A
+// member with tasks assigned in the project cannot become a viewer (ErrInvalid):
+// assignees must be contributors or managers.
+func (mt *MembershipTable) UpdateRole(ctx context.Context, db DB, authz ProjectAuthz, in MembershipTableUpdateRoleInput) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if !isKnownRole(in.Role) {
+		return nil, deny(ErrInvalid, "role must be manager, contributor or viewer")
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadUpdateMembership(ctx, tx, authz.ProjectID(), in)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if m, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
+
+func isKnownRole(role string) bool { return isWriterRole(role) || role == RoleViewer }
+
