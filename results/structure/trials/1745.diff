diff --git a/internal/model/user_table.go b/internal/model/user_table.go
index 4905832..0e4b824 100644
--- a/internal/model/user_table.go
+++ b/internal/model/user_table.go
@@ -2,9 +2,29 @@ package model
 
 import "context"
 
-// UserTable reads the users table.
+// UserTable is the users table. Find reads rows; RemoveFromOrg serves the API.
 type UserTable struct{}
 
+// RemoveFromOrg removes the user from the organization (offboarding): the user
+// leaves every project of the organization and their tasks become unassigned,
+// all or nothing. The user row stays. Removing a user with no memberships is a
+// no-op. ErrNotFound if the user does not exist in the organization.
+func (*UserTable) RemoveFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanManageUsers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveUser(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
+
 // NewUserTable returns the users table.
 func NewUserTable() *UserTable { return &UserTable{} }
 
