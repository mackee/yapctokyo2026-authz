+func TestRemoveUserFromOrg(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes user without memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"project manager", "ann", "/orgs/acme/users/ben", 403},
+		{"plain member", "dan", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"other org caller", "gus", "/orgs/acme/users/ben", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ben", 404},
+		{"org of another org", "eve", "/orgs/globex/users/gus", 404},
+		{"user of another org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveUserFromOrgEffects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d", code)
+	}
+
+	// ben lost access to every project he belonged to, archived ones included.
+	for _, p := range []string{"web", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ben", ""); code != 404 {
+			t.Fatalf("ben still reads %s: %d", p, code)
+		}
+	}
+
+	// Other members are untouched.
+	for _, c := range []struct{ user, project string }{
+		{"ann", "web"}, {"cat", "web"}, {"dan", "web"}, {"ann", "legacy"}, {"cat", "ops"},
+	} {
+		if code, _ := do(t, h, "GET", "/projects/"+c.project+"/tasks", c.user, ""); code != 200 {
+			t.Fatalf("%s lost %s: %d", c.user, c.project, code)
+		}
+	}
+
+	// Tasks assigned to ben (t1 in web, t5 in archived legacy) no longer point at
+	// a non-member; other assignments are kept.
+	want := map[string]string{"t1": "", "t2": "cat", "t3": ""}
+	_, body := do(t, h, "GET", "/projects/web/tasks", "ann", "")
+	var tasks []Task
+	if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+		t.Fatal(err)
+	}
+	for _, task := range tasks {
+		if task.AssigneeID != want[task.ID] {
+			t.Fatalf("task %s assignee %q, want %q", task.ID, task.AssigneeID, want[task.ID])
+		}
+	}
+	_, body = do(t, h, "GET", "/projects/legacy/tasks/t5", "ann", "")
+	var t5 Task
+	if err := json.Unmarshal([]byte(body), &t5); err != nil {
+		t.Fatal(err)
+	}
+	if t5.AssigneeID != "" {
+		t.Fatalf("t5 still assigned to %q", t5.AssigneeID)
+	}
+	_, body = do(t, h, "GET", "/projects/ops/tasks/t4", "ann", "")
+	var t4 Task
+	if err := json.Unmarshal([]byte(body), &t4); err != nil {
+		t.Fatal(err)
+	}
+	if t4.AssigneeID != "cat" {
+		t.Fatalf("t4 assignee %q, want cat", t4.AssigneeID)
+	}
+
+	// Removing again is idempotent.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("second remove: got %d", code)
+	}
+}
