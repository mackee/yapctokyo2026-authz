@@ -0,0 +1,82 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestRemoveOrgMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown user", "zed", "/orgs/acme/users/ben", 401},
+		{"manager is not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"contributor is not org admin", "ben", "/orgs/acme/users/cat", 403},
+		{"org admin of another org", "gus", "/orgs/acme/users/ben", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ben", 404},
+		{"unknown target user", "eve", "/orgs/acme/users/zed", 404},
+		{"target in another org", "eve", "/orgs/acme/users/gus", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgMemberRemovesMembershipsAndAssignments(t *testing.T) {
+	h := newServer()
+
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+
+	// ben is out of every acme project, archived ones included.
+	for _, path := range []string{"/projects/web/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, h, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("ben GET %s: got %d want 404", path, code)
+		}
+	}
+
+	// Tasks ben was assigned to are unassigned rather than left pointing at a non-member.
+	for _, path := range []string{"/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		code, body := do(t, h, "GET", path, "ann", "")
+		if code != 200 {
+			t.Fatalf("ann GET %s: got %d want 200", path, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.Assignee != "" {
+			t.Fatalf("%s: assignee is %q, want unassigned", path, task.Assignee)
+		}
+	}
+
+	// Other members and other organizations are untouched.
+	code, body := do(t, h, "GET", "/projects/web/tasks/t2", "ann", "")
+	if code != 200 {
+		t.Fatalf("ann GET t2: got %d want 200", code)
+	}
+	var t2 Task
+	if err := json.Unmarshal([]byte(body), &t2); err != nil {
+		t.Fatal(err)
+	}
+	if t2.Assignee != "cat" {
+		t.Fatalf("t2 assignee is %q, want cat", t2.Assignee)
+	}
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatalf("gus GET gx tasks: got %d want 200", code)
+	}
+
+	// Removing an already removed member is still a 204.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("second remove: got %d want 204", code)
+	}
+}
