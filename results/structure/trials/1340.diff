+      members' = members.keys().exclude(Set((p, target))).mapBy(k => members.get(k)),
+      tasks' = tasks.keys().mapBy(k => {
+        val x = tasks.get(k)
+        if (x.project == p and x.assignee == target) { ...x, assignee: "" } else x
+      }),
+      nextTask' = nextTask,
