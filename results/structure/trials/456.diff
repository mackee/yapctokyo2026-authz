+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes user with no memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"org admin removes self", "eve", "/orgs/acme/users/eve", 204},
+		{"manager is not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"viewer is not org admin", "dan", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"caller in other org", "gus", "/orgs/acme/users/ben", 404},
+		{"admin of other org", "eve", "/orgs/globex/users/gus", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ben", 404},
+		{"target missing", "eve", "/orgs/acme/users/zed", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserRemovesAllMemberships(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("delete: got %d: %s", code, body)
+	}
+
+	// ben was a contributor in web and legacy; both must now hide the project.
+	for _, path := range []string{"/projects/web/tasks", "/projects/legacy/tasks", "/projects/web/tasks/t1"} {
+		if code, _ := do(t, h, "GET", path, "ben", ""); code != 404 {
+			t.Errorf("GET %s as removed user: got %d want 404", path, code)
+		}
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 404 {
+		t.Errorf("POST as removed user: got %d want 404", code)
+	}
+
+	// Other members of the same projects keep their access.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Errorf("cat lost access to web: got %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/legacy/tasks", "ann", ""); code != 200 {
+		t.Errorf("ann lost access to legacy: got %d", code)
+	}
+
+	// Removing a user twice is harmless.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Errorf("second delete: got %d want 204", code)
+	}
+}
+
+func TestRemoveOrgUserLeavesOtherMembershipsIntact(t *testing.T) {
+	h := newServer()
+	// ivy is a manager in web and ops; removing ann must not touch ivy.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ann", "eve", ""); code != 204 {
+		t.Fatalf("delete: got %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ann", ""); code != 404 {
+		t.Errorf("ann still sees web: got %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "ivy", ""); code != 200 {
+		t.Errorf("ivy lost ops: got %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ivy", ""); code != 200 {
+		t.Errorf("ivy lost web: got %d", code)
+	}
+}
