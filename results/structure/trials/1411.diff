+// Move moves the task to another project and returns it. The actor must be a
+// manager of both projects (CanManage on the task, CanReceive on the target); the
+// task keeps its ID, title, status and assignee.
+func (*TaskTable) Move(ctx context.Context, db DB, authz TaskAuthz, toProjectID string) (*Task, error) {
+	if err := authz.CanManage(); err != nil {
+		return nil, err
+	}
+	var t *Task
+	if err := inTx(ctx, db, func(tx DB) error {
+		dst, err := NewProjectAuthz(ctx, tx, authz.Project().Actor(), toProjectID)
+		if err != nil {
+			return err
+		}
+		if err := dst.CanReceive(); err != nil {
+			return err
+		}
+		agg, err := loadMoveTask(ctx, tx, authz.TaskID(), toProjectID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if t, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return t, nil
+}
