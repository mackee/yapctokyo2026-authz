+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager of both", "ivy", "/projects/web/tasks/t2/move", `{"toProjectId":"ops"}`, 200},
+		{"unassigned task", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 200},
+		{"assignee not in target", "ivy", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 400},
+		{"viewer in target", "ann", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 403},
+		{"contributor in source", "ben", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"archived source", "ann", "/projects/legacy/tasks/t5/move", `{"toProjectId":"web"}`, 409},
+		{"archived target", "ann", "/projects/web/tasks/t3/move", `{"toProjectId":"legacy"}`, 409},
+		{"other org target", "ann", "/projects/web/tasks/t3/move", `{"toProjectId":"gx"}`, 404},
+		{"missing target", "ann", "/projects/web/tasks/t3/move", `{"toProjectId":"nope"}`, 404},
+		{"cross project task", "ivy", "/projects/web/tasks/t4/move", `{"toProjectId":"ops"}`, 404},
+		{"unknown user", "zed", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 401},
+		{"missing field", "ivy", "/projects/web/tasks/t3/move", `{}`, 400},
+		{"bad json", "ivy", "/projects/web/tasks/t3/move", `{`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsTask(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got Task
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", AssigneeID: "cat"}
+	if got != want {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t2", "ivy", ""); code != 404 {
+		t.Fatalf("old project still has the task: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks/t2", "ivy", ""); code != 200 {
+		t.Fatalf("new project does not have the task: %d", code)
+	}
+}
