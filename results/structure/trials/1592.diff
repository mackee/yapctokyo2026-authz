+// freezeProjectAggregate turns every member of one project into a viewer.
+type freezeProjectAggregate struct {
+	project *Project
+	members []*Membership
+	tasks   []*Task // the project's tasks; assigned ones lose their assignee
+}
+
+func loadFreezeProject(ctx context.Context, tx DB, projectID string) (*freezeProjectAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	members, err := p.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	tasks, err := p.Tasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &freezeProjectAggregate{project: p, members: members, tasks: tasks}, nil
+}
+
+func (a *freezeProjectAggregate) validate() error {
+	if a.project.Archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	return nil
+}
+
+func (a *freezeProjectAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	// Viewers cannot be assignees, so clear assignees first.
+	for _, t := range a.tasks {
+		if t.AssigneeID == "" {
+			continue
+		}
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	for _, m := range a.members {
+		if err := m.setRole(ctx, tx, RoleViewer); err != nil {
+			return nil, err
+		}
+	}
+	return a.members, nil
+}
+
