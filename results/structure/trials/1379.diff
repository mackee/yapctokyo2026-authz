+// Remove removes the user from the project and unassigns the user's tasks in
+// the project, all or nothing. A user who is not a member of the project is
+// ErrNotFound; otherwise the actor must be a manager of an unarchived project
+// (CanManageMembers).
+func (*MembershipTable) Remove(ctx context.Context, db DB, authz ProjectAuthz, userID string) error {
+	if !authz.CanRead() {
+		return deny(ErrNotFound, "not found")
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveMember(ctx, tx, authz.ProjectID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := authz.CanManageMembers(); err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
