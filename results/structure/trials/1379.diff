+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager", "ann", "/projects/web/members/dan", 204},
+		{"manager removes contributor", "ann", "/projects/web/members/ben", 204},
+		{"contributor", "ben", "/projects/web/members/cat", 403},
+		{"viewer", "dan", "/projects/web/members/cat", 403},
+		{"org admin without role", "eve", "/projects/ops/members/cat", 403},
+		{"non member", "hal", "/projects/web/members/cat", 404},
+		{"other org", "gus", "/projects/web/members/cat", 404},
+		{"anonymous", "", "/projects/web/members/cat", 401},
+		{"unknown user", "zed", "/projects/web/members/cat", 401},
+		{"target not a member", "ann", "/projects/web/members/hal", 404},
+		{"target in other org", "ann", "/projects/web/members/gus", 404},
+		{"target unknown", "ann", "/projects/web/members/zed", 404},
+		{"archived", "ann", "/projects/legacy/members/ben", 409},
+		{"missing project", "ann", "/projects/missing/members/ben", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveMemberEffects(t *testing.T) {
+	srv := newServer()
+	getTask := func(path string) Task {
+		t.Helper()
+		code, body := do(t, srv, "GET", path, "ann", "")
+		if code != 200 {
+			t.Fatalf("GET %s: got %d", path, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		return task
+	}
+
+	// ben is assigned t1 in web and t5 in legacy.
+	if code, _ := do(t, srv, "DELETE", "/projects/web/members/ben", "ann", ""); code != 204 {
+		t.Fatalf("remove ben from web: got %d want 204", code)
+	}
+
+	// The removed member loses access to the project.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("removed member reads web: got %d want 404", code)
+	}
+
+	// Tasks assigned to the removed member in that project are unassigned.
+	if got := getTask("/projects/web/tasks/t1").AssigneeID; got != "" {
+		t.Fatalf("t1 assignee = %q, want unassigned", got)
+	}
+	// Other tasks in the project are untouched.
+	if got := getTask("/projects/web/tasks/t2").AssigneeID; got != "cat" {
+		t.Fatalf("t2 assignee = %q, want cat", got)
+	}
+
+	// Membership in another project is untouched.
+	if got := getTask("/projects/legacy/tasks/t5").AssigneeID; got != "ben" {
+		t.Fatalf("legacy t5 assignee = %q, want ben", got)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/legacy/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben reads legacy after removal from web: got %d want 200", code)
+	}
+
+	// Removing again: no longer a member, so 404.
+	if code, _ := do(t, srv, "DELETE", "/projects/web/members/ben", "ann", ""); code != 404 {
+		t.Fatalf("second removal: got %d want 404", code)
+	}
+}
