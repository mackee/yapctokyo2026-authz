+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager", "ann", "/projects/web/freeze", 200},
+		{"contributor", "ben", "/projects/web/freeze", 403},
+		{"viewer", "dan", "/projects/web/freeze", 403},
+		{"org admin", "eve", "/projects/web/freeze", 403},
+		{"non member", "hal", "/projects/web/freeze", 404},
+		{"other org", "gus", "/projects/web/freeze", 404},
+		{"missing project", "ann", "/projects/nope/freeze", 404},
+		{"anonymous", "", "/projects/web/freeze", 401},
+		{"archived", "ann", "/projects/legacy/freeze", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResult(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got []memberRole
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []string{"ann", "ben", "cat", "dan", "ivy"}
+	if len(got) != len(want) {
+		t.Fatalf("got %v", got)
+	}
+	for i, m := range got {
+		if m.UserID != want[i] || m.Role != "viewer" {
+			t.Fatalf("got %v", got)
+		}
+	}
+
+	// Nobody can change tasks of the frozen project, managers included.
+	writes := []struct{ method, path, user, body string }{
+		{"POST", "/projects/web/tasks", "ann", `{"title":"x"}`},
+		{"POST", "/projects/web/tasks", "ivy", `{"title":"x"}`},
+		{"PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`},
+		{"PATCH", "/projects/web/tasks/t3", "ann", `{"status":"done"}`},
+		{"DELETE", "/projects/web/tasks/t1", "ann", ""},
+		{"POST", "/projects/web/freeze", "ann", ""},
+	}
+	for _, w := range writes {
+		if code, _ := do(t, h, w.method, w.path, w.user, w.body); code != 403 {
+			t.Errorf("%s %s as %s: got %d want 403", w.method, w.path, w.user, code)
+		}
+	}
+
+	// Tasks are still readable, and unassigned (model: inv_assigneeIsWriter).
+	code, body = do(t, h, "GET", "/projects/web/tasks", "dan", "")
+	if code != 200 {
+		t.Fatal(code)
+	}
+	var tasks []Task
+	if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+		t.Fatal(err)
+	}
+	if len(tasks) != 3 {
+		t.Fatalf("got %d tasks", len(tasks))
+	}
+	for _, tk := range tasks {
+		if tk.Assignee != "" {
+			t.Errorf("%s still assigned to %s", tk.ID, tk.Assignee)
+		}
+	}
+}
+
+func TestFreezeOnlyThatProject(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatal(code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ops should be unaffected, got %d", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/ops/freeze", "ivy", ""); code != 200 {
+		t.Fatalf("ivy is still ops manager, got %d", code)
+	}
+}
