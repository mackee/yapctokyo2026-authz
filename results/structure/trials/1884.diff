@@ -0,0 +1,99 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestMoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager of both moves", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 200},
+		{"viewer can be moved", "ivy", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 200},
+		{"anonymous", "", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 401},
+		{"unknown user", "zed", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 401},
+		{"non member caller", "hal", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"other org caller", "gus", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"missing source project", "ivy", "/projects/nope/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"contributor caller", "ben", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer caller", "dan", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin caller", "eve", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"manager of source only", "ann", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"target not member of source", "ivy", "/projects/web/members/hal/move", `{"toProjectId":"ops"}`, 404},
+		{"missing target project", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"nope"}`, 404},
+		{"target in other org", "ann", "/projects/web/members/ben/move", `{"toProjectId":"gx"}`, 404},
+		{"already member of target", "ivy", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 409},
+		{"archived source", "ann", "/projects/legacy/members/ben/move", `{"toProjectId":"web"}`, 409},
+		{"archived target", "ann", "/projects/web/members/dan/move", `{"toProjectId":"legacy"}`, 409},
+		{"same project", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"web"}`, 400},
+		{"empty target", "ivy", "/projects/web/members/ben/move", `{"toProjectId":""}`, 400},
+		{"bad body", "ivy", "/projects/web/members/ben/move", `nope`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d (%s)", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestMoveMemberResult(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d (%s)", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]string{"userId": "ben", "projectId": "ops", "role": "contributor"}
+	if len(got) != len(want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	for k, v := range want {
+		if got[k] != v {
+			t.Fatalf("got %v want %v", got, want)
+		}
+	}
+
+	app := h.(*appHandler)
+	var role string
+	if err := app.db.QueryRow(`SELECT role FROM memberships WHERE project_id='ops' AND user_id='ben'`).Scan(&role); err != nil || role != "contributor" {
+		t.Fatalf("ben in ops: role %q err %v", role, err)
+	}
+	var n int
+	app.db.QueryRow(`SELECT COUNT(*) FROM memberships WHERE project_id='web' AND user_id='ben'`).Scan(&n)
+	if n != 0 {
+		t.Fatal("ben is still a member of web")
+	}
+	// Ben's task in web stays there but loses its assignee (model rule).
+	var project, assignee string
+	app.db.QueryRow(`SELECT project_id, assignee FROM tasks WHERE id='t1'`).Scan(&project, &assignee)
+	if project != "web" || assignee != "" {
+		t.Fatalf("t1: project %q assignee %q", project, assignee)
+	}
+	// Other members' tasks are untouched.
+	app.db.QueryRow(`SELECT assignee FROM tasks WHERE id='t2'`).Scan(&assignee)
+	if assignee != "cat" {
+		t.Fatalf("t2 assignee %q", assignee)
+	}
+}
+
+func TestMoveMemberRejectedChangesNothing(t *testing.T) {
+	h := newServer()
+	code, _ := do(t, h, "POST", "/projects/web/members/cat/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 409 {
+		t.Fatalf("got %d", code)
+	}
+	app := h.(*appHandler)
+	var n int
+	app.db.QueryRow(`SELECT COUNT(*) FROM memberships WHERE project_id='web' AND user_id='cat'`).Scan(&n)
+	if n != 1 {
+		t.Fatal("cat was removed from web despite rejection")
+	}
+}
