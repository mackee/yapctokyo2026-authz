+// RemoveUserFromOrg removes the user from every project of the organization
+// (the user leaves the organization). It is all-or-nothing: if any of those
+// memberships is in an archived project, nothing changes (ErrArchived).
+// Removing a user who has no memberships there succeeds.
+func (*MembershipTable) RemoveUserFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanManageMembers(); err != nil {
+		return err
+	}
+	return db.update(ctx, func(x *Tx) error {
+		agg, err := loadRemoveUserFromOrg(ctx, x, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, x)
+	})
+}
