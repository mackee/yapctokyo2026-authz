+func TestRemoveUserFromOrgEffects(t *testing.T) {
+	t.Run("removes memberships and unassigns tasks in every project", func(t *testing.T) {
+		h := newServer()
+		if code, body := do(t, h, "DELETE", "/orgs/acme/users/cat", "eve", ""); code != 204 {
+			t.Fatalf("delete: got %d %s", code, body)
+		}
+		// cat is no longer a member of web or ops.
+		for _, p := range []string{"web", "ops"} {
+			if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "cat", ""); code != 404 {
+				t.Fatalf("cat in %s: got %d want 404", p, code)
+			}
+		}
+		// Tasks cat was assigned to are unassigned (web t2, ops t4).
+		for _, path := range []string{"/projects/web/tasks/t2", "/projects/ops/tasks/t4"} {
+			code, body := do(t, h, "GET", path, "ann", "")
+			if code != 200 {
+				t.Fatalf("GET %s: got %d", path, code)
+			}
+			var task Task
+			if err := json.Unmarshal([]byte(body), &task); err != nil {
+				t.Fatal(err)
+			}
+			if task.AssigneeID != "" {
+				t.Fatalf("%s still assigned to %q", path, task.AssigneeID)
+			}
+		}
+		// Other members are untouched.
+		if code, _ := do(t, h, "GET", "/projects/web/tasks", "ivy", ""); code != 200 {
+			t.Fatalf("ivy in web: got %d want 200", code)
+		}
+	})
+
+	t.Run("archived membership changes nothing", func(t *testing.T) {
+		h := newServer()
+		if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 409 {
+			t.Fatalf("delete: got %d want 409", code)
+		}
+		// ben keeps the web membership and the task assignment t1.
+		code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+		if code != 200 {
+			t.Fatalf("got %d", code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.AssigneeID != "ben" {
+			t.Fatalf("t1 assignee %q, want ben", task.AssigneeID)
+		}
+		if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+			t.Fatalf("ben in web: got %d want 200", code)
+		}
+	})
+}
