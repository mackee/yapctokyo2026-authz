+// removeUserFromOrgAggregate removes one user from every project of one
+// organization. Tasks the user is assigned to in those projects are unassigned,
+// so no task is left with an assignee who is no longer a member.
+type removeUserFromOrgAggregate struct {
+	memberships []*Membership // the user's memberships in the organization's projects
+	projects    map[string]*Project
+}
+
+func loadRemoveUserFromOrg(ctx context.Context, x *Tx, orgID, userID string) (*removeUserFromOrgAggregate, error) {
+	u, err := NewUserTable().Find(ctx, x, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != orgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	all, err := u.Memberships(ctx, x)
+	if err != nil {
+		return nil, err
+	}
+	a := &removeUserFromOrgAggregate{projects: map[string]*Project{}}
+	for _, m := range all {
+		p, err := m.Project(ctx, x)
+		if errors.Is(err, ErrNoRows) {
+			continue
+		} else if err != nil {
+			return nil, err
+		}
+		if p.Org != orgID {
+			continue
+		}
+		a.projects[p.ID] = p
+		a.memberships = append(a.memberships, m)
+	}
+	return a, nil
+}
+
+// validate rejects the change if any of the memberships is in an archived
+// project: archived projects reject all writes (README).
+func (a *removeUserFromOrgAggregate) validate() error {
+	for _, m := range a.memberships {
+		if a.projects[m.ProjectID].Archived {
+			return deny(ErrArchived, "project is archived")
+		}
+	}
+	return nil
+}
+
+func (a *removeUserFromOrgAggregate) apply(ctx context.Context, x *Tx) error {
+	for _, m := range a.memberships {
+		tasks, err := m.AssignedTasks(ctx, x)
+		if err != nil {
+			return err
+		}
+		for _, t := range tasks {
+			if err := t.unassign(ctx, x); err != nil {
+				return err
+			}
+		}
+		if err := m.remove(ctx, x); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
