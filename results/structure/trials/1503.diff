+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes contributor", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes viewer", "eve", "/orgs/acme/users/dan", 204},
+		{"org admin removes user without projects", "eve", "/orgs/acme/users/hal", 204},
+		{"manager of a project", "ann", "/orgs/acme/users/ben", 403},
+		{"org member without roles", "hal", "/orgs/acme/users/ben", 403},
+		{"other org", "gus", "/orgs/acme/users/ben", 404},
+		{"org not found", "eve", "/orgs/nope/users/ben", 404},
+		{"user in another org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed", 404},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+// assigneesOf returns the assignee of every task in the project, read as user
+// u (who must be able to read the project).
+func assigneesOf(t *testing.T, h http.Handler, u, project string) map[string]string {
+	t.Helper()
+	code, body := do(t, h, "GET", "/projects/"+project+"/tasks", u, "")
+	if code != 200 {
+		t.Fatalf("list %s as %s: got %d", project, u, code)
+	}
+	var tasks []Task
+	if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+		t.Fatal(err)
+	}
+	out := map[string]string{}
+	for _, task := range tasks {
+		out[task.ID] = task.AssigneeID
+	}
+	return out
+}
+
+func TestRemoveOrgUserClearsProjectsAndAssignments(t *testing.T) {
+	h := newServer()
+
+	// cat is a contributor of web (t2 assigned) and ops (t4 assigned).
+	if code, body := do(t, h, "DELETE", "/orgs/acme/users/cat", "eve", ""); code != 204 || body != "" {
+		t.Fatalf("remove cat: got %d %q", code, body)
+	}
+	web := assigneesOf(t, h, "ann", "web")
+	if web["t2"] != "" {
+		t.Fatalf("t2 still assigned to %q", web["t2"])
+	}
+	if web["t1"] != "ben" {
+		t.Fatalf("t1 changed to %q, want ben", web["t1"])
+	}
+	if ops := assigneesOf(t, h, "eve", "ops"); ops["t4"] != "" {
+		t.Fatalf("t4 still assigned to %q", ops["t4"])
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 404 {
+		t.Fatalf("cat still reads web: got %d", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/ops/tasks", "cat", `{"title":"x"}`); code != 404 {
+		t.Fatalf("cat still writes ops: got %d", code)
+	}
+
+	// ben is a contributor of web (t1 assigned) and of the archived legacy
+	// project (t5 assigned). Removal goes through even though legacy is archived.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove ben: got %d", code)
+	}
+	if web := assigneesOf(t, h, "ann", "web"); web["t1"] != "" {
+		t.Fatalf("t1 still assigned to %q", web["t1"])
+	}
+	if legacy := assigneesOf(t, h, "ann", "legacy"); legacy["t5"] != "" {
+		t.Fatalf("t5 still assigned to %q", legacy["t5"])
+	}
+	if code, _ := do(t, h, "GET", "/projects/legacy/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben still reads legacy: got %d", code)
+	}
+
+	// Removing again is still 204: there is nothing left to remove.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove ben again: got %d", code)
+	}
+
+	// Other members are untouched: ivy still manages web, and ben's own
+	// membership in ops never existed, so ops is unchanged for ann.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ivy", ""); code != 200 {
+		t.Fatalf("ivy lost web: got %d", code)
+	}
+	if ops := assigneesOf(t, h, "ann", "ops"); len(ops) != 1 {
+		t.Fatalf("ops tasks changed: %v", ops)
+	}
+}
