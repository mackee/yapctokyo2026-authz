+// setMemberRolesAggregate changes the roles of several members of one project.
+// Every target must already be a member; the change is all or nothing.
+type setMemberRolesAggregate struct {
+	changes []memberRoleChange
+}
+
+type memberRoleChange struct {
+	member *Membership
+	role   string
+}
+
+func loadSetMemberRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*setMemberRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "members must belong to an existing project")
+	} else if err != nil {
+		return nil, err
+	}
+	// Sorted, so the same request always fails on the same user.
+	userIDs := make([]string, 0, len(roles))
+	for id := range roles {
+		userIDs = append(userIDs, id)
+	}
+	sort.Strings(userIDs)
+	a := &setMemberRolesAggregate{}
+	for _, id := range userIDs {
+		m, err := p.Membership(ctx, tx, id)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "user "+id+" is not a member of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		a.changes = append(a.changes, memberRoleChange{member: m, role: roles[id]})
+	}
+	return a, nil
+}
+
+func (a *setMemberRolesAggregate) validate() error {
+	for _, c := range a.changes {
+		if !isProjectRole(c.role) {
+			return deny(ErrInvalid, "role must be manager, contributor or viewer")
+		}
+	}
+	return nil
+}
+
+func (a *setMemberRolesAggregate) apply(ctx context.Context, tx DB) error {
+	for _, c := range a.changes {
+		if err := c.member.setRole(ctx, tx, c.role); err != nil {
+			return err
+		}
+	}
+	return nil
+}
