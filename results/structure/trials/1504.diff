+
+// RemoveFromOrg removes the user from every project of the organization (the
+// authorization object's): the memberships there are deleted, and the tasks the
+// user holds in those projects are unassigned. It runs in one transaction. The
+// user row itself is kept. Archived projects are included: removing a member
+// is offboarding, not a task write.
+func (*UserTable) RemoveFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanManageMembers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveUser(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
