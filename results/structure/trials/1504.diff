+// removeUserAggregate removes one user from every project of one organization.
+type removeUserAggregate struct {
+	user        *User
+	memberships []*Membership // the user's memberships in the organization's projects
+	unassign    []*Task       // the tasks of those projects assigned to the user
+}
+
+func loadRemoveUser(ctx context.Context, tx DB, org, userID string) (*removeUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != org {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	all, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	a := &removeUserAggregate{user: u}
+	for _, m := range all {
+		p, err := m.Project(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		if p.Org != org {
+			continue
+		}
+		a.memberships = append(a.memberships, m)
+		tasks, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.unassign = append(a.unassign, tasks...)
+	}
+	return a, nil
+}
+
+// validate needs no check: every task the user holds in the organization's
+// projects is unassigned in apply, so no task is left with a non-member assignee.
+func (a *removeUserAggregate) validate() error { return nil }
+
+func (a *removeUserAggregate) apply(ctx context.Context, tx DB) error {
+	for _, t := range a.unassign {
+		if err := t.unassign(ctx, tx); err != nil {
+			return err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
