diff --git a/org_test.go b/org_test.go
new file mode 100644
index 0000000..d758d89
--- /dev/null
+++ b/org_test.go
@@ -0,0 +1,115 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"testing"
+)
+
+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/cat", 204},
+		{"org admin, user in archived project", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin, user in no project", "eve", "/orgs/acme/users/hal", 204},
+		{"not org admin", "ann", "/orgs/acme/users/cat", 403},
+		{"member without role", "hal", "/orgs/acme/users/cat", 403},
+		{"other org", "gus", "/orgs/acme/users/cat", 404},
+		{"unknown org", "eve", "/orgs/nope/users/cat", 404},
+		{"user of another org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown user", "eve", "/orgs/acme/users/nobody", 404},
+		{"anonymous", "", "/orgs/acme/users/cat", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/cat", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+// taskAssignees lists the project's tasks as ann and returns their assignees by task ID.
+func taskAssignees(t *testing.T, h http.Handler, project string) map[string]string {
+	t.Helper()
+	code, body := do(t, h, "GET", "/projects/"+project+"/tasks", "ann", "")
+	if code != 200 {
+		t.Fatalf("list %s: got %d", project, code)
+	}
+	var tasks []Task
+	if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+		t.Fatal(err)
+	}
+	out := map[string]string{}
+	for _, task := range tasks {
+		out[task.ID] = task.AssigneeID
+	}
+	return out
+}
+
+func TestRemoveOrgUserDetachesFromAllOrgProjects(t *testing.T) {
+	h := newServer()
+
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove ben: got %d", code)
+	}
+
+	// ben's tasks in web and in the archived legacy project are unassigned.
+	web := taskAssignees(t, h, "web")
+	if web["t1"] != "" {
+		t.Fatalf("t1 still assigned to %q", web["t1"])
+	}
+	if web["t2"] != "cat" {
+		t.Fatalf("t2 changed to %q, want cat", web["t2"])
+	}
+	if legacy := taskAssignees(t, h, "legacy"); legacy["t5"] != "" {
+		t.Fatalf("t5 still assigned to %q", legacy["t5"])
+	}
+
+	// ben is no longer a member of web, legacy, or any project of acme.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads web: got %d want 404", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/legacy/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads legacy: got %d want 404", code)
+	}
+
+	// Other members are untouched.
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat reads ops: got %d want 200", code)
+	}
+
+	// Removing again is still 204.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("second remove: got %d want 204", code)
+	}
+}
+
+func TestRemoveOrgUserOnlyTouchesOrgProjects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ivy", "eve", ""); code != 204 {
+		t.Fatalf("remove ivy: got %d", code)
+	}
+	// ivy's memberships in acme's web and ops are gone, so her manager role no longer
+	// lets her write there.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ivy", `{"title":"x"}`); code != 404 {
+		t.Fatalf("ivy writes web: got %d want 404", code)
+	}
+}
+
+func TestRemoveOrgUserForbiddenLeavesDataAlone(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "ann", ""); code != 403 {
+		t.Fatalf("ann removes ben: got %d want 403", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t1", "ben", ""); code != 200 {
+		t.Fatalf("ben still reads web: got %d want 200", code)
+	}
+	if web := taskAssignees(t, h, "web"); web["t1"] != "ben" {
+		t.Fatalf("t1 assignee = %q, want ben", web["t1"])
+	}
+}
