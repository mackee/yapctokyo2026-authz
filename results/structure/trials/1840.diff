+// ---- PUT /projects/{pid}/members ----------------------------------------------------
+
+// memberRole is one entry of the PUT /projects/{pid}/members response.
+type memberRole struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// membersSnapshot returns the project's memberships as "user=role" pairs in user
+// order, read straight from the database behind h.
+func membersSnapshot(t *testing.T, h http.Handler, projectID string) string {
+	t.Helper()
+	app := h.(*appHandler)
+	rows, err := app.db.Query(`SELECT user_id, role FROM memberships WHERE project_id = ? ORDER BY user_id`, projectID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer rows.Close()
+	var parts []string
+	for rows.Next() {
+		var user, role string
+		if err := rows.Scan(&user, &role); err != nil {
+			t.Fatal(err)
+		}
+		parts = append(parts, user+"="+role)
+	}
+	if err := rows.Err(); err != nil {
+		t.Fatal(err)
+	}
+	return strings.Join(parts, ",")
+}
+
+func TestUpdateMembersSuccess(t *testing.T) {
+	h := newServer()
+	before := membersSnapshot(t, h, "web")
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"manager","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []memberRole
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("response is not a member list: %v: %s", err, body)
+	}
+	// The response is the project's member list after the change, in user order.
+	want := []memberRole{
+		{"ann", "manager"}, {"ben", "manager"}, {"cat", "contributor"}, {"dan", "contributor"}, {"ivy", "manager"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("response members:\n got %v\nwant %v", got, want)
+	}
+	if after, want := membersSnapshot(t, h, "web"), "ann=manager,ben=manager,cat=contributor,dan=contributor,ivy=manager"; after != want {
+		t.Fatalf("stored roles:\n got %q\nwant %q (before %q)", after, want, before)
+	}
+}
+
+func TestUpdateMembersRejects(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		// Access rules: role changes need a manager of a live project.
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"ben":"contributor"}}`, 403},
+		{"org admin not a member", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"unknown project", "ann", "nope", `{"roles":{"dan":"contributor"}}`, 404},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"manager"}}`, 409},
+		// Body rules: checked before any access decision.
+		{"unknown role", "ann", "web", `{"roles":{"dan":"contributor","ben":"owner"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"bad json", "ann", "web", `{"roles":`, 400},
+		// Target rules: every user must already be a member, and the change must keep the model rules.
+		{"non member target", "ann", "web", `{"roles":{"dan":"contributor","hal":"viewer"}}`, 400},
+		{"unknown user target", "ann", "web", `{"roles":{"dan":"contributor","zed":"viewer"}}`, 400},
+		{"demote assignee", "ann", "web", `{"roles":{"dan":"contributor","ben":"viewer"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			before := membersSnapshot(t, h, c.project)
+			code, body := do(t, h, "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+			if after := membersSnapshot(t, h, c.project); after != before {
+				t.Fatalf("rejected request changed roles:\n before %q\n after  %q", before, after)
+			}
+		})
+	}
+}
