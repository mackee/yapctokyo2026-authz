+// setRolesAggregate changes the roles of several members of one project.
+type setRolesAggregate struct {
+	changes []roleChange // ordered by user ID
+}
+
+// roleChange is one member's new role, with the tasks assigned to the member in
+// the project (the rules for those tasks' assignees apply to the new role).
+type roleChange struct {
+	member        *Membership
+	role          string
+	assignedTasks []*Task
+}
+
+func loadSetRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*setRolesAggregate, error) {
+	userIDs := make([]string, 0, len(roles))
+	for userID := range roles {
+		userIDs = append(userIDs, userID)
+	}
+	sort.Strings(userIDs)
+	a := &setRolesAggregate{}
+	for _, userID := range userIDs {
+		m, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, fmt.Sprintf("%s is not a member of the project", userID))
+		} else if err != nil {
+			return nil, err
+		}
+		assigned, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.changes = append(a.changes, roleChange{member: m, role: roles[userID], assignedTasks: assigned})
+	}
+	return a, nil
+}
+
+func (a *setRolesAggregate) validate() error {
+	for _, c := range a.changes {
+		if !isProjectRole(c.role) {
+			return deny(ErrInvalid, fmt.Sprintf("invalid role %q", c.role))
+		}
+		// An assignee is a contributor or manager of the task's project.
+		if !isWriterRole(c.role) && len(c.assignedTasks) > 0 {
+			return deny(ErrInvalid, fmt.Sprintf("%s has tasks assigned in the project, so the role must stay contributor or manager", c.member.UserID))
+		}
+	}
+	return nil
+}
+
+func (a *setRolesAggregate) apply(ctx context.Context, tx DB) error {
+	for _, c := range a.changes {
+		if err := c.member.setRole(ctx, tx, c.role); err != nil {
+			return err
+		}
+	}
+	return nil
+}
