-// MembershipTable reads the memberships table.
+// MembershipTable is the memberships table. Find and List* read rows; Move is
+// the API operation that moves a member to another project.
 type MembershipTable struct{}
 
 // NewMembershipTable returns the memberships table.
 func NewMembershipTable() *MembershipTable { return &MembershipTable{} }
 
+// MembershipTableMoveInput is the input of MembershipTable.Move.
+type MembershipTableMoveInput struct {
+	UserID      string // the member to move; must be a member of the authorized project
+	ToProjectID string
+}
+
+// Move moves the member from the authorized project to ToProjectID, keeping the
+// role. The actor must be a manager of both projects. The source is checked
+// with from.CanManageMembers; the target is loaded through NewProjectAuthz (so
+// an unreadable target is 404) and checked the same way.
+// Checks run in this order (it matches the Quint outcome moveOutcome):
+// source manager and not archived; member of the source (404); target differs
+// from the source (400); target readable, manager, not archived; member not
+// already in the target (409).
+func (mt *MembershipTable) Move(ctx context.Context, db DB, from ProjectAuthz, in MembershipTableMoveInput) (*Membership, error) {
+	if err := from.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	src, err := mt.Find(ctx, db, from.ProjectID(), in.UserID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if in.ToProjectID == from.ProjectID() {
+		return nil, deny(ErrInvalid, "target project must differ from the source project")
+	}
+	to, err := NewProjectAuthz(ctx, db, from.Actor(), in.ToProjectID)
+	if err != nil {
+		return nil, err
+	}
+	if err := to.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var moved *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveMember(ctx, tx, src, to.ProjectID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		moved, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return moved, nil
+}
