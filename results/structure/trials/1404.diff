+// moveMemberAggregate moves one member from the source project to the target
+// project, keeping the role. The member's tasks in the source project are
+// unassigned, since an assignee must be a member of the task's project.
+type moveMemberAggregate struct {
+	from        *Membership // the member in the source project
+	to          *Membership // the member in the target project, when already there (a conflict)
+	tasks       []*Task     // the source project's tasks assigned to the member
+	toProjectID string
+}
+
+func loadMoveMember(ctx context.Context, tx DB, from *Membership, toProjectID string) (*moveMemberAggregate, error) {
+	a := &moveMemberAggregate{from: from, toProjectID: toProjectID}
+	m, err := NewMembershipTable().Find(ctx, tx, toProjectID, from.UserID)
+	if err == nil {
+		a.to = m
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	tasks, err := from.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	a.tasks = tasks
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.to != nil {
+		return deny(ErrConflict, "member is already in the target project")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.from.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	moved := &Membership{ProjectID: a.toProjectID, UserID: a.from.UserID, Role: a.from.Role}
+	if err := moved.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return moved, nil
+}
+
 // deleteTaskAggregate removes one task.
