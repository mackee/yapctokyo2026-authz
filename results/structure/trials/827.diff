+func TestFreeze(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+		{"missing project", "ann", "nope", 404},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResponseAndEffect(t *testing.T) {
+	srv := newServer()
+	code, body := do(t, srv, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("freeze got %d: %s", code, body)
+	}
+	var members []memberRole
+	if err := json.Unmarshal([]byte(body), &members); err != nil {
+		t.Fatal(err)
+	}
+	want := []memberRole{
+		{"ann", "viewer"}, {"ben", "viewer"}, {"cat", "viewer"},
+		{"dan", "viewer"}, {"ivy", "viewer"},
+	}
+	if len(members) != len(want) {
+		t.Fatalf("got %v want %v", members, want)
+	}
+	for i := range want {
+		if members[i] != want[i] {
+			t.Fatalf("member %d: got %v want %v", i, members[i], want[i])
+		}
+	}
+
+	// Nobody can write web tasks any more, managers included.
+	writes := []struct {
+		name, method, path, user, body string
+	}{
+		{"manager patch", "PATCH", "/projects/web/tasks/t2", "ann", `{"status":"done"}`},
+		{"contributor own patch", "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`},
+		{"manager create", "POST", "/projects/web/tasks", "ivy", `{"title":"x"}`},
+		{"manager delete", "DELETE", "/projects/web/tasks/t1", "ann", ""},
+	}
+	for _, w := range writes {
+		if code, _ := do(t, srv, w.method, w.path, w.user, w.body); code != 403 {
+			t.Fatalf("%s: got %d want 403", w.name, code)
+		}
+	}
+	// Reads still work, and a frozen manager is now a viewer and cannot re-freeze.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ann", ""); code != 200 {
+		t.Fatalf("read after freeze got %d", code)
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/freeze", "ivy", ""); code != 403 {
+		t.Fatalf("re-freeze got %d want 403", code)
+	}
+	// Other projects are untouched.
+	if code, _ := do(t, srv, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ops write after web freeze got %d want 200", code)
+	}
+}
