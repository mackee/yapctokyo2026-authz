+// moveTaskAggregate moves one task into another project. The task's assignee,
+// if any, must be a contributor or manager of the destination project.
+type moveTaskAggregate struct {
+	task      *Task
+	toProject *Project
+	assignee  *Membership // the assignee's membership in the destination; nil when none
+}
+
+func loadMoveTask(ctx context.Context, tx DB, taskID, toProjectID string) (*moveTaskAggregate, error) {
+	t, err := NewTaskTable().Find(ctx, tx, taskID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	p, err := NewProjectTable().Find(ctx, tx, toProjectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveTaskAggregate{task: t, toProject: p}
+	if t.AssigneeID != "" {
+		m, err := p.Membership(ctx, tx, t.AssigneeID)
+		if err == nil {
+			a.assignee = m
+		} else if !errors.Is(err, ErrNoRows) {
+			return nil, err
+		}
+	}
+	return a, nil
+}
+
+func (a *moveTaskAggregate) validate() error {
+	if a.task.AssigneeID != "" && (a.assignee == nil || !isWriterRole(a.assignee.Role)) {
+		return deny(ErrInvalid, "assignee must be a contributor or manager of the destination project")
+	}
+	return nil
+}
+
+func (a *moveTaskAggregate) apply(ctx context.Context, tx DB) (*Task, error) {
+	if err := a.task.moveTo(ctx, tx, a.toProject.ID); err != nil {
+		return nil, err
+	}
+	return a.task, nil
+}
+
