+// CanMoveTo returns nil if the actor may move the task into the project dst:
+// the actor must be a contributor or manager of dst (else ErrForbidden, or
+// ErrArchived when dst is archived), and either the task is assigned to the
+// actor, or the actor is a manager of both projects. Call it after CanEdit,
+// which covers the source project.
+func (a TaskAuthz) CanMoveTo(dst ProjectAuthz) error {
+	if err := dst.CanWrite(); err != nil {
+		return err
+	}
+	if a.isAssignee || (a.project.role == RoleManager && dst.role == RoleManager) {
+		return nil
+	}
+	return deny(ErrForbidden, "contributors may only move tasks assigned to themselves")
+}
