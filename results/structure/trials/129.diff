+// MemberView is one member of a project and their role in it.
+type MemberView struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// ManageProject is the manager-only capability for one project.
+type ManageProject interface {
+	ReadProject
+	// Freeze freezes the project. Every member's role becomes viewer (managers
+	// included), and no task in the project can be changed afterwards. Freezing
+	// is permanent: there is no unfreeze. It returns the members after the change.
+	Freeze() ([]MemberView, error)
+}
+
+type manageProject struct{ readProject }
+
+func (p *manageProject) Freeze() ([]MemberView, error) {
+	var out []MemberView
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		pid := p.ps.pid
+		proj := s.projects[pid]
+		proj.frozen = true
+		s.projects[pid] = proj
+		for uid := range s.members[pid] {
+			s.members[pid][uid] = RoleViewer
+		}
+		out = s.membersIn(pid)
+		return nil
+	})
+	return out, err
+}
