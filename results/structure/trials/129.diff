+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"second manager", "ivy", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"manager of other project is viewer here", "ann", "ops", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"unknown project", "ann", "nope", 404},
+		{"archived", "ann", "legacy", 409},
+		{"anonymous", "", "web", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatal(code)
+	}
+	want := `[{"userId":"ann","role":"viewer"},{"userId":"ben","role":"viewer"},{"userId":"cat","role":"viewer"},{"userId":"dan","role":"viewer"},{"userId":"ivy","role":"viewer"}]`
+	if got := strings.TrimSpace(body); got != want {
+		t.Fatalf("got %s\nwant %s", got, want)
+	}
+}
+
+func TestFrozenProjectRejectsTaskWrites(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatal(code)
+	}
+
+	cases := []struct {
+		name, user, method, path, body string
+		want                           int
+	}{
+		{"contributor edits own task", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`, 409},
+		{"contributor edits other task", "cat", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`, 409},
+		{"former manager edits", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 409},
+		{"former manager reassigns", "ivy", "PATCH", "/projects/web/tasks/t3", `{"assignee":"cat"}`, 409},
+		{"former manager creates", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`, 409},
+		{"contributor creates", "ben", "POST", "/projects/web/tasks", `{"title":"x"}`, 409},
+		{"former manager deletes", "ann", "DELETE", "/projects/web/tasks/t1", "", 409},
+		{"viewer edits", "dan", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`, 409},
+		{"freeze again", "ann", "POST", "/projects/web/freeze", "", 403},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, srv, c.method, c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+
+	// Reads still work, and the task is unchanged.
+	code, body := do(t, srv, "GET", "/projects/web/tasks/t1", "dan", "")
+	if code != 200 {
+		t.Fatalf("read after freeze: got %d", code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.Status != "open" || task.Assignee != "ben" || task.Title != "Fix header" {
+		t.Fatalf("frozen task changed: %+v", task)
+	}
+}
+
+func TestFreezeIsPerProject(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatal(code)
+	}
+	code, _ := do(t, srv, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`)
+	if code != 200 {
+		t.Fatalf("other project after freeze: got %d want 200", code)
+	}
+}
+
+func TestFreezeKeepsAssignments(t *testing.T) {
+	// Freezing demotes the contributors who hold tasks. The freeze must still
+	// commit, and the assignments must stay as they were.
+	srv := newServer()
+	if code, _ := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatal(code)
+	}
+	code, body := do(t, srv, "GET", "/projects/web/tasks", "ann", "")
+	if code != 200 {
+		t.Fatal(code)
+	}
+	var tasks []Task
+	if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+		t.Fatal(err)
+	}
+	assignees := map[string]string{}
+	for _, task := range tasks {
+		assignees[task.ID] = task.Assignee
+	}
+	if assignees["t1"] != "ben" || assignees["t2"] != "cat" || assignees["t3"] != "" {
+		t.Fatalf("assignments changed: %v", assignees)
+	}
+}
