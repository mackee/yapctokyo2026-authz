+++ b/orgusers_test.go
@@ -0,0 +1,80 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestRemoveOrgUserStatuses(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes", "eve", "/orgs/acme/users/ben", 204},
+		{"user without memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"non admin", "ann", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"caller from other org", "gus", "/orgs/acme/users/ben", 404},
+		{"unknown org", "eve", "/orgs/missing/users/ben", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("got %d", code)
+	}
+	// ben lost access to every project he was in, archived ones included.
+	for _, p := range []string{"web", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ben", ""); code != 404 {
+			t.Fatalf("%s: ben still reads, got %d", p, code)
+		}
+	}
+	// His tasks are unassigned (t1 in web, t5 in archived legacy).
+	for _, c := range []struct{ project, id string }{{"web", "t1"}, {"legacy", "t5"}} {
+		code, body := do(t, h, "GET", "/projects/"+c.project+"/tasks/"+c.id, "eve", "")
+		var task Task
+		json.Unmarshal([]byte(body), &task)
+		if code != 200 || task.Assignee != "" {
+			t.Fatalf("%s: code %d assignee %q", c.id, code, task.Assignee)
+		}
+	}
+	// Others are untouched.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat lost access: %d", code)
+	}
+	_, body := do(t, h, "GET", "/projects/web/tasks/t2", "cat", "")
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "cat" {
+		t.Fatalf("t2 assignee %q", task.Assignee)
+	}
+	// Removing again is fine, and a removed user cannot be assigned any more.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("second removal got %d", code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t3", "ann", `{"assignee":"ben"}`); code != 400 {
+		t.Fatalf("assign removed user got %d", code)
+	}
+}
+
+func TestRemoveOrgUserKeepsOtherOrg(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/gus", "eve", ""); code != 404 {
+		t.Fatalf("got %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatalf("gus lost access: %d", code)
+	}
+}
