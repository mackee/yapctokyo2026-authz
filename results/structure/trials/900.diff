+func TestRemoveMemberEffects(t *testing.T) {
+	h := newServer()
+
+	// ann removes cat from web: cat's web task is unassigned, cat's ops task is kept.
+	if code, body := do(t, h, "DELETE", "/projects/web/members/cat", "ann", ""); code != 204 {
+		t.Fatalf("remove cat: got %d %s", code, body)
+	}
+	code, body := do(t, h, "GET", "/projects/web/tasks/t2", "ann", "")
+	if code != 200 {
+		t.Fatal(code)
+	}
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.AssigneeID != "" {
+		t.Fatalf("t2 still assigned to %q", task.AssigneeID)
+	}
+	code, body = do(t, h, "GET", "/projects/ops/tasks/t4", "ann", "")
+	json.Unmarshal([]byte(body), &task)
+	if code != 200 || task.AssigneeID != "cat" {
+		t.Fatalf("ops t4: got %d assignee %q, want cat kept", code, task.AssigneeID)
+	}
+
+	// cat has lost access to web but keeps it to ops.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 404 {
+		t.Fatalf("removed member reads web: got %d want 404", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat reads ops: got %d want 200", code)
+	}
+
+	// Removing again: no longer a member.
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/cat", "ann", ""); code != 404 {
+		t.Fatalf("second remove: got %d want 404", code)
+	}
+
+	// ben is removed from web only; ben's task in legacy stays assigned.
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 204 {
+		t.Fatalf("remove ben: got %d", code)
+	}
+	code, body = do(t, h, "GET", "/projects/legacy/tasks/t5", "ann", "")
+	json.Unmarshal([]byte(body), &task)
+	if code != 200 || task.AssigneeID != "ben" {
+		t.Fatalf("legacy t5: got %d assignee %q, want ben kept", code, task.AssigneeID)
+	}
+}
