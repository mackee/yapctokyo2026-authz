+// Remove removes the user from the project and unassigns the user's tasks in
+// the project, all or nothing. Only managers may remove members (else
+// ErrForbidden), and the project must not be archived (else ErrArchived). A user
+// who is not a member of the project is ErrNotFound.
+func (*MembershipTable) Remove(ctx context.Context, db DB, authz ProjectAuthz, userID string) error {
+	if err := authz.CanManageMembers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveMember(ctx, tx, authz.ProjectID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
