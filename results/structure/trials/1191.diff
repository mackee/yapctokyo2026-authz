+func TestFreeze(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"missing project", "ann", "nope", 404},
+		{"anonymous", "", "web", 401},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeEffects(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got []map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 5 {
+		t.Fatalf("want 5 members, got %v", got)
+	}
+	for _, m := range got {
+		if m["role"] != "viewer" || m["userId"] == "" || len(m) != 2 {
+			t.Fatalf("bad member %v", m)
+		}
+	}
+	// Nobody can modify tasks any more, managers included.
+	for _, u := range []string{"ann", "ivy", "ben", "cat", "dan", "eve"} {
+		if c, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", u, `{"status":"done"}`); c != 403 {
+			t.Fatalf("%s patch: got %d", u, c)
+		}
+		if c, _ := do(t, h, "POST", "/projects/web/tasks", u, `{"title":"x"}`); c != 403 {
+			t.Fatalf("%s create: got %d", u, c)
+		}
+		if c, _ := do(t, h, "DELETE", "/projects/web/tasks/t1", u, ""); c != 403 {
+			t.Fatalf("%s delete: got %d", u, c)
+		}
+	}
+	// Still readable by members, and other projects are untouched.
+	if c, _ := do(t, h, "GET", "/projects/web/tasks", "ann", ""); c != 200 {
+		t.Fatalf("read after freeze: %d", c)
+	}
+	if c, _ := do(t, h, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`); c != 200 {
+		t.Fatalf("other project: %d", c)
+	}
+	// A frozen project has no manager left, so it cannot be frozen again.
+	if c, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); c != 403 {
+		t.Fatalf("refreeze: %d", c)
+	}
+}
