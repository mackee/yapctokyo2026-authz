+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin no memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"manager not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"other org admin", "gus", "/orgs/acme/users/ben", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatal(code)
+	}
+	// ben is gone from every project, including the archived one.
+	for _, p := range []string{"web", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ben", ""); code != 404 {
+			t.Fatalf("ben still reads %s: %d", p, code)
+		}
+	}
+	// ben's tasks are unassigned; other users are untouched.
+	for id, want := range map[string]string{"t1": "", "t5": "", "t2": "cat"} {
+		p := "web"
+		if id == "t5" {
+			p = "legacy"
+		}
+		_, body := do(t, h, "GET", "/projects/"+p+"/tasks/"+id, "ann", "")
+		var task Task
+		json.Unmarshal([]byte(body), &task)
+		if task.Assignee != want {
+			t.Fatalf("task %s assignee %q want %q", id, task.Assignee, want)
+		}
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat lost access: %d", code)
+	}
+	// Other orgs are unaffected by removal in acme.
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatalf("gus lost access: %d", code)
+	}
+}
