+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/cat", 204},
+		{"non admin", "ann", "/orgs/acme/users/cat", 403},
+		{"other org admin path", "gus", "/orgs/acme/users/cat", 404},
+		{"target other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"anonymous", "", "/orgs/acme/users/cat", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatal(code)
+	}
+	// ben is gone everywhere, including the archived project.
+	for _, p := range []string{"web", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ben", ""); code != 401 {
+			t.Fatalf("%s: removed user got %d", p, code)
+		}
+	}
+	// their tasks are unassigned, and cannot be re-assigned to them.
+	_, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" {
+		t.Fatalf("assignee %q not cleared", task.Assignee)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ann", `{"assignee":"ben"}`); code != 400 {
+		t.Fatalf("reassign to removed user got %d", code)
+	}
+	// other users and other orgs are untouched.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatal(code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatal(code)
+	}
+	// removing an org admin revokes their access too.
+	do(t, h, "DELETE", "/orgs/acme/users/eve", "eve", "")
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "eve", ""); code != 401 {
+		t.Fatalf("removed admin got %d", code)
+	}
+}
