+// RemoveUserFromOrg offboards a user: drops them from every project of their
+// org (archived ones included), unassigns their tasks there, and deletes the
+// user so they can no longer authenticate (which also revokes org-admin reads).
+func (s *Store) RemoveUserFromOrg(userID string) {
+	u := s.users[userID]
+	if u == nil {
+		return
+	}
+	for _, p := range s.projects {
+		if p.OrgID != u.OrgID {
+			continue
+		}
+		delete(s.members[p.ID], userID)
+		for _, t := range s.tasks {
+			if t.ProjectID == p.ID && t.Assignee == userID {
+				t.Assignee = ""
+			}
+		}
+	}
+	delete(s.users, userID)
+}
