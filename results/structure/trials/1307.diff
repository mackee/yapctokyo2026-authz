+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes", "eve", "/orgs/acme/users/ben", 204},
+		{"manager is not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"viewer is not org admin", "dan", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"caller in other org", "gus", "/orgs/acme/users/ben", 404},
+		{"org admin, path is another org", "eve", "/orgs/globex/users/gus", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserOffboards(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+
+	// ben is gone from every acme project, the archived one included.
+	for _, path := range []string{"/projects/web/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, srv, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("ben GET %s: got %d want 404", path, code)
+		}
+	}
+	if code, _ := do(t, srv, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 404 {
+		t.Fatalf("ben PATCH: got %d want 404", code)
+	}
+
+	// ben's assignments in acme are cleared; other assignments are untouched.
+	wantAssignee := map[string]struct{ path, assignee string }{
+		"t1": {"/projects/web/tasks/t1", ""},
+		"t5": {"/projects/legacy/tasks/t5", ""},
+		"t2": {"/projects/web/tasks/t2", "cat"},
+	}
+	for id, want := range wantAssignee {
+		_, body := do(t, srv, "GET", want.path, "ann", "")
+		var task Task
+		json.Unmarshal([]byte(body), &task)
+		if task.Assignee != want.assignee {
+			t.Fatalf("task %s assignee %q, want %q", id, task.Assignee, want.assignee)
+		}
+	}
+
+	// Other members keep their access.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat GET web: got %d want 200", code)
+	}
+	// A second removal is a 404: ben is no longer in acme.
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 404 {
+		t.Fatalf("second remove: got %d want 404", code)
+	}
+}
+
+func TestRemoveOrgUserRevokesOrgAdmin(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/eve", "eve", ""); code != 204 {
+		t.Fatalf("self remove: got %d want 204", code)
+	}
+	// The removed admin can no longer read any acme project.
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "eve", ""); code != 404 {
+		t.Fatalf("eve GET ops: got %d want 404", code)
+	}
+	// ...nor remove anyone else.
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/cat", "eve", ""); code != 404 {
+		t.Fatalf("eve remove cat: got %d want 404", code)
+	}
+}
