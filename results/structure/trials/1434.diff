@@ -0,0 +1,78 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestTransferStatus(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 200},
+		{"not an admin", "ann", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 403},
+		{"other org", "gus", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 404},
+		{"user in another org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"globex"}`, 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"same org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"acme"}`, 400},
+		{"unknown org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"initech"}`, 400},
+		{"missing field", "eve", "/orgs/acme/users/ben/transfer", `{}`, 400},
+		{"bad json", "eve", "/orgs/acme/users/ben/transfer", `{`, 400},
+		{"anonymous", "", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown actor", "zed", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferEffects(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got struct{ ID, OrgID string }
+	if err := json.Unmarshal([]byte(body), &got); err != nil || got.ID != "ben" || got.OrgID != "globex" {
+		t.Fatalf("unexpected body %s", body)
+	}
+	// Memberships in the old organization are gone: ben can no longer read acme projects.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("old project readable after transfer: %d", code)
+	}
+	// Tasks assigned to ben (t1, t5) are unassigned.
+	for _, p := range []string{"/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		_, b := do(t, h, "GET", p, "ann", "")
+		var task Task
+		if err := json.Unmarshal([]byte(b), &task); err != nil || task.AssigneeID != "" {
+			t.Fatalf("%s still assigned: %s", p, b)
+		}
+	}
+	// Other users' tasks are untouched.
+	_, b := do(t, h, "GET", "/projects/web/tasks/t2", "ann", "")
+	var task Task
+	if err := json.Unmarshal([]byte(b), &task); err != nil || task.AssigneeID != "cat" {
+		t.Fatalf("t2 changed: %s", b)
+	}
+	// The moved user is no longer in acme, so eve can't transfer them again.
+	if code, _ := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 404 {
+		t.Fatalf("second transfer: %d", code)
+	}
+}
+
+func TestTransferClearsOrgAdmin(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("got %d", code)
+	}
+	// eve is a plain globex user now: not an admin there.
+	if code, _ := do(t, h, "POST", "/orgs/globex/users/gus/transfer", "eve", `{"toOrgId":"acme"}`); code != 403 {
+		t.Fatalf("former admin kept admin rights: %d", code)
+	}
+}
