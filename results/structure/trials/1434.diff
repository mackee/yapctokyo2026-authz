+// transferUserAggregate moves one user to another organization. The user's
+// memberships and assigned tasks are loaded so they can be dropped: members
+// belong to the project's organization, and assignees are project writers.
+type transferUserAggregate struct {
+	user        *User
+	from        string
+	toExists    bool
+	memberships []*Membership
+	tasks       []*Task
+	in          UserTableTransferInput
+}
+
+func loadTransferUser(ctx context.Context, tx DB, orgID string, in UserTableTransferInput) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, in.UserID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != orgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	a := &transferUserAggregate{user: u, from: u.Org, in: in}
+	if a.toExists, err = NewUserTable().OrgExists(ctx, tx, in.ToOrgID); err != nil {
+		return nil, err
+	}
+	if !a.toExists {
+		if a.toExists, err = NewProjectTable().OrgExists(ctx, tx, in.ToOrgID); err != nil {
+			return nil, err
+		}
+	}
+	if a.memberships, err = u.Memberships(ctx, tx); err != nil {
+		return nil, err
+	}
+	if a.tasks, err = u.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if a.in.ToOrgID == a.from {
+		return deny(ErrInvalid, "user already belongs to the organization")
+	}
+	if !a.toExists {
+		return deny(ErrInvalid, "unknown organization")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.user.moveTo(ctx, tx, a.in.ToOrgID); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
+
