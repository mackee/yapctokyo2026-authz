+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager moves unassigned", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 200},
+		{"manager moves assigned, assignee fits target", "ivy", "/projects/web/tasks/t2/move", `{"toProjectId":"ops"}`, 200},
+		{"assignee not in target", "ivy", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 409},
+		{"contributor source", "ben", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer source", "dan", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin source", "eve", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 403},
+		{"manager in source, viewer in target", "ann", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 403},
+		{"non member source", "hal", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 404},
+		{"other org source", "gus", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 404},
+		{"unknown source project", "ivy", "/projects/nope/tasks/t3/move", `{"toProjectId":"ops"}`, 404},
+		{"task not in source project", "ivy", "/projects/ops/tasks/t1/move", `{"toProjectId":"legacy"}`, 404},
+		{"unknown task", "ivy", "/projects/web/tasks/t99/move", `{"toProjectId":"ops"}`, 404},
+		{"archived source", "ann", "/projects/legacy/tasks/t5/move", `{"toProjectId":"web"}`, 409},
+		{"archived target", "ann", "/projects/web/tasks/t3/move", `{"toProjectId":"legacy"}`, 409},
+		{"unknown target", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"nope"}`, 404},
+		{"target in other org", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"gx"}`, 404},
+		{"target not readable", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"legacy"}`, 404},
+		{"same project", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"web"}`, 400},
+		{"missing toProjectId", "ivy", "/projects/web/tasks/t3/move", `{}`, 400},
+		{"invalid body", "ivy", "/projects/web/tasks/t3/move", `not json`, 400},
+		{"anonymous", "", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 401},
+		{"unknown user", "zed", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsTaskFields(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d want 200: %s", code, body)
+	}
+	var got Task
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("move response is not a task: %v: %s", err, body)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", Assignee: "cat"}
+	if got != want {
+		t.Fatalf("moved task = %+v, want %+v", got, want)
+	}
+
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks/t2", "ivy", ""); code != 200 {
+		t.Fatalf("GET in new project: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t2", "ivy", ""); code != 404 {
+		t.Fatalf("GET in old project: got %d want 404", code)
+	}
+}
