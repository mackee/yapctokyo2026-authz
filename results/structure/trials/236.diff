+// OrgExists reports whether any user or project belongs to the organization.
+func (s *Store) OrgExists(orgID string) bool {
+	for _, u := range s.users {
+		if u.OrgID == orgID {
+			return true
+		}
+	}
+	for _, p := range s.projects {
+		if p.OrgID == orgID {
+			return true
+		}
+	}
+	return false
+}
+
+// TransferUser moves a user to another organization. Everything that grants
+// the user access in the old org is dropped: project memberships, task
+// assignments in the old org's projects, and the org admin flag.
+func (s *Store) TransferUser(u *User, toOrgID string) {
+	for _, members := range s.members {
+		delete(members, u.ID)
+	}
+	for _, t := range s.tasks {
+		if t.Assignee == u.ID {
+			if p := s.projects[t.ProjectID]; p != nil && p.OrgID != toOrgID {
+				t.Assignee = ""
+			}
+		}
+	}
+	u.OrgID = toOrgID
+	u.OrgAdmin = false
+}
