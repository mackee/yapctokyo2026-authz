new file mode 100644
index 0000000..f3de327
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,90 @@
+package main
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, project, member, body string
+		want                              int
+	}{
+		{"manager moves contributor", "ivy", "web", "ben", `{"toProjectId":"ops"}`, 200},
+		{"manager moves viewer", "ivy", "web", "dan", `{"toProjectId":"ops"}`, 200},
+		{"contributor", "ben", "web", "cat", `{"toProjectId":"legacy"}`, 403},
+		{"viewer, destination not readable", "dan", "web", "ben", `{"toProjectId":"ops"}`, 404},
+		{"org admin", "eve", "web", "ben", `{"toProjectId":"ops"}`, 403},
+		{"manager of source, viewer of destination", "ann", "web", "cat", `{"toProjectId":"ops"}`, 403},
+		{"non member", "hal", "web", "ben", `{"toProjectId":"ops"}`, 404},
+		{"other org", "gus", "web", "ben", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "web", "ben", `{"toProjectId":"ops"}`, 401},
+		{"destination not readable", "ivy", "web", "ben", `{"toProjectId":"legacy"}`, 404},
+		{"destination in other org", "ivy", "web", "ben", `{"toProjectId":"gx"}`, 404},
+		{"destination unknown", "ivy", "web", "ben", `{"toProjectId":"nope"}`, 404},
+		{"destination archived", "ann", "web", "cat", `{"toProjectId":"legacy"}`, 409},
+		{"source archived", "ann", "legacy", "ben", `{"toProjectId":"web"}`, 409},
+		{"same project", "ivy", "web", "ben", `{"toProjectId":"web"}`, 400},
+		{"already a member of destination", "ivy", "web", "cat", `{"toProjectId":"ops"}`, 409},
+		{"not a member of source", "ivy", "web", "hal", `{"toProjectId":"ops"}`, 404},
+		{"missing destination", "ivy", "web", "ben", `{}`, 400},
+		{"malformed body", "ivy", "web", "ben", `{`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/members/"+c.member+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveResponseKeepsRole(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/members/dan/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]string{"userId": "dan", "projectId": "ops", "role": "viewer"}
+	for k, v := range want {
+		if got[k] != v {
+			t.Fatalf("field %s: got %q want %q (body %s)", k, got[k], v, body)
+		}
+	}
+	if len(got) != len(want) {
+		t.Fatalf("unexpected fields in %s", body)
+	}
+}
+
+func TestMoveEffects(t *testing.T) {
+	srv := newServer()
+
+	// ben is a contributor of web and assigned t1 there.
+	if code, body := do(t, srv, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`); code != 200 {
+		t.Fatalf("move: got %d: %s", code, body)
+	}
+
+	// ben left web: no access to it any more.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads web after move: got %d want 404", code)
+	}
+
+	// ben joined ops with the same role: may create tasks there.
+	if code, body := do(t, srv, "POST", "/projects/ops/tasks", "ben", `{"title":"x","assignee":"ben"}`); code != 200 {
+		t.Fatalf("ben creates in ops: got %d: %s", code, body)
+	}
+
+	// t1 is no longer assigned to ben, since ben is not a member of web.
+	code, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("get t1: got %d: %s", code, body)
+	}
+	if !strings.Contains(body, `"assignee":""`) {
+		t.Fatalf("t1 should be unassigned after move: %s", body)
+	}
+}
