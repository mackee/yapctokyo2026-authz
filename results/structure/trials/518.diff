+// Move moves the user from the project of from to the project of to, keeping
+// the role. The actor must be a manager of both projects. The user's tasks in
+// the source project are unassigned, since they are no longer its members.
+func (*MembershipTable) Move(ctx context.Context, db DB, from, to ProjectAuthz, userID string) (*Membership, error) {
+	if from.ProjectID() == to.ProjectID() {
+		return nil, deny(ErrInvalid, "destination must be a different project")
+	}
+	if err := from.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if err := to.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveMember(ctx, tx, from.ProjectID(), to.ProjectID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if m, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
+
