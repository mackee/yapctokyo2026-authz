+// moveMember moves {uid} from {pid} to the project named in the body. The
+// target is not in the path, so the handler builds its authorization object
+// (the Transformer only builds the source's).
+func moveMember(ctx tanukirpc.Context[*projectRegistry], req moveMemberRequest) (*model.Membership, error) {
+	reg := ctx.Registry()
