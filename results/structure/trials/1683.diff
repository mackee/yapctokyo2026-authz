diff --git a/move_member_test.go b/move_member_test.go
new file mode 100644
index 0000000..ec4d169
--- /dev/null
+++ b/move_member_test.go
@@ -0,0 +1,154 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"reflect"
+	"testing"
+)
+
+// POST /projects/{pid}/members/{uid}/move with {"toProjectId": ...} moves the
+// member to the target project with the same role; the response is
+// {"userId","projectId","role"}.
+
+func TestMoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager of both moves", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 200},
+		{"viewer keeps its role", "ivy", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 200},
+		{"manager of source, viewer of target", "ann", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"contributor of source", "cat", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin", "eve", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"target not readable", "dan", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"target missing", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"nope"}`, 404},
+		{"target in other org", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"gx"}`, 404},
+		{"source not readable", "gus", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"not a member of source", "ivy", "/projects/web/members/hal/move", `{"toProjectId":"ops"}`, 404},
+		{"already a member of target", "ivy", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 400},
+		{"same project", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"web"}`, 400},
+		{"missing target", "ivy", "/projects/web/members/ben/move", `{}`, 400},
+		{"malformed body", "ivy", "/projects/web/members/ben/move", `nope`, 400},
+		{"archived source", "ann", "/projects/legacy/members/ben/move", `{"toProjectId":"web"}`, 409},
+		{"archived target", "ann", "/projects/web/members/ben/move", `{"toProjectId":"legacy"}`, 409},
+		{"anonymous", "", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 401},
+		{"unknown user", "zed", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d (body %s)", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestMoveMemberResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200 (body %s)", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]string{"userId": "ben", "projectId": "ops", "role": "contributor"}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+}
+
+func TestMoveMemberMovesMembership(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`); code != 200 {
+		t.Fatalf("move: got %d (body %s)", code, body)
+	}
+	// ben is no longer a member of web ...
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("web as ben: got %d want 404", code)
+	}
+	// ... is a member of ops ...
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ops as ben: got %d want 200", code)
+	}
+	// ... and keeps the membership of legacy, which was not moved.
+	if code, _ := do(t, srv, "GET", "/projects/legacy/tasks/t5", "ben", ""); code != 200 {
+		t.Fatalf("legacy as ben: got %d want 200", code)
+	}
+}
+
+func TestMoveMemberKeepsRole(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/projects/web/members/dan/move", "ivy", `{"toProjectId":"ops"}`); code != 200 {
+		t.Fatalf("move: got %d (body %s)", code, body)
+	}
+	// dan was a viewer in web, so still a viewer in ops: reads yes, writes no.
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "dan", ""); code != 200 {
+		t.Fatalf("ops read as dan: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "POST", "/projects/ops/tasks", "dan", `{"title":"x"}`); code != 403 {
+		t.Fatalf("ops create as dan: got %d want 403", code)
+	}
+}
+
+func TestMoveMemberUnassignsTasksInSource(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`); code != 200 {
+		t.Fatalf("move: got %d (body %s)", code, body)
+	}
+	// t1 was assigned to ben in web; it is unassigned now, so the assignee is
+	// still a member of the task's project.
+	if got := assigneeOf(t, srv, "ann", "/projects/web/tasks/t1"); got != "" {
+		t.Fatalf("t1 assignee: got %q want unassigned", got)
+	}
+	// Tasks assigned to others in web are untouched.
+	if got := assigneeOf(t, srv, "ann", "/projects/web/tasks/t2"); got != "cat" {
+		t.Fatalf("t2 assignee: got %q want cat", got)
+	}
+}
+
+func TestMoveMemberFailureChangesNothing(t *testing.T) {
+	srv := newServer()
+	// archived target: rejected with 409
+	if code, _ := do(t, srv, "POST", "/projects/web/members/ben/move", "ann", `{"toProjectId":"legacy"}`); code != 409 {
+		t.Fatalf("archived target: got %d want 409", code)
+	}
+	// already a member of target: rejected with 400
+	if code, _ := do(t, srv, "POST", "/projects/web/members/cat/move", "ivy", `{"toProjectId":"ops"}`); code != 400 {
+		t.Fatalf("already member: got %d want 400", code)
+	}
+	// nothing changed: ben is still in web with t1, and not in ops
+	if got := assigneeOf(t, srv, "ann", "/projects/web/tasks/t1"); got != "ben" {
+		t.Fatalf("t1 assignee: got %q want ben", got)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("web as ben: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ops as ben: got %d want 404", code)
+	}
+	// cat is still a member of web, with t2
+	if got := assigneeOf(t, srv, "ann", "/projects/web/tasks/t2"); got != "cat" {
+		t.Fatalf("t2 assignee: got %q want cat", got)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("web as cat: got %d want 200", code)
+	}
+}
+
+// assigneeOf reads the task at path as user and returns its assignee ("" when
+// unassigned). It fails the test if the read fails.
+func assigneeOf(t *testing.T, h http.Handler, user, path string) string {
+	t.Helper()
+	code, body := do(t, h, "GET", path, user, "")
+	if code != 200 {
+		t.Fatalf("GET %s as %s: got %d (body %s)", path, user, code, body)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	return task.AssigneeID
+}
