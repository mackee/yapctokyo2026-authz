+// moveMemberAggregate moves one member from a source project to a target
+// project.
+type moveMemberAggregate struct {
+	from     *Membership // the member, in the source project
+	to       *Project    // the target project
+	toMember *Membership // the member's membership in the target project, if any
+}
+
+func loadMoveMember(ctx context.Context, tx DB, fromProjectID, toProjectID, userID string) (*moveMemberAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, fromProjectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	to, err := NewProjectTable().Find(ctx, tx, toProjectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveMemberAggregate{from: m, to: to}
+	tm, err := to.Membership(ctx, tx, userID)
+	if err == nil {
+		a.toMember = tm
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.toMember != nil {
+		return deny(ErrInvalid, "user is already a member of the target project")
+	}
+	return nil
+}
+
+// apply unassigns the member's tasks in the source project (so their assignees
+// stay members of their projects), removes the source membership and adds the
+// same role in the target project.
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	tasks, err := a.from.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, t := range tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.from.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	moved := a.to.newMembership(a.from.UserID, a.from.Role)
+	if err := moved.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return moved, nil
+}
