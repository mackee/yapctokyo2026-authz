+// TaskTableMoveInput is the input of TaskTable.Move.
+type TaskTableMoveInput struct {
+	ToProjectID string
+}
+
+// Move moves the task to another project. The actor must be able to manage the
+// task in its project (as for Delete) and write in the destination project; the
+// destination must be readable by the actor (else ErrNotFound). The task's
+// assignee carries over, so it must be a contributor or manager of the
+// destination (ErrInvalid), and a contributor in the destination may only move
+// tasks assigned to themselves or to nobody there.
+func (*TaskTable) Move(ctx context.Context, db DB, authz TaskAuthz, in TaskTableMoveInput) (*Task, error) {
+	if err := authz.CanManage(); err != nil {
+		return nil, err
+	}
+	if in.ToProjectID == "" || in.ToProjectID == authz.Project().ProjectID() {
+		return nil, deny(ErrInvalid, "task must move to a different project")
+	}
+	dest, err := NewProjectAuthz(ctx, db, authz.Project().Actor(), in.ToProjectID)
+	if err != nil {
+		return nil, err
+	}
+	if err := dest.CanWrite(); err != nil {
+		return nil, err
+	}
+	var t *Task
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveTask(ctx, tx, authz.TaskID(), dest.ProjectID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if err := dest.CanAssign(agg.task.AssigneeID); err != nil {
+			return err
+		}
+		if t, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return t, nil
+}
