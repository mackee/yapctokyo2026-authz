+// Member is the JSON shape of a project member.
+type Member struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+type membersUpdateRequest struct {
+	// Roles maps user IDs to their new role. Every role is checked here, so an
+	// invalid role is a 400 before any access decision.
+	Roles map[string]string `json:"roles" validate:"required,min=1,dive,oneof=manager contributor viewer"`
+}
+
+func updateMembers(ctx tanukirpc.Context[*projectRegistry], req membersUpdateRequest) ([]Member, error) {
+	reg := ctx.Registry()
+	ms, err := model.NewMembershipTable().UpdateRoles(ctx, reg.db, reg.authz, model.MembershipTableUpdateRolesInput{Roles: req.Roles})
+	if err != nil {
+		return nil, err
+	}
+	out := make([]Member, 0, len(ms))
+	for _, m := range ms {
+		out = append(out, Member{UserID: m.UserID, Role: m.Role})
+	}
+	return out, nil
+}
