+// updateMembersAggregate changes the roles of several members of one project.
+type updateMembersAggregate struct {
+	projectID string
+	members   []*Membership // the members to change, ordered by user ID
+	roles     []string      // roles[i] is the new role of members[i]
+}
+
+func loadUpdateMembers(ctx context.Context, tx DB, projectID string, in MembershipTableUpdateRolesInput) (*updateMembersAggregate, error) {
+	userIDs := make([]string, 0, len(in.Roles))
+	for uid := range in.Roles {
+		userIDs = append(userIDs, uid)
+	}
+	sort.Strings(userIDs)
+
+	a := &updateMembersAggregate{projectID: projectID}
+	for _, uid := range userIDs {
+		m, err := NewMembershipTable().Find(ctx, tx, projectID, uid)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "user "+uid+" is not a member of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		a.members = append(a.members, m)
+		a.roles = append(a.roles, in.Roles[uid])
+	}
+	return a, nil
+}
+
+func (a *updateMembersAggregate) validate() error {
+	for _, role := range a.roles {
+		if !validRoles[role] {
+			return deny(ErrInvalid, "invalid role "+role)
+		}
+	}
+	return nil
+}
+
+// apply changes the roles and returns the project's members after the change.
+func (a *updateMembersAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for i, m := range a.members {
+		if err := m.setRole(ctx, tx, a.roles[i]); err != nil {
+			return nil, err
+		}
+	}
+	return NewMembershipTable().ListByProject(ctx, tx, a.projectID)
+}
+
