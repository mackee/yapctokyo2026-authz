+func TestUpdateMembers(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager", "ann", "web", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 200},
+		{"manager sets same role", "ann", "web", `{"roles":{"cat":"contributor"}}`, 200},
+		{"manager of other project", "ivy", "ops", `{"roles":{"cat":"viewer"}}`, 200},
+		{"viewer of other project", "ann", "ops", `{"roles":{"cat":"viewer"}}`, 403},
+		{"contributor", "ben", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"ben":"viewer"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"ben":"viewer"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"ben":"viewer"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"ben":"viewer"}}`, 404},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"target not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"invalid role", "ann", "web", `{"roles":{"ben":"owner"}}`, 400},
+		{"invalid role by viewer is body error", "dan", "web", `{"roles":{"ben":"owner"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"malformed body", "ann", "web", `{"roles":`, 400},
+		{"anonymous", "", "web", `{"roles":{"ben":"viewer"}}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMembersResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann",
+		`{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []Member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []Member{
+		{UserID: "ann", Role: "manager"},
+		{UserID: "ben", Role: "viewer"},
+		{UserID: "cat", Role: "contributor"},
+		{UserID: "dan", Role: "contributor"},
+		{UserID: "ivy", Role: "manager"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %d members want %d: %s", len(got), len(want), body)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("member %d: got %+v want %+v", i, got[i], want[i])
+		}
+	}
+	// The wire keys are userId and role.
+	if !strings.Contains(body, `"userId":"ben"`) || !strings.Contains(body, `"role":"viewer"`) {
+		t.Fatalf("unexpected JSON shape: %s", body)
+	}
+}
+
+func TestUpdateMembersIsAllOrNothing(t *testing.T) {
+	srv := newServer()
+
+	// ben and dan are valid targets; hal is not a member, so the whole batch fails.
+	code, _ := do(t, srv, "PUT", "/projects/web/members", "ann",
+		`{"roles":{"ben":"viewer","dan":"contributor","hal":"viewer"}}`)
+	if code != 400 {
+		t.Fatalf("batch with a non-member: got %d want 400", code)
+	}
+
+	// A later valid update returns the members; ben and dan must still have their seed roles.
+	code, body := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"cat":"viewer"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []Member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	seed := map[string]string{"ann": "manager", "ben": "contributor", "cat": "viewer", "dan": "viewer", "ivy": "manager"}
+	for _, m := range got {
+		if seed[m.UserID] != m.Role {
+			t.Fatalf("%s: got role %q want %q (failed batch leaked): %s", m.UserID, m.Role, seed[m.UserID], body)
+		}
+	}
+}
