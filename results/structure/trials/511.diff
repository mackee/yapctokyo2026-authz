 import "context"
 
 // MembershipTable reads the memberships table.
+//
+// UpdateRoles is the API operation: it takes the database, the authorization
+// object of the project and an input, asks the authorization object whether the
+// actor may perform it, then runs its aggregate (aggregate.go) in a transaction.
 type MembershipTable struct{}
 
 // NewMembershipTable returns the memberships table.
 func NewMembershipTable() *MembershipTable { return &MembershipTable{} }
 
+// MembershipTableUpdateRolesInput is the input of MembershipTable.UpdateRoles.
+type MembershipTableUpdateRolesInput struct {
+	Roles map[string]string // user ID -> new role
+}
+
+// UpdateRoles changes the roles of several members of the project, all or
+// nothing. It returns the project's members after the change, ordered by user
+// ID. A user who is not a member of the project, or an invalid role, rejects
+// the whole update (ErrInvalid) and nothing changes.
+func (mt *MembershipTable) UpdateRoles(ctx context.Context, db DB, authz ProjectAuthz, in MembershipTableUpdateRolesInput) ([]*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if len(in.Roles) == 0 {
+		return nil, deny(ErrInvalid, "roles must not be empty")
+	}
+	for _, role := range in.Roles {
+		if !validRoles[role] {
+			return nil, deny(ErrInvalid, "invalid role "+role)
+		}
+	}
+	var out []*Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadUpdateMembers(ctx, tx, authz.ProjectID(), in)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if out, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
+
