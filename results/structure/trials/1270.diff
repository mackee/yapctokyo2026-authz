+func TestFreeze(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"archived", "ann", "legacy", 409},
+		{"missing project", "ann", "nope", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeEffects(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got []map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []string{"ann", "ben", "cat", "dan", "ivy"}
+	if len(got) != len(want) {
+		t.Fatalf("got %v", got)
+	}
+	for i, m := range got {
+		if m["userId"] != want[i] || m["role"] != "viewer" || len(m) != 2 {
+			t.Fatalf("member %d: %v", i, m)
+		}
+	}
+
+	// Nobody can change tasks any more, managers included; reads still work.
+	for _, u := range []string{"ann", "ivy", "ben", "cat"} {
+		if code, _ := do(t, h, "POST", "/projects/web/tasks", u, `{"title":"x"}`); code != 403 {
+			t.Fatalf("%s create: %d", u, code)
+		}
+		if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t3", u, `{"status":"done"}`); code != 403 {
+			t.Fatalf("%s update: %d", u, code)
+		}
+		if code, _ := do(t, h, "DELETE", "/projects/web/tasks/t3", u, ""); code != 403 {
+			t.Fatalf("%s delete: %d", u, code)
+		}
+		if code, _ := do(t, h, "GET", "/projects/web/tasks", u, ""); code != 200 {
+			t.Fatalf("%s list: %d", u, code)
+		}
+	}
+	// A second freeze has no manager left to ask for it.
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 403 {
+		t.Fatalf("refreeze: %d", code)
+	}
+
+	// Assignees would no longer be writers, so web's tasks are unassigned.
+	_, body = do(t, h, "GET", "/projects/web/tasks", "ann", "")
+	var tasks []Task
+	json.Unmarshal([]byte(body), &tasks)
+	for _, task := range tasks {
+		if task.AssigneeID != "" {
+			t.Fatalf("task %s still assigned to %s", task.ID, task.AssigneeID)
+		}
+	}
+
+	// Other projects are untouched.
+	if code, _ := do(t, h, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ops update: %d", code)
+	}
+}
