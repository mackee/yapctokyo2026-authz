+// freezeProjectAggregate turns every member of one project into a viewer.
+// Because an assignee must be a contributor or manager, the project's assigned
+// tasks are unassigned in the same transaction.
+type freezeProjectAggregate struct {
+	project *Project
+	members []*Membership // project.Memberships()
+	tasks   []*Task       // project.Tasks() that have an assignee
+}
+
+func loadFreezeProject(ctx context.Context, tx DB, projectID string) (*freezeProjectAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	members, err := p.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	all, err := p.Tasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	a := &freezeProjectAggregate{project: p, members: members}
+	for _, t := range all {
+		if t.AssigneeID != "" {
+			a.tasks = append(a.tasks, t)
+		}
+	}
+	return a, nil
+}
+
+func (a *freezeProjectAggregate) validate() error { return nil }
+
+func (a *freezeProjectAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for _, m := range a.members {
+		if err := m.demote(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	return a.members, nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
