+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager removes member", "ann", "/projects/web/members/dan", 204},
+		{"manager removes manager", "ivy", "/projects/web/members/ann", 204},
+		{"manager, member has assigned task", "ann", "/projects/web/members/ben", 400},
+		{"manager, target not a member", "ann", "/projects/web/members/hal", 404},
+		{"manager, target is org admin without role", "ann", "/projects/web/members/eve", 404},
+		{"contributor", "ben", "/projects/web/members/dan", 403},
+		{"viewer", "dan", "/projects/web/members/ben", 403},
+		{"org admin", "eve", "/projects/web/members/dan", 403},
+		{"non member caller", "hal", "/projects/web/members/dan", 404},
+		{"other org", "gus", "/projects/web/members/dan", 404},
+		{"anonymous", "", "/projects/web/members/dan", 401},
+		{"unknown user", "zed", "/projects/web/members/dan", 401},
+		{"archived, manager", "ann", "/projects/legacy/members/ben", 409},
+		{"archived, contributor", "ben", "/projects/legacy/members/ann", 403},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveMemberTakesEffect(t *testing.T) {
+	srv := newServer()
+
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "dan", ""); code != 200 {
+		t.Fatalf("before removal: dan read got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "DELETE", "/projects/web/members/dan", "ann", ""); code != 204 {
+		t.Fatalf("remove dan: got %d want 204", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "dan", ""); code != 404 {
+		t.Fatalf("after removal: dan read got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "DELETE", "/projects/web/members/dan", "ann", ""); code != 404 {
+		t.Fatalf("remove dan again: got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ann", ""); code != 200 {
+		t.Fatalf("other members unaffected: ann read got %d want 200", code)
+	}
+}
+
+func TestRemoveMemberWithAssignedTaskChangesNothing(t *testing.T) {
+	srv := newServer()
+
+	if code, _ := do(t, srv, "DELETE", "/projects/web/members/ben", "ann", ""); code != 400 {
+		t.Fatalf("remove ben: got %d want 400", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks/t1", "ben", ""); code != 200 {
+		t.Fatalf("ben still a member: read got %d want 200", code)
+	}
+	if code, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ann", ""); code != 200 || !strings.Contains(body, `"assignee":"ben"`) {
+		t.Fatalf("t1 still assigned to ben: got %d %s", code, body)
+	}
+}
