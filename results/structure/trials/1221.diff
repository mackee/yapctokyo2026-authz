+// removeMemberAggregate removes one user's membership in one project.
+type removeMemberAggregate struct {
+	membership *Membership
+	assigned   []*Task // the member's tasks in the project; must be empty
+}
+
+func loadRemoveMember(ctx context.Context, tx DB, projectID, userID string) (*removeMemberAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	tasks, err := m.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &removeMemberAggregate{membership: m, assigned: tasks}, nil
+}
+
+func (a *removeMemberAggregate) validate() error {
+	// An assignee must be a contributor or manager of the task's project, so a
+	// member with assigned tasks cannot leave the project.
+	if len(a.assigned) > 0 {
+		return deny(ErrInvalid, "member still has tasks assigned in the project")
+	}
+	return nil
+}
+
+func (a *removeMemberAggregate) apply(ctx context.Context, tx DB) error {
+	return a.membership.destroy(ctx, tx)
+}
+
