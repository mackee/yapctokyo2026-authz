+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager removes viewer", "ann", "/projects/web/members/dan", 204},
+		{"manager removes contributor", "ivy", "/projects/web/members/ben", 204},
+		{"manager removes manager", "ivy", "/projects/web/members/ann", 204},
+		{"contributor cannot", "ben", "/projects/web/members/dan", 403},
+		{"viewer cannot", "dan", "/projects/web/members/ben", 403},
+		{"org admin cannot", "eve", "/projects/web/members/dan", 403},
+		{"non member", "hal", "/projects/web/members/dan", 404},
+		{"other org", "gus", "/projects/web/members/ann", 404},
+		{"anonymous", "", "/projects/web/members/dan", 401},
+		{"unknown user", "zed", "/projects/web/members/dan", 401},
+		{"project missing", "ann", "/projects/nope/members/dan", 404},
+		{"target not a member", "ann", "/projects/web/members/hal", 404},
+		{"archived", "ann", "/projects/legacy/members/ben", 409},
+		{"archived non manager", "ben", "/projects/legacy/members/ann", 403},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d (body %q)", code, c.want, body)
+			}
+			if code == 204 && body != "" {
+				t.Fatalf("204 must have no body, got %q", body)
+			}
+		})
+	}
+}
+
+func TestRemoveMemberTakesEffect(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "dan", ""); code != 200 {
+		t.Fatalf("before removal: dan read web got %d want 200", code)
+	}
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/dan", "ann", ""); code != 204 {
+		t.Fatalf("remove dan: got %d want 204", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "dan", ""); code != 404 {
+		t.Fatalf("after removal: dan read web got %d want 404", code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "dan", `{"status":"done"}`); code != 404 {
+		t.Fatalf("after removal: dan patch got %d want 404", code)
+	}
+	// Removing dan must not touch other memberships.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben still in web: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "ann", ""); code != 200 {
+		t.Fatalf("ann still in ops: got %d want 200", code)
+	}
+	// Removing the same member again is a 404: they are no longer a member.
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/dan", "ann", ""); code != 404 {
+		t.Fatalf("second removal: got %d want 404", code)
+	}
+}
+
+func TestRemoveMemberScopedToProject(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/cat", "ann", ""); code != 204 {
+		t.Fatalf("remove cat from web: got %d want 204", code)
+	}
+	// cat's contributor role in ops is unaffected.
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat still in ops: got %d want 200", code)
+	}
+}
