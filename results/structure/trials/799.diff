+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestUpdateRoles(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"one invalid role rejects the batch", "ann", "/projects/web/members", `{"roles":{"dan":"contributor","cat":"viewer2"}}`, 400},
+		{"manager promotes viewer", "ann", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 200},
+		{"manager demotes member without tasks", "ivy", "/projects/ops/members", `{"roles":{"ann":"viewer"}}`, 200},
+		{"manager demotes self", "ivy", "/projects/web/members", `{"roles":{"ivy":"contributor"}}`, 200},
+		{"demote assignee to viewer", "ann", "/projects/web/members", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 400},
+		{"non-member user", "ann", "/projects/web/members", `{"roles":{"hal":"viewer"}}`, 400},
+		{"invalid role", "ann", "/projects/web/members", `{"roles":{"dan":"owner"}}`, 400},
+		{"empty roles", "ann", "/projects/web/members", `{"roles":{}}`, 400},
+		{"contributor", "ben", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin", "eve", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 403},
+		{"archived", "ann", "/projects/legacy/members", `{"roles":{"ben":"manager"}}`, 409},
+		{"not readable", "hal", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "ann", "/projects/gx/members", `{"roles":{"gus":"viewer"}}`, 404},
+		{"unauthenticated", "", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestUpdateRolesResponseAndAtomicity(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	for _, want := range []string{`{"userId":"ann","role":"manager"}`, `{"userId":"dan","role":"contributor"}`, `{"userId":"ben","role":"contributor"}`} {
+		if !strings.Contains(body, want) {
+			t.Fatalf("missing %s in %s", want, body)
+		}
+	}
+
+	// A failing entry (ben has tasks) must leave the valid one (cat -> viewer is
+	// also blocked, so use ivy) unchanged.
+	h = newServer()
+	if code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ivy":"viewer","ben":"viewer"}}`); code != 400 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	// ivy is still a manager: may delete a task.
+	if code, body := do(t, h, "DELETE", "/projects/web/tasks/t3", "ivy", ""); code != 204 {
+		t.Fatalf("ivy should still be manager: got %d body=%s", code, body)
+	}
+}
