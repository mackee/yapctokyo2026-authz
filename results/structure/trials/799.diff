+// updateRolesAggregate changes the roles of several members of one project.
+type updateRolesAggregate struct {
+	members []*Membership // the targeted memberships, ordered by user ID
+	roles   map[string]string
+	// assigned[userID] reports whether the member has tasks assigned in the project.
+	assigned map[string]bool
+}
+
+func loadUpdateRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*updateRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	all, err := p.Memberships(ctx, tx) // ordered by user ID
+	if err != nil {
+		return nil, err
+	}
+	a := &updateRolesAggregate{roles: roles, assigned: map[string]bool{}}
+	found := 0
+	for _, m := range all {
+		if _, ok := roles[m.UserID]; !ok {
+			continue
+		}
+		found++
+		a.members = append(a.members, m)
+		tasks, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.assigned[m.UserID] = len(tasks) > 0
+	}
+	if found != len(roles) {
+		return nil, deny(ErrInvalid, "every user must be a member of the project")
+	}
+	return a, nil
+}
+
+func (a *updateRolesAggregate) validate() error {
+	for _, m := range a.members {
+		role := a.roles[m.UserID]
+		switch role {
+		case RoleManager, RoleContributor, RoleViewer:
+		default:
+			return deny(ErrInvalid, "invalid role")
+		}
+		if !isWriterRole(role) && a.assigned[m.UserID] {
+			return deny(ErrInvalid, "assignee must be a contributor or manager of the project")
+		}
+	}
+	return nil
+}
+
+func (a *updateRolesAggregate) apply(ctx context.Context, tx DB) error {
+	for _, m := range a.members {
+		if err := m.changeRole(ctx, tx, a.roles[m.UserID]); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
