+func TestChangeRoles(t *testing.T) {
+	const path = "/projects/web/members"
+	t.Run("returns members and unassigns demoted writers", func(t *testing.T) {
+		h := newServer()
+		code, body := do(t, h, "PUT", path, "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+		if code != 200 {
+			t.Fatalf("got %d body=%s", code, body)
+		}
+		var got []map[string]string
+		if err := json.Unmarshal([]byte(body), &got); err != nil {
+			t.Fatal(err)
+		}
+		roles := map[string]string{}
+		for _, m := range got {
+			roles[m["userId"]] = m["role"]
+		}
+		want := map[string]string{"ann": "manager", "ben": "viewer", "cat": "contributor", "dan": "contributor", "ivy": "manager"}
+		if len(roles) != len(want) {
+			t.Fatalf("members = %v", roles)
+		}
+		for u, r := range want {
+			if roles[u] != r {
+				t.Fatalf("%s = %q want %q (%s)", u, roles[u], r, body)
+			}
+		}
+		_, task := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+		if !strings.Contains(task, `"assignee":""`) {
+			t.Fatalf("t1 should be unassigned: %s", task)
+		}
+	})
+	denied := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"contributor", "ben", path, `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", path, `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin", "eve", path, `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", path, `{"roles":{"dan":"contributor"}}`, 404},
+		{"unauthenticated", "", path, `{"roles":{"dan":"contributor"}}`, 401},
+		{"archived", "ann", "/projects/legacy/members", `{"roles":{"ben":"viewer"}}`, 409},
+		{"invalid role", "ann", path, `{"roles":{"dan":"boss"}}`, 400},
+		{"empty roles", "ann", path, `{"roles":{}}`, 400},
+		{"non member target", "ann", path, `{"roles":{"hal":"viewer"}}`, 400},
+		{"other org user", "ann", path, `{"roles":{"gus":"viewer"}}`, 400},
+	}
+	for _, c := range denied {
+		t.Run(c.name, func(t *testing.T) {
+			if code, body := do(t, newServer(), "PUT", c.path, c.user, c.body); code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+	t.Run("one failure changes nothing", func(t *testing.T) {
+		h := newServer()
+		if code, _ := do(t, h, "PUT", path, "ann", `{"roles":{"dan":"manager","hal":"viewer"}}`); code != 400 {
+			t.Fatalf("got %d", code)
+		}
+		// dan is still a viewer: cannot create tasks
+		if code, _ := do(t, h, "POST", path[:len(path)-len("members")]+"tasks", "dan", `{"title":"x"}`); code != 403 {
+			t.Fatalf("dan was changed: %d", code)
+		}
+	})
+}
