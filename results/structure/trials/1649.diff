diff --git a/move_test.go b/move_test.go
new file mode 100644
index 0000000..5218101
--- /dev/null
+++ b/move_test.go
@@ -0,0 +1,90 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+// POST /projects/{pid}/tasks/{tid}/move with {"toProjectId": ...} moves the
+// task to another project and returns it with 200. ID, title, status and
+// assignee are kept.
+
+func TestMoveCases(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager moves with assignee in target", "ivy", "/projects/web/tasks/t2/move", `{"toProjectId":"ops"}`, 200},
+		{"manager moves unassigned task", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 200},
+		{"assignee not a writer in target", "ivy", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 400},
+		{"contributor cannot move", "cat", "/projects/web/tasks/t2/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer cannot move", "dan", "/projects/web/tasks/t2/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin cannot move", "eve", "/projects/web/tasks/t2/move", `{"toProjectId":"ops"}`, 403},
+		{"non member of source", "hal", "/projects/web/tasks/t2/move", `{"toProjectId":"ops"}`, 404},
+		{"task in other project", "ivy", "/projects/ops/tasks/t1/move", `{"toProjectId":"web"}`, 404},
+		{"target missing", "ann", "/projects/web/tasks/t3/move", `{"toProjectId":"nope"}`, 404},
+		{"target in other org", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"gx"}`, 404},
+		{"target readable but viewer only", "ann", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 403},
+		{"target archived", "ann", "/projects/web/tasks/t3/move", `{"toProjectId":"legacy"}`, 409},
+		{"source archived", "ann", "/projects/legacy/tasks/t5/move", `{"toProjectId":"web"}`, 409},
+		{"same project", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"web"}`, 400},
+		{"missing target field", "ivy", "/projects/web/tasks/t3/move", `{}`, 400},
+		{"empty target field", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":""}`, 400},
+		{"malformed body", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":`, 400},
+		{"anonymous", "", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveReturnsTaskKeepingFields(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got Task
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", AssigneeID: "cat"}
+	if got != want {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+}
+
+func TestMovePersists(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`); code != 200 {
+		t.Fatalf("move got %d: %s", code, body)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks/t2", "ann", ""); code != 404 {
+		t.Fatalf("old project still reads the task: got %d want 404", code)
+	}
+	code, body := do(t, srv, "GET", "/projects/ops/tasks/t2", "ann", "")
+	if code != 200 {
+		t.Fatalf("new project got %d want 200: %s", code, body)
+	}
+	var got Task
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.ProjectID != "ops" || got.AssigneeID != "cat" || got.Title != "Update footer" || got.Status != "doing" {
+		t.Fatalf("task changed unexpectedly: %+v", got)
+	}
+}
+
+func TestMoveRejectedLeavesTaskInPlace(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks/t1/move", "ivy", `{"toProjectId":"ops"}`); code != 400 {
+		t.Fatalf("move got %d want 400", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks/t1", "ann", ""); code != 200 {
+		t.Fatalf("task left its project after a rejected move: got %d", code)
+	}
+}
