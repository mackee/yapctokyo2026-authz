diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..c68b5d2
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,144 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"reflect"
+	"testing"
+)
+
+// memberRoles reads the roles of the project's members straight from the
+// database behind h, so a test can see whether a failed request changed anything.
+func memberRoles(t *testing.T, h http.Handler, projectID string) map[string]string {
+	t.Helper()
+	app, ok := h.(*appHandler)
+	if !ok {
+		t.Fatalf("memberRoles: %T is not the handler built by newServer", h)
+	}
+	rows, err := app.db.Query(`SELECT user_id, role FROM memberships WHERE project_id = ?`, projectID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer rows.Close()
+	out := map[string]string{}
+	for rows.Next() {
+		var user, role string
+		if err := rows.Scan(&user, &role); err != nil {
+			t.Fatal(err)
+		}
+		out[user] = role
+	}
+	if err := rows.Err(); err != nil {
+		t.Fatal(err)
+	}
+	return out
+}
+
+func TestUpdateMembersStatus(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager changes roles", "ann", "web", `{"roles":{"dan":"contributor","ivy":"contributor"}}`, 200},
+		{"manager promotes to manager", "ann", "web", `{"roles":{"cat":"manager"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"org admin is not a member", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"unknown project", "ann", "nope", `{"roles":{"dan":"contributor"}}`, 404},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"manager"}}`, 409},
+		{"invalid role", "ann", "web", `{"roles":{"dan":"admin"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"bad json", "ann", "web", `{"roles":`, 400},
+		{"user not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"unknown user", "ann", "web", `{"roles":{"zed":"viewer"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMembersResponse(t *testing.T) {
+	srv := newServer()
+	code, body := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"ivy":"contributor","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("response is not a list: %v: %s", err, body)
+	}
+	want := []map[string]string{
+		{"userId": "ann", "role": "manager"},
+		{"userId": "ben", "role": "contributor"},
+		{"userId": "cat", "role": "contributor"},
+		{"userId": "dan", "role": "contributor"},
+		{"userId": "ivy", "role": "contributor"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("response:\n got %v\nwant %v", got, want)
+	}
+	if roles := memberRoles(t, srv, "web"); roles["dan"] != "contributor" || roles["ivy"] != "contributor" {
+		t.Fatalf("roles not stored: %v", roles)
+	}
+}
+
+func TestUpdateMembersTakesEffect(t *testing.T) {
+	srv := newServer()
+	// dan is a viewer, so he cannot create tasks until he is promoted.
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 403 {
+		t.Fatalf("before: got %d want 403", code)
+	}
+	if code, body := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor"}}`); code != 200 {
+		t.Fatalf("promote: got %d: %s", code, body)
+	}
+	if code, body := do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("after: got %d: %s", code, body)
+	}
+}
+
+func TestUpdateMembersIsAllOrNothing(t *testing.T) {
+	cases := []struct {
+		name, body string
+	}{
+		// ben is assigned t1 in web, so demoting him to viewer breaks the
+		// assignee rule; dan's valid change must not be applied either.
+		{"assignee demoted", `{"roles":{"ben":"viewer","dan":"contributor"}}`},
+		// hal is not a member of web.
+		{"non member in the batch", `{"roles":{"dan":"contributor","hal":"viewer"}}`},
+		{"invalid role in the batch", `{"roles":{"dan":"contributor","ivy":"owner"}}`},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			srv := newServer()
+			before := memberRoles(t, srv, "web")
+			code, body := do(t, srv, "PUT", "/projects/web/members", "ann", c.body)
+			if code != 400 {
+				t.Fatalf("got %d want 400: %s", code, body)
+			}
+			if after := memberRoles(t, srv, "web"); !reflect.DeepEqual(before, after) {
+				t.Fatalf("roles changed by a failed request:\n before %v\n after  %v", before, after)
+			}
+		})
+	}
+}
+
+func TestUpdateMembersDemoteWithoutAssignedTasks(t *testing.T) {
+	// ivy has no tasks assigned in web, so she can become a viewer.
+	srv := newServer()
+	code, body := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"ivy":"viewer"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	if roles := memberRoles(t, srv, "web"); roles["ivy"] != "viewer" {
+		t.Fatalf("ivy role = %q, want viewer", roles["ivy"])
+	}
+}
