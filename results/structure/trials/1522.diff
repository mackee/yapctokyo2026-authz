+func updateMembers(ctx tanukirpc.Context[*projectRegistry], req membersRequest) ([]memberRole, error) {
+	reg := ctx.Registry()
+	ms, err := model.NewMembershipTable().UpdateRoles(ctx, reg.db, reg.authz, model.MembershipTableUpdateRolesInput{Roles: req.Roles})
+	if err != nil {
+		return nil, err
+	}
+	out := make([]memberRole, 0, len(ms))
+	for _, m := range ms {
+		out = append(out, memberRole{UserID: m.UserID, Role: m.Role})
+	}
+	return out, nil
+}
