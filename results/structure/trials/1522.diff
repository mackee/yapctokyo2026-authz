 }
 
+// updateRolesAggregate changes the roles of several members of one project, all
+// or nothing.
+type updateRolesAggregate struct {
+	members []*Membership // the members whose role changes, ordered by user ID
+	roles   []string      // roles[i] is the new role of members[i]
+	// assigned[i] holds the tasks of members[i]'s project assigned to that member;
+	// it is loaded only when the new role is not a writer role.
+	assigned [][]*Task
+}
+
+func loadUpdateRoles(ctx context.Context, tx DB, projectID string, in MembershipTableUpdateRolesInput) (*updateRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &updateRolesAggregate{}
+	for _, userID := range slices.Sorted(maps.Keys(in.Roles)) {
+		m, err := p.Membership(ctx, tx, userID)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, userID+" is not a member of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		role := in.Roles[userID]
+		var assigned []*Task
+		if !isWriterRole(role) {
+			assigned, err = m.AssignedTasks(ctx, tx)
+			if err != nil {
+				return nil, err
+			}
+		}
+		a.members = append(a.members, m)
+		a.roles = append(a.roles, role)
+		a.assigned = append(a.assigned, assigned)
+	}
+	return a, nil
+}
+
+func (a *updateRolesAggregate) validate() error {
+	for i, m := range a.members {
+		if !isWriterRole(a.roles[i]) && len(a.assigned[i]) > 0 {
+			return deny(ErrInvalid, m.UserID+" has assigned tasks in the project and must stay a contributor or manager")
+		}
+	}
+	return nil
+}
+
+func (a *updateRolesAggregate) apply(ctx context.Context, tx DB) error {
+	for i, m := range a.members {
+		if err := m.setRole(ctx, tx, a.roles[i]); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
