+// Manage applies the membership rule: readable, manager (else 403), not
+// archived (else 409). Org admins who are not project managers get 403.
+func (s *projectScope) Manage() (ManageProject, error) {
+	err := s.as.a.st.read(func(st *state) error {
+		p, r, err := readable(st, s.as.actor, s.pid)
+		if err != nil {
+			return err
+		}
+		if r != RoleManager {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if p.archived {
+			return deny(ErrArchived, "project is archived")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &manageProject{readProject: readProject{ps: s}}, nil
+}
+
+// ManageProject may change the roles of existing members of one project.
+type ManageProject interface {
+	ReadProject
+	// SetRole sets the role of an existing member. An unknown role is 400, a
+	// user who is not a member of this project is 404. If the change would
+	// leave a task assigned to a user who is no longer a contributor or manager,
+	// the store rejects it with 400 and nothing changes.
+	SetRole(userID, role string) (MemberView, error)
+}
+
+type manageProject struct {
+	readProject
+}
+
+func (p *manageProject) SetRole(userID, role string) (MemberView, error) {
+	if role != RoleManager && role != RoleContributor && role != RoleViewer {
+		return MemberView{}, deny(ErrInvalid, "role must be manager, contributor or viewer")
+	}
+	var v MemberView
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		if _, ok := s.members[p.ps.pid][userID]; !ok {
+			return deny(ErrNotFound, "member not found")
+		}
+		s.members[p.ps.pid][userID] = role
+		v = MemberView{UserID: userID, Role: role}
+		return nil
+	})
+	return v, err
+}
