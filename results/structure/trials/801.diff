+func TestMoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager of source only", "ann", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer of source, manager of target", "ann", "/projects/ops/members/cat/move", `{"toProjectId":"web"}`, 403},
+		{"not a member of target", "ivy", "/projects/ops/members/ann/move", `{"toProjectId":"legacy"}`, 404},
+		{"contributor", "ben", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin", "eve", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"non member of source", "hal", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 401},
+		{"unknown target", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"nope"}`, 404},
+		{"other org target", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"gx"}`, 404},
+		{"user not in source", "ivy", "/projects/web/members/hal/move", `{"toProjectId":"ops"}`, 404},
+		{"already in target", "ivy", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 400},
+		{"same project", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"web"}`, 400},
+		{"missing body field", "ivy", "/projects/web/members/ben/move", `{}`, 400},
+		{"archived target", "ann", "/projects/web/members/ben/move", `{"toProjectId":"legacy"}`, 409},
+		{"archived source", "ann", "/projects/legacy/members/ben/move", `{"toProjectId":"web"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestMoveMemberEffects(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]string{"userId": "ben", "projectId": "ops", "role": "contributor"}
+	for k, v := range want {
+		if got[k] != v {
+			t.Fatalf("%s = %q want %q (body=%s)", k, got[k], v, body)
+		}
+	}
+	// No longer a member of web: ben cannot read it; now readable in ops.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben should lose web access, got %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben should read ops, got %d", code)
+	}
+	// His web task is unassigned rather than left with a non-member assignee.
+	_, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if !strings.Contains(body, `"assignee":""`) {
+		t.Fatalf("t1 should be unassigned: %s", body)
+	}
+	// Moving again fails: no longer in web.
+	if code, _ := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`); code != 404 {
+		t.Fatalf("second move got %d want 404", code)
+	}
+}
