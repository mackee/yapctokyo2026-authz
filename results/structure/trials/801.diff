+// Move moves the user from the authorized project to the target project with
+// the same role. The actor must be a manager of both projects (neither archived).
+func (*MembershipTable) Move(ctx context.Context, db DB, authz ProjectAuthz, userID, toProjectID string) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var moved *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		toAuthz, err := NewProjectAuthz(ctx, tx, authz.Actor(), toProjectID)
+		if err != nil {
+			return err
+		}
+		if err := toAuthz.CanManageMembers(); err != nil {
+			return err
+		}
+		agg, err := loadMoveMember(ctx, tx, authz.ProjectID(), userID, toProjectID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		moved, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return moved, nil
+}
