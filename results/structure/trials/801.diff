+// moveMemberAggregate moves one member from one project to another, keeping the
+// role. Tasks assigned to the member in the source project are unassigned, so
+// that no assignee is left outside the project's members.
+type moveMemberAggregate struct {
+	from, to *Project
+	member   *Membership // the user's membership in from
+	user     *User
+	existing *Membership // the user's membership in to; must be nil
+	assigned []*Task     // member.AssignedTasks
+}
+
+func loadMoveMember(ctx context.Context, tx DB, fromID, userID, toID string) (*moveMemberAggregate, error) {
+	from, err := NewProjectTable().Find(ctx, tx, fromID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	to, err := NewProjectTable().Find(ctx, tx, toID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	m, err := from.Membership(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	u, err := m.User(ctx, tx)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveMemberAggregate{from: from, to: to, member: m, user: u}
+	if e, err := to.Membership(ctx, tx, userID); err == nil {
+		a.existing = e
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	if a.assigned, err = m.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.from.ID == a.to.ID {
+		return deny(ErrInvalid, "target project must differ from the source project")
+	}
+	if a.user.Org != a.to.Org {
+		return deny(ErrInvalid, "members must belong to the project's organization")
+	}
+	if a.existing != nil {
+		return deny(ErrInvalid, "user is already a member of the target project")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	for _, t := range a.assigned {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.member.remove(ctx, tx); err != nil {
+		return nil, err
+	}
+	moved := &Membership{ProjectID: a.to.ID, UserID: a.member.UserID, Role: a.member.Role}
+	if err := moved.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return moved, nil
+}
