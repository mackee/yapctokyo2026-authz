+++ b/transfer_test.go
@@ -0,0 +1,102 @@
+package main
+
+import (
+	"testing"
+)
+
+func TestTransferAccess(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin transfers", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 200},
+		{"anonymous", "", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 401},
+		{"project manager is not org admin", "ann", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 403},
+		{"other org admin", "gus", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 403},
+		{"admin of another org", "eve", "/orgs/globex/users/gus/transfer", `{"toOrgId":"acme"}`, 403},
+		{"unknown user", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"user in another org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"unknown target org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"initech"}`, 400},
+		{"same org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"acme"}`, 400},
+		{"missing toOrgId", "eve", "/orgs/acme/users/ben/transfer", `{}`, 400},
+		{"empty body", "eve", "/orgs/acme/users/ben/transfer", ``, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	want := `{"id":"ben","orgId":"globex"}` + "\n"
+	if body != want {
+		t.Fatalf("got body %q want %q", body, want)
+	}
+}
+
+func TestTransferMovesAccess(t *testing.T) {
+	h := newServer()
+	// ben is a contributor in web and legacy (acme) and is assigned t1 in web.
+	if code, body := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer got %d: %s", code, body)
+	}
+
+	// The user can no longer see the old org's projects.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("old project after transfer: got %d want 404", code)
+	}
+
+	app := h.(*appHandler)
+	var orgID string
+	if err := app.db.QueryRow(`SELECT org_id FROM users WHERE id = 'ben'`).Scan(&orgID); err != nil {
+		t.Fatal(err)
+	}
+	if orgID != "globex" {
+		t.Fatalf("ben org_id = %s, want globex", orgID)
+	}
+	var n int
+	if err := app.db.QueryRow(`SELECT COUNT(*) FROM memberships WHERE user_id = 'ben'`).Scan(&n); err != nil {
+		t.Fatal(err)
+	}
+	if n != 0 {
+		t.Fatalf("ben still has %d memberships", n)
+	}
+	var assignee string
+	if err := app.db.QueryRow(`SELECT assignee FROM tasks WHERE id = 't1'`).Scan(&assignee); err != nil {
+		t.Fatal(err)
+	}
+	if assignee != "" {
+		t.Fatalf("t1 assignee = %q, want unassigned", assignee)
+	}
+	// Assignments in projects of other orgs are untouched.
+	var gusTask string
+	if err := app.db.QueryRow(`SELECT assignee FROM tasks WHERE id = 't6'`).Scan(&gusTask); err != nil {
+		t.Fatal(err)
+	}
+	if gusTask != "gus" {
+		t.Fatalf("t6 assignee = %q, want gus", gusTask)
+	}
+}
+
+func TestTransferClearsOrgAdmin(t *testing.T) {
+	h := newServer()
+	// eve is the only org admin of acme; moving her out must not keep admin rights.
+	if code, body := do(t, h, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer got %d: %s", code, body)
+	}
+	var orgAdmin bool
+	if err := h.(*appHandler).db.QueryRow(`SELECT org_admin FROM users WHERE id = 'eve'`).Scan(&orgAdmin); err != nil {
+		t.Fatal(err)
+	}
+	if orgAdmin {
+		t.Fatal("eve kept org admin after transfer")
+	}
+}
