+func TestTransfer(t *testing.T) {
+	const gx = `{"toOrgId":"globex"}`
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/hal/transfer", gx, 200},
+		{"non admin", "ann", "/orgs/acme/users/hal/transfer", gx, 403},
+		{"anonymous", "", "/orgs/acme/users/hal/transfer", gx, 401},
+		{"admin of other org", "gus", "/orgs/acme/users/hal/transfer", gx, 404},
+		{"target not in org", "eve", "/orgs/acme/users/gus/transfer", gx, 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed/transfer", gx, 404},
+		{"same org", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"acme"}`, 400},
+		{"unknown org", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"nope"}`, 400},
+		{"empty body", "eve", "/orgs/acme/users/hal/transfer", ``, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferEffects(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 || strings.TrimSpace(body) != `{"id":"ben","orgId":"globex"}` {
+		t.Fatalf("got %d %s", code, body)
+	}
+	// lost access to the old org's projects
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("old project still visible: %d", code)
+	}
+	// tasks assigned to them in the old org are unassigned
+	_, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if !strings.Contains(body, `"assignee":""`) {
+		t.Fatalf("assignment kept: %s", body)
+	}
+	// transferred org admin does not stay admin
+	do(t, h, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "eve", ""); code != 404 {
+		t.Fatalf("admin flag carried over: %d", code)
+	}
+}
