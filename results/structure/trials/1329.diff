+  // POST /projects/{pid}/tasks/{tid}/move {"toProjectId": d}
+  // Needs manager in the source (like delete) and contributor/manager in the
+  // destination (like create). The assignee is carried over, so it must be a
+  // writer of the destination project (inv_assigneeIsWriter).
+  def moveOutcome(u: UserId, p: ProjectId, t: TaskId, d: ProjectId): int =
+    if (not(userExists(u))) 401
+    else if (not(canRead(u, p))) 404
+    else if (not(taskExists(t)) or tasks.get(t).project != p) 404
+    else if (roleOf(p, u) != "manager") 403
+    else if (projects.get(p).archived) 409
+    else if (not(canRead(u, d))) 404
+    else if (not(isWriter(d, u))) 403
+    else if (projects.get(d).archived) 409
+    else if (d == p) 400
+    else if (tasks.get(t).assignee != "" and not(isWriter(d, tasks.get(t).assignee))) 400
+    else 200
+
