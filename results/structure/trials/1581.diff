+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager", "ann", "/projects/web/members/dan", 204},
+		{"manager removes member with tasks", "ann", "/projects/web/members/ben", 204},
+		{"contributor", "ben", "/projects/web/members/dan", 403},
+		{"viewer", "dan", "/projects/web/members/cat", 403},
+		{"org admin non member", "eve", "/projects/web/members/dan", 403},
+		{"archived", "ann", "/projects/legacy/members/ben", 409},
+		{"not a member", "ann", "/projects/web/members/hal", 404},
+		{"non member caller", "hal", "/projects/web/members/dan", 404},
+		{"other org", "gus", "/projects/web/members/dan", 404},
+		{"anonymous", "", "/projects/web/members/dan", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveMemberEffects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 204 {
+		t.Fatalf("got %d want 204", code)
+	}
+	// ben can no longer read the project.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("removed member: got %d want 404", code)
+	}
+	// ben's task in web is unassigned; his other project is untouched.
+	_, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "" {
+		t.Fatalf("t1 assignee = %q, want unassigned", task.AssigneeID)
+	}
+	_, body = do(t, h, "GET", "/projects/legacy/tasks/t5", "ann", "")
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "ben" {
+		t.Fatalf("t5 assignee = %q, want ben", task.AssigneeID)
+	}
+	// Removing again is 404.
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 404 {
+		t.Fatalf("second removal: got %d want 404", code)
+	}
+}
