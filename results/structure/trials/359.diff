+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager of both", "ivy", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 200},
+		{"manager of source only", "ann", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 403},
+		{"contributor", "ben", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer", "dan", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin", "eve", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 403},
+		{"non member", "hal", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 404},
+		{"other org", "gus", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 401},
+		{"unknown user", "zed", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 401},
+		{"user not in source", "ivy", "/projects/web/members/hal/move", `{"toProjectId":"ops"}`, 404},
+		{"already in destination", "ivy", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 409},
+		{"destination missing", "ivy", "/projects/web/members/dan/move", `{"toProjectId":"nope"}`, 404},
+		{"destination other org", "ivy", "/projects/web/members/dan/move", `{"toProjectId":"gx"}`, 404},
+		{"destination archived", "ann", "/projects/web/members/dan/move", `{"toProjectId":"legacy"}`, 409},
+		{"source archived", "ann", "/projects/legacy/members/ben/move", `{"toProjectId":"web"}`, 409},
+		{"same project", "ivy", "/projects/web/members/dan/move", `{"toProjectId":"web"}`, 400},
+		{"empty destination", "ivy", "/projects/web/members/dan/move", `{"toProjectId":""}`, 400},
+		{"missing body", "ivy", "/projects/web/members/dan/move", ``, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/members/dan/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]string{"userId": "dan", "projectId": "ops", "role": "viewer"}
+	for k, v := range want {
+		if got[k] != v {
+			t.Fatalf("field %s: got %q want %q (body %s)", k, got[k], v, body)
+		}
+	}
+}
+
+func TestMoveChangesMembership(t *testing.T) {
+	s := newServer()
+	if code, body := do(t, s, "POST", "/projects/web/members/dan/move", "ivy", `{"toProjectId":"ops"}`); code != 200 {
+		t.Fatalf("move: got %d: %s", code, body)
+	}
+	if code, _ := do(t, s, "GET", "/projects/web/tasks", "dan", ""); code != 404 {
+		t.Fatalf("dan still reads web: got %d", code)
+	}
+	if code, _ := do(t, s, "GET", "/projects/ops/tasks", "dan", ""); code != 200 {
+		t.Fatalf("dan cannot read ops: got %d", code)
+	}
+	if code, _ := do(t, s, "POST", "/projects/web/members/dan/move", "ivy", `{"toProjectId":"ops"}`); code != 404 {
+		t.Fatalf("second move: got %d want 404", code)
+	}
+}
+
+func TestMoveUnassignsSourceTasks(t *testing.T) {
+	s := newServer()
+	if code, body := do(t, s, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`); code != 200 {
+		t.Fatalf("move: got %d: %s", code, body)
+	}
+	_, body := do(t, s, "GET", "/projects/web/tasks/t1", "ivy", "")
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.Assignee != "" {
+		t.Fatalf("t1 still assigned to %q", task.Assignee)
+	}
+	_, body = do(t, s, "GET", "/projects/web/tasks/t2", "ivy", "")
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.Assignee != "cat" {
+		t.Fatalf("t2 assignee changed to %q", task.Assignee)
+	}
+	// Tasks in other projects keep their assignee.
+	if code, body := do(t, s, "GET", "/projects/legacy/tasks/t5", "ann", ""); code != 200 || !strings.Contains(body, `"assignee":"ben"`) {
+		t.Fatalf("t5 changed: %d %s", code, body)
+	}
+}
