+// ManageProject may move members out of one project.
+type ManageProject interface {
+	ReadProject
+	// MoveMember moves userID from this project to toProjectID, keeping the
+	// role. The actor must manage both projects (403 otherwise). The user's
+	// tasks in this project are unassigned, since an assignee must belong to
+	// the task's project.
+	MoveMember(userID, toProjectID string) (MemberView, error)
+}
+
+type manageProject struct{ readProject }
+
+func (p *manageProject) MoveMember(userID, toProjectID string) (MemberView, error) {
+	if toProjectID == "" || toProjectID == p.ps.pid {
+		return MemberView{}, deny(ErrInvalid, "toProjectId must name a different project")
+	}
+	var v MemberView
+	err := p.ps.as.a.db.update(func(x *tx) error {
+		if _, err := manageable(x, p.ps.as.actor, p.ps.pid); err != nil {
+			return err
+		}
+		if _, err := manageable(x, p.ps.as.actor, toProjectID); err != nil {
+			return err
+		}
+		agg, err := loadMoveMember(x, p.ps.pid, toProjectID, userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		v = agg.save(x)
+		return nil
+	})
+	return v, err
+}
