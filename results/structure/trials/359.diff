+// moveMemberAggregate moves one membership from one project to another and
+// keeps the role. The user's tasks in the source project are unassigned,
+// because an assignee must be a contributor or manager of the task's project.
+type moveMemberAggregate struct {
+	from  projectRecord
+	to    projectRecord
+	user  userRecord
+	old   membershipRecord // source membership, destroyed on save
+	moved membershipRecord // destination membership, saved on save
+	tasks []taskRecord     // source tasks assigned to the user
+}
+
+func loadMoveMember(x *tx, fromPID, toPID, userID string) (*moveMemberAggregate, error) {
+	from, ok := x.findProject(fromPID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	to, ok := x.findProject(toPID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	old, ok := x.findMembership(fromPID, userID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if _, exists := x.findMembership(toPID, userID); exists {
+		return nil, deny(ErrConflict, "user is already a member of the destination project")
+	}
+	user, ok := x.findUser(userID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	a := &moveMemberAggregate{
+		from:  from,
+		to:    to,
+		user:  user,
+		old:   old,
+		moved: membershipRecord{ProjectID: toPID, UserID: userID, Role: old.Role},
+	}
+	for _, t := range x.tasksIn(fromPID) {
+		if t.AssigneeID == userID {
+			a.tasks = append(a.tasks, t)
+		}
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.user.Org != a.to.Org {
+		return deny(ErrInvalid, "project members must belong to the project's organization")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) save(x *tx) MemberView {
+	a.old.destroy(x)
+	a.moved.save(x)
+	for _, t := range a.tasks {
+		t.AssigneeID = ""
+		t.save(x)
+	}
+	return MemberView{UserID: a.moved.UserID, ProjectID: a.moved.ProjectID, Role: a.moved.Role}
+}
+
