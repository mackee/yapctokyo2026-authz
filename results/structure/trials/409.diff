+// changeMemberRoleAggregate changes the role of one project member.
+type changeMemberRoleAggregate struct {
+	membership *Membership
+	assigned   []*Task // the member's tasks in the project
+	in         MembershipTableChangeRoleInput
+}
+
+func loadChangeMemberRole(ctx context.Context, x *Tx, projectID, userID string, in MembershipTableChangeRoleInput) (*changeMemberRoleAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, x, projectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	assigned, err := m.AssignedTasks(ctx, x)
+	if err != nil {
+		return nil, err
+	}
+	return &changeMemberRoleAggregate{membership: m, assigned: assigned, in: in}, nil
+}
+
+func (a *changeMemberRoleAggregate) validate() error {
+	// An assignee must be a contributor or manager of the task's project.
+	if !isWriterRole(a.in.Role) && len(a.assigned) > 0 {
+		return deny(ErrInvalid, "member still has tasks assigned; reassign them before making the member a viewer")
+	}
+	return nil
+}
+
+func (a *changeMemberRoleAggregate) apply(ctx context.Context, x *Tx) (*Membership, error) {
+	if err := a.membership.changeRole(ctx, x, a.in.Role); err != nil {
+		return nil, err
+	}
+	return a.membership, nil
+}
+
