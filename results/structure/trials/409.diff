+// MembershipTableChangeRoleInput is the input of MembershipTable.ChangeRole.
+type MembershipTableChangeRoleInput struct {
+	Role string
+}
+
+// ChangeRole changes the role of a member of the project. The member must be a
+// member of the project (else ErrNotFound), and the role must be one of the
+// project roles (else ErrInvalid). Changing it to a role that cannot be an
+// assignee (viewer) is rejected while the member still has tasks assigned in
+// the project.
+func (*MembershipTable) ChangeRole(ctx context.Context, db DB, authz ProjectAuthz, userID string, in MembershipTableChangeRoleInput) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if !isProjectRole(in.Role) {
+		return nil, deny(ErrInvalid, "role must be manager, contributor or viewer")
+	}
+	var m *Membership
+	if err := db.update(ctx, func(x *Tx) error {
+		agg, err := loadChangeMemberRole(ctx, x, authz.ProjectID(), userID, in)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if m, err = agg.apply(ctx, x); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
