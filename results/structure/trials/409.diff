+func changeMemberRole(ctx tanukirpc.Context[*projectRegistry], req changeRoleRequest) (*memberResponse, error) {
+	reg := ctx.Registry()
+	uid := chi.URLParam(ctx.Request(), "uid")
+	m, err := model.NewMembershipTable().ChangeRole(ctx, reg.db, reg.authz, uid, model.MembershipTableChangeRoleInput{Role: req.Role})
