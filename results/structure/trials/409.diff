diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..16e90d4
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,103 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestChangeMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, project, target, body string
+		want                              int
+	}{
+		{"manager promotes viewer", "ann", "web", "dan", `{"role":"contributor"}`, 200},
+		{"manager promotes to manager", "ann", "web", "ben", `{"role":"manager"}`, 200},
+		{"manager demotes assignee", "ann", "web", "ben", `{"role":"viewer"}`, 400},
+		{"contributor caller", "ben", "web", "dan", `{"role":"contributor"}`, 403},
+		{"viewer caller", "dan", "web", "ben", `{"role":"viewer"}`, 403},
+		{"org admin", "eve", "web", "dan", `{"role":"contributor"}`, 403},
+		{"non member", "hal", "web", "dan", `{"role":"contributor"}`, 404},
+		{"other org", "gus", "web", "dan", `{"role":"contributor"}`, 404},
+		{"anonymous", "", "web", "dan", `{"role":"contributor"}`, 401},
+		{"unknown user", "zed", "web", "dan", `{"role":"contributor"}`, 401},
+		{"target not a member", "ann", "web", "hal", `{"role":"contributor"}`, 404},
+		{"target in other project", "ann", "web", "gus", `{"role":"contributor"}`, 404},
+		{"archived", "ann", "legacy", "ben", `{"role":"viewer"}`, 409},
+		{"archived, contributor caller", "ben", "legacy", "ben", `{"role":"viewer"}`, 403},
+		{"invalid role", "ann", "web", "dan", `{"role":"owner"}`, 400},
+		{"missing role", "ann", "web", "dan", `{}`, 400},
+		{"bad json", "ann", "web", "dan", `{"role":`, 400},
+		{"viewer caller, invalid body", "dan", "web", "dan", `{"role":"owner"}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members/"+c.target, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestChangeMemberRoleResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.UserID != "dan" || got.Role != "contributor" {
+		t.Fatalf("got %+v", got)
+	}
+}
+
+func TestChangeMemberRoleTakesEffect(t *testing.T) {
+	srv := newServer()
+	post := func(user string) int {
+		code, _ := do(t, srv, "POST", "/projects/web/tasks", user, `{"title":"x"}`)
+		return code
+	}
+	if code := post("dan"); code != 403 {
+		t.Fatalf("viewer create: got %d want 403", code)
+	}
+	if code, _ := do(t, srv, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`); code != 200 {
+		t.Fatalf("promote: got %d want 200", code)
+	}
+	if code := post("dan"); code != 200 {
+		t.Fatalf("promoted create: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "PUT", "/projects/web/members/dan", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote: got %d want 200", code)
+	}
+	if code := post("dan"); code != 403 {
+		t.Fatalf("demoted create: got %d want 403", code)
+	}
+}
+
+func TestChangeMemberRoleRejectedLeavesRoleUnchanged(t *testing.T) {
+	srv := newServer()
+	// ben is assigned t1 in web, so demoting him to viewer is rejected...
+	if code, _ := do(t, srv, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 400 {
+		t.Fatalf("demote assignee: got %d want 400", code)
+	}
+	// ...and his role is still contributor.
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 200 {
+		t.Fatalf("ben create after rejected demotion: got %d want 200", code)
+	}
+}
+
+func TestChangeMemberRoleAfterReassign(t *testing.T) {
+	srv := newServer()
+	// Hand ben's only task in web to ann; ben can then be demoted.
+	if code, _ := do(t, srv, "PATCH", "/projects/web/tasks/t1", "ann", `{"assignee":"ann"}`); code != 200 {
+		t.Fatalf("reassign: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote after reassign: got %d want 200", code)
+	}
+}
