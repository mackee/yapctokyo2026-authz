+// OrgAuthz is what the actor may do in one organization.
+type OrgAuthz struct {
+	actor Actor
+	org   string
+}
+
+// OrgID returns the organization the object is bound to.
+func (a OrgAuthz) OrgID() string { return a.org }
+
+// CanAdmin returns nil if the actor is an admin of the organization (else
+// ErrForbidden).
+func (a OrgAuthz) CanAdmin() error {
+	if a.org == "" || !a.actor.orgAdmin {
+		return deny(ErrForbidden, "only org admins may do this")
+	}
+	return nil
+}
+
+// UserAuthz is what the actor may do with one user of one organization.
+type UserAuthz struct {
+	org  OrgAuthz
+	user string
+}
+
+// OrgID returns the organization the user belongs to.
+func (a UserAuthz) OrgID() string { return a.org.org }
+
+// UserID returns the user the object is bound to.
+func (a UserAuthz) UserID() string { return a.user }
+
+// CanTransfer returns nil if the actor may move the user to another
+// organization: admins of the user's organization only (else ErrForbidden).
+func (a UserAuthz) CanTransfer() error { return a.org.CanAdmin() }
+
 // TaskAuthz is what the actor may do with one task of one project.
 type TaskAuthz struct {
 	project    ProjectAuthz
@@ -180,3 +214,31 @@ func NewTaskAuthz(ctx context.Context, db DB, pa ProjectAuthz, taskID string) (T
 	}
 	return TaskAuthz{project: pa, task: t.ID, isAssignee: t.AssigneeID == pa.actor.id}, nil
 }
+
+// NewOrgAuthz builds the actor's authorization object for one organization.
+// Only the actor's own organization is visible; another one is ErrNotFound.
+func NewOrgAuthz(act Actor, orgID string) (OrgAuthz, error) {
+	if orgID == "" || act.org != orgID {
+		return OrgAuthz{}, deny(ErrNotFound, "not found")
+	}
+	return OrgAuthz{actor: act, org: orgID}, nil
+}
+
+// NewUserAuthz builds the authorization object for one user of the
+// organization. The user must belong to that organization; otherwise
+// ErrNotFound.
+func NewUserAuthz(ctx context.Context, db DB, oa OrgAuthz, userID string) (UserAuthz, error) {
+	if oa.org == "" {
+		return UserAuthz{}, deny(ErrNotFound, "not found")
+	}
+	u, err := NewUserTable().Find(ctx, db, userID)
+	if errors.Is(err, ErrNoRows) {
+		return UserAuthz{}, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return UserAuthz{}, err
+	}
+	if u.Org != oa.org {
+		return UserAuthz{}, deny(ErrNotFound, "not found")
+	}
+	return UserAuthz{org: oa, user: u.ID}, nil
+}
