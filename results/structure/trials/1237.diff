+// transferUserAggregate moves one user to another organization.
+type transferUserAggregate struct {
+	user        *User
+	in          UserTableTransferInput
+	memberships []*Membership // the user's project memberships, in any project
+}
+
+func loadTransferUser(ctx context.Context, tx DB, userID string, in UserTableTransferInput) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &transferUserAggregate{user: u, in: in, memberships: ms}, nil
+}
+
+// validate: members belong to their project's organization, so a user with
+// project memberships cannot leave the organization they belong to.
+func (a *transferUserAggregate) validate() error {
+	if len(a.memberships) > 0 {
+		return deny(ErrInvalid, "user has project memberships; remove them before transferring")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	if err := a.user.moveTo(ctx, tx, a.in.ToOrgID); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
+
