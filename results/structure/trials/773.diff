+// setRoleAggregate changes the role of one project member.
+type setRoleAggregate struct {
+	member   *Membership
+	role     string
+	assigned []*Task // member.AssignedTasks: an assignee must stay a contributor or manager
+}
+
+func loadSetRole(ctx context.Context, tx DB, projectID, userID, role string) (*setRoleAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	m, err := p.Membership(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	assigned, err := m.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &setRoleAggregate{member: m, role: role, assigned: assigned}, nil
+}
+
+func (a *setRoleAggregate) validate() error {
+	if !isWriterRole(a.role) && len(a.assigned) > 0 {
+		return deny(ErrInvalid, "member has assigned tasks; reassign them before making the member a viewer")
+	}
+	return nil
+}
+
+func (a *setRoleAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.member.setRole(ctx, tx, a.role); err != nil {
+		return nil, err
+	}
+	return a.member, nil
+}
