@@ -0,0 +1,74 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager removes contributor", "ann", "/projects/web/members/ben", 204},
+		{"manager removes manager", "ann", "/projects/web/members/ivy", 204},
+		{"contributor", "ben", "/projects/web/members/cat", 403},
+		{"viewer", "dan", "/projects/web/members/ben", 403},
+		{"org admin", "eve", "/projects/web/members/ben", 403},
+		{"non member", "hal", "/projects/web/members/ben", 404},
+		{"other org", "gus", "/projects/web/members/ann", 404},
+		{"anonymous", "", "/projects/web/members/ben", 401},
+		{"unknown user", "zed", "/projects/web/members/ben", 401},
+		{"target not a member", "ann", "/projects/web/members/hal", 404},
+		{"unknown project", "ann", "/projects/nope/members/ben", 404},
+		{"archived", "ann", "/projects/legacy/members/ben", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveMemberEffects(t *testing.T) {
+	srv := newServer()
+
+	if code, _ := do(t, srv, "DELETE", "/projects/web/members/ben", "ann", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+
+	// The removed user loses access to the project.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("removed member list: got %d want 404", code)
+	}
+
+	// Removing them again is not found.
+	if code, _ := do(t, srv, "DELETE", "/projects/web/members/ben", "ann", ""); code != 404 {
+		t.Fatalf("second remove: got %d want 404", code)
+	}
+
+	// Tasks ben was assigned to are unassigned; other assignments are kept.
+	_, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ann", "")
+	var t1 Task
+	json.Unmarshal([]byte(body), &t1)
+	if t1.Assignee != "" {
+		t.Fatalf("t1 assignee = %q, want unassigned", t1.Assignee)
+	}
+	_, body = do(t, srv, "GET", "/projects/web/tasks/t2", "ann", "")
+	var t2 Task
+	json.Unmarshal([]byte(body), &t2)
+	if t2.Assignee != "cat" {
+		t.Fatalf("t2 assignee = %q, want cat", t2.Assignee)
+	}
+
+	// Tasks in other projects are not touched.
+	_, body = do(t, srv, "GET", "/projects/legacy/tasks/t5", "ann", "")
+	var t5 Task
+	json.Unmarshal([]byte(body), &t5)
+	if t5.Assignee != "ben" {
+		t.Fatalf("t5 assignee = %q, want ben", t5.Assignee)
+	}
+}
