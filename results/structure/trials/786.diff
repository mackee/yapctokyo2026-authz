+func TestFreezeDenied(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			code, _ := do(t, h, "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+			// a denied freeze changes nothing
+			if code, _ := do(t, h, "POST", "/projects/web/tasks", "ann", `{"title":"x"}`); c.project == "web" && code != 200 {
+				t.Fatalf("project was frozen by a denied request: %d", code)
+			}
+		})
+	}
+}
+
+func TestFreeze(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got []map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []string{"ann", "ben", "cat", "dan", "ivy"}
+	if len(got) != len(want) {
+		t.Fatalf("got %v", got)
+	}
+	for i, m := range got {
+		if len(m) != 2 || m["userId"] != want[i] || m["role"] != "viewer" {
+			t.Fatalf("member %d: %v", i, m)
+		}
+	}
+
+	// nobody can change the project's tasks any more
+	for _, u := range []string{"ann", "ben", "cat", "ivy"} {
+		for _, c := range []struct{ method, path, body string }{
+			{"POST", "/projects/web/tasks", `{"title":"x"}`},
+			{"PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+			{"PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+			{"DELETE", "/projects/web/tasks/t1", ""},
+			{"POST", "/projects/web/freeze", ""},
+		} {
+			if code, _ := do(t, h, c.method, c.path, u, c.body); code != 403 {
+				t.Errorf("%s %s %s after freeze: got %d want 403", u, c.method, c.path, code)
+			}
+		}
+	}
+	// reads still work, and other projects are untouched
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ann", ""); code != 200 {
+		t.Fatalf("read after freeze: %d", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/ops/tasks", "ivy", `{"title":"x"}`); code != 200 {
+		t.Fatalf("other project affected: %d", code)
+	}
+}
