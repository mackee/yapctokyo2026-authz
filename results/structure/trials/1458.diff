+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager", "ann", "/projects/web/members/ben", 204},
+		{"contributor", "ben", "/projects/web/members/cat", 403},
+		{"viewer", "dan", "/projects/web/members/cat", 403},
+		{"org admin", "eve", "/projects/web/members/ben", 403},
+		{"non member", "hal", "/projects/web/members/ben", 404},
+		{"other org", "gus", "/projects/web/members/ben", 404},
+		{"anonymous", "", "/projects/web/members/ben", 401},
+		{"unknown user", "zed", "/projects/web/members/ben", 401},
+		{"missing project", "ann", "/projects/nope/members/ben", 404},
+		{"target not a member", "ann", "/projects/web/members/hal", 404},
+		{"target in other project", "ann", "/projects/legacy/members/cat", 404},
+		{"archived", "ann", "/projects/legacy/members/ben", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveMemberUnassignsTasks(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 204 {
+		t.Fatalf("remove: got %d: %s", code, body)
+	}
+
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("get t1: got %d", code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.Assignee != "" {
+		t.Fatalf("t1 still assigned to %q after its assignee was removed", task.Assignee)
+	}
+
+	code, body = do(t, h, "GET", "/projects/web/tasks/t2", "ann", "")
+	if code != 200 {
+		t.Fatalf("get t2: got %d", code)
+	}
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.Assignee != "cat" {
+		t.Fatalf("t2 assignee changed to %q, want cat", task.Assignee)
+	}
+
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("removed member still reads project: got %d want 404", code)
+	}
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 404 {
+		t.Fatalf("removing twice: got %d want 404", code)
+	}
+}
