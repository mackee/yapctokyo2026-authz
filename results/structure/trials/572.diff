+func TestSetMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager promotes", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"manager demotes unassigned", "ann", "/projects/web/members/ivy", `{"role":"viewer"}`, 200},
+		{"demote with assigned tasks", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 400},
+		{"contributor", "ben", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"viewer", "dan", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"manager elsewhere only viewer here", "ann", "/projects/ops/members/cat", `{"role":"viewer"}`, 403},
+		{"org admin", "eve", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"non member", "hal", "/projects/web/members/dan", `{"role":"contributor"}`, 404},
+		{"other org", "gus", "/projects/web/members/dan", `{"role":"contributor"}`, 404},
+		{"anonymous", "", "/projects/web/members/dan", `{"role":"contributor"}`, 401},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"unknown role", "ann", "/projects/web/members/dan", `{"role":"admin"}`, 400},
+		{"missing role", "ann", "/projects/web/members/dan", `{}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMemberRoleEffect(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got struct{ UserID, Role string }
+	if err := json.Unmarshal([]byte(body), &got); err != nil || got.UserID != "dan" || got.Role != "contributor" {
+		t.Fatalf("bad body %s", body)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 201 && code != 200 {
+		t.Fatalf("dan should now write, got %d", code)
+	}
+	// A rejected change leaves the role unchanged.
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 400 {
+		t.Fatal(code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"y"}`); code != 201 && code != 200 {
+		t.Fatalf("ben should still write, got %d", code)
+	}
+}
