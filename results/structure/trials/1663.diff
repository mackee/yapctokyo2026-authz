+// OrgAuthz is what the actor may do in one organization.
+type OrgAuthz struct {
+	actor Actor
+	org   string
+}
+
+// OrgID returns the organization the object is bound to.
+func (a OrgAuthz) OrgID() string { return a.org }
+
+// CanManageUsers returns nil if the actor may remove users from the
+// organization's projects: org admins only (else ErrForbidden).
+func (a OrgAuthz) CanManageUsers() error {
+	if !a.actor.orgAdmin {
+		return deny(ErrForbidden, "only org admins may remove users")
+	}
+	return nil
+}
+
 // ---- building authorization objects -------------------------------------------------
 
 // Authenticate resolves the X-User value. Unknown or missing users are 401.
@@ -180,3 +198,12 @@ func NewTaskAuthz(ctx context.Context, db DB, pa ProjectAuthz, taskID string) (T
 	}
 	return TaskAuthz{project: pa, task: t.ID, isAssignee: t.AssigneeID == pa.actor.id}, nil
 }
+
+// NewOrgAuthz builds the actor's authorization object for one organization.
+// The actor must belong to the organization; otherwise ErrNotFound.
+func NewOrgAuthz(act Actor, orgID string) (OrgAuthz, error) {
+	if orgID == "" || act.org != orgID {
+		return OrgAuthz{}, deny(ErrNotFound, "not found")
+	}
+	return OrgAuthz{actor: act, org: orgID}, nil
+}
