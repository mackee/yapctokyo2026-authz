+// assigneeOf returns the assignee of a task as seen by user, failing the test
+// unless the read succeeds.
+func assigneeOf(t *testing.T, h http.Handler, user, path string) string {
+	t.Helper()
+	code, body := do(t, h, "GET", path, user, "")
+	if code != 200 {
+		t.Fatalf("GET %s as %s: got %d want 200", path, user, code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	return task.AssigneeID
+}
+
+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin, user without memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"project manager is not an org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"contributor", "ben", "/orgs/acme/users/cat", 403},
+		{"viewer", "dan", "/orgs/acme/users/cat", 403},
+		{"org admin of another org", "gus", "/orgs/acme/users/ben", 404},
+		{"user in another org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ben", 404},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "DELETE", "/orgs/acme/users/cat", "eve", ""); code != 204 {
+		t.Fatalf("remove cat: got %d want 204: %s", code, body)
+	}
+
+	// cat is no longer a member of any acme project: no access, not even reads.
+	for _, path := range []string{"/projects/web/tasks", "/projects/ops/tasks"} {
+		if code, _ := do(t, h, "GET", path, "cat", ""); code != 404 {
+			t.Fatalf("GET %s as cat: got %d want 404", path, code)
+		}
+	}
+
+	// Tasks cat was assigned to are unassigned, in every project of the org.
+	if got := assigneeOf(t, h, "ann", "/projects/web/tasks/t2"); got != "" {
+		t.Fatalf("web t2 assignee = %q, want unassigned", got)
+	}
+	if got := assigneeOf(t, h, "ivy", "/projects/ops/tasks/t4"); got != "" {
+		t.Fatalf("ops t4 assignee = %q, want unassigned", got)
+	}
+
+	// Other members are untouched.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ann", ""); code != 200 {
+		t.Fatalf("ann reads web: got %d want 200", code)
+	}
+	if got := assigneeOf(t, h, "ann", "/projects/web/tasks/t1"); got != "ben" {
+		t.Fatalf("web t1 assignee = %q, want ben", got)
+	}
+}
+
+func TestRemoveOrgUserArchivedProject(t *testing.T) {
+	// Removal is access revocation, so it also applies to archived projects.
+	h := newServer()
+	if code, body := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove ben: got %d want 204: %s", code, body)
+	}
+	if code, _ := do(t, h, "GET", "/projects/legacy/tasks", "ben", ""); code != 404 {
+		t.Fatalf("GET legacy as ben: got %d want 404", code)
+	}
+	if got := assigneeOf(t, h, "ann", "/projects/legacy/tasks/t5"); got != "" {
+		t.Fatalf("legacy t5 assignee = %q, want unassigned", got)
+	}
+}
