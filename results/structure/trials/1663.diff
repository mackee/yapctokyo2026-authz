+// RemoveFromOrg removes the user from every project of the authorization
+// object's organization, all or nothing. The user's tasks in those projects
+// are unassigned. A user who is not in the organization is ErrNotFound; a user
+// with no memberships there is left as it is (the call succeeds).
+func (*UserTable) RemoveFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanManageUsers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveOrgUser(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
