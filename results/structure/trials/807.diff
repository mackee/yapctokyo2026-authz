+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"contributor own", "cat", "/projects/ops/tasks/t4", `{"toProjectId":"web"}`, 200},
+		{"contributor others", "cat", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"manager any", "ivy", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 200},
+		{"manager into viewer project", "ann", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"viewer source", "dan", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"org admin source", "eve", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"non member source", "hal", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 404},
+		{"cross org source", "gus", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 401},
+		{"task in other project", "ann", "/projects/web/tasks/t4", `{"toProjectId":"legacy"}`, 404},
+		{"target missing", "ann", "/projects/web/tasks/t1", `{"toProjectId":"nope"}`, 404},
+		{"target other org", "ann", "/projects/web/tasks/t1", `{"toProjectId":"gx"}`, 404},
+		{"target not readable", "ben", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 404},
+		{"target archived", "ann", "/projects/web/tasks/t1", `{"toProjectId":"legacy"}`, 409},
+		{"source archived", "ann", "/projects/legacy/tasks/t5", `{"toProjectId":"web"}`, 409},
+		{"same project", "ann", "/projects/web/tasks/t1", `{"toProjectId":"web"}`, 400},
+		{"empty target", "ann", "/projects/web/tasks/t1", `{"toProjectId":""}`, 400},
+		{"missing body", "ann", "/projects/web/tasks/t1", ``, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsTask(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/tasks/t1/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var moved Task
+	if err := json.Unmarshal([]byte(body), &moved); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t1", ProjectID: "ops", Title: "Fix header", Status: "open", Assignee: "ben"}
+	if moved != want {
+		t.Fatalf("got %+v want %+v", moved, want)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks/t1", "ivy", ""); code != 200 {
+		t.Fatalf("task not in target project: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t1", "ivy", ""); code != 404 {
+		t.Fatalf("task still in source project: %d", code)
+	}
+}
+
+func TestMoveMixedRolesOnlyOwnTasks(t *testing.T) {
+	db, err := openSeededDB()
+	if err != nil {
+		t.Fatal(err)
+	}
+	// ann: manager in web, contributor in ops.
+	if _, err := db.Exec(`UPDATE memberships SET role = 'contributor' WHERE project_id = 'ops' AND user_id = 'ann'`); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := db.Exec(`UPDATE tasks SET assignee = 'ann' WHERE id = 't3'`); err != nil {
+		t.Fatal(err)
+	}
+	h := newServerWithDB(db)
+	if code, _ := do(t, h, "POST", "/projects/web/tasks/t1/move", "ann", `{"toProjectId":"ops"}`); code != 403 {
+		t.Fatalf("moving someone else's task: got %d want 403", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks/t3/move", "ann", `{"toProjectId":"ops"}`); code != 200 {
+		t.Fatalf("moving own task: got %d want 200", code)
+	}
+}
