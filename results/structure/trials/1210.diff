+// moveTaskAggregate moves one task to another project. The task keeps its
+// assignee, so the assignee must be a contributor or manager of the target.
+type moveTaskAggregate struct {
+	task     *Task
+	target   *Project
+	assignee *Membership // target.Membership(assignee); nil when unassigned or not a member
+}
+
+func loadMoveTask(ctx context.Context, tx DB, taskID, toProjectID string) (*moveTaskAggregate, error) {
+	t, err := NewTaskTable().Find(ctx, tx, taskID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	p, err := NewProjectTable().Find(ctx, tx, toProjectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveTaskAggregate{task: t, target: p}
+	if t.AssigneeID != "" {
+		m, err := p.Membership(ctx, tx, t.AssigneeID)
+		if errors.Is(err, ErrNoRows) {
+			// not a member of the target: validate rejects it
+		} else if err != nil {
+			return nil, err
+		} else {
+			a.assignee = m
+		}
+	}
+	return a, nil
+}
+
+func (a *moveTaskAggregate) validate() error {
+	if a.task.AssigneeID != "" && (a.assignee == nil || !isWriterRole(a.assignee.Role)) {
+		return deny(ErrInvalid, "assignee must be a contributor or manager of the target project")
+	}
+	return nil
+}
+
+func (a *moveTaskAggregate) apply(ctx context.Context, tx DB) (*Task, error) {
+	if err := a.task.moveTo(ctx, tx, a.target.ID); err != nil {
+		return nil, err
+	}
+	return a.task, nil
+}
