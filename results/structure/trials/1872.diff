+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+type member struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func TestFreezeResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var members []member
+	if err := json.Unmarshal([]byte(body), &members); err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]bool{"ann": true, "ben": true, "cat": true, "dan": true, "ivy": true}
+	if len(members) != len(want) {
+		t.Fatalf("want %d members, got %v", len(want), members)
+	}
+	for _, m := range members {
+		if !want[m.UserID] {
+			t.Fatalf("unexpected member %s", m.UserID)
+		}
+		if m.Role != "viewer" {
+			t.Fatalf("member %s has role %s", m.UserID, m.Role)
+		}
+	}
+}
+
+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"missing project", "ann", "nope", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeBlocksTaskChanges(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: %d", code)
+	}
+	cases := []struct {
+		name, method, path, user, body string
+	}{
+		{"former manager creates", "POST", "/projects/web/tasks", "ann", `{"title":"x"}`},
+		{"former contributor creates", "POST", "/projects/web/tasks", "ben", `{"title":"x"}`},
+		{"former manager updates", "PATCH", "/projects/web/tasks/t2", "ann", `{"status":"done"}`},
+		{"former contributor updates own", "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`},
+		{"former manager deletes", "DELETE", "/projects/web/tasks/t1", "ivy", ""},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, h, c.method, c.path, c.user, c.body)
+			if code != 403 {
+				t.Fatalf("got %d want 403", code)
+			}
+		})
+	}
+	// Tasks are still readable.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("list after freeze: %d", code)
+	}
+}
+
+// Assignees must be contributors or managers (see rules_test.go), so freezing
+// must leave no task assigned to a member who became a viewer.
+func TestFreezeUnassignsTasks(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: %d", code)
+	}
+	code, body := do(t, h, "GET", "/projects/web/tasks", "ann", "")
+	if code != 200 {
+		t.Fatal(code)
+	}
+	var tasks []Task
+	json.Unmarshal([]byte(body), &tasks)
+	if len(tasks) != 3 {
+		t.Fatalf("want 3 tasks kept, got %d", len(tasks))
+	}
+	for _, task := range tasks {
+		if task.Assignee != "" {
+			t.Fatalf("task %s still assigned to %s", task.ID, task.Assignee)
+		}
+	}
+}
+
+func TestFreezeOnlyAffectsProject(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: %d", code)
+	}
+	// ops is untouched: cat is still a contributor and can update her own task.
+	if code, _ := do(t, h, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ops update: %d", code)
+	}
+}
+
+func TestFreezeIdempotent(t *testing.T) {
+	h := newServer()
+	for i := 0; i < 2; i++ {
+		if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+			// After the first freeze ann is a viewer; a repeat is refused.
+			if i == 0 {
+				t.Fatalf("first freeze: %d", code)
+			}
+			if code != 403 {
+				t.Fatalf("second freeze: %d want 403", code)
+			}
+		}
+	}
+}
