+func TestSetMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, project, target, body string
+		want                              int
+	}{
+		{"manager promotes viewer", "ann", "web", "dan", `{"role":"contributor"}`, 200},
+		{"manager demotes unassigned manager", "ann", "web", "ivy", `{"role":"contributor"}`, 200},
+		{"manager keeps same role", "ann", "web", "ben", `{"role":"contributor"}`, 200},
+		{"demote assigned contributor", "ann", "web", "ben", `{"role":"viewer"}`, 400},
+		{"archived", "ann", "legacy", "ben", `{"role":"viewer"}`, 409},
+		{"contributor", "ben", "web", "dan", `{"role":"contributor"}`, 403},
+		{"viewer", "dan", "web", "ben", `{"role":"viewer"}`, 403},
+		{"org admin", "eve", "web", "dan", `{"role":"contributor"}`, 403},
+		{"non member actor", "hal", "web", "dan", `{"role":"contributor"}`, 404},
+		{"other org actor", "gus", "web", "dan", `{"role":"contributor"}`, 404},
+		{"anonymous", "", "web", "dan", `{"role":"contributor"}`, 401},
+		{"unknown user", "zed", "web", "dan", `{"role":"contributor"}`, 401},
+		{"target not a member", "ann", "web", "hal", `{"role":"contributor"}`, 404},
+		{"target in other project", "ivy", "ops", "ben", `{"role":"viewer"}`, 404},
+		{"viewer of project cannot change", "ann", "ops", "cat", `{"role":"viewer"}`, 403},
+		{"invalid role", "ann", "web", "dan", `{"role":"owner"}`, 400},
+		{"missing role", "ann", "web", "dan", `{}`, 400},
+		{"bad json", "ann", "web", "dan", `{"role":`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members/"+c.target, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMemberRoleResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/ops/members/ann", "ivy", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["userId"] != "ann" || got["role"] != "contributor" || len(got) != 2 {
+		t.Fatalf("got body %s", body)
+	}
+}
+
+func TestSetMemberRoleTakesEffect(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`); code != 200 {
+		t.Fatalf("promote: got %d: %s", code, body)
+	}
+	if code, body := do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("promoted dan create: got %d: %s", code, body)
+	}
+	if code, body := do(t, srv, "PUT", "/projects/web/members/dan", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote: got %d: %s", code, body)
+	}
+	if code, body := do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 403 {
+		t.Fatalf("demoted dan create: got %d want 403: %s", code, body)
+	}
+}
+
+func TestSetMemberRoleRejectedLeavesRoleUnchanged(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 400 {
+		t.Fatalf("demote assigned: got %d want 400: %s", code, body)
+	}
+	if code, body := do(t, srv, "POST", "/projects/web/tasks", "ben", `{"title":"x","assignee":"ben"}`); code != 200 {
+		t.Fatalf("ben should still be a contributor: got %d: %s", code, body)
+	}
+}
