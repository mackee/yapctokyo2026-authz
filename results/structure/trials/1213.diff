+// setRoleAggregate changes one member's role in one project.
+type setRoleAggregate struct {
+	membership *Membership
+	role       string
+	assigned   []*Task // the member's tasks in the project
+}
+
+func loadSetRole(ctx context.Context, tx DB, projectID, userID string, in MembershipTableSetRoleInput) (*setRoleAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	assigned, err := m.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &setRoleAggregate{membership: m, role: in.Role, assigned: assigned}, nil
+}
+
+func (a *setRoleAggregate) validate() error {
+	if len(a.assigned) > 0 && !isWriterRole(a.role) {
+		return deny(ErrInvalid, "member is assigned tasks in the project and must stay a contributor or manager")
+	}
+	return nil
+}
+
+func (a *setRoleAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.membership.setRole(ctx, tx, a.role); err != nil {
+		return nil, err
+	}
+	return a.membership, nil
+}
+
 // deleteTaskAggregate removes one task.
