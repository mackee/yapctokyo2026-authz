+// ---- operations -----------------------------------------------------------------------
+
+// validRoles are the project roles a membership may hold.
+var validRoles = map[string]bool{RoleManager: true, RoleContributor: true, RoleViewer: true}
+
+// MembershipTableSetRoleInput is the input of MembershipTable.SetRole.
+type MembershipTableSetRoleInput struct {
+	Role string
+}
+
+// SetRole changes the role of the user's membership in the project. Managers
+// only. The user must already be a member; otherwise ErrNotFound. A member who
+// is assigned tasks in the project must stay a contributor or manager, so such
+// a change is rejected with ErrInvalid and nothing changes.
+func (mt *MembershipTable) SetRole(ctx context.Context, db DB, authz ProjectAuthz, userID string, in MembershipTableSetRoleInput) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if !validRoles[in.Role] {
+		return nil, deny(ErrInvalid, "invalid role")
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadSetRole(ctx, tx, authz.ProjectID(), userID, in)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if m, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
