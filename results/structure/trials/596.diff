+// changeRolesAggregate changes the roles of several members of one project.
+// A member who stops being a contributor or manager is unassigned from their
+// tasks in the project, so the assignee rule keeps holding.
+type changeRolesAggregate struct {
+	project *Project
+	members []*Membership // the members to change, ordered by user ID
+	roles   map[string]string
+	tasks   map[string][]*Task // member user ID -> tasks assigned to them
+}
+
+func loadChangeRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*changeRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	all, err := p.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	a := &changeRolesAggregate{project: p, roles: roles, tasks: map[string][]*Task{}}
+	found := 0
+	for _, m := range all { // ordered by user ID
+		role, ok := roles[m.UserID]
+		if !ok {
+			continue
+		}
+		found++
+		a.members = append(a.members, m)
+		if !isWriterRole(role) {
+			ts, err := m.AssignedTasks(ctx, tx)
+			if err != nil {
+				return nil, err
+			}
+			a.tasks[m.UserID] = ts
+		}
+	}
+	if found != len(roles) {
+		return nil, deny(ErrInvalid, "every user must be a member of the project")
+	}
+	return a, nil
+}
+
+func (a *changeRolesAggregate) validate() error {
+	for _, role := range a.roles {
+		if !validRoles[role] {
+			return deny(ErrInvalid, "role must be manager, contributor or viewer")
+		}
+	}
+	return nil
+}
+
+func (a *changeRolesAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for _, m := range a.members {
+		role := a.roles[m.UserID]
+		if m.Role == role {
+			continue
+		}
+		if err := m.setRole(ctx, tx, role); err != nil {
+			return nil, err
+		}
+		for _, t := range a.tasks[m.UserID] {
+			if err := t.unassign(ctx, tx); err != nil {
+				return nil, err
+			}
+		}
+	}
+	return a.project.Memberships(ctx, tx)
+}
+
