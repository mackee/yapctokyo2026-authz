+func TestUpdateMemberRoles(t *testing.T) {
+	members := func(t *testing.T, h http.Handler) map[string]string {
+		t.Helper()
+		// the PUT with no change returns the current list
+		code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ann":"manager"}}`)
+		if code != 200 {
+			t.Fatalf("list: %d %s", code, body)
+		}
+		var ms []struct{ UserID, Role string }
+		if err := json.Unmarshal([]byte(body), &ms); err != nil {
+			t.Fatal(err)
+		}
+		out := map[string]string{}
+		for _, m := range ms {
+			out[m.UserID] = m.Role
+		}
+		return out
+	}
+
+	t.Run("bulk change", func(t *testing.T) {
+		h := newServer()
+		code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+		if code != 200 {
+			t.Fatalf("%d %s", code, body)
+		}
+		var ms []map[string]string
+		if err := json.Unmarshal([]byte(body), &ms); err != nil {
+			t.Fatal(err)
+		}
+		got := map[string]string{}
+		for _, m := range ms {
+			if len(m) != 2 {
+				t.Fatalf("unexpected shape %v", m)
+			}
+			got[m["userId"]] = m["role"]
+		}
+		want := map[string]string{"ann": "manager", "ben": "viewer", "cat": "contributor", "dan": "contributor", "ivy": "manager"}
+		if len(got) != len(want) {
+			t.Fatalf("got %v want %v", got, want)
+		}
+		for k, v := range want {
+			if got[k] != v {
+				t.Fatalf("got %v want %v", got, want)
+			}
+		}
+		// ben is no longer a writer: their task is unassigned
+		_, tb := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+		var task Task
+		json.Unmarshal([]byte(tb), &task)
+		if task.AssigneeID != "" {
+			t.Fatalf("t1 still assigned to %q", task.AssigneeID)
+		}
+	})
+
+	t.Run("one bad entry changes nothing", func(t *testing.T) {
+		h := newServer()
+		for _, body := range []string{
+			`{"roles":{"ben":"viewer","hal":"viewer"}}`, // hal is not a member
+			`{"roles":{"ben":"viewer","gus":"viewer"}}`, // other org
+			`{"roles":{"ben":"viewer","dan":"admin"}}`,  // invalid role
+			`{"roles":{"ben":"viewer","dan":""}}`,       // empty role
+			`{"roles":{}}`,                              // nothing to do
+			`{}`,                                        // missing
+			`not json`,                                  // malformed
+		} {
+			code, _ := do(t, h, "PUT", "/projects/web/members", "ann", body)
+			if code != 400 {
+				t.Fatalf("%s: got %d want 400", body, code)
+			}
+		}
+		got := members(t, h)
+		if got["ben"] != "contributor" || got["dan"] != "viewer" {
+			t.Fatalf("roles changed: %v", got)
+		}
+	})
+
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"contributor", "ben", "/projects/web/members", 403},
+		{"viewer", "dan", "/projects/web/members", 403},
+		{"org admin", "eve", "/projects/web/members", 403},
+		{"non member", "hal", "/projects/web/members", 404},
+		{"other org", "gus", "/projects/web/members", 404},
+		{"anonymous", "", "/projects/web/members", 401},
+		{"archived", "ann", "/projects/legacy/members", 409},
+		{"manager", "ann", "/projects/web/members", 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			code, _ := do(t, h, "PUT", c.path, c.user, `{"roles":{"ben":"viewer"}}`)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+			if c.want != 200 {
+				if got := members(t, h); got["ben"] != "contributor" {
+					t.Fatalf("role changed despite %d", code)
+				}
+			}
+		})
+	}
+}
