+// RemoveFromOrg removes the user from every project of the organization (for
+// example when the user leaves it), all or nothing. The user's tasks in those
+// projects are unassigned. Removing a user who is already in no project is a
+// no-op. Only org admins of the organization may do it (CanManageMembers); a
+// user outside the organization is ErrNotFound.
+func (*UserTable) RemoveFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanManageMembers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveOrgUser(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
