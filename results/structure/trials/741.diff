+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d body=%s", code, body)
+	}
+
+	// ben is no longer a member of web or of the archived legacy project.
+	for _, path := range []string{"/projects/web/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, h, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("ben GET %s: got %d want 404", path, code)
+		}
+	}
+
+	// ben's tasks are unassigned; other assignments are untouched.
+	code, body := do(t, h, "GET", "/projects/web/tasks", "ann", "")
+	if code != 200 {
+		t.Fatalf("ann lists web: got %d", code)
+	}
+	var web []Task
+	if err := json.Unmarshal([]byte(body), &web); err != nil {
+		t.Fatal(err)
+	}
+	assignee := map[string]string{}
+	for _, task := range web {
+		assignee[task.ID] = task.AssigneeID
+	}
+	if assignee["t1"] != "" {
+		t.Fatalf("t1 still assigned to %q", assignee["t1"])
+	}
+	if assignee["t2"] != "cat" {
+		t.Fatalf("t2 assignee changed to %q", assignee["t2"])
+	}
+
+	code, body = do(t, h, "GET", "/projects/legacy/tasks/t5", "ann", "")
+	if code != 200 {
+		t.Fatalf("ann reads t5: got %d", code)
+	}
+	var t5 Task
+	if err := json.Unmarshal([]byte(body), &t5); err != nil {
+		t.Fatal(err)
+	}
+	if t5.AssigneeID != "" {
+		t.Fatalf("legacy t5 still assigned to %q", t5.AssigneeID)
+	}
+
+	// ben's own membership row is gone, so ben can no longer write either.
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t3", "ben", `{"status":"done"}`); code != 404 {
+		t.Fatalf("ben PATCH after removal: got %d want 404", code)
+	}
+
+	// Other users in the organization keep their memberships.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat lost access to web: got %d", code)
+	}
+
+	// Removing again is a no-op.
+	if code, body := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("repeat remove: got %d body=%s", code, body)
+	}
+}
