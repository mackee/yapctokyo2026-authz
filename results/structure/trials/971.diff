+func TestSetMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, project, target, body string
+		want                              int
+	}{
+		{"manager demotes", "ann", "web", "ben", `{"role":"viewer"}`, 200},
+		{"manager promotes", "ann", "web", "dan", `{"role":"contributor"}`, 200},
+		{"manager sets manager", "ann", "web", "cat", `{"role":"manager"}`, 200},
+		{"contributor caller", "ben", "web", "cat", `{"role":"viewer"}`, 403},
+		{"viewer caller", "dan", "web", "ben", `{"role":"viewer"}`, 403},
+		{"org admin caller", "eve", "web", "ben", `{"role":"viewer"}`, 403},
+		{"non member caller", "hal", "web", "ben", `{"role":"viewer"}`, 404},
+		{"other org caller", "gus", "web", "ben", `{"role":"viewer"}`, 404},
+		{"archived", "ann", "legacy", "ben", `{"role":"viewer"}`, 409},
+		{"unknown role", "ann", "web", "ben", `{"role":"owner"}`, 400},
+		{"missing role", "ann", "web", "ben", `{}`, 400},
+		{"bad json", "ann", "web", "ben", `{`, 400},
+		{"target not member", "ann", "web", "hal", `{"role":"viewer"}`, 404},
+		{"target in other project", "ivy", "ops", "ben", `{"role":"viewer"}`, 404},
+		{"viewer of ops cannot change roles", "ann", "ops", "cat", `{"role":"viewer"}`, 403},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members/"+c.target, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMemberRoleEffect(t *testing.T) {
+	srv := newServer()
+	code, body := do(t, srv, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["userId"] != "ben" || got["role"] != "viewer" {
+		t.Fatalf("unexpected body %s", body)
+	}
+	// ben was a contributor; as a viewer the write must now be refused.
+	code, _ = do(t, srv, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`)
+	if code != 403 {
+		t.Fatalf("demoted user write: got %d want 403", code)
+	}
+}
