+// moveMemberAggregate moves one member from a source project to a target project.
+type moveMemberAggregate struct {
+	from  *Membership // the member in the source project
+	tasks []*Task     // the source project's tasks assigned to the member
+	toID  string      // the target project
+}
+
+func loadMoveMember(ctx context.Context, tx DB, fromProjectID, toProjectID, userID string) (*moveMemberAggregate, error) {
+	from, err := NewMembershipTable().Find(ctx, tx, fromProjectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "member not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if _, err := NewMembershipTable().Find(ctx, tx, toProjectID, userID); err == nil {
+		return nil, deny(ErrConflict, "member is already in the target project")
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	tasks, err := from.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &moveMemberAggregate{from: from, tasks: tasks, toID: toProjectID}, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	switch a.from.Role {
+	case RoleManager, RoleContributor, RoleViewer:
+		return nil
+	}
+	return deny(ErrInvalid, "member has no valid role")
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.from.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	to := &Membership{ProjectID: a.toID, UserID: a.from.UserID, Role: a.from.Role}
+	if err := to.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return to, nil
+}
+
