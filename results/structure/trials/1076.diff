+// setRolesAggregate changes the roles of several members of one project, all or
+// nothing.
+type setRolesAggregate struct {
+	project *Project
+	targets []*Membership // the members to change, ordered by user ID
+	roles   map[string]string
+}
+
+func loadSetRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*setRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "project does not exist")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &setRolesAggregate{project: p, roles: roles}
+	for _, userID := range slices.Sorted(maps.Keys(roles)) {
+		m, err := p.Membership(ctx, tx, userID)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "user "+userID+" is not a member of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		a.targets = append(a.targets, m)
+	}
+	return a, nil
+}
+
+func (a *setRolesAggregate) validate() error {
+	for _, userID := range slices.Sorted(maps.Keys(a.roles)) {
+		if !isValidRole(a.roles[userID]) {
+			return deny(ErrInvalid, "invalid role for user "+userID)
+		}
+	}
+	return nil
+}
+
+// apply changes the roles and returns the project's members after the change.
+func (a *setRolesAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for _, m := range a.targets {
+		if err := m.setRole(ctx, tx, a.roles[m.UserID]); err != nil {
+			return nil, err
+		}
+	}
+	return NewMembershipTable().ListByProject(ctx, tx, a.project.ID)
+}
