+func TestSetRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager demotes contributor", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 200},
+		{"manager promotes viewer", "ann", "/projects/web/members/dan", `{"role":"manager"}`, 200},
+		{"other manager changes role", "ivy", "/projects/web/members/ben", `{"role":"viewer"}`, 200},
+		{"same role is a no-op", "ann", "/projects/web/members/ben", `{"role":"contributor"}`, 200},
+		{"contributor caller", "ben", "/projects/web/members/cat", `{"role":"viewer"}`, 403},
+		{"viewer caller", "dan", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"org admin caller", "eve", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"non member caller", "hal", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"other org caller", "gus", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"anonymous", "", "/projects/web/members/ben", `{"role":"viewer"}`, 401},
+		{"unknown user", "zed", "/projects/web/members/ben", `{"role":"viewer"}`, 401},
+		{"unknown project", "ann", "/projects/nope/members/ben", `{"role":"viewer"}`, 404},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"target unknown user", "ann", "/projects/web/members/zed", `{"role":"viewer"}`, 404},
+		{"target in other org", "ann", "/projects/web/members/gus", `{"role":"viewer"}`, 404},
+		{"archived project", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"invalid role", "ann", "/projects/web/members/ben", `{"role":"owner"}`, 400},
+		{"empty role", "ann", "/projects/web/members/ben", `{}`, 400},
+		{"bad body", "ann", "/projects/web/members/ben", `not json`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetRoleResponseAndEffect(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("bad json %q: %v", body, err)
+	}
+	if got["userId"] != "ben" || got["role"] != "viewer" {
+		t.Fatalf("body %s, want userId ben and role viewer", body)
+	}
+
+	// The new role applies in the changed project: ben is now a viewer of web.
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 403 {
+		t.Fatalf("demoted member PATCH got %d want 403", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("demoted member still reads: got %d want 200", code)
+	}
+
+	// The change is scoped to web: ben stays a contributor in legacy, so his
+	// write reaches the archived check (409) instead of the role check (403).
+	if code, _ := do(t, h, "PATCH", "/projects/legacy/tasks/t5", "ben", `{"status":"done"}`); code != 409 {
+		t.Fatalf("ben in legacy got %d want 409", code)
+	}
+}
