+func TestSetMemberRoles(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager changes roles", "ann", "web", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 200},
+		{"manager promotes to manager", "ann", "web", `{"roles":{"cat":"manager"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"ben":"viewer"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"ben":"viewer"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"ben":"viewer"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"ben":"viewer"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"ben":"viewer"}}`, 401},
+		{"unknown user", "zed", "web", `{"roles":{"ben":"viewer"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"unknown role", "ann", "web", `{"roles":{"ben":"owner"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"null roles", "ann", "web", `{"roles":null}`, 400},
+		{"bad json", "ann", "web", `{"roles":`, 400},
+		{"target not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"one target not a member", "ann", "web", `{"roles":{"ben":"viewer","hal":"viewer"}}`, 400},
+		{"unknown project", "ann", "nope", `{"roles":{"ben":"viewer"}}`, 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMemberRolesResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann",
+		`{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	type member struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	var got []member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []member{
+		{"ann", "manager"},
+		{"ben", "viewer"},
+		{"cat", "contributor"},
+		{"dan", "contributor"},
+		{"ivy", "manager"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %s", body)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("row %d: got %+v want %+v in %s", i, got[i], want[i], body)
+		}
+	}
+}
+
+func TestSetMemberRolesIsAllOrNothing(t *testing.T) {
+	s := newServer()
+	// ben is a valid member, hal is not: the whole request must fail.
+	code, _ := do(t, s, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","hal":"viewer"}}`)
+	if code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	// A later successful request on the same database shows ben is unchanged.
+	code, body := do(t, s, "PUT", "/projects/web/members", "ann", `{"roles":{"cat":"viewer"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	if !strings.Contains(body, `{"userId":"ben","role":"contributor"}`) {
+		t.Fatalf("ben changed by a failed request: %s", body)
+	}
+}
