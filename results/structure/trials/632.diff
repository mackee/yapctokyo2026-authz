+// MembershipTableSetRolesInput is the input of MembershipTable.SetRoles.
+type MembershipTableSetRolesInput struct {
+	Roles map[string]string // user ID -> new role
+}
+
+// SetRoles changes the roles of several members of the project, all or nothing,
+// and returns the project's members (ordered by user ID) after the change.
+// Every user in the input must already be a member; otherwise nothing changes.
+func (*MembershipTable) SetRoles(ctx context.Context, db DB, authz ProjectAuthz, in MembershipTableSetRolesInput) ([]*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if len(in.Roles) == 0 {
+		return nil, deny(ErrInvalid, "roles must not be empty")
+	}
+	for _, role := range in.Roles {
+		if !isRole(role) {
+			return nil, deny(ErrInvalid, "role must be manager, contributor or viewer")
+		}
+	}
+	var out []*Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadSetRoles(ctx, tx, authz.ProjectID(), in)
+		if err != nil {
+			return err
+		}
+		if out, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
