+// setRolesAggregate changes the roles of several members of one project.
+type setRolesAggregate struct {
+	project *Project
+	targets []*Membership // the members to change, ordered by user ID
+	roles   map[string]string
+}
+
+func loadSetRoles(ctx context.Context, tx DB, projectID string, in MembershipTableSetRolesInput) (*setRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	userIDs := make([]string, 0, len(in.Roles))
+	for userID := range in.Roles {
+		userIDs = append(userIDs, userID)
+	}
+	sort.Strings(userIDs)
+	a := &setRolesAggregate{project: p, roles: in.Roles}
+	for _, userID := range userIDs {
+		m, err := p.Membership(ctx, tx, userID)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "every user in roles must be a member of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		a.targets = append(a.targets, m)
+	}
+	return a, nil
+}
+
+// apply changes the roles and returns the project's members after the change.
+func (a *setRolesAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for _, m := range a.targets {
+		if err := m.setRole(ctx, tx, a.roles[m.UserID]); err != nil {
+			return nil, err
+		}
+	}
+	return a.project.Memberships(ctx, tx)
+}
+
