+package main
+
+import (
+	"encoding/json"
+	"reflect"
+	"testing"
+)
+
+func TestFreezeResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got []memberRole
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("bad body %s: %v", body, err)
+	}
+	want := []memberRole{
+		{UserID: "ann", Role: RoleViewer},
+		{UserID: "ben", Role: RoleViewer},
+		{UserID: "cat", Role: RoleViewer},
+		{UserID: "dan", Role: RoleViewer},
+		{UserID: "ivy", Role: RoleViewer},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+}
+
+func TestFreezeAuthorization(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"anonymous", "", "/projects/web/freeze", 401},
+		{"unknown user", "zed", "/projects/web/freeze", 401},
+		{"non member", "hal", "/projects/web/freeze", 404},
+		{"other org", "gus", "/projects/web/freeze", 404},
+		{"missing project", "ann", "/projects/nope/freeze", 404},
+		{"contributor", "ben", "/projects/web/freeze", 403},
+		{"viewer", "dan", "/projects/web/freeze", 403},
+		{"org admin", "eve", "/projects/web/freeze", 403},
+		{"archived", "ann", "/projects/legacy/freeze", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestFreezeBlocksTaskWrites(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze got %d body=%s", code, body)
+	}
+	cases := []struct {
+		name, user, method, path, body string
+		want                           int
+	}{
+		{"contributor own task", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`, 403},
+		{"former manager patch", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"former manager create", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"former manager delete", "ann", "DELETE", "/projects/web/tasks/t1", "", 403},
+		{"other project still writable", "cat", "POST", "/projects/ops/tasks", `{"title":"x"}`, 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, h, c.method, c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("reads should still work, got %d", code)
+	}
+}
+
+// Even if a member's role were somehow restored, the frozen flag alone must
+// keep the project read-only.
+func TestFrozenFlagRejectsWritesRegardlessOfRole(t *testing.T) {
+	h, db := newServerWithDB()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze got %d body=%s", code, body)
+	}
+	if _, err := db.Exec(`UPDATE memberships SET role = 'manager' WHERE project_id = 'web' AND user_id = 'ann'`); err != nil {
+		t.Fatal(err)
+	}
+	if code, body := do(t, h, "PATCH", "/projects/web/tasks/t2", "ann", `{"status":"done"}`); code != 409 {
+		t.Fatalf("patch got %d want 409 body=%s", code, body)
+	}
+	if code, body := do(t, h, "POST", "/projects/web/tasks", "ann", `{"title":"x"}`); code != 409 {
+		t.Fatalf("create got %d want 409 body=%s", code, body)
+	}
+	if code, body := do(t, h, "DELETE", "/projects/web/tasks/t1", "ann", ""); code != 409 {
+		t.Fatalf("delete got %d want 409 body=%s", code, body)
+	}
+}
+
+// After a freeze every former manager is a viewer, so a second freeze is
+// rejected by the manager-only rule.
+func TestRefreezeIsForbidden(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze got %d body=%s", code, body)
+	}
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 403 {
+		t.Fatalf("refreeze got %d want 403 body=%s", code, body)
+	}
+}
