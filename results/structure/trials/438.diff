+// moveMemberAggregate moves one member from the source project to the
+// destination project, keeping the role.
+type moveMemberAggregate struct {
+	from     *Membership // the user's membership in the source project
+	fromProj *Project
+	to       *Project
+	existing *Membership // the user's membership in the destination project, if any
+}
+
+func loadMoveMember(ctx context.Context, x *Tx, fromProjectID, toProjectID, userID string) (*moveMemberAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, x, fromProjectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	fp, err := m.Project(ctx, x)
+	if err != nil {
+		return nil, err
+	}
+	tp, err := NewProjectTable().Find(ctx, x, toProjectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	existing, err := tp.Membership(ctx, x, userID)
+	if errors.Is(err, ErrNoRows) {
+		existing = nil
+	} else if err != nil {
+		return nil, err
+	}
+	return &moveMemberAggregate{from: m, fromProj: fp, to: tp, existing: existing}, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.to.Org != a.fromProj.Org {
+		return deny(ErrInvalid, "destination project must belong to the same organization")
+	}
+	if a.existing != nil {
+		return deny(ErrConflict, "user is already a member of the destination project")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, x *Tx) (*Membership, error) {
+	// An assignee must be a member of the task's project, so the user's tasks
+	// in the source project are unassigned.
+	tasks, err := a.from.AssignedTasks(ctx, x)
+	if err != nil {
+		return nil, err
+	}
+	for _, t := range tasks {
+		if err := t.unassign(ctx, x); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.from.remove(ctx, x); err != nil {
+		return nil, err
+	}
+	m := &Membership{ProjectID: a.to.ID, UserID: a.from.UserID, Role: a.from.Role}
+	if err := m.save(ctx, x); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
+
