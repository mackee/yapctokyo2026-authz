+// Move moves the user's membership from the project of from to the project of
+// to, keeping the role. The user's tasks in the source project are unassigned,
+// since their assignee must be a member of the task's project. The actor must
+// be a manager of both projects (see CanManageMembers). The move is all-or-nothing.
+func (*MembershipTable) Move(ctx context.Context, db DB, from, to ProjectAuthz, userID string) (*Membership, error) {
+	if from.ProjectID() == to.ProjectID() {
+		return nil, deny(ErrInvalid, "destination must be a different project")
+	}
+	if err := from.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if err := to.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var m *Membership
+	if err := db.update(ctx, func(x *Tx) error {
+		agg, err := loadMoveMember(ctx, x, from.ProjectID(), to.ProjectID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		m, err = agg.apply(ctx, x)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
