+func TestUpdateMembers(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager bulk", "ann", "/projects/web/members", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 200},
+		{"viewer", "dan", "/projects/web/members", `{"roles":{"ben":"viewer"}}`, 403},
+		{"contributor", "ben", "/projects/web/members", `{"roles":{"ben":"manager"}}`, 403},
+		{"org admin", "eve", "/projects/web/members", `{"roles":{"ben":"viewer"}}`, 403},
+		{"non member", "hal", "/projects/web/members", `{"roles":{"ben":"viewer"}}`, 404},
+		{"other org", "gus", "/projects/web/members", `{"roles":{"ben":"viewer"}}`, 404},
+		{"anonymous", "", "/projects/web/members", `{"roles":{"ben":"viewer"}}`, 401},
+		{"archived", "ann", "/projects/legacy/members", `{"roles":{"ben":"viewer"}}`, 409},
+		{"invalid role", "ann", "/projects/web/members", `{"roles":{"ben":"boss"}}`, 400},
+		{"empty roles", "ann", "/projects/web/members", `{"roles":{}}`, 400},
+		{"bad body", "ann", "/projects/web/members", `nope`, 400},
+		{"non member target", "ann", "/projects/web/members", `{"roles":{"hal":"viewer"}}`, 400},
+		{"last manager", "ann", "/projects/web/members", `{"roles":{"ann":"viewer","ivy":"viewer"}}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMembersResult(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got []memberView
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []memberView{{"ann", "manager"}, {"ben", "viewer"}, {"cat", "contributor"}, {"dan", "contributor"}, {"ivy", "manager"}}
+	if len(got) != len(want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("got %v want %v", got, want)
+		}
+	}
+	// ben became a viewer: his task t1 is unassigned, and he can no longer write.
+	_, b := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(b), &task)
+	if task.Assignee != "" {
+		t.Fatalf("t1 still assigned to %q", task.Assignee)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Fatalf("ben create got %d want 403", code)
+	}
+	// dan became a contributor.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("dan create got %d want 200", code)
+	}
+}
+
+func TestUpdateMembersAtomic(t *testing.T) {
+	h := newServer()
+	// hal is not a member, so the whole request fails and ben stays a contributor.
+	if code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","hal":"viewer"}}`); code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ben should still be contributor, got %d", code)
+	}
+	// last-manager failure also rolls back the other change and task unassignment.
+	if code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","ann":"viewer","ivy":"viewer"}}`); code != 409 {
+		t.Fatalf("got %d want 409", code)
+	}
+	_, b := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(b), &task)
+	if task.Assignee != "ben" {
+		t.Fatalf("t1 assignee changed to %q", task.Assignee)
+	}
+}
