+// OrgScope is bound to one actor and one organization ID. It grants nothing by
+// itself; call User to narrow it to one user.
+type OrgScope interface {
+	ID() string
+	User(userID string) UserScope
+}
+
+// UserScope is bound to one actor, one organization and one user ID.
+type UserScope interface {
+	Manage() (ManageUser, error)
+}
+
+type orgScope struct {
+	as  *actorScope
+	oid string
+}
+
+func (s *orgScope) ID() string { return s.oid }
+func (s *orgScope) User(userID string) UserScope {
+	return &userScope{os: s, uid: userID}
+}
+
+type userScope struct {
+	os  *orgScope
+	uid string
+}
+
+// Manage applies the manage rule: the actor belongs to the organization in the
+// path (else 404), is an org admin of it (else 403), and the user belongs to it
+// (else 404). Org admins are checked before the user lookup so that non-admins
+// learn nothing about who is in the organization.
+func (s *userScope) Manage() (ManageUser, error) {
+	err := s.os.as.a.db.view(func(x *tx) error {
+		act := s.os.as.actor
+		if act.org != s.os.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		if !act.orgAdmin {
+			return deny(ErrForbidden, "forbidden")
+		}
+		u, ok := x.findUser(s.uid)
+		if !ok || u.Org != s.os.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &manageUser{us: s}, nil
+}
+
+// ---- user capabilities ---------------------------------------------------------
+
+// ManageUser may change the organization of one user.
+type ManageUser interface {
+	// Transfer moves the user to toOrgID and removes the user's memberships and
+	// task assignments in projects of the old organization. The whole change is
+	// atomic. An unknown organization or the user's current one is 400.
+	Transfer(toOrgID string) (UserView, error)
+}
+
+type manageUser struct{ us *userScope }
+
+func (m *manageUser) Transfer(toOrgID string) (UserView, error) {
+	if toOrgID == "" {
+		return UserView{}, deny(ErrInvalid, "toOrgId is required")
+	}
+	var v UserView
+	err := m.us.os.as.a.db.update(func(x *tx) error {
+		agg, err := loadTransferUser(x, m.us.uid, toOrgID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		v = agg.apply(x)
+		return nil
+	})
+	return v, err
+}
+
