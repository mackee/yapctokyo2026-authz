index 1c6ebfe..e9586e8 100644
--- a/internal/capability/aggregate.go
+++ b/internal/capability/aggregate.go
@@ -118,3 +118,58 @@ func loadDeleteTask(x *tx, taskID string) (*deleteTaskAggregate, error) {
 func (a *deleteTaskAggregate) validate() error { return nil }
 
 func (a *deleteTaskAggregate) apply(x *tx) { a.task.Destroy(x) }
+
+// transferUserAggregate moves one user to another organization.
+//
+// The user's project memberships are in the old organization's projects, which
+// would break "project members belong to the project's organization", so they
+// are removed. Tasks assigned to the user in those projects are unassigned,
+// which keeps "an assignee is a member of the task's project".
+type transferUserAggregate struct {
+	user            userRecord
+	toOrg           orgRecord
+	dropMemberships []membershipRecord
+	unassign        []taskRecord
+}
+
+func loadTransferUser(x *tx, userID, toOrgID string) (*transferUserAggregate, error) {
+	u, ok := x.findUser(userID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	to, ok := x.findOrg(toOrgID)
+	if !ok {
+		return nil, deny(ErrInvalid, "unknown organization")
+	}
+	a := &transferUserAggregate{user: u, toOrg: to}
+	for _, m := range u.Memberships(x) {
+		if p, ok := m.Project(x); ok && p.Org != to.ID {
+			a.dropMemberships = append(a.dropMemberships, m)
+		}
+	}
+	for _, t := range u.AssignedTasks(x) {
+		if p, ok := t.Project(x); !ok || p.Org != to.ID {
+			a.unassign = append(a.unassign, t)
+		}
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if a.user.Org == a.toOrg.ID {
+		return deny(ErrInvalid, "user already belongs to that organization")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(x *tx) UserView {
+	for _, m := range a.dropMemberships {
+		m.Remove(x)
+	}
+	for _, t := range a.unassign {
+		t.Unassign(x)
+	}
+	u := a.user
+	u.MoveTo(x, a.toOrg.ID)
+	return u.view()
+}
