+func TestUpdateMemberRoles(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager", "ann", "web", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"org admin without role", "eve", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"cat":"viewer"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"cat":"viewer"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"cat":"viewer"}}`, 401},
+		{"unknown user", "zed", "web", `{"roles":{"cat":"viewer"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"bad json", "ann", "web", `{"roles":`, 400},
+		{"invalid role", "ann", "web", `{"roles":{"ben":"owner"}}`, 400},
+		{"non member target", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"partial non member target", "ann", "web", `{"roles":{"ben":"viewer","hal":"viewer"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRolesResponse(t *testing.T) {
+	srv := newServer()
+	code, body := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []member{
+		{"ann", "manager"}, {"ben", "viewer"}, {"cat", "contributor"},
+		{"dan", "contributor"}, {"ivy", "manager"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("row %d: got %v want %v", i, got[i], want[i])
+		}
+	}
+	// dan is now a contributor, so may create tasks.
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("dan create after promotion: got %d", code)
+	}
+}
+
+func TestUpdateMemberRolesIsAtomic(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","hal":"viewer"}}`); code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	if code, _ := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"cat":"viewer","ben":"nope"}}`); code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	// Neither failed request may have changed ben or cat.
+	code, body := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"ivy":"manager"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []member
+	json.Unmarshal([]byte(body), &got)
+	for _, m := range got {
+		if (m.UserID == "ben" || m.UserID == "cat") && m.Role != "contributor" {
+			t.Fatalf("%s changed to %s by a failed request", m.UserID, m.Role)
+		}
+	}
+}
