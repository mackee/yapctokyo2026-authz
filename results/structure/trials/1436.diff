+// UserTableTransferInput is the input of UserTable.Transfer.
+type UserTableTransferInput struct {
+	UserID  string
+	ToOrgID string
+}
+
+// Transfer moves a user of the authorized organization to another
+// organization: their project memberships (all in projects of the old
+// organization) are dropped, tasks assigned to them are unassigned, and the
+// org admin flag is cleared.
+func (*UserTable) Transfer(ctx context.Context, db DB, authz OrgAuthz, in UserTableTransferInput) (*User, error) {
+	if err := authz.CanTransfer(); err != nil {
+		return nil, err
+	}
+	if in.ToOrgID == "" {
+		return nil, deny(ErrInvalid, "toOrgId must not be empty")
+	}
+	var u *User
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadTransferUser(ctx, tx, authz.OrgID(), in)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if u, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return u, nil
+}
