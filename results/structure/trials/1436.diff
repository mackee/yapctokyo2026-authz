+// transferUserAggregate moves one user to another organization. Project
+// memberships of the user are dropped (the projects stay in the old
+// organization) and the tasks assigned through them are unassigned.
+type transferUserAggregate struct {
+	user    *User
+	toOrg   string
+	dropped []*Membership      // memberships in projects outside toOrg
+	tasks   map[string][]*Task // by project ID: tasks assigned to the user
+}
+
+func loadTransferUser(ctx context.Context, tx DB, orgID string, in UserTableTransferInput) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, in.UserID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != orgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if in.ToOrgID == orgID {
+		return nil, deny(ErrInvalid, "user already belongs to that organization")
+	}
+	ok, err := NewUserTable().OrgExists(ctx, tx, in.ToOrgID)
+	if err != nil {
+		return nil, err
+	}
+	if !ok {
+		return nil, deny(ErrInvalid, "unknown organization")
+	}
+	a := &transferUserAggregate{user: u, toOrg: in.ToOrgID, tasks: map[string][]*Task{}}
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, m := range ms {
+		p, err := m.Project(ctx, tx)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "membership must belong to an existing project")
+		} else if err != nil {
+			return nil, err
+		}
+		if p.Org == a.toOrg {
+			continue
+		}
+		ts, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.dropped = append(a.dropped, m)
+		a.tasks[m.ProjectID] = ts
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if a.toOrg == "" || a.toOrg == a.user.Org {
+		return deny(ErrInvalid, "user must move to a different organization")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	for _, m := range a.dropped {
+		for _, t := range a.tasks[m.ProjectID] {
+			if err := t.unassign(ctx, tx); err != nil {
+				return nil, err
+			}
+		}
+		if err := m.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.user.moveTo(ctx, tx, a.toOrg); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
+
