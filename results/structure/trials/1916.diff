+// OrgExists reports whether the organization has any user or project.
+func (*UserTable) OrgExists(ctx context.Context, db DB, org string) (bool, error) {
+	var one int
+	err := db.QueryRowContext(ctx,
+		`SELECT 1 FROM users WHERE org_id = ? UNION SELECT 1 FROM projects WHERE org_id = ?`, org, org).Scan(&one)
+	if errors.Is(err, sql.ErrNoRows) {
