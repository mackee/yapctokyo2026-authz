+// transferUserAggregate moves one user to another organization. The user
+// leaves every project of the old organization: their memberships are removed
+// and the tasks assigned to them there are unassigned.
+type transferUserAggregate struct {
+	user      *User
+	toOrg     string
+	leaving   []*Membership      // memberships in projects outside toOrg
+	unassigns map[string][]*Task // by project ID: tasks assigned to the user there
+}
+
+func loadTransferUser(ctx context.Context, tx DB, orgID, userID, toOrg string) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) || (err == nil && u.Org != orgID) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &transferUserAggregate{user: u, toOrg: toOrg, unassigns: map[string][]*Task{}}
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, m := range ms {
+		p, err := m.Project(ctx, tx)
+		if errors.Is(err, ErrNoRows) {
+			// membership of a missing project: nothing to keep.
+		} else if err != nil {
+			return nil, err
+		} else if p.Org == toOrg {
+			continue
+		}
+		ts, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.leaving = append(a.leaving, m)
+		a.unassigns[m.ProjectID] = ts
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if a.toOrg == "" {
+		return deny(ErrInvalid, "toOrgId must not be empty")
+	}
+	if a.toOrg == a.user.Org {
+		return deny(ErrInvalid, "user already belongs to that organization")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	for _, m := range a.leaving {
+		for _, t := range a.unassigns[m.ProjectID] {
+			if err := t.unassign(ctx, tx); err != nil {
+				return nil, err
+			}
+		}
+		if err := m.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.user.moveToOrg(ctx, tx, a.toOrg); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
+
