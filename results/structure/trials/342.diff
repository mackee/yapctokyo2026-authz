+	// ivy is also a manager of ops, which was not frozen.
+	if code, _ := do(t, srv, "PATCH", "/projects/ops/tasks/t4", "ivy", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ops write after web freeze: got %d want 200", code)
+	}
+}
