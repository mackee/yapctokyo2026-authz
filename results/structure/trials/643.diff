+// updateRolesAggregate changes the roles of several members of one project.
+// Members demoted to viewer lose the tasks assigned to them, because only
+// contributors and managers may be assignees.
+type updateRolesAggregate struct {
+	project *Project
+	members []*Membership      // the members to change, ordered by user ID
+	roles   map[string]string  // user ID -> new role
+	tasks   map[string][]*Task // user ID -> tasks assigned to that member
+}
+
+func loadUpdateRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*updateRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	all, err := p.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	a := &updateRolesAggregate{project: p, roles: roles, tasks: map[string][]*Task{}}
+	for _, m := range all { // ordered by user ID
+		if _, ok := roles[m.UserID]; !ok {
+			continue
+		}
+		a.members = append(a.members, m)
+		if tasks, err := m.AssignedTasks(ctx, tx); err != nil {
+			return nil, err
+		} else {
+			a.tasks[m.UserID] = tasks
+		}
+	}
+	return a, nil
+}
+
+func (a *updateRolesAggregate) validate() error {
+	if len(a.roles) == 0 {
+		return deny(ErrInvalid, "roles must not be empty")
+	}
+	for _, role := range a.roles {
+		if role != RoleManager && role != RoleContributor && role != RoleViewer {
+			return deny(ErrInvalid, "role must be manager, contributor or viewer")
+		}
+	}
+	if len(a.members) != len(a.roles) {
+		return deny(ErrInvalid, "every user must be a member of the project")
+	}
+	return nil
+}
+
+func (a *updateRolesAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for _, m := range a.members {
+		m.Role = a.roles[m.UserID]
+		if err := m.save(ctx, tx); err != nil {
+			return nil, err
+		}
+		if isWriterRole(m.Role) {
+			continue
+		}
+		for _, t := range a.tasks[m.UserID] {
+			if err := t.unassign(ctx, tx); err != nil {
+				return nil, err
+			}
+		}
+	}
+	return a.project.Memberships(ctx, tx)
+}
+
