+func TestUpdateMemberRoles(t *testing.T) {
+	t.Run("bulk change returns members", func(t *testing.T) {
+		h := newServer()
+		code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+		if code != 200 {
+			t.Fatalf("got %d: %s", code, body)
+		}
+		var got []Member
+		if err := json.Unmarshal([]byte(body), &got); err != nil {
+			t.Fatal(err)
+		}
+		want := []Member{{"ann", "manager"}, {"ben", "viewer"}, {"cat", "contributor"}, {"dan", "contributor"}, {"ivy", "manager"}}
+		if len(got) != len(want) {
+			t.Fatalf("got %v want %v", got, want)
+		}
+		for i := range want {
+			if got[i] != want[i] {
+				t.Fatalf("got %v want %v", got, want)
+			}
+		}
+		// dan can now write; ben (demoted) lost the task assigned to them.
+		if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+			t.Fatalf("dan create: got %d", code)
+		}
+		_, task := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+		if !strings.Contains(task, `"assignee":""`) {
+			t.Fatalf("t1 should be unassigned: %s", task)
+		}
+	})
+
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"contributor forbidden", "ben", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 403},
+		{"viewer forbidden", "dan", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin forbidden", "eve", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 403},
+		{"non member", "hal", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 404},
+		{"anonymous", "", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 401},
+		{"archived", "ann", "/projects/legacy/members", `{"roles":{"ben":"viewer"}}`, 409},
+		{"invalid role", "ann", "/projects/web/members", `{"roles":{"ben":"admin"}}`, 400},
+		{"empty roles", "ann", "/projects/web/members", `{"roles":{}}`, 400},
+		{"malformed body", "ben", "/projects/web/members", `{`, 400},
+		{"non member target", "ann", "/projects/web/members", `{"roles":{"ben":"viewer","hal":"viewer"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+		})
+	}
+
+	t.Run("all or nothing", func(t *testing.T) {
+		h := newServer()
+		if code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","hal":"viewer"}}`); code != 400 {
+			t.Fatalf("got %d want 400", code)
+		}
+		// ben is still a contributor, so can still edit own task.
+		if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"doing"}`); code != 200 {
+			t.Fatalf("ben should still be contributor, got %d", code)
+		}
+	})
+}
