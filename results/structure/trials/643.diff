+func updateMemberRoles(ctx tanukirpc.Context[*projectRegistry], req updateMemberRolesRequest) ([]Member, error) {
+	reg := ctx.Registry()
+	ms, err := model.NewMembershipTable().UpdateRoles(ctx, reg.db, reg.authz, req.Roles)
