+  // POST /projects/{pid}/tasks/{tid}/move {"toProjectId": target}
+  // Moving takes the task out of p, so the caller needs the same rights as
+  // editing it in p (managers: any task; contributors: own tasks only), and
+  // must be able to write to the target. The assignee must remain a writer of
+  // the target project, since the invariant inv_assigneeIsWriter must hold.
+  def moveOutcome(u: UserId, p: ProjectId, t: TaskId, target: ProjectId): int =
+    if (not(userExists(u))) 401
+    else if (not(canRead(u, p))) 404
+    else if (not(taskExists(t)) or tasks.get(t).project != p) 404
+    else if (not(isWriter(p, u))) 403
+    else if (roleOf(p, u) == "contributor" and tasks.get(t).assignee != u) 403
+    else if (projects.get(p).archived) 409
+    else if (target == p) 400
+    else if (not(projectExists(target)) or not(canRead(u, target))) 404
+    else if (not(isWriter(target, u))) 403
+    else if (projects.get(target).archived) 409
+    else if (tasks.get(t).assignee != "" and not(isWriter(target, tasks.get(t).assignee))) 400
+    else 200
+
