+func TestMoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, project, member, body string
+		want                              int
+	}{
+		{"manager moves contributor", "ivy", "web", "ben", `{"toProjectId":"ops"}`, 200},
+		{"manager moves viewer keeps role", "ivy", "web", "dan", `{"toProjectId":"ops"}`, 200},
+		{"contributor cannot move", "ben", "web", "dan", `{"toProjectId":"ops"}`, 403},
+		{"viewer cannot move", "dan", "web", "cat", `{"toProjectId":"ops"}`, 403},
+		{"org admin without role cannot move", "eve", "web", "ben", `{"toProjectId":"ops"}`, 403},
+		{"manager of source but viewer of destination", "ann", "web", "dan", `{"toProjectId":"ops"}`, 403},
+		{"non member of source", "hal", "web", "ben", `{"toProjectId":"ops"}`, 404},
+		{"other org", "gus", "web", "ben", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "web", "ben", `{"toProjectId":"ops"}`, 401},
+		{"unknown user", "zed", "web", "ben", `{"toProjectId":"ops"}`, 401},
+		{"missing source project", "ivy", "nope", "ben", `{"toProjectId":"ops"}`, 404},
+		{"missing destination project", "ivy", "web", "ben", `{"toProjectId":"nope"}`, 404},
+		{"destination in other org", "ivy", "web", "ben", `{"toProjectId":"gx"}`, 404},
+		{"user not a member of source", "ivy", "web", "hal", `{"toProjectId":"ops"}`, 404},
+		{"already a member of destination", "ivy", "web", "cat", `{"toProjectId":"ops"}`, 409},
+		{"archived source", "ann", "legacy", "ben", `{"toProjectId":"ops"}`, 409},
+		{"archived destination", "ann", "web", "dan", `{"toProjectId":"legacy"}`, 409},
+		{"same project", "ivy", "web", "ben", `{"toProjectId":"web"}`, 400},
+		{"missing toProjectId", "ivy", "web", "ben", `{}`, 400},
+		{"invalid body", "ivy", "web", "ben", `not json`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			path := "/projects/" + c.project + "/members/" + c.member + "/move"
+			code, _ := do(t, newServer(), "POST", path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveMemberResponseAndState(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("response is not a JSON object: %v: %s", err, body)
+	}
+	want := map[string]string{"userId": "ben", "projectId": "ops", "role": "contributor"}
+	if len(got) != len(want) {
+		t.Fatalf("response %s, want fields %v", body, want)
+	}
+	for k, v := range want {
+		if got[k] != v {
+			t.Fatalf("response field %s = %q, want %q (body %s)", k, got[k], v, body)
+		}
+	}
+
+	// ben is no longer a member of web, and is now a member of ops.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reading web after move: got %d want 404", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben reading ops after move: got %d want 200", code)
+	}
+
+	// t1 was assigned to ben in web; ben is no longer a member there, so it is unassigned.
+	code, body = do(t, h, "GET", "/projects/web/tasks/t1", "ivy", "")
+	if code != 200 {
+		t.Fatalf("get t1: got %d: %s", code, body)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.Assignee != "" {
+		t.Fatalf("t1 still assigned to %q after ben moved out", task.Assignee)
+	}
+}
