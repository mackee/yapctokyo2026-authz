+// ---- member capabilities -----------------------------------------------------------
+
+// MemberView is the public representation of a project membership.
+type MemberView struct {
+	UserID    string `json:"userId"`
+	ProjectID string `json:"projectId"`
+	Role      string `json:"role"`
+}
+
+// MemberScope is bound to one actor, one project and one member user ID.
+type MemberScope interface {
+	// Move acquires the right to move this member out of the project and into
+	// toProjectID. The actor must manage both projects.
+	Move(toProjectID string) (MoveMember, error)
+}
+
+// MoveMember may move one member from one project to another, keeping the role.
+type MoveMember interface {
+	Apply() (MemberView, error)
+}
+
+type memberScope struct {
+	ps  *projectScope
+	uid string
+}
+
+// Move applies the move rule: the source is readable and the actor manages it
+// (else 404 / 403), the source is not archived (else 409), the user is a member
+// of the source (else 404), the destination is a different project, readable,
+// managed by the actor and not archived (else 400 / 404 / 403 / 409), and the
+// user is not already a member of the destination (else 400).
+func (s *memberScope) Move(toProjectID string) (MoveMember, error) {
+	err := s.ps.as.a.st.read(func(st *state) error {
+		src, role, err := readable(st, s.ps.as.actor, s.ps.pid)
+		if err != nil {
+			return err
+		}
+		if role != RoleManager {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if src.archived {
+			return deny(ErrArchived, "project is archived")
+		}
+		if st.role(s.ps.pid, s.uid) == "" {
+			return deny(ErrNotFound, "not found")
+		}
+		if toProjectID == s.ps.pid {
+			return deny(ErrInvalid, "destination must be a different project")
+		}
+		dst, dstRole, err := readable(st, s.ps.as.actor, toProjectID)
+		if err != nil {
+			return err
+		}
+		if dstRole != RoleManager {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if dst.archived {
+			return deny(ErrArchived, "project is archived")
+		}
+		if st.role(toProjectID, s.uid) != "" {
+			return deny(ErrInvalid, "user is already a member of the destination project")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &moveMember{ms: s, to: toProjectID}, nil
+}
+
+type moveMember struct {
+	ms *memberScope
+	to string
+}
+
+// Apply moves the member in one transaction. The role is kept. Tasks in the
+// source project that were assigned to the user become unassigned, because an
+// assignee must be a member of the task's project.
+func (m *moveMember) Apply() (MemberView, error) {
+	src, dst, uid := m.ms.ps.pid, m.to, m.ms.uid
+	var v MemberView
+	err := m.ms.ps.as.a.st.tx(func(s *state) error {
+		role := s.role(src, uid)
+		if role == "" {
+			return deny(ErrNotFound, "not found")
+		}
+		if s.role(dst, uid) != "" {
+			return deny(ErrInvalid, "user is already a member of the destination project")
+		}
+		delete(s.members[src], uid)
+		if s.members[dst] == nil {
+			s.members[dst] = map[string]string{}
+		}
+		s.members[dst][uid] = role
+		for id, t := range s.tasks {
+			if t.project == src && t.assignee.user == uid {
+				t.assignee = Assignee{project: src}
+				s.tasks[id] = t
+			}
+		}
+		v = MemberView{UserID: uid, ProjectID: dst, Role: role}
+		return nil
+	})
+	return v, err
+}
