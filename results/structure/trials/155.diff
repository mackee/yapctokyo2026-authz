+type moveRequest struct {
+	ToProjectID string `json:"toProjectId"`
+}
+
+// moveMember moves {uid} from the path project to toProjectId. The destination
+// is part of the access decision, so the body is read before the capability is
+// acquired; a missing destination is a request-shape error.
+func moveMember(ctx tanukirpc.Context[*projectRegistry], _ struct{}) (*capability.MemberView, error) {
+	var req moveRequest
+	if err := decodeBody(ctx.Request(), &req); err != nil || req.ToProjectID == "" {
+		return nil, errInvalidBody
+	}
+	m, err := ctx.Registry().scope.Member(chi.URLParam(ctx.Request(), "uid")).Move(req.ToProjectID)
+	if err != nil {
+		return nil, err
+	}
+	v, err := m.Apply()
+	if err != nil {
+		return nil, err
+	}
+	return &v, nil
+}
