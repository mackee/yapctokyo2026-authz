+// transferUserAggregate moves one user from fromOrg to toOrgID.
+type transferUserAggregate struct {
+	user    *User
+	fromOrg string
+	toOrgID string
+}
+
+func loadTransferUser(ctx context.Context, tx DB, fromOrg string, in UserTableTransferInput) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, in.UserID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != fromOrg {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if in.ToOrgID == fromOrg {
+		return nil, deny(ErrInvalid, "user is already in that organization")
+	}
+	if _, err := NewOrgTable().Find(ctx, tx, in.ToOrgID); errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "unknown organization")
+	} else if err != nil {
+		return nil, err
+	}
+	return &transferUserAggregate{user: u, fromOrg: fromOrg, toOrgID: in.ToOrgID}, nil
+}
+
+func (a *transferUserAggregate) validate() error { return nil }
+
+// apply drops the user's memberships in the old organization's projects, and
+// unassigns the tasks they hold in those projects (projects are org-scoped, so
+// a member must belong to the project's organization). Then it moves the user.
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	memberships, err := a.user.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, m := range memberships {
+		p, err := m.Project(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		if p.Org != a.fromOrg {
+			continue
+		}
+		tasks, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		for _, t := range tasks {
+			if err := t.unassign(ctx, tx); err != nil {
+				return nil, err
+			}
+		}
+		if err := m.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	a.user.Org = a.toOrgID
+	a.user.OrgAdmin = false
+	if err := a.user.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
+
