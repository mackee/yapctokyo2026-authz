+// FreezeProject marks the project frozen and demotes every member to viewer.
+func (s *Store) FreezeProject(projectID string) {
+	s.projects[projectID].Frozen = true
+	for userID := range s.members[projectID] {
+		s.members[projectID][userID] = RoleViewer
+	}
+}
+
+// Members returns the project's members sorted by user ID.
+func (s *Store) Members(projectID string) []Membership {
+	out := make([]Membership, 0, len(s.members[projectID]))
+	for userID, role := range s.members[projectID] {
+		out = append(out, Membership{UserID: userID, Role: role})
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].UserID < out[j].UserID })
+	return out
+}
