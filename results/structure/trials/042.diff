+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"other manager", "ivy", "ops", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+		{"unknown project", "ann", "nope", 404},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+	want := `[{"userId":"ann","role":"viewer"},{"userId":"ben","role":"viewer"},{"userId":"cat","role":"viewer"},{"userId":"dan","role":"viewer"},{"userId":"ivy","role":"viewer"}]`
+	if strings.TrimSpace(body) != want {
+		t.Fatalf("body mismatch\n got: %s\nwant: %s", strings.TrimSpace(body), want)
+	}
+}
+
+func TestFreezeOnlyAffectsProject(t *testing.T) {
+	h := newServer()
+	do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	// ops is untouched: ivy is still a manager there.
+	code, _ := do(t, h, "PATCH", "/projects/ops/tasks/t4", "ivy", `{"status":"done"}`)
+	if code != 200 {
+		t.Fatalf("ops write after web freeze: got %d want 200", code)
+	}
+	// ann was demoted in web, so she can no longer freeze it again.
+	code, _ = do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 403 {
+		t.Fatalf("second freeze by demoted manager: got %d want 403", code)
+	}
+}
+
+func TestFrozenProjectRejectsTaskWrites(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d want 200", code)
+	}
+	cases := []struct {
+		name, user, method, path, body string
+		want                           int
+	}{
+		{"former manager patch", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"former manager ivy patch", "ivy", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"former contributor own patch", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`, 403},
+		{"former manager create", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"former manager delete", "ann", "DELETE", "/projects/web/tasks/t1", "", 403},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, h, c.method, c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+	// Reads still work.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "dan", ""); code != 200 {
+		t.Fatalf("list after freeze: got %d want 200", code)
+	}
+	// Tasks are unchanged.
+	if _, body := do(t, h, "GET", "/projects/web/tasks/t2", "dan", ""); !strings.Contains(body, `"status":"doing"`) {
+		t.Fatalf("task t2 changed after freeze: %s", body)
+	}
+}
+
+func TestFrozenFlagRejectsWritesRegardlessOfRole(t *testing.T) {
+	// Roles alone already block writes after a freeze; the frozen flag
+	// must also block them independently of roles.
+	st := newSeededStore()
+	st.projects["web"].Frozen = true
+	h := newServerWithStore(st)
+	cases := []struct {
+		name, user, method, path, body string
+		want                           int
+	}{
+		{"manager patch", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 409},
+		{"manager create", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`, 409},
+		{"manager delete", "ann", "DELETE", "/projects/web/tasks/t1", "", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, h, c.method, c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeOrgAdminReadStillWorks(t *testing.T) {
+	h := newServer()
+	do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "eve", ""); code != 200 {
+		t.Fatalf("org admin read after freeze: got %d want 200", code)
