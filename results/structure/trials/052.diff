+
+type membersRequest struct {
+	Roles map[string]string `json:"roles"` // userID -> new role
+}
+
+func (s *server) updateMembers(w http.ResponseWriter, r *http.Request) {
+	s.store.mu.Lock()
+	defer s.store.mu.Unlock()
+
+	user := s.store.User(r.Header.Get("X-User"))
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project := s.store.Project(r.PathValue("pid"))
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role := s.store.Role(project.ID, user.ID)
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req membersRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || len(req.Roles) == 0 {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+
+	// Validate every entry before changing anything, so the batch is all-or-nothing.
+	userIDs := make([]string, 0, len(req.Roles))
+	for uid := range req.Roles {
+		userIDs = append(userIDs, uid)
+	}
+	sort.Strings(userIDs)
+	for _, uid := range userIDs {
+		newRole := req.Roles[uid]
+		if newRole != RoleManager && newRole != RoleContributor && newRole != RoleViewer {
+			writeError(w, 400, "invalid role for "+uid)
+			return
+		}
+		if s.store.Role(project.ID, uid) == "" {
+			writeError(w, 400, uid+" is not a member of the project")
+			return
+		}
+	}
+	for _, uid := range userIDs {
+		s.store.members[project.ID][uid] = req.Roles[uid]
+	}
+	writeJSON(w, 200, s.store.MembersOf(project.ID))
+}
diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..e027b31
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,106 @@
+package main
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func TestUpdateMembersAuthz(t *testing.T) {
+	body := `{"roles":{"ben":"viewer"}}`
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMembersBatch(t *testing.T) {
+	s := newServer()
+	code, body := do(t, s, "PUT", "/projects/web/members", "ann",
+		`{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []Member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []Member{
+		{UserID: "ann", Role: "manager"},
+		{UserID: "ben", Role: "viewer"},
+		{UserID: "cat", Role: "contributor"},
+		{UserID: "dan", Role: "contributor"},
+		{UserID: "ivy", Role: "manager"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %d members, want %d: %s", len(got), len(want), body)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("member %d: got %+v want %+v", i, got[i], want[i])
+		}
+	}
+	if !strings.Contains(body, `{"userId":"ben","role":"viewer"}`) {
+		t.Fatalf("unexpected JSON shape: %s", body)
+	}
+
+	// The change persists: dan (now contributor) can write, ben (now viewer) cannot.
+	code, _ = do(t, s, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`)
+	if code != 201 {
+		t.Fatalf("dan should be a contributor now, got %d", code)
+	}
+	code, _ = do(t, s, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`)
+	if code != 403 {
+		t.Fatalf("ben should be a viewer now, got %d", code)
+	}
+}
+
+func TestUpdateMembersRejectsWholeBatch(t *testing.T) {
+	cases := []struct {
+		name, body string
+	}{
+		{"invalid role", `{"roles":{"ben":"viewer","cat":"owner"}}`},
+		{"non member target", `{"roles":{"ben":"viewer","hal":"viewer"}}`},
+		{"unknown user target", `{"roles":{"ben":"viewer","zed":"viewer"}}`},
+		{"empty roles", `{"roles":{}}`},
+		{"missing roles", `{}`},
+		{"malformed json", `{"roles":`},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			s := newServer()
+			code, _ := do(t, s, "PUT", "/projects/web/members", "ann", c.body)
+			if code != 400 {
+				t.Fatalf("got %d want 400", code)
+			}
+			// Nothing changed: ben is still a contributor. A follow-up no-op-style
+			// change returns the full list, which shows the current state.
+			code, body := do(t, s, "PUT", "/projects/web/members", "ann", `{"roles":{"cat":"contributor"}}`)
+			if code != 200 {
+				t.Fatalf("follow-up got %d", code)
+			}
+			if !strings.Contains(body, `{"userId":"ben","role":"contributor"}`) ||
+				!strings.Contains(body, `{"userId":"cat","role":"contributor"}`) {
+				t.Fatalf("partial change leaked: %s", body)
+			}
+		})
+	}
+}
