@@ -51,6 +51,22 @@ func (s *Store) Project(id string) *Project { return s.projects[id] }
 
 func (s *Store) Role(projectID, userID string) string { return s.members[projectID][userID] }
 
+// Member is one project membership entry.
+type Member struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// MembersOf returns the members of a project sorted by user ID.
+func (s *Store) MembersOf(projectID string) []Member {
+	out := []Member{}
+	for uid, role := range s.members[projectID] {
+		out = append(out, Member{UserID: uid, Role: role})
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].UserID < out[j].UserID })
+	return out
+}
+
