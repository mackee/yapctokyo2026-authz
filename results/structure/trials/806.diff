+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager both, others' task", "ivy", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 200},
+		{"contributor both, own task", "cat", "/projects/ops/tasks/t4", `{"toProjectId":"web"}`, 200},
+		{"contributor both, others' task", "cat", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"manager src, viewer dest", "ann", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"viewer src", "ann", "/projects/ops/tasks/t4", `{"toProjectId":"web"}`, 403},
+		{"org admin", "eve", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"non member", "hal", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 404},
+		{"other org source", "gus", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 404},
+		{"dest non member", "ivy", "/projects/web/tasks/t1", `{"toProjectId":"legacy"}`, 404},
+		{"dest other org", "ann", "/projects/web/tasks/t1", `{"toProjectId":"gx"}`, 404},
+		{"dest missing", "ann", "/projects/web/tasks/t1", `{"toProjectId":"nope"}`, 404},
+		{"task in other project", "ann", "/projects/web/tasks/t4", `{"toProjectId":"ops"}`, 404},
+		{"same project", "ivy", "/projects/web/tasks/t1", `{"toProjectId":"web"}`, 400},
+		{"missing toProjectId", "ann", "/projects/web/tasks/t1", `{}`, 400},
+		{"bad json", "ann", "/projects/web/tasks/t1", `nope`, 400},
+		{"anonymous", "", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 401},
+		{"archived dest", "ann", "/projects/web/tasks/t1", `{"toProjectId":"legacy"}`, 409},
+		{"archived src", "ben", "/projects/legacy/tasks/t5", `{"toProjectId":"web"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveMixedRolesNeedsOwnTask(t *testing.T) {
+	// ann is a manager in web but a contributor in ops: the "both managers"
+	// exception does not apply, so she may only move tasks assigned to her.
+	db, err := openSeededDB()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := db.Exec(`UPDATE memberships SET role = 'contributor' WHERE project_id = 'ops' AND user_id = 'ann'`); err != nil {
+		t.Fatal(err)
+	}
+	h := (&server{db: db}).routes()
+	for _, tid := range []string{"t1", "t2", "t3"} {
+		code, _ := do(t, h, "POST", "/projects/web/tasks/"+tid+"/move", "ann", `{"toProjectId":"ops"}`)
+		if code != 403 {
+			t.Fatalf("%s: got %d want 403", tid, code)
+		}
+	}
+}
+
+func TestMoveKeepsTaskFields(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/tasks/t1/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d: %s", code, body)
+	}
+	var got Task
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t1", ProjectID: "ops", Title: "Fix header", Status: "open", Assignee: "ben"}
+	if got != want {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks/t1", "ivy", ""); code != 200 {
+		t.Fatalf("task not readable in destination: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t1", "ivy", ""); code != 404 {
+		t.Fatalf("task still in source: %d", code)
+	}
+}
