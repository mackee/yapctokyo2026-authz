+// updateRolesAggregate changes the roles of several members of one project.
+type updateRolesAggregate struct {
+	project *Project
+	members []*Membership // the members to change, ordered by user ID
+	roles   map[string]string
+	blocked map[string]bool // members that still have assigned tasks in the project
+}
+
+func loadUpdateRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*updateRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &updateRolesAggregate{project: p, roles: roles, blocked: map[string]bool{}}
+	all, err := p.Memberships(ctx, tx) // ordered by user ID
+	if err != nil {
+		return nil, err
+	}
+	for _, m := range all {
+		role, ok := roles[m.UserID]
+		if !ok {
+			continue
+		}
+		a.members = append(a.members, m)
+		if !isWriterRole(role) {
+			tasks, err := m.AssignedTasks(ctx, tx)
+			if err != nil {
+				return nil, err
+			}
+			a.blocked[m.UserID] = len(tasks) > 0
+		}
+	}
+	return a, nil
+}
+
+func (a *updateRolesAggregate) validate() error {
+	if len(a.members) != len(a.roles) {
+		return deny(ErrInvalid, "every user must be a member of the project")
+	}
+	for _, m := range a.members {
+		if r := a.roles[m.UserID]; !validRoles[r] {
+			return deny(ErrInvalid, "role must be manager, contributor or viewer")
+		}
+		if a.blocked[m.UserID] {
+			return deny(ErrInvalid, "assignee must be a contributor or manager of the project: "+m.UserID+" still has assigned tasks")
+		}
+	}
+	return nil
+}
+
+// apply changes the roles and returns the project's members afterwards.
+func (a *updateRolesAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for _, m := range a.members {
+		if err := m.setRole(ctx, tx, a.roles[m.UserID]); err != nil {
+			return nil, err
+		}
+	}
+	return a.project.Memberships(ctx, tx)
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
