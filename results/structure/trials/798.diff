new file mode 100644
index 0000000..40b2537
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,68 @@
+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestUpdateMemberRoles(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ivy":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	want := `[{"userId":"ann","role":"manager"},{"userId":"ben","role":"contributor"},{"userId":"cat","role":"contributor"},{"userId":"dan","role":"contributor"},{"userId":"ivy","role":"viewer"}]`
+	if strings.TrimSpace(body) != want {
+		t.Fatalf("got %s want %s", body, want)
+	}
+	// persisted: the demoted manager can no longer write
+	if code, body := do(t, h, "POST", "/projects/web/tasks", "ivy", `{"title":"x"}`); code != 403 {
+		t.Fatalf("demoted manager: got %d body=%s", code, body)
+	}
+}
+
+func TestUpdateMemberRolesRejected(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"contributor", "ben", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 403},
+		{"manager of another project", "ann", "/projects/ops/members", `{"roles":{"cat":"viewer"}}`, 403},
+		{"org admin non-member", "eve", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 403},
+		{"archived", "ann", "/projects/legacy/members", `{"roles":{"ben":"viewer"}}`, 409},
+		{"unreadable project", "hal", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 404},
+		{"unauthenticated", "", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 401},
+		{"malformed body", "ann", "/projects/web/members", `{"roles":`, 400},
+		{"empty roles", "ann", "/projects/web/members", `{"roles":{}}`, 400},
+		{"invalid role", "ann", "/projects/web/members", `{"roles":{"dan":"owner"}}`, 400},
+		{"non-member", "ann", "/projects/web/members", `{"roles":{"hal":"viewer"}}`, 400},
+		{"demote assignee", "ann", "/projects/web/members", `{"roles":{"ben":"viewer"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+// One bad entry must leave every other entry unchanged.
+func TestUpdateMemberRolesAllOrNothing(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","ben":"viewer"}}`)
+	if code != 400 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	// dan is still a viewer
+	if code, body := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 403 {
+		t.Fatalf("dan: got %d body=%s", code, body)
+	}
+	// ben still holds t1 and can edit it
+	if code, body := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ben: got %d body=%s", code, body)
+	}
+}
