diff --git a/move_test.go b/move_test.go
new file mode 100644
index 0000000..41747a4
--- /dev/null
+++ b/move_test.go
@@ -0,0 +1,89 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestMoveKeepsTaskAndReturnsIt(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got Task
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", AssigneeID: "cat"}
+	if got != want {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks/t2", "ivy", ""); code != 200 {
+		t.Fatalf("task not in destination: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t2", "ivy", ""); code != 404 {
+		t.Fatalf("task still in source: %d", code)
+	}
+}
+
+func TestMoveUnassignedTask(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/tasks/t3/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got Task
+	json.Unmarshal([]byte(body), &got)
+	if got.ProjectID != "ops" || got.AssigneeID != "" || got.Title != "Write copy" || got.Status != "open" {
+		t.Fatalf("unexpected task %+v", got)
+	}
+}
+
+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager in both", "ivy", "/projects/web/tasks/t2/move", `{"toProjectId":"ops"}`, 200},
+		{"assignee not a member of destination", "ivy", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 400},
+		{"viewer in destination", "ann", "/projects/web/tasks/t2/move", `{"toProjectId":"ops"}`, 403},
+		{"contributor in source", "cat", "/projects/web/tasks/t2/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer in source", "dan", "/projects/web/tasks/t2/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin", "eve", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 403},
+		{"non member of source", "hal", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 401},
+		{"task of another project", "ivy", "/projects/web/tasks/t4/move", `{"toProjectId":"ops"}`, 404},
+		{"missing destination", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"nope"}`, 404},
+		{"destination in another org", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"gx"}`, 404},
+		{"archived source to open project", "ann", "/projects/legacy/tasks/t5/move", `{"toProjectId":"ops"}`, 409},
+		{"archived destination", "ann", "/projects/web/tasks/t3/move", `{"toProjectId":"legacy"}`, 409},
+		{"archived source", "ann", "/projects/legacy/tasks/t5/move", `{"toProjectId":"web"}`, 409},
+		{"same project", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"web"}`, 400},
+		{"empty destination", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":""}`, 400},
+		{"missing destination field", "ivy", "/projects/web/tasks/t3/move", `{}`, 400},
+		{"malformed body", "ivy", "/projects/web/tasks/t3/move", `{`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestFailedMoveChangesNothing(t *testing.T) {
+	h := newServer()
+	for _, c := range []struct{ path, user, body string }{
+		{"/projects/web/tasks/t1/move", "ivy", `{"toProjectId":"ops"}`}, // assignee not in ops
+		{"/projects/web/tasks/t2/move", "cat", `{"toProjectId":"ops"}`}, // forbidden
+	} {
+		do(t, h, "POST", c.path, c.user, c.body)
+	}
+	for _, id := range []string{"t1", "t2"} {
+		if code, _ := do(t, h, "GET", "/projects/web/tasks/"+id, "ivy", ""); code != 200 {
+			t.Fatalf("%s left the source project: %d", id, code)
+		}
+	}
+}
