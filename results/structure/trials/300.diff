+
+// ---- organization capabilities -------------------------------------------------
+
+// ManageOrg is the org-admin capability for one organization.
+type ManageOrg interface {
+	// RemoveUser removes a user from every project of the organization (offboarding).
+	// Tasks in those projects that were assigned to the user become unassigned.
+	// The user must belong to the organization (else 404). Removing a user who
+	// is not a member of any project succeeds as a no-op.
+	RemoveUser(userID string) error
+}
+
+type orgScope struct {
+	as  *actorScope
+	oid string
+}
+
+// Manage applies the org-admin rule: the organization must be the actor's own
+// (else 404), and the actor must be an org admin of it (else 403).
+func (s *orgScope) Manage() (ManageOrg, error) {
+	err := s.as.a.st.read(func(*state) error {
+		if s.as.actor.org != s.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		if !s.as.actor.orgAdmin {
+			return deny(ErrForbidden, "forbidden")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &manageOrg{os: s}, nil
+}
+
+type manageOrg struct{ os *orgScope }
+
+func (o *manageOrg) RemoveUser(userID string) error {
+	return o.os.as.a.st.tx(func(s *state) error {
+		u, ok := s.users[userID]
+		if !ok || u.org != o.os.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		for pid, p := range s.projects {
+			if p.org == o.os.oid {
+				delete(s.members[pid], userID)
+			}
+		}
+		for tid, t := range s.tasks {
+			if t.assignee.user != userID {
+				continue
+			}
+			if p, ok := s.projects[t.project]; ok && p.org == o.os.oid {
+				t.assignee = Assignee{project: t.project}
+				s.tasks[tid] = t
+			}
+		}
+		return nil
+	})
+}
