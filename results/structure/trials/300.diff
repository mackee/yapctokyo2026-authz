+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes non member", "eve", "/orgs/acme/users/hal", 204},
+		{"org admin removes viewer", "eve", "/orgs/acme/users/dan", 204},
+		{"org admin removes self", "eve", "/orgs/acme/users/eve", 204},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"same org non admin", "ann", "/orgs/acme/users/ben", 403},
+		{"other org caller", "gus", "/orgs/acme/users/ben", 404},
+		{"admin of other org", "eve", "/orgs/globex/users/gus", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ben", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+
+	// Before: ben is a contributor of web and legacy, and is assigned t1 and t5.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t1", "ann", ""); code != 200 {
+		t.Fatalf("setup: got %d", code)
+	}
+	if got := assigneeOf(t, h, "/projects/web/tasks/t1"); got != "ben" {
+		t.Fatalf("setup: t1 assignee %q", got)
+	}
+
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+
+	// ben is no longer a member of any project of the org.
+	for _, path := range []string{"/projects/web/tasks", "/projects/legacy/tasks", "/projects/web/tasks/t1"} {
+		if code, _ := do(t, h, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("ben GET %s: got %d want 404", path, code)
+		}
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 404 {
+		t.Fatalf("ben PATCH: got %d want 404", code)
+	}
+
+	// Tasks assigned to ben are unassigned in every project of the org...
+	if got := assigneeOf(t, h, "/projects/web/tasks/t1"); got != "" {
+		t.Fatalf("t1 assignee %q, want unassigned", got)
+	}
+	if got := assigneeOf(t, h, "/projects/legacy/tasks/t5"); got != "" {
+		t.Fatalf("t5 assignee %q, want unassigned", got)
+	}
+	// ...and other assignments are untouched.
+	if got := assigneeOf(t, h, "/projects/web/tasks/t2"); got != "cat" {
+		t.Fatalf("t2 assignee %q, want cat", got)
+	}
+	if got := assigneeOf(t, h, "/projects/ops/tasks/t4"); got != "cat" {
+		t.Fatalf("t4 assignee %q, want cat", got)
+	}
+
+	// Remaining members can still write: the store invariants hold after removal.
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ann", `{"status":"done","assignee":"cat"}`); code != 200 {
+		t.Fatalf("manager reassigns after removal: got %d want 200", code)
+	}
+}
+
+// assigneeOf returns the assignee of the task at path, read as ann.
+func assigneeOf(t *testing.T, h http.Handler, path string) string {
+	t.Helper()
+	code, body := do(t, h, "GET", path, "ann", "")
+	if code != 200 {
+		t.Fatalf("GET %s: got %d", path, code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	return task.Assignee
+}
