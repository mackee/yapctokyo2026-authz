+func TestFreeze(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeEffect(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got []map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 5 {
+		t.Fatalf("want 5 members, got %s", body)
+	}
+	for _, m := range got {
+		if m["role"] != "viewer" || m["userId"] == "" {
+			t.Fatalf("bad member %v", m)
+		}
+	}
+	// nobody can write any more, managers included
+	for _, c := range []struct{ user, method, path, body string }{
+		{"ann", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"ivy", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"ann", "DELETE", "/projects/web/tasks/t1", ""},
+		{"ann", "POST", "/projects/web/freeze", ""},
+	} {
+		if code, _ := do(t, h, c.method, c.path, c.user, c.body); code != 403 {
+			t.Fatalf("%s %s by %s: got %d want 403", c.method, c.path, c.user, code)
+		}
+	}
+	// reads still work, other projects are untouched
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ann", ""); code != 200 {
+		t.Fatal(code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`); code != 200 {
+		t.Fatal(code)
+	}
+}
