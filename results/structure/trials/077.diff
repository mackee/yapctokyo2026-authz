+type moveRequest struct {
+	ToProjectID string `json:"toProjectId"`
+}
+
+type moveResponse struct {
+	UserID    string `json:"userId"`
+	ProjectID string `json:"projectId"`
+	Role      string `json:"role"`
+}
+
+// moveMember removes a member from the path project and adds them to
+// toProjectId with the same role, atomically under the store lock.
+func (s *server) moveMember(w http.ResponseWriter, r *http.Request) {
+	s.store.mu.Lock()
+	defer s.store.mu.Unlock()
+
+	user := s.store.User(r.Header.Get("X-User"))
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	from := s.store.Project(r.PathValue("pid"))
+	if from == nil || from.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role := s.store.Role(from.ID, user.ID)
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if from.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req moveRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || req.ToProjectID == "" {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	if req.ToProjectID == from.ID {
+		writeError(w, 400, "target project must differ from the source project")
+		return
+	}
+	to := s.store.Project(req.ToProjectID)
+	if to == nil || to.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	toRole := s.store.Role(to.ID, user.ID)
+	if toRole == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if toRole != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if to.Archived {
+		writeError(w, 409, "target project is archived")
+		return
+	}
+	memberID := r.PathValue("uid")
+	memberRole := s.store.Role(from.ID, memberID)
+	if memberRole == "" {
+		writeError(w, 404, "user is not a member of this project")
+		return
+	}
+	if s.store.Role(to.ID, memberID) != "" {
+		writeError(w, 409, "user is already a member of the target project")
+		return
+	}
+	s.store.RemoveMember(from.ID, memberID)
+	s.store.AddMember(to.ID, memberID, memberRole)
+	writeJSON(w, 200, moveResponse{UserID: memberID, ProjectID: to.ID, Role: memberRole})
+}
