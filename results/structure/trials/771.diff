diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..81b4412
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,61 @@
+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestUpdateMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"contributor cannot", "ben", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"viewer cannot", "dan", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"viewer cannot self-promote in ops", "ann", "/projects/ops/members/ann", `{"role":"manager"}`, 403},
+		{"org admin without role cannot", "eve", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"non-member sees 404", "hal", "/projects/web/members/dan", `{"role":"manager"}`, 404},
+		{"other org sees 404", "gus", "/projects/web/members/dan", `{"role":"manager"}`, 404},
+		{"unknown user 401", "nobody", "/projects/web/members/dan", `{"role":"manager"}`, 401},
+		{"target not a member 404", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"archived project 409", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"invalid role 400", "ann", "/projects/web/members/dan", `{"role":"owner"}`, 400},
+		{"missing role 400", "ann", "/projects/web/members/dan", `{}`, 400},
+		{"malformed body 400 before access", "ben", "/projects/web/members/dan", `{`, 400},
+		{"demote member with assigned tasks 400", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRoleResponseAndEffect(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 || strings.TrimSpace(body) != `{"userId":"dan","role":"contributor"}` {
+		t.Fatalf("got %d %s", code, body)
+	}
+	// dan can now create tasks (was a viewer).
+	if code, body := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("promoted member could not write: %d %s", code, body)
+	}
+	// A failed demotion changes nothing: ben still writes.
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 400 {
+		t.Fatalf("want 400, got %d", code)
+	}
+	if code, body := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ben lost write access: %d %s", code, body)
+	}
+	// Demoted manager loses manager rights.
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ivy", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote failed")
+	}
+	if code, _ := do(t, h, "PUT", "/projects/web/members/dan", "ivy", `{"role":"viewer"}`); code != 403 {
+		t.Fatalf("demoted manager still manages, got %d", code)
+	}
+}
