+// transferUserAggregate moves one user from one organization to another. It
+// removes the user's memberships in projects outside the new organization and
+// unassigns the tasks the user holds in those projects, so the model rules hold
+// after the move.
+type transferUserAggregate struct {
+	user        *User
+	toOrg       string
+	memberships []*Membership // memberships in projects outside toOrg: removed
+	tasks       []*Task       // tasks assigned to the user outside toOrg: unassigned
+	archived    bool          // one of those projects is archived: read-only, so refuse
+}
+
+func loadTransferUser(ctx context.Context, x *Tx, fromOrg, userID, toOrg string) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, x, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != fromOrg {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	ok, err := NewOrgTable().Exists(ctx, x, toOrg)
+	if err != nil {
+		return nil, err
+	}
+	if !ok {
+		return nil, deny(ErrInvalid, "unknown organization")
+	}
+	a := &transferUserAggregate{user: u, toOrg: toOrg}
+	memberships, err := u.Memberships(ctx, x)
+	if err != nil {
+		return nil, err
+	}
+	for _, m := range memberships {
+		p, err := m.Project(ctx, x)
+		if err != nil {
+			return nil, err
+		}
+		if p.Org == toOrg {
+			continue
+		}
+		a.memberships = append(a.memberships, m)
+		a.archived = a.archived || p.Archived
+	}
+	tasks, err := u.AssignedTasks(ctx, x)
+	if err != nil {
+		return nil, err
+	}
+	for _, t := range tasks {
+		p, err := t.Project(ctx, x)
+		if err != nil {
+			return nil, err
+		}
+		if p.Org == toOrg {
+			continue
+		}
+		a.tasks = append(a.tasks, t)
+		a.archived = a.archived || p.Archived
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if a.archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, x *Tx) (*User, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, x); err != nil {
+			return nil, err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, x); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.user.moveTo(ctx, x, a.toOrg); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
