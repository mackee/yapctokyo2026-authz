+// UserTableTransferInput is the input of UserTable.Transfer.
+type UserTableTransferInput struct {
+	ToOrgID string
+}
+
+// Transfer moves the user from the organization of authz to ToOrgID, all or
+// nothing. The user's memberships in projects outside the new organization are
+// removed, and tasks assigned to the user there are unassigned. The user stops
+// being an org admin. Only org admins of the organization may do this.
+func (*UserTable) Transfer(ctx context.Context, db DB, authz OrgAuthz, userID string, in UserTableTransferInput) (*User, error) {
+	if err := authz.CanAdmin(); err != nil {
+		return nil, err
+	}
+	if in.ToOrgID == "" {
+		return nil, deny(ErrInvalid, "toOrgId must not be empty")
+	}
+	if in.ToOrgID == authz.OrgID() {
+		return nil, deny(ErrInvalid, "user already belongs to that organization")
+	}
+	var u *User
+	if err := db.update(ctx, func(x *Tx) error {
+		agg, err := loadTransferUser(ctx, x, authz.OrgID(), userID, in.ToOrgID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if u, err = agg.apply(ctx, x); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return u, nil
+}
