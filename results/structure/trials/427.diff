+	}
+}
+
+func TestTransferRevokesOldOrgAccessAndUnassigns(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/orgs/acme/users/cat/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: got %d: %s", code, body)
+	}
+
+	// cat's acme memberships are gone.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "cat", ""); code != 404 {
+		t.Fatalf("cat reads web: got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "cat", ""); code != 404 {
+		t.Fatalf("cat reads ops: got %d want 404", code)
+	}
+	// cat is not a member of any globex project.
+	if code, _ := do(t, srv, "GET", "/projects/gx/tasks", "cat", ""); code != 404 {
+		t.Fatalf("cat reads gx: got %d want 404", code)
+	}
+
+	// Tasks cat held in acme are unassigned, not left pointing at a non-member.
+	for _, path := range []string{"/projects/web/tasks/t2", "/projects/ops/tasks/t4"} {
+		code, body := do(t, srv, "GET", path, "ann", "")
+		if code != 200 {
+			t.Fatalf("%s: got %d", path, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.AssigneeID != "" {
+			t.Fatalf("%s: still assigned to %q", path, task.AssigneeID)
+		}
+	}
+
+	// Other people's data is untouched.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks/t1", "ann", ""); code != 200 {
+		t.Fatalf("t1 after transfer: got %d", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatalf("gus reads gx: got %d want 200", code)
+	}
+}
+
+func TestTransferFailureChangesNothing(t *testing.T) {
+	srv := newServer()
+	// ben has an active membership in web and an archived one in legacy, so the
+	// whole move is refused.
+	if code, _ := do(t, srv, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 409 {
+		t.Fatalf("transfer: got %d want 409", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben still reads web: got %d want 200", code)
+	}
+	code, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatal(code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "ben" {
+		t.Fatalf("t1 assignee changed to %q", task.AssigneeID)
+	}
+}
+
+func TestTransferDropsOrgAdmin(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
