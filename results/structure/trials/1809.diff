+// Move moves the task to another project. The task keeps its ID, title, status
+// and assignee. The actor must be a manager of the task's project and a
+// contributor or manager of the target project. The target comes from the
+// request body, so its authorization object is built here rather than in a
+// Transformer.
+func (tt *TaskTable) Move(ctx context.Context, db DB, authz TaskAuthz, toProjectID string) (*Task, error) {
+	if err := authz.CanManage(); err != nil {
+		return nil, err
+	}
+	if toProjectID == authz.Project().ProjectID() {
+		return nil, deny(ErrInvalid, "task is already in the project")
+	}
+	target, err := NewProjectAuthz(ctx, db, authz.Project().Actor(), toProjectID)
+	if err != nil {
+		return nil, err
+	}
+	if err := target.CanWrite(); err != nil {
+		return nil, err
+	}
+	var t *Task
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveTask(ctx, tx, authz.TaskID(), toProjectID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if t, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return t, nil
+}
