+func TestChangeMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager promotes viewer", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"manager sets same role", "ann", "/projects/web/members/ivy", `{"role":"manager"}`, 200},
+		{"manager demotes contributor with tasks", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 400},
+		{"manager demotes ops contributor with tasks", "ivy", "/projects/ops/members/cat", `{"role":"viewer"}`, 400},
+		{"contributor", "ben", "/projects/web/members/cat", `{"role":"viewer"}`, 403},
+		{"viewer", "dan", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"org admin", "eve", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"non member", "hal", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"other org", "gus", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"anonymous", "", "/projects/web/members/ben", `{"role":"viewer"}`, 401},
+		{"unknown user", "zed", "/projects/web/members/ben", `{"role":"viewer"}`, 401},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"contributor"}`, 404},
+		{"target in other org", "ann", "/projects/web/members/gus", `{"role":"viewer"}`, 404},
+		{"invalid role", "ann", "/projects/web/members/dan", `{"role":"owner"}`, 400},
+		{"missing role", "ann", "/projects/web/members/dan", `{}`, 400},
+		{"malformed body", "ann", "/projects/web/members/dan", `not json`, 400},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestChangeMemberRoleResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["userId"] != "dan" || got["role"] != "contributor" || len(got) != 2 {
+		t.Fatalf("unexpected body: %s", body)
+	}
+}
+
+func TestChangeMemberRoleTakesEffect(t *testing.T) {
+	srv := newServer()
+	createBody := `{"title":"x"}`
+
+	// dan is a viewer: cannot create tasks.
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "dan", createBody); code != 403 {
+		t.Fatalf("viewer create: got %d want 403", code)
+	}
+	if code, _ := do(t, srv, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`); code != 200 {
+		t.Fatalf("promote: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "dan", createBody); code != 201 {
+		t.Fatalf("contributor create: got %d want 201", code)
+	}
+	// Demotion to viewer is refused while the member has tasks assigned, so
+	// assign dan one first.
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "ann", `{"title":"y","assignee":"dan"}`); code != 201 {
+		t.Fatalf("assign to dan: got %d want 201", code)
+	}
+	if code, body := do(t, srv, "PUT", "/projects/web/members/dan", "ann", `{"role":"viewer"}`); code != 400 {
+		t.Fatalf("demote with tasks: got %d want 400: %s", code, body)
+	}
+	// Rejected demotion changed nothing: dan is still a contributor.
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "dan", createBody); code != 201 {
+		t.Fatalf("after rejected demotion: got %d want 201", code)
+	}
+}
+
+func TestChangeMemberRoleDemoteWithoutTasks(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`); code != 200 {
+		t.Fatalf("promote: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "PUT", "/projects/web/members/dan", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 403 {
+		t.Fatalf("demoted create: got %d want 403", code)
+	}
+}
