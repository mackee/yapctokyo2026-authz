+// changeMemberRoleAggregate changes the role of one project membership.
+type changeMemberRoleAggregate struct {
+	member   membershipRecord // Role already holds the new role
+	assigned []taskRecord     // tasks of the project assigned to the member
+}
+
+func loadChangeMemberRole(x *tx, projectID, userID, role string) (*changeMemberRoleAggregate, error) {
+	m, ok := x.findMembership(projectID, userID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	m.Role = role
+	a := &changeMemberRoleAggregate{member: m}
+	for _, t := range x.tasksIn(projectID) {
+		if t.AssigneeID == userID {
+			a.assigned = append(a.assigned, t)
+		}
+	}
+	return a, nil
+}
+
+func (a *changeMemberRoleAggregate) validate() error {
+	if !isValidRole(a.member.Role) {
+		return deny(ErrInvalid, "role must be manager, contributor or viewer")
+	}
+	if !isWriterRole(a.member.Role) && len(a.assigned) > 0 {
+		return deny(ErrInvalid, "member has tasks assigned in this project; reassign them before making the member a viewer")
+	}
+	return nil
+}
+
+func (a *changeMemberRoleAggregate) save(x *tx) MemberView {
+	a.member.save(x)
+	return MemberView{UserID: a.member.UserID, Role: a.member.Role}
+}
