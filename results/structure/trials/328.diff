+// ManageProject may manage the membership of one project.
+type ManageProject interface {
+	ReadProject
+	// ChangeMemberRole sets the role of an existing member. A user who is not
+	// a member of this project is 404. A new role that is not manager,
+	// contributor or viewer is 400, and so is demoting a member to viewer while
+	// they still have tasks assigned in this project.
+	ChangeMemberRole(userID, role string) (MemberView, error)
+}
+
+type manageProject struct {
+	readProject
+}
+
+func (p *manageProject) ChangeMemberRole(userID, role string) (MemberView, error) {
+	var v MemberView
+	err := p.ps.as.a.db.update(func(x *tx) error {
+		agg, err := loadChangeMemberRole(x, p.ps.pid, userID, role)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		v = agg.save(x)
+		return nil
+	})
+	return v, err
+}
