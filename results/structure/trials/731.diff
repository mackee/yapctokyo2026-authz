+// updateMemberRoleAggregate changes the role of one member of one project.
+type updateMemberRoleAggregate struct {
+	project    *Project
+	membership *Membership // the member, found through the project
+	member     *User       // the member's user, for the organization rule
+	role       string
+}
+
+func loadUpdateMemberRole(ctx context.Context, tx DB, projectID string, in MembershipTableUpdateRoleInput) (*updateMemberRoleAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	m, err := p.Membership(ctx, tx, in.UserID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "member not found")
+	} else if err != nil {
+		return nil, err
+	}
+	u, err := m.User(ctx, tx)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "member must be a user of the project's organization")
+	} else if err != nil {
+		return nil, err
+	}
+	return &updateMemberRoleAggregate{project: p, membership: m, member: u, role: in.Role}, nil
+}
+
+func (a *updateMemberRoleAggregate) validate() error {
+	// Project members are users of the project's organization.
+	if a.member.Org != a.project.Org {
+		return deny(ErrInvalid, "member must be a user of the project's organization")
+	}
+	return nil
+}
+
+func (a *updateMemberRoleAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.membership.setRole(ctx, tx, a.role); err != nil {
+		return nil, err
+	}
+	return a.membership, nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
