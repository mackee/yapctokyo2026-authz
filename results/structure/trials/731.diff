diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..101e99b
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,86 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestUpdateMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, project, target, body string
+		want                              int
+	}{
+		{"manager promotes", "ann", "web", "ben", `{"role":"manager"}`, 200},
+		{"manager demotes", "ivy", "web", "ivy", `{"role":"viewer"}`, 200},
+		{"contributor", "ben", "web", "cat", `{"role":"viewer"}`, 403},
+		{"viewer", "dan", "web", "ben", `{"role":"viewer"}`, 403},
+		{"org admin non member", "eve", "web", "ben", `{"role":"viewer"}`, 403},
+		{"non member", "hal", "web", "ben", `{"role":"viewer"}`, 404},
+		{"other org", "gus", "web", "ben", `{"role":"viewer"}`, 404},
+		{"anonymous", "", "web", "ben", `{"role":"viewer"}`, 401},
+		{"unknown user", "zed", "web", "ben", `{"role":"viewer"}`, 401},
+		{"unknown project", "ann", "nope", "ben", `{"role":"viewer"}`, 404},
+		{"target not a member", "ann", "web", "hal", `{"role":"manager"}`, 404},
+		{"target outside project", "ann", "web", "t1", `{"role":"manager"}`, 404},
+		{"archived manager", "ann", "legacy", "ben", `{"role":"viewer"}`, 409},
+		{"archived contributor", "ben", "legacy", "ben", `{"role":"viewer"}`, 403},
+		{"invalid role", "ann", "web", "ben", `{"role":"owner"}`, 400},
+		{"empty role", "ann", "web", "ben", `{"role":""}`, 400},
+		{"missing role", "ann", "web", "ben", `{}`, 400},
+		{"malformed body", "ann", "web", "ben", `{"role":`, 400},
+		{"invalid role from viewer", "dan", "web", "ben", `{"role":"owner"}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			path := "/projects/" + c.project + "/members/" + c.target
+			code, body := do(t, newServer(), "PUT", path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRoleResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.UserID != "ben" || got.Role != "viewer" {
+		t.Fatalf("got %+v", got)
+	}
+}
+
+// TestUpdateMemberRolePersists checks, on one server, that a role change is
+// what later requests see: cat (a contributor) cannot reassign t2 until a
+// manager promotes cat, and a demoted member loses write access.
+func TestUpdateMemberRolePersists(t *testing.T) {
+	srv := newServer()
+
+	if code, body := do(t, srv, "PATCH", "/projects/web/tasks/t2", "cat", `{"assignee":"ben"}`); code != 403 {
+		t.Fatalf("contributor reassign before promotion: got %d body=%s", code, body)
+	}
+	if code, body := do(t, srv, "PUT", "/projects/web/members/cat", "ann", `{"role":"manager"}`); code != 200 {
+		t.Fatalf("promote: got %d body=%s", code, body)
+	}
+	if code, body := do(t, srv, "PATCH", "/projects/web/tasks/t2", "cat", `{"assignee":"ben"}`); code != 200 {
+		t.Fatalf("manager reassign after promotion: got %d body=%s", code, body)
+	}
+
+	if code, body := do(t, srv, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote: got %d body=%s", code, body)
+	}
+	if code, body := do(t, srv, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 403 {
+		t.Fatalf("demoted member write: got %d body=%s", code, body)
+	}
+	if code, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ben", ""); code != 200 {
+		t.Fatalf("demoted member read: got %d body=%s", code, body)
+	}
+}
