+func TestTransfer(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/cat/transfer", `{"toOrgId":"globex"}`, 200},
+		{"contributor caller", "ben", "/orgs/acme/users/cat/transfer", `{"toOrgId":"globex"}`, 403},
+		{"manager caller", "ann", "/orgs/acme/users/cat/transfer", `{"toOrgId":"globex"}`, 403},
+		{"other org caller", "gus", "/orgs/acme/users/cat/transfer", `{"toOrgId":"globex"}`, 404},
+		{"anonymous", "", "/orgs/acme/users/cat/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown caller", "zed", "/orgs/acme/users/cat/transfer", `{"toOrgId":"globex"}`, 401},
+		{"path org is not caller's org", "eve", "/orgs/globex/users/cat/transfer", `{"toOrgId":"acme"}`, 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"unknown target user", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"unknown target org", "eve", "/orgs/acme/users/cat/transfer", `{"toOrgId":"initech"}`, 400},
+		{"same org", "eve", "/orgs/acme/users/cat/transfer", `{"toOrgId":"acme"}`, 400},
+		{"missing toOrgId", "eve", "/orgs/acme/users/cat/transfer", `{}`, 400},
+		{"bad body", "eve", "/orgs/acme/users/cat/transfer", `nope`, 400},
+		{"member of archived project", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferResponseAndCleanup(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/orgs/acme/users/cat/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got transferResponse
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.ID != "cat" || got.OrgID != "globex" {
+		t.Fatalf("got %+v", got)
+	}
+
+	// cat's org is now globex, so acme projects are invisible to cat.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 404 {
+		t.Fatalf("cat reading acme project: got %d want 404", code)
+	}
+	// cat's assignments in acme projects were cleared.
+	for _, path := range []string{"/projects/web/tasks/t2", "/projects/ops/tasks/t4"} {
+		code, body := do(t, h, "GET", path, "ann", "")
+		if code != 200 {
+			t.Fatalf("%s: got %d", path, code)
+		}
+		var task Task
+		json.Unmarshal([]byte(body), &task)
+		if task.Assignee != "" {
+			t.Fatalf("%s: assignee still %q", path, task.Assignee)
+		}
+	}
+	// Memberships in the old org's projects are gone.
+	var n int
+	if err := h.(*appHandler).db.QueryRow(`SELECT COUNT(*) FROM memberships WHERE user_id = 'cat'`).Scan(&n); err != nil {
+		t.Fatal(err)
+	}
+	if n != 0 {
+		t.Fatalf("cat still has %d memberships", n)
+	}
+}
+
+func TestTransferDropsOrgAdmin(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var admin int
+	var org string
+	if err := h.(*appHandler).db.QueryRow(`SELECT org_admin, org_id FROM users WHERE id = 'eve'`).Scan(&admin, &org); err != nil {
+		t.Fatal(err)
+	}
+	if admin != 0 || org != "globex" {
+		t.Fatalf("eve: org_admin=%d org=%s, want 0 globex", admin, org)
+	}
+}
