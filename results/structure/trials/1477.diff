+type transferRequest struct {
+	ToOrgID string `json:"toOrgId"`
+}
+
+type transferResponse struct {
+	ID    string `json:"id"`
+	OrgID string `json:"orgId"`
+}
+
+// transferUser moves a user from the org in the path to toOrgId. The user's
+// memberships and task assignments in the old org's projects are removed, since
+// project members must belong to the project's org; the user also loses org admin.
+func (s *server) transferUser(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	caller, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if caller == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	orgID := r.PathValue("orgID")
+	if caller.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	target, err := findUser(ctx, s.db, r.PathValue("uid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if target == nil || target.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	if !caller.OrgAdmin {
+		writeError(w, 403, "only org admins may transfer users")
+		return
+	}
+	var req transferRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || req.ToOrgID == "" {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	if req.ToOrgID == orgID {
+		writeError(w, 400, "user already belongs to that organization")
+		return
+	}
+	exists, err := orgExists(ctx, s.db, req.ToOrgID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if !exists {
+		writeError(w, 400, "unknown organization")
+		return
+	}
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+	var archived int
+	if err := tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM memberships m
+		JOIN projects p ON p.id = m.project_id
+		WHERE m.user_id = ? AND p.org_id = ? AND p.archived = 1`, target.ID, orgID).Scan(&archived); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if archived > 0 {
+		writeError(w, 409, "user is a member of an archived project")
+		return
+	}
+	if _, err := tx.ExecContext(ctx, `UPDATE tasks SET assignee = '' WHERE assignee = ?
+		AND project_id IN (SELECT id FROM projects WHERE org_id = ?)`, target.ID, orgID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if _, err := tx.ExecContext(ctx, `DELETE FROM memberships WHERE user_id = ?
+		AND project_id IN (SELECT id FROM projects WHERE org_id = ?)`, target.ID, orgID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if _, err := tx.ExecContext(ctx, `UPDATE users SET org_id = ?, org_admin = 0 WHERE id = ?`, req.ToOrgID, target.ID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, transferResponse{ID: target.ID, OrgID: req.ToOrgID})
+}
