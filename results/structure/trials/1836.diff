+// transferUserAggregate moves one user from fromOrg to toOrg. The user leaves
+// fromOrg's projects, so the memberships there are removed and the tasks the
+// user holds in them are unassigned; that keeps the model rules true.
+type transferUserAggregate struct {
+	user    *User
+	fromOrg string
+	toOrg   string
+}
+
+func loadTransferUser(ctx context.Context, tx DB, userID, fromOrg, toOrg string) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != fromOrg {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	ok, err := NewOrgTable().Exists(ctx, tx, toOrg)
+	if err != nil {
+		return nil, err
+	}
+	if !ok {
+		return nil, deny(ErrInvalid, "toOrgId must be an existing organization")
+	}
+	return &transferUserAggregate{user: u, fromOrg: fromOrg, toOrg: toOrg}, nil
+}
+
+func (a *transferUserAggregate) validate() error { return nil }
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	ms, err := a.user.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, m := range ms {
+		p, err := m.Project(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		if p.Org == a.fromOrg {
+			if err := m.destroy(ctx, tx); err != nil {
+				return nil, err
+			}
+		}
+	}
+	tasks, err := a.user.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, t := range tasks {
+		p, err := t.Project(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		if p.Org == a.fromOrg {
+			if err := t.unassign(ctx, tx); err != nil {
+				return nil, err
+			}
+		}
+	}
+	if err := a.user.transfer(ctx, tx, a.toOrg); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
+
