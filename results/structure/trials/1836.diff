+
+// Transfer moves the user from the authorization object's organization to
+// ToOrgID. The actor must be an org admin of that organization; a user who is
+// not in it is ErrNotFound.
+func (*UserTable) Transfer(ctx context.Context, db DB, authz OrgAuthz, userID string, in UserTableTransferInput) (*User, error) {
+	if err := authz.CanTransferUsers(); err != nil {
+		return nil, err
+	}
