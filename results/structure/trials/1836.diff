+package model
+
+import "context"
+
+// OrgTable reads the orgs table.
+type OrgTable struct{}
+
+// NewOrgTable returns the orgs table.
+func NewOrgTable() *OrgTable { return &OrgTable{} }
+
+// Exists reports whether an organization with the ID exists.
+func (*OrgTable) Exists(ctx context.Context, db DB, id string) (bool, error) {
+	var n int
+	if err := db.QueryRowContext(ctx, `SELECT COUNT(*) FROM orgs WHERE id = ?`, id).Scan(&n); err != nil {
+		return false, err
+	}
+	return n > 0, nil
+}
