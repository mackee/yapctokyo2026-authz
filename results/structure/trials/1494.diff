 // NewMembershipTable returns the memberships table.
 func NewMembershipTable() *MembershipTable { return &MembershipTable{} }
 
+var validRoles = map[string]bool{RoleManager: true, RoleContributor: true, RoleViewer: true}
+
+// ChangeRole sets the role of the user in the project. Only managers may do it
+// (CanManageMembers). A user who is not a member of the project is ErrNotFound;
+// a user who still has tasks assigned in the project cannot become a viewer
+// (ErrInvalid).
+func (*MembershipTable) ChangeRole(ctx context.Context, db DB, authz ProjectAuthz, userID, role string) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if !validRoles[role] {
+		return nil, deny(ErrInvalid, "role must be manager, contributor or viewer")
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadChangeRole(ctx, tx, authz.ProjectID(), userID, role)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		m, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
