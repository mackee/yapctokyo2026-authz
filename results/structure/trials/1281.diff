+func TestChangeRoles(t *testing.T) {
+	const web = "/projects/web/members"
+	members := func(t *testing.T, h http.Handler) string {
+		t.Helper()
+		// ann is a manager; a no-op change returns the current list.
+		code, body := do(t, h, "PUT", web, "ann", `{"roles":{"ann":"manager"}}`)
+		if code != 200 {
+			t.Fatalf("list: %d %s", code, body)
+		}
+		return strings.TrimSpace(body)
+	}
+
+	t.Run("bulk change returns members", func(t *testing.T) {
+		h := newServer()
+		code, body := do(t, h, "PUT", web, "ann", `{"roles":{"dan":"contributor","ivy":"viewer"}}`)
+		if code != 200 {
+			t.Fatalf("got %d %s", code, body)
+		}
+		var got []map[string]string
+		if err := json.Unmarshal([]byte(body), &got); err != nil {
+			t.Fatal(err)
+		}
+		want := map[string]string{"ann": "manager", "ben": "contributor", "cat": "contributor", "dan": "contributor", "ivy": "viewer"}
+		if len(got) != len(want) {
+			t.Fatalf("got %v", got)
+		}
+		for _, m := range got {
+			if want[m["userId"]] != m["role"] || len(m) != 2 {
+				t.Errorf("unexpected member %v", m)
+			}
+		}
+	})
+
+	t.Run("all or nothing", func(t *testing.T) {
+		cases := []struct {
+			name, body string
+			want       int
+		}{
+			{"non-member", `{"roles":{"dan":"contributor","hal":"viewer"}}`, 400},
+			{"demote assignee", `{"roles":{"dan":"contributor","ben":"viewer"}}`, 400},
+		}
+		for _, c := range cases {
+			h := newServer()
+			before := members(t, h)
+			if code, body := do(t, h, "PUT", web, "ann", c.body); code != c.want {
+				t.Errorf("%s: got %d %s, want %d", c.name, code, body, c.want)
+			}
+			if after := members(t, h); after != before {
+				t.Errorf("%s: members changed: %s -> %s", c.name, before, after)
+			}
+		}
+	})
+
+	t.Run("status codes", func(t *testing.T) {
+		cases := []struct {
+			name, user, path, body string
+			want                   int
+		}{
+			{"invalid role", "ann", web, `{"roles":{"dan":"boss"}}`, 400},
+			{"empty roles", "ann", web, `{"roles":{}}`, 400},
+			{"bad json", "ann", web, `{`, 400},
+			{"no user", "", web, `{"roles":{"dan":"viewer"}}`, 401},
+			{"contributor", "ben", web, `{"roles":{"dan":"viewer"}}`, 403},
+			{"viewer", "dan", web, `{"roles":{"dan":"viewer"}}`, 403},
+			{"org admin", "eve", web, `{"roles":{"dan":"viewer"}}`, 403},
+			{"other org", "gus", web, `{"roles":{"dan":"viewer"}}`, 404},
+			{"archived", "ann", "/projects/legacy/members", `{"roles":{"ben":"contributor"}}`, 409},
+			{"manager ok", "ivy", web, `{"roles":{"dan":"viewer"}}`, 200},
+		}
+		for _, c := range cases {
+			if code, body := do(t, newServer(), "PUT", c.path, c.user, c.body); code != c.want {
+				t.Errorf("%s: got %d %s, want %d", c.name, code, body, c.want)
+			}
+		}
+	})
+}
