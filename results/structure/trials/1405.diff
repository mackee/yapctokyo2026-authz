@@ -0,0 +1,110 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestMoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager of both moves", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 200},
+		{"contributor caller", "ben", "/projects/web/members/cat/move", `{"toProjectId":"legacy"}`, 403},
+		{"manager of source only", "ann", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin caller", "eve", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"non member caller", "hal", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"other org caller", "gus", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 401},
+		{"unknown user", "zed", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 401},
+		{"member not in source", "ivy", "/projects/web/members/hal/move", `{"toProjectId":"ops"}`, 404},
+		{"unknown member", "ivy", "/projects/web/members/zed/move", `{"toProjectId":"ops"}`, 404},
+		{"target missing", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"missing"}`, 404},
+		{"target in other org", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"gx"}`, 404},
+		{"target not readable", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"legacy"}`, 404},
+		{"same project", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"web"}`, 400},
+		{"empty target", "ivy", "/projects/web/members/ben/move", `{"toProjectId":""}`, 400},
+		{"missing target", "ivy", "/projects/web/members/ben/move", `{}`, 400},
+		{"source archived", "ann", "/projects/legacy/members/ben/move", `{"toProjectId":"web"}`, 409},
+		{"target archived", "ann", "/projects/web/members/cat/move", `{"toProjectId":"legacy"}`, 409},
+		{"already in target", "ivy", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveMemberResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got struct {
+		UserID    string `json:"userId"`
+		ProjectID string `json:"projectId"`
+		Role      string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.UserID != "ben" || got.ProjectID != "ops" || got.Role != "contributor" {
+		t.Fatalf("got %+v", got)
+	}
+}
+
+func TestMoveMemberChangesMembership(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`); code != 200 {
+		t.Fatalf("move: got %d: %s", code, body)
+	}
+
+	// ben has left web and joined ops.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads web after move: got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben reads ops after move: got %d want 200", code)
+	}
+
+	// ben's task in web loses its assignee; cat's task is untouched.
+	_, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "" {
+		t.Fatalf("t1 assignee = %q, want unassigned", task.AssigneeID)
+	}
+	_, body = do(t, srv, "GET", "/projects/web/tasks/t2", "ann", "")
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "cat" {
+		t.Fatalf("t2 assignee = %q, want cat", task.AssigneeID)
+	}
+}
+
+func TestMoveMemberRejectedChangesNothing(t *testing.T) {
+	srv := newServer()
+	// cat is already a member of ops, so the move is a 409.
+	if code, _ := do(t, srv, "POST", "/projects/web/members/cat/move", "ivy", `{"toProjectId":"ops"}`); code != 409 {
+		t.Fatalf("got %d want 409", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat lost web after a rejected move: got %d", code)
+	}
+	_, body := do(t, srv, "GET", "/projects/web/tasks/t2", "ann", "")
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "cat" {
+		t.Fatalf("t2 assignee = %q after a rejected move, want cat", task.AssigneeID)
+	}
+}
