+
+// moveMemberAggregate moves one member from the source project to the target
+// project, with the same role. The member's tasks in the source project lose
+// their assignee, since an assignee must be a member of the task's project.
+type moveMemberAggregate struct {
+	from      *Membership // the member in the source project; removed
+	toProject string      // the target project ID
+	tasks     []*Task     // the member's tasks in the source project
+}
+
+func loadMoveMember(ctx context.Context, tx DB, from *Membership, toProjectID string) (*moveMemberAggregate, error) {
+	_, err := NewMembershipTable().Find(ctx, tx, toProjectID, from.UserID)
+	if err == nil {
+		return nil, deny(ErrConflict, "user is already a member of the target project")
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	tasks, err := from.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &moveMemberAggregate{from: from, toProject: toProjectID, tasks: tasks}, nil
+}
+
+func (a *moveMemberAggregate) validate() error { return nil }
+
+// apply unassigns the member's tasks in the source project, removes the source
+// membership and adds the membership in the target project. It returns the new
+// membership.
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.from.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	moved := &Membership{ProjectID: a.toProject, UserID: a.from.UserID, Role: a.from.Role}
+	if err := moved.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return moved, nil
+}
