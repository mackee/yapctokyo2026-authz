+func TestRemoveMemberEffects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 204 {
+		t.Fatalf("got %d", code)
+	}
+	// ben lost access to web...
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("removed member still reads: %d", code)
+	}
+	// ...his task there is unassigned (model rules are checked by do())...
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if code != 200 || task.Assignee != "" {
+		t.Fatalf("t1 after removal: %d %+v", code, task)
+	}
+	// ...other projects are untouched.
+	if code, _ := do(t, h, "GET", "/projects/legacy/tasks/t5", "ben", ""); code != 200 {
+		t.Fatalf("legacy membership affected: %d", code)
+	}
+	// Removing twice -> 404.
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 404 {
+		t.Fatalf("second removal got %d", code)
+	}
+}
