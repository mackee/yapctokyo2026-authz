+
+// transferTo moves the user to the organization; the org admin flag does not
+// carry over.
+func (r *User) transferTo(ctx context.Context, db DB, org string) error {
+	r.Org = org
+	r.OrgAdmin = false
+	return r.save(ctx, db)
+}
