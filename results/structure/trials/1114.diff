+// transferUserAggregate moves one user to another organization, keeping the
+// rule that project members belong to the project's organization.
+type transferUserAggregate struct {
+	user    *User
+	toOrg   string
+	orgOK   bool          // the target organization exists
+	leaving []*Membership // memberships in projects outside the target organization
+	stale   []*Task       // tasks assigned to the user in those projects
+}
+
+func loadTransferUser(ctx context.Context, tx DB, fromOrg string, in UserTableTransferInput) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, in.UserID)
+	if errors.Is(err, ErrNoRows) || (err == nil && u.Org != fromOrg) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &transferUserAggregate{user: u, toOrg: in.ToOrgID}
+	if a.orgOK, err = NewUserTable().OrgExists(ctx, tx, in.ToOrgID); err != nil {
+		return nil, err
+	}
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	keep := map[string]bool{}
+	for _, m := range ms {
+		p, err := m.Project(ctx, tx)
+		if errors.Is(err, ErrNoRows) {
+			a.leaving = append(a.leaving, m)
+			continue
+		} else if err != nil {
+			return nil, err
+		}
+		if p.Org == in.ToOrgID {
+			keep[p.ID] = true
+		} else {
+			a.leaving = append(a.leaving, m)
+		}
+	}
+	tasks, err := u.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, t := range tasks {
+		if !keep[t.ProjectID] {
+			a.stale = append(a.stale, t)
+		}
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if a.toOrg == a.user.Org {
+		return deny(ErrInvalid, "user already belongs to the organization")
+	}
+	if !a.orgOK {
+		return deny(ErrInvalid, "organization does not exist")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	for _, t := range a.stale {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	for _, m := range a.leaving {
+		if err := m.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.user.transferTo(ctx, tx, a.toOrg); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
