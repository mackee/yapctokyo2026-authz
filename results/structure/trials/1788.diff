+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"reflect"
+	"testing"
+)
+
+// roleOf reads a membership straight from the database ("" if not a member).
+func roleOf(t *testing.T, h http.Handler, pid, uid string) string {
+	t.Helper()
+	app, ok := h.(*appHandler)
+	if !ok {
+		t.Fatalf("roleOf: %T is not the handler built by newServer", h)
+	}
+	var role string
+	err := app.db.QueryRow(`SELECT role FROM memberships WHERE project_id = ? AND user_id = ?`, pid, uid).Scan(&role)
+	if err != nil {
+		return ""
+	}
+	return role
+}
+
+func TestFreezeResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got []map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("body is not a JSON array of objects: %v: %s", err, body)
+	}
+	// Every member of web (including the manager ann and ivy), sorted by userId.
+	want := []map[string]string{
+		{"userId": "ann", "role": "viewer"},
+		{"userId": "ben", "role": "viewer"},
+		{"userId": "cat", "role": "viewer"},
+		{"userId": "dan", "role": "viewer"},
+		{"userId": "ivy", "role": "viewer"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("members after freeze:\n got  %v\n want %v", got, want)
+	}
+}
+
+func TestFreezeAuthorization(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+		{"unknown project", "ann", "nope", 404},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestFreezeSetsEveryMemberToViewer(t *testing.T) {
+	h := newServer()
+	do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	for _, uid := range []string{"ann", "ben", "cat", "dan", "ivy"} {
+		if got := roleOf(t, h, "web", uid); got != "viewer" {
+			t.Errorf("%s in web: role %q, want viewer", uid, got)
+		}
+	}
+}
+
+func TestFreezeLeavesOtherProjectsAlone(t *testing.T) {
+	h := newServer()
+	do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if got := roleOf(t, h, "ops", "ivy"); got != "manager" {
+		t.Errorf("ivy in ops: role %q, want manager", got)
+	}
+	if got := roleOf(t, h, "ops", "cat"); got != "contributor" {
+		t.Errorf("cat in ops: role %q, want contributor", got)
+	}
+	// ivy is a manager of ops, so she can still write there.
+	if code, body := do(t, h, "PATCH", "/projects/ops/tasks/t4", "ivy", `{"status":"done"}`); code != 200 {
+		t.Errorf("ivy PATCH in ops: got %d want 200: %s", code, body)
+	}
+}
+
+func TestFreezeRejectsTaskWritesForEveryone(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d: %s", code, body)
+	}
+	cases := []struct {
+		name, user, method, path, body string
+	}{
+		{"former manager ann patches", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"former manager ivy patches", "ivy", "PATCH", "/projects/web/tasks/t3", `{"title":"y"}`},
+		{"former contributor ben patches", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"former contributor cat patches", "cat", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"former manager creates", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"former contributor creates", "ben", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"former manager deletes", "ann", "DELETE", "/projects/web/tasks/t3", ""},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, h, c.method, c.path, c.user, c.body)
+			if code != 403 {
+				t.Fatalf("got %d want 403: %s", code, body)
+			}
+		})
+	}
+
+	// Reads still work, and the tasks are unchanged.
+	code, body := do(t, h, "GET", "/projects/web/tasks/t2", "dan", "")
+	if code != 200 {
+		t.Fatalf("GET after freeze: got %d: %s", code, body)
+	}
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Status != "doing" || task.Title != "Update footer" {
+		t.Fatalf("task changed by frozen writes: %+v", task)
+	}
+}
+
+func TestFreezeClearsAssignees(t *testing.T) {
+	// Assignees must be contributors or managers (a model rule), and after a freeze
+	// nobody in the project is, so the assignments are cleared.
+	h := newServer()
+	do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	for _, id := range []string{"t1", "t2", "t3"} {
+		code, body := do(t, h, "GET", "/projects/web/tasks/"+id, "dan", "")
+		if code != 200 {
+			t.Fatalf("GET %s: got %d: %s", id, code, body)
+		}
+		var task Task
+		json.Unmarshal([]byte(body), &task)
+		if task.Assignee != "" {
+			t.Errorf("task %s still assigned to %q after freeze", id, task.Assignee)
+		}
+	}
+}
+
+func TestFreezeTwiceIsRefusedForFormerManager(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("first freeze: got %d", code)
+	}
+	// ann is a viewer now, so she may no longer freeze the project.
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 403 {
+		t.Fatalf("second freeze: got %d want 403: %s", code, body)
+	}
+}
+
+func TestFreezeArchivedProjectChangesNothing(t *testing.T) {
+	h := newServer()
+	do(t, h, "POST", "/projects/legacy/freeze", "ann", "")
+	if got := roleOf(t, h, "legacy", "ann"); got != "manager" {
+		t.Errorf("ann in legacy: role %q, want manager", got)
+	}
+	if got := roleOf(t, h, "legacy", "ben"); got != "contributor" {
+		t.Errorf("ben in legacy: role %q, want contributor", got)
+	}
+}
