+// setMemberRolesAggregate changes the roles of several members of one project.
+type setMemberRolesAggregate struct {
+	project *Project
+	members []*Membership // project.Memberships(), ordered by user ID
+	roles   map[string]string
+}
+
+func loadSetMemberRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*setMemberRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	ms, err := p.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &setMemberRolesAggregate{project: p, members: ms, roles: roles}, nil
+}
+
+func (a *setMemberRolesAggregate) validate() error {
+	byUser := make(map[string]*Membership, len(a.members))
+	for _, m := range a.members {
+		byUser[m.UserID] = m
+	}
+	for userID, role := range a.roles {
+		if role != RoleManager && role != RoleContributor && role != RoleViewer {
+			return deny(ErrInvalid, "role must be manager, contributor or viewer")
+		}
+		if byUser[userID] == nil {
+			return deny(ErrInvalid, "not a member of the project: "+userID)
+		}
+	}
+	// A project must keep at least one manager: nobody else can manage it.
+	for _, m := range a.members {
+		role := m.Role
+		if r, ok := a.roles[m.UserID]; ok {
+			role = r
+		}
+		if role == RoleManager {
+			return nil
+		}
+	}
+	return deny(ErrInvalid, "the project must keep at least one manager")
+}
+
+func (a *setMemberRolesAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for _, m := range a.members {
+		role, ok := a.roles[m.UserID]
+		if !ok || role == m.Role {
+			continue
+		}
+		if err := m.setRole(ctx, tx, role); err != nil {
+			return nil, err
+		}
+		if isWriterRole(role) {
+			continue
+		}
+		// A viewer cannot be an assignee: unassign the member's tasks.
+		ts, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		for _, t := range ts {
+			if err := t.unassign(ctx, tx); err != nil {
+				return nil, err
+			}
+		}
+	}
+	return a.members, nil
+}
