@@ -0,0 +1,61 @@
+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestMoveMemberDenied(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"anonymous", "", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 401},
+		{"manager of source only", "ann", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"contributor", "cat", "/projects/ops/members/ann/move", `{"toProjectId":"web"}`, 403},
+		{"non member of source", "hal", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"org admin", "eve", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"other org caller", "gus", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"destination in other org", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"gx"}`, 404},
+		{"destination missing", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"nope"}`, 404},
+		{"destination archived", "ann", "/projects/web/members/ben/move", `{"toProjectId":"legacy"}`, 409},
+		{"not a member", "ivy", "/projects/web/members/hal/move", `{"toProjectId":"ops"}`, 404},
+		{"already in destination", "ivy", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 409},
+		{"same project", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"web"}`, 400},
+		{"bad body", "ivy", "/projects/web/members/ben/move", `{}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestMoveMemberEffects(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	if want := `{"userId":"ben","projectId":"ops","role":"contributor"}`; strings.TrimSpace(body) != want {
+		t.Fatalf("got %s want %s", body, want)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben still reads web: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben cannot read ops: %d", code)
+	}
+	// t1 was assigned to ben in web; it must now be unassigned.
+	_, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if !strings.Contains(body, `"assignee":""`) {
+		t.Fatalf("t1 still assigned: %s", body)
+	}
+	// A second move is a 404: ben is no longer in web.
+	if code, _ := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`); code != 404 {
+		t.Fatalf("second move got %d", code)
+	}
+}
