+// moveMemberAggregate moves one member from the source project to the target
+// project, keeping the role. The member's tasks in the source project are
+// unassigned, because an assignee must be a member of the task's project.
+type moveMemberAggregate struct {
+	member   *Membership // the member in the source project
+	targetID string
+	tasks    []*Task // the member's tasks in the source project
+}
+
+func loadMoveMember(ctx context.Context, tx DB, from, to ProjectAuthz, userID string) (*moveMemberAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, from.ProjectID(), userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "member not found")
+	} else if err != nil {
+		return nil, err
+	}
+	_, err = NewMembershipTable().Find(ctx, tx, to.ProjectID(), userID)
+	if err == nil {
+		return nil, deny(ErrInvalid, "user is already a member of the target project")
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	tasks, err := m.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &moveMemberAggregate{member: m, targetID: to.ProjectID(), tasks: tasks}, nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.member.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	moved := &Membership{ProjectID: a.targetID, UserID: a.member.UserID, Role: a.member.Role}
+	if err := moved.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return moved, nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
