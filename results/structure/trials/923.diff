--- a/internal/model/membership_table.go
+++ b/internal/model/membership_table.go
@@ -2,12 +2,50 @@ package model
 
 import "context"
 
-// MembershipTable reads the memberships table.
+// MembershipTable is the memberships table.
+//
+// Find and List* read rows. Move is the API operation: it asks the
+// authorization objects of both projects whether the actor may manage their
+// members, then runs its aggregate (aggregate.go) in a transaction.
 type MembershipTable struct{}
 
 // NewMembershipTable returns the memberships table.
 func NewMembershipTable() *MembershipTable { return &MembershipTable{} }
 
+// Move moves the user's membership from the source project to the target
+// project, keeping the role, all or nothing. The actor must be a manager of
+// both projects. The user's tasks in the source project are unassigned.
+//
+// The target's authorization object is built here, after the source check, so
+// a non-manager of the source gets 403 whatever the target is.
+func (mt *MembershipTable) Move(ctx context.Context, db DB, from ProjectAuthz, toProjectID, userID string) (*Membership, error) {
+	if err := from.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if from.ProjectID() == toProjectID {
+		return nil, deny(ErrInvalid, "target project must differ from the source project")
+	}
+	to, err := NewProjectAuthz(ctx, db, from.Actor(), toProjectID)
+	if err != nil {
+		return nil, err
+	}
+	if err := to.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var moved *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveMember(ctx, tx, from, to, userID)
+		if err != nil {
+			return err
+		}
+		moved, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return moved, nil
+}
+
