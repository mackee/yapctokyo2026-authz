+// RemoveFromOrg removes the user from every project of the authorization
+// object's organization (for example when the user leaves the company). Tasks
+// the user was assigned to in those projects are unassigned. Only org admins
+// may do it (CanManageMembers). The user must belong to the organization,
+// otherwise ErrNotFound. A user with no memberships there is left as it is.
+func (*UserTable) RemoveFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanManageMembers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveFromOrg(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
