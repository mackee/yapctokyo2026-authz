diff --git a/org_test.go b/org_test.go
new file mode 100644
index 0000000..2de63f5
--- /dev/null
+++ b/org_test.go
@@ -0,0 +1,104 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+// DELETE /orgs/{orgID}/users/{uid} removes the user from every project of the
+// organization (offboarding). Only org admins of that organization may do it.
+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin, user with no memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"project manager, not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"contributor", "ben", "/orgs/acme/users/cat", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown user", "zed", "/orgs/acme/users/ben", 401},
+		{"org admin of another org", "gus", "/orgs/acme/users/ben", 404},
+		{"org admin, other org's id", "eve", "/orgs/globex/users/gus", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ben", 404},
+		{"user of another org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown user id", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+// After the removal the user is a member of no project of the organization:
+// the projects are not readable to them, and their task assignments in those
+// projects are cleared (an assignee must be a member). Other members and other
+// organizations are unaffected.
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d %s", code, body)
+	}
+
+	// ben is no longer a member of web or legacy (archived); both are unreadable to him.
+	for _, path := range []string{"/projects/web/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, h, "GET", path, "ben", ""); code != 404 {
+			t.Errorf("ben GET %s: got %d want 404", path, code)
+		}
+	}
+
+	// The tasks ben was assigned to are unassigned now; ann (manager) still reads them.
+	for _, path := range []string{"/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		code, body := do(t, h, "GET", path, "ann", "")
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil || code != 200 {
+			t.Fatalf("GET %s: got %d %s", path, code, body)
+		}
+		if task.AssigneeID != "" {
+			t.Errorf("GET %s: assignee %q, want unassigned", path, task.AssigneeID)
+		}
+	}
+
+	// Other members keep their membership and assignments.
+	if code, body := do(t, h, "GET", "/projects/web/tasks/t2", "ann", ""); code != 200 {
+		t.Fatalf("GET t2: got %d %s", code, body)
+	} else {
+		var task Task
+		_ = json.Unmarshal([]byte(body), &task)
+		if task.AssigneeID != "cat" {
+			t.Errorf("t2 assignee %q, want cat", task.AssigneeID)
+		}
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Errorf("cat GET web tasks: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "cat", ""); code != 200 {
+		t.Errorf("cat GET ops tasks: got %d want 200", code)
+	}
+
+	// Another organization is unaffected.
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Errorf("gus GET gx tasks: got %d want 200", code)
+	}
+}
+
+// A refused request changes nothing.
+func TestRemoveOrgUserForbiddenChangesNothing(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "ann", ""); code != 403 {
+		t.Fatalf("got %d want 403", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Errorf("ben GET web tasks: got %d want 200", code)
+	}
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	_ = json.Unmarshal([]byte(body), &task)
+	if code != 200 || task.AssigneeID != "ben" {
+		t.Errorf("t1: got %d assignee %q, want 200 assignee ben", code, task.AssigneeID)
+	}
+}
