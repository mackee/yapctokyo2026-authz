+func TestFreezeIsProjectScoped(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/ops/freeze", "ivy", ""); code != 200 {
+		t.Fatalf("freeze: got %d: %s", code, body)
+	}
+	// ops: cat was a contributor and assigned t4; now a viewer, so the write is refused.
+	if code, body := do(t, h, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`); code != 403 {
+		t.Fatalf("frozen ops: got %d want 403: %s", code, body)
+	}
+	// web is untouched: ben is still a contributor there and can edit his task.
+	if code, body := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 200 {
+		t.Fatalf("web after ops freeze: got %d want 200: %s", code, body)
+	}
+	// ivy is still a manager in web.
+	if code, body := do(t, h, "PATCH", "/projects/web/tasks/t2", "ivy", `{"status":"done"}`); code != 200 {
+		t.Fatalf("web manager after ops freeze: got %d want 200: %s", code, body)
+	}
+}
