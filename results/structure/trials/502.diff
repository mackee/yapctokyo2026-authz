+func TestFreezeBlocksTaskWrites(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ivy", ""); code != 200 {
+		t.Fatalf("freeze: got %d: %s", code, body)
+	}
+	cases := []struct {
+		name, user, method, path, body string
+		want                           int
+	}{
+		{"manager patch", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"manager patch as ivy", "ivy", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`, 403},
+		{"contributor own task", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`, 403},
+		{"manager create", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"contributor create", "cat", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"manager delete", "ann", "DELETE", "/projects/web/tasks/t1", "", 403},
+		{"second freeze has no manager left", "ann", "POST", "/projects/web/freeze", "", 403},
+		{"members can still read", "dan", "GET", "/projects/web/tasks/t1", "", 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, h, c.method, c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+		})
+	}
+}
