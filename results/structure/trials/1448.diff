+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager moves unassigned", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 200},
+		{"manager moves to project where assignee is member", "ivy", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 200},
+		{"assignee not in target", "ivy", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 400},
+		{"contributor source", "ben", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"viewer source", "dan", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"org admin source", "eve", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 403},
+		{"non member source", "hal", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 404},
+		{"other org", "gus", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 401},
+		{"task in other project", "ivy", "/projects/web/tasks/t4", `{"toProjectId":"ops"}`, 404},
+		{"missing task", "ivy", "/projects/web/tasks/t99", `{"toProjectId":"ops"}`, 404},
+		{"missing target", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"nope"}`, 404},
+		{"target in other org", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"gx"}`, 404},
+		{"target not readable", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"legacy"}`, 404},
+		{"target read only", "ann", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 403},
+		{"target archived", "ann", "/projects/web/tasks/t3", `{"toProjectId":"legacy"}`, 409},
+		{"source archived", "ann", "/projects/legacy/tasks/t5", `{"toProjectId":"web"}`, 409},
+		{"same project", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"web"}`, 400},
+		{"missing target id", "ivy", "/projects/web/tasks/t3", `{}`, 400},
+		{"bad body", "ivy", "/projects/web/tasks/t3", `not json`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsTaskFields(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d: %s", code, body)
+	}
+	var moved Task
+	if err := json.Unmarshal([]byte(body), &moved); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", Assignee: "cat"}
+	if moved != want {
+		t.Fatalf("got %+v want %+v", moved, want)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks/t2", "ivy", ""); code != 200 {
+		t.Fatalf("GET in target: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t2", "ivy", ""); code != 404 {
+		t.Fatalf("GET in source: got %d want 404", code)
+	}
+}
