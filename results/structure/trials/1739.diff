+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager removes contributor", "ann", "/projects/web/members/ben", 204},
+		{"manager removes viewer", "ann", "/projects/web/members/dan", 204},
+		{"manager removes manager", "ann", "/projects/web/members/ivy", 204},
+		{"manager removes self", "ann", "/projects/web/members/ann", 204},
+		{"contributor", "ben", "/projects/web/members/cat", 403},
+		{"viewer", "dan", "/projects/web/members/ben", 403},
+		{"viewer of ops is not manager there", "ann", "/projects/ops/members/cat", 403},
+		{"org admin", "eve", "/projects/web/members/ben", 403},
+		{"non member", "hal", "/projects/web/members/ben", 404},
+		{"other org", "gus", "/projects/web/members/ben", 404},
+		{"anonymous", "", "/projects/web/members/ben", 401},
+		{"unknown user", "zed", "/projects/web/members/ben", 401},
+		{"target is not a member", "ann", "/projects/web/members/hal", 404},
+		{"target does not exist", "ann", "/projects/web/members/zed", 404},
+		{"target member of other project only", "ann", "/projects/web/members/gus", 404},
+		{"archived", "ann", "/projects/legacy/members/ben", 409},
+		{"unknown project", "ann", "/projects/nope/members/ben", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveMemberEffects(t *testing.T) {
+	h := newServer()
+
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben should read web before removal, got %d", code)
+	}
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+
+	// The removed user can no longer see the project.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("removed member: got %d want 404", code)
+	}
+	// Removing again: the user is no longer a member.
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 404 {
+		t.Fatalf("second remove: got %d want 404", code)
+	}
+
+	// Their tasks in this project become unassigned (an assignee must be a
+	// member); the tasks themselves stay.
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("t1 should still exist, got %d", code)
+	}
+	var t1 Task
+	if err := json.Unmarshal([]byte(body), &t1); err != nil {
+		t.Fatal(err)
+	}
+	if t1.AssigneeID != "" {
+		t.Fatalf("t1 assignee = %q, want unassigned", t1.AssigneeID)
+	}
+
+	// Other members' tasks are untouched.
+	_, body = do(t, h, "GET", "/projects/web/tasks/t2", "ann", "")
+	var t2 Task
+	json.Unmarshal([]byte(body), &t2)
+	if t2.AssigneeID != "cat" {
+		t.Fatalf("t2 assignee = %q, want cat", t2.AssigneeID)
+	}
+}
+
+func TestRemoveMemberKeepsOtherProjects(t *testing.T) {
+	h := newServer()
+
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/cat", "ann", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+	// cat is still a member of ops, and keeps the task assigned there.
+	code, body := do(t, h, "GET", "/projects/ops/tasks/t4", "cat", "")
+	if code != 200 {
+		t.Fatalf("cat should still read ops, got %d", code)
+	}
+	var t4 Task
+	json.Unmarshal([]byte(body), &t4)
+	if t4.AssigneeID != "cat" {
+		t.Fatalf("t4 assignee = %q, want cat", t4.AssigneeID)
+	}
+}
