+// freezeProject demotes every member of the project to viewer and marks the
+// project frozen. It answers with the members after the change.
+func freezeProject(ctx tanukirpc.Context[*projectRegistry], _ struct{}) ([]capability.MemberView, error) {
+	p, err := ctx.Registry().scope.Manage()
+	if err != nil {
+		return nil, err
+	}
+	return p.Freeze()
