+// MemberView is the public representation of a project member.
+type MemberView struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// ManageProject may change the membership of one project.
+type ManageProject interface {
+	ReadProject
+	// Freeze sets every member's role to viewer and marks the project frozen,
+	// so nobody can change its tasks afterwards. It returns the members after
+	// the change, sorted by user ID.
+	Freeze() ([]MemberView, error)
+}
+
+type manageProject struct {
+	readProject
+}
+
+func (p *manageProject) Freeze() ([]MemberView, error) {
+	var out []MemberView
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		pr := s.projects[p.ps.pid]
+		pr.frozen = true
+		s.projects[pr.id] = pr
+		for uid := range s.members[pr.id] {
+			s.members[pr.id][uid] = RoleViewer
+		}
+		out = s.membersIn(pr.id)
+		return nil
+	})
+	return out, err
+}
+
