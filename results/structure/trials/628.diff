+// MembershipTableUpdateInput is the input of MembershipTable.Update.
+type MembershipTableUpdateInput struct {
+	Role string // manager, contributor or viewer
+}
+
+// Update changes the role of the user in the project. Only managers may do so
+// (CanManageMembers); the user must be a member of the project (else ErrNotFound).
+func (mt *MembershipTable) Update(ctx context.Context, db DB, authz ProjectAuthz, userID string, in MembershipTableUpdateInput) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if !isProjectRole(in.Role) {
+		return nil, deny(ErrInvalid, "role must be manager, contributor or viewer")
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadUpdateMembership(ctx, tx, authz.ProjectID(), userID, in)
+		if err != nil {
+			return err
+		}
+		if m, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
