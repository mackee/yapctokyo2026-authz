+// updateMembershipAggregate changes the role of one member of one project.
+type updateMembershipAggregate struct {
+	membership *Membership
+	in         MembershipTableUpdateInput
+}
+
+func loadUpdateMembership(ctx context.Context, tx DB, projectID, userID string, in MembershipTableUpdateInput) (*updateMembershipAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	return &updateMembershipAggregate{membership: m, in: in}, nil
+}
+
+func (a *updateMembershipAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.membership.setRole(ctx, tx, a.in.Role); err != nil {
+		return nil, err
+	}
+	return a.membership, nil
+}
