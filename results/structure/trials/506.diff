+// transferUserAggregate moves one user to another organization.
+type transferUserAggregate struct {
+	user        *User
+	toOrg       string
+	memberships []*Membership // the user's memberships in projects of the old organization
+	tasks       []*Task       // tasks assigned to the user in projects of the old organization
+}
+
+func loadTransferUser(ctx context.Context, tx DB, fromOrg, userID, toOrg string) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != fromOrg {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if toOrg == fromOrg {
+		return nil, deny(ErrInvalid, "user is already in the organization")
+	}
+	exists, err := NewUserTable().OrgExists(ctx, tx, toOrg)
+	if err != nil {
+		return nil, err
+	}
+	if !exists {
+		return nil, deny(ErrInvalid, "unknown organization")
+	}
+	a := &transferUserAggregate{user: u, toOrg: toOrg}
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, m := range ms {
+		p, err := m.Project(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		if p.Org == fromOrg {
+			a.memberships = append(a.memberships, m)
+		}
+	}
+	ts, err := u.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, t := range ts {
+		p, err := t.Project(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		if p.Org == fromOrg {
+			a.tasks = append(a.tasks, t)
+		}
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error { return nil }
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.user.setOrg(ctx, tx, a.toOrg); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
+
