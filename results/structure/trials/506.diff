+
+// OrgExists reports whether the organization exists. Organizations have no
+// table of their own: one exists when some user belongs to it.
+func (*UserTable) OrgExists(ctx context.Context, db DB, orgID string) (bool, error) {
+	var n int
+	if err := db.QueryRowContext(ctx, `SELECT EXISTS (SELECT 1 FROM users WHERE org_id = ?)`, orgID).Scan(&n); err != nil {
+		return false, err
+	}
+	return n == 1, nil
+}
+
+// UserTransferInput is the input of UserTable.Transfer.
+type UserTransferInput struct {
+	ToOrgID string
+}
+
+// Transfer moves the user from the organization of the authorization object to
+// another organization, all or nothing. The user's memberships in the old
+// organization's projects are removed and the tasks they hold there are
+// unassigned, since project members must belong to the project's organization.
+func (*UserTable) Transfer(ctx context.Context, db DB, authz OrgAuthz, userID string, in UserTransferInput) (*User, error) {
+	if err := authz.CanAdmin(); err != nil {
+		return nil, err
+	}
+	if in.ToOrgID == "" {
+		return nil, deny(ErrInvalid, "toOrgId must not be empty")
+	}
+	var u *User
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadTransferUser(ctx, tx, authz.OrgID(), userID, in.ToOrgID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if u, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return u, nil
+}
