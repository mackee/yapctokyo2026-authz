+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestMoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"anonymous", "", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 401},
+		{"non member", "hal", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"other org", "gus", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"contributor", "ben", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer", "dan", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin cannot write", "eve", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"manager of source only", "ann", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"dest not visible", "ann", "/projects/web/members/ben/move", `{"toProjectId":"gx"}`, 404},
+		{"dest missing", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"nope"}`, 404},
+		{"bad body", "ivy", "/projects/web/members/ben/move", `{}`, 400},
+		{"same project", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"web"}`, 400},
+		{"not a member", "ivy", "/projects/web/members/hal/move", `{"toProjectId":"ops"}`, 404},
+		{"already in dest", "ivy", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 409},
+		{"archived source", "ann", "/projects/legacy/members/ben/move", `{"toProjectId":"web"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestMoveMemberEffects(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var resp moveResponse
+	json.Unmarshal([]byte(body), &resp)
+	if resp != (moveResponse{UserID: "ben", ProjectID: "ops", Role: "contributor"}) {
+		t.Fatalf("bad response %+v", resp)
+	}
+	// ben is no longer in web, so he can't read it.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben still reads web: %d", code)
+	}
+	// ben is now in ops.
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben cannot read ops: %d", code)
+	}
+	// his web task is unassigned.
+	_, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" {
+		t.Fatalf("t1 still assigned to %q", task.Assignee)
+	}
+}
