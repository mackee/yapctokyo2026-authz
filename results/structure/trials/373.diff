+// removeMemberAggregate removes one member from one project. The member's
+// tasks in that project are unassigned, so no task keeps an assignee who is
+// no longer a contributor or manager of the project.
+type removeMemberAggregate struct {
+	member   membershipRecord
+	assigned []taskRecord // tasks of the project assigned to the member
+}
+
+func loadRemoveMember(x *tx, projectID, userID string) (*removeMemberAggregate, error) {
+	p, ok := x.findProject(projectID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	m, ok := p.Membership(x, userID)
+	if !ok {
+		return nil, deny(ErrNotFound, "member not found")
+	}
+	return &removeMemberAggregate{member: m, assigned: m.AssignedTasks(x)}, nil
+}
+
+func (a *removeMemberAggregate) validate() error { return nil }
+
+func (a *removeMemberAggregate) apply(x *tx) {
+	for _, t := range a.assigned {
+		t.Unassign(x)
+	}
+	a.member.Destroy(x)
+}
