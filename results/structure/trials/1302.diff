+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager removes contributor", "ann", "/projects/web/members/cat", 204},
+		{"manager removes viewer", "ann", "/projects/web/members/dan", 204},
+		{"manager removes self", "ivy", "/projects/ops/members/ivy", 204},
+		{"contributor cannot", "ben", "/projects/web/members/cat", 403},
+		{"viewer cannot", "dan", "/projects/web/members/ben", 403},
+		{"org admin without role cannot", "eve", "/projects/web/members/ben", 403},
+		{"target not a member", "ann", "/projects/web/members/hal", 404},
+		{"target unknown user", "ann", "/projects/web/members/zed", 404},
+		{"caller not a member", "hal", "/projects/web/members/ben", 404},
+		{"caller other org", "gus", "/projects/web/members/ben", 404},
+		{"archived", "ann", "/projects/legacy/members/ben", 409},
+		{"anonymous", "", "/projects/web/members/cat", 401},
+		{"unknown caller", "zed", "/projects/web/members/cat", 401},
+		{"missing project", "ann", "/projects/nope/members/ben", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveMemberEffects(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "DELETE", "/projects/web/members/cat", "ann", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+
+	// The removed member is no longer a member, so cannot read the project.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "cat", ""); code != 404 {
+		t.Fatalf("removed member read: got %d want 404", code)
+	}
+	// Removing them again is a 404: they are not a member any more.
+	if code, _ := do(t, srv, "DELETE", "/projects/web/members/cat", "ann", ""); code != 404 {
+		t.Fatalf("second remove: got %d want 404", code)
+	}
+
+	// Tasks they were assigned to in the project are unassigned...
+	code, body := do(t, srv, "GET", "/projects/web/tasks", "ann", "")
+	if code != 200 {
+		t.Fatal(code)
+	}
+	var tasks []Task
+	json.Unmarshal([]byte(body), &tasks)
+	for _, task := range tasks {
+		if task.ID == "t2" && task.Assignee != "" {
+			t.Fatalf("t2 still assigned to %q", task.Assignee)
+		}
+		if task.ID == "t1" && task.Assignee != "ben" {
+			t.Fatalf("t1 assignee changed to %q", task.Assignee)
+		}
+	}
+
+	// ...but their assignments in other projects are untouched.
+	code, body = do(t, srv, "GET", "/projects/ops/tasks/t4", "ann", "")
+	if code != 200 || !strings.Contains(body, `"assignee":"cat"`) {
+		t.Fatalf("ops task t4 changed: %d %s", code, body)
+	}
+}
