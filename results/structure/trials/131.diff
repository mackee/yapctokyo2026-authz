+
+// ---- organization capabilities ----------------------------------------------------
+
+type orgScope struct {
+	as  *actorScope
+	oid string
+}
+
+func (s *orgScope) ID() string { return s.oid }
+
+// Admin applies the org admin rule: the organization must be the actor's own
+// (else 404, like any other org the actor cannot see), and the actor must be an
+// org admin of it (else 403).
+func (s *orgScope) Admin() (AdminOrg, error) {
+	err := s.as.a.st.read(func(st *state) error {
+		if s.as.actor.org != s.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		if !s.as.actor.orgAdmin {
+			return deny(ErrForbidden, "forbidden")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &adminOrg{orgScope: s}, nil
+}
+
+// AdminOrg may move users out of the organization it was acquired for.
+type AdminOrg interface {
+	ID() string
+	// TransferUser moves a user of this organization to toOrgID. The user's
+	// project memberships in this organization are removed, tasks assigned to
+	// the user are unassigned, and the user loses org admin rights (admin rights
+	// do not carry over to the destination). All of it commits atomically.
+	TransferUser(userID, toOrgID string) (UserView, error)
+}
+
+type adminOrg struct{ *orgScope }
+
+func (a *adminOrg) TransferUser(userID, toOrgID string) (UserView, error) {
+	if toOrgID == "" {
+		return UserView{}, deny(ErrInvalid, "toOrgId is required")
+	}
+	if toOrgID == a.oid {
+		return UserView{}, deny(ErrInvalid, "user is already in that organization")
+	}
+	var v UserView
+	err := a.as.a.st.tx(func(s *state) error {
+		u, ok := s.users[userID]
+		if !ok || u.org != a.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		if !s.orgs[toOrgID] {
+			return deny(ErrInvalid, "unknown organization")
+		}
+		// Project memberships are per organization, so they go with the user.
+		for pid, m := range s.members {
+			if s.projects[pid].org == a.oid {
+				delete(m, userID)
+			}
+		}
+		// Tasks held by the user can only stay assigned to a current member.
+		for tid, t := range s.tasks {
+			if t.assignee.user == userID {
+				t.assignee = Assignee{project: t.project}
+				s.tasks[tid] = t
+			}
+		}
+		u.org = toOrgID
+		u.orgAdmin = false
+		s.users[userID] = u
+		v = UserView{ID: u.id, OrgID: u.org}
+		return nil
+	})
+	return v, err
+}
