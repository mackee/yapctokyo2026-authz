+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/cat", 204},
+		{"org admin without memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"manager is not org admin", "ann", "/orgs/acme/users/cat", 403},
+		{"other org's admin target", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"other org path", "eve", "/orgs/globex/users/gus", 404},
+		{"anonymous", "", "/orgs/acme/users/cat", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/cat", "eve", ""); code != 204 {
+		t.Fatalf("got %d", code)
+	}
+	// cat lost access to every project.
+	for _, p := range []string{"web", "ops"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "cat", ""); code != 404 {
+			t.Fatalf("%s: cat still reads, got %d", p, code)
+		}
+	}
+	// cat's tasks (t2 in web, t4 in ops) are unassigned; others are untouched.
+	_, body := do(t, h, "GET", "/projects/web/tasks", "ann", "")
+	var tasks []Task
+	json.Unmarshal([]byte(body), &tasks)
+	for _, task := range tasks {
+		want := map[string]string{"t1": "ben", "t2": "", "t3": ""}[task.ID]
+		if task.AssigneeID != want {
+			t.Fatalf("%s assignee %q want %q", task.ID, task.AssigneeID, want)
+		}
+	}
+	_, body = do(t, h, "GET", "/projects/ops/tasks/t4", "ann", "")
+	var t4 Task
+	json.Unmarshal([]byte(body), &t4)
+	if t4.AssigneeID != "" {
+		t.Fatalf("t4 still assigned to %q", t4.AssigneeID)
+	}
+	// other members keep their access.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben got %d", code)
+	}
+}
