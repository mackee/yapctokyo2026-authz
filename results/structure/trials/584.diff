+// removeOrgUserAggregate removes one user from every project of an org. The
+// tasks assigned to the user in those projects are unassigned, because an
+// assignee must be a member of the task's project.
+type removeOrgUserAggregate struct {
+	memberships []*Membership // the user's memberships in projects of the org
+}
+
+func loadRemoveOrgUser(ctx context.Context, tx DB, orgID, userID string) (*removeOrgUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != orgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	all, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	a := &removeOrgUserAggregate{}
+	for _, m := range all {
+		p, err := m.Project(ctx, tx)
+		if errors.Is(err, ErrNoRows) {
+			continue
+		} else if err != nil {
+			return nil, err
+		}
+		if p.Org == orgID {
+			a.memberships = append(a.memberships, m)
+		}
+	}
+	return a, nil
+}
+
+func (a *removeOrgUserAggregate) validate() error { return nil }
+
+func (a *removeOrgUserAggregate) apply(ctx context.Context, tx DB) error {
+	for _, m := range a.memberships {
+		tasks, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return err
+		}
+		for _, t := range tasks {
+			if err := t.unassign(ctx, tx); err != nil {
+				return err
+			}
+		}
+		if err := m.destroy(ctx, tx); err != nil {
+			return err
+		}
+	}
+	return nil
+}
