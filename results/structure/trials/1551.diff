+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"missing project", "ann", "nope", 404},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeMakesEveryoneViewer(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got []map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []string{"ann", "ben", "cat", "dan", "ivy"}
+	if len(got) != len(want) {
+		t.Fatalf("got %v", got)
+	}
+	for i, m := range got {
+		if m["userId"] != want[i] || m["role"] != "viewer" || len(m) != 2 {
+			t.Fatalf("member %d: %v", i, m)
+		}
+	}
+
+	// Nobody can change tasks any more, managers included.
+	writes := []struct{ method, path, body string }{
+		{"POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"PATCH", "/projects/web/tasks/t3", `{"title":"y"}`},
+		{"DELETE", "/projects/web/tasks/t1", ""},
+	}
+	for _, user := range []string{"ann", "ben", "cat", "dan", "ivy", "eve"} {
+		for _, w := range writes {
+			if code, _ := do(t, h, w.method, w.path, user, w.body); code != 403 {
+				t.Errorf("%s %s %s: got %d want 403", user, w.method, w.path, code)
+			}
+		}
+	}
+	// A frozen project is still readable, and other projects are untouched.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Errorf("read after freeze: %d", code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"doing"}`); code != 200 {
+		t.Errorf("other project write: %d", code)
+	}
+}
+
+func TestFreezeTwice(t *testing.T) {
+	h := newServer()
+	do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 403 {
+		t.Fatalf("second freeze: got %d want 403", code)
+	}
+}
