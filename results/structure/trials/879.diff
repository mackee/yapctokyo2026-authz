+func TestUpdateMembers(t *testing.T) {
+	cases := []struct {
+		name, pid, user, body string
+		want                  int
+	}{
+		{"manager ok", "web", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 200},
+		{"promote", "web", "ivy", `{"roles":{"dan":"manager"}}`, 200},
+		{"contributor forbidden", "web", "ben", `{"roles":{"dan":"manager"}}`, 403},
+		{"viewer forbidden", "web", "dan", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin forbidden", "web", "eve", `{"roles":{"dan":"manager"}}`, 403},
+		{"non member", "web", "hal", `{"roles":{"dan":"manager"}}`, 404},
+		{"other org", "web", "gus", `{"roles":{"dan":"manager"}}`, 404},
+		{"anonymous", "web", "", `{"roles":{"dan":"manager"}}`, 401},
+		{"archived", "legacy", "ann", `{"roles":{"ben":"viewer"}}`, 409},
+		{"bad role", "web", "ann", `{"roles":{"ben":"boss"}}`, 400},
+		{"non member target", "web", "ann", `{"roles":{"hal":"viewer"}}`, 400},
+		{"empty", "web", "ann", `{"roles":{}}`, 400},
+		{"last manager", "ops", "ivy", `{"roles":{"ivy":"viewer"}}`, 400},
+		{"swap managers", "ops", "ivy", `{"roles":{"ivy":"viewer","cat":"manager"}}`, 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.pid+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMembersResultAndAtomic(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d", code)
+	}
+	var got []member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	roles := map[string]string{}
+	for _, m := range got {
+		roles[m.UserID] = m.Role
+	}
+	if len(got) != 5 || roles["ben"] != "viewer" || roles["dan"] != "contributor" || roles["ann"] != "manager" {
+		t.Fatalf("unexpected members: %s", body)
+	}
+
+	// One bad entry must leave everything untouched.
+	h = newServer()
+	if code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","hal":"viewer"}}`); code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"doing"}`); code != 200 {
+		t.Fatalf("ben should still be a contributor, got %d", code)
+	}
+}
