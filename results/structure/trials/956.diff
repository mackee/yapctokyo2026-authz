+// ---- operations -----------------------------------------------------------------------
+
+var validRoles = map[string]bool{RoleManager: true, RoleContributor: true, RoleViewer: true}
+
+// SetRoles changes the roles of several members of the project, all or
+// nothing, and returns the project's members afterwards. roles maps user ID to
+// the new role.
+func (mt *MembershipTable) SetRoles(ctx context.Context, db DB, authz ProjectAuthz, roles map[string]string) ([]*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if len(roles) == 0 {
+		return nil, deny(ErrInvalid, "roles must not be empty")
+	}
+	for _, role := range roles {
+		if !validRoles[role] {
+			return nil, deny(ErrInvalid, "invalid role")
+		}
+	}
+	var out []*Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadSetRoles(ctx, tx, authz.ProjectID(), roles)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if err := agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		out, err = mt.ListByProject(ctx, tx, authz.ProjectID())
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
