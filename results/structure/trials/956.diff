+// setRolesAggregate changes the roles of several members of one project.
+type setRolesAggregate struct {
+	members  []*Membership // existing memberships to change, ordered by user ID
+	roles    map[string]string
+	assigned map[string][]*Task // user ID -> tasks assigned in the project (unassigned when demoted to viewer)
+}
+
+func loadSetRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*setRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	all, err := p.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	a := &setRolesAggregate{roles: roles, assigned: map[string][]*Task{}}
+	found := 0
+	for _, m := range all {
+		if _, ok := roles[m.UserID]; ok {
+			a.members = append(a.members, m)
+			found++
+		}
+	}
+	if found != len(roles) {
+		return nil, deny(ErrInvalid, "every user must be a member of the project")
+	}
+	for _, m := range a.members {
+		ts, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.assigned[m.UserID] = ts
+	}
+	return a, nil
+}
+
+func (a *setRolesAggregate) validate() error {
+	for _, m := range a.members {
+		if !validRoles[a.roles[m.UserID]] {
+			return deny(ErrInvalid, "invalid role")
+		}
+	}
+	return nil
+}
+
+// apply changes the roles. A member demoted to viewer can no longer be an
+// assignee, so their tasks in the project are unassigned.
+func (a *setRolesAggregate) apply(ctx context.Context, tx DB) error {
+	for _, m := range a.members {
+		role := a.roles[m.UserID]
+		if err := m.setRole(ctx, tx, role); err != nil {
+			return err
+		}
+		if !isWriterRole(role) {
+			for _, t := range a.assigned[m.UserID] {
+				if err := t.unassign(ctx, tx); err != nil {
+					return err
+				}
+			}
+		}
+	}
+	return nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
