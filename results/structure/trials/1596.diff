 // NewUserTable returns the users table.
 func NewUserTable() *UserTable { return &UserTable{} }
 
+// OrgExists reports whether any user or project belongs to the organization
+// (organizations have no table of their own).
+func (*UserTable) OrgExists(ctx context.Context, db DB, org string) (bool, error) {
+	var n int
+	if err := db.QueryRowContext(ctx,
+		`SELECT (SELECT COUNT(*) FROM users WHERE org_id = ?) + (SELECT COUNT(*) FROM projects WHERE org_id = ?)`,
+		org, org).Scan(&n); err != nil {
+		return false, err
+	}
+	return n > 0, nil
+}
+
+// UserTableTransferInput is the input of UserTable.Transfer.
+type UserTableTransferInput struct {
+	ToOrg string
+}
+
+// Transfer moves the user to another organization, all or nothing. Only an org
+// admin of the user's current organization may do it.
+func (*UserTable) Transfer(ctx context.Context, db DB, authz OrgAuthz, userID string, in UserTableTransferInput) (*User, error) {
+	if err := authz.CanManageUsers(); err != nil {
+		return nil, err
+	}
+	var u *User
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadTransferUser(ctx, tx, userID, in.ToOrg)
+		if err != nil {
+			return err
+		}
+		// A user of another organization is invisible to this org's admin.
+		if agg.user.Org != authz.OrgID() {
+			return deny(ErrNotFound, "not found")
+		}
+		if err := agg.validate(ctx, tx); err != nil {
+			return err
+		}
+		u, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return u, nil
+}
+
 // Find returns the user with the ID, or ErrNoRows.
