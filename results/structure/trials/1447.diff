+// MemberAuthz is what the actor may do with one member of one project.
+type MemberAuthz struct {
+	project ProjectAuthz
+	user    string
+}
+
+// Project returns the project-level authorization the member object came from.
+func (a MemberAuthz) Project() ProjectAuthz { return a.project }
+
+// UserID returns the member the object is bound to.
+func (a MemberAuthz) UserID() string { return a.user }
+
+// CanRead reports whether the actor may read the member. NewMemberAuthz only
+// returns objects that can read, so this is true for every built object.
+func (a MemberAuthz) CanRead() bool { return a.user != "" && a.project.CanRead() }
+
+// CanMove returns nil if the actor may move the member out of the project:
+// managers only, project not archived. The destination is checked by the
+// operation itself.
+func (a MemberAuthz) CanMove() error {
+	if !a.CanRead() {
+		return deny(ErrForbidden, "forbidden")
+	}
+	return a.project.CanManageMembers()
