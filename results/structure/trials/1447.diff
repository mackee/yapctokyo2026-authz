+// MembershipTableMoveInput is the input of MembershipTable.Move.
+type MembershipTableMoveInput struct {
+	ToProjectID string
+}
+
+// Move moves the member to another project with the same role, all or nothing.
+// The actor must manage both projects and neither may be archived. Checks run in
+// the order of the formal model (moveOutcome in spec/taskboard.qnt).
+func (*MembershipTable) Move(ctx context.Context, db DB, authz MemberAuthz, in MembershipTableMoveInput) (*Membership, error) {
+	if err := authz.CanMove(); err != nil {
+		return nil, err
+	}
+	src := authz.Project()
+	if in.ToProjectID == src.ProjectID() {
+		return nil, deny(ErrInvalid, "destination must be a different project")
+	}
+	// The destination must be readable by the actor (404), then writable (403, 409).
+	dst, err := NewProjectAuthz(ctx, db, src.Actor(), in.ToProjectID)
+	if err != nil {
+		return nil, err
+	}
+	if err := dst.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var moved *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		member, err := NewMembershipTable().Find(ctx, tx, src.ProjectID(), authz.UserID())
+		if errors.Is(err, ErrNoRows) {
+			return deny(ErrNotFound, "not found")
+		} else if err != nil {
+			return err
+		}
+		agg, err := loadMoveMember(ctx, tx, member, in.ToProjectID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		moved, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return moved, nil
+}
