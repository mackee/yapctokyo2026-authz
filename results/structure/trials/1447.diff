+// moveMemberAggregate moves one member from a project to another with the same
+// role. The member's tasks in the source project become unassigned, since the
+// member is no longer a contributor or manager of it.
+type moveMemberAggregate struct {
+	member *Membership // the membership in the source project
+	user   *User
+	target *Project
+	exists bool // the user is already a member of the target
+	tasks  []*Task
+}
+
+func loadMoveMember(ctx context.Context, tx DB, member *Membership, toProjectID string) (*moveMemberAggregate, error) {
+	target, err := NewProjectTable().Find(ctx, tx, toProjectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveMemberAggregate{member: member, target: target}
+	if a.user, err = member.User(ctx, tx); err != nil {
+		return nil, err
+	}
+	if _, err := target.Membership(ctx, tx, member.UserID); err == nil {
+		a.exists = true
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	if a.tasks, err = member.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.user.Org != a.target.Org {
+		return deny(ErrInvalid, "member must belong to the project's organization")
+	}
+	if a.exists {
+		return deny(ErrInvalid, "user is already a member of the destination project")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.member.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	moved := &Membership{ProjectID: a.target.ID, UserID: a.member.UserID, Role: a.member.Role}
+	if err := moved.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return moved, nil
+}
