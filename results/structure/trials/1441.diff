+// updateRolesAggregate changes the roles of several members of one project.
+type updateRolesAggregate struct {
+	project *Project
+	targets []*Membership // the members to change, ordered by user ID
+	roles   map[string]string
+}
+
+func loadUpdateRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*updateRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	all, err := p.Memberships(ctx, tx) // ordered by user ID
+	if err != nil {
+		return nil, err
+	}
+	a := &updateRolesAggregate{project: p, roles: roles}
+	for _, m := range all {
+		if _, ok := roles[m.UserID]; ok {
+			a.targets = append(a.targets, m)
+		}
+	}
+	if len(a.targets) != len(roles) {
+		return nil, deny(ErrInvalid, "every user must be a member of the project")
+	}
+	return a, nil
+}
+
+func (a *updateRolesAggregate) validate(ctx context.Context, tx DB) error {
+	for _, m := range a.targets {
+		role := a.roles[m.UserID]
+		if role != RoleManager && role != RoleContributor && role != RoleViewer {
+			return deny(ErrInvalid, "invalid role")
+		}
+		if isWriterRole(role) {
+			continue
+		}
+		// An assignee must stay a contributor or manager.
+		tasks, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return err
+		}
+		if len(tasks) > 0 {
+			return deny(ErrInvalid, "member has assigned tasks and must remain a contributor or manager")
+		}
+	}
+	return nil
+}
+
+func (a *updateRolesAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for _, m := range a.targets {
+		if err := m.setRole(ctx, tx, a.roles[m.UserID]); err != nil {
+			return nil, err
+		}
+	}
+	return a.project.Memberships(ctx, tx)
+}
+
