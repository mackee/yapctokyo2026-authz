+func TestUpdateMemberRoles(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager", "ann", "/projects/web/members", `{"roles":{"dan":"contributor","ivy":"viewer"}}`, 200},
+		{"assignee stays writer", "ann", "/projects/web/members", `{"roles":{"ben":"manager"}}`, 200},
+		{"assignee demoted", "ann", "/projects/web/members", `{"roles":{"ben":"viewer"}}`, 400},
+		{"not a member", "ann", "/projects/web/members", `{"roles":{"dan":"contributor","hal":"viewer"}}`, 400},
+		{"invalid role", "ann", "/projects/web/members", `{"roles":{"dan":"boss"}}`, 400},
+		{"empty roles", "ann", "/projects/web/members", `{"roles":{}}`, 400},
+		{"bad json", "ann", "/projects/web/members", `{`, 400},
+		{"contributor", "ben", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin", "eve", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 404},
+		{"missing project", "ann", "/projects/nope/members", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 401},
+		{"archived", "ann", "/projects/legacy/members", `{"roles":{"ben":"manager"}}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+		})
+	}
+
+	t.Run("returns members after the change", func(t *testing.T) {
+		h := newServer()
+		code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","ivy":"viewer"}}`)
+		if code != 200 {
+			t.Fatalf("got %d: %s", code, body)
+		}
+		var got []map[string]string
+		if err := json.Unmarshal([]byte(body), &got); err != nil {
+			t.Fatal(err)
+		}
+		want := []map[string]string{
+			{"userId": "ann", "role": "manager"},
+			{"userId": "ben", "role": "contributor"},
+			{"userId": "cat", "role": "contributor"},
+			{"userId": "dan", "role": "contributor"},
+			{"userId": "ivy", "role": "viewer"},
+		}
+		if len(got) != len(want) {
+			t.Fatalf("got %v want %v", got, want)
+		}
+		for i := range want {
+			if got[i]["userId"] != want[i]["userId"] || got[i]["role"] != want[i]["role"] {
+				t.Fatalf("got %v want %v", got, want)
+			}
+		}
+		// dan can now write: a contributor may create a task assigned to themselves.
+		if code, body := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x","assignee":"dan"}`); code != 200 {
+			t.Fatalf("dan create: got %d: %s", code, body)
+		}
+	})
+
+	t.Run("failure changes nothing", func(t *testing.T) {
+		h := newServer()
+		// dan would become a contributor, but ben (assigned t1) cannot become a viewer.
+		if code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","ben":"viewer"}}`); code != 400 {
+			t.Fatalf("got %d want 400", code)
+		}
+		if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x","assignee":"dan"}`); code != 403 {
+			t.Fatalf("dan must still be a viewer: got %d want 403", code)
+		}
+		if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 200 {
+			t.Fatalf("ben must still be a contributor: got %d want 200", code)
+		}
+	})
+}
