+func TestFreeze(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+		{"missing project", "ann", "nope", 404},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	want := `[{"userId":"ann","role":"viewer"},{"userId":"ben","role":"viewer"},{"userId":"cat","role":"viewer"},{"userId":"dan","role":"viewer"},{"userId":"ivy","role":"viewer"}]`
+	if got := strings.TrimSpace(body); got != want {
+		t.Fatalf("body mismatch\n got: %s\nwant: %s", got, want)
+	}
+}
+
+func TestFreezeBlocksWrites(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d body=%s", code, body)
+	}
+	cases := []struct {
+		name, user, method, path, body string
+		want                           int
+	}{
+		{"manager patches", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"contributor patches own", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`, 403},
+		{"manager creates", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"contributor creates", "ben", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"manager deletes", "ann", "DELETE", "/projects/web/tasks/t1", "", 403},
+		{"ex-manager freezes again", "ann", "POST", "/projects/web/freeze", "", 403},
+		{"viewer reads", "dan", "GET", "/projects/web/tasks/t1", "", 200},
+		{"other project unaffected", "cat", "PATCH", "/projects/ops/tasks/t4", `{"status":"done"}`, 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, h, c.method, c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+// The freeze flag is a backstop: even if a member regains a writing role
+// (no API does this today), writes stay rejected with 409.
+func TestFrozenFlagRejectsWritesEvenForManagers(t *testing.T) {
+	db, err := openSeededDB()
+	if err != nil {
+		t.Fatal(err)
+	}
+	h := (&server{db: db}).routes()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d body=%s", code, body)
+	}
+	if _, err := db.Exec(`UPDATE memberships SET role = 'manager' WHERE project_id = 'web' AND user_id = 'ann'`); err != nil {
+		t.Fatal(err)
+	}
+	cases := []struct {
+		name, method, path, body string
+	}{
+		{"patch", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"create", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"delete", "DELETE", "/projects/web/tasks/t1", ""},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, h, c.method, c.path, "ann", c.body)
+			if code != 409 {
+				t.Fatalf("got %d want 409 body=%s", code, body)
+			}
+		})
+	}
+}
