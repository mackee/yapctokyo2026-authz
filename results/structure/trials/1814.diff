new file mode 100644
index 0000000..06fc004
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,66 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestUpdateMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager promotes viewer", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"manager promotes contributor", "ann", "/projects/web/members/cat", `{"role":"manager"}`, 200},
+		{"manager demotes assignee", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 400},
+		{"invalid role", "ann", "/projects/web/members/dan", `{"role":"owner"}`, 400},
+		{"missing role", "ann", "/projects/web/members/dan", `{}`, 400},
+		{"contributor", "ben", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"viewer", "dan", "/projects/web/members/cat", `{"role":"viewer"}`, 403},
+		{"org admin", "eve", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"non member actor", "hal", "/projects/web/members/dan", `{"role":"contributor"}`, 404},
+		{"other org actor", "gus", "/projects/web/members/dan", `{"role":"contributor"}`, 404},
+		{"anonymous", "", "/projects/web/members/dan", `{"role":"contributor"}`, 401},
+		{"unknown user", "zed", "/projects/web/members/dan", `{"role":"contributor"}`, 401},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"contributor"}`, 404},
+		{"target in other org", "ann", "/projects/web/members/gus", `{"role":"contributor"}`, 404},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRoleResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("response is not JSON: %v: %s", err, body)
+	}
+	if got["userId"] != "dan" || got["role"] != "contributor" || len(got) != 2 {
+		t.Fatalf("got %s, want {\"userId\":\"dan\",\"role\":\"contributor\"}", body)
+	}
+}
+
+func TestUpdateMemberRolePersists(t *testing.T) {
+	h := newServer()
+	// ben is the assignee of t1 in web, so demoting him is refused until the task is unassigned.
+	if code, body := do(t, h, "PATCH", "/projects/web/tasks/t1", "ann", `{"assignee":""}`); code != 200 {
+		t.Fatalf("unassign: got %d want 200: %s", code, body)
+	}
+	if code, body := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote: got %d want 200: %s", code, body)
+	}
+	// As a viewer, ben can no longer create tasks in web.
+	if code, body := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Fatalf("viewer create: got %d want 403: %s", code, body)
+	}
+}
