+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben", 204},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"project manager is not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"plain member", "ben", "/orgs/acme/users/cat", 403},
+		{"other org's caller", "gus", "/orgs/acme/users/ben", 404},
+		{"target in another org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ben", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserDropsAllMemberships(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ann", "eve", ""); code != 204 {
+		t.Fatal(code)
+	}
+	// ann was in web, ops and legacy (archived); all are now hidden from her.
+	for _, p := range []string{"web", "ops", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ann", ""); code != 404 {
+			t.Fatalf("project %s: got %d want 404", p, code)
+		}
+	}
+	// Other members are untouched.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben lost access: %d", code)
+	}
+}
