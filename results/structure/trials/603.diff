+// moveMemberAggregate moves one member from the project to another project,
+// keeping the role. Tasks the member was assigned to in the source project are
+// unassigned, since an assignee must be a contributor or manager of the task's
+// project.
+type moveMemberAggregate struct {
+	from     *Membership
+	user     *User
+	to       *Project
+	existing *Membership // the user's membership in the destination; nil when none
+	tasks    []*Task     // from.AssignedTasks
+}
+
+func loadMoveMember(ctx context.Context, tx DB, authz ProjectAuthz, in MembershipTableMoveInput) (*moveMemberAggregate, error) {
+	if in.ToProjectID == authz.ProjectID() {
+		return nil, deny(ErrInvalid, "destination must be a different project")
+	}
+	// The destination must be readable by the actor, like any project (404),
+	// and the actor must be allowed to add members to it.
+	toAuthz, err := NewProjectAuthz(ctx, tx, authz.Actor(), in.ToProjectID)
+	if err != nil {
+		return nil, err
+	}
+	if err := toAuthz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	to, err := NewProjectTable().Find(ctx, tx, toAuthz.ProjectID())
+	if err != nil {
+		return nil, err
+	}
+	from, err := NewMembershipTable().Find(ctx, tx, authz.ProjectID(), in.UserID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveMemberAggregate{from: from, to: to}
+	if a.user, err = from.User(ctx, tx); err != nil {
+		return nil, err
+	}
+	if a.existing, err = to.Membership(ctx, tx, in.UserID); errors.Is(err, ErrNoRows) {
+		a.existing = nil
+	} else if err != nil {
+		return nil, err
+	}
+	if a.tasks, err = from.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.user.Org != a.to.Org {
+		return deny(ErrInvalid, "member must belong to the destination project's organization")
+	}
+	if a.existing != nil {
+		return deny(ErrInvalid, "user is already a member of the destination project")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.from.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	m := a.to.newMembership(a.from.UserID, a.from.Role)
+	if err := m.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
+
