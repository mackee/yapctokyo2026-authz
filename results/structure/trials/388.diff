+type transferRequest struct {
+	ToOrgID string `json:"toOrgId"`
+}
+
+func transferUser(ctx tanukirpc.Context[*userRegistry], _ struct{}) (*capability.UserView, error) {
+	m, err := ctx.Registry().scope.Manage()
+	if err != nil {
+		return nil, err
+	}
+	var req transferRequest
+	if err := decodeBody(ctx.Request(), &req); err != nil {
+		return nil, errInvalidBody
+	}
+	v, err := m.Transfer(req.ToOrgID)
+	if err != nil {
+		return nil, err
+	}
+	return &v, nil
+}
