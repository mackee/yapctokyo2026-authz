index 0000000..a852253
--- /dev/null
+++ b/internal/capability/org.go
@@ -0,0 +1,86 @@
+package capability
+
+// Organization capabilities. An org admin may move a user of their organization
+// to another organization (for example a transfer between group companies).
+
+// UserView is the public representation of a user.
+type UserView struct {
+	ID    string `json:"id"`
+	OrgID string `json:"orgId"`
+}
+
+// OrgScope is bound to one actor and one organization ID. It grants nothing by
+// itself; call User(uid) and then Manage to acquire a capability.
+type OrgScope interface {
+	User(userID string) UserScope
+}
+
+// UserScope is bound to one actor, one organization ID and one user ID.
+type UserScope interface {
+	Manage() (ManageUser, error)
+}
+
+// ManageUser is the org-admin capability for one user of an organization.
+type ManageUser interface {
+	// Transfer moves the user to toOrgID. Nothing changes if the move would
+	// break a model rule (ErrInvalid).
+	Transfer(toOrgID string) (UserView, error)
+}
+
+type orgScope struct {
+	as    *actorScope
+	orgID string
+}
+
+func (s *orgScope) User(userID string) UserScope { return &userScope{os: s, uid: userID} }
+
+type userScope struct {
+	os  *orgScope
+	uid string
+}
+
+// orgUser applies the org admin rule: the actor belongs to the organization
+// (else 404), is one of its org admins (else 403), and the user belongs to the
+// organization (else 404).
+func orgUser(x *tx, act Actor, orgID, userID string) (userRecord, error) {
+	if act.org != orgID {
+		return userRecord{}, deny(ErrNotFound, "not found")
+	}
+	if !act.orgAdmin {
+		return userRecord{}, deny(ErrForbidden, "forbidden")
+	}
+	u, ok := x.findUser(userID)
+	if !ok || u.Org != orgID {
+		return userRecord{}, deny(ErrNotFound, "not found")
+	}
+	return u, nil
+}
+
+func (s *userScope) Manage() (ManageUser, error) {
+	err := s.os.as.a.db.view(func(x *tx) error {
+		_, err := orgUser(x, s.os.as.actor, s.os.orgID, s.uid)
+		return err
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &manageUser{us: s}, nil
+}
+
+type manageUser struct{ us *userScope }
+
+func (m *manageUser) Transfer(toOrgID string) (UserView, error) {
+	var v UserView
+	err := m.us.os.as.a.db.update(func(x *tx) error {
+		agg, err := loadTransferUser(x, m.us.os.orgID, m.us.uid, toOrgID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		v = agg.apply(x)
+		return nil
+	})
+	return v, err
+}
