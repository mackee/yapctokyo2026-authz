+// orgExists reports whether any user or project belongs to the organization.
+// Organizations have no table of their own.
+func (x *tx) orgExists(orgID string) bool {
+	for _, u := range x.t.users {
+		if u.Org == orgID {
+			return true
+		}
+	}
+	for _, p := range x.t.projects {
+		if p.Org == orgID {
+			return true
+		}
+	}
+	return false
+}
+
 func (x *tx) tasksIn(projectID string) []taskRecord {
 	out := []taskRecord{}
 	for _, t := range x.t.tasks {
@@ -276,6 +292,14 @@ func (r *taskRecord) Unassign(x *tx) {
 	r.save(x)
 }
 
+// MoveTo moves the user to another organization. Org admin rights are granted
+// per organization, so they do not carry over.
+func (r *userRecord) MoveTo(x *tx, org string) {
+	r.Org = org
+	r.OrgAdmin = false
+	r.save(x)
+}
+
 // Destroy deletes the task.
 func (r taskRecord) Destroy(x *tx) { delete(x.t.tasks, r.ID) }
 
