@@ -118,3 +118,48 @@ func loadDeleteTask(x *tx, taskID string) (*deleteTaskAggregate, error) {
 func (a *deleteTaskAggregate) validate() error { return nil }
 
 func (a *deleteTaskAggregate) apply(x *tx) { a.task.Destroy(x) }
+
+// transferUserAggregate moves one user of an organization to another organization.
+type transferUserAggregate struct {
+	user     userRecord
+	toOrg    string
+	projects []projectRecord // the projects the user is a member of
+}
+
+func loadTransferUser(x *tx, orgID, userID, toOrgID string) (*transferUserAggregate, error) {
+	u, ok := x.findUser(userID)
+	if !ok || u.Org != orgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if toOrgID == "" || toOrgID == orgID {
+		return nil, deny(ErrInvalid, "user must be transferred to another organization")
+	}
+	if !x.orgExists(toOrgID) {
+		return nil, deny(ErrInvalid, "unknown organization")
+	}
+	a := &transferUserAggregate{user: u, toOrg: toOrgID}
+	for _, m := range u.Memberships(x) {
+		p, _ := m.Project(x)
+		a.projects = append(a.projects, p)
+	}
+	return a, nil
+}
+
+// validate enforces "project members belong to the project's organization":
+// after the move, every membership must be in a project of the target
+// organization. Memberships are not moved automatically; the user must leave
+// the projects of the current organization first.
+func (a *transferUserAggregate) validate() error {
+	for _, p := range a.projects {
+		if p.Org != a.toOrg {
+			return deny(ErrInvalid, "user must leave the projects of the current organization before transfer")
+		}
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(x *tx) UserView {
+	u := a.user
+	u.MoveTo(x, a.toOrg)
+	return UserView{ID: u.ID, OrgID: u.Org}
+}
