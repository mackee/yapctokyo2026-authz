+// Move moves the task from the authorized project to the project toProjectID.
+// The task keeps its ID, title, status and assignee. The actor must be a
+// manager of the task's project (as for Delete); the destination must be
+// readable by the actor (else ErrNotFound), and the actor must be able to write
+// to it (contributor or manager there, and not archived). The assignee must be
+// a contributor or manager of the destination.
+func (*TaskTable) Move(ctx context.Context, db DB, authz TaskAuthz, toProjectID string) (*Task, error) {
+	if err := authz.CanManage(); err != nil {
+		return nil, err
+	}
+	dest, err := NewProjectAuthz(ctx, db, authz.Project().Actor(), toProjectID)
+	if err != nil {
+		return nil, err
+	}
+	if dest.ProjectID() == authz.Project().ProjectID() {
+		return nil, deny(ErrInvalid, "task is already in that project")
+	}
+	if err := dest.CanWrite(); err != nil {
+		return nil, err
+	}
+	var t *Task
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveTask(ctx, tx, authz.TaskID(), dest.ProjectID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if t, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return t, nil
+}
