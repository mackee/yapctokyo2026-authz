+// MembershipTableMoveInput is the input of MembershipTable.Move.
+type MembershipTableMoveInput struct {
+	UserID      string // the member to move; must be a member of the authorized project
+	ToProjectID string // the project to move the member to
+}
+
+// Move moves a member out of the authorized project and into ToProjectID, with
+// the same role. The actor must manage both projects. The member's tasks in the
+// authorized project are unassigned, since an assignee must belong to the
+// task's project. It returns the membership in the target project.
+func (*MembershipTable) Move(ctx context.Context, db DB, authz ProjectAuthz, in MembershipTableMoveInput) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if in.ToProjectID == authz.ProjectID() {
+		return nil, deny(ErrInvalid, "member is already in this project")
+	}
+	to, err := NewProjectAuthz(ctx, db, authz.Actor(), in.ToProjectID)
+	if err != nil {
+		return nil, err
+	}
+	if err := to.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveMember(ctx, tx, authz.ProjectID(), in.UserID, in.ToProjectID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if m, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
