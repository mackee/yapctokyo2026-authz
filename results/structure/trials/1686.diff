+// moveMemberAggregate moves one member from the source project to the target
+// project, keeping the role.
+type moveMemberAggregate struct {
+	from  *Membership // the member's membership in the source project
+	tasks []*Task     // the member's tasks in the source project
+	toID  string      // the target project
+}
+
+func loadMoveMember(ctx context.Context, tx DB, fromProjectID, userID, toProjectID string) (*moveMemberAggregate, error) {
+	from, err := NewMembershipTable().Find(ctx, tx, fromProjectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if _, err := NewMembershipTable().Find(ctx, tx, toProjectID, userID); err == nil {
+		return nil, deny(ErrInvalid, "member is already in the target project")
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	tasks, err := from.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &moveMemberAggregate{from: from, tasks: tasks, toID: toProjectID}, nil
+}
+
+// validate has nothing to check: the authorization objects already ensure the
+// target project is in the actor's organization, and the membership lookups
+// above ensure the member is in the source only.
+func (a *moveMemberAggregate) validate() error { return nil }
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.from.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	m := &Membership{ProjectID: a.toID, UserID: a.from.UserID, Role: a.from.Role}
+	if err := m.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
+
