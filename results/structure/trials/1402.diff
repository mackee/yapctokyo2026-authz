+// setRolesAggregate changes the roles of several members of one project.
+type setRolesAggregate struct {
+	project     *Project
+	memberships map[string]*Membership // every member of the project, by user ID
+	tasks       []*Task                // every task of the project
+	in          MembershipTableSetRolesInput
+}
+
+func loadSetRoles(ctx context.Context, tx DB, projectID string, in MembershipTableSetRolesInput) (*setRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if err != nil {
+		return nil, err
+	}
+	ms, err := p.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	ts, err := p.Tasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	a := &setRolesAggregate{project: p, memberships: map[string]*Membership{}, tasks: ts, in: in}
+	for _, m := range ms {
+		a.memberships[m.UserID] = m
+	}
+	for userID := range in.Roles {
+		if _, ok := a.memberships[userID]; !ok {
+			return nil, deny(ErrInvalid, "user is not a member of the project")
+		}
+	}
+	return a, nil
+}
+
+// validate checks the model rule on the roles after the change: every assignee
+// of a task in the project is still a contributor or manager.
+func (a *setRolesAggregate) validate() error {
+	for _, t := range a.tasks {
+		if t.AssigneeID == "" {
+			continue
+		}
+		role := ""
+		if m, ok := a.memberships[t.AssigneeID]; ok {
+			role = m.Role
+		}
+		if newRole, ok := a.in.Roles[t.AssigneeID]; ok {
+			role = newRole
+		}
+		if !isWriterRole(role) {
+			return deny(ErrInvalid, "assignee must be a contributor or manager of the project")
+		}
+	}
+	return nil
+}
+
+func (a *setRolesAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for userID, role := range a.in.Roles {
+		if err := a.memberships[userID].setRole(ctx, tx, role); err != nil {
+			return nil, err
+		}
+	}
+	return a.project.Memberships(ctx, tx)
+}
