+// MembershipTableSetRolesInput is the input of MembershipTable.SetRoles: the
+// new role of each member, by user ID.
+type MembershipTableSetRolesInput struct {
+	Roles map[string]string
+}
+
+// SetRoles changes the roles of several members of the project, all or
+// nothing, and returns the project's members after the change. If any entry
+// cannot be changed, nothing changes and the error says why.
+func (mt *MembershipTable) SetRoles(ctx context.Context, db DB, authz ProjectAuthz, in MembershipTableSetRolesInput) ([]*Membership, error) {
+	if len(in.Roles) == 0 {
+		return nil, deny(ErrInvalid, "roles must not be empty")
+	}
+	for _, role := range in.Roles {
+		if !isRole(role) {
+			return nil, deny(ErrInvalid, "invalid role")
+		}
+	}
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var out []*Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadSetRoles(ctx, tx, authz.ProjectID(), in)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if out, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
+
+// isRole reports whether role is one of the project roles.
+func isRole(role string) bool {
+	return role == RoleManager || role == RoleContributor || role == RoleViewer
+}
