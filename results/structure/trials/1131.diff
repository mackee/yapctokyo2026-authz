+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager moves assigned task", "ivy", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 200},
+		{"manager moves unassigned task", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 200},
+		{"assignee not writer in destination", "ivy", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 400},
+		{"contributor cannot move", "ben", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"viewer cannot move", "dan", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"org admin cannot move", "eve", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"non member", "hal", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 404},
+		{"other org", "gus", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 401},
+		{"unknown user", "zed", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 401},
+		{"task in other project", "ivy", "/projects/web/tasks/t4", `{"toProjectId":"ops"}`, 404},
+		{"unknown task", "ivy", "/projects/web/tasks/t99", `{"toProjectId":"ops"}`, 404},
+		{"unknown source project", "ivy", "/projects/nope/tasks/t1", `{"toProjectId":"ops"}`, 404},
+		{"archived source", "ann", "/projects/legacy/tasks/t5", `{"toProjectId":"web"}`, 409},
+		{"destination missing", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"nope"}`, 404},
+		{"destination other org", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"gx"}`, 404},
+		{"destination not writable", "ann", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 403},
+		{"destination archived", "ann", "/projects/web/tasks/t3", `{"toProjectId":"legacy"}`, 409},
+		{"same project", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"web"}`, 400},
+		{"missing toProjectId", "ivy", "/projects/web/tasks/t3", `{}`, 400},
+		{"bad body", "ivy", "/projects/web/tasks/t3", `not json`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsFieldsAndMovesProject(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d %s", code, body)
+	}
+	var moved Task
+	if err := json.Unmarshal([]byte(body), &moved); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", Assignee: "cat"}
+	if moved != want {
+		t.Fatalf("moved task = %+v, want %+v", moved, want)
+	}
+
+	code, body = do(t, h, "GET", "/projects/ops/tasks/t2", "ivy", "")
+	if code != 200 {
+		t.Fatalf("get in destination: got %d %s", code, body)
+	}
+	var got Task
+	json.Unmarshal([]byte(body), &got)
+	if got != want {
+		t.Fatalf("stored task = %+v, want %+v", got, want)
+	}
+
+	code, _ = do(t, h, "GET", "/projects/web/tasks/t2", "ivy", "")
+	if code != 404 {
+		t.Fatalf("old path: got %d want 404", code)
+	}
+}
