 }
 
+// moveTaskAggregate moves one task from its project to another project.
+type moveTaskAggregate struct {
+	task     *Task
+	project  *Project    // the destination project
+	assignee *Membership // the assignee's membership in the destination; nil when unassigned
+}
+
+func loadMoveTask(ctx context.Context, tx DB, taskID, fromProjectID, toProjectID string) (*moveTaskAggregate, error) {
+	t, err := NewTaskTable().Find(ctx, tx, taskID)
+	if errors.Is(err, ErrNoRows) || (err == nil && t.ProjectID != fromProjectID) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	p, err := NewProjectTable().Find(ctx, tx, toProjectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "task must belong to an existing project")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveTaskAggregate{task: t, project: p}
+	if t.AssigneeID != "" {
+		m, err := p.Membership(ctx, tx, t.AssigneeID)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "assignee must be a contributor or manager of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		a.assignee = m
+	}
+	return a, nil
+}
+
+func (a *moveTaskAggregate) validate() error {
+	if a.assignee != nil && !isWriterRole(a.assignee.Role) {
+		return deny(ErrInvalid, "assignee must be a contributor or manager of the project")
+	}
+	return nil
+}
+
+func (a *moveTaskAggregate) apply(ctx context.Context, tx DB) (*Task, error) {
+	if err := a.task.moveTo(ctx, tx, a.project.ID); err != nil {
+		return nil, err
+	}
+	return a.task, nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
