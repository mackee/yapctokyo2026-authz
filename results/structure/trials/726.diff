+// CanMoveTo returns nil if the actor may move the task from its project to
+// dest, the destination project's authorization object (NewProjectAuthz).
+// The actor must be a contributor or manager in both projects (else
+// ErrForbidden). A manager in both may move any task; otherwise the task must
+// be assigned to the actor (else ErrForbidden). Neither project may be archived
+// (else ErrArchived).
+func (a TaskAuthz) CanMoveTo(dest ProjectAuthz) error {
+	src := a.project
+	if !a.CanRead() || !isWriterRole(src.role) || !isWriterRole(dest.role) {
+		return deny(ErrForbidden, "forbidden")
+	}
+	bothManagers := src.role == RoleManager && dest.role == RoleManager
+	if !bothManagers && !a.isAssignee {
+		return deny(ErrForbidden, "only managers in both projects may move tasks not assigned to them")
+	}
+	if src.archived || dest.archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	return nil
+}
