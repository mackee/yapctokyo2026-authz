+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"anonymous", "", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 401},
+		{"malformed body", "ivy", "/projects/web/tasks/t3/move", `{}`, 400},
+		{"task not in source project", "ivy", "/projects/web/tasks/t4/move", `{"toProjectId":"legacy"}`, 404},
+		{"same project", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"web"}`, 400},
+		{"destination missing", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"nope"}`, 404},
+		{"destination in other org", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"gx"}`, 404},
+		{"destination not readable", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"legacy"}`, 404},
+		{"viewer in source", "ann", "/projects/ops/tasks/t4/move", `{"toProjectId":"web"}`, 403},
+		{"contributor moves task of other", "cat", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"manager in source, viewer in destination", "ann", "/projects/web/tasks/t2/move", `{"toProjectId":"ops"}`, 403},
+		{"contributor own task, archived destination", "ben", "/projects/web/tasks/t1/move", `{"toProjectId":"legacy"}`, 409},
+		{"manager, archived destination", "ann", "/projects/web/tasks/t1/move", `{"toProjectId":"legacy"}`, 409},
+		{"manager, archived source", "ann", "/projects/legacy/tasks/t5/move", `{"toProjectId":"web"}`, 409},
+		{"assignee not in destination", "ivy", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsTask(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move got %d body=%s", code, body)
+	}
+	var moved Task
+	if err := json.Unmarshal([]byte(body), &moved); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", AssigneeID: "cat"}
+	if moved != want {
+		t.Fatalf("moved task = %+v, want %+v", moved, want)
+	}
+
+	code, _ = do(t, h, "GET", "/projects/ops/tasks/t2", "ann", "")
+	if code != 200 {
+		t.Fatalf("task not readable in destination: %d", code)
+	}
+	code, _ = do(t, h, "GET", "/projects/web/tasks/t2", "ann", "")
+	if code != 404 {
+		t.Fatalf("task still readable in source: %d", code)
+	}
+}
