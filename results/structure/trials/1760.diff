+type member struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// members reads a project's members back through a PUT that re-sets the
+// manager's own role (there is no GET endpoint; an empty change is a 400).
+func members(t *testing.T, h http.Handler, project, manager string) map[string]string {
+	t.Helper()
+	code, body := do(t, h, "PUT", "/projects/"+project+"/members", manager, `{"roles":{"`+manager+`":"manager"}}`)
+	if code != 200 {
+		t.Fatalf("read back: %d %s", code, body)
+	}
+	var ms []member
+	if err := json.Unmarshal([]byte(body), &ms); err != nil {
+		t.Fatal(err)
+	}
+	out := map[string]string{}
+	for _, m := range ms {
+		out[m.UserID] = m.Role
+	}
+	return out
+}
+
+func TestUpdateMembers(t *testing.T) {
+	t.Run("changes roles and returns the member list", func(t *testing.T) {
+		h := newServer()
+		code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ivy":"viewer","dan":"contributor"}}`)
+		if code != 200 {
+			t.Fatalf("got %d %s", code, body)
+		}
+		var ms []member
+		if err := json.Unmarshal([]byte(body), &ms); err != nil {
+			t.Fatal(err)
+		}
+		want := []member{{"ann", "manager"}, {"ben", "contributor"}, {"cat", "contributor"}, {"dan", "contributor"}, {"ivy", "viewer"}}
+		if len(ms) != len(want) {
+			t.Fatalf("got %v want %v", ms, want)
+		}
+		for i := range want {
+			if ms[i] != want[i] {
+				t.Fatalf("got %v want %v", ms, want)
+			}
+		}
+	})
+
+	t.Run("change persists and only touches the named project", func(t *testing.T) {
+		h := newServer()
+		if code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"manager"}}`); code != 200 {
+			t.Fatal(code, body)
+		}
+		if got := members(t, h, "web", "ann")["dan"]; got != "manager" {
+			t.Fatalf("dan = %q", got)
+		}
+		if got := members(t, h, "ops", "ivy")["ann"]; got != "viewer" {
+			t.Fatalf("ops changed: ann = %q", got)
+		}
+	})
+
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"invalid role", "ann", "web", `{"roles":{"dan":"boss"}}`, 400},
+		{"empty role", "ann", "web", `{"roles":{"dan":""}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"unknown user", "ann", "web", `{"roles":{"zed":"viewer"}}`, 400},
+		{"assignee would become viewer", "ann", "web", `{"roles":{"ben":"viewer"}}`, 400},
+		{"invalid body beats access", "ben", "web", `{"roles":{"dan":"boss"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+
+	t.Run("all or nothing", func(t *testing.T) {
+		h := newServer()
+		// dan -> contributor is fine, hal is not a member: nothing may change.
+		code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","hal":"viewer"}}`)
+		if code != 400 {
+			t.Fatalf("got %d want 400", code)
+		}
+		// ivy -> viewer is fine, ben holds task t1: nothing may change.
+		code, _ = do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ivy":"viewer","ben":"viewer"}}`)
+		if code != 400 {
+			t.Fatalf("got %d want 400", code)
+		}
+		ms := members(t, h, "web", "ann")
+		if ms["dan"] != "viewer" || ms["ivy"] != "manager" || ms["ben"] != "contributor" {
+			t.Fatalf("roles changed: %v", ms)
+		}
+	})
+}
