 }
 
+// updateRolesAggregate changes the roles of several members of one project.
+type updateRolesAggregate struct {
+	project *Project
+	changes []roleChange // ordered by user ID
+}
+
+type roleChange struct {
+	member   *Membership // project.Membership(user)
+	role     string      // the new role
+	assigned []*Task     // member.AssignedTasks(): tasks the member is assignee of
+}
+
+func loadUpdateRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*updateRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "membership must belong to an existing project")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &updateRolesAggregate{project: p}
+	ids := make([]string, 0, len(roles))
+	for id := range roles {
+		ids = append(ids, id)
+	}
+	sort.Strings(ids)
+	for _, id := range ids {
+		m, err := p.Membership(ctx, tx, id)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "user "+id+" is not a member of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		tasks, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.changes = append(a.changes, roleChange{member: m, role: roles[id], assigned: tasks})
+	}
+	return a, nil
+}
+
+func (a *updateRolesAggregate) validate() error {
+	for _, c := range a.changes {
+		if !validRoles[c.role] {
+			return deny(ErrInvalid, "invalid role")
+		}
+		if !isWriterRole(c.role) && len(c.assigned) > 0 {
+			return deny(ErrInvalid, "user "+c.member.UserID+" has assigned tasks and must stay a contributor or manager")
+		}
+	}
+	return nil
+}
+
+func (a *updateRolesAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for _, c := range a.changes {
+		if err := c.member.setRole(ctx, tx, c.role); err != nil {
+			return nil, err
+		}
+	}
+	return a.project.Memberships(ctx, tx)
+}
+
