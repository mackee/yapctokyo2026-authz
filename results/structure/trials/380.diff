diff --git a/org_test.go b/org_test.go
new file mode 100644
index 0000000..17de2d4
--- /dev/null
+++ b/org_test.go
@@ -0,0 +1,93 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes user with no memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"org admin removes again", "eve", "/orgs/acme/users/ben", 204},
+		{"manager is not org admin", "ann", "/orgs/acme/users/cat", 403},
+		{"contributor is not org admin", "ben", "/orgs/acme/users/cat", 403},
+		{"user of another org", "gus", "/orgs/acme/users/ben", 404},
+		{"org admin of another org", "eve", "/orgs/globex/users/gus", 404},
+		{"target in another org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ben", 404},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown actor", "zed", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d: %s", code, body)
+	}
+
+	// ben is no longer a member of any acme project, so cannot read them.
+	for _, p := range []string{"/projects/web/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, h, "GET", p, "ben", ""); code != 404 {
+			t.Fatalf("ben GET %s: got %d want 404", p, code)
+		}
+	}
+
+	// ben's assignments in those projects are cleared; other assignments stay.
+	assignee := func(path string) string {
+		t.Helper()
+		code, body := do(t, h, "GET", path, "eve", "")
+		if code != 200 {
+			t.Fatalf("eve GET %s: got %d", path, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		return task.Assignee
+	}
+	if got := assignee("/projects/web/tasks/t1"); got != "" {
+		t.Fatalf("t1 assignee: got %q want unassigned", got)
+	}
+	if got := assignee("/projects/legacy/tasks/t5"); got != "" {
+		t.Fatalf("t5 assignee: got %q want unassigned", got)
+	}
+	if got := assignee("/projects/web/tasks/t2"); got != "cat" {
+		t.Fatalf("t2 assignee: got %q want cat", got)
+	}
+
+	// Other organizations are untouched.
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatalf("gus GET gx tasks: got %d want 200", code)
+	}
+}
+
+func TestRemoveOrgUserKeepsOtherMemberships(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ann", "eve", ""); code != 204 {
+		t.Fatalf("remove ann: got %d", code)
+	}
+	// ann held roles in web, ops and legacy; all are gone.
+	for _, p := range []string{"/projects/web/tasks", "/projects/ops/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, h, "GET", p, "ann", ""); code != 404 {
+			t.Fatalf("ann GET %s: got %d want 404", p, code)
+		}
+	}
+	// cat's membership in ops is not affected by removing ann.
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat GET ops tasks: got %d want 200", code)
+	}
+}
