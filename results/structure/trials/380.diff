diff --git a/internal/capability/aggregate.go b/internal/capability/aggregate.go
index 1c6ebfe..50de45d 100644
--- a/internal/capability/aggregate.go
+++ b/internal/capability/aggregate.go
@@ -118,3 +118,41 @@ func loadDeleteTask(x *tx, taskID string) (*deleteTaskAggregate, error) {
 func (a *deleteTaskAggregate) validate() error { return nil }
 
 func (a *deleteTaskAggregate) apply(x *tx) { a.task.Destroy(x) }
+
+// removeOrgUserAggregate removes one user from every project of one
+// organization. It clears the user's assignments in those projects, so that
+// no task is left assigned to a non-member.
+type removeOrgUserAggregate struct {
+	memberships []membershipRecord // the user's memberships in the org's projects
+	assigned    []taskRecord       // tasks in those projects assigned to the user
+}
+
+func loadRemoveOrgUser(x *tx, orgID, userID string) (*removeOrgUserAggregate, error) {
+	u, ok := x.findUser(userID)
+	if !ok || u.Org != orgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	a := &removeOrgUserAggregate{}
+	for _, m := range u.Memberships(x) {
+		p, ok := m.Project(x)
+		if !ok || p.Org != orgID {
+			continue
+		}
+		a.memberships = append(a.memberships, m)
+		a.assigned = append(a.assigned, m.AssignedTasks(x)...)
+	}
+	return a, nil
+}
+
+// validate has nothing to reject: apply clears every assignment the removal
+// would otherwise leave behind, so the model rules still hold afterwards.
+func (a *removeOrgUserAggregate) validate() error { return nil }
+
+func (a *removeOrgUserAggregate) apply(x *tx) {
+	for _, t := range a.assigned {
+		t.Unassign(x)
+	}
+	for _, m := range a.memberships {
+		m.Destroy(x)
+	}
+}
