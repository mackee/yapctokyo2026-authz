+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin, user without projects", "eve", "/orgs/acme/users/hal", 204},
+		{"manager is not admin", "ann", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"other org", "gus", "/orgs/acme/users/ben", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatal(code)
+	}
+	// ben lost access to every project, including the archived one.
+	for _, p := range []string{"/projects/web/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, h, "GET", p, "ben", ""); code != 404 {
+			t.Fatalf("%s: got %d want 404", p, code)
+		}
+	}
+	// his tasks are unassigned (also in the archived project); others untouched.
+	want := map[string]string{"/projects/web/tasks/t1": "", "/projects/legacy/tasks/t5": "", "/projects/web/tasks/t2": "cat"}
+	for path, assignee := range want {
+		code, body := do(t, h, "GET", path, "ann", "")
+		if code != 200 {
+			t.Fatalf("%s: %d", path, code)
+		}
+		var task Task
+		json.Unmarshal([]byte(body), &task)
+		if task.Assignee != assignee {
+			t.Fatalf("%s: assignee %q want %q", path, task.Assignee, assignee)
+		}
+	}
+	// other orgs' memberships are untouched.
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatal(code)
+	}
+}
