+// UserTransferInput is the input of UserTable.Transfer.
+type UserTransferInput struct {
+	ToOrgID string
+}
+
+// Transfer moves the user to another organization. The user leaves the
+// projects of the old organization (their memberships are removed and the
+// tasks assigned to them are unassigned, so the model rules keep holding) and
+// loses org admin, which does not carry over. Only org admins of the user's
+// organization may transfer users.
+func (*UserTable) Transfer(ctx context.Context, db DB, authz UserAuthz, in UserTransferInput) (*User, error) {
+	if err := authz.CanTransfer(); err != nil {
+		return nil, err
+	}
+	if in.ToOrgID == "" {
+		return nil, deny(ErrInvalid, "toOrgId must not be empty")
+	}
+	var u *User
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadTransferUser(ctx, tx, authz.UserID(), in.ToOrgID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		u, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return u, nil
+}
