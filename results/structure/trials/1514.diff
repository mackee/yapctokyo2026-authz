+package model
+
+import "context"
+
+// OrgTable reads organizations. There is no organizations table: an
+// organization exists while some user or project belongs to it.
+type OrgTable struct{}
+
+// NewOrgTable returns the organizations table.
+func NewOrgTable() *OrgTable { return &OrgTable{} }
+
+// Exists reports whether some user or project belongs to the organization.
+func (*OrgTable) Exists(ctx context.Context, db DB, id string) (bool, error) {
+	var ok bool
+	if err := db.QueryRowContext(ctx,
+		`SELECT EXISTS (SELECT 1 FROM users WHERE org_id = ?) OR EXISTS (SELECT 1 FROM projects WHERE org_id = ?)`,
+		id, id).Scan(&ok); err != nil {
+		return false, err
+	}
+	return ok, nil
+}
