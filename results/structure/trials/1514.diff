+// transferUserAggregate moves one user to another organization.
+type transferUserAggregate struct {
+	user        *User
+	toOrg       string
+	memberships []*Membership // the user's projects; all are in the user's organization (model rule)
+	assigned    []*Task       // the tasks assigned to the user, in any project
+}
+
+func loadTransferUser(ctx context.Context, tx DB, userID, toOrg string) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	ok, err := NewOrgTable().Exists(ctx, tx, toOrg)
+	if err != nil {
+		return nil, err
+	}
+	if !ok {
+		return nil, deny(ErrInvalid, "unknown organization")
+	}
+	memberships, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	assigned, err := u.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &transferUserAggregate{user: u, toOrg: toOrg, memberships: memberships, assigned: assigned}, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if a.user.Org == a.toOrg {
+		return deny(ErrInvalid, "user already belongs to that organization")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	// Assignees must be members of the task's project, so the tasks lose their
+	// assignee before the memberships go.
+	for _, t := range a.assigned {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.user.transferTo(ctx, tx, a.toOrg); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
+
