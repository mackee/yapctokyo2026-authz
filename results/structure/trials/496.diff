 func (a *deleteTaskAggregate) apply(ctx context.Context, tx DB) error { return a.task.destroy(ctx, tx) }
+
+// removeUserAggregate removes one user from every project of one organization.
+type removeUserAggregate struct {
+	user        *User
+	memberships []*Membership // the user's memberships in the organization's projects
+}
+
+func loadRemoveUser(ctx context.Context, tx DB, orgID, userID string) (*removeUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != orgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	a := &removeUserAggregate{user: u}
+	for _, m := range ms {
+		p, err := m.Project(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		if p.Org == orgID {
+			a.memberships = append(a.memberships, m)
+		}
+	}
+	return a, nil
+}
+
+func (a *removeUserAggregate) validate() error { return nil }
+
+// apply unassigns the user's tasks in each project and deletes the membership.
+// Archived projects are included: removing a user is not a write to the
+// project's content, and a departing user must lose access everywhere.
+func (a *removeUserAggregate) apply(ctx context.Context, tx DB) error {
+	for _, m := range a.memberships {
+		tasks, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return err
+		}
+		for _, t := range tasks {
+			if err := t.unassign(ctx, tx); err != nil {
+				return err
+			}
+		}
+		if err := m.destroy(ctx, tx); err != nil {
+			return err
+		}
+	}
+	return nil
+}
