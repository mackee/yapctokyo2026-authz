+// RemoveFromOrganization removes the user from every project of the
+// organization: the memberships are deleted and the tasks the user holds in
+// those projects are unassigned. The user row itself stays. Only org admins
+// may do this (else ErrForbidden); a user outside the organization is
+// ErrNotFound. A user who is in no project is a no-op.
+func (*UserTable) RemoveFromOrganization(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanManageMembers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveUser(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
