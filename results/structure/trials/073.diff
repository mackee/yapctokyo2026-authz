+// OrgExists reports whether any user or project belongs to the organization.
+// There is no separate organization table, so an org exists while it has members or projects.
+func (s *Store) OrgExists(orgID string) bool {
+	for _, u := range s.users {
+		if u.OrgID == orgID {
+			return true
+		}
+	}
+	for _, p := range s.projects {
+		if p.OrgID == orgID {
+			return true
+		}
+	}
+	return false
+}
+
+// TransferUser moves a user to another organization. Org admin rights are
+// org-scoped, so they are cleared. Project memberships in projects outside the
+// new organization are dropped; they could never be used again.
+func (s *Store) TransferUser(userID, toOrgID string) {
+	u := s.users[userID]
+	u.OrgID = toOrgID
+	u.OrgAdmin = false
+	for projectID, members := range s.members {
+		if p := s.projects[projectID]; p != nil && p.OrgID != toOrgID {
+			delete(members, userID)
+		}
+	}
+}
+
 func (s *Store) PutTask(t *Task) { s.tasks[t.ID] = t }
 
 func (s *Store) DeleteTask(id string) { delete(s.tasks, id) }
