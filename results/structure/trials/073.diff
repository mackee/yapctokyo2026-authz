+func TestTransfer(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin transfers", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 200},
+		{"manager is not org admin", "ann", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 403},
+		{"contributor is not org admin", "ben", "/orgs/acme/users/cat/transfer", `{"toOrgId":"globex"}`, 403},
+		{"caller in other org", "gus", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 404},
+		{"anonymous", "", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown user", "zed", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown target user", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"same org, not admin", "gus", "/orgs/globex/users/gus/transfer", `{"toOrgId":"acme"}`, 403},
+		{"unknown destination org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"initech"}`, 400},
+		{"missing destination org", "eve", "/orgs/acme/users/ben/transfer", `{}`, 400},
+		{"same org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"acme"}`, 400},
+		{"invalid body", "eve", "/orgs/acme/users/ben/transfer", `not json`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+	var got struct {
+		ID    string `json:"id"`
+		OrgID string `json:"orgId"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.ID != "ben" || got.OrgID != "globex" {
+		t.Fatalf("got %+v", got)
+	}
+}
+
+func TestTransferEffects(t *testing.T) {
+	h := newServer()
+
+	// ben loses access to acme projects he was a member of.
+	if code, _ := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer got %d want 200", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t1", "ben", ""); code != 404 {
+		t.Fatalf("moved user reads old org project: got %d want 404", code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 404 {
+		t.Fatalf("moved user writes old org project: got %d want 404", code)
+	}
+
+	// Org admin rights do not follow the user: eve, moved to globex, can no longer
+	// see acme projects, and the admin flag is cleared.
+	if code, _ := do(t, h, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("self transfer got %d want 200", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "eve", ""); code != 404 {
+		t.Fatalf("transferred admin reads gx: got %d want 404", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "eve", ""); code != 404 {
+		t.Fatalf("transferred admin reads acme project: got %d want 404", code)
+	}
+}
+
+func TestStoreTransferUserMemberships(t *testing.T) {
+	st := newSeededStore()
+	st.TransferUser("ben", "globex")
+
+	u := st.User("ben")
+	if u.OrgID != "globex" || u.OrgAdmin {
+		t.Fatalf("got org %q admin %v", u.OrgID, u.OrgAdmin)
+	}
+	for _, pid := range []string{"web", "legacy"} {
+		if role := st.Role(pid, "ben"); role != "" {
+			t.Fatalf("ben still has role %q in %s", role, pid)
+		}
+	}
+	// Other users' memberships are untouched.
+	if role := st.Role("web", "cat"); role != RoleContributor {
+		t.Fatalf("cat's role in web changed to %q", role)
+	}
+}
+
+func TestStoreOrgExists(t *testing.T) {
+	st := newSeededStore()
+	if !st.OrgExists("acme") || !st.OrgExists("globex") {
+		t.Fatal("seeded orgs should exist")
+	}
+	if st.OrgExists("initech") {
+		t.Fatal("unknown org should not exist")
+	}
+}
