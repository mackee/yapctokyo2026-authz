+func TestTransferRejections(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"anonymous", "", "/orgs/acme/users/ivy/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ivy/transfer", `{"toOrgId":"globex"}`, 401},
+		{"non admin in org", "ann", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 403},
+		{"caller in other org", "gus", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 404},
+		{"caller path org mismatch", "eve", "/orgs/globex/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"missing toOrgId", "eve", "/orgs/acme/users/ivy/transfer", `{}`, 400},
+		{"invalid json", "eve", "/orgs/acme/users/ivy/transfer", `{`, 400},
+		{"same org", "eve", "/orgs/acme/users/ivy/transfer", `{"toOrgId":"acme"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/ivy/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got struct {
+		ID    string `json:"id"`
+		OrgID string `json:"orgId"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.ID != "ivy" || got.OrgID != "globex" {
+		t.Fatalf("got %+v", got)
+	}
+}
+
+// After a transfer the user loses access to the old org's projects, and the
+// org admin rights of the old org do not carry over to the new org.
+func TestTransferAccessFollowsOrg(t *testing.T) {
+	srv := newServer()
+
+	// ivy is a manager in acme's web project before the transfer.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ivy", ""); code != 200 {
+		t.Fatalf("before: ivy list web got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "POST", "/orgs/acme/users/ivy/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer ivy got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ivy", ""); code != 404 {
+		t.Fatalf("after: ivy list web got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "PATCH", "/projects/web/tasks/t1", "ivy", `{"status":"done"}`); code != 404 {
+		t.Fatalf("after: ivy patch web got %d want 404", code)
+	}
+	// Other acme users are unaffected.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ann", ""); code != 200 {
+		t.Fatalf("ann list web got %d want 200", code)
+	}
+
+	// eve is an acme org admin. Moving her clears the admin flag, so she cannot
+	// read globex's project without a membership.
+	if code, _ := do(t, srv, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer eve got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/gx/tasks", "eve", ""); code != 404 {
+		t.Fatalf("after: eve list gx got %d want 404 (org admin must not carry over)", code)
+	}
+}
