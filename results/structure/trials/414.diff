+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager removes contributor", "ann", "/projects/web/members/ben", 204},
+		{"manager removes self", "ivy", "/projects/ops/members/ivy", 204},
+		{"contributor", "ben", "/projects/web/members/cat", 403},
+		{"viewer", "dan", "/projects/web/members/ben", 403},
+		{"org admin without role", "eve", "/projects/web/members/ben", 403},
+		{"non member", "hal", "/projects/web/members/ben", 404},
+		{"other org", "gus", "/projects/web/members/ben", 404},
+		{"anonymous", "", "/projects/web/members/ben", 401},
+		{"unknown user", "zed", "/projects/web/members/ben", 401},
+		{"target not a member", "ann", "/projects/web/members/hal", 404},
+		{"target in another project only", "ivy", "/projects/ops/members/dan", 404},
+		{"archived", "ann", "/projects/legacy/members/ben", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func taskAssignee(t *testing.T, h http.Handler, user, path string) string {
+	t.Helper()
+	code, body := do(t, h, "GET", path, user, "")
+	if code != 200 {
+		t.Fatalf("GET %s: got %d", path, code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	return task.AssigneeID
+}
+
+func TestRemoveMemberUnassignsTasksInProject(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 204 {
+		t.Fatalf("remove: got %d", code)
+	}
+	if got := taskAssignee(t, h, "ann", "/projects/web/tasks/t1"); got != "" {
+		t.Fatalf("t1 (ben's in web) assignee = %q, want unassigned", got)
+	}
+	if got := taskAssignee(t, h, "ann", "/projects/web/tasks/t2"); got != "cat" {
+		t.Fatalf("t2 (cat's) assignee = %q, want cat", got)
+	}
+	if got := taskAssignee(t, h, "ben", "/projects/legacy/tasks/t5"); got != "ben" {
+		t.Fatalf("t5 in legacy assignee = %q, want ben (membership elsewhere is untouched)", got)
+	}
+}
+
+func TestRemoveMemberRevokesAccess(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 204 {
+		t.Fatalf("remove: got %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("removed member reads web: got %d want 404", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/legacy/tasks/t5", "ben", ""); code != 200 {
+		t.Fatalf("ben reads legacy: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 404 {
+		t.Fatalf("second remove: got %d want 404", code)
+	}
+}
+
+func TestRemoveMemberArchivedChangesNothing(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/projects/legacy/members/ben", "ann", ""); code != 409 {
+		t.Fatalf("remove: got %d want 409", code)
+	}
+	if got := taskAssignee(t, h, "ann", "/projects/legacy/tasks/t5"); got != "ben" {
+		t.Fatalf("t5 assignee = %q after rejected remove, want ben", got)
+	}
+	if code, _ := do(t, h, "GET", "/projects/legacy/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben lost read access after rejected remove: got %d", code)
+	}
+}
