@@ -11,6 +11,26 @@ type MembershipTable struct{}
 // NewMembershipTable returns the memberships table.
 func NewMembershipTable() *MembershipTable { return &MembershipTable{} }
 
+// Delete removes the user from the project, and unassigns the user's tasks in
+// the project in the same transaction. A user who is not a member is
+// ErrNotFound; only managers may do this (else ErrForbidden), and not in an
+// archived project (else ErrArchived).
+func (*MembershipTable) Delete(ctx context.Context, db DB, authz ProjectAuthz, userID string) error {
+	if err := authz.CanManageMembers(); err != nil {
+		return err
+	}
+	return db.update(ctx, func(x *Tx) error {
+		agg, err := loadRemoveMember(ctx, x, authz.ProjectID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, x)
+	})
+}
+
 // Find returns the membership of the user in the project, or ErrNoRows.
