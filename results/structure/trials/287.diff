 }
 
+// Manage applies the manager rule: readable, manager only (else 403), not
+// archived (else 409). Org admins get no special rights here: like other writes,
+// they are refused with 403.
+func (s *projectScope) Manage() (ManageProject, error) {
+	err := s.as.a.st.read(func(st *state) error {
+		p, r, err := readable(st, s.as.actor, s.pid)
+		if err != nil {
+			return err
+		}
+		if r != RoleManager {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if p.archived {
+			return deny(ErrArchived, "project is archived")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &manageProject{ps: s}, nil
+}
