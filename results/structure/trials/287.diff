+// MemberView is the public representation of a project member.
+type MemberView struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// ManageProject may change the roles of members of one project (managers only).
+type ManageProject interface {
+	// SetRole changes the role of an existing member. The role must be manager,
+	// contributor or viewer (else 400). A user who is not a member of the project
+	// is 404. Demoting a user who is assigned tasks in the project is 400, because
+	// assignees must remain contributors or managers; nothing changes then.
+	SetRole(userID, role string) (MemberView, error)
+}
+
+type manageProject struct{ ps *projectScope }
+
+func (p *manageProject) SetRole(userID, role string) (MemberView, error) {
+	if role != RoleManager && role != RoleContributor && role != RoleViewer {
+		return MemberView{}, deny(ErrInvalid, "role must be manager, contributor or viewer")
+	}
+	var v MemberView
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		if _, ok := s.members[p.ps.pid][userID]; !ok {
+			return deny(ErrNotFound, "member not found")
+		}
+		s.members[p.ps.pid][userID] = role
+		v = MemberView{UserID: userID, Role: role}
+		return nil
+	})
+	return v, err
+}
+
 type readProject struct{ ps *projectScope }
 
 func (p *readProject) ID() string { return p.ps.pid }
