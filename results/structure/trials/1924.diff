+// moveMemberAggregate moves one member from one project to another, keeping the
+// role. The tasks assigned to the member in the source project are unassigned,
+// since the member is no longer a contributor or manager there.
+type moveMemberAggregate struct {
+	member   *Membership // the member's membership in the source project
+	user     *User
+	dest     *Project
+	existing *Membership // the user's membership in dest, if any
+	tasks    []*Task     // member.AssignedTasks
+}
+
+func loadMoveMember(ctx context.Context, tx DB, fromProjectID, userID, toProjectID string) (*moveMemberAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, fromProjectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveMemberAggregate{member: m}
+	if a.user, err = m.User(ctx, tx); errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "member must be an existing user")
+	} else if err != nil {
+		return nil, err
+	}
+	if a.dest, err = NewProjectTable().Find(ctx, tx, toProjectID); errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if a.existing, err = a.dest.Membership(ctx, tx, userID); errors.Is(err, ErrNoRows) {
+		a.existing = nil
+	} else if err != nil {
+		return nil, err
+	}
+	if a.tasks, err = m.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.user.Org != a.dest.Org {
+		return deny(ErrInvalid, "member must belong to the project's organization")
+	}
+	if a.existing != nil {
+		return deny(ErrInvalid, "user is already a member of the destination project")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.member.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	moved := &Membership{ProjectID: a.dest.ID, UserID: a.member.UserID, Role: a.member.Role}
+	if err := moved.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return moved, nil
+}
