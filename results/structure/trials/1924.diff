+// MembershipTableMoveInput is the input of MembershipTable.Move.
+type MembershipTableMoveInput struct {
+	UserID      string
+	ToProjectID string
+}
+
+// Move removes the user from the project and adds them, with the same role, to
+// the destination project. The actor must be a manager of both projects (the
+// destination must also be readable by the actor, else ErrNotFound), neither
+// may be archived, and the user must not already be in the destination.
+// Tasks assigned to the user in the source project are unassigned. It returns
+// the new membership.
+func (*MembershipTable) Move(ctx context.Context, db DB, authz ProjectAuthz, in MembershipTableMoveInput) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if in.ToProjectID == authz.ProjectID() {
+		return nil, deny(ErrInvalid, "destination must be a different project")
+	}
+	var moved *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveMember(ctx, tx, authz.ProjectID(), in.UserID, in.ToProjectID)
+		if err != nil {
+			return err
+		}
+		destAuthz, err := NewProjectAuthz(ctx, tx, authz.Actor(), in.ToProjectID)
+		if err != nil {
+			return err
+		}
+		if err := destAuthz.CanManageMembers(); err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		moved, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return moved, nil
+}
