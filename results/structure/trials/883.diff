+
+type moveRequest struct {
+	ToProjectID string `json:"toProjectId"`
+}
+
+// moveMember moves a member from the path project to another project, keeping
+// their role. The caller must be a manager of both projects. Tasks the moved
+// user was assigned to in the source project become unassigned.
+func (s *server) moveMember(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	src, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if src == nil || src.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	srcRole, err := findRole(ctx, s.db, src.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if srcRole == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if srcRole != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	var req moveRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || req.ToProjectID == "" {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	dst, err := findProject(ctx, s.db, req.ToProjectID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if dst == nil || dst.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	dstRole, err := findRole(ctx, s.db, dst.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if dstRole == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if dstRole != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if src.ID == dst.ID {
+		writeError(w, 400, "source and destination projects are the same")
+		return
+	}
+	if src.Archived || dst.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	uid := r.PathValue("uid")
+	role, err := findRole(ctx, s.db, src.ID, uid)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if role == "" {
+		writeError(w, 404, "not found")
+		return
+	}
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+	// Insert first: the primary key rejects a user already in the destination.
+	res, err := tx.ExecContext(ctx, `INSERT OR IGNORE INTO memberships (project_id, user_id, role) VALUES (?, ?, ?)`, dst.ID, uid, role)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if n, _ := res.RowsAffected(); n == 0 {
+		writeError(w, 409, "user is already a member of the destination project")
+		return
+	}
+	if _, err := tx.ExecContext(ctx, `DELETE FROM memberships WHERE project_id = ? AND user_id = ?`, src.ID, uid); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if _, err := tx.ExecContext(ctx, `UPDATE tasks SET assignee = '' WHERE project_id = ? AND assignee = ?`, src.ID, uid); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, map[string]string{"userId": uid, "projectId": dst.ID, "role": role})
+}
