+func TestFreeze(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"manager ivy", "ivy", "ops", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResultAndEffect(t *testing.T) {
+	srv := newServer()
+
+	code, body := do(t, srv, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("freeze: got %d body %s", code, body)
+	}
+	var got []memberRole
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []memberRole{
+		{UserID: "ann", Role: "viewer"},
+		{UserID: "ben", Role: "viewer"},
+		{UserID: "cat", Role: "viewer"},
+		{UserID: "dan", Role: "viewer"},
+		{UserID: "ivy", Role: "viewer"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("member %d: got %v want %v", i, got[i], want[i])
+		}
+	}
+
+	// Nobody can change the frozen project's tasks, managers included.
+	writes := []struct {
+		name, user, method, path, body string
+		want                           int
+	}{
+		{"manager update", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"contributor update own", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`, 403},
+		{"contributor create", "ben", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"manager create", "ivy", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"manager delete", "ann", "DELETE", "/projects/web/tasks/t1", "", 403},
+		{"manager refreeze", "ann", "POST", "/projects/web/freeze", "", 403},
+		{"reads still work", "ben", "GET", "/projects/web/tasks/t1", "", 200},
+	}
+	for _, c := range writes {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, srv, c.method, c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+
+	// Other projects are not affected: cat is still a contributor of ops.
+	code, _ = do(t, srv, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`)
+	if code != 200 {
+		t.Fatalf("ops update after web freeze: got %d want 200", code)
+	}
+}
