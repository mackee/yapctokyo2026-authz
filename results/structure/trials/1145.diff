+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin, user with no memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"org admin removes self", "eve", "/orgs/acme/users/eve", 204},
+		{"manager is not an org admin", "ann", "/orgs/acme/users/cat", 403},
+		{"viewer is not an org admin", "dan", "/orgs/acme/users/cat", 403},
+		{"anonymous", "", "/orgs/acme/users/cat", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/cat", 401},
+		{"caller in other org", "gus", "/orgs/acme/users/cat", 404},
+		{"org that is not the caller's", "eve", "/orgs/globex/users/gus", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204: %s", code, body)
+	}
+	// Removing again is harmless.
+	if code, body := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("second remove: got %d want 204: %s", code, body)
+	}
+
+	// ben is no longer a member of any project in acme.
+	for _, path := range []string{"/projects/web/tasks", "/projects/legacy/tasks/t5"} {
+		if code, _ := do(t, srv, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("GET %s as ben: got %d want 404", path, code)
+		}
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 404 {
+		t.Fatalf("POST as ben: got %d want 404", code)
+	}
+
+	// Tasks ben was assigned to are unassigned, and assigning ben again is rejected.
+	for _, path := range []string{"/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		code, body := do(t, srv, "GET", path, "eve", "")
+		if code != 200 {
+			t.Fatalf("GET %s: got %d want 200", path, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.Assignee != "" {
+			t.Fatalf("%s still assigned to %q", task.ID, task.Assignee)
+		}
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "ann", `{"title":"x","assignee":"ben"}`); code != 400 {
+		t.Fatalf("assign removed ben: got %d want 400", code)
+	}
+
+	// Other users are untouched.
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "cat", `{"title":"x"}`); code != 200 {
+		t.Fatalf("cat still a contributor on web: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ann", ""); code != 200 {
+		t.Fatalf("ann still a manager on web: got %d want 200", code)
+	}
+	code, body := do(t, srv, "GET", "/projects/web/tasks/t2", "eve", "")
+	if code != 200 {
+		t.Fatalf("GET t2: got %d want 200", code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.Assignee != "cat" {
+		t.Fatalf("t2 assignee changed to %q", task.Assignee)
+	}
+}
