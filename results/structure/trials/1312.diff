+
+func TestFreeze(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"other manager", "ivy", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+	want := `[{"userId":"ann","role":"viewer"},{"userId":"ben","role":"viewer"},` +
+		`{"userId":"cat","role":"viewer"},{"userId":"dan","role":"viewer"},{"userId":"ivy","role":"viewer"}]`
+	if strings.TrimSpace(body) != want {
+		t.Fatalf("got %s\nwant %s", body, want)
+	}
+}
+
+func TestFreezeBlocksWrites(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d want 200", code)
+	}
+
+	cases := []struct {
+		name, method, user, path, body string
+		want                           int
+	}{
+		{"former manager patch", "PATCH", "ann", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"former contributor own task", "PATCH", "ben", "/projects/web/tasks/t1", `{"status":"done"}`, 403},
+		{"former manager create", "POST", "ivy", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"former manager delete", "DELETE", "ann", "/projects/web/tasks/t3", "", 403},
+		{"freeze again", "POST", "ann", "/projects/web/freeze", "", 403},
+		{"other project still writable", "PATCH", "cat", "/projects/ops/tasks/t4", `{"status":"done"}`, 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, h, c.method, c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+
+	// Reads still work, and the frozen project's tasks are unassigned.
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "dan", "")
+	if code != 200 {
+		t.Fatalf("read: got %d want 200", code)
+	}
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" {
+		t.Fatalf("assignee = %q, want unassigned", task.Assignee)
+	}
+}
