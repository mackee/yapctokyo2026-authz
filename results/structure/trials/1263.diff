+// removeUserAggregate takes one user out of every project of an organization
+// (offboarding). The tasks assigned to the user are unassigned first, so the
+// rule "an assignee is a contributor or manager of the task's project" keeps
+// holding. Archived projects are included.
+type removeUserAggregate struct {
+	user        *User
+	memberships []*Membership
+	assigned    [][]*Task // assigned[i] = memberships[i].AssignedTasks
+}
+
+func loadRemoveUser(ctx context.Context, tx DB, orgID, userID string) (*removeUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != orgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	a := &removeUserAggregate{user: u}
+	if a.memberships, err = u.Memberships(ctx, tx); err != nil {
+		return nil, err
+	}
+	for _, m := range a.memberships {
+		ts, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.assigned = append(a.assigned, ts)
+	}
+	return a, nil
+}
+
+func (a *removeUserAggregate) validate() error { return nil }
+
+func (a *removeUserAggregate) apply(ctx context.Context, tx DB) error {
+	for i, m := range a.memberships {
+		for _, t := range a.assigned[i] {
+			if err := t.unassign(ctx, tx); err != nil {
+				return err
+			}
+		}
+		if err := m.destroy(ctx, tx); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
