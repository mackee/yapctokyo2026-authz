+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes user without projects", "eve", "/orgs/acme/users/hal", 204},
+		{"manager is not admin", "ann", "/orgs/acme/users/ben", 403},
+		{"viewer is not admin", "dan", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"other org", "eve", "/orgs/globex/users/gus", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+	// ben: contributor in web and legacy (archived), assignee of t1 and t5.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatal(code)
+	}
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("got %d want 204", code)
+	}
+	for _, p := range []string{"web", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ben", ""); code != 404 {
+			t.Fatalf("ben still reads %s: %d", p, code)
+		}
+	}
+	// Tasks assigned to ben are unassigned; others are untouched.
+	for tid, want := range map[string]string{"t1": "", "t2": "cat"} {
+		_, body := do(t, h, "GET", "/projects/web/tasks/"+tid, "ann", "")
+		var task Task
+		json.Unmarshal([]byte(body), &task)
+		if task.AssigneeID != want {
+			t.Fatalf("%s assignee %q want %q", tid, task.AssigneeID, want)
+		}
+	}
+	_, body := do(t, h, "GET", "/projects/legacy/tasks/t5", "ann", "")
+	var t5 Task
+	json.Unmarshal([]byte(body), &t5)
+	if t5.AssigneeID != "" {
+		t.Fatalf("t5 still assigned to %q", t5.AssigneeID)
+	}
+	// Other members are unaffected.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat lost access: %d", code)
+	}
+	// Removing again: the user is still in the org, so it is idempotent.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("second removal got %d", code)
+	}
+	// Other orgs are untouched.
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatalf("gus lost access: %d", code)
+	}
+}
