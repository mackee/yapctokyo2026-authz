+// ManageProject may change the membership of one project. Managers only.
+type ManageProject interface {
+	ReadProject
+	// RemoveMember removes userID from the project. In the same commit, the
+	// user's tasks in this project become unassigned, so the assignee invariant
+	// still holds. A user who is not a member of the project is 404.
+	RemoveMember(userID string) error
+}
+
+type manageProject struct{ readProject }
+
+func (p *manageProject) RemoveMember(userID string) error {
+	return p.ps.as.a.st.tx(func(s *state) error {
+		m := s.members[p.ps.pid]
+		if _, ok := m[userID]; !ok {
+			return deny(ErrNotFound, "not found")
+		}
+		delete(m, userID)
+		for id, t := range s.tasks {
+			if t.project == p.ps.pid && t.assignee.user == userID {
+				t.assignee = Assignee{project: p.ps.pid}
+				s.tasks[id] = t
+			}
+		}
+		return nil
+	})
+}
