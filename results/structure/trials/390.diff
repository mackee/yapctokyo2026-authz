diff --git a/internal/capability/aggregate.go b/internal/capability/aggregate.go
index 1c6ebfe..0646f7b 100644
--- a/internal/capability/aggregate.go
+++ b/internal/capability/aggregate.go
@@ -118,3 +118,65 @@ func loadDeleteTask(x *tx, taskID string) (*deleteTaskAggregate, error) {
 func (a *deleteTaskAggregate) validate() error { return nil }
 
 func (a *deleteTaskAggregate) apply(x *tx) { a.task.Destroy(x) }
+
+// transferUserAggregate moves one user from their organization to another.
+// Leaving the organization also leaves its projects: the user's memberships in
+// the source organization's projects are removed, and tasks assigned to them
+// there are unassigned, so that project members stay in the project's org.
+// The user's org admin flag does not follow them to the new organization.
+type transferUserAggregate struct {
+	user        userRecord
+	fromOrg     string
+	toOrg       string
+	toOrgExists bool
+	memberships []membershipRecord // memberships in the source org's projects
+	tasks       []taskRecord       // tasks assigned to the user in the source org's projects
+}
+
+func loadTransferUser(x *tx, fromOrg, userID, toOrg string) (*transferUserAggregate, error) {
+	u, ok := x.findUser(userID)
+	if !ok || u.Org != fromOrg {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	a := &transferUserAggregate{
+		user:        u,
+		fromOrg:     fromOrg,
+		toOrg:       toOrg,
+		toOrgExists: x.findOrg(toOrg),
+	}
+	for _, m := range u.Memberships(x) {
+		if p, ok := m.Project(x); ok && p.Org == fromOrg {
+			a.memberships = append(a.memberships, m)
+		}
+	}
+	for _, t := range u.AssignedTasks(x) {
+		if p, ok := t.Project(x); ok && p.Org == fromOrg {
+			a.tasks = append(a.tasks, t)
+		}
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if a.toOrg == a.fromOrg {
+		return deny(ErrInvalid, "user is already in that organization")
+	}
+	if !a.toOrgExists {
+		return deny(ErrInvalid, "destination organization does not exist")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(x *tx) UserView {
+	for _, m := range a.memberships {
+		m.Destroy(x)
+	}
+	for _, t := range a.tasks {
+		t.Unassign(x)
+	}
+	u := a.user
+	u.Org = a.toOrg
+	u.OrgAdmin = false
+	u.save(x)
+	return UserView{ID: u.ID, OrgID: u.Org}
+}
