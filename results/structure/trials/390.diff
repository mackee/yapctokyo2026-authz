diff --git a/main_transfer_test.go b/main_transfer_test.go
new file mode 100644
index 0000000..5da2abd
--- /dev/null
+++ b/main_transfer_test.go
@@ -0,0 +1,122 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestTransferAccess(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin transfers user without projects", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 200},
+		{"org admin transfers user with projects", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 200},
+		{"org member but not admin", "ann", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 403},
+		{"admin of another org", "gus", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 404},
+		{"unknown org in path", "eve", "/orgs/initech/users/hal/transfer", `{"toOrgId":"globex"}`, 404},
+		{"user of another org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"unknown destination", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"initech"}`, 400},
+		{"same organization", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"acme"}`, 400},
+		{"missing destination", "eve", "/orgs/acme/users/hal/transfer", `{}`, 400},
+		{"malformed body", "eve", "/orgs/acme/users/hal/transfer", `not json`, 400},
+		{"anonymous", "", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown caller", "zed", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/hal/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got struct {
+		ID    string `json:"id"`
+		OrgID string `json:"orgId"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.ID != "hal" || got.OrgID != "globex" {
+		t.Fatalf("got %+v", got)
+	}
+}
+
+func TestTransferMovesUserOutOfOldProjects(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: got %d: %s", code, body)
+	}
+
+	// ben's assignments in acme projects are cleared; other people's are kept.
+	code, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("get t1: %d", code)
+	}
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" {
+		t.Fatalf("t1 still assigned to %q", task.Assignee)
+	}
+	code, body = do(t, srv, "GET", "/projects/web/tasks/t2", "ann", "")
+	json.Unmarshal([]byte(body), &task)
+	if code != 200 || task.Assignee != "cat" {
+		t.Fatalf("t2: got %d assignee %q, want cat", code, task.Assignee)
+	}
+	code, body = do(t, srv, "GET", "/projects/legacy/tasks/t5", "ann", "")
+	json.Unmarshal([]byte(body), &task)
+	if code != 200 || task.Assignee != "" {
+		t.Fatalf("t5: got %d assignee %q, want unassigned", code, task.Assignee)
+	}
+
+	// ben is no longer a member of acme projects.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben lists web: got %d want 404", code)
+	}
+
+	// ben now belongs to globex: acme's admin no longer reaches him (404), and
+	// the globex path resolves him as a non-admin member of the org (403).
+	if code, _ := do(t, srv, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"acme"}`); code != 404 {
+		t.Fatalf("acme admin on ben: got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "POST", "/orgs/globex/users/ben/transfer", "ben", `{"toOrgId":"acme"}`); code != 403 {
+		t.Fatalf("ben on globex: got %d want 403", code)
+	}
+}
+
+func TestTransferClearsOrgAdmin(t *testing.T) {
+	srv := newServer()
+	code, body := do(t, srv, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 || body == "" {
+		t.Fatalf("transfer self: got %d: %s", code, body)
+	}
+	// eve is now a plain member of globex, not its admin.
+	if code, _ := do(t, srv, "POST", "/orgs/globex/users/gus/transfer", "eve", `{"toOrgId":"acme"}`); code != 403 {
+		t.Fatalf("eve as globex non-admin: got %d want 403", code)
+	}
+}
+
+func TestTransferFailureChangesNothing(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"initech"}`); code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben lost access after rejected transfer: %d", code)
+	}
+	code, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if code != 200 || task.Assignee != "ben" {
+		t.Fatalf("t1: got %d assignee %q, want ben", code, task.Assignee)
+	}
+}
