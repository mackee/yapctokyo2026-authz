@@ -108,6 +114,23 @@ func (a *Authorizer) Authenticate(userID string) (ActorScope, error) {
 type ActorScope interface {
 	Actor() Actor
 	Project(projectID string) ProjectScope
+	Org(orgID string) OrgScope
+}
+
+// OrgScope is bound to one actor and one organization ID. It grants nothing by
+// itself; call Admin to acquire the capability.
+type OrgScope interface {
+	ID() string
+	Admin() (AdminOrg, error)
+}
+
+// AdminOrg may move users out of one organization.
+type AdminOrg interface {
+	// TransferUser moves a user of this organization to toOrgID. Memberships in
+	// this organization's projects are removed and the user's assignments there
+	// are cleared. Unknown users are 404; an unknown destination or the same
+	// organization is 400.
+	TransferUser(userID, toOrgID string) (UserView, error)
 }
 
 // ProjectScope is bound to one actor and one project ID. It grants nothing by
@@ -136,6 +159,46 @@ func (s *actorScope) Actor() Actor { return s.actor }
 func (s *actorScope) Project(projectID string) ProjectScope {
 	return &projectScope{as: s, pid: projectID}
 }
+func (s *actorScope) Org(orgID string) OrgScope {
+	return &orgScope{as: s, oid: orgID}
+}
+
+type orgScope struct {
+	as  *actorScope
+	oid string
+}
+
+func (s *orgScope) ID() string { return s.oid }
+
+// Admin applies the admin rule: the organization must be the actor's own (else
+// 404), and the actor must be its org admin (else 403).
+func (s *orgScope) Admin() (AdminOrg, error) {
+	if s.oid != s.as.actor.org {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if !s.as.actor.orgAdmin {
+		return nil, deny(ErrForbidden, "forbidden")
+	}
+	return &adminOrg{os: s}, nil
+}
+
+type adminOrg struct{ os *orgScope }
+
+func (o *adminOrg) TransferUser(userID, toOrgID string) (UserView, error) {
+	var v UserView
+	err := o.os.as.a.db.update(func(x *tx) error {
+		agg, err := loadTransferUser(x, o.os.oid, userID, toOrgID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		v = agg.apply(x)
+		return nil
+	})
+	return v, err
+}
 
