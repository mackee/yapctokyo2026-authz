+func TestMoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager moves", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 200},
+		{"viewer keeps role", "ivy", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 200},
+		{"contributor actor", "ben", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 403},
+		{"not manager of destination", "ann", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin", "eve", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"non member actor", "hal", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"target not a member", "ivy", "/projects/web/members/hal/move", `{"toProjectId":"ops"}`, 404},
+		{"already in destination", "ivy", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 400},
+		{"same project", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"web"}`, 400},
+		{"unknown destination", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"nope"}`, 404},
+		{"unreadable destination", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"legacy"}`, 404},
+		{"other org destination", "ann", "/projects/web/members/ben/move", `{"toProjectId":"gx"}`, 404},
+		{"archived destination", "ann", "/projects/web/members/dan/move", `{"toProjectId":"legacy"}`, 409},
+		{"archived source", "ann", "/projects/legacy/members/ben/move", `{"toProjectId":"web"}`, 409},
+		{"missing destination", "ivy", "/projects/web/members/ben/move", `{}`, 400},
+		{"anonymous", "", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveMemberEffects(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got map[string]string
+	json.Unmarshal([]byte(body), &got)
+	want := map[string]string{"userId": "ben", "projectId": "ops", "role": "contributor"}
+	if len(got) != 3 || got["userId"] != want["userId"] || got["projectId"] != want["projectId"] || got["role"] != want["role"] {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("still a member of web: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+		t.Fatalf("not a member of ops: %d", code)
+	}
+	// ben's task in web is unassigned rather than left with a non-member.
+	_, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" {
+		t.Fatalf("t1 still assigned to %q", task.Assignee)
+	}
+	// Moving again fails: ben is no longer in web.
+	if code, _ := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`); code != 404 {
+		t.Fatalf("second move got %d", code)
+	}
+}
