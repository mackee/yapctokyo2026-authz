+// Manage applies the manager rule: readable, manager (else 403), not archived
+// (else 409).
+func (s *projectScope) Manage() (ManageProject, error) {
+	err := s.as.a.st.read(func(st *state) error {
+		p, r, err := readable(st, s.as.actor, s.pid)
+		if err != nil {
+			return err
+		}
+		if r != RoleManager {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if p.archived {
+			return deny(ErrArchived, "project is archived")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &manageProject{ps: s}, nil
+}
+
+// MemberView is the public representation of a project membership.
+type MemberView struct {
+	UserID    string `json:"userId"`
+	ProjectID string `json:"projectId"`
+	Role      string `json:"role"`
+}
+
+// ManageProject is the manager-only capability for one project's membership.
+type ManageProject interface {
+	// MoveMember removes a member from this project and adds them to another
+	// project with the same role. The actor must also be a manager of the
+	// destination (404 if unreadable, 403 if not manager, 409 if archived).
+	// Tasks the member held in this project become unassigned.
+	MoveMember(userID, toProjectID string) (MemberView, error)
+}
+
+type manageProject struct{ ps *projectScope }
+
+func (p *manageProject) MoveMember(userID, toProjectID string) (MemberView, error) {
+	if toProjectID == "" || toProjectID == p.ps.pid {
+		return MemberView{}, deny(ErrInvalid, "invalid destination project")
+	}
+	var v MemberView
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		role := s.role(p.ps.pid, userID)
+		if role == "" {
+			return deny(ErrNotFound, "not found")
+		}
+		dst, dstRole, err := readable(s, p.ps.as.actor, toProjectID)
+		if err != nil {
+			return err
+		}
+		if dstRole != RoleManager {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if dst.archived {
+			return deny(ErrArchived, "project is archived")
+		}
+		if s.role(toProjectID, userID) != "" {
+			return deny(ErrInvalid, "user is already a member of the destination project")
+		}
+		delete(s.members[p.ps.pid], userID)
+		if s.members[toProjectID] == nil {
+			s.members[toProjectID] = map[string]string{}
+		}
+		s.members[toProjectID][userID] = role
+		for id, t := range s.tasks {
+			if t.project == p.ps.pid && t.assignee.user == userID {
+				t.assignee = Assignee{project: t.project}
+				s.tasks[id] = t
+			}
+		}
+		v = MemberView{UserID: userID, ProjectID: toProjectID, Role: role}
+		return nil
+	})
+	return v, err
+}
