new file mode 100644
index 0000000..fa4fa60
--- /dev/null
+++ b/transfer_test.go
@@ -0,0 +1,128 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"testing"
+)
+
+func TestTransferUser(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin moves member", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 200},
+		{"org admin moves user with assignments", "eve", "/orgs/acme/users/cat/transfer", `{"toOrgId":"globex"}`, 200},
+		{"non admin member", "ann", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 403},
+		{"contributor", "ben", "/orgs/acme/users/cat/transfer", `{"toOrgId":"globex"}`, 403},
+		{"anonymous", "", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 401},
+		{"caller in other org", "gus", "/orgs/acme/users/ben/transfer", `{"toOrgId":"acme"}`, 404},
+		{"org that does not exist", "eve", "/orgs/nowhere/users/ben/transfer", `{"toOrgId":"globex"}`, 404},
+		{"user in other org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"missing toOrgId", "eve", "/orgs/acme/users/ben/transfer", `{}`, 400},
+		{"empty toOrgId", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":""}`, 400},
+		{"bad json", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":`, 400},
+		{"unknown target org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"initech"}`, 400},
+		{"same org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"acme"}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["id"] != "ben" || got["orgId"] != "globex" || len(got) != 2 {
+		t.Fatalf("got body %s", body)
+	}
+}
+
+func TestTransferDropsOldOrgAccess(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: got %d: %s", code, body)
+	}
+
+	// ben is no longer in acme: acme projects are invisible to ben.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != http.StatusNotFound {
+		t.Fatalf("read old project: got %d want 404", code)
+	}
+	// ben's old org is no longer ben's: the org is invisible to ben.
+	if code, _ := do(t, h, "POST", "/orgs/acme/users/cat/transfer", "ben", `{"toOrgId":"globex"}`); code != http.StatusNotFound {
+		t.Fatalf("org of old membership: got %d want 404", code)
+	}
+
+	app := h.(*appHandler)
+	var memberships int
+	if err := app.db.QueryRow(`SELECT COUNT(*) FROM memberships WHERE user_id = 'ben'`).Scan(&memberships); err != nil {
+		t.Fatal(err)
+	}
+	if memberships != 0 {
+		t.Fatalf("ben still has %d memberships", memberships)
+	}
+	// t1 (web, assigned to ben) and t5 (legacy, assigned to ben) are unassigned.
+	var assigned int
+	if err := app.db.QueryRow(`SELECT COUNT(*) FROM tasks WHERE assignee = 'ben'`).Scan(&assigned); err != nil {
+		t.Fatal(err)
+	}
+	if assigned != 0 {
+		t.Fatalf("ben still has %d assigned tasks", assigned)
+	}
+	var assignee string
+	if err := app.db.QueryRow(`SELECT assignee FROM tasks WHERE id = 't1'`).Scan(&assignee); err != nil {
+		t.Fatal(err)
+	}
+	if assignee != "" {
+		t.Fatalf("t1 assignee = %q, want unassigned", assignee)
+	}
+	// Other people's tasks are untouched.
+	if err := app.db.QueryRow(`SELECT assignee FROM tasks WHERE id = 't2'`).Scan(&assignee); err != nil {
+		t.Fatal(err)
+	}
+	if assignee != "cat" {
+		t.Fatalf("t2 assignee = %q, want cat", assignee)
+	}
+}
+
+func TestTransferClearsOrgAdmin(t *testing.T) {
+	h := newServer()
+	app := h.(*appHandler)
+	// Make ann an org admin too, so there is an admin to transfer.
+	if _, err := app.db.Exec(`UPDATE users SET org_admin = 1 WHERE id = 'ann'`); err != nil {
+		t.Fatal(err)
+	}
+	if code, body := do(t, h, "POST", "/orgs/acme/users/ann/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: got %d: %s", code, body)
+	}
+	var admin bool
+	if err := app.db.QueryRow(`SELECT org_admin FROM users WHERE id = 'ann'`).Scan(&admin); err != nil {
+		t.Fatal(err)
+	}
+	if admin {
+		t.Fatal("org admin right carried over to the new organization")
+	}
+}
+
+func TestTransferAdminOfTargetOrgNotNeeded(t *testing.T) {
+	// The caller needs to administer the user's current organization. Being an
+	// admin of the target organization is not required: here eve (acme admin)
+	// moves ivy, who is not an admin anywhere.
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/ivy/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+}
