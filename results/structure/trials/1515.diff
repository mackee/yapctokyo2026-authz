+// transferUserAggregate moves one user to another organization.
+type transferUserAggregate struct {
+	user        *User
+	toOrg       string
+	memberships []*Membership // the user's memberships: all are in the old organization's projects
+	assigned    []*Task       // the tasks assigned to the user: all are in the old organization's projects
+}
+
+func loadTransferUser(ctx context.Context, tx DB, authz OrgAuthz, in UserTableTransferInput) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, in.UserID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != authz.OrgID() {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if in.ToOrgID == u.Org {
+		return nil, deny(ErrInvalid, "user is already in that organization")
+	}
+	ok, err := NewUserTable().OrgExists(ctx, tx, in.ToOrgID)
+	if err != nil {
+		return nil, err
+	}
+	if !ok {
+		return nil, deny(ErrInvalid, "organization must exist")
+	}
+	a := &transferUserAggregate{user: u, toOrg: in.ToOrgID}
+	if a.memberships, err = u.Memberships(ctx, tx); err != nil {
+		return nil, err
+	}
+	if a.assigned, err = u.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	// Project members belong to the project's organization. The user's
+	// memberships and assignments all sit in the old organization, and both are
+	// removed below, so nothing is left in a project of another organization.
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	for _, t := range a.assigned {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	a.user.Org = a.toOrg
+	a.user.OrgAdmin = false
+	if err := a.user.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
+
