+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+type memberOut struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func TestFreezeDemotesEveryoneToViewer(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []memberOut
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []memberOut{
+		{"ann", "viewer"}, {"ben", "viewer"}, {"cat", "viewer"}, {"dan", "viewer"}, {"ivy", "viewer"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("got %v want %v", got, want)
+		}
+	}
+}
+
+func TestFreezeBlocksAllTaskChanges(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatal(code)
+	}
+	for _, user := range []string{"ann", "ben", "cat", "dan", "ivy", "eve"} {
+		if code, _ := do(t, h, "POST", "/projects/web/tasks", user, `{"title":"x"}`); code != 403 {
+			t.Errorf("%s create: got %d want 403", user, code)
+		}
+		if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", user, `{"status":"done"}`); code != 403 {
+			t.Errorf("%s patch: got %d want 403", user, code)
+		}
+		if code, _ := do(t, h, "DELETE", "/projects/web/tasks/t1", user, ""); code != 403 {
+			t.Errorf("%s delete: got %d want 403", user, code)
+		}
+	}
+	// Still readable.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("read after freeze: %d", code)
+	}
+}
+
+func TestFreezeLeavesOtherProjectsAlone(t *testing.T) {
+	h := newServer()
+	do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code, _ := do(t, h, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"doing"}`); code != 200 {
+		t.Fatalf("ops should be unaffected, got %d", code)
+	}
+}
+
+func TestFreezeIsIdempotent(t *testing.T) {
+	h := newServer()
+	do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	// ann is a viewer now, so only the first call can be made by a manager;
+	// the repeat must not be a server error for anyone who may freeze.
+	code, _ := do(t, h, "POST", "/projects/ops/freeze", "ivy", "")
+	if code != 200 {
+		t.Fatal(code)
+	}
+}
+
+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"missing project", "ann", "nope", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			code, _ := do(t, h, "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+			// A rejected freeze must not change anything.
+			if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"doing"}`); code != 200 {
+				t.Fatalf("web should be unfrozen, got %d", code)
+			}
+		})
+	}
+}
