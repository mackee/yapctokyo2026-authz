+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"testing"
+)
+
+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager moves unassigned task", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 200},
+		{"contributor moves own task", "cat", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 200},
+		{"contributor moves others task", "cat", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"viewer in destination", "ann", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"non member of source", "hal", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 404},
+		{"org admin without role", "eve", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 403},
+		{"anonymous", "", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 401},
+		{"unknown task", "ivy", "/projects/web/tasks/t99", `{"toProjectId":"ops"}`, 404},
+		{"task not in path project", "ivy", "/projects/ops/tasks/t1", `{"toProjectId":"web"}`, 404},
+		{"destination missing", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"nope"}`, 404},
+		{"destination in other org", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"gx"}`, 404},
+		{"destination archived", "ann", "/projects/web/tasks/t3", `{"toProjectId":"legacy"}`, 409},
+		{"source archived", "ann", "/projects/legacy/tasks/t5", `{"toProjectId":"ops"}`, 409},
+		{"assignee not in destination", "ivy", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 409},
+		{"same project", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"web"}`, 400},
+		{"missing toProjectId", "ivy", "/projects/web/tasks/t3", `{}`, 400},
+		{"empty toProjectId", "ivy", "/projects/web/tasks/t3", `{"toProjectId":""}`, 400},
+		{"invalid body", "ivy", "/projects/web/tasks/t3", `nope`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsTaskFieldsAndChangesProject(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/tasks/t2/move", "cat", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d want 200: %s", code, body)
+	}
+	var moved Task
+	if err := json.Unmarshal([]byte(body), &moved); err != nil {
+		t.Fatalf("move response is not a task: %v: %s", err, body)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", Assignee: "cat"}
+	if moved != want {
+		t.Fatalf("moved task = %+v, want %+v", moved, want)
+	}
+
+	code, body = do(t, h, "GET", "/projects/ops/tasks/t2", "ivy", "")
+	if code != 200 {
+		t.Fatalf("get from destination: got %d want 200: %s", code, body)
+	}
+	var got Task
+	json.Unmarshal([]byte(body), &got)
+	if got != want {
+		t.Fatalf("stored task = %+v, want %+v", got, want)
+	}
+
+	code, _ = do(t, h, "GET", "/projects/web/tasks/t2", "ivy", "")
+	if code != http.StatusNotFound {
+		t.Fatalf("get from source after move: got %d want 404", code)
+	}
+}
