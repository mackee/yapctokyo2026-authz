diff --git a/members.go b/members.go
new file mode 100644
index 0000000..faa1941
--- /dev/null
+++ b/members.go
@@ -0,0 +1,149 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+)
+
+type member struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+type setRolesRequest struct {
+	Roles map[string]string `json:"roles"`
+}
+
+// setMemberRoles changes several members' roles in one all-or-nothing request.
+// Only managers of the project may do this. Every named user must already be a
+// member, every role must be valid, and the project must keep at least one
+// manager; otherwise nothing is changed and 400 is returned.
+func (s *server) setMemberRoles(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role, err := findRole(ctx, s.db, project.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "only managers may change member roles")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req setRolesRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || len(req.Roles) == 0 {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	for _, newRole := range req.Roles {
+		if newRole != RoleManager && newRole != RoleContributor && newRole != RoleViewer {
+			writeError(w, 400, "invalid role")
+			return
+		}
+	}
+
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+
+	current := map[string]string{}
+	rows, err := tx.QueryContext(ctx, `SELECT user_id, role FROM memberships WHERE project_id = ?`, project.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	for rows.Next() {
+		var uid, r string
+		if err := rows.Scan(&uid, &r); err != nil {
+			rows.Close()
+			writeError(w, 500, "internal error")
+			return
+		}
+		current[uid] = r
+	}
+	rows.Close()
+	if err := rows.Err(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+
+	for uid, newRole := range req.Roles {
+		if _, ok := current[uid]; !ok {
+			writeError(w, 400, "not a member of the project: "+uid)
+			return
+		}
+		current[uid] = newRole
+	}
+	managers := 0
+	for _, r := range current {
+		if r == RoleManager {
+			managers++
+		}
+	}
+	if managers == 0 {
+		writeError(w, 400, "project must keep at least one manager")
+		return
+	}
+
+	for uid, newRole := range req.Roles {
+		if _, err := tx.ExecContext(ctx, `UPDATE memberships SET role = ? WHERE project_id = ? AND user_id = ?`,
+			newRole, project.ID, uid); err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+	}
+
+	out := []member{}
+	rows, err = tx.QueryContext(ctx, `SELECT user_id, role FROM memberships WHERE project_id = ? ORDER BY user_id`, project.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	for rows.Next() {
+		var m member
+		if err := rows.Scan(&m.UserID, &m.Role); err != nil {
+			rows.Close()
+			writeError(w, 500, "internal error")
+			return
+		}
+		out = append(out, m)
+	}
+	rows.Close()
+	if err := rows.Err(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, out)
+}
diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..d79bb0d
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,101 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"testing"
+)
+
+func memberRoles(t *testing.T, h http.Handler, pid string) map[string]string {
+	t.Helper()
+	code, body := do(t, h, "PUT", "/projects/"+pid+"/members", "ann", `{"roles":{"ann":"manager"}}`)
+	if code != 200 {
+		t.Fatalf("list got %d %s", code, body)
+	}
+	var ms []member
+	if err := json.Unmarshal([]byte(body), &ms); err != nil {
+		t.Fatal(err)
+	}
+	out := map[string]string{}
+	for _, m := range ms {
+		out[m.UserID] = m.Role
+	}
+	return out
+}
+
+func TestSetMemberRoles(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d %s", code, body)
+	}
+	var ms []member
+	if err := json.Unmarshal([]byte(body), &ms); err != nil {
+		t.Fatal(err)
+	}
+	got := map[string]string{}
+	for _, m := range ms {
+		got[m.UserID] = m.Role
+	}
+	want := map[string]string{"ann": "manager", "ben": "viewer", "cat": "contributor", "dan": "contributor", "ivy": "manager"}
+	if len(got) != len(want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	for k, v := range want {
+		if got[k] != v {
+			t.Fatalf("got %v want %v", got, want)
+		}
+	}
+}
+
+func TestSetMemberRolesAtomic(t *testing.T) {
+	bad := []string{
+		// non-member
+		`{"roles":{"ben":"viewer","zed":"viewer"}}`,
+		// invalid role
+		`{"roles":{"ben":"viewer","dan":"admin"}}`,
+		// org user, not a member
+		`{"roles":{"hal":"viewer","ben":"viewer"}}`,
+		// no manager left
+		`{"roles":{"ann":"viewer","ivy":"contributor"}}`,
+		`{"roles":{}}`,
+		`not json`,
+	}
+	for _, b := range bad {
+		h := newServer()
+		code, _ := do(t, h, "PUT", "/projects/web/members", "ann", b)
+		if code != 400 {
+			t.Fatalf("%s: got %d want 400", b, code)
+		}
+		got := memberRoles(t, h, "web")
+		if got["ben"] != "contributor" || got["dan"] != "viewer" || got["ann"] != "manager" || got["ivy"] != "manager" {
+			t.Fatalf("%s: state changed: %v", b, got)
+		}
+	}
+}
+
+func TestSetMemberRolesAccess(t *testing.T) {
+	body := `{"roles":{"ben":"viewer"}}`
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"anonymous", "", "/projects/web/members", 401},
+		{"contributor", "ben", "/projects/web/members", 403},
+		{"viewer", "dan", "/projects/web/members", 403},
+		{"org admin", "eve", "/projects/web/members", 403},
+		{"non member", "hal", "/projects/web/members", 404},
+		{"other org", "gus", "/projects/web/members", 404},
+		{"missing project", "ann", "/projects/nope/members", 404},
+		{"archived", "ann", "/projects/legacy/members", 409},
+		{"manager", "ann", "/projects/web/members", 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
