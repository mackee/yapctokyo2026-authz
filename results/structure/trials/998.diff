+type membersRequest struct {
+	Roles map[string]string `json:"roles"`
+}
+
+type memberView struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// updateMemberRoles changes several members' roles at once. It is all-or-nothing:
+// if any change is refused, nothing is written. On success it returns the
+// project's member list after the change.
+func (s *server) updateMemberRoles(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role, err := findRole(ctx, s.db, project.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "only managers may change member roles")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req membersRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || len(req.Roles) == 0 {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	// Sorted so that the reported error is deterministic.
+	ids := make([]string, 0, len(req.Roles))
+	for id := range req.Roles {
+		ids = append(ids, id)
+	}
+	sort.Strings(ids)
+
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+	for _, id := range ids {
+		newRole := req.Roles[id]
+		if newRole != RoleManager && newRole != RoleContributor && newRole != RoleViewer {
+			writeError(w, 400, "invalid role for "+id)
+			return
+		}
+		current, err := findRole(ctx, tx, project.ID, id)
+		if err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+		if current == "" {
+			writeError(w, 400, id+" is not a member of the project")
+			return
+		}
+		if _, err := tx.ExecContext(ctx, `UPDATE memberships SET role = ? WHERE project_id = ? AND user_id = ?`,
+			newRole, project.ID, id); err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+
+	rows, err := s.db.QueryContext(ctx, `SELECT user_id, role FROM memberships WHERE project_id = ? ORDER BY user_id`, project.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer rows.Close()
+	members := []memberView{}
+	for rows.Next() {
+		var m memberView
+		if err := rows.Scan(&m.UserID, &m.Role); err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+		members = append(members, m)
+	}
+	if err := rows.Err(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, members)
+}
