+// transferUserAggregate moves one user to another organization. To keep the
+// model rules, the user leaves every project of the old organization: their
+// memberships are removed and the tasks assigned to them are unassigned.
+type transferUserAggregate struct {
+	user        *User
+	fromOrg     string
+	toOrg       string
+	toOrgExists bool
+	memberships []*Membership
+	assigned    []*Task
+}
+
+func loadTransferUser(ctx context.Context, tx DB, fromOrg string, in UserTableTransferInput) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, in.UserID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &transferUserAggregate{user: u, fromOrg: fromOrg, toOrg: in.ToOrg}
+	if u.Org != fromOrg {
+		return a, nil // validate reports not found
+	}
+	if a.toOrgExists, err = NewUserTable().OrgExists(ctx, tx, in.ToOrg); err != nil {
+		return nil, err
+	}
+	if a.memberships, err = u.Memberships(ctx, tx); err != nil {
+		return nil, err
+	}
+	if a.assigned, err = u.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if a.user.Org != a.fromOrg {
+		return deny(ErrNotFound, "not found")
+	}
+	if a.toOrg == a.fromOrg {
+		return deny(ErrInvalid, "user already belongs to the organization")
+	}
+	if !a.toOrgExists {
+		return deny(ErrInvalid, "destination organization does not exist")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	for _, t := range a.assigned {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.user.moveTo(ctx, tx, a.toOrg); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
