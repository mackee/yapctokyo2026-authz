+func TestTransfer(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 200},
+		{"anonymous", "", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 401},
+		{"not admin", "ann", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 403},
+		{"other org admin", "gus", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 404},
+		{"user in other org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"unknown target org", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"nowhere"}`, 400},
+		{"same org", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"acme"}`, 400},
+		{"missing body field", "eve", "/orgs/acme/users/hal/transfer", `{}`, 400},
+		{"bad json", "eve", "/orgs/acme/users/hal/transfer", `{`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+
+	t.Run("response", func(t *testing.T) {
+		code, body := do(t, newServer(), "POST", "/orgs/acme/users/hal/transfer", "eve", `{"toOrgId":"globex"}`)
+		var got map[string]string
+		if err := json.Unmarshal([]byte(body), &got); err != nil || code != 200 {
+			t.Fatalf("code %d body %q err %v", code, body, err)
+		}
+		if got["id"] != "hal" || got["orgId"] != "globex" || len(got) != 2 {
+			t.Fatalf("unexpected body %v", got)
+		}
+	})
+
+	t.Run("leaves old org projects", func(t *testing.T) {
+		h := newServer()
+		if code, _ := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+			t.Fatalf("transfer got %d", code)
+		}
+		// ben now belongs to globex: no access to his old acme projects.
+		if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+			t.Fatalf("old project got %d want 404", code)
+		}
+		// His tasks were unassigned, and he can no longer be assigned.
+		_, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil || task.AssigneeID != "" {
+			t.Fatalf("t1 body %q err %v", body, err)
+		}
+		if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ann", `{"assignee":"ben"}`); code != 400 {
+			t.Fatalf("assign transferred user got %d want 400", code)
+		}
+		// He is no longer in acme, so acme's admin cannot transfer him again.
+		if code, _ := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 404 {
+			t.Fatalf("second transfer got %d want 404", code)
+		}
+	})
+
+	t.Run("org admin rights are not carried over", func(t *testing.T) {
+		h := newServer()
+		if code, _ := do(t, h, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+			t.Fatalf("self transfer got %d", code)
+		}
+		if code, _ := do(t, h, "GET", "/projects/gx/tasks", "eve", ""); code != 404 {
+			t.Fatalf("former admin reads globex project: got %d want 404", code)
+		}
+	})
+}
