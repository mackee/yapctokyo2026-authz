+type manageProject struct{ readProject }
+
+func (p *manageProject) MoveMember(userID string, to ProjectScope) (MemberView, error) {
+	dest, ok := to.(*projectScope)
+	if !ok || dest.as != p.ps.as {
+		return MemberView{}, deny(ErrInvalid, "destination must be a project of the same actor")
+	}
+	if _, err := dest.Manage(); err != nil {
+		return MemberView{}, err
+	}
+	var v MemberView
+	err := p.ps.as.a.db.update(func(x *tx) error {
+		agg, err := loadMoveMember(x, p.ps.pid, dest.pid, userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		v = agg.save(x)
+		return nil
+	})
+	return v, err
+}
