@@ -108,3 +108,61 @@ func loadDeleteTask(x *tx, taskID string) (*deleteTaskAggregate, error) {
 func (a *deleteTaskAggregate) validate() error { return nil }
 
 func (a *deleteTaskAggregate) save(x *tx) { a.task.destroy(x) }
+
+// moveMemberAggregate moves one member from one project to another, keeping
+// the role. The member's assignments in the source project are cleared,
+// because an assignee must belong to the task's project.
+type moveMemberAggregate struct {
+	user     userRecord
+	dest     projectRecord
+	from     membershipRecord
+	to       membershipRecord
+	unassign []taskRecord
+}
+
+func loadMoveMember(x *tx, fromPID, toPID, userID string) (*moveMemberAggregate, error) {
+	if fromPID == toPID {
+		return nil, deny(ErrInvalid, "member must move to a different project")
+	}
+	from, ok := x.findMembership(fromPID, userID)
+	if !ok {
+		return nil, deny(ErrNotFound, "member not found")
+	}
+	dest, ok := x.findProject(toPID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if _, ok := x.findMembership(toPID, userID); ok {
+		return nil, deny(ErrConflict, "member is already in the destination project")
+	}
+	user, _ := x.findUser(userID)
+	a := &moveMemberAggregate{
+		user: user,
+		dest: dest,
+		from: from,
+		to:   membershipRecord{ProjectID: toPID, UserID: userID, Role: from.Role},
+	}
+	for _, t := range x.tasksIn(fromPID) {
+		if t.AssigneeID == userID {
+			t.AssigneeID = ""
+			a.unassign = append(a.unassign, t)
+		}
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.user.Org != a.dest.Org {
+		return deny(ErrInvalid, "member must belong to the project's organization")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) save(x *tx) MemberView {
+	a.from.destroy(x)
+	a.to.save(x)
+	for _, t := range a.unassign {
+		t.save(x)
+	}
+	return MemberView{UserID: a.to.UserID, ProjectID: a.to.ProjectID, Role: a.to.Role}
+}
