+func TestMoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager of both", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 200},
+		{"contributor in source", "ben", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer in destination", "ann", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"non member actor", "hal", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"destination in other org", "ann", "/projects/web/members/ben/move", `{"toProjectId":"gx"}`, 404},
+		{"destination missing", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"nope"}`, 404},
+		{"user not in source", "ivy", "/projects/web/members/hal/move", `{"toProjectId":"ops"}`, 404},
+		{"already in destination", "ivy", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 409},
+		{"source archived", "ann", "/projects/legacy/members/ben/move", `{"toProjectId":"web"}`, 409},
+		{"destination archived", "ann", "/projects/web/members/cat/move", `{"toProjectId":"legacy"}`, 409},
+		{"same project", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"web"}`, 400},
+		{"missing destination", "ivy", "/projects/web/members/ben/move", `{}`, 400},
+		{"malformed body", "ivy", "/projects/web/members/ben/move", `not json`, 400},
+		{"anonymous", "", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveMemberEffects(t *testing.T) {
+	srv := newServer()
+	code, body := do(t, srv, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d %s", code, body)
+	}
+	var got capability.MemberView
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := capability.MemberView{UserID: "ben", ProjectID: "ops", Role: "contributor"}
+	if got != want {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+
+	// Left the source project.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben still reads web: %d", code)
+	}
+	// Joined the destination with the same role: a contributor may create a task for self there.
+	if code, _ := do(t, srv, "POST", "/projects/ops/tasks", "ben", `{"title":"x","assignee":"ben"}`); code != 201 {
+		t.Fatalf("ben cannot write ops: %d", code)
+	}
+	// Assignments in the source project are cleared; other projects are untouched.
+	if code, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ann", ""); code != 200 || !strings.Contains(body, `"assignee":""`) {
+		t.Fatalf("t1 not unassigned: %d %s", code, body)
+	}
+	if code, body := do(t, srv, "GET", "/projects/legacy/tasks/t5", "ann", ""); code != 200 || !strings.Contains(body, `"assignee":"ben"`) {
+		t.Fatalf("t5 changed: %d %s", code, body)
+	}
+}
