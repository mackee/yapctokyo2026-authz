+// RemoveFromOrgProjects removes the user from every project of the
+// organization, all or nothing. The user's assigned tasks in those projects are
+// unassigned. Removing a user who is in no project succeeds without change.
+// Only org admins of the organization may do this (else ErrForbidden); the user
+// must belong to the organization (else ErrNotFound).
+func (*UserTable) RemoveFromOrgProjects(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanRemoveUser(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveOrgUser(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
