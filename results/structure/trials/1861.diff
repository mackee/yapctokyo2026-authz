+
+// removeMember takes a user out of a project. Only managers may do it. The
+// user's tasks in the project become unassigned, because an assignee must be a
+// contributor or manager of the task's project.
+func (s *server) removeMember(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role, err := findRole(ctx, s.db, project.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	targetID := r.PathValue("uid")
+	targetRole, err := findRole(ctx, s.db, project.ID, targetID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if targetRole == "" {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+	if _, err := tx.ExecContext(ctx, `DELETE FROM memberships WHERE project_id = ? AND user_id = ?`, project.ID, targetID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if _, err := tx.ExecContext(ctx, `UPDATE tasks SET assignee = '' WHERE project_id = ? AND assignee = ?`, project.ID, targetID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	w.WriteHeader(204)
+}
diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..dc21caa
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,128 @@
+package main
+
+import (
+	"net/http"
+	"testing"
+)
+
+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager removes contributor", "ann", "/projects/web/members/ben", 204},
+		{"manager removes viewer", "ann", "/projects/web/members/dan", 204},
+		{"manager removes manager", "ann", "/projects/web/members/ivy", 204},
+		{"manager removes self", "ann", "/projects/web/members/ann", 204},
+		{"contributor", "ben", "/projects/web/members/cat", 403},
+		{"viewer", "dan", "/projects/web/members/ben", 403},
+		{"org admin", "eve", "/projects/web/members/ben", 403},
+		{"non member caller", "hal", "/projects/web/members/ben", 404},
+		{"other org caller", "gus", "/projects/web/members/ben", 404},
+		{"anonymous", "", "/projects/web/members/ben", 401},
+		{"unknown caller", "zed", "/projects/web/members/ben", 401},
+		{"target not a member", "ann", "/projects/web/members/hal", 404},
+		{"target unknown user", "ann", "/projects/web/members/zed", 404},
+		{"target member of other project only", "ann", "/projects/web/members/gus", 404},
+		{"missing project", "ann", "/projects/nope/members/ben", 404},
+		{"archived", "ann", "/projects/legacy/members/ben", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func roleOf(t *testing.T, h http.Handler, project, user string) string {
+	t.Helper()
+	var role string
+	err := h.(*appHandler).db.QueryRow(`SELECT COALESCE((SELECT role FROM memberships WHERE project_id = ? AND user_id = ?), '')`, project, user).Scan(&role)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return role
+}
+
+func TestRemoveMemberTakesEffect(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 204 {
+		t.Fatalf("got %d want 204", code)
+	}
+	if r := roleOf(t, h, "web", "ben"); r != "" {
+		t.Fatalf("ben still has role %q in web", r)
+	}
+	// Other memberships are untouched.
+	if r := roleOf(t, h, "web", "cat"); r != RoleContributor {
+		t.Fatalf("cat's role in web changed to %q", r)
+	}
+	if r := roleOf(t, h, "legacy", "ben"); r != RoleContributor {
+		t.Fatalf("ben's role in legacy changed to %q", r)
+	}
+	// The removed user lost access to the project.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("removed member can still read project: %d", code)
+	}
+	// Removing again: no longer a member.
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 404 {
+		t.Fatalf("second removal got %d want 404", code)
+	}
+}
+
+// A removed member must not stay assignee of tasks in the project (model rules
+// are checked by do() after the request); the tasks become unassigned.
+func TestRemoveMemberUnassignsTasks(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 204 {
+		t.Fatalf("got %d want 204", code)
+	}
+	var assignee string
+	if err := h.(*appHandler).db.QueryRow(`SELECT assignee FROM tasks WHERE id = 't1'`).Scan(&assignee); err != nil {
+		t.Fatal(err)
+	}
+	if assignee != "" {
+		t.Fatalf("t1 still assigned to %q", assignee)
+	}
+	// Tasks assigned to others, and tasks of other projects, are untouched.
+	if err := h.(*appHandler).db.QueryRow(`SELECT assignee FROM tasks WHERE id = 't2'`).Scan(&assignee); err != nil {
+		t.Fatal(err)
+	}
+	if assignee != "cat" {
+		t.Fatalf("t2 assignee changed to %q", assignee)
+	}
+	if err := h.(*appHandler).db.QueryRow(`SELECT assignee FROM tasks WHERE id = 't5'`).Scan(&assignee); err != nil {
+		t.Fatal(err)
+	}
+	if assignee != "ben" {
+		t.Fatalf("t5 (legacy) assignee changed to %q", assignee)
+	}
+}
+
+// Removing a user from one project keeps their tasks in other projects.
+func TestRemoveMemberKeepsOtherProjectAssignments(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/cat", "ann", ""); code != 204 {
+		t.Fatalf("got %d want 204", code)
+	}
+	var assignee string
+	if err := h.(*appHandler).db.QueryRow(`SELECT assignee FROM tasks WHERE id = 't4'`).Scan(&assignee); err != nil {
+		t.Fatal(err)
+	}
+	if assignee != "cat" {
+		t.Fatalf("t4 (ops) assignee changed to %q", assignee)
+	}
+}
+
+// A failed removal changes nothing.
+func TestRemoveMemberDeniedChangesNothing(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "cat", ""); code != 403 {
+		t.Fatalf("got %d want 403", code)
+	}
+	if r := roleOf(t, h, "web", "ben"); r != RoleContributor {
+		t.Fatalf("ben's role changed to %q", r)
+	}
+}
