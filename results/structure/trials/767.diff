+// CanMove returns nil if the actor may move the task into the destination
+// project: contributor or manager in both projects (else ErrForbidden), and
+// either manager in both or the task is assigned to the actor (else
+// ErrForbidden); neither project is archived (else ErrArchived).
+func (a TaskAuthz) CanMove(dest ProjectAuthz) error {
+	if !a.CanRead() || !isWriterRole(a.project.role) || !dest.CanRead() || !isWriterRole(dest.role) {
+		return deny(ErrForbidden, "forbidden")
+	}
+	bothManager := a.project.role == RoleManager && dest.role == RoleManager
+	if !bothManager && !a.isAssignee {
+		return deny(ErrForbidden, "only managers of both projects may move tasks assigned to others")
+	}
+	if a.project.archived || dest.archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	return nil
+}
