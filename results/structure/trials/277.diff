+// ---- membership capability -----------------------------------------------------
+
+// MemberView is the public representation of a project membership.
+type MemberView struct {
+	UserID    string `json:"userId"`
+	ProjectID string `json:"projectId"`
+	Role      string `json:"role"`
+}
+
+// ManageProject is the manager-only capability for one project's membership.
+// It requires the manager role and a non-archived project.
+type ManageProject interface {
+	ID() string
+	// MoveMember removes userID from this project and adds them, with the same
+	// role, to dest's project. dest must be a ManageProject of the same actor, so
+	// the caller must be a manager of both projects. Tasks in this project that
+	// were assigned to the user become unassigned. Errors: unknown member 404,
+	// same project or already a member of dest 400.
+	MoveMember(userID string, dest ManageProject) (MemberView, error)
+}
+
+type manageProject struct{ ps *projectScope }
+
+func (p *manageProject) ID() string { return p.ps.pid }
+
+// Manage applies the manager rule: readable, manager (else 403), not archived
+// (else 409).
+func (s *projectScope) Manage() (ManageProject, error) {
+	err := s.as.a.st.read(func(st *state) error {
+		p, r, err := readable(st, s.as.actor, s.pid)
+		if err != nil {
+			return err
+		}
+		if r != RoleManager {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if p.archived {
+			return deny(ErrArchived, "project is archived")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &manageProject{ps: s}, nil
+}
+
+func (p *manageProject) MoveMember(userID string, dest ManageProject) (MemberView, error) {
+	d, ok := dest.(*manageProject)
+	if !ok || d.ps.as != p.ps.as {
+		return MemberView{}, deny(ErrInvalid, "invalid destination")
+	}
+	src, dst := p.ps.pid, d.ps.pid
+	if src == dst {
+		return MemberView{}, deny(ErrInvalid, "destination must be a different project")
+	}
+	var v MemberView
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		role := s.role(src, userID)
+		if role == "" {
+			return deny(ErrNotFound, "not found")
+		}
+		if s.role(dst, userID) != "" {
+			return deny(ErrInvalid, "user is already a member of the destination project")
+		}
+		delete(s.members[src], userID)
+		if s.members[dst] == nil {
+			s.members[dst] = map[string]string{}
+		}
+		s.members[dst][userID] = role
+		for id, t := range s.tasks {
+			if t.project == src && t.assignee.user == userID {
+				t.assignee = Assignee{project: src}
+				s.tasks[id] = t
+			}
+		}
+		v = MemberView{UserID: userID, ProjectID: dst, Role: role}
+		return nil
+	})
+	return v, err
+}
