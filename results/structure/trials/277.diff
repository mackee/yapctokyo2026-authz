+type moveRequest struct {
+	ToProjectID string `json:"toProjectId"`
+}
+
+func moveMember(ctx tanukirpc.Context[*projectRegistry], _ struct{}) (*capability.MemberView, error) {
+	scope := ctx.Registry().scope
+	src, err := scope.Manage()
+	if err != nil {
+		return nil, err
+	}
+	var req moveRequest
+	if err := decodeBody(ctx.Request(), &req); err != nil || req.ToProjectID == "" {
+		return nil, errInvalidBody
+	}
+	// The caller must also manage the destination project.
+	dst, err := scope.Actor().Project(req.ToProjectID).Manage()
+	if err != nil {
+		return nil, err
+	}
+	v, err := src.MoveMember(chi.URLParam(ctx.Request(), "uid"), dst)
+	if err != nil {
+		return nil, err
+	}
+	return &v, nil
+}
