+func TestUpdateMemberRoles(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager batch", "ann", "web", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"ben":"viewer"}}`, 403},
+		{"org admin without role", "eve", "web", `{"roles":{"ben":"viewer"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"ben":"viewer"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"ben":"viewer"}}`, 404},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"invalid role", "ann", "web", `{"roles":{"ben":"owner"}}`, 400},
+		{"target not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"bad json", "ann", "web", `{"roles":`, 400},
+		{"anonymous", "", "web", `{"roles":{"ben":"viewer"}}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRolesResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []memberRole
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []memberRole{
+		{"ann", "manager"},
+		{"ben", "viewer"},
+		{"cat", "contributor"},
+		{"dan", "contributor"},
+		{"ivy", "manager"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("row %d: got %v want %v", i, got[i], want[i])
+		}
+	}
+}
+
+func TestUpdateMemberRolesTakesEffect(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer"}}`); code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	// ben is now a viewer, so may no longer edit his own task.
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 403 {
+		t.Fatalf("demoted ben: got %d want 403", code)
+	}
+}
+
+func TestUpdateMemberRolesIsAtomic(t *testing.T) {
+	h := newServer()
+	// ben's change is valid, hal is not a member, so nothing may change.
+	code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","hal":"viewer"}}`)
+	if code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	// ben must still be a contributor, so he can still update his own task.
+	if code, body := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+}
