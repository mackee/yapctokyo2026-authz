+// updateMemberRoleAggregate changes the role of one project member.
+type updateMemberRoleAggregate struct {
+	member   *Membership
+	role     string
+	assigned []*Task // the member's tasks in the project; loaded when the new role is viewer
+}
+
+func loadUpdateMemberRole(ctx context.Context, tx DB, projectID, userID, role string) (*updateMemberRoleAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &updateMemberRoleAggregate{member: m, role: role}
+	if role == RoleViewer {
+		if a.assigned, err = m.AssignedTasks(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	return a, nil
+}
+
+func (a *updateMemberRoleAggregate) validate() error {
+	if a.role == RoleViewer && len(a.assigned) > 0 {
+		return deny(ErrInvalid, "assignee must be a contributor or manager of the project: unassign the member's tasks first")
+	}
+	return nil
+}
+
+func (a *updateMemberRoleAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.member.changeRole(ctx, tx, a.role); err != nil {
+		return nil, err
+	}
+	return a.member, nil
+}
