+// updateMembershipAggregate changes the role of one member of one project.
+type updateMembershipAggregate struct {
+	membership *Membership
+	role       string
+}
+
+func loadUpdateMembership(ctx context.Context, x *Tx, projectID, userID, role string) (*updateMembershipAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, x, projectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	return &updateMembershipAggregate{membership: m, role: role}, nil
+}
+
+func (a *updateMembershipAggregate) validate() error { return nil }
+
+func (a *updateMembershipAggregate) apply(ctx context.Context, x *Tx) (*Membership, error) {
+	if err := a.membership.changeRole(ctx, x, a.role); err != nil {
+		return nil, err
+	}
+	return a.membership, nil
+}
