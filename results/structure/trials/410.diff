+// memberUpdateRequest is the body of PUT /projects/{pid}/members/{uid}. The
+// role is checked here, so a bad role is a 400 before any access decision.
+type memberUpdateRequest struct {
+	Role string `json:"role" validate:"required,oneof=manager contributor viewer"`
+}
+
+// memberResponse is the JSON shape of a project member.
+type memberResponse struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func updateMember(ctx tanukirpc.Context[*projectRegistry], req memberUpdateRequest) (*memberResponse, error) {
+	reg := ctx.Registry()
+	uid := chi.URLParam(ctx.Request(), "uid")
+	m, err := model.NewMembershipTable().Update(ctx, reg.db, reg.authz, uid, model.MembershipTableUpdateInput{Role: req.Role})
+	if err != nil {
+		return nil, err
+	}
+	return &memberResponse{UserID: m.UserID, Role: m.Role}, nil
+}
