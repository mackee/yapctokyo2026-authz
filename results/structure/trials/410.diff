+// MembershipTableUpdateInput is the input of MembershipTable.Update.
+type MembershipTableUpdateInput struct {
+	Role string
+}
+
+var validRoles = map[string]bool{RoleManager: true, RoleContributor: true, RoleViewer: true}
+
+// Update changes the role of the user in the project. Only managers may do
+// this (CanManageMembers); the user must already be a member of the project,
+// otherwise ErrNotFound.
+func (tt *MembershipTable) Update(ctx context.Context, db DB, authz ProjectAuthz, userID string, in MembershipTableUpdateInput) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if !validRoles[in.Role] {
+		return nil, deny(ErrInvalid, "invalid role")
+	}
+	var m *Membership
+	if err := db.update(ctx, func(x *Tx) error {
+		agg, err := loadUpdateMembership(ctx, x, authz.ProjectID(), userID, in.Role)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if m, err = agg.apply(ctx, x); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
