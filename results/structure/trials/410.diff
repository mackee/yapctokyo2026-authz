+func TestUpdateMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, project, uid, body string
+		want                           int
+	}{
+		{"manager demotes", "ann", "web", "ben", `{"role":"viewer"}`, 200},
+		{"manager promotes", "ann", "web", "dan", `{"role":"contributor"}`, 200},
+		{"manager same role", "ann", "web", "ben", `{"role":"contributor"}`, 200},
+		{"manager other manager", "ann", "web", "ivy", `{"role":"contributor"}`, 200},
+		{"contributor", "ben", "web", "cat", `{"role":"viewer"}`, 403},
+		{"contributor self", "ben", "web", "ben", `{"role":"manager"}`, 403},
+		{"viewer", "dan", "web", "ben", `{"role":"viewer"}`, 403},
+		{"org admin", "eve", "web", "ben", `{"role":"viewer"}`, 403},
+		{"non member", "hal", "web", "ben", `{"role":"viewer"}`, 404},
+		{"other org", "gus", "web", "ben", `{"role":"viewer"}`, 404},
+		{"archived", "ann", "legacy", "ben", `{"role":"viewer"}`, 409},
+		{"target not a member", "ann", "web", "hal", `{"role":"viewer"}`, 404},
+		{"target member of other project only", "ivy", "ops", "ben", `{"role":"viewer"}`, 404},
+		{"actor only a viewer there", "ann", "ops", "cat", `{"role":"viewer"}`, 403},
+		{"unknown target", "ann", "web", "zed", `{"role":"viewer"}`, 404},
+		{"invalid role", "ann", "web", "ben", `{"role":"owner"}`, 400},
+		{"empty role", "ann", "web", "ben", `{"role":""}`, 400},
+		{"missing role", "ann", "web", "ben", `{}`, 400},
+		{"bad json", "ann", "web", "ben", `not json`, 400},
+		{"anonymous", "", "web", "ben", `{"role":"viewer"}`, 401},
+		{"unknown user", "zed", "web", "ben", `{"role":"viewer"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members/"+c.uid, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRoleResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["userId"] != "ben" || got["role"] != "viewer" || len(got) != 2 {
+		t.Fatalf("body = %s", body)
+	}
+}
+
+func TestUpdateMemberRoleTakesEffect(t *testing.T) {
+	h := newServer()
+	newTask := `{"title":"x"}`
+
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", newTask); code != 200 {
+		t.Fatalf("contributor create before change: got %d want 200", code)
+	}
+	if code, body := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote: got %d want 200: %s", code, body)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", newTask); code != 403 {
+		t.Fatalf("viewer create after demotion: got %d want 403", code)
+	}
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"contributor"}`); code != 200 {
+		t.Fatalf("promote back: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", newTask); code != 200 {
+		t.Fatalf("contributor create after promotion: got %d want 200", code)
+	}
+}
