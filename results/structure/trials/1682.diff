+// updateMembersRequest is the body of PUT /projects/{pid}/members: user ID -> role.
+type updateMembersRequest struct {
+	Roles map[string]string `json:"roles" validate:"required,min=1,dive,oneof=manager contributor viewer"`
+}
+
+// memberResponse is one entry of the member list.
+type memberResponse struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func updateMembers(ctx tanukirpc.Context[*projectRegistry], req updateMembersRequest) ([]memberResponse, error) {
+	reg := ctx.Registry()
+	members, err := model.NewMembershipTable().UpdateRoles(ctx, reg.db, reg.authz, model.MembershipTableUpdateRolesInput{Roles: req.Roles})
+	if err != nil {
+		return nil, err
+	}
+	out := make([]memberResponse, 0, len(members))
+	for _, m := range members {
+		out = append(out, memberResponse{UserID: m.UserID, Role: m.Role})
+	}
+	return out, nil
+}
