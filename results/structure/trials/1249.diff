+// TaskTableMoveInput is the input of TaskTable.Move.
+type TaskTableMoveInput struct {
+	ToProjectID string
+}
+
+// Move moves the task to another project, keeping its ID, title, status and
+// assignee. The actor must be able to delete the task from its project
+// (manager, not archived) and to create tasks in the destination (contributor
+// or manager, not archived; unreadable destinations are ErrNotFound). The
+// assignee, if any, must be a contributor or manager of the destination
+// (else ErrInvalid).
+func (*TaskTable) Move(ctx context.Context, db DB, authz TaskAuthz, in TaskTableMoveInput) (*Task, error) {
+	if err := authz.CanManage(); err != nil {
+		return nil, err
+	}
+	if in.ToProjectID == "" {
+		return nil, deny(ErrInvalid, "toProjectId must not be empty")
+	}
+	var t *Task
+	if err := inTx(ctx, db, func(tx DB) error {
+		dest, err := NewProjectAuthz(ctx, tx, authz.Project().Actor(), in.ToProjectID)
+		if err != nil {
+			return err
+		}
+		if err := dest.CanWrite(); err != nil {
+			return err
+		}
+		if dest.ProjectID() == authz.Project().ProjectID() {
+			return deny(ErrInvalid, "task is already in the project")
+		}
+		agg, err := loadMoveTask(ctx, tx, authz.TaskID(), dest.ProjectID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if t, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return t, nil
+}
