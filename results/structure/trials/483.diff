+// Move moves the task into the target project. The task keeps its ID, title,
+// status and assignee. The actor must be able to manage the task in its
+// current project (CanManage) and to write in the target project (CanWrite).
+// The assignee must still be a contributor or manager of the target project.
+func (*TaskTable) Move(ctx context.Context, db DB, authz TaskAuthz, target ProjectAuthz) (*Task, error) {
+	if err := authz.CanManage(); err != nil {
+		return nil, err
+	}
+	if err := target.CanWrite(); err != nil {
+		return nil, err
+	}
+	if target.ProjectID() == authz.Project().ProjectID() {
+		return nil, deny(ErrInvalid, "task is already in the project")
+	}
+	var t *Task
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveTask(ctx, tx, authz.TaskID(), target.ProjectID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if t, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return t, nil
+}
