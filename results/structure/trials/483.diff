+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager of source and writer of target", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 200},
+		{"contributor cannot manage source", "ben", "/projects/web/tasks/t1", `{"toProjectId":"legacy"}`, 403},
+		{"target not readable by actor", "ben", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 404},
+		{"org admin cannot manage source", "eve", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 403},
+		{"manager but viewer of target", "ann", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 403},
+		{"target archived", "ann", "/projects/web/tasks/t3", `{"toProjectId":"legacy"}`, 409},
+		{"source archived", "ann", "/projects/legacy/tasks/t5", `{"toProjectId":"web"}`, 409},
+		{"target in another org", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"gx"}`, 404},
+		{"target missing", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"nope"}`, 404},
+		{"target is source", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"web"}`, 400},
+		{"assignee not a member of target", "ivy", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 400},
+		{"missing toProjectId", "ivy", "/projects/web/tasks/t3", `{}`, 400},
+		{"cross project id", "ivy", "/projects/web/tasks/t4", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsFields(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got Task
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", AssigneeID: "cat"}
+	if got != want {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks/t2", "ivy", ""); code != 200 {
+		t.Fatalf("task not readable in target: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t2", "ivy", ""); code != 404 {
+		t.Fatalf("task still readable in source: %d", code)
+	}
+}
