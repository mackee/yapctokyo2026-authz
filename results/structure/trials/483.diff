+// moveTaskAggregate moves one task into another project.
+type moveTaskAggregate struct {
+	task     *Task
+	target   *Project
+	assignee *Membership // the task's assignee as a member of the target project; nil when unassigned
+}
+
+func loadMoveTask(ctx context.Context, tx DB, taskID, targetID string) (*moveTaskAggregate, error) {
+	t, err := NewTaskTable().Find(ctx, tx, taskID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	p, err := NewProjectTable().Find(ctx, tx, targetID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "task must belong to an existing project")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveTaskAggregate{task: t, target: p}
+	if t.AssigneeID != "" {
+		m, err := p.Membership(ctx, tx, t.AssigneeID)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "assignee must be a contributor or manager of the target project")
+		} else if err != nil {
+			return nil, err
+		}
+		a.assignee = m
+	}
+	return a, nil
+}
+
+func (a *moveTaskAggregate) validate() error {
+	if a.assignee != nil && !isWriterRole(a.assignee.Role) {
+		return deny(ErrInvalid, "assignee must be a contributor or manager of the target project")
+	}
+	return nil
+}
+
+func (a *moveTaskAggregate) apply(ctx context.Context, tx DB) (*Task, error) {
+	if err := a.task.moveTo(ctx, tx, a.target.ID); err != nil {
+		return nil, err
+	}
+	return a.task, nil
+}
