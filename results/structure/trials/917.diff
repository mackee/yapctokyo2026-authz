+// setRolesAggregate changes the roles of existing members of one project. Every
+// target must already be a member; the change is all or nothing.
+type setRolesAggregate struct {
+	changes []roleChange // ordered by user ID
+}
+
+type roleChange struct {
+	member *Membership // project.Membership(user), loaded before the change
+	role   string
+}
+
+func loadSetRoles(ctx context.Context, tx DB, projectID string, in MembershipTableSetRolesInput) (*setRolesAggregate, error) {
+	userIDs := make([]string, 0, len(in.Roles))
+	for userID := range in.Roles {
+		userIDs = append(userIDs, userID)
+	}
+	sort.Strings(userIDs)
+	a := &setRolesAggregate{}
+	for _, userID := range userIDs {
+		m, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "user "+userID+" is not a member of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		a.changes = append(a.changes, roleChange{member: m, role: in.Roles[userID]})
+	}
+	return a, nil
+}
+
+func (a *setRolesAggregate) validate() error {
+	for _, c := range a.changes {
+		if !isProjectRole(c.role) {
+			return deny(ErrInvalid, "role must be manager, contributor or viewer")
+		}
+	}
+	return nil
+}
+
+func (a *setRolesAggregate) apply(ctx context.Context, tx DB) error {
+	for _, c := range a.changes {
+		if err := c.member.setRole(ctx, tx, c.role); err != nil {
+			return err
+		}
+	}
+	return nil
+}
