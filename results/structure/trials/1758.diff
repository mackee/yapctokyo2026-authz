+		{"empty role", `{"roles":{"dan":""}}`},
+		{"not a member", `{"roles":{"hal":"viewer"}}`},
+		{"other org user", `{"roles":{"gus":"viewer"}}`},
+		{"unknown user", `{"roles":{"zed":"viewer"}}`},
+		{"assignee would become viewer", `{"roles":{"ben":"viewer"}}`},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/web/members", "ann", c.body)
