+}
+
+func TestChangeMembersResult(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","ivy":"viewer"}}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got []memberOut
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []memberOut{
+		{"ann", "manager"}, {"ben", "contributor"}, {"cat", "contributor"},
+		{"dan", "contributor"}, {"ivy", "viewer"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("got %v want %v", got, want)
+		}
+	}
+	// The change is persisted: dan can now be assigned a task.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ann", `{"title":"x","assignee":"dan"}`); code != 200 {
+		t.Fatalf("dan should be assignable, got %d", code)
+	}
+	// Other projects are untouched.
+	if code, _ := do(t, h, "POST", "/projects/ops/tasks", "ivy", `{"title":"x"}`); code != 200 {
+		t.Fatalf("ivy is still ops manager, got %d", code)
+	}
+}
+
+func TestChangeMembersAllOrNothing(t *testing.T) {
+	h := newServer()
+	// dan would become contributor, but zed is not a member: nothing changes.
+	if code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","zed":"viewer"}}`); code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ann", `{"title":"x","assignee":"dan"}`); code != 400 {
+		t.Fatalf("dan must still be a viewer, got %d", code)
+	}
+	// ivy would become viewer, but ben holds an assigned task: nothing changes.
+	if code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ivy":"viewer","ben":"viewer"}}`); code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ivy", `{"title":"x"}`); code != 200 {
+		t.Fatalf("ivy must still be a manager, got %d", code)
+	}
+}
