+// RemoveFromOrg removes the user from every project of the organization: their
+// memberships there are deleted, and the tasks they hold in those projects are
+// unassigned. The actor must be an org admin of the organization (else
+// ErrForbidden); the user must belong to it (else ErrNotFound).
+func (*UserTable) RemoveFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanManageMembers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveOrgUser(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
