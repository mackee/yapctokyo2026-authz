+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes user without roles", "eve", "/orgs/acme/users/hal", 204},
+		{"project manager is not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"plain member", "ben", "/orgs/acme/users/cat", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"caller from other org", "gus", "/orgs/acme/users/ben", 404},
+		{"admin of other org's path", "eve", "/orgs/globex/users/gus", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserRemovesAllMemberships(t *testing.T) {
+	h := newServer()
+	// ben is a member of web and of the archived project legacy.
+	for _, p := range []string{"web", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ben", ""); code != 200 {
+			t.Fatalf("precondition: ben reading %s got %d", p, code)
+		}
+	}
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove got %d", code)
+	}
+	for _, p := range []string{"web", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ben", ""); code != 404 {
+			t.Fatalf("ben still reads %s after removal: %d", p, code)
+		}
+	}
+	// Other members are untouched.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat lost access: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/legacy/tasks", "ann", ""); code != 200 {
+		t.Fatalf("ann lost access: %d", code)
+	}
+}
+
+func TestRemoveOrgUserSpansProjects(t *testing.T) {
+	h := newServer()
+	// cat is a member of web and ops.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/cat", "eve", ""); code != 204 {
+		t.Fatalf("remove got %d", code)
+	}
+	for _, p := range []string{"web", "ops"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "cat", ""); code != 404 {
+			t.Fatalf("cat still reads %s: %d", p, code)
+		}
+	}
+}
+
+func TestRemoveOrgUserForbiddenKeepsMemberships(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "ann", ""); code != 403 {
+		t.Fatalf("got %d want 403", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben lost access despite rejected request: %d", code)
+	}
+}
+
+func TestRemoveOrgAdminRevokesAdminAccess(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "eve", ""); code != 200 {
+		t.Fatalf("precondition: admin read got %d", code)
+	}
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/eve", "eve", ""); code != 204 {
+		t.Fatalf("remove got %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "eve", ""); code == 200 {
+		t.Fatalf("removed admin can still read projects")
+	}
+}
+
+func TestRemoveOrgUserIdempotent(t *testing.T) {
+	h := newServer()
+	for i := 0; i < 2; i++ {
+		if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+			t.Fatalf("call %d got %d", i+1, code)
+		}
+	}
+}
