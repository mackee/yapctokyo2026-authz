diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..f679a1d
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,164 @@
+package main
+
+import (
+	"encoding/json"
+	"reflect"
+	"testing"
+)
+
+type memberJSON struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func rolesOf(t *testing.T, h *appHandler, project string) map[string]string {
+	t.Helper()
+	rows, err := h.db.Query(`SELECT user_id, role FROM memberships WHERE project_id = ?`, project)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer rows.Close()
+	out := map[string]string{}
+	for rows.Next() {
+		var u, r string
+		if err := rows.Scan(&u, &r); err != nil {
+			t.Fatal(err)
+		}
+		out[u] = r
+	}
+	return out
+}
+
+func assigneeOf(t *testing.T, h *appHandler, task string) string {
+	t.Helper()
+	var a string
+	if err := h.db.QueryRow(`SELECT assignee FROM tasks WHERE id = ?`, task).Scan(&a); err != nil {
+		t.Fatal(err)
+	}
+	return a
+}
+
+func TestBulkRolesSuccess(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []memberJSON
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []memberJSON{
+		{"ann", "manager"}, {"ben", "viewer"}, {"cat", "contributor"}, {"dan", "contributor"}, {"ivy", "manager"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+	roles := rolesOf(t, h.(*appHandler), "web")
+	if roles["ben"] != "viewer" || roles["dan"] != "contributor" || roles["cat"] != "contributor" {
+		t.Fatalf("stored roles wrong: %v", roles)
+	}
+}
+
+// A member demoted to viewer can no longer be an assignee (model rule), so
+// their tasks in the project are unassigned. Other projects are untouched.
+func TestBulkRolesDemotionUnassignsTasks(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","cat":"viewer"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	app := h.(*appHandler)
+	if a := assigneeOf(t, app, "t1"); a != "" {
+		t.Fatalf("t1 assignee %q, want unassigned", a)
+	}
+	if a := assigneeOf(t, app, "t2"); a != "" {
+		t.Fatalf("t2 assignee %q, want unassigned", a)
+	}
+	if a := assigneeOf(t, app, "t4"); a != "cat" { // ops task, cat still contributor there
+		t.Fatalf("t4 assignee %q, want cat", a)
+	}
+	if a := assigneeOf(t, app, "t5"); a != "ben" { // legacy task
+		t.Fatalf("t5 assignee %q, want ben", a)
+	}
+}
+
+func TestBulkRolesNoChangeNeeded(t *testing.T) {
+	h := newServer()
+	code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d", code)
+	}
+	if a := assigneeOf(t, h.(*appHandler), "t1"); a != "ben" {
+		t.Fatalf("t1 assignee %q, want ben", a)
+	}
+}
+
+func TestBulkRolesPermissions(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ivy", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+		{"archived", "ann", "legacy", 409},
+		{"missing project", "ann", "nope", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			before := rolesOf(t, h.(*appHandler), c.project)
+			body := `{"roles":{"ben":"viewer"}}`
+			code, _ := do(t, h, "PUT", "/projects/"+c.project+"/members", c.user, body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+			if c.want != 200 {
+				if after := rolesOf(t, h.(*appHandler), c.project); !reflect.DeepEqual(before, after) {
+					t.Fatalf("roles changed on failure: %v -> %v", before, after)
+				}
+			}
+		})
+	}
+}
+
+// One entry that cannot be applied rejects the whole request, changing nothing.
+func TestBulkRolesAllOrNothing(t *testing.T) {
+	cases := []struct {
+		name, body string
+		want       int
+	}{
+		{"invalid role", `{"roles":{"dan":"contributor","ben":"admin"}}`, 400},
+		{"empty role", `{"roles":{"dan":"contributor","ben":""}}`, 400},
+		{"not a member", `{"roles":{"dan":"contributor","hal":"viewer"}}`, 400},
+		{"unknown user", `{"roles":{"dan":"contributor","zed":"viewer"}}`, 400},
+		{"other org user", `{"roles":{"dan":"contributor","gus":"viewer"}}`, 400},
+		{"empty roles", `{"roles":{}}`, 400},
+		{"missing roles", `{}`, 400},
+		{"malformed", `{"roles":`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			app := h.(*appHandler)
+			beforeRoles := rolesOf(t, app, "web")
+			beforeT1 := assigneeOf(t, app, "t1")
+			code, _ := do(t, h, "PUT", "/projects/web/members", "ann", c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+			if after := rolesOf(t, app, "web"); !reflect.DeepEqual(beforeRoles, after) {
+				t.Fatalf("roles changed: %v -> %v", beforeRoles, after)
+			}
+			if a := assigneeOf(t, app, "t1"); a != beforeT1 {
+				t.Fatalf("t1 assignee changed to %q", a)
+			}
+		})
+	}
+}
