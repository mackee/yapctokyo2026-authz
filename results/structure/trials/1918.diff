+// changeRolesAggregate changes the roles of several members of one project.
+// A member who stops being a contributor or manager can no longer be an
+// assignee, so their tasks in the project are unassigned.
+type changeRolesAggregate struct {
+	members  []*Membership // the members named in the input, ordered by user ID
+	newRoles map[string]string
+	demoted  map[string][]*Task // user ID -> tasks to unassign
+}
+
+func loadChangeRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*changeRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	all, err := p.Memberships(ctx, tx) // ordered by user ID
+	if err != nil {
+		return nil, err
+	}
+	a := &changeRolesAggregate{newRoles: roles, demoted: map[string][]*Task{}}
+	for _, m := range all {
+		if _, ok := roles[m.UserID]; ok {
+			a.members = append(a.members, m)
+		}
+	}
+	if len(a.members) != len(roles) {
+		return nil, deny(ErrInvalid, "every user must be a member of the project")
+	}
+	for _, m := range a.members {
+		if isWriterRole(m.Role) && !isWriterRole(roles[m.UserID]) {
+			tasks, err := m.AssignedTasks(ctx, tx)
+			if err != nil {
+				return nil, err
+			}
+			a.demoted[m.UserID] = tasks
+		}
+	}
+	return a, nil
+}
+
+func (a *changeRolesAggregate) validate() error {
+	for _, m := range a.members {
+		if !isValidRole(a.newRoles[m.UserID]) {
+			return deny(ErrInvalid, "role must be manager, contributor or viewer")
+		}
+	}
+	return nil
+}
+
+func (a *changeRolesAggregate) apply(ctx context.Context, tx DB) error {
+	for _, m := range a.members {
+		if err := m.setRole(ctx, tx, a.newRoles[m.UserID]); err != nil {
+			return err
+		}
+		for _, t := range a.demoted[m.UserID] {
+			if err := t.unassign(ctx, tx); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
