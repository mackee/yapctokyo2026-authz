+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes user with no memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"org admin removes unknown user", "eve", "/orgs/acme/users/zed", 404},
+		{"user of another org", "eve", "/orgs/acme/users/gus", 404},
+		{"another org's path", "eve", "/orgs/globex/users/gus", 404},
+		{"caller of another org", "gus", "/orgs/acme/users/ben", 404},
+		{"same org manager, not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"same org, no roles", "hal", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d %s", code, body)
+	}
+
+	// ben is gone from every acme project, including the archived one.
+	for _, path := range []string{"/projects/web/tasks", "/projects/legacy/tasks", "/projects/web/tasks/t1"} {
+		if code, _ := do(t, srv, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("ben GET %s: got %d want 404", path, code)
+		}
+	}
+
+	// Other members and other orgs are unaffected.
+	for _, c := range []struct{ user, path string }{
+		{"ann", "/projects/web/tasks"},
+		{"cat", "/projects/web/tasks"},
+		{"ann", "/projects/legacy/tasks"},
+		{"gus", "/projects/gx/tasks"},
+	} {
+		if code, _ := do(t, srv, "GET", c.path, c.user, ""); code != 200 {
+			t.Fatalf("%s GET %s: got %d want 200", c.user, c.path, code)
+		}
+	}
+
+	// Task assignments are not changed: t1 still names ben.
+	code, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 || !strings.Contains(body, `"assignee":"ben"`) {
+		t.Fatalf("t1: got %d %s, want assignee ben kept", code, body)
+	}
+
+	// Removing again is a no-op.
+	if code, body := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("second remove: got %d %s", code, body)
+	}
+}
