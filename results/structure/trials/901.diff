+// RemoveFromOrg removes the user from every project of the organization. It
+// deletes the user's memberships in those projects, all or nothing; the user
+// row itself is kept. Org admins only. A user who is not in the organization
+// is ErrNotFound; a user with no memberships there is a no-op.
+func (*UserTable) RemoveFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanManageUsers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveOrgUser(ctx, tx, authz.Org(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
