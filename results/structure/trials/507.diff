@@ -0,0 +1,52 @@
+package model
+
+import (
+	"context"
+	"testing"
+)
+
+func TestTransferRemovesOldOrgRows(t *testing.T) {
+	ctx := context.Background()
+	db, err := Open()
+	if err != nil {
+		t.Fatal(err)
+	}
+	eve, err := Authenticate(ctx, db, "eve")
+	if err != nil {
+		t.Fatal(err)
+	}
+	authz, err := NewOrgAuthz(eve, "acme")
+	if err != nil {
+		t.Fatal(err)
+	}
+	u, err := NewUserTable().Transfer(ctx, db, authz, "ben", UserTableTransferInput{ToOrgID: "globex"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if u.Org != "globex" {
+		t.Fatalf("org: got %q want globex", u.Org)
+	}
+
+	ms, err := NewMembershipTable().ListByUser(ctx, db, "ben")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(ms) != 0 {
+		t.Fatalf("ben still has %d memberships in acme projects", len(ms))
+	}
+	ts, err := NewTaskTable().ListByAssignee(ctx, db, "ben")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(ts) != 0 {
+		t.Fatalf("ben is still assigned %d tasks", len(ts))
+	}
+	// Other users' rows are untouched.
+	ann, err := NewMembershipTable().ListByUser(ctx, db, "ann")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(ann) != 3 {
+		t.Fatalf("ann memberships: got %d want 3", len(ann))
+	}
+}
