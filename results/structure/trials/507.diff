 func (a *deleteTaskAggregate) apply(ctx context.Context, tx DB) error { return a.task.destroy(ctx, tx) }
+
+// transferUserAggregate moves one user to another organization. The user leaves
+// the projects of the old organization: their memberships there are removed,
+// and their tasks there are unassigned, so the model rules still hold.
+type transferUserAggregate struct {
+	user    *User
+	toOrgID string
+	leaving []*Membership // memberships in projects outside the target organization
+	tasks   []*Task       // tasks assigned to the user in projects outside the target organization
+}
+
+func loadTransferUser(ctx context.Context, tx DB, fromOrgID, userID string, in UserTableTransferInput) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != fromOrgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if _, err := NewOrgTable().Find(ctx, tx, in.ToOrgID); errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "organization does not exist")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &transferUserAggregate{user: u, toOrgID: in.ToOrgID}
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, m := range ms {
+		p, err := m.Project(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		if p.Org != in.ToOrgID {
+			a.leaving = append(a.leaving, m)
+		}
+	}
+	ts, err := u.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, t := range ts {
+		p, err := t.Project(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		if p.Org != in.ToOrgID {
+			a.tasks = append(a.tasks, t)
+		}
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if a.user.Org == a.toOrgID {
+		return deny(ErrInvalid, "user is already in that organization")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	for _, m := range a.leaving {
+		if err := m.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.user.moveTo(ctx, tx, a.toOrgID); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
