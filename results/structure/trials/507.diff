--- /dev/null
+++ b/transfer_test.go
@@ -0,0 +1,85 @@
+package main
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func TestTransferUser(t *testing.T) {
+	cases := []struct {
+		name, user, org, uid, body string
+		want                       int
+	}{
+		{"org admin moves member", "eve", "acme", "ben", `{"toOrgId":"globex"}`, 200},
+		{"non admin member", "ann", "acme", "ben", `{"toOrgId":"globex"}`, 403},
+		{"viewer of org", "hal", "acme", "ben", `{"toOrgId":"globex"}`, 403},
+		{"caller in other org", "gus", "acme", "ben", `{"toOrgId":"globex"}`, 404},
+		{"org the caller is not in", "eve", "globex", "gus", `{"toOrgId":"acme"}`, 404},
+		{"user in another org", "eve", "acme", "gus", `{"toOrgId":"acme"}`, 404},
+		{"unknown user", "eve", "acme", "zed", `{"toOrgId":"globex"}`, 404},
+		{"anonymous", "", "acme", "ben", `{"toOrgId":"globex"}`, 401},
+		{"unknown caller", "zed", "acme", "ben", `{"toOrgId":"globex"}`, 401},
+		{"unknown target org", "eve", "acme", "ben", `{"toOrgId":"initech"}`, 400},
+		{"same org", "eve", "acme", "ben", `{"toOrgId":"acme"}`, 400},
+		{"missing target", "eve", "acme", "ben", `{}`, 400},
+		{"malformed body", "eve", "acme", "ben", `{"toOrgId":`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			path := "/orgs/" + c.org + "/users/" + c.uid + "/transfer"
+			code, _ := do(t, newServer(), "POST", path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got struct {
+		ID    string `json:"id"`
+		OrgID string `json:"orgId"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.ID != "ben" || got.OrgID != "globex" {
+		t.Fatalf("got %+v", got)
+	}
+}
+
+func TestTransferTakesUserOutOfOldOrg(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: got %d: %s", code, body)
+	}
+
+	// ben can no longer see acme's projects.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads web: got %d want 404", code)
+	}
+	// ben's task in web is unassigned; the project is still readable by ann.
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("ann reads t1: got %d", code)
+	}
+	if !strings.Contains(body, `"assignee":""`) {
+		t.Fatalf("t1 should be unassigned, got %s", body)
+	}
+}
+
+func TestTransferClearsOrgAdmin(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: got %d: %s", code, body)
+	}
+	// eve is now in globex and no longer an org admin there.
+	if code, _ := do(t, h, "POST", "/orgs/globex/users/eve/transfer", "eve", `{"toOrgId":"acme"}`); code != 403 {
+		t.Fatalf("got %d want 403", code)
+	}
+}
