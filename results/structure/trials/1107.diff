+func TestFreeze(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"contributor", "ben", "/projects/web/freeze", 403},
+		{"viewer", "dan", "/projects/web/freeze", 403},
+		{"org admin", "eve", "/projects/web/freeze", 403},
+		{"non member", "hal", "/projects/web/freeze", 404},
+		{"anonymous", "", "/projects/web/freeze", 401},
+		{"archived", "ann", "/projects/legacy/freeze", 409},
+		{"manager of other role elsewhere", "ann", "/projects/ops/freeze", 403},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeEffect(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var members []struct{ UserID, Role string }
+	if err := json.Unmarshal([]byte(body), &members); err != nil {
+		t.Fatal(err)
+	}
+	if len(members) != 5 {
+		t.Fatalf("want 5 members, got %d: %s", len(members), body)
+	}
+	for _, m := range members {
+		if m.Role != "viewer" {
+			t.Fatalf("%s is %s", m.UserID, m.Role)
+		}
+	}
+	if !strings.Contains(body, `"userId":"ann"`) || !strings.Contains(body, `"role":"viewer"`) {
+		t.Fatalf("unexpected JSON shape: %s", body)
+	}
+
+	// Nobody can change tasks any more, the former manager included.
+	writes := []struct{ user, method, path, body string }{
+		{"ann", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"ann", "DELETE", "/projects/web/tasks/t1", ""},
+		{"ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"ivy", "DELETE", "/projects/web/tasks/t3", ""},
+	}
+	for _, w := range writes {
+		if code, b := do(t, h, w.method, w.path, w.user, w.body); code != 403 {
+			t.Fatalf("%s %s by %s: got %d want 403 body=%s", w.method, w.path, w.user, code, b)
+		}
+	}
+	// Reads still work, and a second freeze is refused (no manager left).
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ann", ""); code != 200 {
+		t.Fatalf("read got %d", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 403 {
+		t.Fatalf("second freeze got %d", code)
+	}
+	// Other projects are untouched.
+	if code, _ := do(t, h, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ops write got %d", code)
+	}
+}
