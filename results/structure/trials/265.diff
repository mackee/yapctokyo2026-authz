+// Manage applies the manager rule: readable, manager (else 403), not archived
+// (else 409). Org admins who are not managers get 403.
+func (s *projectScope) Manage() (ManageProject, error) {
+	err := s.as.a.st.read(func(st *state) error {
+		p, r, err := readable(st, s.as.actor, s.pid)
+		if err != nil {
+			return err
+		}
+		if r != RoleManager {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if p.archived {
+			return deny(ErrArchived, "project is archived")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &manageProject{readProject: readProject{ps: s}}, nil
+}
+
 // ---- project capabilities ----------------------------------------------------
 
+// MemberView is the public representation of a project member.
+type MemberView struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// ManageProject is the manager-only capability for project-wide operations.
+type ManageProject interface {
+	ReadProject
+	// Freeze makes every member (managers included) a viewer, so nobody can
+	// modify the project's tasks any more, and returns the resulting members
+	// sorted by user ID. Because an assignee must be a contributor or manager,
+	// all task assignments in the project are cleared.
+	Freeze() ([]MemberView, error)
+}
+
+type manageProject struct{ readProject }
+
+func (p *manageProject) Freeze() ([]MemberView, error) {
+	pid := p.ps.pid
+	var out []MemberView
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		for uid := range s.members[pid] {
+			s.members[pid][uid] = RoleViewer
+		}
+		for id, t := range s.tasks {
+			if t.project == pid && t.assignee.user != "" {
+				t.assignee = Assignee{project: pid}
+				s.tasks[id] = t
+			}
+		}
+		out = s.membersOf(pid)
+		return nil
+	})
+	return out, err
+}
+
