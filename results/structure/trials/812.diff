+func TestSetMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, project, uid, body string
+		want                           int
+	}{
+		{"manager demotes contributor", "ann", "web", "ben", `{"role":"viewer"}`, 200},
+		{"manager promotes viewer", "ann", "web", "dan", `{"role":"manager"}`, 200},
+		{"manager sets contributor", "ann", "web", "dan", `{"role":"contributor"}`, 200},
+		{"contributor cannot change roles", "ben", "web", "cat", `{"role":"viewer"}`, 403},
+		{"viewer cannot change roles", "dan", "web", "ben", `{"role":"viewer"}`, 403},
+		{"org admin without role", "eve", "web", "ben", `{"role":"viewer"}`, 403},
+		{"non member", "hal", "web", "ben", `{"role":"viewer"}`, 404},
+		{"other org", "gus", "web", "ben", `{"role":"viewer"}`, 404},
+		{"unknown user", "zed", "web", "ben", `{"role":"viewer"}`, 401},
+		{"anonymous", "", "web", "ben", `{"role":"viewer"}`, 401},
+		{"archived", "ann", "legacy", "ben", `{"role":"viewer"}`, 409},
+		{"target not a member", "ann", "web", "hal", `{"role":"viewer"}`, 404},
+		{"manager changes own role", "ann", "web", "ann", `{"role":"viewer"}`, 200},
+		{"invalid role", "ann", "web", "ben", `{"role":"owner"}`, 400},
+		{"empty role", "ann", "web", "ben", `{"role":""}`, 400},
+		{"bad body", "ann", "web", "ben", `nope`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members/"+c.uid, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMemberRoleResponseAndEffect(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatalf("got %d", code)
+	}
+	var got struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.UserID != "dan" || got.Role != "contributor" {
+		t.Fatalf("got %+v", got)
+	}
+	// dan is now a contributor, so may create a task.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("promoted user create: got %d want 200", code)
+	}
+	// ben is demoted to viewer, so may no longer create tasks.
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote: got %d", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Fatalf("demoted user create: got %d want 403", code)
+	}
+}
