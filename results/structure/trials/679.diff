+
+type Member struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+type updateMembersRequest struct {
+	Roles map[string]string `json:"roles"`
+}
+
+// updateMembers changes the roles of several existing members at once. Either
+// every change applies or none does. Only managers may call it.
+func (s *server) updateMembers(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role, err := findRole(ctx, s.db, project.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req updateMembersRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || len(req.Roles) == 0 {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	// Validate the requested roles before touching anything.
+	userIDs := make([]string, 0, len(req.Roles))
+	for uid, newRole := range req.Roles {
+		if newRole != RoleManager && newRole != RoleContributor && newRole != RoleViewer {
+			writeError(w, 400, "invalid role")
+			return
+		}
+		userIDs = append(userIDs, uid)
+	}
+	sort.Strings(userIDs)
+
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+	// Every target must already be a member; check all of them inside the
+	// transaction before writing any change.
+	for _, uid := range userIDs {
+		var current string
+		err := tx.QueryRowContext(ctx, `SELECT role FROM memberships WHERE project_id = ? AND user_id = ?`, project.ID, uid).Scan(&current)
+		if errors.Is(err, sql.ErrNoRows) {
+			writeError(w, 400, "user is not a member of the project: "+uid)
+			return
+		}
+		if err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+	}
+	for _, uid := range userIDs {
+		if _, err := tx.ExecContext(ctx, `UPDATE memberships SET role = ? WHERE project_id = ? AND user_id = ?`,
+			req.Roles[uid], project.ID, uid); err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+	}
+	members, err := listMembers(ctx, tx, project.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, members)
+}
+
+// listMembers returns the project's members sorted by user ID.
+func listMembers(ctx context.Context, q interface {
+	QueryContext(context.Context, string, ...any) (*sql.Rows, error)
+}, projectID string) ([]Member, error) {
+	rows, err := q.QueryContext(ctx, `SELECT user_id, role FROM memberships WHERE project_id = ? ORDER BY user_id`, projectID)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	members := []Member{}
+	for rows.Next() {
+		var m Member
+		if err := rows.Scan(&m.UserID, &m.Role); err != nil {
+			return nil, err
+		}
+		members = append(members, m)
+	}
+	return members, rows.Err()
+}
