+func TestFreezeLocksTasks(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d body=%s", code, body)
+	}
+	cases := []struct {
+		name, user, method, path, body string
+	}{
+		{"manager create", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"manager update", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"manager delete", "ann", "DELETE", "/projects/web/tasks/t1", ""},
+		{"former contributor update own", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"former contributor create", "cat", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"second freeze", "ann", "POST", "/projects/web/freeze", ""},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, srv, c.method, c.path, c.user, c.body)
+			if code != 403 {
+				t.Fatalf("got %d want 403", code)
+			}
+		})
+	}
+	// Reads still work, and the freeze is scoped to its project.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "dan", ""); code != 200 {
+		t.Fatalf("read after freeze: got %d", code)
+	}
+	if code, _ := do(t, srv, "POST", "/projects/ops/tasks", "ivy", `{"title":"x"}`); code != 200 {
+		t.Fatalf("other project after freeze: got %d", code)
+	}
+}
