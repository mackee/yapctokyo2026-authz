+func TestFreezeResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got []map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := `[{"userId":"ann","role":"viewer"},{"userId":"ben","role":"viewer"},{"userId":"cat","role":"viewer"},{"userId":"dan","role":"viewer"},{"userId":"ivy","role":"viewer"}]`
+	var wantList []map[string]string
+	json.Unmarshal([]byte(want), &wantList)
+	if len(got) != len(wantList) {
+		t.Fatalf("got %s want %s", body, want)
+	}
+	for i := range got {
+		if got[i]["userId"] != wantList[i]["userId"] || got[i]["role"] != wantList[i]["role"] {
+			t.Fatalf("got %s want %s", body, want)
+		}
+	}
+}
