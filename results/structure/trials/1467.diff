+func TestRemoveOrgUserAccess(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes self", "eve", "/orgs/acme/users/eve", 204},
+		{"member of target without role", "eve", "/orgs/acme/users/hal", 204},
+		{"repeat is idempotent", "eve", "/orgs/acme/users/dan", 204},
+		{"manager is not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"contributor is not org admin", "ben", "/orgs/acme/users/cat", 403},
+		{"other org admin", "gus", "/orgs/acme/users/ben", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ben", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+	app := h.(*appHandler)
+	count := func(t *testing.T, q string, args ...any) int {
+		t.Helper()
+		var n int
+		if err := app.db.QueryRow(q, args...).Scan(&n); err != nil {
+			t.Fatal(err)
+		}
+		return n
+	}
+	if code, body := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	// ben is gone from every acme project, and his tasks there are unassigned.
+	if n := count(t, `SELECT COUNT(*) FROM memberships WHERE user_id = 'ben'`); n != 0 {
+		t.Fatalf("ben still has %d memberships", n)
+	}
+	for _, id := range []string{"t1", "t5"} {
+		if a := count(t, `SELECT COUNT(*) FROM tasks WHERE id = ? AND assignee = ''`, id); a != 1 {
+			t.Fatalf("task %s should be unassigned", id)
+		}
+	}
+	// ben can no longer read the projects he was removed from.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads web: got %d want 404", code)
+	}
+	// Other members and their tasks are untouched.
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "ann", ""); code != 200 {
+		t.Fatalf("ann reads ops: got %d want 200", code)
+	}
+	if a := count(t, `SELECT COUNT(*) FROM tasks WHERE id = 't4' AND assignee = 'cat'`); a != 1 {
+		t.Fatal("t4 assignee changed")
+	}
+	// Removing a user who is an org admin also removes their org-wide read access.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/eve", "eve", ""); code != 204 {
+		t.Fatalf("self removal: got %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "eve", ""); code != 404 {
+		t.Fatalf("eve reads ops after removal: got %d want 404", code)
+	}
+}
