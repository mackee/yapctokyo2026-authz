 // ---- project capabilities ----------------------------------------------------
 
+// MemberView is the public representation of a project member.
+type MemberView struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// ManageProject is the manager-only capability for project membership.
+type ManageProject interface {
+	ReadProject
+	// SetRoles changes the roles of existing members all-or-nothing and
+	// returns the resulting member list sorted by user ID. It is 400 if the
+	// map is empty, a role is invalid, a user is not a member of the project,
+	// or the result would break an invariant (e.g. demoting a task assignee
+	// to viewer, or leaving the project without a manager).
+	SetRoles(roles map[string]string) ([]MemberView, error)
+}
+
+type manageProject struct{ readProject }
+
+func (p *manageProject) SetRoles(roles map[string]string) ([]MemberView, error) {
+	if len(roles) == 0 {
+		return nil, deny(ErrInvalid, "roles must not be empty")
+	}
+	var out []MemberView
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		pid := p.ps.pid
+		for uid, role := range roles {
+			if role != RoleManager && role != RoleContributor && role != RoleViewer {
+				return deny(ErrInvalid, "invalid role for "+uid)
+			}
+			if s.role(pid, uid) == "" {
+				return deny(ErrInvalid, uid+" is not a member of the project")
+			}
+			s.members[pid][uid] = role
+		}
+		out = s.membersIn(pid)
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return out, nil
+}
