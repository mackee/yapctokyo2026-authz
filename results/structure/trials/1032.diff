+type transferRequest struct {
+	ToOrgID string `json:"toOrgId"`
+}
+
+// transferUser moves a user to another organization. Only an org admin of the
+// user's current org may do it. The user's project memberships and task
+// assignments in the old org are removed, and org admin status is not carried
+// over to the new org.
+func (s *server) transferUser(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	caller, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if caller == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	orgID := r.PathValue("oid")
+	if caller.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	target, err := findUser(ctx, s.db, r.PathValue("uid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if target == nil || target.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	if !caller.OrgAdmin {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	var req transferRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || req.ToOrgID == "" {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	if req.ToOrgID == orgID {
+		writeError(w, 400, "user already belongs to that organization")
+		return
+	}
+	// Organizations have no table of their own: one exists if it has users or projects.
+	var exists bool
+	if err := s.db.QueryRowContext(ctx,
+		`SELECT EXISTS (SELECT 1 FROM users WHERE org_id = ?1) OR EXISTS (SELECT 1 FROM projects WHERE org_id = ?1)`,
+		req.ToOrgID).Scan(&exists); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if !exists {
+		writeError(w, 400, "unknown destination organization")
+		return
+	}
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+	stmts := []string{
+		`UPDATE tasks SET assignee = '' WHERE assignee = ?1 AND project_id IN (SELECT id FROM projects WHERE org_id = ?2)`,
+		`DELETE FROM memberships WHERE user_id = ?1 AND project_id IN (SELECT id FROM projects WHERE org_id = ?2)`,
+		`UPDATE users SET org_id = ?3, org_admin = 0 WHERE id = ?1`,
+	}
+	for _, q := range stmts {
+		if _, err := tx.ExecContext(ctx, q, target.ID, orgID, req.ToOrgID); err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, map[string]string{"id": target.ID, "orgId": req.ToOrgID})
+}
