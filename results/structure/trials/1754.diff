+package model
+
+import "context"
+
+// OrgTable answers questions about organizations. There is no organizations
+// table: an organization exists when a user or a project belongs to it.
+type OrgTable struct{}
+
+// NewOrgTable returns the organizations view.
+func NewOrgTable() *OrgTable { return &OrgTable{} }
+
+// Exists reports whether any user or project belongs to the organization.
+func (*OrgTable) Exists(ctx context.Context, db DB, id string) (bool, error) {
+	var n int
+	if err := db.QueryRowContext(ctx,
+		`SELECT (SELECT COUNT(*) FROM users WHERE org_id = ?) + (SELECT COUNT(*) FROM projects WHERE org_id = ?)`,
+		id, id).Scan(&n); err != nil {
+		return false, err
+	}
+	return n > 0, nil
+}
