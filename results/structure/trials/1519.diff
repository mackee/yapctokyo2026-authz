 // Aggregates: one per operation. An aggregate is built inside the transaction
@@ -144,3 +145,66 @@ func loadDeleteTask(ctx context.Context, tx DB, taskID string) (*deleteTaskAggre
 func (a *deleteTaskAggregate) validate() error { return nil }
 
 func (a *deleteTaskAggregate) apply(ctx context.Context, tx DB) error { return a.task.destroy(ctx, tx) }
+
+// updateRolesAggregate changes the roles of several members of one project.
+type updateRolesAggregate struct {
+	changes []*roleChange // ordered by user ID
+}
+
+// roleChange is one member's role change. assigned holds the project's tasks
+// assigned to the member; it is loaded only when the new role is viewer.
+type roleChange struct {
+	member   *Membership
+	role     string
+	assigned []*Task
+}
+
+func loadUpdateRoles(ctx context.Context, tx DB, projectID string, in MembershipTableUpdateRolesInput) (*updateRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	userIDs := make([]string, 0, len(in.Roles))
+	for userID := range in.Roles {
+		userIDs = append(userIDs, userID)
+	}
+	sort.Strings(userIDs)
+	a := &updateRolesAggregate{}
+	for _, userID := range userIDs {
+		m, err := p.Membership(ctx, tx, userID)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, userID+" is not a member of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		c := &roleChange{member: m, role: in.Roles[userID]}
+		if c.role == RoleViewer {
+			if c.assigned, err = m.AssignedTasks(ctx, tx); err != nil {
+				return nil, err
+			}
+		}
+		a.changes = append(a.changes, c)
+	}
+	return a, nil
+}
+
+func (a *updateRolesAggregate) validate() error {
+	for _, c := range a.changes {
+		// An assignee must be a contributor or manager of the task's project.
+		if c.role == RoleViewer && len(c.assigned) > 0 {
+			return deny(ErrInvalid, c.member.UserID+" has assigned tasks in the project and cannot become a viewer; reassign them first")
+		}
+	}
+	return nil
+}
+
+func (a *updateRolesAggregate) apply(ctx context.Context, tx DB) error {
+	for _, c := range a.changes {
+		if err := c.member.setRole(ctx, tx, c.role); err != nil {
+			return err
+		}
+	}
+	return nil
+}
