diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..90f58af
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,141 @@
+package main
+
+import (
+	"database/sql"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"testing"
+)
+
+// roleOf returns the user's role in the project read straight from the
+// database, or "" when the user is not a member.
+func roleOf(t *testing.T, h http.Handler, projectID, userID string) string {
+	t.Helper()
+	app := h.(*appHandler)
+	var role string
+	err := app.db.QueryRow(`SELECT role FROM memberships WHERE project_id = ? AND user_id = ?`, projectID, userID).Scan(&role)
+	if errors.Is(err, sql.ErrNoRows) {
+		return ""
+	}
+	if err != nil {
+		t.Fatal(err)
+	}
+	return role
+}
+
+func TestUpdateMembers(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager changes roles", "ann", "web", `{"roles":{"dan":"contributor","ivy":"viewer"}}`, 200},
+		{"manager promotes to manager", "ann", "web", `{"roles":{"dan":"manager"}}`, 200},
+		{"manager changes own role", "ann", "web", `{"roles":{"ann":"contributor"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"null roles", "ann", "web", `{"roles":null}`, 400},
+		{"bad role", "ann", "web", `{"roles":{"dan":"admin"}}`, 400},
+		{"empty user id", "ann", "web", `{"roles":{"":"viewer"}}`, 400},
+		{"bad json", "ann", "web", `{"roles":`, 400},
+		{"target not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"target in other org", "ann", "web", `{"roles":{"gus":"viewer"}}`, 400},
+		{"mixed valid and not a member", "ann", "web", `{"roles":{"dan":"contributor","hal":"viewer"}}`, 400},
+		// ben is assigned t1 in web, so ben cannot become a viewer.
+		{"demote assignee", "ann", "web", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMembersResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","ivy":"viewer"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var members []struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &members); err != nil {
+		t.Fatal(err)
+	}
+	want := []struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}{
+		{"ann", "manager"},
+		{"ben", "contributor"},
+		{"cat", "contributor"},
+		{"dan", "contributor"},
+		{"ivy", "viewer"},
+	}
+	if len(members) != len(want) {
+		t.Fatalf("got %d members, want %d: %s", len(members), len(want), body)
+	}
+	for i := range want {
+		if members[i] != want[i] {
+			t.Fatalf("member %d: got %+v want %+v", i, members[i], want[i])
+		}
+	}
+}
+
+func TestUpdateMembersPersists(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","ivy":"viewer"}}`); code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	if got := roleOf(t, h, "web", "dan"); got != "contributor" {
+		t.Fatalf("dan: got %q want contributor", got)
+	}
+	if got := roleOf(t, h, "web", "ivy"); got != "viewer" {
+		t.Fatalf("ivy: got %q want viewer", got)
+	}
+}
+
+// A batch with one member that cannot change changes nothing.
+func TestUpdateMembersAllOrNothing(t *testing.T) {
+	bodies := []string{
+		`{"roles":{"dan":"contributor","hal":"viewer"}}`, // hal is not a member
+		`{"roles":{"dan":"contributor","ben":"viewer"}}`, // ben is assigned t1
+		`{"roles":{"dan":"contributor","ivy":"nope"}}`,   // invalid role
+	}
+	for _, body := range bodies {
+		h := newServer()
+		if code, _ := do(t, h, "PUT", "/projects/web/members", "ann", body); code != 400 {
+			t.Fatalf("%s: got %d want 400", body, code)
+		}
+		if got := roleOf(t, h, "web", "dan"); got != "viewer" {
+			t.Fatalf("%s: dan changed to %q", body, got)
+		}
+		if got := roleOf(t, h, "web", "ben"); got != "contributor" {
+			t.Fatalf("%s: ben changed to %q", body, got)
+		}
+	}
+}
+
+// Demoting an assignee is allowed once the member has no tasks in the project.
+func TestUpdateMembersDemoteAfterReassign(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "PATCH", "/projects/web/tasks/t1", "ann", `{"assignee":"cat"}`); code != 200 {
+		t.Fatalf("reassign: got %d: %s", code, body)
+	}
+	if code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer"}}`); code != 200 {
+		t.Fatalf("demote: got %d: %s", code, body)
+	}
+	if got := roleOf(t, h, "web", "ben"); got != "viewer" {
+		t.Fatalf("ben: got %q want viewer", got)
+	}
+}
