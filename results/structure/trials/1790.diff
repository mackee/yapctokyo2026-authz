 - Writes require the `contributor` or `manager` role in the project. Users who can read but not write get 403.
 - Contributors may only modify tasks assigned to themselves, and may not reassign tasks. Managers may modify any task.
 - Only managers may delete tasks.
+- Only managers may freeze a project (contributors and viewers get 403). Freezing sets every member's role to `viewer`, managers included, and clears the assignee of every task in the project. Afterwards nobody can change the project's tasks. A frozen project cannot be frozen again, because its former manager is now a viewer (403). There is no unfreeze endpoint.
 - Archived projects reject all writes with 409 (reads still work).
 - A task ID that does not belong to the project in the path → 404.
 
diff --git a/freeze_test.go b/freeze_test.go
new file mode 100644
index 0000000..ec913ce
--- /dev/null
+++ b/freeze_test.go
@@ -0,0 +1,141 @@
+package main
+
+import (
+	"encoding/json"
+	"reflect"
+	"testing"
+)
+
+type memberJSON struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+		{"missing project", "ann", "nope", 404},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResponseListsMembersAsViewers(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got []memberJSON
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("response is not a member list: %v: %s", err, body)
+	}
+	want := []memberJSON{
+		{"ann", "viewer"}, {"ben", "viewer"}, {"cat", "viewer"}, {"dan", "viewer"}, {"ivy", "viewer"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+}
+
+// After a freeze the former manager is a viewer, so a second freeze is refused
+// and the member list stays as the first freeze left it.
+func TestFreezeCannotBeRepeated(t *testing.T) {
+	s := newServer()
+	if code, _ := do(t, s, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("first freeze got %d want 200", code)
+	}
+	code, _ := do(t, s, "POST", "/projects/web/freeze", "ann", "")
+	if code != 403 {
+		t.Fatalf("second freeze got %d want 403", code)
+	}
+}
+
+func TestFailedFreezeChangesNothing(t *testing.T) {
+	s := newServer()
+	if code, _ := do(t, s, "POST", "/projects/web/freeze", "ben", ""); code != 403 {
+		t.Fatalf("contributor freeze got %d want 403", code)
+	}
+	if code, _ := do(t, s, "PATCH", "/projects/web/tasks/t2", "ann", `{"status":"done"}`); code != 200 {
+		t.Fatalf("manager write after failed freeze got %d want 200", code)
+	}
+}
+
+func TestFreezeBlocksAllTaskWrites(t *testing.T) {
+	s := newServer()
+	if code, _ := do(t, s, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze got %d want 200", code)
+	}
+	cases := []struct {
+		name, user, method, path, body string
+	}{
+		{"manager update", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"contributor own update", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"manager create", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"contributor create", "ben", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"manager delete", "ann", "DELETE", "/projects/web/tasks/t1", ""},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, s, c.method, c.path, c.user, c.body)
+			if code != 403 {
+				t.Fatalf("got %d want 403", code)
+			}
+		})
+	}
+	if code, _ := do(t, s, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("read after freeze got %d want 200", code)
+	}
+}
+
+func TestFreezeUnassignsProjectTasks(t *testing.T) {
+	s := newServer()
+	if code, _ := do(t, s, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze got %d want 200", code)
+	}
+	code, body := do(t, s, "GET", "/projects/web/tasks", "ann", "")
+	if code != 200 {
+		t.Fatalf("list got %d want 200", code)
+	}
+	var tasks []Task
+	if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+		t.Fatal(err)
+	}
+	if len(tasks) != 3 {
+		t.Fatalf("want 3 tasks, got %d", len(tasks))
+	}
+	for _, task := range tasks {
+		if task.Assignee != "" {
+			t.Fatalf("task %s still assigned to %q after freeze", task.ID, task.Assignee)
+		}
+	}
+}
+
+func TestFreezeLeavesOtherProjectsAlone(t *testing.T) {
+	s := newServer()
+	if code, _ := do(t, s, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze got %d want 200", code)
+	}
+	if code, _ := do(t, s, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`); code != 200 {
+		t.Fatalf("contributor write in ops got %d want 200", code)
+	}
+	if code, _ := do(t, s, "PATCH", "/projects/ops/tasks/t4", "ivy", `{"status":"open"}`); code != 200 {
+		t.Fatalf("manager write in ops got %d want 200", code)
+	}
+}
