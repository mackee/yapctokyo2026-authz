+// removeOrgUser takes a user out of every project of the organization (the
+// offboarding step). Only org admins of that organization may do it.
+func removeOrgUser(ctx tanukirpc.Context[*orgUserRegistry], _ struct{}) (*struct{}, error) {
+	m, err := ctx.Registry().scope.Manage()
+	if err != nil {
+		return nil, err
+	}
+	if err := m.Remove(); err != nil {
+		return nil, err
+	}
+	ctx.Response().WriteHeader(http.StatusNoContent)
+	return nil, nil
+}
