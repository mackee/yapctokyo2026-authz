+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes user without projects", "eve", "/orgs/acme/users/hal", 204},
+		{"org admin removes contributor of two projects", "eve", "/orgs/acme/users/cat", 204},
+		{"manager cannot", "ann", "/orgs/acme/users/ben", 403},
+		{"viewer cannot", "dan", "/orgs/acme/users/ben", 403},
+		{"other org admin", "gus", "/orgs/acme/users/ben", 404},
+		{"org not yours", "eve", "/orgs/globex/users/gus", 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed", 404},
+		{"user of other org", "eve", "/orgs/acme/users/gus", 404},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserTakesEffectInEveryProject(t *testing.T) {
+	h := newServer()
+
+	if code, body := do(t, h, "DELETE", "/orgs/acme/users/cat", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d: %s", code, body)
+	}
+
+	// cat was a contributor in web and ops; both memberships are gone.
+	for _, path := range []string{"/projects/web/tasks", "/projects/ops/tasks"} {
+		if code, _ := do(t, h, "GET", path, "cat", ""); code != 404 {
+			t.Fatalf("cat GET %s: got %d want 404", path, code)
+		}
+	}
+	// cat can no longer be assigned anywhere.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ann", `{"title":"x","assignee":"cat"}`); code != 400 {
+		t.Fatalf("assign removed user: got %d want 400", code)
+	}
+
+	// Tasks cat held are unassigned; other tasks are untouched.
+	assignee := func(path string) string {
+		t.Helper()
+		code, body := do(t, h, "GET", path, "eve", "")
+		if code != 200 {
+			t.Fatalf("GET %s: got %d", path, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		return task.Assignee
+	}
+	if got := assignee("/projects/web/tasks/t2"); got != "" {
+		t.Fatalf("web t2 assignee = %q, want unassigned", got)
+	}
+	if got := assignee("/projects/ops/tasks/t4"); got != "" {
+		t.Fatalf("ops t4 assignee = %q, want unassigned", got)
+	}
+	if got := assignee("/projects/web/tasks/t1"); got != "ben" {
+		t.Fatalf("web t1 assignee = %q, want ben", got)
+	}
+
+	// Other members keep their access.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben lost access to web: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "ivy", ""); code != 200 {
+		t.Fatalf("ivy lost access to ops: %d", code)
+	}
+}
