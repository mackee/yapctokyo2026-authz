+
+// ---- org capabilities -----------------------------------------------------------
+
+// OrgScope is bound to one actor and one organization ID.
+type OrgScope interface {
+	User(userID string) OrgUserScope
+}
+
+// OrgUserScope is bound to one actor, one organization ID and one user ID.
+type OrgUserScope interface {
+	Manage() (ManageOrgUser, error)
+}
+
+// ManageOrgUser is the org-admin capability for one user of one organization.
+type ManageOrgUser interface {
+	// Remove takes the user out of every project of the organization. Tasks the
+	// user was assigned to in those projects become unassigned. The user record
+	// itself is kept.
+	Remove() error
+}
+
+type orgScope struct {
+	as  *actorScope
+	oid string
+}
+
+func (s *orgScope) User(userID string) OrgUserScope {
+	return &orgUserScope{os: s, uid: userID}
+}
+
+type orgUserScope struct {
+	os  *orgScope
+	uid string
+}
+
+// Manage applies the org rule: the organization must be the actor's own (else
+// 404), and the actor must be an org admin (else 403).
+func (s *orgUserScope) Manage() (ManageOrgUser, error) {
+	act := s.os.as.actor
+	if act.org != s.os.oid {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if !act.orgAdmin {
+		return nil, deny(ErrForbidden, "forbidden")
+	}
+	return &manageOrgUser{s: s}, nil
+}
+
+type manageOrgUser struct{ s *orgUserScope }
+
+func (m *manageOrgUser) Remove() error {
+	return m.s.os.as.a.db.update(func(x *tx) error {
+		agg, err := loadRemoveOrgUser(x, m.s.os.oid, m.s.uid)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		agg.save(x)
+		return nil
+	})
+}
