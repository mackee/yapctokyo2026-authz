 type manageTask struct{ editTask }
 
+// Move moves the task to another project, keeping its ID, title, status and
+// assignee. dest must be a WriteProject of the same actor, so the actor needs
+// the write rule in the destination too. If the assignee is not a contributor
+// or manager of the destination, the invariant check rejects the move (400)
+// and nothing changes.
+func (t *manageTask) Move(dest WriteProject) (TaskView, error) {
+	wp, ok := dest.(*writeProject)
+	if !ok || wp.ps.as != t.ts.ps.as {
+		return TaskView{}, deny(ErrForbidden, "forbidden")
+	}
+	if wp.ps.pid == t.ts.ps.pid {
+		return TaskView{}, deny(ErrInvalid, "task is already in that project")
+	}
+	var v TaskView
+	err := t.ts.ps.as.a.st.tx(func(s *state) error {
+		cur := s.tasks[t.ts.tid]
+		cur.project = wp.ps.pid
+		cur.assignee = Assignee{project: wp.ps.pid, user: cur.assignee.user}
+		s.tasks[cur.id] = cur
+		v = cur.view()
+		return nil
+	})
+	return v, err
+}
