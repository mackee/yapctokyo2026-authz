+func moveTask(ctx tanukirpc.Context[*taskRegistry], _ struct{}) (*Task, error) {
+	t, err := ctx.Registry().scope.Manage()
+	if err != nil {
+		return nil, err
+	}
+	var req moveRequest
+	if err := decodeBody(ctx.Request(), &req); err != nil || req.ToProjectID == "" {
+		return nil, errInvalidBody
+	}
+	dest, err := ctx.Registry().project.Actor().Project(req.ToProjectID).Write()
+	if err != nil {
+		return nil, err
+	}
+	v, err := t.Move(dest)
+	if err != nil {
+		return nil, err
+	}
+	return &v, nil
+}
