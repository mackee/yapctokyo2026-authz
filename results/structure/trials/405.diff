+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager moves unassigned", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 200},
+		{"manager moves assigned contributor", "ivy", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 200},
+		{"contributor source", "ben", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"viewer source", "dan", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"org admin source", "eve", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 403},
+		{"non member source", "hal", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 404},
+		{"cross project id", "ann", "/projects/web/tasks/t4", `{"toProjectId":"ops"}`, 404},
+		{"cross org", "gus", "/projects/web/tasks/t3", `{"toProjectId":"gx"}`, 404},
+		{"archived source", "ann", "/projects/legacy/tasks/t5", `{"toProjectId":"web"}`, 409},
+		{"destination missing", "ann", "/projects/web/tasks/t3", `{"toProjectId":"zzz"}`, 404},
+		{"destination other org", "ann", "/projects/web/tasks/t3", `{"toProjectId":"gx"}`, 404},
+		{"destination viewer", "ann", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 403},
+		{"destination archived", "ann", "/projects/web/tasks/t3", `{"toProjectId":"legacy"}`, 409},
+		{"same project", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"web"}`, 400},
+		{"assignee not in destination", "ivy", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 400},
+		{"missing destination", "ann", "/projects/web/tasks/t3", `{}`, 400},
+		{"empty destination", "ann", "/projects/web/tasks/t3", `{"toProjectId":""}`, 400},
+		{"anonymous", "", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsFieldsAndChangesProject(t *testing.T) {
+	srv := newServer()
+	code, body := do(t, srv, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d body %s", code, body)
+	}
+	var got Task
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", AssigneeID: "cat"}
+	if got != want {
+		t.Fatalf("moved task = %+v, want %+v", got, want)
+	}
+
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks/t2", "ann", ""); code != 404 {
+		t.Fatalf("old project still serves the task: got %d", code)
+	}
+	code, body = do(t, srv, "GET", "/projects/ops/tasks/t2", "ivy", "")
+	if code != 200 {
+		t.Fatalf("new project: got %d", code)
+	}
+	var fetched Task
+	json.Unmarshal([]byte(body), &fetched)
+	if fetched != want {
+		t.Fatalf("fetched task = %+v, want %+v", fetched, want)
+	}
+
+	var tasks []Task
+	_, body = do(t, srv, "GET", "/projects/web/tasks", "ann", "")
+	json.Unmarshal([]byte(body), &tasks)
+	if len(tasks) != 2 {
+		t.Fatalf("web should have 2 tasks left, got %d", len(tasks))
+	}
+}
+
+func TestMoveFailureChangesNothing(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks/t1/move", "ivy", `{"toProjectId":"ops"}`); code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	code, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("task should still be in web: got %d", code)
+	}
+	var got Task
+	json.Unmarshal([]byte(body), &got)
+	if got.ProjectID != "web" || got.AssigneeID != "ben" {
+		t.Fatalf("task changed after failed move: %+v", got)
+	}
+}
