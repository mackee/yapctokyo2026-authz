+// moveTaskAggregate moves one task into another project.
+type moveTaskAggregate struct {
+	task     *Task
+	dest     ProjectAuthz // the actor's authorization in the destination project
+	assignee *Membership  // the assignee's membership in the destination; nil if none
+}
+
+func loadMoveTask(ctx context.Context, x *Tx, act Actor, taskID, toProjectID string) (*moveTaskAggregate, error) {
+	t, err := NewTaskTable().Find(ctx, x, taskID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	dest, err := NewProjectAuthz(ctx, x, act, toProjectID)
+	if err != nil {
+		return nil, err
+	}
+	a := &moveTaskAggregate{task: t, dest: dest}
+	if t.AssigneeID != "" {
+		m, err := NewMembershipTable().Find(ctx, x, toProjectID, t.AssigneeID)
+		if err != nil && !errors.Is(err, ErrNoRows) {
+			return nil, err
+		}
+		a.assignee = m // nil when the assignee is not a member of the destination
+	}
+	return a, nil
+}
+
+func (a *moveTaskAggregate) validate() error {
+	if a.dest.ProjectID() == a.task.ProjectID {
+		return deny(ErrInvalid, "task is already in that project")
+	}
+	if err := a.dest.CanMoveIn(); err != nil {
+		return err
+	}
+	if a.task.AssigneeID != "" && (a.assignee == nil || !isWriterRole(a.assignee.Role)) {
+		return deny(ErrInvalid, "assignee must be a contributor or manager of the destination project")
+	}
+	return nil
+}
+
+func (a *moveTaskAggregate) apply(ctx context.Context, x *Tx) (*Task, error) {
+	if err := a.task.moveTo(ctx, x, a.dest.ProjectID()); err != nil {
+		return nil, err
+	}
+	return a.task, nil
+}
+
