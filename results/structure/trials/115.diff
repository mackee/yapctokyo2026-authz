+func TestSetMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager promotes viewer", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"manager promotes manager", "ann", "/projects/web/members/ivy", `{"role":"contributor"}`, 200},
+		{"manager demotes self", "ann", "/projects/web/members/ann", `{"role":"viewer"}`, 200},
+		{"demote assignee", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 400},
+		{"contributor cannot change roles", "ben", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"viewer cannot change roles", "dan", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"org admin cannot change roles", "eve", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"non member", "hal", "/projects/web/members/dan", `{"role":"contributor"}`, 404},
+		{"other org", "gus", "/projects/web/members/dan", `{"role":"contributor"}`, 404},
+		{"anonymous", "", "/projects/web/members/dan", `{"role":"contributor"}`, 401},
+		{"unknown project", "ann", "/projects/nope/members/dan", `{"role":"contributor"}`, 404},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"contributor"}`, 404},
+		{"target unknown user", "ann", "/projects/web/members/zed", `{"role":"contributor"}`, 404},
+		{"target in other org", "ann", "/projects/web/members/gus", `{"role":"viewer"}`, 404},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"unknown role", "ann", "/projects/web/members/dan", `{"role":"owner"}`, 400},
+		{"missing role", "ann", "/projects/web/members/dan", `{}`, 400},
+		{"malformed body", "ann", "/projects/web/members/dan", `nope`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMemberRoleResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.UserID != "dan" || got.Role != "contributor" {
+		t.Fatalf("got %+v", got)
+	}
+}
+
+func TestSetMemberRoleTakesEffect(t *testing.T) {
+	srv := newServer()
+
+	// dan starts as a viewer and cannot create tasks.
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 403 {
+		t.Fatalf("viewer create: got %d want 403", code)
+	}
+	if code, _ := do(t, srv, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`); code != 200 {
+		t.Fatalf("promote: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 201 {
+		t.Fatalf("contributor create: got %d want 201", code)
+	}
+	if code, _ := do(t, srv, "PUT", "/projects/web/members/dan", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"y"}`); code != 403 {
+		t.Fatalf("demoted create: got %d want 403", code)
+	}
+}
+
+func TestFailedDemotionChangesNothing(t *testing.T) {
+	srv := newServer()
+
+	// ben is assigned t1, so demoting him is rejected and his role stays.
+	if code, _ := do(t, srv, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 400 {
+		t.Fatalf("demote assignee: got %d want 400", code)
+	}
+	if code, _ := do(t, srv, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ben edits own task after rejected demotion: got %d want 200", code)
+	}
+}
