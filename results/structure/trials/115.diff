+func (p *manageProject) SetRole(userID, role string) (MemberView, error) {
+	if !isKnownRole(role) {
+		return MemberView{}, deny(ErrInvalid, "invalid role")
+	}
+	var v MemberView
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		if _, ok := s.members[p.ps.pid][userID]; !ok {
+			return deny(ErrNotFound, "not found")
+		}
+		// tx works on a deep copy of members, so this write is not visible
+		// unless the whole transaction commits.
+		s.members[p.ps.pid][userID] = role
+		v = MemberView{UserID: userID, Role: role}
+		return nil
+	})
+	return v, err
+}
