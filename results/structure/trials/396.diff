index 0000000..773891e
--- /dev/null
+++ b/main_move_test.go
@@ -0,0 +1,98 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+
+	"taskboard/internal/capability"
+)
+
+func TestMoveAccess(t *testing.T) {
+	const toOps = `{"toProjectId":"ops"}`
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager of both moves", "ivy", "/projects/web/members/ben/move", toOps, 200},
+		{"contributor", "ben", "/projects/web/members/cat/move", toOps, 403},
+		{"viewer", "dan", "/projects/web/members/ben/move", toOps, 403},
+		{"org admin", "eve", "/projects/web/members/ben/move", toOps, 403},
+		{"non member", "hal", "/projects/web/members/ben/move", toOps, 404},
+		{"other org", "gus", "/projects/web/members/ben/move", toOps, 404},
+		{"anonymous", "", "/projects/web/members/ben/move", toOps, 401},
+		{"manager of source only", "ann", "/projects/web/members/ben/move", toOps, 403},
+		{"destination missing", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"nope"}`, 404},
+		{"destination other org", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"gx"}`, 404},
+		{"destination is source", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"web"}`, 400},
+		{"destination archived", "ann", "/projects/web/members/ben/move", `{"toProjectId":"legacy"}`, 409},
+		{"source archived", "ann", "/projects/legacy/members/ben/move", `{"toProjectId":"web"}`, 409},
+		{"user not in source", "ivy", "/projects/web/members/hal/move", toOps, 404},
+		{"user already in destination", "ivy", "/projects/web/members/cat/move", toOps, 400},
+		{"empty destination", "ivy", "/projects/web/members/ben/move", `{}`, 400},
+		{"bad body", "ivy", "/projects/web/members/ben/move", `not json`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveEffects(t *testing.T) {
+	h := newServer()
+
+	code, body := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d: %s", code, body)
+	}
+	var got capability.MemberView
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := capability.MemberView{UserID: "ben", ProjectID: "ops", Role: "contributor"}
+	if got != want {
+		t.Fatalf("response: got %+v want %+v", got, want)
+	}
+
+	// ben left web: no longer readable there.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben in web after move: got %d want 404", code)
+	}
+	// ben joined ops with the same role: can read and write there.
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben in ops after move: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/ops/tasks", "ben", `{"title":"x"}`); code != 201 {
+		t.Fatalf("ben create in ops: got %d want 201", code)
+	}
+
+	// t1 was ben's task in web; it is unassigned now, and still in web.
+	code, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("get t1: got %d", code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.Assignee != "" || task.ProjectID != "web" {
+		t.Fatalf("t1 after move: got assignee %q project %q", task.Assignee, task.ProjectID)
+	}
+}
+
+func TestMoveKeepsRole(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/members/dan/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got capability.MemberView
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.Role != "viewer" || got.ProjectID != "ops" {
+		t.Fatalf("got %+v want viewer in ops", got)
+	}
+}
