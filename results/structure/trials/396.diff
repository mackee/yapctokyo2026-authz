+type moveRequest struct {
+	ToProjectID string `json:"toProjectId"`
+}
+
+// moveMember moves {uid} from {pid} to toProjectId. The caller must manage both
+// projects. Acquiring the source first means access errors on it take
+// precedence over body errors.
+func moveMember(ctx tanukirpc.Context[*projectRegistry], _ struct{}) (*capability.MemberView, error) {
+	from, err := ctx.Registry().scope.Manage()
+	if err != nil {
+		return nil, err
+	}
+	var req moveRequest
+	if err := decodeBody(ctx.Request(), &req); err != nil || req.ToProjectID == "" {
+		return nil, errInvalidBody
+	}
+	to, err := ctx.Registry().scope.Actor().Project(req.ToProjectID).Manage()
+	if err != nil {
+		return nil, err
+	}
+	v, err := from.MoveMember(chi.URLParam(ctx.Request(), "uid"), to)
+	if err != nil {
+		return nil, err
+	}
+	return &v, nil
+}
