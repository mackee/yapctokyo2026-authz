 }
 
+// ManageProject may change the membership of one project. Only managers may.
+type ManageProject interface {
+	ReadProject
+	// MoveMember moves a member of this project into the destination project,
+	// keeping their role. The destination must be a ManageProject too, so the
+	// caller must manage both projects. The member's tasks in this project are
+	// unassigned. Errors: 404 if userID is not a member here, 400 if the
+	// destination is this project or the user is already in it.
+	MoveMember(userID string, to ManageProject) (MemberView, error)
+}
+
+type manageProject struct{ readProject }
+
+func (p *manageProject) MoveMember(userID string, to ManageProject) (MemberView, error) {
+	dst, ok := to.(*manageProject)
+	if !ok {
+		return MemberView{}, deny(ErrInvalid, "destination is not a managed project")
+	}
+	if dst.ps.pid == p.ps.pid {
+		return MemberView{}, deny(ErrInvalid, "destination must be another project")
+	}
+	var v MemberView
+	err := p.ps.as.a.db.update(func(x *tx) error {
+		agg, err := loadMoveMember(x, p.ps.pid, dst.ps.pid, userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		v = agg.apply(x)
+		return nil
+	})
+	return v, err
+}
+
