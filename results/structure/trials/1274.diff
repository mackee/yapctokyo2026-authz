+// moveToOrg removes the user's memberships and unassigns their tasks, then moves
+// the user to another organization as a plain member.
+func (r *User) moveToOrg(ctx context.Context, db DB, orgID string) error {
+	if _, err := db.ExecContext(ctx, `DELETE FROM memberships WHERE user_id = ?`, r.ID); err != nil {
+		return err
+	}
+	if _, err := db.ExecContext(ctx, `UPDATE tasks SET assignee = '' WHERE assignee = ?`, r.ID); err != nil {
+		return err
+	}
+	r.Org = orgID
+	r.OrgAdmin = false
+	return r.save(ctx, db)
+}
