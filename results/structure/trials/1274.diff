+// transferUserAggregate moves one user to another organization.
+type transferUserAggregate struct {
+	user    *User
+	toOrgID string
+	toExist bool
+}
+
+func loadTransferUser(ctx context.Context, tx DB, fromOrgID string, in UserTableTransferInput) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, in.UserID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != fromOrgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	exists, err := NewUserTable().OrgExists(ctx, tx, in.ToOrgID)
+	if err != nil {
+		return nil, err
+	}
+	return &transferUserAggregate{user: u, toOrgID: in.ToOrgID, toExist: exists}, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if a.toOrgID == "" || !a.toExist {
+		return deny(ErrInvalid, "destination organization does not exist")
+	}
+	if a.toOrgID == a.user.Org {
+		return deny(ErrInvalid, "user already belongs to the organization")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	if err := a.user.moveToOrg(ctx, tx, a.toOrgID); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
