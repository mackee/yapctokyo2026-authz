+
+// RemoveFromOrg removes the user from every project of the organization
+// (the user's memberships in those projects), unassigning the user's tasks in
+// them. Archived projects are included. Removing a user who has no
+// memberships is a no-op. The user must belong to the organization, else
+// ErrNotFound.
+func (*UserTable) RemoveFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanManageMembers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveFromOrg(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
