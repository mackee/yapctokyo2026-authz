+// removeFromOrgAggregate removes one user from the projects of one
+// organization. It unassigns the user's tasks in those projects, so no task is
+// left assigned to a non-member.
+type removeFromOrgAggregate struct {
+	user        *User
+	memberships []*Membership // the user's memberships in projects of the org
+	assigned    []*Task       // tasks of those projects assigned to the user
+}
+
+func loadRemoveFromOrg(ctx context.Context, tx DB, orgID, userID string) (*removeFromOrgAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != orgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	a := &removeFromOrgAggregate{user: u}
+	for _, m := range ms {
+		p, err := m.Project(ctx, tx)
+		if errors.Is(err, ErrNoRows) {
+			continue
+		} else if err != nil {
+			return nil, err
+		}
+		if p.Org != orgID {
+			continue
+		}
+		ts, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.memberships = append(a.memberships, m)
+		a.assigned = append(a.assigned, ts...)
+	}
+	return a, nil
+}
+
+func (a *removeFromOrgAggregate) validate() error { return nil }
+
+func (a *removeFromOrgAggregate) apply(ctx context.Context, tx DB) error {
+	for _, t := range a.assigned {
+		if err := t.unassign(ctx, tx); err != nil {
+			return err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
