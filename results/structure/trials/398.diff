@@ -118,3 +118,64 @@ func loadDeleteTask(x *tx, taskID string) (*deleteTaskAggregate, error) {
 func (a *deleteTaskAggregate) validate() error { return nil }
 
 func (a *deleteTaskAggregate) apply(x *tx) { a.task.Destroy(x) }
+
+// moveMemberAggregate moves one membership from one project to another. The
+// user leaves the source project and joins the target with the same role.
+type moveMemberAggregate struct {
+	from      projectRecord
+	member    membershipRecord // the membership in the source project
+	to        projectRecord
+	user      userRecord
+	alreadyIn bool         // the user is already a member of the target project
+	assigned  []taskRecord // the member's tasks in the source project
+}
+
+func loadMoveMember(x *tx, fromID, userID, toID string) (*moveMemberAggregate, error) {
+	from, ok := x.findProject(fromID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	m, ok := from.Membership(x, userID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	to, ok := x.findProject(toID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	u, ok := m.User(x)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	_, alreadyIn := to.Membership(x, userID)
+	return &moveMemberAggregate{
+		from:      from,
+		member:    m,
+		to:        to,
+		user:      u,
+		alreadyIn: alreadyIn,
+		assigned:  m.AssignedTasks(x),
+	}, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.to.Org != a.user.Org {
+		return deny(ErrInvalid, "project members must belong to the project's organization")
+	}
+	if a.alreadyIn {
+		return deny(ErrInvalid, "user is already a member of the target project")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(x *tx) MemberView {
+	// An assignee must be a member of the task's project, so the member's
+	// tasks in the source project are released.
+	for _, t := range a.assigned {
+		t.Unassign(x)
+	}
+	a.member.Destroy(x)
+	moved := membershipRecord{ProjectID: a.to.ID, UserID: a.member.UserID, Role: a.member.Role}
+	moved.save(x)
+	return MemberView{UserID: moved.UserID, ProjectID: moved.ProjectID, Role: moved.Role}
+}
