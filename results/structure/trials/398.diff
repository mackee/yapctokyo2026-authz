+}
+
+func TestMoveMemberEffects(t *testing.T) {
+	srv := newServer()
+
+	// ben holds t1 in web; moving ben releases it.
+	if code, body := do(t, srv, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`); code != 200 {
+		t.Fatalf("move: got %d: %s", code, body)
+	}
+
+	// ben is no longer a member of web, and is now a member of ops.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads web after move: got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben reads ops after move: got %d want 200", code)
+	}
+
+	// The task that ben held in web is unassigned, and the other task is untouched.
+	code, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("get t1: got %d", code)
+	}
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" {
+		t.Fatalf("t1 still assigned to %q", task.Assignee)
+	}
+	code, body = do(t, srv, "GET", "/projects/web/tasks/t2", "ann", "")
+	json.Unmarshal([]byte(body), &task)
+	if code != 200 || task.Assignee != "cat" {
+		t.Fatalf("t2 changed: code %d assignee %q", code, task.Assignee)
+	}
+
+	// ben can now be assigned in ops, but not in web.
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "ann", `{"title":"x","assignee":"ben"}`); code != 400 {
+		t.Fatalf("assign ben in web: got %d want 400", code)
+	}
+	if code, _ := do(t, srv, "POST", "/projects/ops/tasks", "ivy", `{"title":"x","assignee":"ben"}`); code != 201 {
+		t.Fatalf("assign ben in ops: got %d want 201", code)
+	}
+
+	// A second move of the same user from web is now a not-found.
+	if code, _ := do(t, srv, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`); code != 404 {
+		t.Fatalf("repeat move: got %d want 404", code)
+	}
+}
