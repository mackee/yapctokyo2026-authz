+
+// ---- member capabilities -------------------------------------------------------
+
+// MemberView is the public representation of a project membership.
+type MemberView struct {
+	UserID    string `json:"userId"`
+	ProjectID string `json:"projectId"`
+	Role      string `json:"role"`
+}
+
+// MemberScope is bound to one actor, one project ID and one user ID.
+type MemberScope interface {
+	Manage() (ManageMember, error)
+}
+
+// ManageMember may move one member out of its project. It requires the manager
+// role in both the source and the target project.
+type ManageMember interface {
+	// MoveTo moves the member to another project of the same organization and
+	// keeps the role. Tasks the member holds in the source project are unassigned.
+	MoveTo(toProjectID string) (MemberView, error)
+}
+
+// requireManager applies the manager rule to the project: readable (else 404),
+// manager role (else 403), not archived (else 409).
+func (s *projectScope) requireManager(x *tx) (projectRecord, error) {
+	p, r, err := readable(x, s.as.actor, s.pid)
+	if err != nil {
+		return projectRecord{}, err
+	}
+	if r != RoleManager {
+		return projectRecord{}, deny(ErrForbidden, "forbidden")
+	}
+	if p.Archived {
+		return projectRecord{}, deny(ErrArchived, "project is archived")
+	}
+	return p, nil
+}
+
+type memberScope struct {
+	ps  *projectScope
+	uid string
+}
+
+func (s *memberScope) Manage() (ManageMember, error) {
+	err := s.ps.as.a.db.view(func(x *tx) error {
+		if _, err := s.ps.requireManager(x); err != nil {
+			return err
+		}
+		if _, ok := x.findMembership(s.ps.pid, s.uid); !ok {
+			return deny(ErrNotFound, "not found")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &manageMember{ms: s}, nil
+}
+
+type manageMember struct{ ms *memberScope }
+
+func (m *manageMember) MoveTo(toProjectID string) (MemberView, error) {
+	if toProjectID == "" {
+		return MemberView{}, deny(ErrInvalid, "toProjectId is required")
+	}
+	if toProjectID == m.ms.ps.pid {
+		return MemberView{}, deny(ErrInvalid, "member is already in this project")
+	}
+	to := &projectScope{as: m.ms.ps.as, pid: toProjectID}
+	err := to.as.a.db.view(func(x *tx) error {
+		_, err := to.requireManager(x)
+		return err
+	})
+	if err != nil {
+		return MemberView{}, err
+	}
+	var v MemberView
+	err = m.ms.ps.as.a.db.update(func(x *tx) error {
+		agg, err := loadMoveMember(x, m.ms.ps.pid, m.ms.uid, toProjectID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		v = agg.apply(x)
+		return nil
+	})
+	return v, err
+}
