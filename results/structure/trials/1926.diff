+// Move moves the user from the project of src to the project of dst, keeping
+// the role, and returns the new membership. The actor must be a manager of both
+// projects, neither archived. Tasks assigned to the user in the source project
+// are unassigned.
+func (*MembershipTable) Move(ctx context.Context, db DB, src, dst ProjectAuthz, userID string) (*Membership, error) {
+	if err := src.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if err := dst.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var moved *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveMember(ctx, tx, src.ProjectID(), userID, dst.ProjectID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if moved, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return moved, nil
+}
