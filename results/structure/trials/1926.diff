+type moveMemberRequest struct {
+	ToProjectID string `json:"toProjectId" validate:"required"`
+}
+
+type moveMemberResponse struct {
+	UserID    string `json:"userId"`
+	ProjectID string `json:"projectId"`
+	Role      string `json:"role"`
+}
+
+func moveMember(ctx tanukirpc.Context[*projectRegistry], req moveMemberRequest) (*moveMemberResponse, error) {
+	reg := ctx.Registry()
+	// Check the source first, so a caller who may not manage members learns
+	// nothing about the destination.
+	if err := reg.authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	// The destination must be readable by the actor, like any project (404 otherwise).
+	dst, err := model.NewProjectAuthz(ctx, reg.db, reg.authz.Actor(), req.ToProjectID)
+	if err != nil {
+		return nil, err
+	}
+	m, err := model.NewMembershipTable().Move(ctx, reg.db, reg.authz, dst, chi.URLParam(ctx.Request(), "uid"))
+	if err != nil {
+		return nil, err
+	}
+	return &moveMemberResponse{UserID: m.UserID, ProjectID: m.ProjectID, Role: m.Role}, nil
+}
