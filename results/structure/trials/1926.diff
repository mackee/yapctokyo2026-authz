+// moveMemberAggregate moves one member from one project to another, keeping
+// the role. Tasks assigned to the member in the source project are unassigned,
+// because the member stops being a contributor or manager there.
+type moveMemberAggregate struct {
+	membership *Membership // the member's membership in the source project
+	user       *User
+	dst        *Project
+	tasks      []*Task // tasks of the source project assigned to the member
+}
+
+func loadMoveMember(ctx context.Context, tx DB, srcID, userID, dstID string) (*moveMemberAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, srcID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	dst, err := NewProjectTable().Find(ctx, tx, dstID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	u, err := m.User(ctx, tx)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "member must be an existing user")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveMemberAggregate{membership: m, user: u, dst: dst}
+	if _, err := dst.Membership(ctx, tx, userID); err == nil {
+		return nil, deny(ErrInvalid, "user is already a member of the destination project")
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	if a.tasks, err = m.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.membership.ProjectID == a.dst.ID {
+		return deny(ErrInvalid, "destination must be a different project")
+	}
+	if a.user.Org != a.dst.Org {
+		return deny(ErrInvalid, "member must belong to the destination project's organization")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.membership.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	moved := a.dst.newMembership(a.membership.UserID, a.membership.Role)
+	if err := moved.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return moved, nil
+}
