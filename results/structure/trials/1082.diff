-// MembershipTable reads the memberships table.
+// MembershipTable is the memberships table.
+//
+// Find and List* read rows. Move is the API operation: it takes the source
+// project's authorization object and moves one member to another project.
 type MembershipTable struct{}
 
 // NewMembershipTable returns the memberships table.
 func NewMembershipTable() *MembershipTable { return &MembershipTable{} }
 
+// Move moves the member userID from the project of from to the project
+// toProjectID, keeping the role. The actor must be a manager of both projects,
+// and the destination must be readable by the actor (else ErrNotFound). The
+// member's tasks in the source project are unassigned, so no task is left
+// assigned to someone who is no longer a member. All or nothing.
+func (*MembershipTable) Move(ctx context.Context, db DB, from ProjectAuthz, userID, toProjectID string) (*Membership, error) {
+	if toProjectID == from.ProjectID() {
+		return nil, deny(ErrInvalid, "destination must be a different project")
+	}
+	if err := from.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	to, err := NewProjectAuthz(ctx, db, from.Actor(), toProjectID)
+	if err != nil {
+		return nil, err
+	}
+	if err := to.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveMember(ctx, tx, from.ProjectID(), toProjectID, userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		m, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
+
 // Find returns the membership of the user in the project, or ErrNoRows.
