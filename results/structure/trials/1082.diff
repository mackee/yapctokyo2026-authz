+// moveMemberAggregate moves one member from one project to another.
+type moveMemberAggregate struct {
+	from          *Membership // the member in the source project
+	toProjectID   string
+	alreadyInTo   bool    // the user is already a member of the destination
+	assignedTasks []*Task // the member's tasks in the source project, unassigned by the move
+}
+
+func loadMoveMember(ctx context.Context, tx DB, fromProjectID, toProjectID, userID string) (*moveMemberAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, fromProjectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveMemberAggregate{from: m, toProjectID: toProjectID}
+	if _, err := NewMembershipTable().Find(ctx, tx, toProjectID, userID); err == nil {
+		a.alreadyInTo = true
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	if a.assignedTasks, err = m.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.alreadyInTo {
+		return deny(ErrConflict, "user is already a member of the destination project")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	for _, t := range a.assignedTasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.from.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	to := &Membership{ProjectID: a.toProjectID, UserID: a.from.UserID, Role: a.from.Role}
+	if err := to.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return to, nil
+}
+
