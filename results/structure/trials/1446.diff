+// moveMemberAggregate moves one member from one project to another, keeping the
+// role. The tasks of the source project assigned to the member are unassigned,
+// since the member is no longer a contributor or manager of that project.
+type moveMemberAggregate struct {
+	membership *Membership // the member's membership in the source project
+	dest       *Project
+	user       *User
+	existing   *Membership // the member's membership in dest; nil if none
+	tasks      []*Task     // tasks of the source project assigned to the member
+}
+
+// loadMoveMember loads the member's membership in the source project; a
+// missing membership is ErrNotFound.
+func loadMoveMember(ctx context.Context, tx DB, projectID, userID string) (*Membership, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	return m, nil
+}
+
+// loadMoveDest loads the rest of the aggregate once the destination is known.
+func loadMoveDest(ctx context.Context, tx DB, m *Membership, destID string) (*moveMemberAggregate, error) {
+	dest, err := NewProjectTable().Find(ctx, tx, destID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	u, err := m.User(ctx, tx)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "member must be an existing user")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveMemberAggregate{membership: m, dest: dest, user: u}
+	if e, err := dest.Membership(ctx, tx, u.ID); err == nil {
+		a.existing = e
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	if a.tasks, err = m.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.dest.ID == a.membership.ProjectID {
+		return deny(ErrInvalid, "destination must be a different project")
+	}
+	if a.user.Org != a.dest.Org {
+		return deny(ErrInvalid, "member must belong to the organization of the destination project")
+	}
+	if a.existing != nil {
+		return deny(ErrConflict, "user is already a member of the destination project")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.membership.moveTo(ctx, tx, a.dest); err != nil {
+		return nil, err
+	}
+	return a.membership, nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
