new file mode 100644
index 0000000..b047eb0
--- /dev/null
+++ b/move_test.go
@@ -0,0 +1,116 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+// The cases mirror moveOutcome in spec/taskboard.qnt.
+func TestMoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, project, member, body string
+		want                              int
+	}{
+		{"manager moves", "ivy", "web", "ben", `{"toProjectId":"ops"}`, 200},
+		{"viewer moves", "ivy", "web", "dan", `{"toProjectId":"ops"}`, 200},
+		{"anonymous", "", "web", "ben", `{"toProjectId":"ops"}`, 401},
+		{"unknown user", "nobody", "web", "ben", `{"toProjectId":"ops"}`, 401},
+		{"non member caller", "hal", "web", "ben", `{"toProjectId":"ops"}`, 404},
+		{"contributor caller", "ben", "web", "cat", `{"toProjectId":"ops"}`, 403},
+		{"org admin caller", "eve", "web", "ben", `{"toProjectId":"ops"}`, 403},
+		{"member not in source", "ivy", "web", "hal", `{"toProjectId":"ops"}`, 404},
+		{"missing destination", "ivy", "web", "ben", `{"toProjectId":"missing"}`, 404},
+		{"other org destination", "ivy", "web", "ben", `{"toProjectId":"gx"}`, 404},
+		{"not manager of destination", "ann", "web", "ben", `{"toProjectId":"ops"}`, 403},
+		{"archived destination", "ann", "web", "ben", `{"toProjectId":"legacy"}`, 409},
+		{"archived source", "ann", "legacy", "ben", `{"toProjectId":"web"}`, 409},
+		{"same project", "ivy", "web", "ivy", `{"toProjectId":"web"}`, 400},
+		{"already a member", "ivy", "web", "cat", `{"toProjectId":"ops"}`, 409},
+		{"missing body field", "ivy", "web", "ben", `{}`, 400},
+		{"bad json", "ivy", "web", "ben", `{`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", "/projects/"+c.project+"/members/"+c.member+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestMoveMemberEffects(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]string{"userId": "ben", "projectId": "ops", "role": "contributor"}
+	if len(got) != len(want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	for k, v := range want {
+		if got[k] != v {
+			t.Fatalf("got %v want %v", got, want)
+		}
+	}
+
+	// ben left web: he can no longer read it, and joined ops as a contributor
+	// (he may now modify a task of his in ops, but not in web).
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben should not read web, got %d", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/ops/tasks", "ben", `{"title":"x","assignee":"ben"}`); code != 200 {
+		t.Fatalf("ben should write in ops, got %d", code)
+	}
+	// His web task t1 is unassigned (the model rule: an assignee is a writer of the project).
+	code, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d", code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "" {
+		t.Fatalf("t1 should be unassigned, got %q", task.AssigneeID)
+	}
+	// His task in another project (legacy t5) is untouched.
+	code, body = do(t, h, "GET", "/projects/legacy/tasks/t5", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d", code)
+	}
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "ben" {
+		t.Fatalf("t5 should stay with ben, got %q", task.AssigneeID)
+	}
+	// Moving again from web fails: he is no longer a member there.
+	if code, _ := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`); code != 404 {
+		t.Fatalf("got %d want 404", code)
+	}
+}
+
+// A rejected move changes nothing.
+func TestMoveMemberRejectedChangesNothing(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/members/cat/move", "ivy", `{"toProjectId":"ops"}`); code != 409 {
+		t.Fatalf("got %d want 409", code)
+	}
+	code, body := do(t, h, "GET", "/projects/web/tasks/t2", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d", code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "cat" {
+		t.Fatalf("t2 should stay with cat, got %q", task.AssigneeID)
+	}
+}
