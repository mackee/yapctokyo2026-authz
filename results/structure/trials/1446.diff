@@ -0,0 +1,53 @@
+package model
+
+import "context"
+
+// MembershipTableMoveInput is the input of MembershipTable.Move.
+type MembershipTableMoveInput struct {
+	UserID      string // the member to move
+	ToProjectID string // the destination project
+}
+
+// Move moves a member of the project to another project with the same role.
+// The actor must be a manager of both projects, and neither may be archived.
+// The checks run in the order of the Quint model (moveOutcome): manager of the
+// source (403), member found (404), destination readable (404), manager of the
+// destination (403), archived (409), same project (400), organization (400),
+// already a member of the destination (409).
+func (*MembershipTable) Move(ctx context.Context, db DB, authz ProjectAuthz, in MembershipTableMoveInput) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var moved *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		m, err := loadMoveMember(ctx, tx, authz.ProjectID(), in.UserID)
+		if err != nil {
+			return err
+		}
+		destAuthz, err := NewProjectAuthz(ctx, tx, authz.Actor(), in.ToProjectID)
+		if err != nil {
+			return err
+		}
+		if err := destAuthz.CanManageMembers(); err != nil {
+			return err
+		}
+		if err := authz.CheckWritable(); err != nil {
+			return err
+		}
+		if err := destAuthz.CheckWritable(); err != nil {
+			return err
+		}
+		agg, err := loadMoveDest(ctx, tx, m, in.ToProjectID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		moved, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return moved, nil
+}
