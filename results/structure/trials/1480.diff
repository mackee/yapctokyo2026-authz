index 0000000..c261051
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,107 @@
+package main
+
+import (
+	"encoding/json"
+	"reflect"
+	"testing"
+)
+
+func TestUpdateMembersStatus(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager", "ann", "web", `{"roles":{"ivy":"viewer"}}`, 200},
+		{"manager multiple", "ann", "web", `{"roles":{"ben":"manager","dan":"contributor"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"unknown user", "zed", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"missing project", "ann", "nope", `{"roles":{"dan":"contributor"}}`, 404},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"invalid role", "ann", "web", `{"roles":{"dan":"admin"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"bad json", "ann", "web", `{"roles":`, 400},
+		{"target not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"target in other org", "ann", "web", `{"roles":{"gus":"viewer"}}`, 400},
+		{"demote assignee", "ann", "web", `{"roles":{"ben":"viewer"}}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMembersResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann",
+		`{"roles":{"ben":"manager","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []member{
+		{"ann", "manager"},
+		{"ben", "manager"},
+		{"cat", "contributor"},
+		{"dan", "contributor"},
+		{"ivy", "manager"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+	// The change is persisted, not just echoed.
+	code, body = do(t, newServer(), "PUT", "/projects/web/members", "ann", `{"roles":{"ivy":"viewer"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got[4] != (member{"ivy", "viewer"}) {
+		t.Fatalf("ivy not updated: %+v", got[4])
+	}
+}
+
+func TestUpdateMembersAllOrNothing(t *testing.T) {
+	h := newServer()
+	// dan's change comes first in sorted order and would succeed on its own;
+	// hal is not a member, so the whole request must fail and change nothing.
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann",
+		`{"roles":{"dan":"contributor","hal":"viewer"}}`)
+	if code != 400 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var role string
+	if err := h.(*appHandler).db.QueryRow(
+		`SELECT role FROM memberships WHERE project_id = 'web' AND user_id = 'dan'`).Scan(&role); err != nil {
+		t.Fatal(err)
+	}
+	if role != "viewer" {
+		t.Fatalf("dan's role changed to %q despite the failed request", role)
+	}
+
+	// A demotion that would break an assignee also rolls back earlier changes.
+	code, body = do(t, h, "PUT", "/projects/web/members", "ann",
+		`{"roles":{"dan":"contributor","ben":"viewer"}}`)
+	if code != 409 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	if err := h.(*appHandler).db.QueryRow(
+		`SELECT role FROM memberships WHERE project_id = 'web' AND user_id = 'dan'`).Scan(&role); err != nil {
+		t.Fatal(err)
+	}
+	if role != "viewer" {
+		t.Fatalf("dan's role changed to %q despite the failed request", role)
+	}
+}
