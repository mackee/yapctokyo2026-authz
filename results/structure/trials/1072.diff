+// transferUserAggregate moves one user from the organization to another.
+type transferUserAggregate struct {
+	user        *User
+	toOrg       string
+	toOrgExists bool
+	projectOrgs []string // the organization of each project the user is a member of
+}
+
+func loadTransferUser(ctx context.Context, tx DB, fromOrg string, in UserTableTransferInput) (*transferUserAggregate, error) {
+	users := NewUserTable()
+	u, err := users.Find(ctx, tx, in.UserID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != fromOrg {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	a := &transferUserAggregate{user: u, toOrg: in.ToOrgID}
+	if a.toOrgExists, err = users.OrgExists(ctx, tx, in.ToOrgID); err != nil {
+		return nil, err
+	}
+	memberships, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, m := range memberships {
+		p, err := m.Project(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.projectOrgs = append(a.projectOrgs, p.Org)
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if !a.toOrgExists {
+		return deny(ErrInvalid, "toOrgId is not an existing organization")
+	}
+	if a.toOrg == a.user.Org {
+		return deny(ErrInvalid, "user already belongs to that organization")
+	}
+	// Project members belong to the project's organization, so a user who is
+	// still a member of a project elsewhere cannot move.
+	for _, org := range a.projectOrgs {
+		if org != a.toOrg {
+			return deny(ErrInvalid, "user is a member of a project outside the target organization")
+		}
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	if err := a.user.transfer(ctx, tx, a.toOrg); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
