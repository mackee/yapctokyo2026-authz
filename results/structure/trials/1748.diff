+func TestFreeze(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"other manager", "ivy", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"archived", "ann", "legacy", 409},
+		{"missing project", "ann", "nope", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got []map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err, body)
+	}
+	want := []string{"ann", "ben", "cat", "dan", "ivy"}
+	if len(got) != len(want) {
+		t.Fatalf("got %v", got)
+	}
+	for i, m := range got {
+		if len(m) != 2 || m["userId"] != want[i] || m["role"] != "viewer" {
+			t.Fatalf("member %d: %v", i, m)
+		}
+	}
+}
+
+func TestFrozenProjectRejectsWrites(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatal(code, body)
+	}
+	writes := []struct {
+		name, user, method, path, body string
+	}{
+		{"manager creates", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"manager updates", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"manager deletes", "ivy", "DELETE", "/projects/web/tasks/t1", ""},
+		{"contributor creates", "ben", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"contributor updates own", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"freeze again", "ann", "POST", "/projects/web/freeze", ""},
+	}
+	for _, w := range writes {
+		if code, _ := do(t, h, w.method, w.path, w.user, w.body); code != 403 {
+			t.Errorf("%s: got %d want 403", w.name, code)
+		}
+	}
+	// Members stay able to read, and the tasks are untouched.
+	code, body := do(t, h, "GET", "/projects/web/tasks", "ann", "")
+	if code != 200 {
+		t.Fatal(code)
+	}
+	var tasks []Task
+	json.Unmarshal([]byte(body), &tasks)
+	if len(tasks) != 3 || tasks[0].Status != "open" || tasks[1].Status != "doing" {
+		t.Fatalf("tasks changed: %s", body)
+	}
+}
+
