+
+// Freeze sets every member of the project to the viewer role, all or nothing,
+// and returns the members (ordered by user ID). Once frozen, no one can change
+// the project's tasks, since task writes need a contributor or manager role.
+func (*ProjectTable) Freeze(ctx context.Context, db DB, authz ProjectAuthz) ([]*Membership, error) {
+	if err := authz.CanFreeze(); err != nil {
+		return nil, err
+	}
+	var out []*Membership
+	if err := db.update(ctx, func(x *Tx) error {
+		agg, err := loadFreezeProject(ctx, x, authz.ProjectID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		out, err = agg.apply(ctx, x)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
