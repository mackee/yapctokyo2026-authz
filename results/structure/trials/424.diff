+
+// freezeProjectAggregate sets every member of one project to the viewer role.
+type freezeProjectAggregate struct {
+	project *Project
+	members []*Membership // project.Memberships, ordered by user ID
+}
+
+func loadFreezeProject(ctx context.Context, x *Tx, projectID string) (*freezeProjectAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, x, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	members, err := p.Memberships(ctx, x)
+	if err != nil {
+		return nil, err
+	}
+	return &freezeProjectAggregate{project: p, members: members}, nil
+}
+
+func (a *freezeProjectAggregate) validate() error { return nil }
+
+func (a *freezeProjectAggregate) apply(ctx context.Context, x *Tx) ([]*Membership, error) {
+	for _, m := range a.members {
+		if m.Role == RoleViewer {
+			continue
+		}
+		if err := m.setRole(ctx, x, RoleViewer); err != nil {
+			return nil, err
+		}
+	}
+	return a.members, nil
+}
