@@ -0,0 +1,103 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager removes contributor", "ann", "/projects/web/members/ben", 204},
+		{"manager removes viewer", "ann", "/projects/web/members/dan", 204},
+		{"manager removes manager", "ann", "/projects/web/members/ivy", 204},
+		{"manager removes self", "ann", "/projects/web/members/ann", 204},
+		{"contributor", "ben", "/projects/web/members/cat", 403},
+		{"viewer", "dan", "/projects/web/members/cat", 403},
+		{"org admin", "eve", "/projects/web/members/ben", 403},
+		{"non member caller", "hal", "/projects/web/members/ben", 404},
+		{"other org caller", "gus", "/projects/web/members/ben", 404},
+		{"anonymous", "", "/projects/web/members/ben", 401},
+		{"unknown user", "zed", "/projects/web/members/ben", 401},
+		{"target not a member", "ann", "/projects/web/members/hal", 404},
+		{"target unknown", "ann", "/projects/web/members/zed", 404},
+		{"target member of other project only", "ann", "/projects/web/members/gus", 404},
+		{"unknown project", "ann", "/projects/nope/members/ben", 404},
+		{"archived", "ann", "/projects/legacy/members/ben", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveMemberTakesAwayAccess(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "dan", ""); code != 200 {
+		t.Fatalf("before: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/dan", "ann", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "dan", ""); code != 404 {
+		t.Fatalf("after: got %d want 404", code)
+	}
+	// Removing twice: the user is no longer a member.
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/dan", "ann", ""); code != 404 {
+		t.Fatalf("again: got %d want 404", code)
+	}
+}
+
+// An assignee must be a contributor or manager of the task's project, so the
+// removed member's tasks in that project become unassigned (checkModelRules,
+// run by do() after the DELETE, enforces the rule; this checks the outcome).
+func TestRemoveMemberUnassignsTheirTasks(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("get t1: %d", code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "" {
+		t.Fatalf("t1 assignee = %q, want unassigned", task.AssigneeID)
+	}
+	// Other members' tasks in the project are untouched.
+	_, body = do(t, h, "GET", "/projects/web/tasks/t2", "ann", "")
+	json.Unmarshal([]byte(body), &task)
+	if task.AssigneeID != "cat" {
+		t.Fatalf("t2 assignee = %q, want cat", task.AssigneeID)
+	}
+}
+
+// Membership is per project: removing cat from ops keeps cat's web membership
+// and web task, and removing her from web keeps her ops task.
+func TestRemoveMemberOnlyAffectsThatProject(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/projects/ops/members/cat", "ivy", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat should still read web: got %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "cat", ""); code != 404 {
+		t.Fatalf("cat should no longer read ops: got %d", code)
+	}
+	_, body := do(t, h, "GET", "/projects/web/tasks/t2", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.AssigneeID != "cat" {
+		t.Fatalf("t2 assignee = %q, want cat", task.AssigneeID)
+	}
+}
