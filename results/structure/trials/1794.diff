diff --git a/transfer.go b/transfer.go
new file mode 100644
index 0000000..fbf5d7e
--- /dev/null
+++ b/transfer.go
@@ -0,0 +1,111 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+)
+
+type transferRequest struct {
+	ToOrgID string `json:"toOrgId"`
+}
+
+type transferResponse struct {
+	ID    string `json:"id"`
+	OrgID string `json:"orgId"`
+}
+
+// orgExists reports whether any user or project belongs to the organization.
+// Organizations have no table of their own.
+func orgExists(ctx context.Context, s *server, orgID string) (bool, error) {
+	var n int
+	err := s.db.QueryRowContext(ctx,
+		`SELECT EXISTS(SELECT 1 FROM users WHERE org_id = ?) OR EXISTS(SELECT 1 FROM projects WHERE org_id = ?)`,
+		orgID, orgID).Scan(&n)
+	return n == 1, err
+}
+
+// transferUser moves a user to another organization. Only an org admin of the
+// user's current organization may do this. The user's org admin flag is cleared,
+// since it applies to the old organization only. Their memberships in the old
+// organization's projects are removed, and any task assigned to them without a
+// remaining contributor or manager role in its project is unassigned, so the
+// model rules in rules_test.go keep holding.
+func (s *server) transferUser(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	caller, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if caller == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	orgID := r.PathValue("orgID")
+	if caller.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	if !caller.OrgAdmin {
+		writeError(w, 403, "only org admins may transfer users")
+		return
+	}
+	target, err := findUser(ctx, s.db, r.PathValue("uid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if target == nil || target.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	var req transferRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || req.ToOrgID == "" {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	if req.ToOrgID == orgID {
+		writeError(w, 400, "user is already in that organization")
+		return
+	}
+	exists, err := orgExists(ctx, s, req.ToOrgID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if !exists {
+		writeError(w, 400, "unknown organization")
+		return
+	}
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+	if _, err := tx.ExecContext(ctx, `UPDATE users SET org_id = ?, org_admin = 0 WHERE id = ?`, req.ToOrgID, target.ID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if _, err := tx.ExecContext(ctx,
+		`DELETE FROM memberships WHERE user_id = ? AND project_id IN (SELECT id FROM projects WHERE org_id <> ?)`,
+		target.ID, req.ToOrgID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if _, err := tx.ExecContext(ctx,
+		`UPDATE tasks SET assignee = '' WHERE assignee = ? AND NOT EXISTS (
+			SELECT 1 FROM memberships m
+			 WHERE m.project_id = tasks.project_id AND m.user_id = tasks.assignee
+			   AND m.role IN ('contributor', 'manager'))`,
+		target.ID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, transferResponse{ID: target.ID, OrgID: req.ToOrgID})
+}
diff --git a/transfer_test.go b/transfer_test.go
new file mode 100644
index 0000000..bbaf916
--- /dev/null
+++ b/transfer_test.go
@@ -0,0 +1,104 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestTransferStatus(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin transfers", "eve", "/orgs/acme/users/ann/transfer", `{"toOrgId":"globex"}`, 200},
+		{"anonymous", "", "/orgs/acme/users/ann/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ann/transfer", `{"toOrgId":"globex"}`, 401},
+		{"caller in other org", "gus", "/orgs/acme/users/ann/transfer", `{"toOrgId":"globex"}`, 404},
+		{"org in path does not exist", "eve", "/orgs/initech/users/ann/transfer", `{"toOrgId":"globex"}`, 404},
+		{"member is not org admin", "ben", "/orgs/acme/users/cat/transfer", `{"toOrgId":"globex"}`, 403},
+		{"user not in org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"globex"}`, 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"missing toOrgId", "eve", "/orgs/acme/users/ann/transfer", `{}`, 400},
+		{"invalid body", "eve", "/orgs/acme/users/ann/transfer", `not json`, 400},
+		{"unknown target org", "eve", "/orgs/acme/users/ann/transfer", `{"toOrgId":"initech"}`, 400},
+		{"same org", "eve", "/orgs/acme/users/ann/transfer", `{"toOrgId":"acme"}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/ann/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got struct {
+		ID    string `json:"id"`
+		OrgID string `json:"orgId"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("bad response %q: %v", body, err)
+	}
+	if got.ID != "ann" || got.OrgID != "globex" {
+		t.Fatalf("got %+v want {ID:ann OrgID:globex}", got)
+	}
+}
+
+func TestTransferMovesUserOut(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/orgs/acme/users/ann/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer got %d: %s", code, body)
+	}
+	// ann can no longer read acme projects, and has no role in globex.
+	for _, path := range []string{"/projects/web/tasks", "/projects/ops/tasks", "/projects/gx/tasks"} {
+		if code, _ := do(t, h, "GET", path, "ann", ""); code != 404 {
+			t.Errorf("ann GET %s: got %d want 404", path, code)
+		}
+	}
+	// globex's own manager still reads its project.
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Errorf("gus GET gx tasks: got %d want 200", code)
+	}
+}
+
+func TestTransferDropsOldOrgRoles(t *testing.T) {
+	h := newServer()
+	// ben is a contributor in acme and is assigned t1 (web).
+	if code, body := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer got %d: %s", code, body)
+	}
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "cat", "")
+	if code != 200 {
+		t.Fatalf("cat GET t1: got %d: %s", code, body)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.Assignee != "" {
+		t.Errorf("t1 still assigned to %q after ben left acme", task.Assignee)
+	}
+	if code, _ := do(t, h, "GET", "/projects/legacy/tasks", "ben", ""); code != 404 {
+		t.Errorf("ben GET legacy tasks: got %d want 404", code)
+	}
+}
+
+func TestTransferClearsOrgAdmin(t *testing.T) {
+	app := newServer().(*appHandler)
+	// Make ann an acme org admin; admin rights belong to the old org and must not follow her.
+	if _, err := app.db.Exec(`UPDATE users SET org_admin = 1 WHERE id = 'ann'`); err != nil {
+		t.Fatal(err)
+	}
+	if code, body := do(t, app, "POST", "/orgs/acme/users/ann/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer got %d: %s", code, body)
+	}
+	if code, _ := do(t, app, "GET", "/projects/gx/tasks", "ann", ""); code != 404 {
+		t.Errorf("ann GET gx tasks: got %d want 404 (org admin rights should not carry over)", code)
+	}
+}
