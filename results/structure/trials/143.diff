 // projectTransformer authenticates the caller and binds the scope to {pid}.
+// X-On-Behalf-Of, when present, makes the caller act as that user in {pid}
+// (only a manager of {pid} may do so; see capability.AuthenticateOnBehalf).
 // The Authorizer stays in this closure; it is never put in a registry.
 func projectTransformer(authz *capability.Authorizer) tanukirpc.Transformer[*rootRegistry, *projectRegistry] {
 	return tanukirpc.NewTransformer(func(ctx tanukirpc.Context[*rootRegistry]) (*projectRegistry, error) {
-		actor, err := authz.Authenticate(ctx.Request().Header.Get("X-User"))
+		pid := chi.URLParam(ctx.Request(), "pid")
+		actor, err := authz.AuthenticateOnBehalf(
+			ctx.Request().Header.Get("X-User"),
+			ctx.Request().Header.Get("X-On-Behalf-Of"),
+			pid,
+		)
 		if err != nil {
 			return nil, err
 		}
-		return &projectRegistry{scope: actor.Project(chi.URLParam(ctx.Request(), "pid"))}, nil
+		return &projectRegistry{scope: actor.Project(pid)}, nil
 	})
 }
 
diff --git a/main_test.go b/main_test.go
index 0277f51..21db927 100644
--- a/main_test.go
+++ b/main_test.go
@@ -19,6 +19,90 @@ func do(t *testing.T, h http.Handler, method, path, user, body string) (int, str
 	return w.Code, w.Body.String()
 }
 
+// doOnBehalf is do with an X-On-Behalf-Of header.
+func doOnBehalf(t *testing.T, h http.Handler, method, path, user, onBehalf, body string) (int, string) {
+	t.Helper()
+	req := httptest.NewRequest(method, path, strings.NewReader(body))
+	if user != "" {
+		req.Header.Set("X-User", user)
+	}
+	if onBehalf != "" {
+		req.Header.Set("X-On-Behalf-Of", onBehalf)
+	}
+	w := httptest.NewRecorder()
+	h.ServeHTTP(w, req)
+	return w.Code, w.Body.String()
+}
+
+func TestOnBehalfOf(t *testing.T) {
+	cases := []struct {
+		name, user, onBehalf, method, path, body string
+		want                                     int
+	}{
+		// Manager ann acts as contributor ben in web: ben's rights, no more.
+		{"manager acts for member: list", "ann", "ben", "GET", "/projects/web/tasks", "", 200},
+		{"acting as ben: edit own task", "ann", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`, 200},
+		{"acting as ben: edit others task", "ann", "ben", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"acting as ben: reassign", "ann", "ben", "PATCH", "/projects/web/tasks/t1", `{"assignee":"cat"}`, 403},
+		{"acting as ben: delete", "ann", "ben", "DELETE", "/projects/web/tasks/t1", "", 403},
+		{"acting as ben: create self-assigned", "ann", "ben", "POST", "/projects/web/tasks", `{"title":"x","assignee":"ben"}`, 201},
+		{"acting as ben: create assigned to other", "ann", "ben", "POST", "/projects/web/tasks", `{"title":"x","assignee":"cat"}`, 403},
+		{"acting as cat: edit own task", "ann", "cat", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 200},
+		// Target rights are the target's: a viewer stays read-only.
+		{"acting as viewer: create", "ann", "dan", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"acting as viewer: list", "ann", "dan", "GET", "/projects/web/tasks", "", 200},
+		// Archived project still rejects writes through delegation.
+		{"acting as ben in archived", "ann", "ben", "POST", "/projects/legacy/tasks", `{"title":"x"}`, 409},
+		// Caller must be a manager of the project.
+		{"contributor cannot delegate", "ben", "cat", "GET", "/projects/web/tasks", "", 403},
+		{"viewer cannot delegate", "dan", "ben", "GET", "/projects/web/tasks", "", 403},
+		{"manager of other project cannot delegate", "ann", "cat", "GET", "/projects/ops/tasks", "", 403},
+		{"org admin cannot delegate", "eve", "ben", "GET", "/projects/web/tasks", "", 403},
+		// Target must be a member of the project.
+		{"target non member", "ann", "hal", "GET", "/projects/web/tasks", "", 403},
+		{"target org admin without role", "ann", "eve", "GET", "/projects/web/tasks", "", 403},
+		{"target other org", "ann", "gus", "GET", "/projects/web/tasks", "", 403},
+		{"target unknown", "ann", "zed", "GET", "/projects/web/tasks", "", 403},
+		// Caller must be authenticated and see the project.
+		{"unknown caller", "zed", "ben", "GET", "/projects/web/tasks", "", 401},
+		{"anonymous caller", "", "ben", "GET", "/projects/web/tasks", "", 401},
+		{"caller cannot see project", "hal", "ben", "GET", "/projects/web/tasks", "", 404},
+		{"unknown project", "ann", "ben", "GET", "/projects/nope/tasks", "", 404},
+		// Delegation is per project: the same manager, a different project.
+		{"ivy acts as cat in ops", "ivy", "cat", "GET", "/projects/ops/tasks", "", 200},
+		{"ivy acts as cat in ops: delete", "ivy", "cat", "DELETE", "/projects/ops/tasks/t4", "", 403},
+		{"task of other project via delegation", "ann", "ben", "PATCH", "/projects/web/tasks/t5", `{"status":"done"}`, 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := doOnBehalf(t, newServer(), c.method, c.path, c.user, c.onBehalf, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestOnBehalfOfWritesAsTarget(t *testing.T) {
+	h := newServer()
+	code, body := doOnBehalf(t, h, "PATCH", "/projects/web/tasks/t1", "ann", "ben", `{"status":"done"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got Task
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.Status != "done" || got.ID != "t1" {
+		t.Fatalf("unexpected task %+v", got)
+	}
+	// The write is visible to a direct read by anyone with access.
+	code, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 || !strings.Contains(body, `"status":"done"`) {
+		t.Fatalf("got %d: %s", code, body)
+	}
+}
+
 func TestRead(t *testing.T) {
 	cases := []struct {
 		name, user, path string
