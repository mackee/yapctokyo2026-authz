diff --git a/internal/capability/onbehalf_test.go b/internal/capability/onbehalf_test.go
new file mode 100644
index 0000000..da4ec3b
--- /dev/null
+++ b/internal/capability/onbehalf_test.go
@@ -0,0 +1,45 @@
+package capability
+
+import (
+	"errors"
+	"testing"
+)
+
+func TestAuthenticateOnBehalfConfinedToProject(t *testing.T) {
+	authz := New()
+	actor, err := authz.AuthenticateOnBehalf("ann", "ben", "web")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if actor.Actor().ID() != "ben" {
+		t.Fatalf("actor = %s, want ben", actor.Actor().ID())
+	}
+
+	// Inside the delegated project the target's rights apply.
+	if _, err := actor.Project("web").Read(); err != nil {
+		t.Fatalf("read web: %v", err)
+	}
+
+	// Outside it the delegation grants nothing, even though ben is a member
+	// of legacy and the caller is a manager there.
+	if _, err := actor.Project("legacy").Read(); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("read legacy via delegation: got %v, want ErrNotFound", err)
+	}
+	if _, err := actor.Project("legacy").Write(); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("write legacy via delegation: got %v, want ErrNotFound", err)
+	}
+}
+
+func TestAuthenticateOnBehalfEmptyIsDirect(t *testing.T) {
+	authz := New()
+	actor, err := authz.AuthenticateOnBehalf("ann", "", "web")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if actor.Actor().ID() != "ann" {
+		t.Fatalf("actor = %s, want ann", actor.Actor().ID())
+	}
+	if _, err := actor.Project("legacy").Read(); err != nil {
+		t.Fatalf("direct actor read legacy: %v", err)
+	}
+}
