+// AuthenticateOnBehalf resolves a delegated request: callerID (X-User) acts as
+// onBehalfOfID (X-On-Behalf-Of) in project pid. The delegation is allowed only
+// when the caller is a manager of pid and the target is a member of pid (any
+// role). The resulting actor has the target's rights, but only inside pid.
+// An empty onBehalfOfID is an ordinary Authenticate.
+//
+// Failures: unknown or missing caller → 401; project not readable by the caller
+// → 404; caller not a manager of pid, or target not a member of pid → 403.
+func (a *Authorizer) AuthenticateOnBehalf(callerID, onBehalfOfID, pid string) (ActorScope, error) {
+	if onBehalfOfID == "" {
+		return a.Authenticate(callerID)
+	}
+	var act Actor
+	err := a.st.read(func(s *state) error {
+		u, ok := s.users[callerID]
+		if callerID == "" || !ok {
+			return deny(ErrUnauthenticated, "unauthenticated")
+		}
+		caller := Actor{id: u.id, org: u.org, orgAdmin: u.orgAdmin}
+		_, role, err := readable(s, caller, pid)
+		if err != nil {
+			return err
+		}
+		if role != RoleManager {
+			return deny(ErrForbidden, "forbidden")
+		}
+		target, ok := s.users[onBehalfOfID]
+		if !ok || s.role(pid, onBehalfOfID) == "" {
+			return deny(ErrForbidden, "forbidden")
+		}
+		act = Actor{id: target.id, org: target.org, orgAdmin: target.orgAdmin, delegatedTo: pid}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &actorScope{a: a, actor: act}, nil
+}
+
