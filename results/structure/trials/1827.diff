 func (a *deleteTaskAggregate) validate() error { return nil }
 
 func (a *deleteTaskAggregate) apply(ctx context.Context, tx DB) error { return a.task.destroy(ctx, tx) }
+
+// removeUserFromOrgAggregate removes one user from every project of one
+// organization. Removing the membership would leave the user's assigned tasks
+// assigned to a non-member, which breaks the assignee rule, so those tasks are
+// unassigned in the same transaction.
+type removeUserFromOrgAggregate struct {
+	memberships []*Membership // the user's memberships in the organization's projects
+	tasks       []*Task       // tasks assigned to the user in those projects
+}
+
+func loadRemoveUserFromOrg(ctx context.Context, tx DB, orgID, userID string) (*removeUserFromOrgAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) || (err == nil && u.Org != orgID) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	all, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	a := &removeUserFromOrgAggregate{}
+	for _, m := range all {
+		p, err := m.Project(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		if p.Org != orgID {
+			continue
+		}
+		tasks, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.memberships = append(a.memberships, m)
+		a.tasks = append(a.tasks, tasks...)
+	}
+	return a, nil
+}
+
+func (a *removeUserFromOrgAggregate) validate() error { return nil }
+
+func (a *removeUserFromOrgAggregate) apply(ctx context.Context, tx DB) error {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return err
+		}
+	}
+	return nil
+}
