new file mode 100644
index 0000000..61d22db
--- /dev/null
+++ b/org_test.go
@@ -0,0 +1,108 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"testing"
+)
+
+// DELETE /orgs/{orgID}/users/{uid} removes the user from every project of the
+// organization (offboarding). Only org admins may do it.
+
+func TestRemoveUserFromOrg(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes contributor", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes viewer", "eve", "/orgs/acme/users/dan", 204},
+		{"org admin removes manager", "eve", "/orgs/acme/users/ivy", 204},
+		{"org admin removes user with no memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"project manager is not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"contributor is not org admin", "ben", "/orgs/acme/users/cat", 403},
+		{"viewer is not org admin", "dan", "/orgs/acme/users/cat", 403},
+		{"member of other org", "gus", "/orgs/acme/users/ben", 404},
+		{"org admin, other org", "eve", "/orgs/globex/users/gus", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/nobody", 404},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveUserFromOrgEffects(t *testing.T) {
+	h := newServer()
+
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != http.StatusNoContent {
+		t.Fatalf("remove ben: got %d want 204", code)
+	}
+
+	// ben is no longer a member of web or legacy (archived), so he cannot read them.
+	for _, p := range []string{"/projects/web/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, h, "GET", p, "ben", ""); code != http.StatusNotFound {
+			t.Fatalf("ben GET %s: got %d want 404", p, code)
+		}
+	}
+
+	// ben can no longer be assigned in web.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ann", `{"title":"x","assignee":"ben"}`); code != http.StatusBadRequest {
+		t.Fatalf("assign ben in web: got %d want 400", code)
+	}
+
+	// Tasks ben held are unassigned, in web and in the archived legacy project.
+	for _, path := range []string{"/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		code, body := do(t, h, "GET", path, "ann", "")
+		if code != http.StatusOK {
+			t.Fatalf("GET %s: got %d want 200", path, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.AssigneeID != "" {
+			t.Fatalf("%s still assigned to %q", path, task.AssigneeID)
+		}
+	}
+
+	// Other people are untouched: cat keeps her assignment and her access.
+	if code, body := do(t, h, "GET", "/projects/web/tasks/t2", "cat", ""); code != http.StatusOK {
+		t.Fatalf("cat GET t2: got %d want 200", code)
+	} else {
+		var task Task
+		_ = json.Unmarshal([]byte(body), &task)
+		if task.AssigneeID != "cat" {
+			t.Fatalf("t2 assignee changed to %q", task.AssigneeID)
+		}
+	}
+
+	// Removing again is still 204.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != http.StatusNoContent {
+		t.Fatalf("remove ben again: got %d want 204", code)
+	}
+}
+
+func TestRemoveUserFromOrgKeepsOtherProjects(t *testing.T) {
+	h := newServer()
+
+	// ivy is a manager in web and ops; both memberships go.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ivy", "eve", ""); code != http.StatusNoContent {
+		t.Fatalf("remove ivy: got %d want 204", code)
+	}
+	for _, p := range []string{"/projects/web/tasks", "/projects/ops/tasks"} {
+		if code, _ := do(t, h, "POST", p, "ivy", `{"title":"x"}`); code != http.StatusNotFound {
+			t.Fatalf("ivy POST %s: got %d want 404", p, code)
+		}
+	}
+	// ann keeps her roles in web and ops.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ann", ""); code != http.StatusOK {
+		t.Fatalf("ann GET web: got %d want 200", code)
+	}
+}
