+// RemoveFromOrgProjects removes the user from every project of the
+// organization (offboarding): the user's memberships in those projects go, and
+// the tasks the user held there are unassigned. Archived projects are included:
+// this is a membership change, not a write to the project's content. A user
+// with no memberships is removed from nothing and still succeeds, so the
+// operation can be repeated. Unknown users, and users outside the organization,
+// are ErrNotFound.
+func (*UserTable) RemoveFromOrgProjects(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanRemoveMembers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveUserFromOrg(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
