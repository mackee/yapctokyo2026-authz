+// Member is the JSON shape of a project member.
+type Member struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+type changeRolesRequest struct {
+	Roles map[string]string `json:"roles" validate:"required,min=1,dive,oneof=manager contributor viewer"`
+}
+
+func changeRoles(ctx tanukirpc.Context[*projectRegistry], req changeRolesRequest) ([]Member, error) {
+	reg := ctx.Registry()
+	ms, err := model.NewMembershipTable().ChangeRoles(ctx, reg.db, reg.authz, req.Roles)
+	if err != nil {
+		return nil, err
+	}
+	out := make([]Member, 0, len(ms))
+	for _, m := range ms {
+		out = append(out, Member{UserID: m.UserID, Role: m.Role})
+	}
+	return out, nil
+}
