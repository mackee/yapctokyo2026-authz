diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..2a8c23d
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,124 @@
+package main
+
+import (
+	"encoding/json"
+	"reflect"
+	"testing"
+)
+
+type memberJSON struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// rolesOf reads the roles of a project straight from the database behind h.
+func rolesOf(t *testing.T, h interface{}, project string) map[string]string {
+	t.Helper()
+	app, ok := h.(*appHandler)
+	if !ok {
+		t.Fatalf("%T is not the handler built by newServer", h)
+	}
+	rows, err := app.db.Query(`SELECT user_id, role FROM memberships WHERE project_id = ?`, project)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer rows.Close()
+	out := map[string]string{}
+	for rows.Next() {
+		var u, r string
+		if err := rows.Scan(&u, &r); err != nil {
+			t.Fatal(err)
+		}
+		out[u] = r
+	}
+	return out
+}
+
+func TestBulkRolesSuccess(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"manager","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []memberJSON
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []memberJSON{
+		{"ann", "manager"}, {"ben", "manager"}, {"cat", "contributor"}, {"dan", "contributor"}, {"ivy", "manager"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	if r := rolesOf(t, h, "web"); r["ben"] != "manager" || r["dan"] != "contributor" {
+		t.Fatalf("not persisted: %v", r)
+	}
+}
+
+func TestBulkRolesDemoteWithoutTasks(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ivy":"viewer"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	if r := rolesOf(t, h, "web"); r["ivy"] != "viewer" {
+		t.Fatalf("not persisted: %v", r)
+	}
+}
+
+func TestBulkRolesRejectedChangesNothing(t *testing.T) {
+	cases := []struct {
+		name, body string
+	}{
+		{"unknown user", `{"roles":{"dan":"contributor","zed":"viewer"}}`},
+		{"non member", `{"roles":{"dan":"contributor","hal":"viewer"}}`},
+		{"other org user", `{"roles":{"dan":"contributor","gus":"viewer"}}`},
+		{"invalid role", `{"roles":{"dan":"contributor","cat":"owner"}}`},
+		// ben is assigned t1 in web: a viewer cannot be an assignee.
+		{"demote assignee", `{"roles":{"dan":"contributor","ben":"viewer"}}`},
+		{"empty roles", `{"roles":{}}`},
+		{"missing roles", `{}`},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			before := rolesOf(t, h, "web")
+			code, _ := do(t, h, "PUT", "/projects/web/members", "ann", c.body)
+			if code != 400 {
+				t.Fatalf("got %d want 400", code)
+			}
+			if after := rolesOf(t, h, "web"); !reflect.DeepEqual(before, after) {
+				t.Fatalf("roles changed: %v -> %v", before, after)
+			}
+		})
+	}
+}
+
+func TestBulkRolesAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"malformed before access", "dan", "web", `{"roles":{"dan":"owner"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			before := rolesOf(t, h, c.project)
+			code, _ := do(t, h, "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+			if after := rolesOf(t, h, c.project); !reflect.DeepEqual(before, after) {
+				t.Fatalf("roles changed: %v -> %v", before, after)
+			}
+		})
+	}
+}
