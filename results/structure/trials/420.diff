+// removeOrgUserAggregate removes one user from the projects of one organization.
+type removeOrgUserAggregate struct {
+	user        *User
+	memberships []*Membership // the user's memberships in the organization's projects
+}
+
+func loadRemoveOrgUser(ctx context.Context, x *Tx, orgID, userID string) (*removeOrgUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, x, userID)
+	if errors.Is(err, ErrNoRows) || (err == nil && u.Org != orgID) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	ms, err := u.Memberships(ctx, x)
+	if err != nil {
+		return nil, err
+	}
+	a := &removeOrgUserAggregate{user: u}
+	for _, m := range ms {
+		p, err := m.Project(ctx, x)
+		if errors.Is(err, ErrNoRows) {
+			continue
+		} else if err != nil {
+			return nil, err
+		}
+		if p.Org == orgID {
+			a.memberships = append(a.memberships, m)
+		}
+	}
+	return a, nil
+}
+
+func (a *removeOrgUserAggregate) validate() error { return nil }
+
+// apply unassigns the user's tasks in each project and then deletes the
+// membership, so no task is left assigned to a non-member.
+func (a *removeOrgUserAggregate) apply(ctx context.Context, x *Tx) error {
+	for _, m := range a.memberships {
+		tasks, err := m.AssignedTasks(ctx, x)
+		if err != nil {
+			return err
+		}
+		for _, t := range tasks {
+			if err := t.unassign(ctx, x); err != nil {
+				return err
+			}
+		}
+		if err := m.destroy(ctx, x); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
