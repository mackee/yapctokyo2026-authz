+// RemoveFromOrg removes the user from every project of the authorization
+// object's organization (the user's memberships there are deleted, and tasks
+// assigned to the user in those projects are unassigned). The user's own
+// organization is not changed. A user who is not in the organization, or who
+// does not exist, is ErrNotFound; removing a user who has no memberships there
+// succeeds and changes nothing.
+func (*UserTable) RemoveFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanManageMembers(); err != nil {
+		return err
+	}
+	return db.update(ctx, func(x *Tx) error {
+		agg, err := loadRemoveOrgUser(ctx, x, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, x)
+	})
+}
