+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, org, uid string
+		want                 int
+	}{
+		{"org admin removes member", "eve", "acme", "ben", 204},
+		{"org admin removes user with no projects", "eve", "acme", "hal", 204},
+		{"org admin removes org admin", "eve", "acme", "eve", 204},
+		{"manager is not org admin", "ann", "acme", "ben", 403},
+		{"contributor is not org admin", "ben", "acme", "cat", 403},
+		{"other org", "gus", "acme", "ben", 404},
+		{"org admin of another org", "eve", "globex", "gus", 404},
+		{"org missing", "eve", "initech", "ben", 404},
+		{"user in another org", "eve", "acme", "gus", 404},
+		{"unknown user", "eve", "acme", "zed", 404},
+		{"anonymous", "", "acme", "ben", 401},
+		{"unknown actor", "zed", "acme", "ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", "/orgs/"+c.org+"/users/"+c.uid, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+// readTask reads one task as the user and fails the test unless it is 200.
+func readTask(t *testing.T, h http.Handler, user, path string) Task {
+	t.Helper()
+	code, body := do(t, h, "GET", path, user, "")
+	if code != 200 {
+		t.Fatalf("GET %s as %s: got %d", path, user, code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	return task
+}
+
+func TestRemoveOrgUserRemovesMembershipsAndUnassigns(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("before: ben should read web, got %d", code)
+	}
+
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+
+	// ben is no longer a member of web or legacy (archived), so both are 404 for ben.
+	for _, p := range []string{"/projects/web/tasks", "/projects/legacy/tasks", "/projects/web/tasks/t1"} {
+		if code, _ := do(t, h, "GET", p, "ben", ""); code != 404 {
+			t.Fatalf("GET %s as ben after removal: got %d want 404", p, code)
+		}
+	}
+
+	// ben's tasks in those projects are unassigned, so no task is assigned to a non-member.
+	if got := readTask(t, h, "ann", "/projects/web/tasks/t1").AssigneeID; got != "" {
+		t.Fatalf("web t1 assignee = %q, want unassigned", got)
+	}
+	if got := readTask(t, h, "ann", "/projects/legacy/tasks/t5").AssigneeID; got != "" {
+		t.Fatalf("legacy t5 assignee = %q, want unassigned", got)
+	}
+	// Other members' assignments are untouched.
+	if got := readTask(t, h, "ann", "/projects/web/tasks/t2").AssigneeID; got != "cat" {
+		t.Fatalf("web t2 assignee = %q, want cat", got)
+	}
+	if got := readTask(t, h, "cat", "/projects/ops/tasks/t4").AssigneeID; got != "cat" {
+		t.Fatalf("ops t4 assignee = %q, want cat", got)
+	}
+	// The project keeps its tasks.
+	code, body := do(t, h, "GET", "/projects/web/tasks", "ann", "")
+	var tasks []Task
+	json.Unmarshal([]byte(body), &tasks)
+	if code != 200 || len(tasks) != 3 {
+		t.Fatalf("web tasks after removal: code %d, %d tasks; want 200 and 3", code, len(tasks))
+	}
+
+	// Removing again is still 204 and changes nothing.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("second remove: got %d want 204", code)
+	}
+	if got := readTask(t, h, "ann", "/projects/web/tasks/t2").AssigneeID; got != "cat" {
+		t.Fatalf("after second remove: web t2 assignee = %q, want cat", got)
+	}
+}
+
+func TestRemoveOrgUserDeniedChangesNothing(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "ann", ""); code != 403 {
+		t.Fatalf("manager remove: got %d want 403", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben after denied remove: got %d want 200", code)
+	}
+	if got := readTask(t, h, "ann", "/projects/web/tasks/t1").AssigneeID; got != "ben" {
+		t.Fatalf("web t1 assignee = %q, want ben", got)
+	}
+}
