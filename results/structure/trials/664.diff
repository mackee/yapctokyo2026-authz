+package main
+
+import "testing"
+
+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes again (idempotent)", "eve", "/orgs/acme/users/hal", 204},
+		{"non admin member", "ann", "/orgs/acme/users/ben", 403},
+		{"viewer in org", "dan", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"caller from other org", "gus", "/orgs/acme/users/ben", 404},
+		{"org admin, other org", "eve", "/orgs/globex/users/gus", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ben", 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserRemovesAllMemberships(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("delete got %d body=%s", code, body)
+	}
+	// ben was a contributor in web and legacy (archived); both must be gone.
+	for _, path := range []string{"/projects/web/tasks", "/projects/legacy/tasks/t5"} {
+		if code, _ := do(t, h, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("GET %s as removed user: got %d want 404", path, code)
+		}
+	}
+	// ben cannot create tasks any more either.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 404 {
+		t.Fatalf("POST as removed user: got %d want 404", code)
+	}
+	// Other members of the same projects are untouched.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ann", ""); code != 200 {
+		t.Fatalf("ann lost access to web: got %d", code)
+	}
+}
+
+func TestRemoveOrgUserLeavesOtherOrgsAlone(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("delete got %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatalf("globex member lost access: got %d", code)
+	}
+}
+
+func TestRemoveOrgUserRevokesOrgAdmin(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/eve", "eve", ""); code != 204 {
+		t.Fatalf("delete got %d", code)
+	}
+	// eve is no longer an org admin, so she can no longer read projects she has no role in.
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "eve", ""); code != 404 {
+		t.Fatalf("removed org admin still reads ops: got %d want 404", code)
+	}
+	// And she can no longer remove anyone.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/hal", "eve", ""); code != 403 {
+		t.Fatalf("removed org admin delete: got %d want 403", code)
+	}
+}
