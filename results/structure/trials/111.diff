+func (t *manageTask) MoveTo(dst WriteProject) (TaskView, error) {
+	dstID := dst.ID()
+	if dstID == t.ts.ps.pid {
+		return TaskView{}, deny(ErrInvalid, "task is already in that project")
+	}
+	var v TaskView
+	err := t.ts.ps.as.a.st.tx(func(s *state) error {
+		cur, ok := s.tasks[t.ts.tid]
+		if !ok || cur.project != t.ts.ps.pid {
+			return deny(ErrNotFound, "not found")
+		}
+		// Re-admit the assignee for the destination; this is what rejects a
+		// move whose assignee cannot work in dst.
+		a, err := admit(s, dstID, cur.assignee.user)
+		if err != nil {
+			return err
+		}
+		cur.project = dstID
+		cur.assignee = a
+		s.tasks[cur.id] = cur
+		v = cur.view()
+		return nil
+	})
+	return v, err
+}
