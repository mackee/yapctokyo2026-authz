+type moveRequest struct {
+	ToProjectID string `json:"toProjectId"`
+}
+
+func moveTask(ctx tanukirpc.Context[*taskRegistry], _ struct{}) (*Task, error) {
+	t, err := ctx.Registry().scope.Manage()
+	if err != nil {
+		return nil, err
+	}
+	var req moveRequest
+	if err := decodeBody(ctx.Request(), &req); err != nil || req.ToProjectID == "" {
+		return nil, errInvalidBody
+	}
+	dst, err := ctx.Registry().scope.Project().Actor().Project(req.ToProjectID).Write()
+	if err != nil {
+		return nil, err
+	}
+	v, err := t.MoveTo(dst)
+	if err != nil {
+		return nil, err
+	}
+	return &v, nil
+}
