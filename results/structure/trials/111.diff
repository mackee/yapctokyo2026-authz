+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager, assignee can write dst", "ivy", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 200},
+		{"manager, unassigned task", "ann", "/projects/web/tasks/t3", `{"toProjectId":"legacy"}`, 409},
+		{"assignee not in dst", "ivy", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 400},
+		{"dst viewer only", "ann", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 403},
+		{"dst is archived", "ann", "/projects/web/tasks/t2", `{"toProjectId":"legacy"}`, 409},
+		{"dst missing", "ann", "/projects/web/tasks/t2", `{"toProjectId":"nope"}`, 404},
+		{"dst in other org", "ann", "/projects/web/tasks/t2", `{"toProjectId":"gx"}`, 404},
+		{"dst is source", "ann", "/projects/web/tasks/t2", `{"toProjectId":"web"}`, 400},
+		{"missing toProjectId", "ann", "/projects/web/tasks/t2", `{}`, 400},
+		{"bad body", "ann", "/projects/web/tasks/t2", `nope`, 400},
+		{"contributor cannot move", "cat", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 403},
+		{"viewer cannot move", "dan", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 403},
+		{"org admin cannot move", "eve", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 403},
+		{"non member", "hal", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 404},
+		{"other org", "gus", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 401},
+		{"cross project task id", "ann", "/projects/web/tasks/t4", `{"toProjectId":"legacy"}`, 404},
+		{"source archived", "ann", "/projects/legacy/tasks/t5", `{"toProjectId":"web"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsFields(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got Task
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", Assignee: "cat"}
+	if got != want {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t2", "ann", ""); code != 404 {
+		t.Fatalf("old project still serves task: %d", code)
+	}
+	code, body = do(t, h, "GET", "/projects/ops/tasks/t2", "ann", "")
+	if code != 200 {
+		t.Fatalf("new project: got %d", code)
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil || got != want {
+		t.Fatalf("after move: got %s", body)
+	}
+}
+
+func TestMoveUnassigned(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/tasks/t3/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got Task
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.ProjectID != "ops" || got.Assignee != "" || got.ID != "t3" {
+		t.Fatalf("unexpected: %+v", got)
+	}
+}
