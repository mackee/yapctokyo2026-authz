 func (a *deleteTaskAggregate) apply(ctx context.Context, tx DB) error { return a.task.destroy(ctx, tx) }
+
+// transferUserAggregate moves one user to another organization.
+type transferUserAggregate struct {
+	user        *User
+	toOrg       string
+	toOrgExists bool          // a user or project belongs to the target organization
+	memberships []*Membership // the user's projects; the user leaves them all
+	tasks       []*Task       // tasks assigned to the user; they are unassigned
+}
+
+func loadTransferUser(ctx context.Context, tx DB, fromOrg, userID string, in UserTableTransferInput) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != fromOrg {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	a := &transferUserAggregate{user: u, toOrg: in.ToOrgID}
+	if a.toOrgExists, err = NewOrgTable().Exists(ctx, tx, in.ToOrgID); err != nil {
+		return nil, err
+	}
+	if a.memberships, err = u.Memberships(ctx, tx); err != nil {
+		return nil, err
+	}
+	if a.tasks, err = u.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if a.toOrg == a.user.Org {
+		return deny(ErrInvalid, "user already belongs to that organization")
+	}
+	if !a.toOrgExists {
+		return deny(ErrInvalid, "toOrgId must be an existing organization")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	u := a.user
+	u.Org = a.toOrg
+	u.OrgAdmin = false
+	if err := u.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return u, nil
+}
