+package model
+
+import "context"
+
+// OrgTable is the set of organizations. It has no table of its own: an
+// organization exists while a user or a project belongs to it.
+type OrgTable struct{}
+
+// NewOrgTable returns the organizations.
+func NewOrgTable() *OrgTable { return &OrgTable{} }
+
+// Exists reports whether a user or a project belongs to the organization.
+func (*OrgTable) Exists(ctx context.Context, db DB, id string) (bool, error) {
+	var ok bool
+	if err := db.QueryRowContext(ctx,
+		`SELECT EXISTS (SELECT 1 FROM users WHERE org_id = ?) OR EXISTS (SELECT 1 FROM projects WHERE org_id = ?)`,
+		id, id).Scan(&ok); err != nil {
+		return false, err
+	}
+	return ok, nil
+}
