diff --git a/transfer_test.go b/transfer_test.go
new file mode 100644
index 0000000..77998c1
--- /dev/null
+++ b/transfer_test.go
@@ -0,0 +1,133 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+// transferResponse is the JSON the transfer endpoint returns.
+type transferResponse struct {
+	ID    string `json:"id"`
+	OrgID string `json:"orgId"`
+}
+
+func TestTransferAccess(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin transfers member", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 200},
+		{"manager is not an org admin", "ann", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 403},
+		{"user transfers self", "ben", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 403},
+		{"anonymous", "", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown actor", "zed", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 401},
+		{"actor in other org", "gus", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"unknown target org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"initech"}`, 400},
+		{"same org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"acme"}`, 400},
+		{"missing toOrgId", "eve", "/orgs/acme/users/ben/transfer", `{}`, 400},
+		{"empty toOrgId", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":""}`, 400},
+		{"malformed body", "eve", "/orgs/acme/users/ben/transfer", `{`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got transferResponse
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("bad response %q: %v", body, err)
+	}
+	if got != (transferResponse{ID: "ben", OrgID: "globex"}) {
+		t.Fatalf("got %+v want {ID:ben OrgID:globex}", got)
+	}
+}
+
+func TestTransferMovesUserOutOfOldOrg(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: got %d: %s", code, body)
+	}
+	// ben can no longer read acme projects, even ones he was a member of.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reading acme project after transfer: got %d want 404", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/legacy/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reading archived acme project after transfer: got %d want 404", code)
+	}
+}
+
+func TestTransferLeavesProjectsAndUnassignsTasks(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: got %d: %s", code, body)
+	}
+	// ben was a contributor on web (t1 is his) and legacy (t5 is his). Both
+	// memberships end with the transfer, so both tasks are unassigned.
+	for _, path := range []string{"/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		code, body := do(t, h, "GET", path, "ann", "")
+		if code != 200 {
+			t.Fatalf("GET %s: got %d: %s", path, code, body)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.AssigneeID != "" {
+			t.Fatalf("%s still assigned to %q after transfer", path, task.AssigneeID)
+		}
+	}
+}
+
+func TestTransferKeepsOtherAssignments(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: got %d: %s", code, body)
+	}
+	// t2 is cat's and must not change.
+	code, body := do(t, h, "GET", "/projects/web/tasks/t2", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "cat" {
+		t.Fatalf("t2 assignee = %q, want cat", task.AssigneeID)
+	}
+}
+
+func TestTransferClearsOrgAdmin(t *testing.T) {
+	h := newServer()
+	// eve is an acme org admin. After she moves to globex she must not keep
+	// admin rights, so she cannot read the globex project gx (she is not a member).
+	if code, body := do(t, h, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: got %d: %s", code, body)
+	}
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "eve", ""); code != 404 {
+		t.Fatalf("eve reading globex project as non-member after transfer: got %d want 404", code)
+	}
+}
+
+func TestTransferAdminCannotMoveUsersAfterMovingOut(t *testing.T) {
+	h := newServer()
+	// After eve leaves acme she is no longer an acme admin, so she cannot move ben.
+	if code, body := do(t, h, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: got %d: %s", code, body)
+	}
+	if code, _ := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 404 {
+		t.Fatalf("got %d want 404 (eve is no longer in acme)", code)
+	}
+}
