+// orgRegistry is the whole handler-visible surface under /orgs/{orgID}.
+type orgRegistry struct {
+	db    model.DB
+	authz model.OrgAuthz
+}
+
+// orgTransformer authenticates the caller and builds the actor's
+// authorization object for {orgID}. Other organizations stop here (404).
+func orgTransformer(conn *sql.DB) tanukirpc.Transformer[*rootRegistry, *orgRegistry] {
+	return tanukirpc.NewTransformer(func(ctx tanukirpc.Context[*rootRegistry]) (*orgRegistry, error) {
+		actor, err := model.Authenticate(ctx, conn, ctx.Request().Header.Get("X-User"))
+		if err != nil {
+			return nil, err
+		}
+		authz, err := model.NewOrgAuthz(actor, chi.URLParam(ctx.Request(), "orgID"))
+		if err != nil {
+			return nil, err
+		}
+		return &orgRegistry{db: conn, authz: authz}, nil
+	})
+}
+
+type transferRequest struct {
+	ToOrgID string `json:"toOrgId" validate:"required"`
+}
+
+type transferResponse struct {
+	ID    string `json:"id"`
+	OrgID string `json:"orgId"`
+}
+
+func transferUser(ctx tanukirpc.Context[*orgRegistry], req transferRequest) (*transferResponse, error) {
+	reg := ctx.Registry()
+	u, err := model.NewUserTable().Transfer(ctx, reg.db, reg.authz, chi.URLParam(ctx.Request(), "uid"), req.ToOrgID)
+	if err != nil {
+		return nil, err
+	}
+	return &transferResponse{ID: u.ID, OrgID: u.Org}, nil
+}
