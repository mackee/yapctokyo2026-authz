+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"admin removes", "eve", "/orgs/acme/users/ben", 204},
+		{"user without memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"non admin", "ann", "/orgs/acme/users/ben", 403},
+		{"other org hidden", "eve", "/orgs/globex/users/gus", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatal(code)
+	}
+	// ben lost access to every project, archived ones included.
+	for _, p := range []string{"web", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ben", ""); code != 404 {
+			t.Fatalf("%s: got %d want 404", p, code)
+		}
+	}
+	// His tasks are unassigned; others are untouched.
+	for id, want := range map[string]string{"t1": "", "t5": "", "t2": "cat"} {
+		p := "web"
+		if id == "t5" {
+			p = "legacy"
+		}
+		_, body := do(t, h, "GET", "/projects/"+p+"/tasks/"+id, "eve", "")
+		var task Task
+		json.Unmarshal([]byte(body), &task)
+		if task.Assignee != want {
+			t.Fatalf("%s assignee %q want %q", id, task.Assignee, want)
+		}
+	}
+	// Other members keep their roles.
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t2", "cat", `{"status":"done"}`); code != 200 {
+		t.Fatalf("cat lost access: %d", code)
+	}
+	// The globex organization is unaffected.
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks/t6", "gus", ""); code != 200 {
+		t.Fatalf("gus: %d", code)
+	}
+}
