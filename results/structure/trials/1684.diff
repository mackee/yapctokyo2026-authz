+// MembershipTableMoveInput is the input of MembershipTable.Move.
+type MembershipTableMoveInput struct {
+	UserID      string
+	ToProjectID string
+}
+
+// Move moves the member from the source project (the authorization object's)
+// to the destination project, keeping the role: the member leaves the source
+// and joins the destination. The actor must manage both projects. The
+// destination is looked up only after the actor passes the source check, so a
+// caller who cannot manage the source learns nothing about the destination.
+// All or nothing.
+func (*MembershipTable) Move(ctx context.Context, db DB, from ProjectAuthz, in MembershipTableMoveInput) (*Membership, error) {
+	if from.ProjectID() == in.ToProjectID {
+		return nil, deny(ErrInvalid, "the member must move to a different project")
+	}
+	if err := from.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	to, err := NewProjectAuthz(ctx, db, from.Actor(), in.ToProjectID)
+	if err != nil {
+		return nil, err
+	}
+	if err := to.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveMember(ctx, tx, from.ProjectID(), to.ProjectID(), in.UserID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if m, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
