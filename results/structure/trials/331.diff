+// ManageProject may change the membership of one project. Managers only.
+type ManageProject interface {
+	ReadProject
+	// RemoveMember removes userID from the project. Tasks of the project that
+	// were assigned to that user become unassigned. A user who is not a member
+	// is 404.
+	RemoveMember(userID string) error
+}
+
+type manageProject struct{ readProject }
+
+func (p *manageProject) RemoveMember(userID string) error {
+	return p.ps.as.a.db.update(func(x *tx) error {
+		agg, err := loadRemoveMember(x, p.ps.pid, userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		agg.save(x)
+		return nil
+	})
+}
