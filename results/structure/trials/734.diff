diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..8c18f12
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,87 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestMemberRoleDenied(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"contributor", "ben", "/projects/web/members/cat", `{"role":"viewer"}`, 403},
+		{"viewer", "dan", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"org admin reads but is not manager", "eve", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"manager of another project only", "ann", "/projects/ops/members/cat", `{"role":"viewer"}`, 403},
+		{"non member", "hal", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"other org", "gus", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"anonymous", "", "/projects/web/members/ben", `{"role":"viewer"}`, 401},
+		{"unknown user", "zed", "/projects/web/members/ben", `{"role":"viewer"}`, 401},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"target in other org", "ann", "/projects/web/members/gus", `{"role":"viewer"}`, 404},
+		{"target not in project", "ivy", "/projects/ops/members/ben", `{"role":"viewer"}`, 404},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"unknown role", "ann", "/projects/web/members/ben", `{"role":"owner"}`, 400},
+		{"missing role", "ann", "/projects/web/members/ben", `{}`, 400},
+		{"malformed body", "ann", "/projects/web/members/ben", `{`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestMemberRoleResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 2 || got["userId"] != "ben" || got["role"] != "viewer" {
+		t.Fatalf("unexpected body %s", body)
+	}
+}
+
+// A role change takes effect for the member's later requests on the same server.
+func TestMemberRoleTakesEffect(t *testing.T) {
+	h := newServer()
+
+	// ben is a contributor: may create a task for himself.
+	if code, body := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x","assignee":"ben"}`); code != 200 {
+		t.Fatalf("before: got %d body=%s", code, body)
+	}
+
+	if code, body := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote: got %d body=%s", code, body)
+	}
+	if code, body := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Fatalf("after demote: got %d body=%s", code, body)
+	}
+
+	// dan is a viewer: promoted to contributor, he may create tasks again.
+	if code, body := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`); code != 200 {
+		t.Fatalf("promote: got %d body=%s", code, body)
+	}
+	if code, body := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("after promote: got %d body=%s", code, body)
+	}
+}
+
+// A promoted manager can change roles too.
+func TestPromotedManagerCanChangeRoles(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "PUT", "/projects/web/members/cat", "ann", `{"role":"manager"}`); code != 200 {
+		t.Fatalf("promote: got %d body=%s", code, body)
+	}
+	if code, body := do(t, h, "PUT", "/projects/web/members/ben", "cat", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("promoted manager: got %d body=%s", code, body)
+	}
+}
