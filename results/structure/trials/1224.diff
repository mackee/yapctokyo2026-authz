+// orgTransformer authenticates the caller and builds the actor's authorization
+// object for {orgID}. An organization other than the caller's stops here (404).
+func orgTransformer(conn *sql.DB) tanukirpc.Transformer[*rootRegistry, *orgRegistry] {
+	return tanukirpc.NewTransformer(func(ctx tanukirpc.Context[*rootRegistry]) (*orgRegistry, error) {
+		actor, err := model.Authenticate(ctx, conn, ctx.Request().Header.Get("X-User"))
+		if err != nil {
+			return nil, err
+		}
+		authz, err := model.NewOrgAuthz(actor, chi.URLParam(ctx.Request(), "orgID"))
+		if err != nil {
+			return nil, err
+		}
+		return &orgRegistry{db: conn, authz: authz}, nil
+	})
+}
