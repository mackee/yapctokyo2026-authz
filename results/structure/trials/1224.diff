+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben", 204},
+		{"project manager is not org admin", "ann", "/orgs/acme/users/cat", 403},
+		{"contributor", "cat", "/orgs/acme/users/dan", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"other org's admin", "eve", "/orgs/globex/users/gus", 404},
+		{"org that is not the caller's", "ann", "/orgs/globex/users/gus", 404},
+		{"target in another org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+// taskAssignee returns the assignee of a task as user sees it.
+func taskAssignee(t *testing.T, h http.Handler, user, path string) string {
+	t.Helper()
+	code, body := do(t, h, "GET", path, user, "")
+	if code != 200 {
+		t.Fatalf("GET %s: got %d", path, code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	return task.AssigneeID
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove ben: got %d want 204", code)
+	}
+	// Idempotent: a second removal of a user in no project is still 204.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove ben again: got %d want 204", code)
+	}
+
+	// ben is no longer a member of web or legacy (archived, but removal still applies).
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads web: got %d want 404", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/legacy/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads legacy: got %d want 404", code)
+	}
+	// ben is still a known user: the request is not 401.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code == 401 {
+		t.Fatal("ben should still authenticate")
+	}
+
+	// Tasks ben held in those projects are unassigned; other assignments are kept.
+	if got := taskAssignee(t, h, "ann", "/projects/web/tasks/t1"); got != "" {
+		t.Fatalf("t1 assignee: got %q want unassigned", got)
+	}
+	if got := taskAssignee(t, h, "ann", "/projects/legacy/tasks/t5"); got != "" {
+		t.Fatalf("t5 assignee: got %q want unassigned", got)
+	}
+	if got := taskAssignee(t, h, "ann", "/projects/web/tasks/t2"); got != "cat" {
+		t.Fatalf("t2 assignee: got %q want cat", got)
+	}
+
+	// ben can no longer be assigned in web.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ann", `{"title":"x","assignee":"ben"}`); code != 400 {
+		t.Fatalf("assign ben: got %d want 400", code)
+	}
+
+	// Other members are untouched.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ann", ""); code != 200 {
+		t.Fatalf("ann reads web: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat reads web: got %d want 200", code)
+	}
+}
+
+func TestRemoveOrgUserKeepsOtherOrgs(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/cat", "eve", ""); code != 204 {
+		t.Fatalf("remove cat: got %d want 204", code)
+	}
+	// cat's assignment in ops (acme) is removed with cat's membership there.
+	if got := taskAssignee(t, h, "ann", "/projects/ops/tasks/t4"); got != "" {
+		t.Fatalf("t4 assignee: got %q want unassigned", got)
+	}
+	// Globex is untouched: gus still reads gx.
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatalf("gus reads gx: got %d want 200", code)
+	}
+	if got := taskAssignee(t, h, "gus", "/projects/gx/tasks/t6"); got != "gus" {
+		t.Fatalf("t6 assignee: got %q want gus", got)
+	}
+}
