+// RemoveFromOrgProjects removes the user from every project of the authorization
+// object's organization, and unassigns the user's tasks in those projects. The
+// user's organization membership itself is not changed. Removing a user who is
+// in no project is a no-op. Only org admins may do this.
+func (*UserTable) RemoveFromOrgProjects(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanManageMembers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveOrgUser(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
