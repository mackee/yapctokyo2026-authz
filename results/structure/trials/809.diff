+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"contributor own task", "cat", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 200},
+		{"contributor own task back", "cat", "/projects/ops/tasks/t4", `{"toProjectId":"web"}`, 200},
+		{"contributor other's task", "cat", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"contributor unassigned task", "cat", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 403},
+		{"manager both any task", "ivy", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 200},
+		{"manager source viewer dest", "ann", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"viewer source, manager dest", "ann", "/projects/ops/tasks/t4", `{"toProjectId":"web"}`, 403},
+		{"viewer source, dest not member", "dan", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 404},
+		{"org admin", "eve", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"non member source", "hal", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 404},
+		{"cross org source", "gus", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 404},
+		{"dest not member", "ben", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 404},
+		{"dest missing", "ann", "/projects/web/tasks/t1", `{"toProjectId":"nope"}`, 404},
+		{"dest other org", "ivy", "/projects/web/tasks/t1", `{"toProjectId":"gx"}`, 404},
+		{"dest archived", "ben", "/projects/web/tasks/t1", `{"toProjectId":"legacy"}`, 409},
+		{"source archived", "ann", "/projects/legacy/tasks/t5", `{"toProjectId":"web"}`, 409},
+		{"same project", "ann", "/projects/web/tasks/t1", `{"toProjectId":"web"}`, 400},
+		{"missing toProjectId", "ann", "/projects/web/tasks/t1", `{}`, 400},
+		{"bad body", "ann", "/projects/web/tasks/t1", `nope`, 400},
+		{"task in other project", "ann", "/projects/web/tasks/t4", `{"toProjectId":"legacy"}`, 404},
+		{"anonymous", "", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 401},
+		{"unknown user", "zed", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsTask(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d: %s", code, body)
+	}
+	var moved Task
+	if err := json.Unmarshal([]byte(body), &moved); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", Assignee: "cat"}
+	if moved != want {
+		t.Fatalf("moved response: got %+v want %+v", moved, want)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks/t2", "ivy", ""); code != 200 {
+		t.Fatalf("task not readable in destination: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t2", "ivy", ""); code != 404 {
+		t.Fatalf("task still in source: %d", code)
+	}
+}
