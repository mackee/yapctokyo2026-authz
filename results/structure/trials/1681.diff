+// updateRolesAggregate changes the roles of several existing members of one
+// project. It does not add members, so the organization rule holds for the
+// members it changes.
+type updateRolesAggregate struct {
+	projectID string
+	members   []*Membership // the members to change, ordered by user ID
+	roles     []string      // roles[i] is the new role of members[i]
+}
+
+func loadUpdateRoles(ctx context.Context, tx DB, projectID string, in MembershipTableUpdateRolesInput) (*updateRolesAggregate, error) {
+	userIDs := make([]string, 0, len(in.Roles))
+	for userID := range in.Roles {
+		userIDs = append(userIDs, userID)
+	}
+	sort.Strings(userIDs)
+	a := &updateRolesAggregate{projectID: projectID}
+	for _, userID := range userIDs {
+		m, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "every user must be a member of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		a.members = append(a.members, m)
+		a.roles = append(a.roles, in.Roles[userID])
+	}
+	return a, nil
+}
+
+func (a *updateRolesAggregate) validate() error {
+	for _, role := range a.roles {
+		if !validRoles[role] {
+			return deny(ErrInvalid, "role must be manager, contributor or viewer")
+		}
+	}
+	return nil
+}
+
+// apply changes every role and returns the project's members after the change.
+func (a *updateRolesAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for i, m := range a.members {
+		if err := m.changeRole(ctx, tx, a.roles[i]); err != nil {
+			return nil, err
+		}
+	}
+	return NewMembershipTable().ListByProject(ctx, tx, a.projectID)
+}
