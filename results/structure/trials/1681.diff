+func TestUpdateMembersRoles(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got []memberRole
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("response is not a member list: %v: %s", err, body)
+	}
+	// The whole member list after the change, ordered by user ID.
+	want := []memberRole{
+		{"ann", "manager"}, {"ben", "viewer"}, {"cat", "contributor"}, {"dan", "contributor"}, {"ivy", "manager"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+	// The change is saved: ben is a viewer now and cannot create tasks, dan can.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Fatalf("ben after change: POST got %d want 403", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("dan after change: POST got %d want 200", code)
+	}
+}
+
+func TestUpdateMembersAllOrNothing(t *testing.T) {
+	cases := []struct {
+		name, body string
+	}{
+		{"not a member", `{"roles":{"ben":"viewer","dan":"contributor","hal":"viewer"}}`},
+		{"other org user", `{"roles":{"ben":"viewer","dan":"contributor","gus":"viewer"}}`},
+		{"unknown user", `{"roles":{"ben":"viewer","dan":"contributor","zed":"viewer"}}`},
+		{"invalid role", `{"roles":{"ben":"viewer","dan":"contributor","cat":"owner"}}`},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			if code, body := do(t, h, "PUT", "/projects/web/members", "ann", c.body); code != 400 {
+				t.Fatalf("got %d want 400: %s", code, body)
+			}
+			// Nothing changed: ben is still a contributor and dan still a viewer.
+			if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 200 {
+				t.Fatalf("ben changed despite the error: POST got %d want 200", code)
+			}
+			if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 403 {
+				t.Fatalf("dan changed despite the error: POST got %d want 403", code)
+			}
+		})
+	}
+}
+
+func TestUpdateMembersRequestAndAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager", "ann", "web", `{"roles":{"cat":"viewer"}}`, 200},
+		{"manager of the project only", "ivy", "ops", `{"roles":{"ann":"contributor"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"viewer in this project", "ann", "ops", `{"roles":{"cat":"viewer"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"cat":"viewer"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"cat":"viewer"}}`, 404},
+		{"no such project", "ann", "nope", `{"roles":{"cat":"viewer"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"cat":"viewer"}}`, 401},
+		{"unknown user", "zed", "web", `{"roles":{"cat":"viewer"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"member not in project", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"bad json", "ann", "web", `{"roles":`, 400},
+		{"invalid role value", "ann", "web", `{"roles":{"cat":"owner"}}`, 400},
+		// Body errors come before the access rules, so a contributor gets 400 here, not 403.
+		{"invalid role value by contributor", "ben", "web", `{"roles":{"cat":"owner"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+		})
+	}
+}
