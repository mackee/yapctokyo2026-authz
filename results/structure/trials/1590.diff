+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestFreezeAuthorization(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager", "ann", "/projects/web/freeze", 200},
+		{"contributor", "ben", "/projects/web/freeze", 403},
+		{"viewer", "dan", "/projects/web/freeze", 403},
+		{"org admin", "eve", "/projects/web/freeze", 403},
+		{"non member", "hal", "/projects/web/freeze", 404},
+		{"other org", "gus", "/projects/web/freeze", 404},
+		{"anonymous", "", "/projects/web/freeze", 401},
+		{"archived", "ann", "/projects/legacy/freeze", 409},
+		{"missing project", "ann", "/projects/nope/freeze", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestFreezeDeniedChangesNothing(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ben", ""); code != 403 {
+		t.Fatalf("got %d", code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"doing"}`); code != 200 {
+		t.Fatalf("contributor lost write access: %d", code)
+	}
+}
+
+func TestFreezeResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got []struct{ UserID, Role string }
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []string{"ann", "ben", "cat", "dan", "ivy"}
+	if len(got) != len(want) {
+		t.Fatalf("got %s", body)
+	}
+	for i, m := range got {
+		if m.UserID != want[i] || m.Role != "viewer" {
+			t.Fatalf("member %d: %+v", i, m)
+		}
+	}
+}
+
+func TestFreezeBlocksTaskChanges(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatal(code, body)
+	}
+	for _, user := range []string{"ann", "ivy", "ben", "cat", "dan", "eve"} {
+		for _, c := range []struct{ method, path, body string }{
+			{"POST", "/projects/web/tasks", `{"title":"x"}`},
+			{"PATCH", "/projects/web/tasks/t1", `{"title":"x"}`},
+			{"PATCH", "/projects/web/tasks/t3", `{"status":"done"}`},
+			{"DELETE", "/projects/web/tasks/t3", ""},
+			{"POST", "/projects/web/freeze", ""},
+		} {
+			code, body := do(t, h, c.method, c.path, user, c.body)
+			if code != 403 {
+				t.Errorf("%s %s %s: got %d want 403: %s", user, c.method, c.path, code, body)
+			}
+		}
+	}
+	// still readable, and nothing changed
+	code, body := do(t, h, "GET", "/projects/web/tasks", "dan", "")
+	if code != 200 {
+		t.Fatal(code)
+	}
+	var tasks []Task
+	json.Unmarshal([]byte(body), &tasks)
+	if len(tasks) != 3 {
+		t.Fatalf("want 3 tasks, got %d", len(tasks))
+	}
+}
+
+// Frozen members are viewers, who cannot be assignees (model rule), so the
+// project's assignments are cleared.
+func TestFreezeClearsAssignees(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatal(code, body)
+	}
+	_, body := do(t, h, "GET", "/projects/web/tasks", "ann", "")
+	var tasks []Task
+	json.Unmarshal([]byte(body), &tasks)
+	for _, task := range tasks {
+		if task.AssigneeID != "" {
+			t.Errorf("task %s still assigned to %s", task.ID, task.AssigneeID)
+		}
+	}
+}
+
+func TestFreezeOnlyAffectsThatProject(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatal(code, body)
+	}
+	if code, body := do(t, h, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"doing"}`); code != 200 {
+		t.Fatalf("ops affected: %d %s", code, body)
+	}
+	if code, body := do(t, h, "POST", "/projects/ops/tasks", "ivy", `{"title":"y","assignee":"cat"}`); code != 200 {
+		t.Fatalf("ops affected: %d %s", code, body)
+	}
+}
