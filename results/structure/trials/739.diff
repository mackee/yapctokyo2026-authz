+func TestRemoveMemberUnassignsTasks(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "DELETE", "/projects/web/members/cat", "ann", ""); code != 204 {
+		t.Fatalf("remove: got %d body=%s", code, body)
+	}
+	if code, _ := do(t, srv, "DELETE", "/projects/web/members/cat", "ann", ""); code != 404 {
+		t.Fatalf("second remove: got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "cat", ""); code != 404 {
+		t.Fatalf("removed member still reads project: got %d want 404", code)
+	}
+	code, body := do(t, srv, "GET", "/projects/web/tasks/t2", "ann", "")
+	if code != 200 {
+		t.Fatalf("get task: got %d body=%s", code, body)
+	}
+	if !strings.Contains(body, `"assignee":""`) {
+		t.Fatalf("task still assigned to removed member: %s", body)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "cat", ""); code != 200 {
+		t.Fatalf("membership in other project was affected: got %d", code)
+	}
+}
