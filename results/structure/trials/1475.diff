--- /dev/null
+++ b/transfer_test.go
@@ -0,0 +1,103 @@
+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestTransferAccess(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin moves user", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 200},
+		{"non admin member", "ann", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 403},
+		{"viewer", "dan", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 403},
+		{"caller in other org", "gus", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 404},
+		{"anonymous", "", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown user", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"user in other org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"unknown org in path", "gus", "/orgs/initech/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"unknown target org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"initech"}`, 400},
+		{"missing target org", "eve", "/orgs/acme/users/ben/transfer", `{}`, 400},
+		{"bad body", "eve", "/orgs/acme/users/ben/transfer", `not json`, 400},
+		{"same org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"acme"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	want := `{"id":"ben","orgId":"globex"}` + "\n"
+	if body != want {
+		t.Fatalf("got body %q want %q", body, want)
+	}
+}
+
+func TestTransferMovesAccess(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: got %d: %s", code, body)
+	}
+
+	// ben loses the acme projects he was a member of.
+	for _, path := range []string{"/projects/web/tasks", "/projects/legacy/tasks/t5"} {
+		if code, _ := do(t, srv, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("ben GET %s: got %d want 404", path, code)
+		}
+	}
+	// The tasks he held there are unassigned.
+	for _, id := range []string{"t1", "t5"} {
+		var assignee string
+		if err := srv.(*appHandler).db.QueryRow(`SELECT assignee FROM tasks WHERE id = ?`, id).Scan(&assignee); err != nil {
+			t.Fatal(err)
+		}
+		if assignee != "" {
+			t.Fatalf("task %s still assigned to %q", id, assignee)
+		}
+	}
+	// Other people's tasks are untouched.
+	if code, body := do(t, srv, "GET", "/projects/web/tasks/t2", "ann", ""); code != 200 || !strings.Contains(body, `"assignee":"cat"`) {
+		t.Fatalf("t2 changed: %d %s", code, body)
+	}
+
+	// ben is in globex now but has no membership there, so the globex project is hidden.
+	if code, _ := do(t, srv, "GET", "/projects/gx/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben GET gx: got %d want 404", code)
+	}
+	// ben can no longer be assigned acme tasks.
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "ann", `{"title":"x","assignee":"ben"}`); code != 400 {
+		t.Fatalf("assign to transferred user: got %d want 400", code)
+	}
+}
+
+func TestTransferDropsOrgAdmin(t *testing.T) {
+	srv := newServer()
+	// eve is acme's only org admin; she moves herself to globex.
+	if code, body := do(t, srv, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var orgID string
+	var admin bool
+	if err := srv.(*appHandler).db.QueryRow(`SELECT org_id, org_admin FROM users WHERE id = 'eve'`).Scan(&orgID, &admin); err != nil {
+		t.Fatal(err)
+	}
+	if orgID != "globex" || admin {
+		t.Fatalf("eve: org %q admin %v; want globex, false", orgID, admin)
+	}
+	// Her old admin rights do not reach acme projects.
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "eve", ""); code != 404 {
+		t.Fatalf("eve GET ops: got %d want 404", code)
+	}
+}
