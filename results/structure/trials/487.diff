diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..d719f7a
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,110 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestSetMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager demotes manager to viewer", "ann", "/projects/web/members/ivy", `{"role":"viewer"}`, 200},
+		{"manager promotes viewer", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"manager promotes to manager", "ann", "/projects/web/members/ben", `{"role":"manager"}`, 200},
+		{"same role", "ann", "/projects/web/members/ann", `{"role":"manager"}`, 200},
+		{"contributor", "ben", "/projects/web/members/cat", `{"role":"viewer"}`, 403},
+		{"viewer", "dan", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"org admin", "eve", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"non member", "hal", "/projects/web/members/dan", `{"role":"contributor"}`, 404},
+		{"other org", "gus", "/projects/web/members/dan", `{"role":"contributor"}`, 404},
+		{"anonymous", "", "/projects/web/members/dan", `{"role":"contributor"}`, 401},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"unknown role", "ann", "/projects/web/members/dan", `{"role":"owner"}`, 400},
+		{"missing role", "ann", "/projects/web/members/dan", `{}`, 400},
+		{"malformed body", "ann", "/projects/web/members/dan", `{"role":`, 400},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"contributor"}`, 404},
+		{"target member of other project", "ann", "/projects/web/members/gus", `{"role":"contributor"}`, 404},
+		{"viewer with assigned task", "ann", "/projects/web/members/cat", `{"role":"viewer"}`, 400},
+		{"unknown project", "ann", "/projects/nope/members/dan", `{"role":"contributor"}`, 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMemberRoleResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.UserID != "dan" || got.Role != "contributor" {
+		t.Fatalf("got %s", body)
+	}
+}
+
+// The new role takes effect for later requests on the same database.
+func TestSetMemberRoleTakesEffect(t *testing.T) {
+	srv := newServer()
+	createBody := `{"title":"x"}`
+
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "dan", createBody); code != 403 {
+		t.Fatalf("viewer create: got %d want 403", code)
+	}
+	if code, _ := do(t, srv, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`); code != 200 {
+		t.Fatalf("promote: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "dan", createBody); code != 200 {
+		t.Fatalf("contributor create: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "PUT", "/projects/web/members/dan", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "dan", createBody); code != 403 {
+		t.Fatalf("demoted create: got %d want 403", code)
+	}
+}
+
+// A viewer cannot be made from a member who still has assigned tasks; once the
+// tasks are reassigned, the demotion goes through.
+func TestDemoteRequiresReassignedTasks(t *testing.T) {
+	srv := newServer()
+
+	if code, _ := do(t, srv, "PUT", "/projects/web/members/cat", "ann", `{"role":"viewer"}`); code != 400 {
+		t.Fatalf("demote with task: got %d want 400", code)
+	}
+	if code, body := do(t, srv, "PATCH", "/projects/web/tasks/t2", "ann", `{"assignee":"ann"}`); code != 200 {
+		t.Fatalf("reassign: got %d want 200: %s", code, body)
+	}
+	if code, _ := do(t, srv, "PUT", "/projects/web/members/cat", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote after reassign: got %d want 200", code)
+	}
+}
+
+// A role is per project: changing ivy's role in web leaves her role in ops alone.
+func TestSetMemberRoleOnlyInProject(t *testing.T) {
+	srv := newServer()
+
+	if code, _ := do(t, srv, "PUT", "/projects/web/members/ivy", "ann", `{"role":"contributor"}`); code != 200 {
+		t.Fatalf("demote ivy in web: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "PUT", "/projects/web/members/dan", "ivy", `{"role":"contributor"}`); code != 403 {
+		t.Fatalf("ivy as web contributor: got %d want 403", code)
+	}
+	if code, _ := do(t, srv, "PUT", "/projects/ops/members/ann", "ivy", `{"role":"contributor"}`); code != 200 {
+		t.Fatalf("ivy still manages ops: got %d want 200", code)
+	}
+}
