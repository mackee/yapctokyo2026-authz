+// setMemberRoleAggregate changes the role of one project member.
+type setMemberRoleAggregate struct {
+	member   *Membership
+	role     string
+	assigned []*Task // the member's tasks in the project; loaded when the new role is viewer
+}
+
+func loadSetMemberRole(ctx context.Context, tx DB, projectID, userID, role string) (*setMemberRoleAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "member not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &setMemberRoleAggregate{member: m, role: role}
+	if role == RoleViewer {
+		if a.assigned, err = m.AssignedTasks(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	return a, nil
+}
+
+func (a *setMemberRoleAggregate) validate() error {
+	if len(a.assigned) > 0 {
+		return deny(ErrInvalid, "member has assigned tasks; reassign them before making the member a viewer")
+	}
+	return nil
+}
+
+func (a *setMemberRoleAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.member.setRole(ctx, tx, a.role); err != nil {
+		return nil, err
+	}
+	return a.member, nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
