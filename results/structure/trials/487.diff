@@ -2,12 +2,45 @@ package model
 
 import "context"
 
-// MembershipTable reads the memberships table.
+// MembershipTable is the memberships table.
+//
+// Find and List* read rows. SetRole is an operation: it takes the database (a
+// *Conn or a *Tx), the authorization object of the project and its input, asks
+// the authorization object whether the actor may perform it, then runs the
+// operation's aggregate (aggregate.go) in a transaction.
 type MembershipTable struct{}
 
 // NewMembershipTable returns the memberships table.
 func NewMembershipTable() *MembershipTable { return &MembershipTable{} }
 
+var validRoles = map[string]bool{RoleManager: true, RoleContributor: true, RoleViewer: true}
+
+// SetRole changes the role of the project's member userID. Only managers may
+// do it, and not in an archived project. The member must exist (ErrNotFound).
+func (*MembershipTable) SetRole(ctx context.Context, db DB, authz ProjectAuthz, userID, role string) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if !validRoles[role] {
+		return nil, deny(ErrInvalid, "invalid role")
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadSetMemberRole(ctx, tx, authz.ProjectID(), userID, role)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		m, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
+
 // Find returns the membership of the user in the project, or ErrNoRows.
 func (*MembershipTable) Find(ctx context.Context, db DB, projectID, userID string) (*Membership, error) {
 	var m Membership
