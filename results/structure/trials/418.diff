+		t.Fatalf("t1 assignee = %q, want ben", got)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "ann", ""); code != 200 {
+		t.Fatalf("ann reads ops after removing cat: got %d", code)
+	}
+}
