@@ -144,3 +144,55 @@ func loadDeleteTask(ctx context.Context, x *Tx, taskID string) (*deleteTaskAggre
 func (a *deleteTaskAggregate) validate() error { return nil }
 
 func (a *deleteTaskAggregate) apply(ctx context.Context, x *Tx) error { return a.task.destroy(ctx, x) }
+
+// removeOrgUserAggregate removes one user from the projects of one organization.
+type removeOrgUserAggregate struct {
+	memberships []*Membership // the user's memberships in the organization's projects
+}
+
+func loadRemoveOrgUser(ctx context.Context, x *Tx, orgID, userID string) (*removeOrgUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, x, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != orgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	all, err := u.Memberships(ctx, x)
+	if err != nil {
+		return nil, err
+	}
+	a := &removeOrgUserAggregate{}
+	for _, m := range all {
+		p, err := m.Project(ctx, x)
+		if err != nil {
+			return nil, err
+		}
+		if p.Org == orgID {
+			a.memberships = append(a.memberships, m)
+		}
+	}
+	return a, nil
+}
+
+// apply unassigns the user's tasks in each project, then deletes the membership,
+// so the rule "an assignee is a member of the task's project" still holds.
+func (a *removeOrgUserAggregate) apply(ctx context.Context, x *Tx) error {
+	for _, m := range a.memberships {
+		tasks, err := m.AssignedTasks(ctx, x)
+		if err != nil {
+			return err
+		}
+		for _, t := range tasks {
+			if err := t.unassign(ctx, x); err != nil {
+				return err
+			}
+		}
+		if err := m.destroy(ctx, x); err != nil {
+			return err
+		}
+	}
+	return nil
+}
