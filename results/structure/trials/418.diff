+// RemoveFromOrg removes the user from every project of the organization. The
+// user's memberships in those projects are deleted, and the tasks the user was
+// assigned in them are unassigned. The user row itself is kept.
+func (*UserTable) RemoveFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanRemoveUsers(); err != nil {
+		return err
+	}
+	return db.update(ctx, func(x *Tx) error {
+		agg, err := loadRemoveOrgUser(ctx, x, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		return agg.apply(ctx, x)
+	})
+}
