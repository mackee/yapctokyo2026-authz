+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes user without projects", "eve", "/orgs/acme/users/hal", 204},
+		{"org admin removes manager", "eve", "/orgs/acme/users/ivy", 204},
+		{"member is not org admin", "ann", "/orgs/acme/users/cat", 403},
+		{"viewer is not org admin", "dan", "/orgs/acme/users/cat", 403},
+		{"anonymous", "", "/orgs/acme/users/cat", 401},
+		{"unknown actor", "zed", "/orgs/acme/users/cat", 401},
+		{"other org admin", "gus", "/orgs/acme/users/cat", 404},
+		{"org does not exist", "eve", "/orgs/nope/users/cat", 404},
+		{"user in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func fetchTask(t *testing.T, h http.Handler, user, path string) Task {
+	t.Helper()
+	code, body := do(t, h, "GET", path, user, "")
+	if code != 200 {
+		t.Fatalf("GET %s as %s: got %d", path, user, code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	return task
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	srv := newServer()
+
+	// ben is a contributor in web and legacy (archived), and holds t1 and t5.
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove ben: got %d", code)
+	}
+
+	// Memberships are gone in every project of the org, including archived ones.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads web: got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/legacy/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads legacy: got %d want 404", code)
+	}
+
+	// Tasks ben held are unassigned, in every project; other tasks are kept.
+	if got := fetchTask(t, srv, "ann", "/projects/web/tasks/t1").AssigneeID; got != "" {
+		t.Fatalf("t1 assignee = %q, want unassigned", got)
+	}
+	if got := fetchTask(t, srv, "eve", "/projects/legacy/tasks/t5").AssigneeID; got != "" {
+		t.Fatalf("t5 assignee = %q, want unassigned", got)
+	}
+	if got := fetchTask(t, srv, "ann", "/projects/web/tasks/t2").AssigneeID; got != "cat" {
+		t.Fatalf("t2 assignee = %q, want cat", got)
+	}
+
+	// ben can no longer be assigned to a task in the project.
+	if code, _ := do(t, srv, "PATCH", "/projects/web/tasks/t1", "ann", `{"assignee":"ben"}`); code != 400 {
+		t.Fatalf("assign removed ben: got %d want 400", code)
+	}
+
+	// Removing again is harmless.
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove ben again: got %d", code)
+	}
+}
+
+func TestRemoveOrgUserKeepsOtherProjects(t *testing.T) {
+	srv := newServer()
+
