diff --git a/transfer.go b/transfer.go
new file mode 100644
index 0000000..e24e496
--- /dev/null
+++ b/transfer.go
@@ -0,0 +1,101 @@
+package main
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"net/http"
+)
+
+type transferRequest struct {
+	ToOrgID string `json:"toOrgId"`
+}
+
+type transferResponse struct {
+	ID    string `json:"id"`
+	OrgID string `json:"orgId"`
+}
+
+// transferUser moves a user from the org in the path to toOrgId.
+//
+// Only an org admin of that org may transfer its users. The user's org admin
+// flag is cleared, because admin rights apply to one organization only.
+// Project memberships are left as they are; they stop granting access while the
+// user is outside the project's org.
+func (s *server) transferUser(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	caller, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if caller == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	orgID := r.PathValue("orgID")
+	if caller.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	if !caller.OrgAdmin {
+		writeError(w, 403, "only org admins may transfer users")
+		return
+	}
+	target, err := findUser(ctx, s.db, r.PathValue("uid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if target == nil || target.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	var req transferRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	if req.ToOrgID == "" {
+		writeError(w, 400, "toOrgId is required")
+		return
+	}
+	if req.ToOrgID == orgID {
+		writeError(w, 400, "user is already in that organization")
+		return
+	}
+	known, err := orgExists(ctx, s.db, req.ToOrgID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if !known {
+		writeError(w, 400, "unknown organization")
+		return
+	}
+	// The org_id condition guards against the user having moved since the lookup above.
+	res, err := s.db.ExecContext(ctx, `UPDATE users SET org_id = ?, org_admin = 0 WHERE id = ? AND org_id = ?`,
+		req.ToOrgID, target.ID, orgID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if n, err := res.RowsAffected(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	} else if n == 0 {
+		writeError(w, 404, "not found")
+		return
+	}
+	writeJSON(w, 200, transferResponse{ID: target.ID, OrgID: req.ToOrgID})
+}
+
+// orgExists reports whether any user or project belongs to the organization.
+// There is no organizations table, so an org is known once something refers to it.
+func orgExists(ctx context.Context, db *sql.DB, orgID string) (bool, error) {
+	var n int
+	err := db.QueryRowContext(ctx,
+		`SELECT EXISTS(SELECT 1 FROM users WHERE org_id = ?) OR EXISTS(SELECT 1 FROM projects WHERE org_id = ?)`,
+		orgID, orgID).Scan(&n)
+	return n == 1, err
+}
diff --git a/transfer_test.go b/transfer_test.go
new file mode 100644
index 0000000..a0b5843
--- /dev/null
+++ b/transfer_test.go
@@ -0,0 +1,89 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func transferPath(orgID, uid string) string {
+	return "/orgs/" + orgID + "/users/" + uid + "/transfer"
+}
+
+// requireJSONError fails unless body is an {"error": "..."} document.
+func requireJSONError(t *testing.T, body string) {
+	t.Helper()
+	var e map[string]string
+	if err := json.Unmarshal([]byte(body), &e); err != nil || e["error"] == "" {
+		t.Fatalf("want JSON error body, got %q", body)
+	}
+}
+
+func TestTransferSucceeds(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", transferPath("acme", "ben"), "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d (%s) want 200", code, body)
+	}
+	var got struct {
+		ID    string `json:"id"`
+		OrgID string `json:"orgId"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("bad body %q: %v", body, err)
+	}
+	if got.ID != "ben" || got.OrgID != "globex" {
+		t.Fatalf("got %+v, want {ben globex}", got)
+	}
+	// ben is no longer in acme, so acme's projects are no longer readable by ben.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("after transfer, read of old-org project got %d want 404", code)
+	}
+}
+
+// acme's org admin must not keep admin rights after moving to globex.
+func TestTransferClearsOrgAdmin(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", transferPath("acme", "eve"), "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("got %d (%s) want 200", code, body)
+	}
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "eve", ""); code != 404 {
+		t.Fatalf("transferred admin read globex project got %d want 404", code)
+	}
+}
+
+func TestTransferRejects(t *testing.T) {
+	cases := []struct {
+		name, orgID, uid, caller, body string
+		want                           int
+		// reader is a user who must still be able to read web after the call,
+		// showing that a rejected transfer did not move anyone.
+		reader string
+	}{
+		{"anonymous", "acme", "ben", "", `{"toOrgId":"globex"}`, 401, "ben"},
+		{"unknown caller", "acme", "ben", "zed", `{"toOrgId":"globex"}`, 401, "ben"},
+		{"manager is not org admin", "acme", "ben", "ann", `{"toOrgId":"globex"}`, 403, "ben"},
+		{"contributor is not org admin", "acme", "cat", "ben", `{"toOrgId":"globex"}`, 403, "cat"},
+		{"caller in other org", "acme", "ben", "gus", `{"toOrgId":"globex"}`, 404, "ben"},
+		{"path org is not caller's org", "globex", "gus", "eve", `{"toOrgId":"acme"}`, 404, "ben"},
+		{"unknown user", "acme", "zed", "eve", `{"toOrgId":"globex"}`, 404, "ben"},
+		{"user in other org", "acme", "gus", "eve", `{"toOrgId":"acme"}`, 404, "ben"},
+		{"bad json", "acme", "ben", "eve", `{`, 400, "ben"},
+		{"missing toOrgId", "acme", "ben", "eve", `{}`, 400, "ben"},
+		{"empty toOrgId", "acme", "ben", "eve", `{"toOrgId":""}`, 400, "ben"},
+		{"unknown target org", "acme", "ben", "eve", `{"toOrgId":"initech"}`, 400, "ben"},
+		{"same org", "acme", "ben", "eve", `{"toOrgId":"acme"}`, 400, "ben"},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			code, body := do(t, h, "POST", transferPath(c.orgID, c.uid), c.caller, c.body)
+			if code != c.want {
+				t.Fatalf("got %d (%s) want %d", code, body, c.want)
+			}
+			requireJSONError(t, body)
+			if code, _ := do(t, h, "GET", "/projects/web/tasks", c.reader, ""); code != 200 {
+				t.Fatalf("%s lost access to web after rejected transfer: got %d", c.reader, code)
+			}
+		})
+	}
+}
