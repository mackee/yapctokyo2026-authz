diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..9038366
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,86 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"testing"
+)
+
+func TestSetMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, project, uid, body string
+		want                           int
+	}{
+		{"contributor forbidden", "ben", "web", "dan", `{"role":"contributor"}`, 403},
+		{"viewer forbidden", "dan", "web", "ann", `{"role":"viewer"}`, 403},
+		{"org admin forbidden", "eve", "web", "dan", `{"role":"contributor"}`, 403},
+		{"non member", "hal", "web", "dan", `{"role":"contributor"}`, 404},
+		{"other org", "gus", "web", "dan", `{"role":"contributor"}`, 404},
+		{"anonymous", "", "web", "dan", `{"role":"contributor"}`, 401},
+		{"unknown user", "zed", "web", "dan", `{"role":"contributor"}`, 401},
+		{"archived", "ann", "legacy", "ben", `{"role":"viewer"}`, 409},
+		{"target not a member", "ann", "web", "hal", `{"role":"contributor"}`, 404},
+		{"target in other org", "ann", "web", "gus", `{"role":"contributor"}`, 404},
+		{"invalid role", "ann", "web", "dan", `{"role":"owner"}`, 400},
+		{"missing role", "ann", "web", "dan", `{}`, 400},
+		{"malformed body", "ann", "web", "dan", `{"role":`, 400},
+		{"demote member with assigned task", "ann", "web", "ben", `{"role":"viewer"}`, 400},
+		{"promote viewer", "ann", "web", "dan", `{"role":"manager"}`, 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "PUT", "/projects/"+c.project+"/members/"+c.uid, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestSetMemberRoleResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["userId"] != "dan" || got["role"] != "contributor" {
+		t.Fatalf("got %v", got)
+	}
+}
+
+// TestSetMemberRolePersists checks that a role change is visible to later
+// requests on the same server, and that a rejected change changes nothing.
+func TestSetMemberRolePersists(t *testing.T) {
+	srv := newServer()
+
+	// dan is a viewer: cannot create tasks.
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 403 {
+		t.Fatalf("viewer create: got %d want 403", code)
+	}
+	if code, body := do(t, srv, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`); code != 200 {
+		t.Fatalf("promote: got %d body=%s", code, body)
+	}
+	// dan is now a contributor: can create an unassigned task.
+	if code, body := do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("contributor create: got %d body=%s", code, body)
+	}
+
+	// ben has t1 assigned: demotion is rejected and ben keeps the contributor role.
+	if code, _ := do(t, srv, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 400 {
+		t.Fatalf("demote with tasks: got %d want 400", code)
+	}
+	if code, body := do(t, srv, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ben after rejected demotion: got %d body=%s", code, body)
+	}
+
+	// Demoting dan, who has no assigned tasks, takes effect immediately.
+	if code, body := do(t, srv, "PUT", "/projects/web/members/dan", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote: got %d body=%s", code, body)
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"y"}`); code != http.StatusForbidden {
+		t.Fatalf("viewer create after demotion: got %d want 403", code)
+	}
+}
