+// ---- operations -----------------------------------------------------------------------
+
+// SetRole changes the role of the project member userID. Only managers may do
+// it (CanManageMembers). The member must exist (else ErrNotFound), the role must
+// be one of the project roles, and a member who is the assignee of a task must
+// stay a contributor or manager (else ErrInvalid); the change is all or nothing.
+func (mt *MembershipTable) SetRole(ctx context.Context, db DB, authz ProjectAuthz, userID, role string) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if !validRoles[role] {
+		return nil, deny(ErrInvalid, "role must be manager, contributor or viewer")
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadSetMemberRole(ctx, tx, authz.ProjectID(), userID, role)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		m, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
+
