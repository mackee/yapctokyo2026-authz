+package main
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func contains(s, sub string) bool { return strings.Contains(s, sub) }
+
+func TestFreezeStatus(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager", "ann", "/projects/web/freeze", 200},
+		{"contributor", "ben", "/projects/web/freeze", 403},
+		{"viewer", "dan", "/projects/web/freeze", 403},
+		{"org admin non-member", "eve", "/projects/web/freeze", 403},
+		{"non-member", "hal", "/projects/web/freeze", 404},
+		{"other org", "gus", "/projects/web/freeze", 404},
+		{"missing project", "ann", "/projects/nope/freeze", 404},
+		{"unknown user", "nobody", "/projects/web/freeze", 401},
+		{"no user", "", "/projects/web/freeze", 401},
+		{"archived", "ann", "/projects/legacy/freeze", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d, want %d (%s)", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestFreezeResult(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ivy", "")
+	if code != 200 {
+		t.Fatalf("got %d (%s)", code, body)
+	}
+	var got []struct{ UserID, Role string }
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []string{"ann", "ben", "cat", "dan", "ivy"}
+	if len(got) != len(want) {
+		t.Fatalf("members = %+v", got)
+	}
+	for i, m := range got {
+		if m.UserID != want[i] || m.Role != "viewer" {
+			t.Fatalf("member %d = %+v", i, m)
+		}
+	}
+	if want := `"userId":"ann","role":"viewer"`; !contains(body, want) {
+		t.Fatalf("body %s lacks %s", body, want)
+	}
+}
+
+func TestFreezeBlocksTaskChanges(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: %d (%s)", code, body)
+	}
+	cases := []struct {
+		name, method, path, user, body string
+		want                           int
+	}{
+		{"former manager creates", "POST", "/projects/web/tasks", "ann", `{"title":"x"}`, 403},
+		{"former manager updates", "PATCH", "/projects/web/tasks/t3", "ann", `{"status":"done"}`, 403},
+		{"former manager deletes", "DELETE", "/projects/web/tasks/t3", "ivy", "", 403},
+		{"former contributor updates", "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`, 403},
+		{"freeze again", "POST", "/projects/web/freeze", "ann", "", 403},
+		{"still readable", "GET", "/projects/web/tasks", "ann", "", 200},
+		{"other project unaffected", "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`, 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			if code, body := do(t, h, c.method, c.path, c.user, c.body); code != c.want {
+				t.Fatalf("got %d, want %d (%s)", code, c.want, body)
+			}
+		})
+	}
+}
+
+// Freezing demotes assignees, so the project's tasks are unassigned and the
+// "assignee is a writer" rule still holds.
+func TestFreezeUnassignsTasks(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: %d (%s)", code, body)
+	}
+	_, body := do(t, h, "GET", "/projects/web/tasks", "ann", "")
+	var tasks []Task
+	if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+		t.Fatal(err)
+	}
+	for _, tk := range tasks {
+		if tk.AssigneeID != "" {
+			t.Fatalf("task %s still assigned to %s", tk.ID, tk.AssigneeID)
+		}
+	}
+	_, body = do(t, h, "GET", "/projects/ops/tasks/t4", "ann", "")
+	if !contains(body, `"assignee":"cat"`) {
+		t.Fatalf("ops task changed: %s", body)
+	}
+}
