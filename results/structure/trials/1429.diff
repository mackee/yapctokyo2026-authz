+package model
+
+import "context"
+
+// FrozenMember is the JSON shape of a member after a project is frozen.
+type FrozenMember struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// Freeze turns every member of the project (managers included) into a viewer
+// and returns the resulting member list, ordered by user ID. Only managers may
+// freeze, and not an archived project.
+func (*ProjectTable) Freeze(ctx context.Context, db DB, authz ProjectAuthz) ([]FrozenMember, error) {
+	if err := authz.CanFreeze(); err != nil {
+		return nil, err
+	}
+	out := []FrozenMember{}
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadFreezeProject(ctx, tx, authz.ProjectID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		ms, err := agg.apply(ctx, tx)
+		if err != nil {
+			return err
+		}
+		for _, m := range ms {
+			out = append(out, FrozenMember{UserID: m.UserID, Role: m.Role})
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
