+// Offboarding removes the user from every project (archived ones too) and
+// unassigns their tasks; everyone else is untouched.
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("got %d want 204", code)
+	}
+	// ben no longer reads web or legacy (404: not a member).
+	for _, p := range []string{"web", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ben", ""); code != 404 {
+			t.Fatalf("ben reads %s: got %d want 404", p, code)
+		}
+	}
+	assignee := func(project, id string) string {
+		t.Helper()
+		code, body := do(t, h, "GET", "/projects/"+project+"/tasks/"+id, "eve", "")
+		if code != 200 {
+			t.Fatalf("get %s: %d", id, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		return task.AssigneeID
+	}
+	if got := assignee("web", "t1"); got != "" {
+		t.Fatalf("t1 assignee %q, want unassigned", got)
+	}
+	if got := assignee("legacy", "t5"); got != "" {
+		t.Fatalf("t5 assignee %q, want unassigned", got)
+	}
+	if got := assignee("web", "t2"); got != "cat" {
+		t.Fatalf("t2 assignee %q, want cat", got)
+	}
+	// others keep their access.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat reads web: %d", code)
+	}
+	// ben can no longer be assigned anything.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ann", `{"title":"x","assignee":"ben"}`); code != 400 {
+		t.Fatalf("assigning removed user: got %d want 400", code)
+	}
+}
+
+func TestRemoveOrgUserAcrossProjects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/cat", "eve", ""); code != 204 {
+		t.Fatalf("got %d want 204", code)
+	}
+	for _, p := range []string{"web", "ops"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "cat", ""); code != 404 {
+			t.Fatalf("cat reads %s: got %d want 404", p, code)
+		}
+	}
+	code, body := do(t, h, "GET", "/projects/ops/tasks/t4", "eve", "")
+	if code != 200 || !strings.Contains(body, `"assignee":""`) {
+		t.Fatalf("t4: %d %s", code, body)
+	}
+}
