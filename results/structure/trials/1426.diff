+func TestRemoveOrgUserStatus(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes viewer", "eve", "/orgs/acme/users/dan", 204},
+		{"org admin without memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"project manager is not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"user removes self", "ben", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown actor", "zed", "/orgs/acme/users/ben", 401},
+		{"other org", "eve", "/orgs/globex/users/gus", 404},
+		{"missing org", "eve", "/orgs/nope/users/ben", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
