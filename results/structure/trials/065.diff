+// exportOrgTasks returns every task of every project in the path org, for audit.
+// It is restricted to org admins because it spans projects the caller may not
+// be a member of.
+func (s *server) exportOrgTasks(w http.ResponseWriter, r *http.Request) {
+	s.store.mu.Lock()
+	defer s.store.mu.Unlock()
+
+	user := s.store.User(r.Header.Get("X-User"))
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	orgID := r.PathValue("orgID")
+	if user.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	if !user.OrgAdmin {
+		writeError(w, 403, "only org admins may export")
+		return
+	}
+	tasks := s.store.TasksInOrg(orgID)
+	if tasks == nil {
+		tasks = []*Task{}
+	}
+	writeJSON(w, 200, tasks)
+}
