+// TasksInOrg returns the tasks of every project belonging to orgID, including
+// archived projects, sorted by project ID and then task ID.
+func (s *Store) TasksInOrg(orgID string) []*Task {
+	var out []*Task
+	for _, t := range s.tasks {
+		if p := s.projects[t.ProjectID]; p != nil && p.OrgID == orgID {
+			out = append(out, t)
+		}
+	}
+	sort.Slice(out, func(i, j int) bool {
+		if out[i].ProjectID != out[j].ProjectID {
+			return out[i].ProjectID < out[j].ProjectID
+		}
+		return out[i].ID < out[j].ID
+	})
+	return out
+}
