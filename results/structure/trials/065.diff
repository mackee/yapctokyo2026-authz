+func TestExportOrgTasks(t *testing.T) {
+	code, body := do(t, newServer(), "GET", "/orgs/acme/export", "eve", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var rows []map[string]any
+	if err := json.Unmarshal([]byte(body), &rows); err != nil {
+		t.Fatal(err)
+	}
+	// acme has t1-t5 across web, ops and archived legacy; t6 is globex's.
+	if len(rows) != 5 {
+		t.Fatalf("want 5 tasks, got %d: %s", len(rows), body)
+	}
+	wantIDs := []string{"t5", "t4", "t1", "t2", "t3"} // sorted by projectId (legacy, ops, web), then id
+	for i, row := range rows {
+		if len(row) != 5 {
+			t.Fatalf("row %d has %d fields, want exactly id,projectId,title,status,assignee: %v", i, len(row), row)
+		}
+		for _, k := range []string{"id", "projectId", "title", "status", "assignee"} {
+			if _, ok := row[k]; !ok {
+				t.Fatalf("row %d missing %q: %v", i, k, row)
+			}
+		}
+		if row["id"] != wantIDs[i] {
+			t.Fatalf("row %d id = %v, want %s", i, row["id"], wantIDs[i])
+		}
+		if row["projectId"] == "gx" {
+			t.Fatalf("leaked other org task: %v", row)
+		}
+	}
+}
+
+func TestExportOrgTasksAccess(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/export", 200},
+		{"other org admin", "eve", "/orgs/globex/export", 404},
+		{"same org manager", "ann", "/orgs/acme/export", 403},
+		{"same org contributor", "ben", "/orgs/acme/export", 403},
+		{"same org non member", "hal", "/orgs/acme/export", 403},
+		{"org member of other org", "gus", "/orgs/acme/export", 404},
+		{"globex non admin", "gus", "/orgs/globex/export", 403},
+		{"missing org", "eve", "/orgs/nope/export", 404},
+		{"anonymous", "", "/orgs/acme/export", 401},
+		{"unknown user", "zed", "/orgs/acme/export", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "GET", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
