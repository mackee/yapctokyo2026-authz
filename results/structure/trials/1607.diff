+type moveRequest struct {
+	ToProjectID string `json:"toProjectId" validate:"required"`
+}
+
+// MemberMoved is the JSON shape of a completed member move.
+type MemberMoved struct {
+	UserID    string `json:"userId"`
+	ProjectID string `json:"projectId"`
+	Role      string `json:"role"`
+}
+
+func moveMember(ctx tanukirpc.Context[*projectRegistry], req moveRequest) (*MemberMoved, error) {
+	reg := ctx.Registry()
+	// The destination must be readable by the actor too (else 404).
+	to, err := model.NewProjectAuthz(ctx, reg.db, reg.authz.Actor(), req.ToProjectID)
+	if err != nil {
+		return nil, err
+	}
+	m, err := model.NewMembershipTable().Move(ctx, reg.db, reg.authz, to, chi.URLParam(ctx.Request(), "uid"))
+	if err != nil {
+		return nil, err
+	}
+	return &MemberMoved{UserID: m.UserID, ProjectID: m.ProjectID, Role: m.Role}, nil
+}
