+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestMoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, project, target, body string
+		want                              int
+	}{
+		{"manager of both moves contributor", "ivy", "web", "ben", `{"toProjectId":"ops"}`, 200},
+		{"manager of both moves viewer", "ivy", "web", "dan", `{"toProjectId":"ops"}`, 200},
+		{"manager of source, viewer of dest", "ann", "web", "ben", `{"toProjectId":"ops"}`, 403},
+		{"contributor", "ben", "web", "cat", `{"toProjectId":"legacy"}`, 403},
+		{"contributor, unreadable destination", "ben", "web", "cat", `{"toProjectId":"ops"}`, 404},
+		{"org admin", "eve", "web", "ben", `{"toProjectId":"ops"}`, 403},
+		{"non member of source", "hal", "web", "ben", `{"toProjectId":"ops"}`, 404},
+		{"unknown destination", "ivy", "web", "ben", `{"toProjectId":"nope"}`, 404},
+		{"destination in other org", "ivy", "web", "ben", `{"toProjectId":"gx"}`, 404},
+		{"target not a member", "ivy", "web", "hal", `{"toProjectId":"ops"}`, 404},
+		{"already in destination", "ivy", "web", "cat", `{"toProjectId":"ops"}`, 400},
+		{"same project", "ivy", "web", "ben", `{"toProjectId":"web"}`, 400},
+		{"missing body field", "ivy", "web", "ben", `{}`, 400},
+		{"anonymous", "", "web", "ben", `{"toProjectId":"ops"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", "/projects/"+c.project+"/members/"+c.target+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestMoveMemberResultAndEffects(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["userId"] != "ben" || got["projectId"] != "ops" || got["role"] != "contributor" {
+		t.Fatalf("unexpected response %v", got)
+	}
+
+	// ben left web: no longer a member there, and his web task is unassigned.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben should no longer read web, got %d", code)
+	}
+	_, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "" {
+		t.Fatalf("t1 should be unassigned, got %q", task.AssigneeID)
+	}
+	// ben is a member of ops now.
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben should read ops, got %d", code)
+	}
+	// moving him again from web is 404 (not a member anymore).
+	if code, _ := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`); code != 404 {
+		t.Fatalf("second move got %d", code)
+	}
+}
+
+func TestMoveMemberArchived(t *testing.T) {
+	// ann manages both web and legacy (archived).
+	h := newServer()
+	// legacy -> web: ann is manager of both, but legacy is archived.
+	code, body := do(t, h, "POST", "/projects/legacy/members/ben/move", "ann", `{"toProjectId":"web"}`)
+	if code != 409 {
+		t.Fatalf("archived source got %d: %s", code, body)
+	}
+	// web -> legacy: archived destination.
+	code, body = do(t, h, "POST", "/projects/web/members/dan/move", "ann", `{"toProjectId":"legacy"}`)
+	if code != 409 {
+		t.Fatalf("archived destination got %d: %s", code, body)
+	}
+}
