+// UserTable is the users table. Find reads rows; RemoveFromOrg is the API
+// operation that takes a user out of an organization's projects.
 type UserTable struct{}
 
 // NewUserTable returns the users table.
 func NewUserTable() *UserTable { return &UserTable{} }
 
+// RemoveFromOrg removes the user from every project of the organization: the
+// user's memberships in those projects are deleted, and the tasks the user
+// was assigned in them are unassigned, so no task keeps an assignee who is no
+// longer a member. The user's organization and org admin flag are unchanged.
+// Only org admins of the organization may do this (else ErrForbidden); a user
+// who is not in the organization, or does not exist, is ErrNotFound.
+func (*UserTable) RemoveFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanManageMembers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveOrgUser(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
+
