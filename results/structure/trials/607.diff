+func TestSetMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager promotes", "ann", "/projects/web/members/ben", `{"role":"manager"}`, 200},
+		{"manager demotes unassigned", "ann", "/projects/web/members/ivy", `{"role":"viewer"}`, 200},
+		{"manager demotes with assigned tasks", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 400},
+		{"manager invalid role", "ann", "/projects/web/members/ben", `{"role":"owner"}`, 400},
+		{"manager empty role", "ann", "/projects/web/members/ben", `{"role":""}`, 400},
+		{"manager bad body", "ann", "/projects/web/members/ben", `not json`, 400},
+		{"manager target not member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"manager target other org", "ann", "/projects/web/members/gus", `{"role":"viewer"}`, 404},
+		{"target member of other project only", "ivy", "/projects/ops/members/ben", `{"role":"viewer"}`, 404},
+		{"manager of other project as caller", "ann", "/projects/ops/members/cat", `{"role":"viewer"}`, 403},
+		{"contributor cannot", "cat", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"viewer cannot", "dan", "/projects/web/members/ben", `{"role":"manager"}`, 403},
+		{"org admin cannot", "eve", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"non member", "hal", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"other org", "gus", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"anonymous", "", "/projects/web/members/ben", `{"role":"viewer"}`, 401},
+		{"unknown user", "zed", "/projects/web/members/ben", `{"role":"viewer"}`, 401},
+		{"missing project", "ann", "/projects/nope/members/ben", `{"role":"viewer"}`, 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMemberRoleResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members/dan", "ann", `{"role":"viewer"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	if body != "{\"userId\":\"dan\",\"role\":\"viewer\"}\n" {
+		t.Fatalf("unexpected body %q", body)
+	}
+}
+
+func TestSetMemberRolePersists(t *testing.T) {
+	h := newServer()
+
+	// dan is a viewer; promote to contributor, then he can create a task.
+	if code, body := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`); code != 200 {
+		t.Fatalf("promote: got %d: %s", code, body)
+	}
+	if code, body := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("create after promote: got %d: %s", code, body)
+	}
+
+	// ben has t1 assigned; demotion is blocked until t1 is unassigned.
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 400 {
+		t.Fatalf("demote with assigned task: got %d want 400", code)
+	}
+	if code, body := do(t, h, "PATCH", "/projects/web/tasks/t1", "ann", `{"assignee":""}`); code != 200 {
+		t.Fatalf("unassign: got %d: %s", code, body)
+	}
+	if code, body := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote after unassign: got %d: %s", code, body)
+	}
+	// ben is now a viewer, so he can no longer write.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Fatalf("write as demoted viewer: got %d want 403", code)
+	}
+}
