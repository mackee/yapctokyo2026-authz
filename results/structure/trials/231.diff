+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes", "eve", "/orgs/acme/users/ann", 204},
+		{"non admin", "ann", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"other org admin path", "gus", "/orgs/acme/users/ben", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatal(code)
+	}
+	// Removed user can no longer authenticate.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 401 {
+		t.Fatalf("removed user got %d want 401", code)
+	}
+	// Their tasks (including in archived projects) are unassigned.
+	for _, p := range []string{"/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		code, body := do(t, h, "GET", p, "ann", "")
+		if code != 200 {
+			t.Fatal(code)
+		}
+		var task Task
+		json.Unmarshal([]byte(body), &task)
+		if task.Assignee != "" {
+			t.Fatalf("%s still assigned to %q", p, task.Assignee)
+		}
+	}
+	// Cannot be assigned any more.
+	code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ann", `{"assignee":"ben"}`)
+	if code != 400 {
+		t.Fatalf("assign removed user got %d want 400", code)
+	}
+	// Other orgs' users are untouched.
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatal(code)
+	}
+	// Removing twice -> 404.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 404 {
+		t.Fatalf("second removal got %d want 404", code)
+	}
+}
+
+func TestRemovedOrgAdminLosesAccess(t *testing.T) {
