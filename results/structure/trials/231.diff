+// RemoveUser offboards a user: drops their membership in every project
+// (archived ones included), unassigns their tasks, and deletes the user
+// record so the identity (including any OrgAdmin flag) no longer authenticates.
+func (s *Store) RemoveUser(userID string) {
+	for _, m := range s.members {
+		delete(m, userID)
+	}
+	for _, t := range s.tasks {
+		if t.Assignee == userID {
+			t.Assignee = ""
+		}
+	}
+	delete(s.users, userID)
+}
