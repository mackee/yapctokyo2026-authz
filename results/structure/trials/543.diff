+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"admin removes", "eve", "/orgs/acme/users/ben", 204},
+		{"non admin", "ann", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"other org admin path", "gus", "/orgs/acme/users/ben", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatal(code)
+	}
+	// ben was in web (contributor) and legacy (archived): now a non-member of both.
+	for _, p := range []string{"web", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ben", ""); code != 404 {
+			t.Fatalf("ben still sees %s: %d", p, code)
+		}
+	}
+	// his tasks are unassigned, others untouched.
+	for id, want := range map[string]string{"t1": "", "t5": "", "t2": "cat"} {
+		p := "web"
+		if id == "t5" {
+			p = "legacy"
+		}
+		_, body := do(t, h, "GET", "/projects/"+p+"/tasks/"+id, "eve", "")
+		var task Task
+		json.Unmarshal([]byte(body), &task)
+		if task.Assignee != want {
+			t.Fatalf("%s assignee %q want %q", id, task.Assignee, want)
+		}
+	}
+	// other members unaffected; repeating the call is still 204.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatal(code)
+	}
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatal(code)
+	}
+}
+
+func TestRemoveOrgUserOtherOrgUntouched(t *testing.T) {
+	h := newServer()
+	do(t, h, "DELETE", "/orgs/acme/users/ann", "eve", "")
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatal(code)
+	}
+}
