+type transferRequest struct {
+	ToOrgID string `json:"toOrgId"`
+}
+
+// transferUser moves a user to another organization (see transferOutcome in
+// spec/taskboard.qnt). Only an org admin of the path org may do it. The user
+// leaves the old org completely: admin flag cleared, project memberships
+// removed and their tasks unassigned, so the model invariants keep holding.
+func (s *server) transferUser(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	caller, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if caller == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	orgID := r.PathValue("orgID")
+	if caller.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	if !caller.OrgAdmin {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	target, err := findUser(ctx, s.db, r.PathValue("uid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if target == nil || target.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	var req transferRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || req.ToOrgID == "" || req.ToOrgID == orgID {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	var known bool
+	if err := s.db.QueryRowContext(ctx, `SELECT EXISTS (SELECT 1 FROM users WHERE org_id = ?) OR EXISTS (SELECT 1 FROM projects WHERE org_id = ?)`,
+		req.ToOrgID, req.ToOrgID).Scan(&known); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if !known {
+		writeError(w, 400, "unknown organization")
+		return
+	}
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+	for _, q := range []string{
+		`UPDATE users SET org_id = ?, org_admin = 0 WHERE id = ?`,
+		`DELETE FROM memberships WHERE user_id = ?`,
+		`UPDATE tasks SET assignee = '' WHERE assignee = ?`,
+	} {
+		args := []any{target.ID}
+		if strings.HasPrefix(q, "UPDATE users") {
+			args = []any{req.ToOrgID, target.ID}
+		}
+		if _, err := tx.ExecContext(ctx, q, args...); err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, map[string]string{"id": target.ID, "orgId": req.ToOrgID})
+}
