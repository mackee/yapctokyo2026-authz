+// transferUserAggregate moves one user to another organization. Project
+// members must belong to the project's organization, so memberships in
+// projects of any other organization are dropped, along with the user's tasks
+// there (which become unassigned).
+type transferUserAggregate struct {
+	user    *User
+	toOrg   string
+	stale   []*Membership // memberships in projects outside toOrg
+	orphans []*Task       // tasks assigned to the user through those memberships
+	exists  bool          // toOrg is a known organization
+}
+
+func loadTransferUser(ctx context.Context, tx DB, fromOrg string, in UserTableTransferInput) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, in.UserID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != fromOrg {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	a := &transferUserAggregate{user: u, toOrg: in.ToOrg}
+	if a.exists, err = NewUserTable().OrgExists(ctx, tx, in.ToOrg); err != nil {
+		return nil, err
+	}
+	if !a.exists {
+		if a.exists, err = NewProjectTable().OrgExists(ctx, tx, in.ToOrg); err != nil {
+			return nil, err
+		}
+	}
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, m := range ms {
+		p, err := m.Project(ctx, tx)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "membership must belong to an existing project")
+		} else if err != nil {
+			return nil, err
+		}
+		if p.Org == in.ToOrg {
+			continue
+		}
+		ts, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.stale = append(a.stale, m)
+		a.orphans = append(a.orphans, ts...)
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if a.toOrg == "" {
+		return deny(ErrInvalid, "toOrgId must not be empty")
+	}
+	if a.toOrg == a.user.Org {
+		return deny(ErrInvalid, "user already belongs to that organization")
+	}
+	if !a.exists {
+		return deny(ErrInvalid, "destination organization does not exist")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	for _, t := range a.orphans {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	for _, m := range a.stale {
+		if err := m.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.user.moveTo(ctx, tx, a.toOrg); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
+
