+// Transfer moves the user to another organization. The user must belong to
+// the authorization object's organization. The user's memberships in projects
+// of other organizations are removed, their tasks there are unassigned, and
+// the org admin flag is cleared.
+func (ut *UserTable) Transfer(ctx context.Context, db DB, authz OrgAuthz, in UserTableTransferInput) (*User, error) {
+	if err := authz.CanTransferUsers(); err != nil {
+		return nil, err
+	}
+	var u *User
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadTransferUser(ctx, tx, authz.OrgID(), in)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		u, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return u, nil
+}
