+// freezeProjectAggregate makes every member of one project a viewer.
+type freezeProjectAggregate struct {
+	members  []*Membership      // project.Memberships
+	assigned map[string][]*Task // member.AssignedTasks, by user ID
+}
+
+func loadFreezeProject(ctx context.Context, tx DB, projectID string) (*freezeProjectAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	members, err := p.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	a := &freezeProjectAggregate{members: members, assigned: map[string][]*Task{}}
+	for _, m := range members {
+		tasks, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.assigned[m.UserID] = tasks
+	}
+	return a, nil
+}
+
+// validate checks the rules the change touches: viewers cannot be assignees,
+// so apply releases the tasks of the members it demotes.
+func (a *freezeProjectAggregate) validate() error { return nil }
+
+func (a *freezeProjectAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for _, m := range a.members {
+		if err := m.demote(ctx, tx); err != nil {
+			return nil, err
+		}
+		for _, t := range a.assigned[m.UserID] {
+			if err := t.unassign(ctx, tx); err != nil {
+				return nil, err
+			}
+		}
+	}
+	return a.members, nil
+}
+
