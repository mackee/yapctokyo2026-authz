+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"unknown project", "ann", "nope", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got []map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err, body)
+	}
+	want := []string{"ann", "ben", "cat", "dan", "ivy"}
+	if len(got) != len(want) {
+		t.Fatalf("want %d members, got %v", len(want), got)
+	}
+	for i, m := range got {
+		if len(m) != 2 || m["userId"] != want[i] || m["role"] != "viewer" {
+			t.Fatalf("member %d: got %v", i, m)
+		}
+	}
+}
+
+func TestFreezeBlocksAllWrites(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatal(code, body)
+	}
+	writes := []struct {
+		name, user, method, path, body string
+	}{
+		{"manager creates", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"other manager creates", "ivy", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"contributor creates", "ben", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"manager updates", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"contributor updates own", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"manager deletes", "ann", "DELETE", "/projects/web/tasks/t1", ""},
+		{"freeze again", "ann", "POST", "/projects/web/freeze", ""},
+	}
+	for _, w := range writes {
+		if code, body := do(t, h, w.method, w.path, w.user, w.body); code != 403 {
+			t.Errorf("%s: got %d want 403 (%s)", w.name, code, body)
+		}
+	}
+	// reads still work
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Errorf("read after freeze: got %d", code)
+	}
+}
+
+func TestFreezeKeepsModelRules(t *testing.T) {
+	// An assignee must be a contributor or manager, so freezing releases the
+	// tasks that were assigned to members who just became viewers.
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatal(code, body)
+	}
+	code, body := do(t, h, "GET", "/projects/web/tasks", "dan", "")
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var tasks []Task
+	if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+		t.Fatal(err)
+	}
+	if len(tasks) != 3 {
+		t.Fatalf("freeze must not delete tasks, got %d", len(tasks))
+	}
+	for _, task := range tasks {
+		if task.AssigneeID != "" {
+			t.Errorf("task %s still assigned to %s", task.ID, task.AssigneeID)
+		}
+	}
+}
+
+func TestFreezeIsPerProject(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ivy", ""); code != 200 {
+		t.Fatal(code, body)
+	}
+	// ivy is still a manager of ops, and ops tasks keep their assignee.
+	if code, body := do(t, h, "PATCH", "/projects/ops/tasks/t4", "ivy", `{"status":"done"}`); code != 200 {
+		t.Fatal(code, body)
+	}
+	code, body := do(t, h, "GET", "/projects/ops/tasks/t4", "ivy", "")
+	if code != 200 || !strings.Contains(body, `"assignee":"cat"`) {
+		t.Fatal(code, body)
+	}
+}
