+func members(t *testing.T, h http.Handler, pid string) map[string]string {
+	t.Helper()
+	code, body := do(t, h, "PUT", "/projects/"+pid+"/members", "ann", `{"roles":{"ann":"manager"}}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var ms []struct{ UserID, Role string }
+	if err := json.Unmarshal([]byte(body), &ms); err != nil {
+		t.Fatal(err)
+	}
+	out := map[string]string{}
+	for _, m := range ms {
+		out[m.UserID] = m.Role
+	}
+	return out
+}
+
+func TestUpdateMemberRoles(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager ok", "ann", "web", `{"roles":{"ivy":"viewer","dan":"contributor"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"invalid role", "ann", "web", `{"roles":{"dan":"boss"}}`, 400},
+		{"not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"empty", "ann", "web", `{"roles":{}}`, 400},
+		{"bad body", "ann", "web", `nope`, 400},
+		{"assignee to viewer", "ann", "web", `{"roles":{"ben":"viewer"}}`, 400},
+		{"last manager", "ann", "web", `{"roles":{"ann":"viewer","ivy":"viewer"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRolesResult(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ivy":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	want := `[{"userId":"ann","role":"manager"},{"userId":"ben","role":"contributor"},{"userId":"cat","role":"contributor"},{"userId":"dan","role":"contributor"},{"userId":"ivy","role":"viewer"}]`
+	if strings.TrimSpace(body) != want {
+		t.Fatalf("got %s", body)
+	}
+	// the new roles take effect: dan can now create tasks, ivy cannot.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 201 {
+		t.Fatalf("dan create: %d", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ivy", `{"title":"x"}`); code != 403 {
+		t.Fatalf("ivy create: %d", code)
+	}
+}
+
+func TestUpdateMemberRolesAtomic(t *testing.T) {
+	h := newServer()
+	// dan is valid, hal is not a member: nothing may change.
+	if code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","hal":"viewer"}}`); code != 400 {
+		t.Fatal(code)
+	}
+	if got := members(t, h, "web")["dan"]; got != "viewer" {
+		t.Fatalf("dan changed to %s", got)
+	}
+	// ben is a task assignee, so demoting him fails even alongside a valid change.
+	if code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","ben":"viewer"}}`); code != 400 {
+		t.Fatal(code)
+	}
+	if ms := members(t, h, "web"); ms["dan"] != "viewer" || ms["ben"] != "contributor" {
+		t.Fatalf("partial change: %v", ms)
+	}
+}
