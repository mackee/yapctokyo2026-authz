 // ---- project capabilities ----------------------------------------------------
 
+// MemberView is the public representation of a project member.
+type MemberView struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// ManageProject is the manager-only capability for project membership.
+type ManageProject interface {
+	// SetRoles changes the roles of existing members in one atomic step.
+	// Every entry must name a current member and a valid role, the project must
+	// keep at least one manager, and the result must satisfy the model
+	// invariants (e.g. a task assignee cannot become a viewer). Otherwise it
+	// returns ErrInvalid and nothing changes. It returns the resulting members.
+	SetRoles(roles map[string]string) ([]MemberView, error)
+}
+
+type manageProject struct{ ps *projectScope }
+
+func (p *manageProject) SetRoles(roles map[string]string) ([]MemberView, error) {
+	if len(roles) == 0 {
+		return nil, deny(ErrInvalid, "roles must not be empty")
+	}
+	var out []MemberView
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		m := s.members[p.ps.pid]
+		for uid, role := range roles {
+			if role != RoleManager && role != RoleContributor && role != RoleViewer {
+				return deny(ErrInvalid, "invalid role for "+uid)
+			}
+			if _, ok := m[uid]; !ok {
+				return deny(ErrInvalid, uid+" is not a member of the project")
+			}
+			m[uid] = role
+		}
+		managers := 0
+		for _, role := range m {
+			if role == RoleManager {
+				managers++
+			}
+		}
+		if managers == 0 {
+			return deny(ErrInvalid, "project must keep at least one manager")
+		}
+		out = s.membersOf(p.ps.pid)
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return out, nil
+}
+
