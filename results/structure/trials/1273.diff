+// OrgExists reports whether the organization has any user or project.
+func (*UserTable) OrgExists(ctx context.Context, db DB, org string) (bool, error) {
+	var n int
+	if err := db.QueryRowContext(ctx,
+		`SELECT (SELECT COUNT(*) FROM users WHERE org_id = ?) + (SELECT COUNT(*) FROM projects WHERE org_id = ?)`,
+		org, org).Scan(&n); err != nil {
+		return false, err
+	}
+	return n > 0, nil
+}
+
+// UserTableTransferInput is the input of UserTable.Transfer.
+type UserTableTransferInput struct {
+	UserID string
+	ToOrg  string
+}
+
+// Transfer moves the user from the authorization object's organization to
+// another one, all or nothing. The user leaves every project of the old
+// organization (memberships are removed, assigned tasks are unassigned) and
+// loses org admin rights.
+func (*UserTable) Transfer(ctx context.Context, db DB, authz OrgAuthz, in UserTableTransferInput) (*User, error) {
+	if err := authz.CanTransferUsers(); err != nil {
+		return nil, err
+	}
+	if in.ToOrg == "" {
+		return nil, deny(ErrInvalid, "toOrgId must not be empty")
+	}
+	var u *User
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadTransferUser(ctx, tx, authz.OrgID(), in)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		u, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return u, nil
+}
