+// ChangeRole sets the role of a member of the project. Only managers may do
+// it (see ProjectAuthz.CanManageMembers). The user must be a member
+// (ErrNotFound), and a member with assigned tasks cannot become a viewer
+// (ErrInvalid).
+func (*MembershipTable) ChangeRole(ctx context.Context, db DB, authz ProjectAuthz, userID, role string) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if !isValidRole(role) {
+		return nil, deny(ErrInvalid, "role must be manager, contributor or viewer")
+	}
+	var m *Membership
+	if err := db.update(ctx, func(x *Tx) error {
+		agg, err := loadChangeRole(ctx, x, authz.ProjectID(), userID, role)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		m, err = agg.apply(ctx, x)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
