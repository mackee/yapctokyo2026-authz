+// changeRoleAggregate changes the role of one project member.
+type changeRoleAggregate struct {
+	membership *Membership
+	role       string
+	assigned   []*Task // the member's tasks in the project; checked when the new role is not a writer role
+}
+
+func loadChangeRole(ctx context.Context, x *Tx, projectID, userID, role string) (*changeRoleAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, x, projectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &changeRoleAggregate{membership: m, role: role}
+	if !isWriterRole(role) {
+		a.assigned, err = m.AssignedTasks(ctx, x)
+		if err != nil {
+			return nil, err
+		}
+	}
+	return a, nil
+}
+
+func (a *changeRoleAggregate) validate() error {
+	// An assignee is a contributor or manager of the task's project.
+	if !isWriterRole(a.role) && len(a.assigned) > 0 {
+		return deny(ErrInvalid, "member has assigned tasks; reassign them before making the member a viewer")
+	}
+	return nil
+}
+
+func (a *changeRoleAggregate) apply(ctx context.Context, x *Tx) (*Membership, error) {
+	if err := a.membership.changeRole(ctx, x, a.role); err != nil {
+		return nil, err
+	}
+	return a.membership, nil
+}
