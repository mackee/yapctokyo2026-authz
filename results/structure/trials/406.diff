+++ b/internal/model/membership_table_test.go
@@ -0,0 +1,90 @@
+package model
+
+import (
+	"context"
+	"errors"
+	"testing"
+)
+
+func roleOf(t *testing.T, conn *Conn, projectID, userID string) string {
+	t.Helper()
+	m, err := NewMembershipTable().Find(context.Background(), conn, projectID, userID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return m.Role
+}
+
+func actorAndProject(t *testing.T, conn *Conn, userID, projectID string) ProjectAuthz {
+	t.Helper()
+	ctx := context.Background()
+	act, err := Authenticate(ctx, conn, userID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	authz, err := NewProjectAuthz(ctx, conn, act, projectID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return authz
+}
+
+func TestChangeRole(t *testing.T) {
+	ctx := context.Background()
+	conn := Open()
+	authz := actorAndProject(t, conn, "ann", "web")
+
+	m, err := NewMembershipTable().ChangeRole(ctx, conn, authz, "dan", RoleContributor)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if m.UserID != "dan" || m.Role != RoleContributor {
+		t.Fatalf("got %+v", m)
+	}
+	if got := roleOf(t, conn, "web", "dan"); got != RoleContributor {
+		t.Fatalf("stored role %q", got)
+	}
+}
+
+func TestChangeRoleRejectedLeavesRoleUnchanged(t *testing.T) {
+	ctx := context.Background()
+	conn := Open()
+	authz := actorAndProject(t, conn, "ann", "web")
+
+	// ben is assigned t1 in web; a viewer cannot be an assignee.
+	_, err := NewMembershipTable().ChangeRole(ctx, conn, authz, "ben", RoleViewer)
+	if !errors.Is(err, ErrInvalid) {
+		t.Fatalf("got %v want ErrInvalid", err)
+	}
+	if got := roleOf(t, conn, "web", "ben"); got != RoleContributor {
+		t.Fatalf("role changed to %q despite rejection", got)
+	}
+}
+
+func TestChangeRoleDenials(t *testing.T) {
+	ctx := context.Background()
+	conn := Open()
+
+	cases := []struct {
+		name      string
+		user, pid string
+		target    string
+		role      string
+		want      error
+	}{
+		{"contributor", "ben", "web", "cat", RoleViewer, ErrForbidden},
+		{"org admin", "eve", "ops", "cat", RoleViewer, ErrForbidden},
+		{"archived", "ann", "legacy", "ben", RoleViewer, ErrArchived},
+		{"target not a member", "ann", "web", "hal", RoleViewer, ErrNotFound},
+		{"unknown role", "ann", "web", "ben", "owner", ErrInvalid},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			authz := actorAndProject(t, conn, c.user, c.pid)
+			_, err := NewMembershipTable().ChangeRole(ctx, conn, authz, c.target, c.role)
+			if !errors.Is(err, c.want) {
+				t.Fatalf("got %v want %v", err, c.want)
+			}
+		})
+	}
+}
