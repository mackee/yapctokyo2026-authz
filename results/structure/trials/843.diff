+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager of both", "ivy", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 200},
+		{"target viewer role", "ann", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 403},
+		{"source contributor", "ben", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 403},
+		{"source viewer", "dan", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin", "eve", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 403},
+		{"non member", "hal", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 404},
+		{"other org", "gus", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 401},
+		{"unknown user", "zed", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 401},
+		{"same project", "ivy", "/projects/web/members/dan/move", `{"toProjectId":"web"}`, 400},
+		{"empty target", "ivy", "/projects/web/members/dan/move", `{}`, 400},
+		{"bad body", "ivy", "/projects/web/members/dan/move", `not json`, 400},
+		{"missing target", "ivy", "/projects/web/members/dan/move", `{"toProjectId":"nope"}`, 404},
+		{"target other org", "ivy", "/projects/web/members/dan/move", `{"toProjectId":"gx"}`, 404},
+		{"target not readable", "ivy", "/projects/web/members/dan/move", `{"toProjectId":"legacy"}`, 404},
+		{"archived target", "ann", "/projects/web/members/cat/move", `{"toProjectId":"legacy"}`, 409},
+		{"archived source", "ann", "/projects/legacy/members/ben/move", `{"toProjectId":"web"}`, 409},
+		{"not a source member", "ivy", "/projects/web/members/hal/move", `{"toProjectId":"ops"}`, 404},
+		{"already in target", "ivy", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveResponseAndMembership(t *testing.T) {
+	srv := newServer()
+	code, body := do(t, srv, "POST", "/projects/web/members/dan/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got moveResponse
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got != (moveResponse{UserID: "dan", ProjectID: "ops", Role: "viewer"}) {
+		t.Fatalf("unexpected response %+v", got)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "dan", ""); code != 200 {
+		t.Fatalf("dan should now read ops, got %d", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "dan", ""); code != 404 {
+		t.Fatalf("dan should no longer read web, got %d", code)
+	}
+}
