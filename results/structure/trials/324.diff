+func (t *manageTask) Move(toProjectID string) (TaskView, error) {
+	if toProjectID == t.ts.ps.pid {
+		return TaskView{}, deny(ErrInvalid, "task is already in that project")
+	}
+	target, err := t.ts.ps.as.Project(toProjectID).Write()
+	if err != nil {
+		return TaskView{}, err
+	}
+	// Same rule as CreateTask: a contributor may only keep tasks assigned to themselves.
+	assignee := t.View().Assignee
+	if target.Role() == RoleContributor && assignee != "" && assignee != t.ts.ps.as.actor.id {
+		return TaskView{}, deny(ErrForbidden, "contributors may only assign tasks to themselves")
+	}
+	var v TaskView
+	err = t.ts.ps.as.a.db.update(func(x *tx) error {
+		agg, err := loadMoveTask(x, t.ts.tid, toProjectID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		v = agg.save(x)
+		return nil
+	})
+	return v, err
+}
