+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"contributor own task", "cat", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 200},
+		{"contributor not own task", "cat", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"manager in both any task", "ivy", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 200},
+		{"archived source", "ann", "/projects/legacy/tasks/t5", `{"toProjectId":"web"}`, 409},
+		{"viewer in dest", "ann", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"not a member of dest", "ben", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 404},
+		{"dest missing", "ann", "/projects/web/tasks/t1", `{"toProjectId":"nope"}`, 404},
+		{"dest other org", "ann", "/projects/web/tasks/t1", `{"toProjectId":"gx"}`, 404},
+		{"org admin cannot write", "eve", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"archived dest", "ann", "/projects/web/tasks/t1", `{"toProjectId":"legacy"}`, 409},
+		{"same project", "ann", "/projects/web/tasks/t1", `{"toProjectId":"web"}`, 400},
+		{"bad body", "ann", "/projects/web/tasks/t1", `{}`, 400},
+		{"task in other project", "ivy", "/projects/web/tasks/t4", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveResult(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/tasks/t2/move", "cat", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", Assignee: "cat"}
+	if task != want {
+		t.Fatalf("got %+v want %+v", task, want)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t2", "ann", ""); code != 404 {
+		t.Fatalf("old location: got %d want 404", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks/t2", "ivy", ""); code != 200 {
+		t.Fatalf("new location: got %d want 200", code)
+	}
+}
