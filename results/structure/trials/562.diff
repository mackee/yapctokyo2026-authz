index 0000000..a8e3f84
--- /dev/null
+++ b/members.go
@@ -0,0 +1,146 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+)
+
+type moveRequest struct {
+	ToProjectID string `json:"toProjectId"`
+}
+
+type moveResponse struct {
+	UserID    string `json:"userId"`
+	ProjectID string `json:"projectId"`
+	Role      string `json:"role"`
+}
+
+// moveMember moves a member from the path project to another project with the
+// same role. Rules:
+//   - the caller must be a manager of BOTH projects (org admins cannot write);
+//   - a destination the caller cannot read -> 404, readable but not manager -> 403;
+//   - either project archived -> 409;
+//   - the user must be a member of the source (404), and not yet of the
+//     destination (409); moving to the same project -> 400;
+//   - tasks in the source assigned to the moved user become unassigned, since
+//     assignees must be project members.
+func (s *server) moveMember(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role, err := findRole(ctx, s.db, project.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req moveRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || req.ToProjectID == "" {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	if req.ToProjectID == project.ID {
+		writeError(w, 400, "destination must be a different project")
+		return
+	}
+	dest, err := findProject(ctx, s.db, req.ToProjectID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if dest == nil || dest.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	destRole, err := findRole(ctx, s.db, dest.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if destRole == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if destRole != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if dest.Archived {
+		writeError(w, 409, "destination project is archived")
+		return
+	}
+	uid := r.PathValue("uid")
+	memberRole, err := findRole(ctx, s.db, project.ID, uid)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if memberRole == "" {
+		writeError(w, 404, "not found")
+		return
+	}
+
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+	// Insert first: the primary key makes a concurrent/duplicate move fail
+	// atomically instead of racing a separate existence check.
+	res, err := tx.ExecContext(ctx, `INSERT OR IGNORE INTO memberships (project_id, user_id, role) VALUES (?, ?, ?)`,
+		dest.ID, uid, memberRole)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if n, _ := res.RowsAffected(); n == 0 {
+		writeError(w, 409, "user is already a member of the destination project")
+		return
+	}
+	res, err = tx.ExecContext(ctx, `DELETE FROM memberships WHERE project_id = ? AND user_id = ?`, project.ID, uid)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if n, _ := res.RowsAffected(); n == 0 {
+		writeError(w, 404, "not found")
+		return
+	}
+	if _, err := tx.ExecContext(ctx, `UPDATE tasks SET assignee = '' WHERE project_id = ? AND assignee = ?`, project.ID, uid); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, moveResponse{UserID: uid, ProjectID: dest.ID, Role: memberRole})
+}
