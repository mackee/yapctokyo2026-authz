+// changeRoleAggregate changes the role of one member of one project.
+type changeRoleAggregate struct {
+	membership *Membership
+	role       string
+	assigned   []*Task // membership.AssignedTasks: tasks the member is the assignee of
+}
+
+func loadChangeRole(ctx context.Context, tx DB, projectID, userID, role string) (*changeRoleAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	assigned, err := m.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &changeRoleAggregate{membership: m, role: role, assigned: assigned}, nil
+}
+
+func (a *changeRoleAggregate) validate() error {
+	if !validRole(a.role) {
+		return deny(ErrInvalid, "invalid role")
+	}
+	if !isWriterRole(a.role) && len(a.assigned) > 0 {
+		return deny(ErrInvalid, "member has assigned tasks; reassign them before making the member a viewer")
+	}
+	return nil
+}
+
+func (a *changeRoleAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.membership.setRole(ctx, tx, a.role); err != nil {
+		return nil, err
+	}
+	return a.membership, nil
+}
+
