+func TestUpdateMembers(t *testing.T) {
+	const path = "/projects/web/members"
+	cases := []struct {
+		name, user, body string
+		want             int
+	}{
+		{"manager", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 200},
+		{"contributor", "ben", `{"roles":{"dan":"contributor"}}`, 403},
+		{"org admin non member", "eve", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", `{"roles":{"dan":"contributor"}}`, 401},
+		{"bad role", "ann", `{"roles":{"dan":"boss"}}`, 400},
+		{"empty", "ann", `{"roles":{}}`, 400},
+		{"bad json", "ann", `{`, 400},
+		{"unknown member", "ann", `{"roles":{"dan":"contributor","hal":"viewer"}}`, 400},
+		{"no manager left", "ann", `{"roles":{"ann":"viewer","ivy":"contributor"}}`, 400},
+		{"archived", "ann", `{"roles":{"ben":"viewer"}}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			p := path
+			if c.name == "archived" {
+				p = "/projects/legacy/members"
+			}
+			code, _ := do(t, newServer(), "PUT", p, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+
+	t.Run("result and effects", func(t *testing.T) {
+		h := newServer()
+		code, body := do(t, h, "PUT", path, "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+		if code != 200 {
+			t.Fatal(code, body)
+		}
+		var ms []struct{ UserID, Role string }
+		if err := json.Unmarshal([]byte(body), &ms); err != nil {
+			t.Fatal(err)
+		}
+		want := map[string]string{"ann": "manager", "ben": "viewer", "cat": "contributor", "dan": "contributor", "ivy": "manager"}
+		if len(ms) != len(want) {
+			t.Fatalf("got %v", ms)
+		}
+		for _, m := range ms {
+			if want[m.UserID] != m.Role {
+				t.Fatalf("%s: got %s want %s", m.UserID, m.Role, want[m.UserID])
+			}
+		}
+		// ben became a viewer: his task is unassigned.
+		_, tb := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+		var task Task
+		json.Unmarshal([]byte(tb), &task)
+		if task.AssigneeID != "" {
+			t.Fatalf("t1 still assigned to %q", task.AssigneeID)
+		}
+	})
+
+	t.Run("all or nothing", func(t *testing.T) {
+		h := newServer()
+		code, _ := do(t, h, "PUT", path, "ann", `{"roles":{"dan":"contributor","hal":"viewer"}}`)
+		if code != 400 {
+			t.Fatal(code)
+		}
+		_, body := do(t, h, "PUT", path, "ann", `{"roles":{"ann":"manager"}}`)
+		if !strings.Contains(body, `{"userId":"dan","role":"viewer"}`) {
+			t.Fatalf("dan changed: %s", body)
+		}
+	})
+}
