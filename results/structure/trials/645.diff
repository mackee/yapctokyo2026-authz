+// changeRolesAggregate changes the roles of several members of one project.
+type changeRolesAggregate struct {
+	members []*Membership // the whole project membership
+	changes []*Membership // memberships to change (Role is the new role)
+}
+
+func loadChangeRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*changeRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	members, err := p.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	a := &changeRolesAggregate{members: members}
+	byUser := map[string]*Membership{}
+	for _, m := range members {
+		byUser[m.UserID] = m
+	}
+	for _, m := range members { // deterministic order
+		role, ok := roles[m.UserID]
+		if !ok {
+			continue
+		}
+		a.changes = append(a.changes, &Membership{ProjectID: m.ProjectID, UserID: m.UserID, Role: role})
+	}
+	for uid := range roles {
+		if byUser[uid] == nil {
+			return nil, deny(ErrInvalid, "not a member of the project: "+uid)
+		}
+	}
+	return a, nil
+}
+
+func (a *changeRolesAggregate) validate() error {
+	if len(a.changes) == 0 {
+		return deny(ErrInvalid, "no roles given")
+	}
+	final := map[string]string{}
+	for _, m := range a.members {
+		final[m.UserID] = m.Role
+	}
+	for _, c := range a.changes {
+		if !validRoles[c.Role] {
+			return deny(ErrInvalid, "invalid role for "+c.UserID)
+		}
+		final[c.UserID] = c.Role
+	}
+	for _, role := range final {
+		if role == RoleManager {
+			return nil
+		}
+	}
+	return deny(ErrInvalid, "a project must keep at least one manager")
+}
+
+// apply saves the new roles. Tasks assigned to a member who becomes a viewer
+// are unassigned, since only contributors and managers may be assignees.
+func (a *changeRolesAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for _, c := range a.changes {
+		if c.Role == RoleViewer {
+			tasks, err := c.AssignedTasks(ctx, tx)
+			if err != nil {
+				return nil, err
+			}
+			for _, t := range tasks {
+				if err := t.unassign(ctx, tx); err != nil {
+					return nil, err
+				}
+			}
+		}
+		if err := c.setRole(ctx, tx, c.Role); err != nil {
+			return nil, err
+		}
+	}
+	return NewMembershipTable().ListByProject(ctx, tx, a.changes[0].ProjectID)
+}
