+func TestUpdateMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager promotes viewer", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"manager demotes assignee", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 400},
+		{"manager promotes assignee to manager", "ann", "/projects/web/members/ben", `{"role":"manager"}`, 200},
+		{"manager demotes unassigned manager", "ann", "/projects/web/members/ivy", `{"role":"viewer"}`, 200},
+		{"contributor caller", "ben", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"viewer caller", "dan", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"org admin caller", "eve", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"non member caller", "hal", "/projects/web/members/dan", `{"role":"contributor"}`, 404},
+		{"other org caller", "gus", "/projects/web/members/dan", `{"role":"contributor"}`, 404},
+		{"anonymous", "", "/projects/web/members/dan", `{"role":"contributor"}`, 401},
+		{"unknown user caller", "zed", "/projects/web/members/dan", `{"role":"contributor"}`, 401},
+		{"project missing", "ann", "/projects/nope/members/dan", `{"role":"contributor"}`, 404},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"target not member", "ann", "/projects/web/members/hal", `{"role":"contributor"}`, 404},
+		{"target in other org", "ann", "/projects/web/members/gus", `{"role":"contributor"}`, 404},
+		{"invalid role", "ann", "/projects/web/members/dan", `{"role":"owner"}`, 400},
+		{"missing role", "ann", "/projects/web/members/dan", `{}`, 400},
+		{"malformed body", "ann", "/projects/web/members/dan", `{`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRoleResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+	var got struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.UserID != "dan" || got.Role != "contributor" {
+		t.Fatalf("got %+v", got)
+	}
+}
+
+// A promoted member gains write access; a demoted one loses it.
+func TestUpdateMemberRoleTakesEffect(t *testing.T) {
+	s := newServer()
+	body := `{"title":"x"}`
+	if code, _ := do(t, s, "POST", "/projects/web/tasks", "dan", body); code != 403 {
+		t.Fatalf("viewer create: got %d want 403", code)
+	}
+	if code, _ := do(t, s, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`); code != 200 {
+		t.Fatalf("promote: got %d want 200", code)
+	}
+	if code, _ := do(t, s, "POST", "/projects/web/tasks", "dan", body); code != 200 {
+		t.Fatalf("contributor create: got %d want 200", code)
+	}
+	if code, _ := do(t, s, "PUT", "/projects/web/members/dan", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote: got %d want 200", code)
+	}
+	if code, _ := do(t, s, "POST", "/projects/web/tasks", "dan", body); code != 403 {
+		t.Fatalf("demoted create: got %d want 403", code)
+	}
+}
+
+// A rejected demotion changes nothing: cat keeps write access to her task.
+// Once the task is reassigned, the demotion goes through.
+func TestUpdateMemberRoleAssigneeRule(t *testing.T) {
+	s := newServer()
+	if code, _ := do(t, s, "PUT", "/projects/web/members/cat", "ann", `{"role":"viewer"}`); code != 400 {
+		t.Fatalf("demote assignee: got %d want 400", code)
+	}
+	if code, _ := do(t, s, "PATCH", "/projects/web/tasks/t2", "cat", `{"status":"done"}`); code != 200 {
+		t.Fatalf("cat after rejected demotion: got %d want 200", code)
+	}
+	if code, _ := do(t, s, "PATCH", "/projects/web/tasks/t2", "ann", `{"assignee":"ann"}`); code != 200 {
+		t.Fatalf("reassign: got %d want 200", code)
+	}
+	if code, _ := do(t, s, "PUT", "/projects/web/members/cat", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote after reassign: got %d want 200", code)
+	}
+	if code, _ := do(t, s, "PATCH", "/projects/web/tasks/t2", "cat", `{"status":"open"}`); code != 403 {
+		t.Fatalf("cat after demotion: got %d want 403", code)
+	}
+}
