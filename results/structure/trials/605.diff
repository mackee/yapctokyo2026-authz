+func TestMoveMemberEffects(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["userId"] != "ben" || got["projectId"] != "ops" || got["role"] != "contributor" || len(got) != 3 {
+		t.Fatalf("unexpected response %v", got)
+	}
+	// ben is now a member of ops and no longer of web.
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben should read ops, got %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben should not read web, got %d", code)
+	}
+	// his task in web is unassigned, so web keeps the assignee rule.
+	_, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.AssigneeID != "" {
+		t.Fatalf("t1 still assigned to %q", task.AssigneeID)
+	}
+	// moving again fails: he is no longer in web.
+	if code, _ := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`); code != 404 {
+		t.Fatalf("second move got %d want 404", code)
+	}
+}
