+// Move moves the user from the authorized project to the project toProjectID,
+// keeping the role. The actor must be a manager of both projects (neither
+// archived); the target project must be readable by the actor (else
+// ErrNotFound). The user's tasks in the source project become unassigned.
+func (*MembershipTable) Move(ctx context.Context, db DB, authz ProjectAuthz, toProjectID, userID string) (*Membership, error) {
+	if err := authz.CanManage(); err != nil {
+		return nil, err
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		to, err := NewProjectAuthz(ctx, tx, authz.Actor(), toProjectID)
+		if err != nil {
+			return err
+		}
+		if err := to.CanManage(); err != nil {
+			return err
+		}
+		agg, err := loadMoveMember(ctx, tx, authz.ProjectID(), toProjectID, userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		m, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
