+// ---- org capabilities -------------------------------------------------------------
+
+// OrgScope is bound to one actor and one organization ID. Call Manage to
+// acquire the org-admin capability.
+type OrgScope interface {
+	Manage() (ManageOrg, error)
+}
+
+// ManageOrg is the org-admin capability for one organization.
+type ManageOrg interface {
+	// RemoveUser takes a user out of every project of the organization. Tasks
+	// assigned to that user in those projects are unassigned, so no task keeps
+	// an assignee who is no longer a member. Unknown users, and users of another
+	// organization, are 404.
+	RemoveUser(userID string) error
+}
+
+type orgScope struct {
+	as  *actorScope
+	oid string
+}
+
+// Manage applies the org rule: the organization must be the actor's own (else
+// 404) and the actor must be an org admin (else 403).
+func (s *orgScope) Manage() (ManageOrg, error) {
+	if s.oid != s.as.actor.org {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if !s.as.actor.orgAdmin {
+		return nil, deny(ErrForbidden, "forbidden")
+	}
+	return &manageOrg{os: s}, nil
+}
+
+type manageOrg struct{ os *orgScope }
+
+func (m *manageOrg) RemoveUser(userID string) error {
+	return m.os.as.a.db.update(func(x *tx) error {
+		agg, err := loadRemoveOrgUser(x, m.os.oid, userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		agg.save(x)
+		return nil
+	})
+}
+
