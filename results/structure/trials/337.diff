@@ -108,3 +108,42 @@ func loadDeleteTask(x *tx, taskID string) (*deleteTaskAggregate, error) {
 func (a *deleteTaskAggregate) validate() error { return nil }
 
 func (a *deleteTaskAggregate) save(x *tx) { a.task.destroy(x) }
+
+// removeOrgUserAggregate takes one user out of every project of one
+// organization: it drops the user's memberships there and unassigns the tasks
+// in those projects that were assigned to the user.
+type removeOrgUserAggregate struct {
+	memberships []membershipRecord // the user's memberships in the org's projects
+	tasks       []taskRecord       // tasks in those projects assigned to the user
+}
+
+func loadRemoveOrgUser(x *tx, org, userID string) (*removeOrgUserAggregate, error) {
+	u, ok := x.findUser(userID)
+	if !ok || u.Org != org {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	a := &removeOrgUserAggregate{}
+	for _, p := range x.projectsIn(org) {
+		if m, ok := x.findMembership(p.ID, userID); ok {
+			a.memberships = append(a.memberships, m)
+		}
+		for _, t := range x.tasksIn(p.ID) {
+			if t.AssigneeID == userID {
+				a.tasks = append(a.tasks, t)
+			}
+		}
+	}
+	return a, nil
+}
+
+func (a *removeOrgUserAggregate) validate() error { return nil }
+
+func (a *removeOrgUserAggregate) save(x *tx) {
+	for _, m := range a.memberships {
+		m.destroy(x)
+	}
+	for _, t := range a.tasks {
+		t.AssigneeID = ""
+		t.save(x)
+	}
+}
