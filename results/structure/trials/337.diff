+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes user with no projects", "eve", "/orgs/acme/users/hal", 204},
+		{"org admin removes self", "eve", "/orgs/acme/users/eve", 204},
+		{"manager is not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"contributor is not org admin", "ben", "/orgs/acme/users/cat", 403},
+		{"user of another org removes", "gus", "/orgs/acme/users/ben", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ben", 404},
+		{"user of another org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed", 404},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown actor", "zed", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserTakesEffect(t *testing.T) {
+	s := newServer()
+
+	if code, _ := do(t, s, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+
+	// ben is gone from every acme project, archived ones included.
+	for _, path := range []string{
+		"/projects/web/tasks",
+		"/projects/ops/tasks",
+		"/projects/legacy/tasks",
+		"/projects/web/tasks/t1",
+		"/projects/legacy/tasks/t5",
+	} {
+		if code, _ := do(t, s, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("GET %s as ben: got %d want 404", path, code)
+		}
+	}
+	if code, _ := do(t, s, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 404 {
+		t.Fatalf("PATCH as ben: got %d want 404", code)
+	}
+
+	// Tasks ben was assigned to are unassigned; other assignments are kept.
+	assignee := func(path string) string {
+		t.Helper()
+		code, body := do(t, s, "GET", path, "ann", "")
+		if code != 200 {
+			t.Fatalf("GET %s: got %d", path, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		return task.Assignee
+	}
+	if got := assignee("/projects/web/tasks/t1"); got != "" {
+		t.Fatalf("t1 assignee: got %q want unassigned", got)
+	}
+	if got := assignee("/projects/legacy/tasks/t5"); got != "" {
+		t.Fatalf("t5 assignee: got %q want unassigned", got)
+	}
+	if got := assignee("/projects/web/tasks/t2"); got != "cat" {
+		t.Fatalf("t2 assignee: got %q want cat", got)
+	}
+	if got := assignee("/projects/ops/tasks/t4"); got != "cat" {
+		t.Fatalf("t4 assignee: got %q want cat", got)
+	}
+
+	// Other members keep their access, and other orgs are untouched.
+	if code, _ := do(t, s, "GET", "/projects/web/tasks", "dan", ""); code != 200 {
+		t.Fatalf("dan GET web: got %d want 200", code)
+	}
+	if code, _ := do(t, s, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatalf("gus GET gx: got %d want 200", code)
+	}
+
+	// Removing again is harmless.
+	if code, _ := do(t, s, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("second remove: got %d want 204", code)
+	}
+}
