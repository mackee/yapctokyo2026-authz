+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"unauthenticated", "", "/projects/web/tasks/t2/move", `{"toProjectId":"ops"}`, 401},
+		{"contributor others' task", "cat", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"contributor unassigned task", "cat", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer in destination", "ann", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"not a member of destination", "ben", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 404},
+		{"org admin", "eve", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer source", "dan", "/projects/web/tasks/t1/move", `{"toProjectId":"web"}`, 403},
+		{"archived destination", "ann", "/projects/web/tasks/t1/move", `{"toProjectId":"legacy"}`, 409},
+		{"archived source", "ann", "/projects/legacy/tasks/t5/move", `{"toProjectId":"web"}`, 409},
+		{"other org destination", "ann", "/projects/web/tasks/t1/move", `{"toProjectId":"gx"}`, 404},
+		{"missing destination", "ann", "/projects/web/tasks/t1/move", `{"toProjectId":"nope"}`, 404},
+		{"task not in path project", "ivy", "/projects/web/tasks/t4/move", `{"toProjectId":"ops"}`, 404},
+		{"same project", "ann", "/projects/web/tasks/t1/move", `{"toProjectId":"web"}`, 400},
+		{"missing body field", "ann", "/projects/web/tasks/t1/move", `{}`, 400},
+		{"assignee not in destination", "ivy", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestMoveResult(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/ops/tasks/t4/move", "cat", `{"toProjectId":"web"}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t4", ProjectID: "web", Title: "Rotate keys", Status: "open", Assignee: "cat"}
+	if task != want {
+		t.Fatalf("got %+v want %+v", task, want)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t4", "cat", ""); code != 200 {
+		t.Fatalf("task not in destination: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks/t4", "cat", ""); code != 404 {
+		t.Fatalf("task still in source: %d", code)
+	}
+}
