+func TestSetMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, project, target, body string
+		want                              int
+	}{
+		{"manager promotes", "ann", "web", "ben", `{"role":"manager"}`, 200},
+		{"manager demotes", "ann", "web", "ivy", `{"role":"viewer"}`, 200},
+		{"manager of other project", "ivy", "ops", "cat", `{"role":"viewer"}`, 200},
+		{"manager same role", "ann", "web", "ann", `{"role":"manager"}`, 200},
+		{"contributor", "ben", "web", "cat", `{"role":"viewer"}`, 403},
+		{"viewer", "dan", "web", "ben", `{"role":"manager"}`, 403},
+		{"manager of other project is viewer here", "ann", "ops", "cat", `{"role":"viewer"}`, 403},
+		{"org admin without role", "eve", "web", "ben", `{"role":"manager"}`, 403},
+		{"non member", "hal", "web", "ben", `{"role":"manager"}`, 404},
+		{"other org", "gus", "web", "ben", `{"role":"manager"}`, 404},
+		{"anonymous", "", "web", "ben", `{"role":"manager"}`, 401},
+		{"unknown user", "zed", "web", "ben", `{"role":"manager"}`, 401},
+		{"target not a member", "ann", "web", "eve", `{"role":"viewer"}`, 404},
+		{"target in other org", "ann", "web", "gus", `{"role":"viewer"}`, 404},
+		{"target unknown", "ann", "web", "zed", `{"role":"viewer"}`, 404},
+		{"archived", "ann", "legacy", "ben", `{"role":"viewer"}`, 409},
+		{"bad role", "ann", "web", "ben", `{"role":"admin"}`, 400},
+		{"missing role", "ann", "web", "ben", `{}`, 400},
+		{"malformed body before access", "dan", "web", "ben", `{"role":"admin"}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members/"+c.target, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMemberRoleResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members/ben", "ann", `{"role":"manager"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["userId"] != "ben" || got["role"] != "manager" || len(got) != 2 {
+		t.Fatalf("unexpected body %s", body)
+	}
+}
+
+func TestSetMemberRoleTakesEffect(t *testing.T) {
+	h := newServer()
+	steps := []struct {
+		name, user, method, path, body string
+		want                           int
+	}{
+		{"demote contributor", "ann", "PUT", "/projects/web/members/cat", `{"role":"viewer"}`, 200},
+		{"demoted cannot create", "cat", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"promote viewer", "ann", "PUT", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"promoted can create", "dan", "POST", "/projects/web/tasks", `{"title":"x"}`, 200},
+		{"demote manager", "ann", "PUT", "/projects/web/members/ivy", `{"role":"contributor"}`, 200},
+		{"demoted manager cannot manage", "ivy", "PUT", "/projects/web/members/cat", `{"role":"viewer"}`, 403},
+		{"demoted manager cannot delete", "ivy", "DELETE", "/projects/web/tasks/t1", ``, 403},
+	}
+	for _, s := range steps {
+		t.Run(s.name, func(t *testing.T) {
+			code, body := do(t, h, s.method, s.path, s.user, s.body)
+			if code != s.want {
+				t.Fatalf("got %d want %d: %s", code, s.want, body)
+			}
+		})
+	}
+}
