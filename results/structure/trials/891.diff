+// setRoleAggregate changes the project role of one member.
+type setRoleAggregate struct {
+	membership *Membership
+	role       string
+}
+
+func loadSetRole(ctx context.Context, tx DB, projectID, userID string, in MembershipTableSetRoleInput) (*setRoleAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	return &setRoleAggregate{membership: m, role: in.Role}, nil
+}
+
+func (a *setRoleAggregate) validate() error {
+	if !validRoles[a.role] {
+		return deny(ErrInvalid, "invalid role")
+	}
+	return nil
+}
+
+func (a *setRoleAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.membership.setRole(ctx, tx, a.role); err != nil {
+		return nil, err
+	}
+	return a.membership, nil
+}
