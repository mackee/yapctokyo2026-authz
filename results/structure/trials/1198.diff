+func TestUpdateMembers(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager", "ann", "web", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"missing project", "ann", "nope", `{"roles":{"dan":"contributor"}}`, 404},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"bad role", "ann", "web", `{"roles":{"dan":"owner"}}`, 400},
+		{"non member target", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"empty", "ann", "web", `{"roles":{}}`, 400},
+		{"bad json", "ann", "web", `nope`, 400},
+		{"last manager", "ann", "web", `{"roles":{"ann":"viewer","ivy":"contributor"}}`, 409},
+		{"swap managers", "ann", "web", `{"roles":{"ann":"viewer","ben":"manager"}}`, 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMembersResult(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got []member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []member{{"ann", "manager"}, {"ben", "viewer"}, {"cat", "contributor"}, {"dan", "contributor"}, {"ivy", "manager"}}
+	if len(got) != len(want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("got %v want %v", got, want)
+		}
+	}
+	// ben was demoted: his task is unassigned so the assignee invariant holds.
+	_, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" {
+		t.Fatalf("t1 assignee %q, want unassigned", task.Assignee)
+	}
+	// dan can now write.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("dan create got %d", code)
+	}
+}
+
+func TestUpdateMembersAtomic(t *testing.T) {
+	for _, body := range []string{
+		`{"roles":{"ben":"viewer","hal":"viewer"}}`,
+		`{"roles":{"ben":"viewer","dan":"owner"}}`,
+		`{"roles":{"ben":"viewer","ann":"viewer","ivy":"viewer"}}`,
+	} {
+		h := newServer()
+		if code, _ := do(t, h, "PUT", "/projects/web/members", "ann", body); code < 400 {
+			t.Fatalf("%s: got %d", body, code)
+		}
+		// nothing changed: ben can still modify his own task.
+		if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 200 {
+			t.Fatalf("%s: ben patch got %d", body, code)
+		}
+	}
+}
