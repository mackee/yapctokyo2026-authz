+func TestUpdateMemberRolesIsAllOrNothing(t *testing.T) {
+	h := newServer()
+	// ben is changed first (users are applied in user ID order), hal is not a
+	// member and is refused: ben's role and his assigned task must stay as they were.
+	if code, body := do(t, h, "PUT", "/projects/web/members", "ann",
+		`{"roles":{"ben":"viewer","hal":"contributor"}}`); code != 400 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ann":"manager"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	for _, m := range members(t, body) {
+		if m.UserID == "ben" && m.Role != "contributor" {
+			t.Fatalf("ben changed despite the refused request: %+v", m)
+		}
+	}
+	code, body = do(t, h, "GET", "/projects/web/tasks/t1", "dan", "")
+	if code != 200 || !strings.Contains(body, `"assignee":"ben"`) {
+		t.Fatalf("task t1 changed despite the refused request: %d %s", code, body)
+	}
+}
+
+func TestDemotedViewerIsUnassigned(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer"}}`); code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	// viewers cannot be assignees, so ben's task in web is unassigned;
+	// cat's task is left alone.
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "dan", "")
+	if code != 200 || !strings.Contains(body, `"assignee":""`) {
+		t.Fatalf("t1 should be unassigned: %d %s", code, body)
+	}
+	code, body = do(t, h, "GET", "/projects/web/tasks/t2", "dan", "")
+	if code != 200 || !strings.Contains(body, `"assignee":"cat"`) {
+		t.Fatalf("t2 should stay assigned to cat: %d %s", code, body)
+	}
+}
