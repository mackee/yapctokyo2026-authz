--- /dev/null
+++ b/internal/capability/move_test.go
@@ -0,0 +1,38 @@
+package capability
+
+import (
+	"errors"
+	"testing"
+)
+
+// Seed data has no user who is a manager of one project and a contributor of
+// another, so this test grants ann the contributor role in ops directly.
+func TestMoveContributorDestinationAssignsOnlySelf(t *testing.T) {
+	a := New()
+	a.db.cur.members["ops"]["ann"] = RoleContributor
+
+	actor, err := a.Authenticate("ann")
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	m, err := actor.Project("web").Task("t2").Manage() // t2 is assigned to cat
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := m.Move("ops"); !errors.Is(err, ErrForbidden) {
+		t.Fatalf("assigned to other: got %v want forbidden", err)
+	}
+
+	m, err = actor.Project("web").Task("t3").Manage() // t3 is unassigned
+	if err != nil {
+		t.Fatal(err)
+	}
+	v, err := m.Move("ops")
+	if err != nil {
+		t.Fatalf("unassigned: %v", err)
+	}
+	if v.ProjectID != "ops" || v.ID != "t3" {
+		t.Fatalf("got %+v", v)
+	}
+}
