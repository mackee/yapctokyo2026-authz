+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager moves, assignee in destination", "ivy", "/projects/ops/tasks/t4", `{"toProjectId":"web"}`, 200},
+		{"manager, assignee not in destination", "ivy", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 400},
+		{"contributor source", "ben", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"org admin source", "eve", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"viewer destination", "ann", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 403},
+		{"destination non member", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"legacy"}`, 404},
+		{"destination archived", "ann", "/projects/web/tasks/t3", `{"toProjectId":"legacy"}`, 409},
+		{"destination missing", "ann", "/projects/web/tasks/t3", `{"toProjectId":"nope"}`, 404},
+		{"destination other org", "ann", "/projects/web/tasks/t3", `{"toProjectId":"gx"}`, 404},
+		{"same project", "ann", "/projects/web/tasks/t3", `{"toProjectId":"web"}`, 400},
+		{"empty destination", "ann", "/projects/web/tasks/t3", `{}`, 400},
+		{"bad body", "ann", "/projects/web/tasks/t3", `{`, 400},
+		{"cross project id", "ann", "/projects/ops/tasks/t1", `{"toProjectId":"web"}`, 404},
+		{"archived source", "ann", "/projects/legacy/tasks/t5", `{"toProjectId":"web"}`, 409},
+		{"cross org", "gus", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsTask(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/ops/tasks/t4/move", "ivy", `{"toProjectId":"web"}`)
+	if code != 200 {
+		t.Fatalf("move got %d: %s", code, body)
+	}
+	var got Task
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t4", ProjectID: "web", Title: "Rotate keys", Status: "open", Assignee: "cat"}
+	if got != want {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+
+	code, body = do(t, h, "GET", "/projects/web/tasks/t4", "ann", "")
+	if code != 200 {
+		t.Fatalf("destination get got %d: %s", code, body)
+	}
+	code, _ = do(t, h, "GET", "/projects/ops/tasks/t4", "ivy", "")
+	if code != 404 {
+		t.Fatalf("source get got %d want 404", code)
+	}
+}
