+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestOutOfOfficeAccess(t *testing.T) {
+	const body = `{"delegate":"ivy"}`
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/cat/out-of-office", body, 200},
+		{"org admin, user with no tasks", "eve", "/orgs/acme/users/hal/out-of-office", body, 200},
+		{"manager is not org admin", "ann", "/orgs/acme/users/cat/out-of-office", body, 403},
+		{"contributor is not org admin", "ben", "/orgs/acme/users/cat/out-of-office", body, 403},
+		{"anonymous", "", "/orgs/acme/users/cat/out-of-office", body, 401},
+		{"unknown user", "zed", "/orgs/acme/users/cat/out-of-office", body, 401},
+		{"other org admin of own org", "gus", "/orgs/acme/users/cat/out-of-office", body, 404},
+		{"org admin of other org", "eve", "/orgs/globex/users/gus/out-of-office", body, 404},
+		{"user not in org", "eve", "/orgs/acme/users/gus/out-of-office", body, 404},
+		{"missing delegate", "eve", "/orgs/acme/users/cat/out-of-office", `{}`, 400},
+		{"empty body", "eve", "/orgs/acme/users/cat/out-of-office", ``, 400},
+		{"delegate is the user", "eve", "/orgs/acme/users/cat/out-of-office", `{"delegate":"cat"}`, 400},
+		{"delegate is a viewer of a project", "eve", "/orgs/acme/users/cat/out-of-office", `{"delegate":"dan"}`, 400},
+		{"delegate not in org", "eve", "/orgs/acme/users/cat/out-of-office", `{"delegate":"gus"}`, 400},
+		{"delegate not in one project", "eve", "/orgs/acme/users/cat/out-of-office", `{"delegate":"ben"}`, 400},
+		{"archived project task", "eve", "/orgs/acme/users/ben/out-of-office", `{"delegate":"ann"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestOutOfOfficeReassignsAllProjects(t *testing.T) {
+	srv := newServer()
+
+	code, body := do(t, srv, "POST", "/orgs/acme/users/cat/out-of-office", "eve", `{"delegate":"ivy"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var moved []Task
+	if err := json.Unmarshal([]byte(body), &moved); err != nil {
+		t.Fatal(err)
+	}
+	// cat holds t2 (web) and t4 (ops).
+	if len(moved) != 2 || moved[0].ID != "t2" || moved[1].ID != "t4" {
+		t.Fatalf("moved tasks: %+v", moved)
+	}
+	for _, task := range moved {
+		if task.Assignee != "ivy" {
+			t.Fatalf("task %s assignee %q, want ivy", task.ID, task.Assignee)
+		}
+	}
+
+	// The change is visible through the normal task endpoints.
+	for _, path := range []string{"/projects/web/tasks/t2", "/projects/ops/tasks/t4"} {
+		code, body := do(t, srv, "GET", path, "ann", "")
+		if code != 200 {
+			t.Fatalf("%s: got %d", path, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.Assignee != "ivy" {
+			t.Fatalf("%s assignee %q, want ivy", path, task.Assignee)
+		}
+	}
+
+	// Nothing is left for cat, so a second call moves nothing and returns [].
+	code, body = do(t, srv, "POST", "/orgs/acme/users/cat/out-of-office", "eve", `{"delegate":"ivy"}`)
+	if code != 200 || body != "[]\n" {
+		t.Fatalf("second call: got %d %q, want 200 []", code, body)
+	}
+}
+
+func TestOutOfOfficeIsAllOrNothing(t *testing.T) {
+	srv := newServer()
+
+	// ben cannot take over cat's ops task (ben is not a member of ops), so the
+	// whole request fails and the web task t2 must stay with cat.
+	code, _ := do(t, srv, "POST", "/orgs/acme/users/cat/out-of-office", "eve", `{"delegate":"ben"}`)
+	if code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	for _, path := range []string{"/projects/web/tasks/t2", "/projects/ops/tasks/t4"} {
+		_, body := do(t, srv, "GET", path, "ann", "")
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.Assignee != "cat" {
+			t.Fatalf("%s assignee %q after failed request, want cat", path, task.Assignee)
+		}
+	}
+}
