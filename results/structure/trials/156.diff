+package capability
+
+import "sort"
+
+// OrgScope is bound to one actor and one organization ID.
+type OrgScope interface {
+	Admin() (OrgAdmin, error)
+}
+
+// OrgAdmin may perform organization-wide administration.
+type OrgAdmin interface {
+	// Delegate moves every task assigned to userID, in every project of the
+	// organization, to delegate, and returns the moved tasks (sorted by ID).
+	// It is all-or-nothing: if any task cannot be moved, nothing changes.
+	Delegate(userID, delegate string) ([]TaskView, error)
+}
+
+type orgScope struct {
+	as    *actorScope
+	orgID string
+}
+
+func (s *actorScope) Org(orgID string) OrgScope {
+	return &orgScope{as: s, orgID: orgID}
+}
+
+// Admin applies the org admin rule: the organization must be the actor's own
+// (else 404), and the actor must be an org admin (else 403).
+func (s *orgScope) Admin() (OrgAdmin, error) {
+	if s.orgID != s.as.actor.org {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if !s.as.actor.orgAdmin {
+		return nil, deny(ErrForbidden, "forbidden")
+	}
+	return &orgAdmin{os: s}, nil
+}
+
+type orgAdmin struct{ os *orgScope }
+
+func (o *orgAdmin) Delegate(userID, delegate string) ([]TaskView, error) {
+	if delegate == "" || delegate == userID {
+		return nil, deny(ErrInvalid, "delegate must be a different user")
+	}
+	out := []TaskView{}
+	err := o.os.as.a.st.tx(func(s *state) error {
+		u, ok := s.users[userID]
+		if !ok || u.org != o.os.orgID {
+			return deny(ErrNotFound, "not found")
+		}
+
+		var ids []string
+		for id, t := range s.tasks {
+			if t.assignee.user == userID && s.projects[t.project].org == o.os.orgID {
+				ids = append(ids, id)
+			}
+		}
+		sort.Strings(ids)
+
+		for _, id := range ids {
+			t := s.tasks[id]
+			if s.projects[t.project].archived {
+				return deny(ErrArchived, "project is archived")
+			}
+			// admit checks that delegate is a contributor or manager of this
+			// task's project, so the store invariants keep holding.
+			a, err := admit(s, t.project, delegate)
+			if err != nil {
+				return err
+			}
+			t.assignee = a
+			s.tasks[id] = t
+			out = append(out, t.view())
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return out, nil
+}
