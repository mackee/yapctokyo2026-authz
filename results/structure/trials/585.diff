+// offboardUserAggregate removes one user from every project of an organization.
+// Because an assignee must be a contributor or manager of the task's project,
+// the user's tasks in those projects are unassigned along with the membership.
+// Archived projects are included: offboarding is not a task write.
+type offboardUserAggregate struct {
+	user        *User
+	memberships []*Membership
+	tasks       []*Task // tasks assigned to the user in the memberships' projects
+}
+
+func loadOffboardUser(ctx context.Context, tx DB, orgID, userID string) (*offboardUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != orgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	a := &offboardUserAggregate{user: u}
+	for _, m := range ms {
+		p, err := m.Project(ctx, tx)
+		if errors.Is(err, ErrNoRows) {
+			continue // dangling membership: nothing to protect, ignore
+		} else if err != nil {
+			return nil, err
+		}
+		if p.Org != orgID {
+			continue // another organization's project is not ours to change
+		}
+		ts, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.memberships = append(a.memberships, m)
+		a.tasks = append(a.tasks, ts...)
+	}
+	return a, nil
+}
+
+func (a *offboardUserAggregate) validate() error { return nil }
+
+func (a *offboardUserAggregate) apply(ctx context.Context, tx DB) error {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
