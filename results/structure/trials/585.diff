+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+	// ben: web contributor (t1), legacy (archived) contributor (t5).
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatal(code)
+	}
+	// ben lost access to every project, archived included.
+	for _, p := range []string{"web", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ben", ""); code != 404 {
+			t.Fatalf("ben still reads %s: %d", p, code)
+		}
+	}
+	// his tasks are unassigned; others are untouched.
+	want := map[string]string{"t1": "", "t2": "cat"}
+	for id, assignee := range want {
+		code, body := do(t, h, "GET", "/projects/web/tasks/"+id, "ann", "")
+		if code != 200 {
+			t.Fatal(code)
+		}
+		var task Task
+		json.Unmarshal([]byte(body), &task)
+		if task.AssigneeID != assignee {
+			t.Fatalf("%s assignee %q want %q", id, task.AssigneeID, assignee)
+		}
+	}
+	code, body := do(t, h, "GET", "/projects/legacy/tasks/t5", "ann", "")
+	var t5 Task
+	json.Unmarshal([]byte(body), &t5)
+	if code != 200 || t5.AssigneeID != "" {
+		t.Fatalf("legacy t5: %d %+v", code, t5)
+	}
+	// other members keep their access.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatal(code)
+	}
+	// ben can no longer be assigned.
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t3", "ann", `{"assignee":"ben"}`); code != 400 {
+		t.Fatalf("assign removed user: %d", code)
+	}
+}
