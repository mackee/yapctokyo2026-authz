+// NewOrgAuthz builds the actor's authorization object for one organization.
+// The actor must belong to it; otherwise ErrNotFound (like a project in
+// another organization).
+func NewOrgAuthz(_ context.Context, _ DB, act Actor, orgID string) (OrgAuthz, error) {
+	if orgID == "" || act.org != orgID {
+		return OrgAuthz{}, deny(ErrNotFound, "not found")
+	}
+	return OrgAuthz{actor: act, org: orgID, admin: act.orgAdmin}, nil
+}
