+// OrgAuthz is what the actor may do in one organization.
+type OrgAuthz struct {
+	actor Actor
+	org   string
+	admin bool
+}
+
+// OrgID returns the organization the object is bound to.
+func (a OrgAuthz) OrgID() string { return a.org }
+
+// CanAdminister returns nil if the actor may administer the organization's
+// members: org admins only (else ErrForbidden).
+func (a OrgAuthz) CanAdminister() error {
+	if a.org == "" || !a.admin {
+		return deny(ErrForbidden, "forbidden")
+	}
+	return nil
+}
