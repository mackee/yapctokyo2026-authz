+func TestSetMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager promotes", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"manager demotes unassigned", "ann", "/projects/web/members/ivy", `{"role":"viewer"}`, 200},
+		{"manager same role", "ann", "/projects/web/members/ben", `{"role":"contributor"}`, 200},
+		{"demote with assigned tasks", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 409},
+		{"contributor cannot", "ben", "/projects/web/members/cat", `{"role":"viewer"}`, 403},
+		{"viewer cannot", "dan", "/projects/web/members/cat", `{"role":"viewer"}`, 403},
+		{"org admin cannot", "eve", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"non member caller", "hal", "/projects/web/members/dan", `{"role":"contributor"}`, 404},
+		{"target not member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"target unknown", "ann", "/projects/web/members/zed", `{"role":"viewer"}`, 404},
+		{"other org caller", "gus", "/projects/web/members/dan", `{"role":"contributor"}`, 404},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"manager"}`, 409},
+		{"bad role", "ann", "/projects/web/members/dan", `{"role":"owner"}`, 400},
+		{"empty role", "ann", "/projects/web/members/dan", `{"role":""}`, 400},
+		{"bad body", "ann", "/projects/web/members/dan", `{"role":`, 400},
+		{"anonymous", "", "/projects/web/members/dan", `{"role":"contributor"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMemberRoleResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+	var got memberResponse
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.UserID != "dan" || got.Role != "contributor" {
+		t.Fatalf("got %+v", got)
+	}
+}
+
+func TestSetMemberRoleTakesEffect(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 403 {
+		t.Fatalf("viewer create: got %d want 403", code)
+	}
+	if code, _ := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`); code != 200 {
+		t.Fatalf("promote: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("contributor create: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 403 {
+		t.Fatalf("demoted create: got %d want 403", code)
+	}
+}
