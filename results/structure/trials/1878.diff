index 0000000..fbee41c
--- /dev/null
+++ b/members.go
@@ -0,0 +1,132 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+)
+
+type memberResponse struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+type bulkRolesRequest struct {
+	Roles map[string]string `json:"roles"`
+}
+
+var validRoles = map[string]bool{RoleManager: true, RoleContributor: true, RoleViewer: true}
+
+// updateMemberRoles changes several members' roles at once (managers only). It is
+// all-or-nothing. A member demoted to viewer is unassigned from their tasks in the
+// project, and the project must keep at least one manager.
+func (s *server) updateMemberRoles(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role, err := findRole(ctx, s.db, project.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "only managers may change member roles")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req bulkRolesRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || len(req.Roles) == 0 {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	for _, newRole := range req.Roles {
+		if !validRoles[newRole] {
+			writeError(w, 400, "role must be manager, contributor or viewer")
+			return
+		}
+	}
+
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+
+	for uid, newRole := range req.Roles {
+		res, err := tx.ExecContext(ctx, `UPDATE memberships SET role = ? WHERE project_id = ? AND user_id = ?`, newRole, project.ID, uid)
+		if err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+		if n, _ := res.RowsAffected(); n == 0 {
+			writeError(w, 400, uid+" is not a member of the project")
+			return
+		}
+	}
+	// Assignees must stay contributors or managers.
+	if _, err := tx.ExecContext(ctx, `UPDATE tasks SET assignee = ''
+		WHERE project_id = ? AND assignee <> ''
+		  AND assignee IN (SELECT user_id FROM memberships WHERE project_id = ? AND role = 'viewer')`,
+		project.ID, project.ID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	var managers int
+	if err := tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM memberships WHERE project_id = ? AND role = 'manager'`, project.ID).Scan(&managers); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if managers == 0 {
+		writeError(w, 409, "project must keep at least one manager")
+		return
+	}
+
+	rows, err := tx.QueryContext(ctx, `SELECT user_id, role FROM memberships WHERE project_id = ? ORDER BY user_id`, project.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	members := []memberResponse{}
+	for rows.Next() {
+		var m memberResponse
+		if err := rows.Scan(&m.UserID, &m.Role); err != nil {
+			rows.Close()
+			writeError(w, 500, "internal error")
+			return
+		}
+		members = append(members, m)
+	}
+	rows.Close()
+	if err := rows.Err(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, members)
+}
diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..f5a3f23
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,136 @@
+package main
+
+import (
+	"encoding/json"
+	"reflect"
+	"testing"
+)
+
+type memberJSON struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func memberRoles(t *testing.T, h interface{}, project string) map[string]string {
+	t.Helper()
+	app := h.(*appHandler)
+	rows, err := app.db.Query(`SELECT user_id, role FROM memberships WHERE project_id = ?`, project)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer rows.Close()
+	out := map[string]string{}
+	for rows.Next() {
+		var u, r string
+		if err := rows.Scan(&u, &r); err != nil {
+			t.Fatal(err)
+		}
+		out[u] = r
+	}
+	return out
+}
+
+func TestBulkRolesSuccess(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []memberJSON
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []memberJSON{
+		{"ann", "manager"}, {"ben", "viewer"}, {"cat", "contributor"},
+		{"dan", "contributor"}, {"ivy", "manager"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	roles := memberRoles(t, h, "web")
+	if roles["ben"] != "viewer" || roles["dan"] != "contributor" {
+		t.Fatalf("not persisted: %v", roles)
+	}
+}
+
+// Demoting a user to viewer must not leave them assigned to tasks.
+func TestBulkRolesDemoteUnassignsTasks(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	_, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" {
+		t.Fatalf("t1 still assigned to %q", task.Assignee)
+	}
+	// Tasks of other projects are untouched.
+	_, body = do(t, h, "GET", "/projects/legacy/tasks/t5", "ann", "")
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "ben" {
+		t.Fatalf("t5 assignee changed to %q", task.Assignee)
+	}
+}
+
+func TestBulkRolesErrors(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"anonymous", "", "web", `{"roles":{"ben":"viewer"}}`, 401},
+		{"contributor", "ben", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"ben":"viewer"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"ben":"viewer"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"ben":"viewer"}}`, 404},
+		{"missing project", "ann", "nope", `{"roles":{"ben":"viewer"}}`, 404},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"bad role", "ann", "web", `{"roles":{"ben":"viewer","dan":"boss"}}`, 400},
+		{"not a member", "ann", "web", `{"roles":{"ben":"viewer","hal":"viewer"}}`, 400},
+		{"unknown user", "ann", "web", `{"roles":{"ben":"viewer","zed":"viewer"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"no roles", "ann", "web", `{}`, 400},
+		{"bad json", "ann", "web", `nope`, 400},
+		{"no manager left", "ann", "web", `{"roles":{"ann":"viewer","ivy":"contributor"}}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			before := memberRoles(t, h, c.project)
+			code, _ := do(t, h, "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+			if after := memberRoles(t, h, c.project); !reflect.DeepEqual(before, after) {
+				t.Fatalf("members changed on failure: %v -> %v", before, after)
+			}
+		})
+	}
+}
+
+// One bad entry must leave the valid ones unapplied, and tasks untouched.
+func TestBulkRolesAllOrNothing(t *testing.T) {
+	h := newServer()
+	code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","hal":"viewer"}}`)
+	if code != 400 {
+		t.Fatalf("got %d", code)
+	}
+	if r := memberRoles(t, h, "web")["ben"]; r != "contributor" {
+		t.Fatalf("ben is %s", r)
+	}
+	_, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "ben" {
+		t.Fatalf("t1 assignee %q", task.Assignee)
+	}
+}
+
+func TestBulkRolesManagerCanSwapManagers(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann", `{"roles":{"ann":"contributor","cat":"manager"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+}
