+// ---- operations -----------------------------------------------------------------------
+
+// UserTableTransferInput is the input of UserTable.Transfer.
+type UserTableTransferInput struct {
+	ToOrgID string
+}
+
+// Transfer moves a user of the authorization object's organization to another
+// organization, all or nothing. The user's memberships in projects outside the
+// new organization are removed, and their task assignments in those projects
+// are cleared.
+func (*UserTable) Transfer(ctx context.Context, db DB, authz OrgAuthz, userID string, in UserTableTransferInput) (*User, error) {
+	if err := authz.CanManageUsers(); err != nil {
+		return nil, err
+	}
+	if in.ToOrgID == "" {
+		return nil, deny(ErrInvalid, "toOrgId must not be empty")
+	}
+	var u *User
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadTransferUser(ctx, tx, authz.OrgID(), userID, in.ToOrgID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if u, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return u, nil
+}
