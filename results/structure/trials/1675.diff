+// After a transfer the user is in the new org: the old org's projects are not
+// readable by them, the old org's memberships and task assignments are gone,
+// and the user can still authenticate (so it is 404, not 401).
+func TestTransferUserEffects(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: got %d (body %s)", code, body)
+	}
+
+	for _, path := range []string{"/projects/web/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, srv, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("ben GET %s: got %d want 404", path, code)
+		}
+	}
+
+	// t1 (web) and t5 (legacy) were assigned to ben: now unassigned.
+	for _, path := range []string{"/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		code, body := do(t, srv, "GET", path, "ann", "")
+		if code != 200 {
+			t.Fatalf("ann GET %s: got %d (body %s)", path, code, body)
+		}
+		var task Task
+		json.Unmarshal([]byte(body), &task)
+		if task.AssigneeID != "" {
+			t.Fatalf("%s still assigned to %q", path, task.AssigneeID)
+		}
+	}
+
+	// Other people's assignments and memberships are untouched.
+	code, body := do(t, srv, "GET", "/projects/web/tasks/t2", "ann", "")
+	var t2 Task
+	json.Unmarshal([]byte(body), &t2)
+	if code != 200 || t2.AssigneeID != "cat" {
+		t.Fatalf("t2: got %d assignee %q, want 200 cat", code, t2.AssigneeID)
+	}
+	if code, body := do(t, srv, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat GET web tasks: got %d (body %s)", code, body)
+	}
+}
