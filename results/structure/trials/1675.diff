+// OrgAuthz is what the actor may do in one organization.
+type OrgAuthz struct {
+	actor Actor
+	org   string
+}
+
+// NewOrgAuthz builds the actor's authorization object for one organization.
+// It needs no lookup: an organization is only the org_id its users and
+// projects carry.
+func NewOrgAuthz(act Actor, orgID string) OrgAuthz { return OrgAuthz{actor: act, org: orgID} }
+
+// OrgID returns the organization the object is bound to.
+func (a OrgAuthz) OrgID() string { return a.org }
+
+// CanManageUsers returns nil if the actor is an admin of the organization
+// (else ErrForbidden). Only org admins may move users out of it.
+func (a OrgAuthz) CanManageUsers() error {
+	if a.org == "" || a.actor.org != a.org || !a.actor.orgAdmin {
+		return deny(ErrForbidden, "only org admins may transfer users")
+	}
+	return nil
+}
