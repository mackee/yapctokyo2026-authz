+
+// Transfer moves a user of the authorization's organization to another
+// organization, all or nothing. The user leaves the organization's projects:
+// their memberships in those projects are removed and the tasks they were
+// assigned there are unassigned. The user is no longer an org admin.
+func (*UserTable) Transfer(ctx context.Context, db DB, authz OrgAuthz, userID string, in UserTableTransferInput) (*User, error) {
+	if err := authz.CanTransferUsers(); err != nil {
+		return nil, err
+	}
