@@ -0,0 +1,66 @@
+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestRemoveMemberDenied(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"contributor", "ben", "/projects/web/members/cat", 403},
+		{"viewer", "dan", "/projects/web/members/ben", 403},
+		{"manager of another project only", "ann", "/projects/ops/members/cat", 403}, // ann is a viewer in ops
+		{"org admin", "eve", "/projects/web/members/ben", 403},
+		{"non member", "hal", "/projects/web/members/ben", 404},
+		{"other org", "gus", "/projects/web/members/ben", 404},
+		{"anonymous", "", "/projects/web/members/ben", 401},
+		{"target not a member", "ann", "/projects/web/members/hal", 404},
+		{"unknown target", "ann", "/projects/web/members/zed", 404},
+		{"archived project", "ann", "/projects/legacy/members/ben", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestRemoveMemberEffects(t *testing.T) {
+	h := newServer()
+	// ben is a contributor of web (assigned t1) and loses access once removed.
+	if code, body := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 204 {
+		t.Fatalf("remove: got %d body=%s", code, body)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("removed member should lose access, got %d", code)
+	}
+	// the member is gone: removing again is 404.
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 404 {
+		t.Fatalf("second remove: got %d want 404", code)
+	}
+	// ben's other memberships are untouched.
+	if code, _ := do(t, h, "GET", "/projects/legacy/tasks", "ben", ""); code != 200 {
+		t.Fatalf("other membership should remain, got %d", code)
+	}
+	// tasks assigned to ben in web are now unassigned.
+	_, body := do(t, h, "GET", "/projects/web/tasks", "ann", "")
+	if strings.Contains(body, `"assignee":"ben"`) {
+		t.Fatalf("removed member still assigned: %s", body)
+	}
+}
+
+func TestRemoveMemberManagerLosesRights(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ivy", "ann", ""); code != 204 {
+		t.Fatalf("got %d want 204", code)
+	}
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/cat", "ivy", ""); code != 404 {
+		t.Fatalf("removed manager should be 404, got %d", code)
+	}
+}
