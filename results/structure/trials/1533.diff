+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestUpdateMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager changes role", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"manager demotes other manager", "ann", "/projects/web/members/ivy", `{"role":"viewer"}`, 200},
+		{"contributor forbidden", "ben", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"viewer forbidden", "dan", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"org admin forbidden", "eve", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"non member", "hal", "/projects/web/members/dan", `{"role":"manager"}`, 404},
+		{"other org", "gus", "/projects/web/members/dan", `{"role":"manager"}`, 404},
+		{"anonymous", "", "/projects/web/members/dan", `{"role":"manager"}`, 401},
+		{"missing project", "ann", "/projects/nope/members/dan", `{"role":"manager"}`, 404},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"invalid role", "ann", "/projects/web/members/dan", `{"role":"owner"}`, 400},
+		{"missing role", "ann", "/projects/web/members/dan", `{}`, 400},
+		{"bad json", "ann", "/projects/web/members/dan", `nope`, 400},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"last manager", "gus", "/projects/gx/members/gus", `{"role":"viewer"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRoleResponseAndEffect(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var resp map[string]string
+	if err := json.Unmarshal([]byte(body), &resp); err != nil {
+		t.Fatal(err)
+	}
+	if resp["userId"] != "dan" || resp["role"] != "contributor" {
+		t.Fatalf("unexpected response %v", resp)
+	}
+	// dan can now be assigned a task, and can write.
+	if code, body := do(t, h, "PATCH", "/projects/web/tasks/t3", "ann", `{"assignee":"dan"}`); code != 200 {
+		t.Fatalf("assign got %d: %s", code, body)
+	}
+	if code, body := do(t, h, "PATCH", "/projects/web/tasks/t3", "dan", `{"status":"doing"}`); code != 200 {
+		t.Fatalf("dan update got %d: %s", code, body)
+	}
+}
+
+func TestDemoteToViewerUnassignsTasks(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d", code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.Assignee != "" {
+		t.Fatalf("assignee = %q, want unassigned", task.Assignee)
+	}
+	// ben's role in other projects is untouched, and so are his tasks there.
+	if code, _ := do(t, h, "PATCH", "/projects/legacy/tasks/t5", "ann", `{"title":"x"}`); code != 409 {
+		t.Fatalf("legacy should stay archived, got %d", code)
+	}
+}
+
+func TestDemotedManagerLosesPowers(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ivy", "ann", `{"role":"contributor"}`); code != 200 {
+		t.Fatalf("demote failed: %d", code)
+	}
+	if code, _ := do(t, h, "PUT", "/projects/web/members/dan", "ivy", `{"role":"manager"}`); code != 403 {
+		t.Fatalf("got %d want 403", code)
+	}
+}
