@@ -0,0 +1,63 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+// Mirrors the setRoleOutcome examples in spec/taskboard.qnt.
+func TestSetMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager promotes viewer", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"manager demotes unassigned member", "ivy", "/projects/web/members/ivy", `{"role":"viewer"}`, 200},
+		{"demote member with tasks", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 409},
+		{"promote member with tasks", "ann", "/projects/web/members/ben", `{"role":"manager"}`, 200},
+		{"invalid role", "ann", "/projects/web/members/dan", `{"role":"admin"}`, 400},
+		{"missing role", "ann", "/projects/web/members/dan", `{}`, 400},
+		{"bad json", "ann", "/projects/web/members/dan", `nope`, 400},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"contributor forbidden", "ben", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"viewer cannot self promote", "dan", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"org admin forbidden", "eve", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"non member", "hal", "/projects/web/members/dan", `{"role":"manager"}`, 404},
+		{"other org", "gus", "/projects/web/members/dan", `{"role":"manager"}`, 404},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"unknown user", "zed", "/projects/web/members/dan", `{"role":"viewer"}`, 401},
+		{"anonymous", "", "/projects/web/members/dan", `{"role":"viewer"}`, 401},
+		{"missing project", "ann", "/projects/nope/members/dan", `{"role":"viewer"}`, 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMemberRoleResponseAndEffect(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["userId"] != "dan" || got["role"] != "contributor" || len(got) != 2 {
+		t.Fatalf("unexpected body %v", got)
+	}
+	// dan is now a contributor: may create a task assigned to self.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x","assignee":"dan"}`); code != 200 {
+		t.Fatalf("new contributor could not create task: %d", code)
+	}
+	// dan now has an assigned task, so demoting back to viewer is a 409.
+	if code, _ := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"viewer"}`); code != 409 {
+		t.Fatalf("want 409, got %d", code)
+	}
+}
