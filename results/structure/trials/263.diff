+// Manage applies the manage rule: readable, manager (else 403), not archived
+// (else 409).
+func (s *projectScope) Manage() (ManageProject, error) {
+	err := s.as.a.st.read(func(st *state) error {
+		p, r, err := readable(st, s.as.actor, s.pid)
+		if err != nil {
+			return err
+		}
+		if r != RoleManager {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if p.archived {
+			return deny(ErrArchived, "project is archived")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &manageProject{readProject: readProject{ps: s}}, nil
+}
+
 // ---- project capabilities ----------------------------------------------------
 
+// MemberView is the public representation of a project member.
+type MemberView struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// ManageProject is the manager-only capability for one project.
+type ManageProject interface {
+	ReadProject
+	// Freeze demotes every member (managers included) to viewer, so nobody can
+	// modify the project's tasks afterwards, and returns the resulting members
+	// sorted by user ID.
+	Freeze() ([]MemberView, error)
+}
+
+type manageProject struct{ readProject }
+
+func (p *manageProject) Freeze() ([]MemberView, error) {
+	var out []MemberView
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		pr := s.projects[p.ps.pid]
+		pr.frozen = true
+		s.projects[pr.id] = pr
+		out = []MemberView{}
+		for uid := range s.members[pr.id] {
+			s.members[pr.id][uid] = RoleViewer
+			out = append(out, MemberView{UserID: uid, Role: RoleViewer})
+		}
+		sort.Slice(out, func(i, j int) bool { return out[i].UserID < out[j].UserID })
+		return nil
+	})
+	return out, err
+}
+
