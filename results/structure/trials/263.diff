+func TestFreeze(t *testing.T) {
+	denied := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range denied {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+
+	t.Run("manager freezes", func(t *testing.T) {
+		h := newServer()
+		code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+		if code != 200 {
+			t.Fatal(code, body)
+		}
+		var got []map[string]string
+		if err := json.Unmarshal([]byte(body), &got); err != nil {
+			t.Fatal(err)
+		}
+		want := []string{"ann", "ben", "cat", "dan", "ivy"}
+		if len(got) != len(want) {
+			t.Fatalf("got %v", got)
+		}
+		for i, m := range got {
+			if m["userId"] != want[i] || m["role"] != "viewer" {
+				t.Fatalf("member %d: %v", i, m)
+			}
+		}
+
+		// Nobody can change tasks any more, but everyone can still read.
+		for _, u := range []string{"ann", "ivy", "ben", "cat", "dan"} {
+			if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", u, `{"status":"done"}`); code != 403 {
+				t.Fatalf("%s patch: %d", u, code)
+			}
+			if code, _ := do(t, h, "POST", "/projects/web/tasks", u, `{"title":"x"}`); code != 403 {
+				t.Fatalf("%s create: %d", u, code)
+			}
+			if code, _ := do(t, h, "DELETE", "/projects/web/tasks/t1", u, ""); code != 403 {
+				t.Fatalf("%s delete: %d", u, code)
+			}
+			if code, _ := do(t, h, "GET", "/projects/web/tasks", u, ""); code != 200 {
+				t.Fatalf("%s list: %d", u, code)
+			}
+		}
+		// A second freeze is refused: nobody is a manager any more.
+		if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 403 {
+			t.Fatalf("refreeze: %d", code)
+		}
+		// Other projects are untouched.
+		if code, _ := do(t, h, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`); code != 200 {
+			t.Fatalf("ops patch: %d", code)
+		}
+	})
+}
