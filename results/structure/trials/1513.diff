@@ -144,3 +144,81 @@ func loadDeleteTask(ctx context.Context, tx DB, taskID string) (*deleteTaskAggre
 func (a *deleteTaskAggregate) validate() error { return nil }
 
 func (a *deleteTaskAggregate) apply(ctx context.Context, tx DB) error { return a.task.destroy(ctx, tx) }
+
+// transferUserAggregate moves one user from its organization to another. The
+// user's memberships are all in the old organization's projects, so the
+// transfer removes them and unassigns the user's tasks: afterwards the user
+// has no membership and no assignment outside the new organization.
+type transferUserAggregate struct {
+	user        *User
+	toOrg       string
+	memberships []*Membership // every membership of the user
+	tasks       []*Task       // every task assigned to the user
+	archived    bool          // a membership is in an archived project
+}
+
+func loadTransferUser(ctx context.Context, tx DB, orgID, userID string, in UserTableTransferInput) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != orgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if in.ToOrgID == orgID {
+		return nil, deny(ErrInvalid, "user is already in that organization")
+	}
+	exists, err := NewUserTable().OrgExists(ctx, tx, in.ToOrgID)
+	if err != nil {
+		return nil, err
+	}
+	if !exists {
+		return nil, deny(ErrInvalid, "organization does not exist")
+	}
+	a := &transferUserAggregate{user: u, toOrg: in.ToOrgID}
+	if a.memberships, err = u.Memberships(ctx, tx); err != nil {
+		return nil, err
+	}
+	for _, m := range a.memberships {
+		p, err := m.Project(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		if p.Archived {
+			a.archived = true
+		}
+	}
+	if a.tasks, err = u.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if a.archived {
+		return deny(ErrArchived, "user is a member of an archived project")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	u := a.user
+	u.Org = a.toOrg
+	u.OrgAdmin = false // admin rights belong to the organization the user left
+	if err := u.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return u, nil
+}
