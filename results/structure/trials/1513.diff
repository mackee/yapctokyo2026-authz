+// OrgExists reports whether the organization has at least one user.
+func (*UserTable) OrgExists(ctx context.Context, db DB, orgID string) (bool, error) {
+	var one int
+	err := db.QueryRowContext(ctx, `SELECT 1 FROM users WHERE org_id = ? LIMIT 1`, orgID).Scan(&one)
