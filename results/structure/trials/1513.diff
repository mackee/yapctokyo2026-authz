--- /dev/null
+++ b/transfer_test.go
@@ -0,0 +1,109 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestTransferAccess(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin moves member", "eve", "/orgs/acme/users/cat/transfer", `{"toOrgId":"globex"}`, 200},
+		{"org admin moves user without memberships", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 200},
+		{"member of archived project", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 409},
+		{"manager, not org admin", "ann", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 403},
+		{"contributor, not org admin", "ben", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 403},
+		{"other org actor", "gus", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 404},
+		{"other org path", "eve", "/orgs/globex/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"user of another org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"anonymous", "", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown user header", "zed", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 401},
+		{"target org does not exist", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"initech"}`, 400},
+		{"target is the same org", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"acme"}`, 400},
+		{"missing toOrgId", "eve", "/orgs/acme/users/hal/transfer", `{}`, 400},
+		{"malformed body", "eve", "/orgs/acme/users/hal/transfer", `not json`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/cat/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got struct {
+		ID    string `json:"id"`
+		OrgID string `json:"orgId"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.ID != "cat" || got.OrgID != "globex" {
+		t.Fatalf("got %+v", got)
+	}
+}
+
+// After a transfer the user keeps the account but loses the old organization:
+// no access to its projects, no assignments in them, no memberships.
+func TestTransferEffects(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/orgs/acme/users/cat/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: got %d: %s", code, body)
+	}
+
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 404 {
+		t.Fatalf("old project read by transferred user: got %d want 404", code)
+	}
+
+	code, body := do(t, h, "GET", "/projects/web/tasks/t2", "ann", "")
+	if code != 200 {
+		t.Fatalf("get t2: got %d: %s", code, body)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "" {
+		t.Fatalf("t2 still assigned to %q", task.AssigneeID)
+	}
+
+	app := h.(*appHandler)
+	var memberships, inGlobex int
+	if err := app.db.QueryRow(`SELECT COUNT(*) FROM memberships WHERE user_id = 'cat'`).Scan(&memberships); err != nil {
+		t.Fatal(err)
+	}
+	if memberships != 0 {
+		t.Fatalf("cat still has %d memberships", memberships)
+	}
+	if err := app.db.QueryRow(`SELECT COUNT(*) FROM users WHERE id = 'cat' AND org_id = 'globex'`).Scan(&inGlobex); err != nil {
+		t.Fatal(err)
+	}
+	if inGlobex != 1 {
+		t.Fatalf("cat is not in globex")
+	}
+}
+
+// An org admin loses the admin right when the user moves to another organization.
+func TestTransferClearsOrgAdmin(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: got %d: %s", code, body)
+	}
+	var admin int
+	if err := h.(*appHandler).db.QueryRow(`SELECT org_admin FROM users WHERE id = 'eve'`).Scan(&admin); err != nil {
+		t.Fatal(err)
+	}
+	if admin != 0 {
+		t.Fatal("eve is still an org admin")
+	}
+}
