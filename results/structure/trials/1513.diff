+// UserTableTransferInput is the input of UserTable.Transfer.
+type UserTableTransferInput struct {
+	ToOrgID string
+}
+
+// Transfer moves the user from the organization to ToOrgID, all or nothing.
+// The user leaves the organization's projects: the memberships are removed,
+// the tasks assigned to the user are unassigned, and the org admin flag is
+// cleared. A user with a membership in an archived project is rejected
+// (ErrArchived), as archived projects reject all writes.
+func (*UserTable) Transfer(ctx context.Context, db DB, authz OrgAuthz, userID string, in UserTableTransferInput) (*User, error) {
+	if err := authz.CanManageUsers(); err != nil {
+		return nil, err
