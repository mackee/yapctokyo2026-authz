+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager removes", "ann", "/projects/web/members/dan", 204},
+		{"manager removes assignee", "ann", "/projects/web/members/ben", 204},
+		{"contributor", "ben", "/projects/web/members/cat", 403},
+		{"viewer", "dan", "/projects/web/members/cat", 403},
+		{"org admin", "eve", "/projects/web/members/dan", 403},
+		{"non member actor", "hal", "/projects/web/members/dan", 404},
+		{"target not member", "ann", "/projects/web/members/hal", 404},
+		{"archived", "ann", "/projects/legacy/members/ben", 409},
+		{"unknown project", "ann", "/projects/nope/members/dan", 404},
+		{"anonymous", "", "/projects/web/members/dan", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveMemberEffects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 204 {
+		t.Fatal(code)
+	}
+	// ben lost access to the project.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("removed member got %d want 404", code)
+	}
+	// ben's membership in other projects is untouched.
+	if code, _ := do(t, h, "GET", "/projects/legacy/tasks", "ben", ""); code != 200 {
+		t.Fatalf("other project got %d want 200", code)
+	}
+	// ben's tasks in web are unassigned.
+	_, body := do(t, h, "GET", "/projects/web/tasks", "ann", "")
+	var tasks []Task
+	json.Unmarshal([]byte(body), &tasks)
+	for _, task := range tasks {
+		if task.AssigneeID == "ben" {
+			t.Fatalf("task %s still assigned to removed member", task.ID)
+		}
+	}
+	// removing again is 404.
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 404 {
+		t.Fatalf("second removal got %d want 404", code)
+	}
+}
