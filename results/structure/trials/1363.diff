new file mode 100644
index 0000000..b081102
--- /dev/null
+++ b/members.go
@@ -0,0 +1,143 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+)
+
+type moveRequest struct {
+	ToProjectID string `json:"toProjectId"`
+}
+
+type moveResponse struct {
+	UserID    string `json:"userId"`
+	ProjectID string `json:"projectId"`
+	Role      string `json:"role"`
+}
+
+// moveMember handles POST /projects/{pid}/members/{uid}/move.
+//
+// It follows moveOutcome in spec/taskboard.qnt; the order of the checks is the
+// order of the model:
+//   - unknown user                                      -> 401
+//   - source project not readable by the caller         -> 404
+//   - caller is not a manager of the source project     -> 403
+//   - {uid} is not a member of the source project       -> 404
+//   - destination missing or not readable by the caller -> 404
+//   - destination is the source project                 -> 400
+//   - caller is not a manager of the destination        -> 403
+//   - source or destination archived                    -> 409
+//   - {uid} is already a member of the destination      -> 409
+//
+// The member keeps the role. Tasks of the source project assigned to the moved
+// user become unassigned, since an assignee must be a writer of the task's project.
+func (s *server) moveMember(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	caller, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if caller == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	// readable returns the project and the caller's role when the caller can read it.
+	readable := func(pid string) (*project, string, bool, error) {
+		p, err := findProject(ctx, s.db, pid)
+		if err != nil || p == nil || p.OrgID != caller.OrgID {
+			return nil, "", false, err
+		}
+		role, err := findRole(ctx, s.db, p.ID, caller.ID)
+		if err != nil {
+			return nil, "", false, err
+		}
+		if role == "" && !caller.OrgAdmin {
+			return nil, "", false, nil
+		}
+		return p, role, true, nil
+	}
+
+	src, srcRole, ok, err := readable(r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if !ok {
+		writeError(w, 404, "not found")
+		return
+	}
+	if srcRole != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	var req moveRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || req.ToProjectID == "" {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	memberID := r.PathValue("uid")
+	memberRole, err := findRole(ctx, s.db, src.ID, memberID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if memberRole == "" {
+		writeError(w, 404, "not found")
+		return
+	}
+	dst, dstRole, ok, err := readable(req.ToProjectID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if !ok {
+		writeError(w, 404, "not found")
+		return
+	}
+	if dst.ID == src.ID {
+		writeError(w, 400, "destination must be a different project")
+		return
+	}
+	if dstRole != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if src.Archived || dst.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	existing, err := findRole(ctx, s.db, dst.ID, memberID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if existing != "" {
+		writeError(w, 409, "user is already a member of the destination project")
+		return
+	}
+
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+	if _, err := tx.ExecContext(ctx, `DELETE FROM memberships WHERE project_id = ? AND user_id = ?`, src.ID, memberID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if _, err := tx.ExecContext(ctx, `INSERT INTO memberships (project_id, user_id, role) VALUES (?, ?, ?)`, dst.ID, memberID, memberRole); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if _, err := tx.ExecContext(ctx, `UPDATE tasks SET assignee = '' WHERE project_id = ? AND assignee = ?`, src.ID, memberID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, moveResponse{UserID: memberID, ProjectID: dst.ID, Role: memberRole})
+}
diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..1d0708f
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,78 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestMoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager of both moves contributor", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 200},
+		{"manager of both moves viewer", "ivy", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 200},
+		{"anonymous", "", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 401},
+		{"unknown user", "nobody", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 401},
+		{"not a manager of destination", "ann", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"contributor caller", "ben", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin is not a manager", "eve", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"non member caller", "hal", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"other org caller", "gus", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"missing source project", "ivy", "/projects/nope/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"user not in source", "ivy", "/projects/web/members/hal/move", `{"toProjectId":"ops"}`, 404},
+		{"missing destination", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"nope"}`, 404},
+		{"destination in other org", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"gx"}`, 404},
+		{"destination is source", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"web"}`, 400},
+		{"empty destination", "ivy", "/projects/web/members/ben/move", `{"toProjectId":""}`, 400},
+		{"bad body", "ivy", "/projects/web/members/ben/move", `nope`, 400},
+		{"already in destination", "ivy", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 409},
+		{"archived source", "ann", "/projects/legacy/members/ben/move", `{"toProjectId":"web"}`, 409},
+		{"archived destination", "ann", "/projects/web/members/ben/move", `{"toProjectId":"legacy"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestMoveMemberEffects(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got moveResponse
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if want := (moveResponse{UserID: "ben", ProjectID: "ops", Role: "contributor"}); got != want {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+	// ben left web and joined ops.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben still reads web: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben cannot read ops: %d", code)
+	}
+	// ben's task in web is unassigned (an assignee must be a writer of the project).
+	_, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" {
+		t.Fatalf("t1 still assigned to %q", task.Assignee)
+	}
+	// ben is a contributor in ops now, so can be assigned there.
+	if code, body := do(t, h, "PATCH", "/projects/ops/tasks/t4", "ivy", `{"assignee":"ben"}`); code != 200 {
+		t.Fatal(code, body)
+	}
+	// and can no longer be moved again from web.
+	if code, _ := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`); code != 404 {
+		t.Fatalf("second move: %d", code)
+	}
+}
diff --git a/spec/taskboard.qnt b/spec/taskboard.qnt
index fe78764..2e075cb 100644
--- a/spec/taskboard.qnt
+++ b/spec/taskboard.qnt
@@ -123,6 +123,22 @@ module taskboard {
     else if (projects.get(p).archived) 409
     else 204
 
+  // POST /projects/{pid}/members/{uid}/move {"toProjectId": to}
+  // Moves member m of project p to project `dst` with the same role. The caller
+  // must be a manager of both projects. Neither project may be archived, and m
+  // must not already be a member of the destination.
+  def moveOutcome(u: UserId, p: ProjectId, m: UserId, dst: ProjectId): int =
+    if (not(userExists(u))) 401
+    else if (not(canRead(u, p))) 404
+    else if (roleOf(p, u) != "manager") 403
+    else if (roleOf(p, m) == "") 404
+    else if (not(canRead(u, dst))) 404
+    else if (dst == p) 400
+    else if (roleOf(dst, u) != "manager") 403
+    else if (projects.get(p).archived or projects.get(dst).archived) 409
+    else if (roleOf(dst, m) != "") 409
+    else 200
+
   // ---- actions -------------------------------------------------------------
 
   action unchanged = all {
@@ -164,6 +180,20 @@ module taskboard {
       members' = members,
     } else unchanged
 
+  // The moved user loses the membership of p, so tasks of p assigned to them
+  // become unassigned (inv_assigneeIsWriter).
+  action moveMember(u: UserId, p: ProjectId, m: UserId, dst: ProjectId): bool =
+    if (moveOutcome(u, p, m, dst) == 200) all {
+      members' = members.keys().exclude(Set((p, m))).mapBy(k => members.get(k)).put((dst, m), members.get((p, m))),
+      tasks' = tasks.keys().mapBy(k =>
+        if (tasks.get(k).project == p and tasks.get(k).assignee == m)
+          { ...tasks.get(k), assignee: "" }
+        else tasks.get(k)),
+      nextTask' = nextTask,
+      users' = users,
+      projects' = projects,
+    } else unchanged
+
   // ---- seed data and steps -------------------------------------------------
 
   action init = all {
@@ -202,7 +232,10 @@ module taskboard {
     nondet t = 1.to(nextTask).oneOf()
     nondet s = STATUSES.oneOf()
     nondet changeAssignee = Set(true, false).oneOf()
+    nondet m = USERS.oneOf()
+    nondet dst = PROJECTS.oneOf()
     any {
+      moveMember(u, p, m, dst),
       createTask(u, p, a),
       updateTask(u, p, t, s, changeAssignee, a),
       deleteTask(u, p, t),
@@ -230,6 +263,15 @@ module taskboard {
       assert(deleteOutcome("ann", "web", 1) == 204),
       assert(deleteOutcome("ben", "web", 1) == 403),
       assert(deleteOutcome("ann", "web", 4) == 404),
+      assert(moveOutcome("ivy", "web", "ben", "ops") == 200),
+      assert(moveOutcome("ann", "web", "ben", "ops") == 403),
+      assert(moveOutcome("ben", "web", "cat", "ops") == 403),
+      assert(moveOutcome("ivy", "web", "cat", "ops") == 409),
+      assert(moveOutcome("ivy", "web", "hal", "ops") == 404),
+      assert(moveOutcome("ivy", "web", "ben", "gx") == 404),
+      assert(moveOutcome("ivy", "web", "ben", "web") == 400),
+      assert(moveOutcome("ann", "legacy", "ben", "web") == 409),
+      assert(moveOutcome("nobody", "web", "ben", "ops") == 401),
       unchanged,
     })
 }
