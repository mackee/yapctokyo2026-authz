+// ---- members ---------------------------------------------------------------------
+
+type memberRoles struct {
+	Roles map[string]string `json:"roles"`
+}
+
+type member struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// updateMembers changes the roles of existing members in one request:
+// PUT /projects/{pid}/members {"roles":{"ben":"viewer","dan":"contributor"}}.
+// The whole batch is applied or, if any entry is refused, nothing is changed.
+// On success it answers 200 with the project's members after the change.
+func (s *server) updateMembers(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role, err := findRole(ctx, s.db, project.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "only managers may change member roles")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req memberRoles
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || len(req.Roles) == 0 {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	for _, newRole := range req.Roles {
+		if newRole != RoleManager && newRole != RoleContributor && newRole != RoleViewer {
+			writeError(w, 400, "role must be manager, contributor or viewer")
+			return
+		}
+	}
+
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+	for userID := range req.Roles {
+		current, err := findRole(ctx, tx, project.ID, userID)
+		if err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+		if current == "" {
+			writeError(w, 400, "user is not a member of the project: "+userID)
+			return
+		}
+	}
+	// Only contributors and managers may hold tasks, so an assignee of a task in
+	// this project cannot be demoted to viewer.
+	for userID, newRole := range req.Roles {
+		if newRole == RoleManager || newRole == RoleContributor {
+			continue
+		}
+		var assigned int
+		if err := tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM tasks WHERE project_id = ? AND assignee = ?`, project.ID, userID).Scan(&assigned); err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+		if assigned > 0 {
+			writeError(w, 409, userID+" is assigned to tasks and must stay a contributor or manager")
+			return
+		}
+	}
+	for userID, newRole := range req.Roles {
+		if _, err := tx.ExecContext(ctx, `UPDATE memberships SET role = ? WHERE project_id = ? AND user_id = ?`, newRole, project.ID, userID); err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+
+	rows, err := s.db.QueryContext(ctx, `SELECT user_id, role FROM memberships WHERE project_id = ? ORDER BY user_id`, project.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer rows.Close()
+	members := []member{}
+	for rows.Next() {
+		var m member
+		if err := rows.Scan(&m.UserID, &m.Role); err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+		members = append(members, m)
+	}
+	if err := rows.Err(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, members)
+}
