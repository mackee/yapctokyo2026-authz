+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes", "eve", "/orgs/acme/users/cat", 204},
+		{"org admin removes user with no memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"manager is not org admin", "ann", "/orgs/acme/users/cat", 403},
+		{"contributor is not org admin", "ben", "/orgs/acme/users/cat", 403},
+		{"anonymous", "", "/orgs/acme/users/cat", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/cat", 401},
+		{"caller in other org", "gus", "/orgs/acme/users/cat", 404},
+		{"org admin of other org", "eve", "/orgs/globex/users/gus", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserRemovesAllMemberships(t *testing.T) {
+	h := newServer()
+	// ben is a contributor in web and legacy (archived); cat is in web and ops.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove ben: got %d want 204", code)
+	}
+	for _, path := range []string{"/projects/web/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, h, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("ben GET %s after removal: got %d want 404", path, code)
+		}
+	}
+	// Other members are untouched.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ann", ""); code != 200 {
+		t.Fatalf("ann GET web after removing ben: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat GET ops after removing ben: got %d want 200", code)
+	}
+}
+
+func TestRemoveOrgUserAppliesToEveryProject(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/cat", "eve", ""); code != 204 {
+		t.Fatalf("remove cat: got %d want 204", code)
+	}
+	for _, path := range []string{"/projects/web/tasks", "/projects/ops/tasks"} {
+		if code, _ := do(t, h, "GET", path, "cat", ""); code != 404 {
+			t.Fatalf("cat GET %s after removal: got %d want 404", path, code)
+		}
+	}
+	// The removed user cannot write either.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "cat", `{"title":"x"}`); code != 404 {
+		t.Fatalf("cat POST web after removal: got %d want 404", code)
+	}
+	// Removing again is still 204.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/cat", "eve", ""); code != 204 {
+		t.Fatalf("second remove cat: got %d want 204", code)
+	}
+}
