+func TestChangeRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager demotes", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 200},
+		{"manager promotes", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"manager sets same role", "ann", "/projects/web/members/ben", `{"role":"contributor"}`, 200},
+		{"contributor", "ben", "/projects/web/members/cat", `{"role":"viewer"}`, 403},
+		{"viewer", "dan", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"org admin", "eve", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"non member", "hal", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"other org", "gus", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"anonymous", "", "/projects/web/members/ben", `{"role":"viewer"}`, 401},
+		{"unknown user", "zed", "/projects/web/members/ben", `{"role":"viewer"}`, 401},
+		{"unknown project", "ann", "/projects/nope/members/ben", `{"role":"viewer"}`, 404},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"target member of other project only", "ann", "/projects/web/members/gus", `{"role":"viewer"}`, 404},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"invalid role", "ann", "/projects/web/members/ben", `{"role":"owner"}`, 400},
+		{"empty role", "ann", "/projects/web/members/ben", `{"role":""}`, 400},
+		{"missing role", "ann", "/projects/web/members/ben", `{}`, 400},
+		{"malformed body", "ann", "/projects/web/members/ben", `nope`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestChangeRoleResponseAndEffect(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 2 || got["userId"] != "ben" || got["role"] != "viewer" {
+		t.Fatalf("unexpected response %v", got)
+	}
+	// ben is now a viewer: can still read, can no longer write.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben read: got %d", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Fatalf("ben create: got %d want 403", code)
+	}
+	// dan promoted to contributor can now create tasks.
+	do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("dan create: got %d want 200", code)
+	}
+}
+
+func TestChangeRoleRejectedLeavesRoleUnchanged(t *testing.T) {
+	h := newServer()
+	do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"owner"}`)
+	do(t, h, "PUT", "/projects/web/members/ben", "cat", `{"role":"viewer"}`)
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 200 {
+		t.Fatalf("ben should still be contributor, got %d", code)
+	}
+	// Failed change on a non-member must not create a membership.
+	do(t, h, "PUT", "/projects/web/members/hal", "ann", `{"role":"viewer"}`)
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "hal", ""); code != 404 {
+		t.Fatalf("hal should still be a non-member, got %d", code)
+	}
+}
