+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes user without memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"org admin removes unknown user", "eve", "/orgs/acme/users/zed", 404},
+		{"org admin removes user of other org", "eve", "/orgs/acme/users/gus", 404},
+		{"org admin, other org path", "eve", "/orgs/globex/users/gus", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ben", 404},
+		{"project manager is not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"non member of org", "hal", "/orgs/acme/users/ben", 403},
+		{"user of other org", "gus", "/orgs/acme/users/ben", 404},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown actor", "zed", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	srv := newServer()
+
+	// Before: ben is a contributor of web and legacy, and is assigned t1 and t5.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("before: ben reads web: got %d", code)
+	}
+
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove ben: got %d want 204", code)
+	}
+
+	// ben is no longer a member of any acme project (and not an org admin).
+	for _, p := range []string{"/projects/web/tasks", "/projects/legacy/tasks", "/projects/web/tasks/t1"} {
+		if code, _ := do(t, srv, "GET", p, "ben", ""); code != 404 {
+			t.Fatalf("ben GET %s: got %d want 404", p, code)
+		}
+	}
+	if code, _ := do(t, srv, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 404 {
+		t.Fatalf("ben PATCH t1: got %d want 404", code)
+	}
+
+	// Tasks ben held are now unassigned; other assignments are untouched.
+	assignee := func(path string) string {
+		t.Helper()
+		code, body := do(t, srv, "GET", path, "ann", "")
+		if code != 200 {
+			t.Fatalf("ann GET %s: got %d", path, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		return task.Assignee
+	}
+	if got := assignee("/projects/web/tasks/t1"); got != "" {
+		t.Fatalf("web t1 assignee: got %q want unassigned", got)
+	}
+	if got := assignee("/projects/legacy/tasks/t5"); got != "" {
+		t.Fatalf("legacy t5 assignee: got %q want unassigned", got)
+	}
+	if got := assignee("/projects/web/tasks/t2"); got != "cat" {
+		t.Fatalf("web t2 assignee: got %q want cat", got)
+	}
+
+	// ben can no longer be assigned anywhere in acme.
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "ann", `{"title":"x","assignee":"ben"}`); code != 400 {
+		t.Fatalf("assign ben: got %d want 400", code)
+	}
+
+	// Removing again is a no-op that still succeeds.
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("second remove: got %d want 204", code)
+	}
+}
