+// ---- organization capabilities -----------------------------------------------
+
+type orgScope struct {
+	as  *actorScope
+	oid string
+}
+
+// Manage applies the organization rule: the actor must belong to the
+// organization (else 404, so other organizations are not visible) and must be
+// one of its org admins (else 403).
+func (s *orgScope) Manage() (ManageOrg, error) {
+	err := s.as.a.st.read(func(st *state) error {
+		if s.as.actor.org != s.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		if !s.as.actor.orgAdmin {
+			return deny(ErrForbidden, "forbidden")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &manageOrg{os: s}, nil
+}
+
+// ManageOrg is the org-admin capability for one organization.
+type ManageOrg interface {
+	// RemoveUser removes a user of the organization from every project of the
+	// organization (offboarding). Tasks the user was assigned to become
+	// unassigned, so the model invariants hold. Removing a user who has no
+	// memberships is a no-op. The user must belong to the organization (else 404).
+	RemoveUser(userID string) error
+}
+
+type manageOrg struct{ os *orgScope }
+
+func (m *manageOrg) RemoveUser(userID string) error {
+	return m.os.as.a.st.tx(func(s *state) error {
+		u, ok := s.users[userID]
+		if !ok || u.org != m.os.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		for pid, members := range s.members {
+			if s.projects[pid].org != m.os.oid {
+				continue
+			}
+			delete(members, userID)
+		}
+		for tid, t := range s.tasks {
+			if t.assignee.user == userID {
+				t.assignee = Assignee{project: t.project}
+				s.tasks[tid] = t
+			}
+		}
+		return nil
+	})
+}
+
