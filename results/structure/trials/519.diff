+// moveMemberAggregate moves one member from a source project to a destination
+// project, keeping the role.
+type moveMemberAggregate struct {
+	from     *Membership // the member in the source project
+	to       *Project    // the destination project
+	user     *User       // the member's user
+	existing *Membership // the member's membership in the destination, if any
+}
+
+func loadMoveMember(ctx context.Context, tx DB, fromProjectID, toProjectID, userID string) (*moveMemberAggregate, error) {
+	from, err := NewMembershipTable().Find(ctx, tx, fromProjectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	to, err := NewProjectTable().Find(ctx, tx, toProjectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "member must be an existing user")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveMemberAggregate{from: from, to: to, user: u}
+	existing, err := to.Membership(ctx, tx, userID)
+	if err == nil {
+		a.existing = existing
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.user.Org != a.to.Org {
+		return deny(ErrInvalid, "project members must belong to the project's organization")
+	}
+	if a.existing != nil {
+		return deny(ErrInvalid, "user is already a member of the destination project")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.from.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	m := &Membership{ProjectID: a.to.ID, UserID: a.from.UserID, Role: a.from.Role}
+	if err := m.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
