+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestUpdateMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager promotes", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"manager demotes", "ann", "/projects/web/members/cat", `{"role":"viewer"}`, 200},
+		{"contributor", "ben", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"viewer", "dan", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"org admin", "eve", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"non member", "hal", "/projects/web/members/dan", `{"role":"contributor"}`, 404},
+		{"other org", "gus", "/projects/web/members/dan", `{"role":"contributor"}`, 404},
+		{"anonymous", "", "/projects/web/members/dan", `{"role":"contributor"}`, 401},
+		{"unknown project", "ann", "/projects/nope/members/dan", `{"role":"contributor"}`, 404},
+		{"target not member", "ann", "/projects/web/members/hal", `{"role":"contributor"}`, 404},
+		{"target in other org", "ann", "/projects/web/members/gus", `{"role":"contributor"}`, 404},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"invalid role", "ann", "/projects/web/members/dan", `{"role":"owner"}`, 400},
+		{"missing role", "ann", "/projects/web/members/dan", `{}`, 400},
+		{"bad json", "ann", "/projects/web/members/dan", `nope`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRoleResponseAndEffect(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var resp map[string]string
+	if err := json.Unmarshal([]byte(body), &resp); err != nil {
+		t.Fatal(err)
+	}
+	if resp["userId"] != "dan" || resp["role"] != "contributor" || len(resp) != 2 {
+		t.Fatalf("unexpected response %v", resp)
+	}
+	// dan can now write.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("promoted member cannot create task: %d", code)
+	}
+	// Other projects are unaffected.
+	if role, _ := findRole(t.Context(), h.(*appHandler).db, "ops", "ann"); role != RoleViewer {
+		t.Fatalf("ann's role in ops changed to %q", role)
+	}
+}
+
+// Demoting an assignee to viewer must not leave tasks assigned to a viewer
+// (checked by the model rules in do()); the tasks become unassigned.
+func TestDemoteUnassignsTasks(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatal(code, body)
+	}
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatal(code)
+	}
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" {
+		t.Fatalf("t1 still assigned to %q", task.Assignee)
+	}
+	// Tasks of others, and tasks of the same user in other projects, are untouched.
+	_, body = do(t, h, "GET", "/projects/web/tasks/t2", "ann", "")
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "cat" {
+		t.Fatalf("t2 assignee changed to %q", task.Assignee)
+	}
+	// cat is a contributor in both web and ops; demoting in web leaves t4 (ops) alone.
+	if code, body := do(t, h, "PUT", "/projects/web/members/cat", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatal(code, body)
+	}
+	_, body = do(t, h, "GET", "/projects/ops/tasks/t4", "ivy", "")
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "cat" {
+		t.Fatalf("t4 assignee changed to %q", task.Assignee)
+	}
+}
+
+func TestDemoteToContributorKeepsTasks(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "PUT", "/projects/web/members/ann", "ann", `{"role":"contributor"}`); code != 200 {
+		t.Fatal(code, body)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t2", "ann", `{"status":"done"}`); code != 403 {
+		t.Fatalf("demoted manager still manages: %d", code)
+	}
+}
