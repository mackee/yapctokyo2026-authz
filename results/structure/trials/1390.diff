+func TestFreeze(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"archived", "ann", "legacy", 409},
+		{"unknown user", "zed", "web", 401},
+		{"anonymous", "", "web", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResponseListsMembersAsViewers(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+	var got []struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []string{"ann", "ben", "cat", "dan", "ivy"}
+	if len(got) != len(want) {
+		t.Fatalf("got %d members, want %d: %s", len(got), len(want), body)
+	}
+	for i, m := range got {
+		if m.UserID != want[i] || m.Role != "viewer" {
+			t.Fatalf("member %d: got %+v, want {%s viewer}", i, m, want[i])
+		}
+	}
+}
+
+func TestFreezeClosesProject(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d want 200", code)
+	}
+
+	cases := []struct {
+		name, method, path, user, body string
+		want                           int
+	}{
+		{"create by manager", "POST", "/projects/web/tasks", "ann", `{"title":"x"}`, 403},
+		{"create by contributor", "POST", "/projects/web/tasks", "ben", `{"title":"x"}`, 403},
+		{"update own task", "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`, 403},
+		{"update by manager", "PATCH", "/projects/web/tasks/t2", "ann", `{"status":"done"}`, 403},
+		{"delete by manager", "DELETE", "/projects/web/tasks/t1", "ann", "", 403},
+		{"freeze again", "POST", "/projects/web/freeze", "ann", "", 403},
+		{"read still works", "GET", "/projects/web/tasks", "ben", "", 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, srv, c.method, c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+
+	// The assignment of t1 (ben, web) is cleared; t4 (ops) is untouched.
+	_, body := do(t, srv, "GET", "/projects/web/tasks/t1", "dan", "")
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "" {
+		t.Fatalf("t1 still assigned to %q", task.AssigneeID)
+	}
+	_, body = do(t, srv, "GET", "/projects/ops/tasks/t4", "ann", "")
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "cat" {
+		t.Fatalf("ops task t4 assignee changed to %q", task.AssigneeID)
+	}
+}
