+package main
+
+import "testing"
+
+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes user without projects", "eve", "/orgs/acme/users/hal", 204},
+		{"non admin", "ann", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"other org", "gus", "/orgs/acme/users/ben", 404},
+		{"missing org", "eve", "/orgs/nope/users/ben", 404},
+		{"missing user", "eve", "/orgs/acme/users/zed", 404},
+		{"user of another org", "eve", "/orgs/acme/users/gus", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserSideEffects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("got %d want 204", code)
+	}
+	db := h.(*appHandler).db
+
+	// removed from every project, including the archived one
+	var n int
+	if err := db.QueryRow(`SELECT COUNT(*) FROM memberships WHERE user_id = 'ben'`).Scan(&n); err != nil {
+		t.Fatal(err)
+	}
+	if n != 0 {
+		t.Fatalf("ben still has %d memberships", n)
+	}
+	// other members are untouched
+	if err := db.QueryRow(`SELECT COUNT(*) FROM memberships WHERE project_id = 'web'`).Scan(&n); err != nil {
+		t.Fatal(err)
+	}
+	if n != 4 {
+		t.Fatalf("web has %d memberships, want 4", n)
+	}
+
+	// tasks he was assigned to become unassigned, not deleted
+	for _, id := range []string{"t1", "t5"} {
+		var assignee string
+		if err := db.QueryRow(`SELECT assignee FROM tasks WHERE id = ?`, id).Scan(&assignee); err != nil {
+			t.Fatalf("task %s: %v", id, err)
+		}
+		if assignee != "" {
+			t.Fatalf("task %s still assigned to %q", id, assignee)
+		}
+	}
+	// others' assignments are untouched
+	var assignee string
+	if err := db.QueryRow(`SELECT assignee FROM tasks WHERE id = 't2'`).Scan(&assignee); err != nil {
+		t.Fatal(err)
+	}
+	if assignee != "cat" {
+		t.Fatalf("t2 assignee = %q, want cat", assignee)
+	}
+
+	// the former member no longer has access
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 401 {
+		t.Fatalf("removed user got %d want 401", code)
+	}
+	// removing twice -> 404
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 404 {
+		t.Fatalf("second removal got %d want 404", code)
+	}
+}
+
+func TestRemovedOrgAdminLosesAccess(t *testing.T) {
+	// a second org admin leaving must not keep read access to the org's projects
+	h := newServer()
+	db := h.(*appHandler).db
+	if _, err := db.Exec(`INSERT INTO users (id, org_id, org_admin) VALUES ('amy', 'acme', 1)`); err != nil {
+		t.Fatal(err)
+	}
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/amy", "eve", ""); code != 204 {
+		t.Fatalf("got %d want 204", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "amy", ""); code != 401 {
+		t.Fatalf("removed admin got %d want 401", code)
+	}
+}
