+// moveTaskAggregate moves one task into another project. The task keeps its
+// assignee, so the assignee must be a writer in the target project.
+type moveTaskAggregate struct {
+	task      *Task
+	projectID string
+	assignee  *Membership // the assignee's membership in the target project; nil if none
+}
+
+func loadMoveTask(ctx context.Context, x *Tx, taskID, projectID string) (*moveTaskAggregate, error) {
+	t, err := NewTaskTable().Find(ctx, x, taskID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	p, err := NewProjectTable().Find(ctx, x, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "task must belong to an existing project")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveTaskAggregate{task: t, projectID: p.ID}
+	if t.AssigneeID != "" {
+		m, err := p.Membership(ctx, x, t.AssigneeID)
+		if errors.Is(err, ErrNoRows) {
+			return a, nil // no membership: validate rejects the move
+		} else if err != nil {
+			return nil, err
+		}
+		a.assignee = m
+	}
+	return a, nil
+}
+
+func (a *moveTaskAggregate) validate() error {
+	if a.task.AssigneeID != "" && (a.assignee == nil || !isWriterRole(a.assignee.Role)) {
+		return deny(ErrInvalid, "assignee must be a contributor or manager of the target project")
+	}
+	return nil
+}
+
+func (a *moveTaskAggregate) apply(ctx context.Context, x *Tx) (*Task, error) {
+	if err := a.task.moveTo(ctx, x, a.projectID); err != nil {
+		return nil, err
+	}
+	return a.task, nil
+}
+
