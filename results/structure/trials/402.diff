+// Move moves the task into the project toProjectID. The task keeps its ID,
+// title, status and assignee. The actor needs edit rights on the task in its
+// current project, then write rights in the target project (a target that is
+// missing or not readable by the actor is ErrNotFound). The assignee must be a
+// contributor or manager of the target project, otherwise the move is rejected
+// and nothing changes.
+func (*TaskTable) Move(ctx context.Context, db DB, authz TaskAuthz, toProjectID string) (*Task, error) {
+	if err := authz.CanEdit(); err != nil {
+		return nil, err
+	}
+	target, err := NewProjectAuthz(ctx, db, authz.Project().Actor(), toProjectID)
+	if err != nil {
+		return nil, err
+	}
+	if err := target.CanWrite(); err != nil {
+		return nil, err
+	}
+	if target.ProjectID() == authz.Project().ProjectID() {
+		return nil, deny(ErrInvalid, "task is already in that project")
+	}
+	var t *Task
+	if err := db.update(ctx, func(x *Tx) error {
