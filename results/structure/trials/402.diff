+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if t, err = agg.apply(ctx, x); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return t, nil
+}
