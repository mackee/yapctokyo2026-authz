diff --git a/move_test.go b/move_test.go
new file mode 100644
index 0000000..6911a27
--- /dev/null
+++ b/move_test.go
@@ -0,0 +1,111 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestMoveAccess(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"contributor own", "cat", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 200},
+		{"manager any", "ivy", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 200},
+		{"contributor others", "cat", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"viewer source", "dan", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"target viewer", "ann", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 403},
+		{"target non member", "ben", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 404},
+		{"target missing", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"nope"}`, 404},
+		{"target other org", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"gx"}`, 404},
+		{"target archived", "ann", "/projects/web/tasks/t1", `{"toProjectId":"legacy"}`, 409},
+		{"source archived", "ann", "/projects/legacy/tasks/t5", `{"toProjectId":"web"}`, 409},
+		{"same project", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"web"}`, 400},
+		{"assignee not in target", "ivy", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 400},
+		{"cross project id", "ann", "/projects/web/tasks/t4", `{"toProjectId":"web"}`, 404},
+		{"empty target", "ivy", "/projects/web/tasks/t3", `{"toProjectId":""}`, 400},
+		{"missing target", "ivy", "/projects/web/tasks/t3", `{}`, 400},
+		{"bad json", "ivy", "/projects/web/tasks/t3", `{`, 400},
+		{"anonymous", "", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsTask(t *testing.T) {
+	h := newServer()
+
+	code, body := do(t, h, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d: %s", code, body)
+	}
+	var moved Task
+	if err := json.Unmarshal([]byte(body), &moved); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", AssigneeID: "cat"}
+	if moved != want {
+		t.Fatalf("moved task = %+v, want %+v", moved, want)
+	}
+
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t2", "ann", ""); code != 404 {
+		t.Fatalf("old project still has task: %d", code)
+	}
+	code, body = do(t, h, "GET", "/projects/ops/tasks/t2", "cat", "")
+	if code != 200 {
+		t.Fatalf("new project read: got %d", code)
+	}
+	var got Task
+	json.Unmarshal([]byte(body), &got)
+	if got != want {
+		t.Fatalf("stored task = %+v, want %+v", got, want)
+	}
+
+	code, body = do(t, h, "GET", "/projects/ops/tasks", "cat", "")
+	var list []Task
+	json.Unmarshal([]byte(body), &list)
+	if code != 200 || len(list) != 2 {
+		t.Fatalf("ops list: code %d, %d tasks; want 2 (t2 and t4)", code, len(list))
+	}
+}
+
+func TestMoveRejectedLeavesTaskInPlace(t *testing.T) {
+	h := newServer()
+
+	// t1 is assigned to ben, who is not in ops.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks/t1/move", "ivy", `{"toProjectId":"ops"}`); code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var got Task
+	json.Unmarshal([]byte(body), &got)
+	if code != 200 || got.ProjectID != "web" || got.AssigneeID != "ben" {
+		t.Fatalf("task changed after rejected move: %d %+v", code, got)
+	}
+}
+
+func TestMoveAssigneeMustBeWriterInTarget(t *testing.T) {
+	h := newServer()
+
+	// ann is a viewer in ops, so a task assigned to ann cannot move there.
+	code, body := do(t, h, "POST", "/projects/web/tasks", "ivy", `{"title":"x","assignee":"ann"}`)
+	if code != 200 {
+		t.Fatalf("create: got %d: %s", code, body)
+	}
+	var created Task
+	json.Unmarshal([]byte(body), &created)
+
+	code, _ = do(t, h, "POST", "/projects/web/tasks/"+created.ID+"/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/"+created.ID, "ann", ""); code != 200 {
+		t.Fatalf("task left its project after rejected move: %d", code)
+	}
+}
