 }
 
+// transferUserAggregate moves one user from their organization to another.
+//
+// The user's memberships are in projects of the old organization, and members
+// must belong to the project's organization, so they are removed. An assignee
+// must be a member of the task's project, so the tasks assigned to the user are
+// unassigned. Both are part of the same change. Archived projects are
+// read-only, so a user who is a member of one cannot be transferred. Org admin
+// rights are not carried over (transferTo).
+type transferUserAggregate struct {
+	user        *User
+	toOrg       *Org
+	memberships []*Membership // the user's memberships; all in the old organization
+	tasks       []*Task       // the tasks assigned to the user
+}
+
+func loadTransferUser(ctx context.Context, tx DB, orgID, userID, toOrgID string) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != orgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	o, err := NewOrgTable().Find(ctx, tx, toOrgID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "target organization does not exist")
+	} else if err != nil {
+		return nil, err
+	}
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	ts, err := u.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &transferUserAggregate{user: u, toOrg: o, memberships: ms, tasks: ts}, nil
+}
+
+func (a *transferUserAggregate) validate(ctx context.Context, tx DB) error {
+	// A task assigned to the user is in a project the user is a member of, so
+	// checking the memberships covers the assigned tasks too.
+	for _, m := range a.memberships {
+		p, err := m.Project(ctx, tx)
+		if err != nil {
+			return err
+		}
+		if p.Archived {
+			return deny(ErrArchived, "user is a member of an archived project")
+		}
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.user.transferTo(ctx, tx, a.toOrg.ID); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
+
