+package model
+
+import (
+	"context"
+	"testing"
+)
+
+// count runs a COUNT query with one string argument and returns the result.
+func count(t *testing.T, db DB, query string, arg string) int {
+	t.Helper()
+	var n int
+	if err := db.QueryRowContext(context.Background(), query, arg).Scan(&n); err != nil {
+		t.Fatal(err)
+	}
+	return n
+}
+
+func eveOfAcme(t *testing.T) OrgAuthz {
+	t.Helper()
+	authz, err := NewOrgAuthz(Actor{id: "eve", org: "acme", orgAdmin: true}, "acme")
+	if err != nil {
+		t.Fatal(err)
+	}
+	return authz
+}
+
+func TestTransferUserRemovesMembershipsAndAssignments(t *testing.T) {
+	conn, err := Open()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+
+	// cat is a contributor in web (t2 assigned) and ops (t4 assigned); neither is archived.
+	u, err := NewUserTable().Transfer(context.Background(), conn, eveOfAcme(t), "cat", "globex")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if u.Org != "globex" || u.OrgAdmin {
+		t.Fatalf("got org %q admin %v", u.Org, u.OrgAdmin)
+	}
+	if n := count(t, conn, `SELECT COUNT(*) FROM memberships WHERE user_id = ?`, "cat"); n != 0 {
+		t.Fatalf("memberships left: %d", n)
+	}
+	if n := count(t, conn, `SELECT COUNT(*) FROM tasks WHERE assignee = ?`, "cat"); n != 0 {
+		t.Fatalf("tasks still assigned: %d", n)
+	}
+	// Model rule: every assignee is a member of its task's project.
+	var broken int
+	if err := conn.QueryRowContext(context.Background(), `SELECT COUNT(*) FROM tasks t WHERE t.assignee <> '' AND NOT EXISTS
+		(SELECT 1 FROM memberships m WHERE m.project_id = t.project_id AND m.user_id = t.assignee)`).Scan(&broken); err != nil {
+		t.Fatal(err)
+	}
+	if broken != 0 {
+		t.Fatalf("assignee rule broken: %d tasks", broken)
+	}
+}
+
+func TestTransferUserFailureChangesNothing(t *testing.T) {
+	conn, err := Open()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+
+	// ann is a member of the archived legacy project, so the transfer is refused.
+	if _, err := NewUserTable().Transfer(context.Background(), conn, eveOfAcme(t), "ann", "globex"); err == nil {
+		t.Fatal("want error")
+	}
+	if n := count(t, conn, `SELECT COUNT(*) FROM users WHERE id = ? AND org_id = 'acme'`, "ann"); n != 1 {
+		t.Fatal("ann moved although the transfer failed")
+	}
+	if n := count(t, conn, `SELECT COUNT(*) FROM memberships WHERE user_id = ?`, "ann"); n != 3 {
+		t.Fatalf("memberships changed: %d want 3", n)
+	}
+}
