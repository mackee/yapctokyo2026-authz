+// Transfer moves the user from the authorization object's organization into
+// toOrgID, all or nothing. See transferUserAggregate for what changes with it.
+func (*UserTable) Transfer(ctx context.Context, db DB, authz OrgAuthz, userID, toOrgID string) (*User, error) {
+	if err := authz.CanManageUsers(); err != nil {
+		return nil, err
+	}
+	if toOrgID == "" {
+		return nil, deny(ErrInvalid, "toOrgId must not be empty")
+	}
+	if toOrgID == authz.OrgID() {
+		return nil, deny(ErrInvalid, "user is already in that organization")
+	}
+	var u *User
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadTransferUser(ctx, tx, authz.OrgID(), userID, toOrgID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(ctx, tx); err != nil {
+			return err
+		}
+		if u, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return u, nil
+}
