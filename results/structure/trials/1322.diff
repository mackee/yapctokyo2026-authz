+func TestSetMemberRoles(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager changes roles", "ann", "web", `{"roles":{"dan":"contributor","ivy":"contributor"}}`, 200},
+		{"manager promotes assignee", "ann", "web", `{"roles":{"ben":"manager"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"org admin is not a manager", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"manager of another project", "ann", "ops", `{"roles":{"cat":"viewer"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"unknown user", "zed", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"manager"}}`, 409},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"bad json", "ann", "web", `{"roles":`, 400},
+		{"invalid role", "ann", "web", `{"roles":{"dan":"admin"}}`, 400},
+		{"target is not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"target is unknown", "ann", "web", `{"roles":{"nobody":"viewer"}}`, 400},
+		{"one bad target fails the batch", "ann", "web", `{"roles":{"dan":"contributor","hal":"viewer"}}`, 400},
+		{"assignee demoted to viewer", "ann", "web", `{"roles":{"ben":"viewer"}}`, 409},
+		{"assignee demoted in a batch", "ann", "web", `{"roles":{"dan":"contributor","cat":"viewer"}}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMemberRolesResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann",
+		`{"roles":{"dan":"contributor","ivy":"viewer"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var members []memberView
+	if err := json.Unmarshal([]byte(body), &members); err != nil {
+		t.Fatal(err)
+	}
+	want := []memberView{
+		{"ann", "manager"},
+		{"ben", "contributor"},
+		{"cat", "contributor"},
+		{"dan", "contributor"},
+		{"ivy", "viewer"},
+	}
+	if !reflect.DeepEqual(members, want) {
+		t.Fatalf("got %+v want %+v", members, want)
+	}
+}
+
+func TestSetMemberRolesTakesEffect(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor"}}`); code != 200 {
+		t.Fatalf("promote: got %d: %s", code, body)
+	}
+	if code, body := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x","assignee":"dan"}`); code != 200 {
+		t.Fatalf("dan should now create tasks: got %d: %s", code, body)
+	}
+	// dan still holds a task, so demoting him is a conflict until it is reassigned.
+	if code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"viewer"}}`); code != 409 {
+		t.Fatalf("demote with a task: got %d want 409", code)
+	}
+	if code, body := do(t, h, "PATCH", "/projects/web/tasks/t7", "ann", `{"assignee":"ben"}`); code != 200 {
+		t.Fatalf("reassign: got %d: %s", code, body)
+	}
+	if code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"viewer"}}`); code != 200 {
+		t.Fatalf("demote: got %d: %s", code, body)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"y"}`); code != 403 {
+		t.Fatalf("dan should be a viewer again: got %d", code)
+	}
+}
+
+// A rejected batch must change nothing, not even the valid entries in it.
+func TestSetMemberRolesAllOrNothing(t *testing.T) {
+	h := newServer()
+	// Non-member target, unknown target, assignee demoted, invalid role.
+	rejected := []string{
+		`{"roles":{"dan":"contributor","hal":"viewer"}}`,
+		`{"roles":{"dan":"contributor","admin":"viewer"}}`,
+		`{"roles":{"dan":"contributor","ben":"viewer"}}`,
+		`{"roles":{"dan":"contributor","ivy":"bogus"}}`,
+	}
+	for _, body := range rejected {
+		if code, _ := do(t, h, "PUT", "/projects/web/members", "ann", body); code == 200 {
+			t.Fatalf("batch %s should be rejected", body)
+		}
+	}
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ivy":"manager"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var members []memberView
+	if err := json.Unmarshal([]byte(body), &members); err != nil {
+		t.Fatal(err)
+	}
+	for _, m := range members {
+		if m.UserID == "dan" && m.Role != "viewer" {
+			t.Fatalf("dan changed to %s by a rejected batch", m.Role)
+		}
+		if m.UserID == "ben" && m.Role != "contributor" {
+			t.Fatalf("ben changed to %s by a rejected batch", m.Role)
+		}
+	}
+}
