+func TestRemoveUserFromOrg(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes", "eve", "/orgs/acme/users/ben", 204},
+		{"user without memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"manager is not admin", "ann", "/orgs/acme/users/ben", 403},
+		{"other org caller", "gus", "/orgs/acme/users/ben", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ben", 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed", 404},
+		{"user of another org", "eve", "/orgs/acme/users/gus", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveUserEffects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatal(code)
+	}
+	// ben was a member of web and legacy (archived): no longer readable.
+	for _, p := range []string{"web", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ben", ""); code != 404 {
+			t.Fatalf("ben still reads %s: %d", p, code)
+		}
+	}
+	// his tasks (t1 in web, t5 in legacy) are unassigned; others are untouched.
+	want := map[string]string{"t1": "", "t2": "cat", "t3": ""}
+	_, body := do(t, h, "GET", "/projects/web/tasks", "ann", "")
+	var tasks []Task
+	if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+		t.Fatal(err)
+	}
+	for _, task := range tasks {
+		if task.AssigneeID != want[task.ID] {
+			t.Fatalf("task %s assignee %q", task.ID, task.AssigneeID)
+		}
+	}
+	_, body = do(t, h, "GET", "/projects/legacy/tasks/t5", "ann", "")
+	var t5 Task
+	if err := json.Unmarshal([]byte(body), &t5); err != nil || t5.AssigneeID != "" {
+		t.Fatalf("t5 %q %v", body, err)
+	}
+	// other members keep access and their tasks.
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "cat", ""); code != 200 {
+		t.Fatal(code)
+	}
+	// removing again is a no-op.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatal(code)
+	}
+}
