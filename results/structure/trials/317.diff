+// ManageProject may manage the membership of one project.
+type ManageProject interface {
+	ReadProject
+	// MoveMember moves a member of this project to the project "to", keeping
+	// their role. The caller must also be a manager of "to" (else 403/404/409).
+	// The move is one commit: the user leaves this project and joins "to".
+	// It is refused (409) if the user already belongs to "to", or if they are
+	// still assigned to a task in this project; reassign those tasks first.
+	MoveMember(userID string, to ProjectScope) (MemberView, error)
+}
+
+// MemberView is the public representation of a project membership.
+type MemberView struct {
+	UserID    string `json:"userId"`
+	ProjectID string `json:"projectId"`
+	Role      string `json:"role"`
+}
+
+type manageProject struct{ readProject }
+
+func (p *manageProject) MoveMember(userID string, to ProjectScope) (MemberView, error) {
+	from := p.ps.pid
+	if to.ID() == from {
+		return MemberView{}, deny(ErrInvalid, "destination must be a different project")
+	}
+	dest, err := to.Manage()
+	if err != nil {
+		return MemberView{}, err
+	}
+	destID := dest.ID()
+	var v MemberView
+	err = p.ps.as.a.st.tx(func(s *state) error {
+		role := s.role(from, userID)
+		if role == "" {
+			return deny(ErrNotFound, "not found")
+		}
+		if s.role(destID, userID) != "" {
+			return deny(ErrConflict, "user is already a member of the destination project")
+		}
+		for _, t := range s.tasks {
+			if t.project == from && t.assignee.user == userID {
+				return deny(ErrConflict, "user is assigned to tasks in this project; reassign them first")
+			}
+		}
+		delete(s.members[from], userID)
+		if s.members[destID] == nil {
+			s.members[destID] = map[string]string{}
+		}
+		s.members[destID][userID] = role
+		v = MemberView{UserID: userID, ProjectID: destID, Role: role}
+		return nil
+	})
+	if err != nil {
+		return MemberView{}, err
+	}
+	return v, nil
+}
