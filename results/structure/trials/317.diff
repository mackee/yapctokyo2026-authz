+func TestMoveMember(t *testing.T) {
+	const toOps = `{"toProjectId":"ops"}`
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager moves viewer", "ivy", "/projects/web/members/dan/move", toOps, 200},
+		{"manager moves member assigned to tasks", "ivy", "/projects/web/members/cat/move", toOps, 409},
+		{"user not in source", "ivy", "/projects/web/members/hal/move", toOps, 404},
+		{"already in destination", "ivy", "/projects/web/members/ivy/move", toOps, 409},
+		{"same project", "ivy", "/projects/web/members/dan/move", `{"toProjectId":"web"}`, 400},
+		{"empty destination", "ivy", "/projects/web/members/dan/move", `{}`, 400},
+		{"unknown destination", "ivy", "/projects/web/members/dan/move", `{"toProjectId":"nope"}`, 404},
+		{"destination in other org", "ivy", "/projects/web/members/dan/move", `{"toProjectId":"gx"}`, 404},
+		{"destination not managed by actor", "ann", "/projects/web/members/dan/move", toOps, 403},
+		{"destination archived", "ann", "/projects/web/members/dan/move", `{"toProjectId":"legacy"}`, 409},
+		{"source archived", "ann", "/projects/legacy/members/ben/move", `{"toProjectId":"web"}`, 409},
+		{"contributor cannot move", "ben", "/projects/web/members/dan/move", toOps, 403},
+		{"viewer cannot move", "dan", "/projects/web/members/dan/move", toOps, 403},
+		{"org admin cannot move", "eve", "/projects/web/members/dan/move", toOps, 403},
+		{"anonymous", "", "/projects/web/members/dan/move", toOps, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveMemberResponseAndAccess(t *testing.T) {
+	s := newServer()
+
+	// Unassign ben's only task in web so that ben can leave the project.
+	if code, body := do(t, s, "PATCH", "/projects/web/tasks/t1", "ivy", `{"assignee":""}`); code != 200 {
+		t.Fatalf("unassign: got %d: %s", code, body)
+	}
+
+	code, body := do(t, s, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]string{"userId": "ben", "projectId": "ops", "role": "contributor"}
+	for k, v := range want {
+		if got[k] != v {
+			t.Fatalf("response %s: got %q want %q (body %s)", k, got[k], v, body)
+		}
+	}
+
+	// ben keeps the contributor role in the destination ...
+	if code, body := do(t, s, "POST", "/projects/ops/tasks", "ben", `{"title":"x"}`); code != 201 {
+		t.Fatalf("ben create in ops: got %d: %s", code, body)
+	}
+	// ... and has lost access to the source.
+	if code, _ := do(t, s, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben read web after move: got %d want 404", code)
+	}
+	if code, _ := do(t, s, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`); code != 404 {
+		t.Fatalf("second move: got %d want 404", code)
+	}
+}
