@@ -0,0 +1,147 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"reflect"
+	"testing"
+)
+
+func TestFreeze(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"manager of another project", "ann", "ops", 403},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+		{"unknown project", "ann", "nope", 404},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResponseListsAllMembersAsViewers(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got []member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("response is not a member list: %v: %s", err, body)
+	}
+	want := []member{
+		{UserID: "ann", Role: "viewer"},
+		{UserID: "ben", Role: "viewer"},
+		{UserID: "cat", Role: "viewer"},
+		{UserID: "dan", Role: "viewer"},
+		{UserID: "ivy", Role: "viewer"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+}
+
+func TestFreezeLeavesOtherProjectsAlone(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d: %s", code, body)
+	}
+	// ann is a viewer on ops, and ivy is still a manager there.
+	if code, _ := do(t, h, "PATCH", "/projects/ops/tasks/t4", "ivy", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ops write after web freeze: got %d want 200", code)
+	}
+}
+
+// After the first freeze nobody is a manager any more, so a second freeze is
+// refused like any other write by a viewer.
+func TestFreezeTwiceIsRefused(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ivy", ""); code != 200 {
+		t.Fatalf("first freeze: got %d: %s", code, body)
+	}
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ivy", ""); code != 403 {
+		t.Fatalf("second freeze: got %d want 403: %s", code, body)
+	}
+}
+
+func TestFrozenProjectRejectsTaskWrites(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ivy", ""); code != 200 {
+		t.Fatalf("freeze: got %d: %s", code, body)
+	}
+	cases := []struct {
+		name, user, method, path, body string
+		want                           int
+	}{
+		{"former manager create", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"former manager update", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"former manager delete", "ann", "DELETE", "/projects/web/tasks/t1", "", 403},
+		{"former contributor update own", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`, 403},
+		{"former contributor create", "cat", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"former manager ivy update", "ivy", "PATCH", "/projects/web/tasks/t3", `{"title":"y"}`, 403},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, h, c.method, c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+
+	// Reads still work, and nothing changed.
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "dan", "")
+	if code != 200 {
+		t.Fatalf("read after freeze: got %d", code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.Status != "open" || task.Title != "Fix header" {
+		t.Fatalf("task changed while frozen: %+v", task)
+	}
+}
+
+// Freezing demotes every member, so the role check already blocks writes. This
+// checks the frozen flag on its own: with a manager restored in the database,
+// writes must still be refused with 409.
+func TestFrozenFlagRejectsManagerWrites(t *testing.T) {
+	srv := newServer()
+	h := srv.(*appHandler)
+	if code, body := do(t, srv, "POST", "/projects/web/freeze", "ivy", ""); code != 200 {
+		t.Fatalf("freeze: got %d: %s", code, body)
+	}
+	if _, err := h.db.Exec(`UPDATE memberships SET role = 'manager' WHERE project_id = 'web' AND user_id = 'ann'`); err != nil {
+		t.Fatal(err)
+	}
+	cases := []struct {
+		name, method, path, body string
+	}{
+		{"create", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"update", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"delete", "DELETE", "/projects/web/tasks/t1", ""},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, srv, c.method, c.path, "ann", c.body)
+			if code != http.StatusConflict {
+				t.Fatalf("got %d want 409: %s", code, body)
+			}
+		})
+	}
+}
