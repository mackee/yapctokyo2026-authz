+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin self", "eve", "/orgs/acme/users/eve", 204},
+		{"manager not admin", "ann", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"other org admin path", "eve", "/orgs/globex/users/gus", 404},
+		{"other org user", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatal(code)
+	}
+	// ben lost access to every project, including the archived one.
+	for _, p := range []string{"web", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ben", ""); code != 404 {
+			t.Fatalf("%s: ben still readable: %d", p, code)
+		}
+	}
+	// Tasks assigned to ben are unassigned; the rest are untouched.
+	for tid, want := range map[string]string{"t1": "", "t2": "cat"} {
+		_, body := do(t, h, "GET", "/projects/web/tasks/"+tid, "ann", "")
+		var task Task
+		json.Unmarshal([]byte(body), &task)
+		if task.Assignee != want {
+			t.Fatalf("%s assignee %q want %q", tid, task.Assignee, want)
+		}
+	}
+	_, body := do(t, h, "GET", "/projects/legacy/tasks/t5", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" {
+		t.Fatalf("t5 assignee %q", task.Assignee)
+	}
+	// Other users keep their access.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatal(code)
+	}
+}
