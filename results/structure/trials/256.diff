+// OrgScope is bound to one actor and one organization ID.
+type OrgScope interface {
+	// Manage applies the org-admin rule: the organization is the actor's own
+	// (else 404) and the actor is an org admin (else 403).
+	Manage() (ManageOrg, error)
+}
+
+// ManageOrg is the org-admin capability for one organization.
+type ManageOrg interface {
+	// RemoveUser takes a user out of every project of the organization
+	// (offboarding) and unassigns their tasks there, archived projects
+	// included. A user who is not in the organization is 404. Atomic.
+	RemoveUser(userID string) error
+}
+
 type actorScope struct {
 	a     *Authorizer
 	actor Actor
 }
 
 func (s *actorScope) Actor() Actor { return s.actor }
+func (s *actorScope) Org(orgID string) OrgScope {
+	return &orgScope{as: s, oid: orgID}
+}
+
+type orgScope struct {
+	as  *actorScope
+	oid string
+}
+
+func (s *orgScope) Manage() (ManageOrg, error) {
+	act := s.as.actor
+	if act.org != s.oid {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if !act.orgAdmin {
+		return nil, deny(ErrForbidden, "forbidden")
+	}
+	return &manageOrg{os: s}, nil
+}
+
+type manageOrg struct{ os *orgScope }
+
+func (m *manageOrg) RemoveUser(userID string) error {
+	return m.os.as.a.st.tx(func(s *state) error {
+		if u, ok := s.users[userID]; !ok || u.org != m.os.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		for pid, members := range s.members {
+			if s.projects[pid].org == m.os.oid {
+				delete(members, userID)
+			}
+		}
+		for id, t := range s.tasks {
+			if t.assignee.user == userID {
+				t.assignee = Assignee{project: t.project}
+				s.tasks[id] = t
+			}
+		}
+		return nil
+	})
+}
 func (s *actorScope) Project(projectID string) ProjectScope {
 	return &projectScope{as: s, pid: projectID}
 }
