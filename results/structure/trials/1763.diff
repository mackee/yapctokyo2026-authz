diff --git a/move_test.go b/move_test.go
new file mode 100644
index 0000000..00c27be
--- /dev/null
+++ b/move_test.go
@@ -0,0 +1,152 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"testing"
+)
+
+func movePath(pid, uid string) string { return "/projects/" + pid + "/members/" + uid + "/move" }
+
+func TestMoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, pid, uid, body string
+		want                       int
+	}{
+		{"manager of both moves contributor", "ivy", "web", "ben", `{"toProjectId":"ops"}`, 200},
+		{"manager of both moves viewer", "ivy", "web", "dan", `{"toProjectId":"ops"}`, 200},
+		{"already in destination (manager)", "ivy", "web", "ann", `{"toProjectId":"ops"}`, 400},
+		{"manager moves self, already in destination", "ivy", "ops", "ivy", `{"toProjectId":"web"}`, 400},
+		{"not manager of destination", "ann", "web", "ben", `{"toProjectId":"ops"}`, 403},
+		{"contributor", "ben", "web", "cat", `{"toProjectId":"ops"}`, 403},
+		{"viewer", "dan", "web", "ben", `{"toProjectId":"ops"}`, 403},
+		{"org admin", "eve", "web", "ben", `{"toProjectId":"ops"}`, 403},
+		{"non member of source", "hal", "web", "ben", `{"toProjectId":"ops"}`, 404},
+		{"other org caller", "gus", "web", "ben", `{"toProjectId":"gx"}`, 404},
+		{"target not a member of source", "ivy", "web", "hal", `{"toProjectId":"ops"}`, 404},
+		{"unknown target user", "ivy", "web", "zed", `{"toProjectId":"ops"}`, 404},
+		{"destination missing", "ivy", "web", "ben", `{"toProjectId":"nope"}`, 404},
+		{"destination in other org", "ivy", "web", "ben", `{"toProjectId":"gx"}`, 404},
+		{"destination archived", "ann", "web", "ben", `{"toProjectId":"legacy"}`, 409},
+		{"source archived", "ann", "legacy", "ben", `{"toProjectId":"web"}`, 409},
+		{"already member of destination", "ivy", "web", "cat", `{"toProjectId":"ops"}`, 400},
+		{"same project", "ivy", "web", "ben", `{"toProjectId":"web"}`, 400},
+		{"missing toProjectId", "ivy", "web", "ben", `{}`, 400},
+		{"empty toProjectId", "ivy", "web", "ben", `{"toProjectId":""}`, 400},
+		{"malformed body", "ivy", "web", "ben", `{`, 400},
+		{"malformed body beats access", "hal", "web", "ben", `{}`, 400},
+		{"anonymous", "", "web", "ben", `{"toProjectId":"ops"}`, 401},
+		{"unknown caller", "zed", "web", "ben", `{"toProjectId":"ops"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", movePath(c.pid, c.uid), c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d (%s)", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestMoveMemberResult(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", movePath("web", "ben"), "ivy", `{"toProjectId":"ops"}`)
+	if code != http.StatusOK {
+		t.Fatalf("got %d (%s)", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]string{"userId": "ben", "projectId": "ops", "role": "contributor"}
+	if len(got) != len(want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	for k, v := range want {
+		if got[k] != v {
+			t.Fatalf("got %v want %v", got, want)
+		}
+	}
+
+	// the same role is kept for a viewer
+	_, body = do(t, h, "POST", movePath("web", "dan"), "ivy", `{"toProjectId":"ops"}`)
+	if err := json.Unmarshal([]byte(body), &got); err != nil || got["role"] != "viewer" || got["projectId"] != "ops" || got["userId"] != "dan" {
+		t.Fatalf("viewer move: %s", body)
+	}
+}
+
+func TestMoveMemberChangesMembership(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben should read web before: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben should not read ops before: %d", code)
+	}
+	if code, body := do(t, h, "POST", movePath("web", "ben"), "ivy", `{"toProjectId":"ops"}`); code != 200 {
+		t.Fatalf("move: %d %s", code, body)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben should no longer read web: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben should read ops: %d", code)
+	}
+	// ben keeps the contributor role: he can create a task assigned to himself in ops
+	if code, body := do(t, h, "POST", "/projects/ops/tasks", "ben", `{"title":"x","assignee":"ben"}`); code != 200 {
+		t.Fatalf("ben should contribute in ops: %d %s", code, body)
+	}
+	// moving again from web is now 404 (not a member any more)
+	if code, _ := do(t, h, "POST", movePath("web", "ben"), "ivy", `{"toProjectId":"ops"}`); code != 404 {
+		t.Fatalf("second move: %d", code)
+	}
+}
+
+// A member who leaves a project can no longer be an assignee there, so the
+// tasks assigned to them in the source project become unassigned.
+func TestMoveMemberUnassignsTasks(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", movePath("web", "ben"), "ivy", `{"toProjectId":"ops"}`); code != 200 {
+		t.Fatalf("move: %d %s", code, body)
+	}
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("get t1: %d", code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "" || task.ProjectID != "web" {
+		t.Fatalf("t1 should stay in web, unassigned: %+v", task)
+	}
+	// other tasks are untouched
+	_, body = do(t, h, "GET", "/projects/web/tasks/t2", "ann", "")
+	if err := json.Unmarshal([]byte(body), &task); err != nil || task.AssigneeID != "cat" {
+		t.Fatalf("t2 should still be cat's: %s", body)
+	}
+}
+
+// A rejected move changes nothing.
+func TestMoveMemberRejectedChangesNothing(t *testing.T) {
+	h := newServer()
+	for _, c := range []struct{ user, uid, body string }{
+		{"ann", "ben", `{"toProjectId":"ops"}`}, // 403: not a manager of ops
+		{"ivy", "cat", `{"toProjectId":"ops"}`}, // 400: already in ops
+	} {
+		if code, _ := do(t, h, "POST", movePath("web", c.uid), c.user, c.body); code < 400 {
+			t.Fatalf("expected rejection, got %d", code)
+		}
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben should still be in web: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat should still be in web: %d", code)
+	}
+	_, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil || task.AssigneeID != "ben" {
+		t.Fatalf("t1 should still be ben's: %s", body)
+	}
+}
