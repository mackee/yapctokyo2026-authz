+// Move moves the user from the project of `from` to the project of `to`,
+// keeping the role, and returns the new membership. The actor must be a
+// manager of both (unarchived) projects. Tasks assigned to the user in the
+// source project become unassigned. All or nothing.
+func (*MembershipTable) Move(ctx context.Context, db DB, from, to ProjectAuthz, userID string) (*Membership, error) {
+	if err := from.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if err := to.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveMember(ctx, tx, from.ProjectID(), to.ProjectID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		m, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
