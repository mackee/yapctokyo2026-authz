+// moveMemberAggregate moves one member from one project to another, keeping
+// the role. Tasks assigned to the member in the source project are
+// unassigned, because an assignee must be a member of the task's project.
+type moveMemberAggregate struct {
+	from, to *Project
+	user     *User
+	current  *Membership // the member's membership in from
+	tasks    []*Task     // current.AssignedTasks
+	existing *Membership // the member's membership in to; nil when none
+}
+
+func loadMoveMember(ctx context.Context, tx DB, fromID, toID, userID string) (*moveMemberAggregate, error) {
+	from, err := NewProjectTable().Find(ctx, tx, fromID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	to, err := NewProjectTable().Find(ctx, tx, toID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	current, err := from.Membership(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveMemberAggregate{from: from, to: to, current: current}
+	if a.user, err = current.User(ctx, tx); errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if a.tasks, err = current.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	switch m, err := to.Membership(ctx, tx, userID); {
+	case err == nil:
+		a.existing = m
+	case !errors.Is(err, ErrNoRows):
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.from.ID == a.to.ID {
+		return deny(ErrInvalid, "the member is already in that project")
+	}
+	if a.existing != nil {
+		return deny(ErrInvalid, "the user is already a member of the destination project")
+	}
+	if a.user.Org != a.to.Org {
+		return deny(ErrInvalid, "project members must belong to the project's organization")
+	}
+	if !isValidRole(a.current.Role) {
+		return deny(ErrInvalid, "invalid role")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.current.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	m := a.to.newMembership(a.current.UserID, a.current.Role)
+	if err := m.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
+
