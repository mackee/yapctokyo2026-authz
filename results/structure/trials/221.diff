+type updateMembersRequest struct {
+	Roles map[string]string `json:"roles"`
+}
+
+// updateMembers changes several members' roles atomically: either every
+// change is applied or none is. Only managers may change roles.
+func (s *server) updateMembers(w http.ResponseWriter, r *http.Request) {
+	s.store.mu.Lock()
+	defer s.store.mu.Unlock()
+
+	user := s.store.User(r.Header.Get("X-User"))
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project := s.store.Project(r.PathValue("pid"))
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role := s.store.Role(project.ID, user.ID)
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req updateMembersRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || len(req.Roles) == 0 {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	managers := 0
+	for _, m := range s.store.Members(project.ID) {
+		if m.Role == RoleManager {
+			managers++
+		}
+	}
+	for uid, newRole := range req.Roles {
+		if newRole != RoleManager && newRole != RoleContributor && newRole != RoleViewer {
+			writeError(w, 400, "invalid role for "+uid)
+			return
+		}
+		oldRole := s.store.Role(project.ID, uid)
+		if oldRole == "" {
+			writeError(w, 400, uid+" is not a member of the project")
+			return
+		}
+		if oldRole == RoleManager {
+			managers--
+		}
+		if newRole == RoleManager {
+			managers++
+		}
+	}
+	if managers < 1 {
+		writeError(w, 409, "project must keep at least one manager")
+		return
+	}
+	s.store.SetRoles(project.ID, req.Roles)
+	writeJSON(w, 200, s.store.Members(project.ID))
+}
+
