+func TestUpdateMembersResponseAndAtomicity(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var members []Member
+	if err := json.Unmarshal([]byte(body), &members); err != nil {
+		t.Fatal(err)
+	}
+	got := map[string]string{}
+	for _, m := range members {
+		got[m.UserID] = m.Role
+	}
+	want := map[string]string{"ann": "manager", "ben": "viewer", "cat": "contributor", "dan": "contributor", "ivy": "manager"}
+	if len(got) != len(want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	for k, v := range want {
+		if got[k] != v {
+			t.Fatalf("got %v want %v", got, want)
+		}
+	}
+
+	// One bad entry must leave everything unchanged.
+	code, _ = do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"cat":"viewer","hal":"viewer"}}`)
+	if code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	code, _ = do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"cat":"viewer","dan":"bogus"}}`)
+	if code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	// cat is still a contributor, so can still create tasks.
+	code, _ = do(t, h, "POST", "/projects/web/tasks", "cat", `{"title":"x"}`)
+	if code != 201 {
+		t.Fatalf("cat should still be contributor, got %d", code)
+	}
+}
