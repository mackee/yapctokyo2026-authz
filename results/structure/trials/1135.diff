+func TestSetMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager changes", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 200},
+		{"manager promotes viewer", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"contributor", "ben", "/projects/web/members/cat", `{"role":"viewer"}`, 403},
+		{"viewer", "dan", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"org admin non member", "eve", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"non member", "hal", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"other org", "gus", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"anonymous", "", "/projects/web/members/ben", `{"role":"viewer"}`, 401},
+		{"unknown user", "zed", "/projects/web/members/ben", `{"role":"viewer"}`, 401},
+		{"missing project", "ann", "/projects/nope/members/ben", `{"role":"viewer"}`, 404},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"target in other project", "ann", "/projects/web/members/gus", `{"role":"viewer"}`, 404},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"invalid role", "ann", "/projects/web/members/ben", `{"role":"owner"}`, 400},
+		{"empty role", "ann", "/projects/web/members/ben", `{"role":""}`, 400},
+		{"invalid body", "ann", "/projects/web/members/ben", `not json`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMemberRoleResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+	var got struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.UserID != "ben" || got.Role != "viewer" {
+		t.Fatalf("got %+v", got)
+	}
+}
+
+func TestSetMemberRoleTakesEffect(t *testing.T) {
+	h := newServer()
+	// ben is a contributor: he may update his own task t1.
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"doing"}`); code != 200 {
+		t.Fatalf("before: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote: got %d want 200", code)
+	}
+	// As a viewer, ben can no longer write, even to his own task.
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 403 {
+		t.Fatalf("after: got %d want 403", code)
+	}
+	// He can still read.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t1", "ben", ""); code != 200 {
+		t.Fatalf("read after demote: got %d want 200", code)
+	}
+}
