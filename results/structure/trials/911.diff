+// transferUserAggregate moves one user to another organization.
+//
+// Project members are users of the project's organization, and an assignee is
+// a member of the task's project. So the user's memberships in projects of the
+// old organization are removed, and the tasks they hold there are unassigned,
+// in the same transaction. The user's organization admin flag is cleared.
+type transferUserAggregate struct {
+	user    *User
+	fromOrg string
+	in      UserTableTransferInput
+	toOrgOK bool          // the target organization exists
+	leaving []*Membership // the user's memberships in projects of fromOrg
+}
+
+func loadTransferUser(ctx context.Context, tx DB, fromOrg, userID string, in UserTableTransferInput) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != fromOrg {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	a := &transferUserAggregate{user: u, fromOrg: fromOrg, in: in}
+	a.toOrgOK, err = NewUserTable().OrgExists(ctx, tx, in.ToOrgID)
+	if err != nil {
+		return nil, err
+	}
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, m := range ms {
+		p, err := m.Project(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		if p.Org == fromOrg {
+			a.leaving = append(a.leaving, m)
+		}
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if a.in.ToOrgID == a.fromOrg {
+		return deny(ErrInvalid, "user is already in that organization")
+	}
+	if !a.toOrgOK {
+		return deny(ErrInvalid, "organization does not exist")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	for _, m := range a.leaving {
+		tasks, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		for _, t := range tasks {
+			if err := t.unassign(ctx, tx); err != nil {
+				return nil, err
+			}
+		}
+		if err := m.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.user.transferTo(ctx, tx, a.in.ToOrgID); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
+
