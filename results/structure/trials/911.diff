+// TestTransferSideEffects checks what leaves with a transferred user: the
+// memberships and assignments in the old organization's projects, and the org
+// admin flag.
+func TestTransferSideEffects(t *testing.T) {
+	srv := newServer()
+
+	// Before: ben is assigned t1 in web (acme) and t5 in legacy (acme, archived).
+	if code, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ann", ""); code != 200 || !strings.Contains(body, `"assignee":"ben"`) {
+		t.Fatalf("before: %d %s", code, body)
+	}
+
+	if code, body := do(t, srv, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer ben: %d %s", code, body)
+	}
+
+	// ben now belongs to globex: acme projects are gone for him.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads acme project after transfer: got %d want 404", code)
+	}
+	// His assignments in acme projects are cleared, the rest of the task is kept.
+	if code, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ann", ""); code != 200 || !strings.Contains(body, `"assignee":""`) || !strings.Contains(body, `"title":"Fix header"`) {
+		t.Fatalf("t1 after transfer: %d %s", code, body)
+	}
+	if code, body := do(t, srv, "GET", "/projects/legacy/tasks/t5", "ann", ""); code != 200 || !strings.Contains(body, `"assignee":""`) {
+		t.Fatalf("t5 after transfer: %d %s", code, body)
+	}
+	// Other users in acme are untouched.
+	if code, body := do(t, srv, "GET", "/projects/web/tasks/t2", "ann", ""); code != 200 || !strings.Contains(body, `"assignee":"cat"`) {
+		t.Fatalf("t2 after transfer: %d %s", code, body)
+	}
+
+	// A transfer brings no memberships into the new org.
+	if code, _ := do(t, srv, "GET", "/projects/gx/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads gx after transfer: got %d want 404", code)
+	}
+
+	// Transferring the org admin clears the admin flag: eve loses her acme
+	// admin rights and gets none in globex.
+	if code, body := do(t, srv, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer eve: %d %s", code, body)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "eve", ""); code != 404 {
+		t.Fatalf("eve reads acme project after transfer: got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "POST", "/orgs/globex/users/gus/transfer", "eve", `{"toOrgId":"acme"}`); code != 403 {
+		t.Fatalf("transferred admin keeps rights: got %d want 403", code)
+	}
+}
