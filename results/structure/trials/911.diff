+// OrgExists reports whether the organization exists. There is no organizations
+// table: an organization exists when at least one user belongs to it.
+func (*UserTable) OrgExists(ctx context.Context, db DB, org string) (bool, error) {
+	var exists bool
+	if err := db.QueryRowContext(ctx, `SELECT EXISTS (SELECT 1 FROM users WHERE org_id = ?)`, org).
+		Scan(&exists); err != nil {
+		return false, err
+	}
+	return exists, nil
+}
+
+// UserTableTransferInput is the input of UserTable.Transfer.
+type UserTableTransferInput struct {
+	ToOrgID string
+}
+
+// Transfer moves the user from the authorized organization to another one, all
+// or nothing. See transferUserAggregate for what leaves with the user.
+func (*UserTable) Transfer(ctx context.Context, db DB, authz OrgAuthz, userID string, in UserTableTransferInput) (*User, error) {
+	if err := authz.CanTransferUsers(); err != nil {
+		return nil, err
+	}
+	var u *User
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadTransferUser(ctx, tx, authz.Org(), userID, in)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if u, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return u, nil
+}
