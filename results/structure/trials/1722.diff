+type member struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func parseMembers(t *testing.T, body string) map[string]string {
+	t.Helper()
+	var ms []member
+	if err := json.Unmarshal([]byte(body), &ms); err != nil {
+		t.Fatalf("bad members body %q: %v", body, err)
+	}
+	out := map[string]string{}
+	for _, m := range ms {
+		out[m.UserID] = m.Role
+	}
+	return out
+}
+
+func TestSetMemberRoles(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	got := parseMembers(t, body)
+	want := map[string]string{"ann": "manager", "ben": "viewer", "cat": "contributor", "dan": "contributor", "ivy": "manager"}
+	if len(got) != len(want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	for k, v := range want {
+		if got[k] != v {
+			t.Fatalf("got %v want %v", got, want)
+		}
+	}
+	// the change is persisted: dan can now create tasks, ben cannot.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("dan create: %d", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Fatalf("ben create: %d", code)
+	}
+}
+
+func TestSetMemberRolesErrors(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"anonymous", "", "web", `{"roles":{"ben":"viewer"}}`, 401},
+		{"contributor", "ben", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"ben":"viewer"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"ben":"viewer"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"ben":"viewer"}}`, 404},
+		{"unknown project", "ann", "nope", `{"roles":{"ben":"viewer"}}`, 404},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"invalid role", "ann", "web", `{"roles":{"ben":"boss"}}`, 400},
+		{"empty role", "ann", "web", `{"roles":{"ben":""}}`, 400},
+		{"not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"unknown user", "ann", "web", `{"roles":{"zed":"viewer"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"bad json", "ann", "web", `nope`, 400},
+		{"removes all managers", "ann", "web", `{"roles":{"ann":"viewer","ivy":"contributor"}}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+// One bad entry must leave every other entry unchanged.
+func TestSetMemberRolesAtomic(t *testing.T) {
+	bad := []string{
+		`{"roles":{"ben":"viewer","cat":"boss"}}`,
+		`{"roles":{"ben":"viewer","hal":"viewer"}}`,
+		`{"roles":{"ben":"viewer","zed":"viewer"}}`,
+		`{"roles":{"ben":"viewer","ann":"viewer","ivy":"viewer"}}`,
+	}
+	for _, b := range bad {
+		h := newServer()
+		if code, _ := do(t, h, "PUT", "/projects/web/members", "ann", b); code < 400 {
+			t.Fatalf("%s: got %d, want error", b, code)
+		}
+		// A no-op update returns the current list.
+		code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ann":"manager"}}`)
+		if code != 200 {
+			t.Fatalf("%d: %s", code, body)
+		}
+		got := parseMembers(t, body)
+		want := map[string]string{"ann": "manager", "ben": "contributor", "cat": "contributor", "dan": "viewer", "ivy": "manager"}
+		for k, v := range want {
+			if got[k] != v {
+				t.Fatalf("%s: state changed: got %v want %v", b, got, want)
+			}
+		}
+	}
+}
+
+// Demoting a user to viewer unassigns their tasks, since only contributors and
+// managers may be assignees.
+func TestSetMemberRolesUnassignsDemoted(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer"}}`); code != 200 {
+		t.Fatalf("%d: %s", code, body)
+	}
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatal(code)
+	}
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" {
+		t.Fatalf("t1 still assigned to %q", task.Assignee)
+	}
+}
+
+func TestSetMemberRolesManagerHandover(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/ops/members", "ivy", `{"roles":{"ann":"manager","ivy":"viewer"}}`)
+	if code != 200 {
+		t.Fatalf("%d: %s", code, body)
+	}
+	got := parseMembers(t, body)
+	if got["ann"] != "manager" || got["ivy"] != "viewer" {
+		t.Fatalf("got %v", got)
+	}
