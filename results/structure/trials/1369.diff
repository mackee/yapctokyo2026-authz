+type moveRequest struct {
+	ToProjectID string `json:"toProjectId" validate:"required"`
+}
+
+// moveTask moves the task to another project. The target project is read
+// through the same authorization object as the source (NewProjectAuthz), so an
+// unreadable or unknown target is 404.
+func moveTask(ctx tanukirpc.Context[*taskRegistry], req moveRequest) (*Task, error) {
+	reg := ctx.Registry()
+	target, err := model.NewProjectAuthz(ctx, reg.db, reg.authz.Project().Actor(), req.ToProjectID)
+	if err != nil {
+		return nil, err
+	}
+	return model.NewTaskTable().Move(ctx, reg.db, reg.authz, target)
+}
