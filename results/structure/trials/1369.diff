+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager to writable target", "ivy", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 200},
+		{"contributor source", "cat", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 403},
+		{"contributor cannot read target", "ben", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 404},
+		{"manager, viewer in target", "ann", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"target unreadable (other org)", "ivy", "/projects/web/tasks/t2", `{"toProjectId":"gx"}`, 404},
+		{"target missing", "ivy", "/projects/web/tasks/t2", `{"toProjectId":"missing"}`, 404},
+		{"same project", "ivy", "/projects/web/tasks/t2", `{"toProjectId":"web"}`, 400},
+		{"assignee not in target", "ivy", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 400},
+		{"target archived", "ann", "/projects/web/tasks/t2", `{"toProjectId":"legacy"}`, 409},
+		{"source archived", "ann", "/projects/legacy/tasks/t5", `{"toProjectId":"web"}`, 409},
+		{"task in other project", "ann", "/projects/web/tasks/t4", `{"toProjectId":"legacy"}`, 404},
+		{"empty target", "ivy", "/projects/web/tasks/t2", `{"toProjectId":""}`, 400},
+		{"missing body field", "ivy", "/projects/web/tasks/t2", `{}`, 400},
+		{"unknown user", "zed", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsTaskFields(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d: %s", code, body)
+	}
+	var moved Task
+	if err := json.Unmarshal([]byte(body), &moved); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", AssigneeID: "cat"}
+	if moved != want {
+		t.Fatalf("moved task = %+v, want %+v", moved, want)
+	}
+
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks/t2", "ivy", ""); code != 200 {
+		t.Fatalf("task not readable in target: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t2", "ivy", ""); code != 404 {
+		t.Fatalf("task still readable in source: %d", code)
+	}
+	code, body = do(t, h, "GET", "/projects/ops/tasks", "ivy", "")
+	if code != 200 {
+		t.Fatal(code)
+	}
+	var tasks []Task
+	if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+		t.Fatal(err)
+	}
+	if len(tasks) != 2 {
+		t.Fatalf("want 2 tasks in ops (t4 and the moved t2), got %d", len(tasks))
+	}
+}
