+// CanMove returns nil if the actor may move the task to the target project
+// (built by NewProjectAuthz, so it is readable): managers of the task's project
+// only (else ErrForbidden); the task's project not archived (else ErrArchived);
+// the target is another project (else ErrInvalid); and the actor may write in
+// the target (see ProjectAuthz.CanWrite). The task's assignee must also be a
+// contributor or manager of the target; the table operation checks that.
+func (a TaskAuthz) CanMove(target ProjectAuthz) error {
+	if !a.CanRead() || a.project.role != RoleManager {
+		return deny(ErrForbidden, "only managers may move tasks")
+	}
+	if a.project.archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	if target.ProjectID() == a.project.project {
+		return deny(ErrInvalid, "task is already in that project")
+	}
+	return target.CanWrite()
+}
