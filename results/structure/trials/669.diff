+func TestFreeze(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown project", "ann", "nope", 404},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeDemotesAllMembers(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var members []struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &members); err != nil {
+		t.Fatal(err)
+	}
+	want := []string{"ann", "ben", "cat", "dan", "ivy"}
+	if len(members) != len(want) {
+		t.Fatalf("got %d members, want %d: %s", len(members), len(want), body)
+	}
+	for i, m := range members {
+		if m.UserID != want[i] || m.Role != "viewer" {
+			t.Fatalf("member %d = %+v, want {%s viewer}", i, m, want[i])
+		}
+	}
+}
+
+func TestFreezeBlocksTaskWrites(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze got %d body=%s", code, body)
+	}
+	cases := []struct {
+		name, user, method, path, body string
+		want                           int
+	}{
+		{"contributor own task", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`, 403},
+		{"former manager", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"former manager create", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"former manager delete", "ann", "DELETE", "/projects/web/tasks/t1", "", 403},
+		{"second freeze", "ann", "POST", "/projects/web/freeze", "", 403},
+		{"other project unaffected", "cat", "PATCH", "/projects/ops/tasks/t4", `{"status":"done"}`, 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, h, c.method, c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
