+
+// removeOrgUserAggregate takes one user out of every project of one
+// organization: the user's memberships there are removed, and the user's task
+// assignments in those projects are cleared so that no task keeps an assignee
+// who is no longer a member.
+type removeOrgUserAggregate struct {
+	memberships []membershipRecord // the user's memberships in the organization's projects
+	tasks       []taskRecord       // the user's assigned tasks in the organization's projects
+}
+
+func loadRemoveOrgUser(x *tx, orgID, userID string) (*removeOrgUserAggregate, error) {
+	u, ok := x.findUser(userID)
+	if !ok || u.Org != orgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	a := &removeOrgUserAggregate{}
+	for _, m := range u.Memberships(x) {
+		if p, ok := m.Project(x); ok && p.Org == orgID {
+			a.memberships = append(a.memberships, m)
+		}
+	}
+	for _, t := range u.AssignedTasks(x) {
+		if p, ok := t.Project(x); ok && p.Org == orgID {
+			a.tasks = append(a.tasks, t)
+		}
+	}
+	return a, nil
+}
+
+func (a *removeOrgUserAggregate) validate() error { return nil }
+
+func (a *removeOrgUserAggregate) apply(x *tx) {
+	for _, t := range a.tasks {
+		t.Unassign(x)
+	}
+	for _, m := range a.memberships {
+		m.Destroy(x)
+	}
+}
