+
+// ---- org capabilities -----------------------------------------------------------
+
+// OrgScope is bound to one actor and one organization ID. It grants nothing by
+// itself; call Manage to acquire the capability.
+type OrgScope interface {
+	Manage() (ManageOrg, error)
+}
+
+// ManageOrg is the org-admin capability for one organization.
+type ManageOrg interface {
+	// RemoveUser takes the user out of every project of the organization and
+	// clears the user's task assignments there. The user record itself is kept.
+	RemoveUser(userID string) error
+}
+
+type orgScope struct {
+	as  *actorScope
+	oid string
+}
+
+func (s *actorScope) Org(orgID string) OrgScope {
+	return &orgScope{as: s, oid: orgID}
+}
+
+// Manage applies the org rule: the organization must be the actor's own (else
+// 404), and the actor must be an org admin (else 403).
+func (s *orgScope) Manage() (ManageOrg, error) {
+	if s.oid != s.as.actor.org {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if !s.as.actor.orgAdmin {
+		return nil, deny(ErrForbidden, "forbidden")
+	}
+	return &manageOrg{scope: s}, nil
+}
+
+type manageOrg struct{ scope *orgScope }
+
+func (m *manageOrg) RemoveUser(userID string) error {
+	return m.scope.as.a.db.update(func(x *tx) error {
+		agg, err := loadRemoveOrgUser(x, m.scope.oid, userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		agg.apply(x)
+		return nil
+	})
+}
