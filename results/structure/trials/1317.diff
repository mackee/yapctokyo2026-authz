+func TestTransfer(t *testing.T) {
+	cases := []struct {
+		name, user, org, uid, body string
+		want                       int
+	}{
+		{"org admin moves member", "eve", "acme", "ben", `{"toOrgId":"globex"}`, 200},
+		{"org member not admin", "ann", "acme", "ben", `{"toOrgId":"globex"}`, 403},
+		{"anonymous", "", "acme", "ben", `{"toOrgId":"globex"}`, 401},
+		{"unknown caller", "zed", "acme", "ben", `{"toOrgId":"globex"}`, 401},
+		{"caller in other org", "gus", "acme", "ben", `{"toOrgId":"globex"}`, 404},
+		{"target in other org", "eve", "acme", "gus", `{"toOrgId":"acme"}`, 404},
+		{"unknown target", "eve", "acme", "zed", `{"toOrgId":"globex"}`, 404},
+		{"unknown target org", "eve", "acme", "ben", `{"toOrgId":"initech"}`, 400},
+		{"same org", "eve", "acme", "ben", `{"toOrgId":"acme"}`, 400},
+		{"missing toOrgId", "eve", "acme", "ben", `{}`, 400},
+		{"empty body", "eve", "acme", "ben", ``, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/orgs/"+c.org+"/users/"+c.uid+"/transfer", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferResponseAndEffects(t *testing.T) {
+	srv := newServer()
+	code, body := do(t, srv, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("transfer got %d: %s", code, body)
+	}
+	var resp map[string]string
+	if err := json.Unmarshal([]byte(body), &resp); err != nil {
+		t.Fatal(err)
+	}
+	if len(resp) != 2 || resp["id"] != "ben" || resp["orgId"] != "globex" {
+		t.Fatalf("unexpected response: %s", body)
+	}
+
+	// ben is now in globex: acme projects are no longer readable.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads acme project after transfer: got %d", code)
+	}
+	// Tasks ben was assigned to in acme projects are unassigned; others are untouched.
+	for path, want := range map[string]string{
+		"/projects/web/tasks/t1":    "",
+		"/projects/legacy/tasks/t5": "",
+		"/projects/web/tasks/t2":    "cat",
+	} {
+		code, body := do(t, srv, "GET", path, "eve", "")
+		if code != 200 {
+			t.Fatalf("%s: got %d", path, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.Assignee != want {
+			t.Fatalf("%s: assignee %q want %q", path, task.Assignee, want)
+		}
+	}
+	// ben is no longer a member of web, so cannot be assigned there.
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "ann", `{"title":"x","assignee":"ben"}`); code != 400 {
+		t.Fatalf("assign transferred user: got %d want 400", code)
+	}
+}
+
+func TestTransferDropsOrgAdmin(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer got %d: %s", code, body)
+	}
+	// eve is now a globex user without admin rights: the acme projects are
+	// in another org, and the globex project needs membership to be read.
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "eve", ""); code != 404 {
+		t.Fatalf("ops: got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/gx/tasks", "eve", ""); code != 404 {
+		t.Fatalf("gx: got %d want 404", code)
+	}
+}
