+// RemoveFromOrg removes the user from every project of the organization (the
+// authorization object's), and unassigns the user's tasks in those projects,
+// all in one transaction. Archived projects are included: this revokes access,
+// and archiving only blocks writes made through the task operations. A user who
+// is in no project of the organization is removed without error.
+func (*MembershipTable) RemoveFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanManageMembers(); err != nil {
+		return err
+	}
+	return db.update(ctx, func(x *Tx) error {
+		agg, err := loadRemoveOrgMember(ctx, x, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, x)
+	})
+}
+
