 func (a *deleteTaskAggregate) apply(ctx context.Context, x *Tx) error { return a.task.destroy(ctx, x) }
+
+// removeOrgMemberAggregate removes one user from every project of one
+// organization. Tasks the user is assigned to in those projects are unassigned,
+// so no task keeps an assignee who is no longer a member.
+type removeOrgMemberAggregate struct {
+	memberships []*Membership // the user's memberships in the organization's projects
+	assigned    []*Task       // tasks in those projects assigned to the user
+}
+
+func loadRemoveOrgMember(ctx context.Context, x *Tx, orgID, userID string) (*removeOrgMemberAggregate, error) {
+	u, err := NewUserTable().Find(ctx, x, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != orgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	all, err := u.Memberships(ctx, x)
+	if err != nil {
+		return nil, err
+	}
+	a := &removeOrgMemberAggregate{}
+	for _, m := range all {
+		p, err := m.Project(ctx, x)
+		if err != nil {
+			return nil, err
+		}
+		if p.Org != orgID {
+			continue
+		}
+		a.memberships = append(a.memberships, m)
+		tasks, err := m.AssignedTasks(ctx, x)
+		if err != nil {
+			return nil, err
+		}
+		a.assigned = append(a.assigned, tasks...)
+	}
+	return a, nil
+}
+
+func (a *removeOrgMemberAggregate) validate() error { return nil }
+
+func (a *removeOrgMemberAggregate) apply(ctx context.Context, x *Tx) error {
+	for _, t := range a.assigned {
+		if err := t.unassign(ctx, x); err != nil {
+			return err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, x); err != nil {
+			return err
+		}
+	}
+	return nil
+}
