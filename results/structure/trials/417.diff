+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin, user in no project", "eve", "/orgs/acme/users/hal", 204},
+		{"org admin, unknown user", "eve", "/orgs/acme/users/zed", 404},
+		{"org admin, user of other org", "eve", "/orgs/acme/users/gus", 404},
+		{"org admin, other org", "eve", "/orgs/globex/users/gus", 404},
+		{"project manager, not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"contributor", "ben", "/orgs/acme/users/cat", 403},
+		{"outsider in org", "hal", "/orgs/acme/users/ben", 403},
+		{"other org member", "gus", "/orgs/acme/users/ben", 404},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown actor", "zed", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	srv := newServer()
+
+	// Before: ben is a contributor of web and legacy, and assigned to t1 (web) and t5 (legacy).
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks/t1", "ann", ""); code != 200 {
+		t.Fatal("setup: web task not readable", code)
+	}
+
+	if code, body := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove ben: got %d %s", code, body)
+	}
+
+	// ben is no longer a member of any acme project, archived one included.
+	for _, p := range []string{"/projects/web/tasks", "/projects/legacy/tasks", "/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		if code, _ := do(t, srv, "GET", p, "ben", ""); code != 404 {
+			t.Fatalf("ben GET %s: got %d want 404", p, code)
+		}
+	}
+
+	// The tasks ben was assigned to are unassigned, not deleted.
+	var t1 Task
+	_, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ann", "")
+	json.Unmarshal([]byte(body), &t1)
+	if t1.ID != "t1" || t1.AssigneeID != "" {
+		t.Fatalf("t1 after removal: %+v", t1)
+	}
+	var t5 Task
+	_, body = do(t, srv, "GET", "/projects/legacy/tasks/t5", "ann", "")
+	json.Unmarshal([]byte(body), &t5)
+	if t5.ID != "t5" || t5.AssigneeID != "" {
+		t.Fatalf("t5 after removal: %+v", t5)
+	}
+
+	// Other members are untouched.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ann", ""); code != 200 {
+		t.Fatal("ann lost access to web", code)
+	}
+	var t2 Task
+	_, body = do(t, srv, "GET", "/projects/web/tasks/t2", "ann", "")
+	json.Unmarshal([]byte(body), &t2)
+	if t2.AssigneeID != "cat" {
+		t.Fatalf("t2 assignee changed: %+v", t2)
+	}
+
+	// Removing again is idempotent.
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatal("second removal", code)
+	}
+}
