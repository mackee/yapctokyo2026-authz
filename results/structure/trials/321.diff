+// moveTaskAggregate moves one task into another project.
+type moveTaskAggregate struct {
+	task     taskRecord
+	project  projectRecord
+	assignee *membershipRecord // nil means unassigned
+}
+
+func loadMoveTask(x *tx, taskID, toProjectID string) (*moveTaskAggregate, error) {
+	t, ok := x.findTask(taskID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	p, ok := x.findProject(toProjectID)
+	if !ok {
+		return nil, deny(ErrInvalid, "task must belong to an existing project")
+	}
+	a := &moveTaskAggregate{task: t, project: p}
+	if t.AssigneeID != "" {
+		m, ok := x.findMembership(p.ID, t.AssigneeID)
+		if !ok {
+			return nil, deny(ErrInvalid, "assignee must be a contributor or manager of the project")
+		}
+		a.assignee = &m
+	}
+	return a, nil
+}
+
+func (a *moveTaskAggregate) validate() error {
+	if a.assignee != nil && !isWriterRole(a.assignee.Role) {
+		return deny(ErrInvalid, "assignee must be a contributor or manager of the project")
+	}
+	return nil
+}
+
+func (a *moveTaskAggregate) save(x *tx) TaskView {
+	a.task.ProjectID = a.project.ID
+	a.task.save(x)
+	return a.task.view()
+}
