 // ManageTask is the manager-only capability for one task.
@@ -422,6 +427,29 @@ func (t *editTask) Apply(p TaskPatch) (TaskView, error) {
 	return v, err
 }
 
+func (t *editTask) MoveTo(dst WriteProject) (TaskView, error) {
+	dw, ok := dst.(*writeProject)
+	if !ok || dw.ps.as.actor.id != t.ts.ps.as.actor.id {
+		return TaskView{}, deny(ErrForbidden, "forbidden")
+	}
+	if dw.ps.pid == t.ts.ps.pid {
+		return TaskView{}, deny(ErrInvalid, "task is already in that project")
+	}
+	var v TaskView
+	err := t.ts.ps.as.a.db.update(func(x *tx) error {
+		agg, err := loadMoveTask(x, t.ts.tid, dw.ps.pid)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		v = agg.save(x)
+		return nil
+	})
+	return v, err
+}
