+type moveRequest struct {
+	ToProjectID string `json:"toProjectId"`
+}
+
+// moveTask needs edit rights on the task in its current project and write
+// rights in the destination project; the capability checks both.
+func moveTask(ctx tanukirpc.Context[*taskRegistry], _ struct{}) (*Task, error) {
+	t, err := ctx.Registry().scope.Edit()
+	if err != nil {
+		return nil, err
+	}
+	var req moveRequest
+	if err := decodeBody(ctx.Request(), &req); err != nil || req.ToProjectID == "" {
+		return nil, errInvalidBody
+	}
+	dst, err := ctx.Registry().actor.Project(req.ToProjectID).Write()
+	if err != nil {
+		return nil, err
+	}
+	v, err := t.MoveTo(dst)
+	if err != nil {
+		return nil, err
+	}
+	return &v, nil
+}
