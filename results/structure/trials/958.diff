index e558654..d01d1ef 100644
--- a/internal/model/aggregate.go
+++ b/internal/model/aggregate.go
@@ -126,6 +126,72 @@ func (a *updateTaskAggregate) apply(ctx context.Context, tx DB) (*Task, error) {
 	return t, nil
 }
 
+// changeRolesAggregate changes the roles of several members of one project.
+type changeRolesAggregate struct {
+	members  []*Membership // the members to change, in user ID order
+	newRoles map[string]string
+	assigned map[string]int // user ID -> number of tasks assigned in the project
+}
+
+func loadChangeRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*changeRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "member must belong to an existing project")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &changeRolesAggregate{newRoles: roles, assigned: map[string]int{}}
+	all, err := p.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	found := map[string]bool{}
+	for _, m := range all {
+		role, ok := roles[m.UserID]
+		if !ok {
+			continue
+		}
+		found[m.UserID] = true
+		if role == m.Role {
+			continue
+		}
+		a.members = append(a.members, m)
+		tasks, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.assigned[m.UserID] = len(tasks)
+	}
+	for uid := range roles {
+		if !found[uid] {
+			return nil, deny(ErrInvalid, "user "+uid+" is not a member of the project")
+		}
+	}
+	return a, nil
+}
+
+func (a *changeRolesAggregate) validate() error {
+	for _, m := range a.members {
+		role := a.newRoles[m.UserID]
+		if !validRoles[role] {
+			return deny(ErrInvalid, "invalid role")
+		}
+		if !isWriterRole(role) && a.assigned[m.UserID] > 0 {
+			return deny(ErrInvalid, "user "+m.UserID+" has assigned tasks and must stay a contributor or manager")
+		}
+	}
+	return nil
+}
+
+func (a *changeRolesAggregate) apply(ctx context.Context, tx DB) error {
+	for _, m := range a.members {
+		if err := m.setRole(ctx, tx, a.newRoles[m.UserID]); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
