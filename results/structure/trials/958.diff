@@ -8,6 +8,42 @@ type MembershipTable struct{}
 // NewMembershipTable returns the memberships table.
 func NewMembershipTable() *MembershipTable { return &MembershipTable{} }
 
+var validRoles = map[string]bool{RoleManager: true, RoleContributor: true, RoleViewer: true}
+
+// ChangeRoles sets the roles of several members of the project (user ID ->
+// role) all or nothing, and returns the project's members afterwards.
+func (mt *MembershipTable) ChangeRoles(ctx context.Context, db DB, authz ProjectAuthz, roles map[string]string) ([]*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if len(roles) == 0 {
+		return nil, deny(ErrInvalid, "roles must not be empty")
+	}
+	for _, role := range roles {
+		if !validRoles[role] {
+			return nil, deny(ErrInvalid, "invalid role")
+		}
+	}
+	var out []*Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadChangeRoles(ctx, tx, authz.ProjectID(), roles)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if err := agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		out, err = mt.ListByProject(ctx, tx, authz.ProjectID())
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
+
 // Find returns the membership of the user in the project, or ErrNoRows.
 func (*MembershipTable) Find(ctx context.Context, db DB, projectID, userID string) (*Membership, error) {
 	var m Membership
