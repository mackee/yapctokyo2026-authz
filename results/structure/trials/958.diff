diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..b1b89f6
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,106 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"testing"
+)
+
+func members(t *testing.T, h http.Handler, pid string) map[string]string {
+	t.Helper()
+	code, body := do(t, h, "PUT", "/projects/"+pid+"/members", "ann", `{"roles":{"ann":"manager"}}`)
+	if code != 200 {
+		t.Fatalf("list members: %d %s", code, body)
+	}
+	var ms []struct{ UserID, Role string }
+	if err := json.Unmarshal([]byte(body), &ms); err != nil {
+		t.Fatal(err)
+	}
+	out := map[string]string{}
+	for _, m := range ms {
+		out[m.UserID] = m.Role
+	}
+	return out
+}
+
+func TestChangeRoles(t *testing.T) {
+	h := newServer()
+	// cat has t2 in web, so she can only move between writer roles; dan has no tasks.
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"cat":"manager","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d %s", code, body)
+	}
+	var ms []map[string]string
+	if err := json.Unmarshal([]byte(body), &ms); err != nil {
+		t.Fatal(err)
+	}
+	got := map[string]string{}
+	for _, m := range ms {
+		got[m["userId"]] = m["role"]
+	}
+	want := map[string]string{"ann": "manager", "ben": "contributor", "cat": "manager", "dan": "contributor", "ivy": "manager"}
+	if len(got) != len(want) {
+		t.Fatalf("got %v", got)
+	}
+	for k, v := range want {
+		if got[k] != v {
+			t.Fatalf("got %v want %v", got, want)
+		}
+	}
+	// demotion works for a member without assigned tasks (dan was promoted above).
+	if code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"viewer"}}`); code != 200 {
+		t.Fatalf("demote: %d %s", code, body)
+	}
+}
+
+func TestChangeRolesAllOrNothing(t *testing.T) {
+	h := newServer()
+	cases := []struct {
+		name, body string
+		want       int
+	}{
+		{"demote member with tasks", `{"roles":{"dan":"contributor","ben":"viewer"}}`, 400},
+		{"non member", `{"roles":{"dan":"contributor","hal":"viewer"}}`, 400},
+		{"invalid role", `{"roles":{"dan":"contributor","cat":"boss"}}`, 400},
+		{"empty", `{"roles":{}}`, 400},
+		{"malformed", `{"roles":`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			if code, body := do(t, h, "PUT", "/projects/web/members", "ann", c.body); code != c.want {
+				t.Fatalf("got %d %s want %d", code, body, c.want)
+			}
+			if m := members(t, h, "web"); m["dan"] != "viewer" || m["ben"] != "contributor" || m["cat"] != "contributor" {
+				t.Fatalf("state changed: %v", m)
+			}
+		})
+	}
+}
+
+func TestChangeRolesAccess(t *testing.T) {
+	body := `{"roles":{"dan":"contributor"}}`
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager", "ivy", "/projects/web/members", 200},
+		{"contributor", "ben", "/projects/web/members", 403},
+		{"viewer", "dan", "/projects/web/members", 403},
+		{"org admin", "eve", "/projects/web/members", 403},
+		{"non member", "hal", "/projects/web/members", 404},
+		{"other org", "gus", "/projects/web/members", 404},
+		{"anonymous", "", "/projects/web/members", 401},
+		{"archived", "ann", "/projects/legacy/members", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			b := body
+			if c.path == "/projects/legacy/members" {
+				b = `{"roles":{"ben":"manager"}}`
+			}
+			if code, out := do(t, newServer(), "PUT", c.path, c.user, b); code != c.want {
+				t.Fatalf("got %d %s want %d", code, out, c.want)
+			}
+		})
+	}
+}
