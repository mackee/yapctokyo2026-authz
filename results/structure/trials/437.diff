+// MembershipTableMoveInput is the input of MembershipTable.Move.
+type MembershipTableMoveInput struct {
+	ToProjectID string
+}
+
+// Move moves the user from the authorized project to another project, keeping
+// the role. The actor must manage both projects. The user's tasks in the
+// source project are unassigned, so every assignee stays a member of its
+// project. All or nothing.
+func (*MembershipTable) Move(ctx context.Context, db DB, authz ProjectAuthz, userID string, in MembershipTableMoveInput) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if in.ToProjectID == authz.ProjectID() {
+		return nil, deny(ErrInvalid, "destination must be a different project")
+	}
+	dest, err := NewProjectAuthz(ctx, db, authz.Actor(), in.ToProjectID)
+	if err != nil {
+		return nil, err
+	}
+	if err := dest.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var out *Membership
+	if err := db.update(ctx, func(x *Tx) error {
+		agg, err := loadMoveMember(ctx, x, authz.ProjectID(), userID, in.ToProjectID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if out, err = agg.apply(ctx, x); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
