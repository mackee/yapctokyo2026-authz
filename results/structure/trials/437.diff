+// moveMemberAggregate moves one member from the source project to the
+// destination project, keeping the role.
+type moveMemberAggregate struct {
+	from  *Membership // the member in the source project
+	to    *Membership // the member in the destination project, to be saved
+	tasks []*Task     // the member's tasks in the source project
+}
+
+func loadMoveMember(ctx context.Context, x *Tx, fromProjectID, userID, toProjectID string) (*moveMemberAggregate, error) {
+	from, err := NewMembershipTable().Find(ctx, x, fromProjectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "user is not a member of the project")
+	} else if err != nil {
+		return nil, err
+	}
+	_, err = NewMembershipTable().Find(ctx, x, toProjectID, userID)
+	if err == nil {
+		return nil, deny(ErrConflict, "user is already a member of the destination project")
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	tasks, err := from.AssignedTasks(ctx, x)
+	if err != nil {
+		return nil, err
+	}
+	return &moveMemberAggregate{
+		from:  from,
+		to:    &Membership{ProjectID: toProjectID, UserID: userID, Role: from.Role},
+		tasks: tasks,
+	}, nil
+}
+
+func (a *moveMemberAggregate) validate() error { return nil }
+
+// apply unassigns the member's tasks in the source project (an assignee must
+// be a member of the task's project), then moves the membership.
+func (a *moveMemberAggregate) apply(ctx context.Context, x *Tx) (*Membership, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, x); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.from.destroy(ctx, x); err != nil {
+		return nil, err
+	}
+	if err := a.to.save(ctx, x); err != nil {
+		return nil, err
+	}
+	return a.to, nil
+}
+
