+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, project, uid, body string
+		want                           int
+	}{
+		{"manager moves member", "ivy", "web", "ben", `{"toProjectId":"ops"}`, 200},
+		{"manager moves viewer", "ivy", "web", "dan", `{"toProjectId":"ops"}`, 200},
+		{"contributor", "ben", "web", "cat", `{"toProjectId":"ops"}`, 403},
+		{"viewer", "dan", "web", "ben", `{"toProjectId":"ops"}`, 403},
+		{"manager of source only", "ann", "web", "ben", `{"toProjectId":"ops"}`, 403},
+		{"org admin", "eve", "web", "ben", `{"toProjectId":"ops"}`, 403},
+		{"non member", "hal", "web", "ben", `{"toProjectId":"ops"}`, 404},
+		{"other org", "gus", "web", "ben", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "web", "ben", `{"toProjectId":"ops"}`, 401},
+		{"user not member of source", "ivy", "web", "hal", `{"toProjectId":"ops"}`, 404},
+		{"user already in destination", "ivy", "web", "cat", `{"toProjectId":"ops"}`, 409},
+		{"same project", "ivy", "web", "ben", `{"toProjectId":"web"}`, 400},
+		{"destination missing", "ivy", "web", "ben", `{"toProjectId":"nope"}`, 404},
+		{"destination in other org", "ivy", "web", "ben", `{"toProjectId":"gx"}`, 404},
+		{"destination not readable", "ivy", "web", "ben", `{"toProjectId":"legacy"}`, 404},
+		{"destination archived", "ann", "web", "ben", `{"toProjectId":"legacy"}`, 409},
+		{"source archived", "ann", "legacy", "ben", `{"toProjectId":"web"}`, 409},
+		{"missing toProjectId", "ivy", "web", "ben", `{}`, 400},
+		{"bad body", "ivy", "web", "ben", `{"toProjectId":`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/members/"+c.uid+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveResponseAndEffects(t *testing.T) {
+	h := newServer()
+
+	// The response names the user, the destination and the kept role.
+	code, body := do(t, h, "POST", "/projects/web/members/dan/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move dan: got %d: %s", code, body)
+	}
+	var got moveMemberResponse
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if want := (moveMemberResponse{UserID: "dan", ProjectID: "ops", Role: "viewer"}); got != want {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+
+	// ben moves next: his task in web is unassigned, other tasks are untouched.
+	code, body = do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move ben: got %d: %s", code, body)
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if want := (moveMemberResponse{UserID: "ben", ProjectID: "ops", Role: "contributor"}); got != want {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+
+	assignee := func(path string) string {
+		t.Helper()
+		code, body := do(t, h, "GET", path, "ivy", "")
+		if code != 200 {
+			t.Fatalf("GET %s: got %d", path, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		return task.AssigneeID
+	}
+	if a := assignee("/projects/web/tasks/t1"); a != "" {
+		t.Fatalf("t1 still assigned to %q", a)
+	}
+	if a := assignee("/projects/web/tasks/t2"); a != "cat" {
+		t.Fatalf("t2 assignee = %q, want cat", a)
+	}
+
+	// ben is now a member of ops only.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads web after move: got %d want 404", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben reads ops after move: got %d want 200", code)
+	}
+}
+
+func TestMoveFailureChangesNothing(t *testing.T) {
+	h := newServer()
+
+	// cat is already in ops, so the move is refused and cat stays in web.
+	if code, _ := do(t, h, "POST", "/projects/web/members/cat/move", "ivy", `{"toProjectId":"ops"}`); code != 409 {
+		t.Fatalf("got %d want 409", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat reads web after failed move: got %d want 200", code)
+	}
+	if code, body := do(t, h, "GET", "/projects/web/tasks/t2", "ivy", ""); code != 200 || !strings.Contains(body, `"assignee":"cat"`) {
+		t.Fatalf("t2 changed after failed move: %d %s", code, body)
+	}
+}
