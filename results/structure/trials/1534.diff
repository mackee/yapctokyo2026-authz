@@ -0,0 +1,91 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestUpdateMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager promotes", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"manager demotes contributor", "ann", "/projects/web/members/cat", `{"role":"viewer"}`, 200},
+		{"manager demotes manager", "ann", "/projects/web/members/ivy", `{"role":"viewer"}`, 200},
+		{"contributor", "ben", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"viewer", "dan", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"org admin", "eve", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"non member", "hal", "/projects/web/members/dan", `{"role":"contributor"}`, 404},
+		{"other org", "gus", "/projects/web/members/dan", `{"role":"contributor"}`, 404},
+		{"anonymous", "", "/projects/web/members/dan", `{"role":"contributor"}`, 401},
+		{"unknown project", "ann", "/projects/nope/members/dan", `{"role":"contributor"}`, 404},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"contributor"}`, 404},
+		{"target in other org", "ann", "/projects/web/members/gus", `{"role":"contributor"}`, 404},
+		{"invalid role", "ann", "/projects/web/members/dan", `{"role":"owner"}`, 400},
+		{"missing role", "ann", "/projects/web/members/dan", `{}`, 400},
+		{"bad body", "ann", "/projects/web/members/dan", `nope`, 400},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"last manager", "ann", "/projects/legacy/members/ann", `{"role":"contributor"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRoleResponseAndEffect(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 2 || got["userId"] != "dan" || got["role"] != "contributor" {
+		t.Fatalf("unexpected body %s", body)
+	}
+	// dan can now write.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x","assignee":"dan"}`); code != 200 {
+		t.Fatalf("promoted member could not create a task: %d", code)
+	}
+}
+
+func TestDemoteToViewerUnassignsTasks(t *testing.T) {
+	h := newServer()
+	// ben is assigned t1 in web.
+	if code, body := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatal(code, body)
+	}
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" {
+		t.Fatalf("t1 still assigned to %q", task.Assignee)
+	}
+	// Other projects are untouched: ben keeps t5 in legacy.
+	_, body = do(t, h, "GET", "/projects/legacy/tasks/t5", "ann", "")
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "ben" {
+		t.Fatalf("t5 assignee = %q, want ben", task.Assignee)
+	}
+}
+
+func TestDemotedManagerLosesWrite(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ivy", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatal(code)
+	}
+	if code, _ := do(t, h, "DELETE", "/projects/web/tasks/t3", "ivy", ""); code != 403 {
+		t.Fatalf("got %d want 403", code)
+	}
+}
