+func TestSetMemberRoles(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager", "ann", "web", `{"roles":{"dan":"contributor","ivy":"contributor"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"invalid role", "ann", "web", `{"roles":{"dan":"boss"}}`, 400},
+		{"non member target", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"empty", "ann", "web", `{"roles":{}}`, 400},
+		{"malformed", "ann", "web", `nope`, 400},
+		{"demote assignee", "ann", "web", `{"roles":{"ben":"viewer"}}`, 400},
+		{"demote last manager", "ivy", "ops", `{"roles":{"ivy":"viewer"}}`, 400},
+		{"no manager left", "ann", "web", `{"roles":{"ann":"viewer","ivy":"viewer"}}`, 400},
+		{"self demote with other manager", "ann", "web", `{"roles":{"ann":"viewer"}}`, 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMemberRolesResult(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","cat":"viewer2"}}`)
+	if code != 400 {
+		t.Fatalf("got %d want 400: %s", code, body)
+	}
+	// A rejected request changes nothing: dan is still a viewer.
+	code, _ = do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`)
+	if code != 403 {
+		t.Fatalf("rejected request changed dan: got %d", code)
+	}
+
+	code, body = do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","ivy":"viewer"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var members []struct{ UserID, Role string }
+	if err := json.Unmarshal([]byte(body), &members); err != nil {
+		t.Fatal(err)
+	}
+	got := map[string]string{}
+	for _, m := range members {
+		got[m.UserID] = m.Role
+	}
+	want := map[string]string{"ann": "manager", "ben": "contributor", "cat": "contributor", "dan": "contributor", "ivy": "viewer"}
+	if len(got) != len(want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	for k, v := range want {
+		if got[k] != v {
+			t.Fatalf("got %v want %v", got, want)
+		}
+	}
+	if !strings.Contains(body, `"userId":"ann"`) {
+		t.Fatalf("unexpected JSON shape: %s", body)
+	}
+	// The change took effect: dan can now create tasks.
+	code, _ = do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`)
+	if code != 201 {
+		t.Fatalf("dan should be able to write now: got %d", code)
+	}
+}
