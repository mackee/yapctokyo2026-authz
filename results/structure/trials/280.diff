 // ---- project capabilities ----------------------------------------------------
 
+// MemberMove is the result of moving a member to another project.
+type MemberMove struct {
+	UserID    string `json:"userId"`
+	ProjectID string `json:"projectId"`
+	Role      string `json:"role"`
+}
+
+// ManageProject is the manager-only capability for one project's membership.
+type ManageProject interface {
+	// MoveMember removes the user from this project and adds them, with the same
+	// role, to toProjectID. The actor must also be a manager of the destination
+	// (else 403; unreadable destination is 404), and the destination must be in
+	// the same organization (400), not archived (409), different from this
+	// project (400) and not already contain the user (409). Tasks in this project
+	// assigned to the user become unassigned. The move is atomic.
+	MoveMember(userID, toProjectID string) (MemberMove, error)
+}
+
+type manageProject struct{ ps *projectScope }
+
+func (p *manageProject) MoveMember(userID, toProjectID string) (MemberMove, error) {
+	from := p.ps.pid
+	if toProjectID == "" || toProjectID == from {
+		return MemberMove{}, deny(ErrInvalid, "invalid destination project")
+	}
+	var mv MemberMove
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		// Re-check the source under the transaction lock.
+		fp, fr, err := readable(s, p.ps.as.actor, from)
+		if err != nil {
+			return err
+		}
+		if fr != RoleManager {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if fp.archived {
+			return deny(ErrArchived, "project is archived")
+		}
+		role := s.role(from, userID)
+		if role == "" {
+			return deny(ErrNotFound, "not found")
+		}
+		tp, tr, err := readable(s, p.ps.as.actor, toProjectID)
+		if err != nil {
+			return err
+		}
+		if tr != RoleManager {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if tp.archived {
+			return deny(ErrArchived, "destination project is archived")
+		}
+		if s.role(toProjectID, userID) != "" {
+			return deny(ErrConflict, "user is already a member of the destination project")
+		}
+		delete(s.members[from], userID)
+		if s.members[toProjectID] == nil {
+			s.members[toProjectID] = map[string]string{}
+		}
+		s.members[toProjectID][userID] = role
+		for id, t := range s.tasks {
+			if t.project == from && t.assignee.user == userID {
+				t.assignee = Assignee{project: from}
+				s.tasks[id] = t
+			}
+		}
+		mv = MemberMove{UserID: userID, ProjectID: toProjectID, Role: role}
+		return nil
+	})
+	return mv, err
+}
