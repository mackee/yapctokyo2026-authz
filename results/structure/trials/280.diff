+func moveMember(ctx tanukirpc.Context[*projectRegistry], _ struct{}) (*capability.MemberMove, error) {
+	p, err := ctx.Registry().scope.Manage()
+	if err != nil {
+		return nil, err
+	}
+	var req moveRequest
+	if err := decodeBody(ctx.Request(), &req); err != nil || req.ToProjectID == "" {
+		return nil, errInvalidBody
+	}
+	mv, err := p.MoveMember(chi.URLParam(ctx.Request(), "uid"), req.ToProjectID)
+	if err != nil {
+		return nil, err
+	}
+	return &mv, nil
