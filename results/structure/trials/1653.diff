+// CanManage returns nil if the actor may manage the project's members (change
+// their roles): managers only (else ErrForbidden) and not archived (else
+// ErrArchived).
+func (a ProjectAuthz) CanManage() error {
+	if !a.CanRead() || a.role != RoleManager {
+		return deny(ErrForbidden, "forbidden")
+	}
+	if a.archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	return nil
