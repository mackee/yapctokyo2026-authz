+var validRoles = map[string]bool{RoleManager: true, RoleContributor: true, RoleViewer: true}
+
+// SetRole changes the role of a member of the project and returns the
+// membership. Only managers may do this (CanManage). A user who is not a member
+// of the project is ErrNotFound.
+func (*MembershipTable) SetRole(ctx context.Context, db DB, authz ProjectAuthz, userID, role string) (*Membership, error) {
+	if err := authz.CanManage(); err != nil {
+		return nil, err
+	}
+	if !validRoles[role] {
+		return nil, deny(ErrInvalid, "role must be manager, contributor or viewer")
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadSetMemberRole(ctx, tx, authz.ProjectID(), userID, role)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if m, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
