+// changeRoleAggregate changes one member's role in one project.
+type changeRoleAggregate struct {
+	member   *Membership
+	role     string
+	assigned []*Task // the member's tasks in the project; checked when the new role is not a writer's
+}
+
+func loadChangeRole(ctx context.Context, tx DB, projectID string, in MembershipTableUpdateRoleInput) (*changeRoleAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	m, err := p.Membership(ctx, tx, in.UserID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &changeRoleAggregate{member: m, role: in.Role}
+	if !isWriterRole(in.Role) {
+		a.assigned, err = m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+	}
+	return a, nil
+}
+
+func (a *changeRoleAggregate) validate() error {
+	if !isWriterRole(a.role) && len(a.assigned) > 0 {
+		return deny(ErrInvalid, "member has assigned tasks; reassign them before making the member a viewer")
+	}
+	return nil
+}
+
+func (a *changeRoleAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.member.setRole(ctx, tx, a.role); err != nil {
+		return nil, err
+	}
+	return a.member, nil
+}
