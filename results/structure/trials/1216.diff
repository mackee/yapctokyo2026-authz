+func TestChangeRole(t *testing.T) {
+	cases := []struct {
+		name, user, project, uid, body string
+		want                           int
+	}{
+		{"manager promotes viewer", "ann", "web", "dan", `{"role":"contributor"}`, 200},
+		{"manager demotes manager without tasks", "ann", "web", "ivy", `{"role":"viewer"}`, 200},
+		{"manager demotes contributor with assigned task", "ann", "web", "cat", `{"role":"viewer"}`, 400},
+		{"manager changes non-member", "ann", "web", "hal", `{"role":"viewer"}`, 404},
+		{"manager changes unknown user", "ann", "web", "zed", `{"role":"viewer"}`, 404},
+		{"contributor", "ben", "web", "dan", `{"role":"manager"}`, 403},
+		{"viewer", "dan", "web", "ben", `{"role":"viewer"}`, 403},
+		{"org admin", "eve", "web", "dan", `{"role":"contributor"}`, 403},
+		{"non member", "hal", "web", "dan", `{"role":"contributor"}`, 404},
+		{"other org", "gus", "web", "dan", `{"role":"contributor"}`, 404},
+		{"unknown project", "ann", "nope", "dan", `{"role":"contributor"}`, 404},
+		{"archived", "ann", "legacy", "ben", `{"role":"viewer"}`, 409},
+		{"anonymous", "", "web", "dan", `{"role":"contributor"}`, 401},
+		{"unknown user", "zed", "web", "dan", `{"role":"contributor"}`, 401},
+		{"bad role", "ann", "web", "dan", `{"role":"admin"}`, 400},
+		{"missing role", "ann", "web", "dan", `{}`, 400},
+		{"malformed body", "ann", "web", "dan", `{"role":`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members/"+c.uid, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestChangeRoleResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["userId"] != "dan" || got["role"] != "contributor" {
+		t.Fatalf("got %v", got)
+	}
+}
+
+func TestChangeRoleTakesEffect(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`); code != 200 {
+		t.Fatalf("promote: got %d", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("promoted dan create: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ivy", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote: got %d", code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t2", "ivy", `{"status":"done"}`); code != 403 {
+		t.Fatalf("demoted ivy patch: got %d want 403", code)
+	}
+}
+
+func TestChangeRoleRejectedLeavesRoleUnchanged(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "PUT", "/projects/web/members/cat", "ann", `{"role":"viewer"}`); code != 400 {
+		t.Fatalf("demote with assigned task: got %d want 400", code)
+	}
+	// cat is still a contributor, so may create a task assigned to herself.
+	if code, body := do(t, h, "POST", "/projects/web/tasks", "cat", `{"title":"x","assignee":"cat"}`); code != 200 {
+		t.Fatalf("cat create: got %d want 200: %s", code, body)
+	}
+}
