+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin, user already gone", "eve", "/orgs/acme/users/hal", 204},
+		{"manager, not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"contributor, not org admin", "ben", "/orgs/acme/users/cat", 403},
+		{"non admin, unknown target", "ann", "/orgs/acme/users/zed", 403},
+		{"other org admin", "gus", "/orgs/acme/users/ben", 404},
+		{"unknown org", "eve", "/orgs/nowhere/users/ben", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown actor", "zed", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserOffboards(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("got %d want 204: %s", code, body)
+	}
+
+	// ben is out of every acme project, archived ones included.
+	for _, path := range []string{"/projects/web/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, h, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("GET %s as ben: got %d want 404", path, code)
+		}
+	}
+	// ben can no longer be assigned work.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ann", `{"title":"x","assignee":"ben"}`); code != 400 {
+		t.Fatalf("assign removed user: got %d want 400", code)
+	}
+
+	// Tasks assigned to ben are unassigned; other assignments stay.
+	assignees := map[string]string{}
+	for _, path := range []string{"/projects/web/tasks", "/projects/legacy/tasks"} {
+		code, body := do(t, h, "GET", path, "ann", "")
+		if code != 200 {
+			t.Fatalf("GET %s as ann: got %d", path, code)
+		}
+		var tasks []Task
+		if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+			t.Fatal(err)
+		}
+		for _, task := range tasks {
+			assignees[task.ID] = task.AssigneeID
+		}
+	}
+	want := map[string]string{"t1": "", "t2": "cat", "t3": "", "t5": ""}
+	for id, assignee := range want {
+		if assignees[id] != assignee {
+			t.Fatalf("task %s assignee %q, want %q", id, assignees[id], assignee)
+		}
+	}
+
+	// Removing again is a no-op with the same answer.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("second removal: got %d want 204", code)
+	}
+
+	// Other organizations are untouched.
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatalf("globex after acme offboarding: got %d want 200", code)
+	}
+}
