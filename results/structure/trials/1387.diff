+// removeOrgUserAggregate removes one user from every project of an organization.
+type removeOrgUserAggregate struct {
+	user        *User
+	memberships []*Membership // the user's memberships in the organization's projects
+	tasks       []*Task       // the tasks of those projects assigned to the user
+}
+
+func loadRemoveOrgUser(ctx context.Context, tx DB, orgID, userID string) (*removeOrgUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != orgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	ms, err := u.MembershipsInOrg(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	ts, err := u.AssignedTasksInOrg(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &removeOrgUserAggregate{user: u, memberships: ms, tasks: ts}, nil
+}
+
+// validate has nothing to check: the change unassigns every task the user
+// holds in the organization, so no assignee is left without its membership.
+func (a *removeOrgUserAggregate) validate() error { return nil }
+
+// apply unassigns the tasks first, then removes the memberships.
+func (a *removeOrgUserAggregate) apply(ctx context.Context, tx DB) error {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return err
+		}
+	}
+	return nil
+}
