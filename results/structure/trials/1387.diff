+// RemoveFromOrg removes the user from every project of the organization
+// (offboarding, DELETE /orgs/{oid}/users/{uid}). The authorization object
+// decides who may do it (org admins of the organization); the aggregate
+// removes the memberships and unassigns the user's tasks in those projects.
+// Archived projects do not block it.
+func (*UserTable) RemoveFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanManageUsers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveOrgUser(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
