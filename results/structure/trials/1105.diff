+// removeUserAggregate removes one user from every project of an organization.
+// Tasks assigned to the user are unassigned, so the rule "an assignee is a
+// contributor or manager of the task's project" keeps holding.
+type removeUserAggregate struct {
+	memberships []*Membership
+	tasks       []*Task
+}
+
+func loadRemoveUser(ctx context.Context, tx DB, orgID, userID string) (*removeUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != orgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	all, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	a := &removeUserAggregate{}
+	for _, m := range all {
+		p, err := m.Project(ctx, tx)
+		if errors.Is(err, ErrNoRows) {
+			continue
+		} else if err != nil {
+			return nil, err
+		}
+		if p.Org != orgID {
+			continue
+		}
+		ts, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.memberships = append(a.memberships, m)
+		a.tasks = append(a.tasks, ts...)
+	}
+	return a, nil
+}
+
+func (a *removeUserAggregate) validate() error { return nil }
+
+func (a *removeUserAggregate) apply(ctx context.Context, tx DB) error {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
