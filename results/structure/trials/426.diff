+package model
+
+import "context"
+
+// OrgTable reads the orgs table.
+type OrgTable struct{}
+
+// NewOrgTable returns the orgs table.
+func NewOrgTable() *OrgTable { return &OrgTable{} }
+
+// Find returns the organization with the ID, or ErrNoRows.
+func (*OrgTable) Find(ctx context.Context, db DB, id string) (*Org, error) {
+	var o Org
+	if err := db.view(ctx, func(x *Tx) error {
+		r, ok := x.t.orgs[id]
+		if !ok {
+			return ErrNoRows
+		}
+		o = r
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return &o, nil
+}
