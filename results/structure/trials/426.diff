+// transferUserAggregate moves one user to another organization. Every
+// membership of the user is in a project of the old organization, so the
+// memberships are removed, and the tasks assigned to the user are unassigned
+// (an assignee must be a member of the task's project).
+type transferUserAggregate struct {
+	user        *User
+	toOrg       *Org
+	memberships []*Membership
+	tasks       []*Task
+}
+
+func loadTransferUser(ctx context.Context, x *Tx, fromOrgID, userID, toOrgID string) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, x, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != fromOrgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	o, err := NewOrgTable().Find(ctx, x, toOrgID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "target organization does not exist")
+	} else if err != nil {
+		return nil, err
+	}
+	ms, err := u.Memberships(ctx, x)
+	if err != nil {
+		return nil, err
+	}
+	ts, err := u.AssignedTasks(ctx, x)
+	if err != nil {
+		return nil, err
+	}
+	return &transferUserAggregate{user: u, toOrg: o, memberships: ms, tasks: ts}, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if a.user.Org == a.toOrg.ID {
+		return deny(ErrInvalid, "user is already in that organization")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, x *Tx) (*User, error) {
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, x); err != nil {
+			return nil, err
+		}
+	}
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, x); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.user.moveTo(ctx, x, a.toOrg.ID); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
+
