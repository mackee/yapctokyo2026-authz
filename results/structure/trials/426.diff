+// ---- operations -----------------------------------------------------------------------
+
+// Transfer moves a user of the authorized organization to another organization
+// (for example a sister company), all or nothing. The user's memberships are
+// removed and the tasks assigned to them are unassigned, since their projects
+// stay behind in the old organization. It returns the user as moved.
+func (*UserTable) Transfer(ctx context.Context, db DB, authz OrgAuthz, userID, toOrgID string) (*User, error) {
+	if err := authz.CanManageUsers(); err != nil {
+		return nil, err
+	}
+	var u *User
+	if err := db.update(ctx, func(x *Tx) error {
+		agg, err := loadTransferUser(ctx, x, authz.OrgID(), userID, toOrgID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if u, err = agg.apply(ctx, x); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return u, nil
+}
