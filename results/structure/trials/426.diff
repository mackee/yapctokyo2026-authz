+func TestTransferUser(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ivy/transfer", `{"toOrgId":"globex"}`, 200},
+		{"member not admin", "ann", "/orgs/acme/users/cat/transfer", `{"toOrgId":"globex"}`, 403},
+		{"anonymous", "", "/orgs/acme/users/cat/transfer", `{"toOrgId":"globex"}`, 401},
+		{"other org", "gus", "/orgs/acme/users/cat/transfer", `{"toOrgId":"globex"}`, 404},
+		{"user in other org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"unknown target org", "eve", "/orgs/acme/users/cat/transfer", `{"toOrgId":"initech"}`, 400},
+		{"same org", "eve", "/orgs/acme/users/cat/transfer", `{"toOrgId":"acme"}`, 400},
+		{"missing target org", "eve", "/orgs/acme/users/cat/transfer", `{}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferUserResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/ivy/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["id"] != "ivy" || got["orgId"] != "globex" || len(got) != 2 {
+		t.Fatalf("body %s", body)
+	}
+}
+
+// A transferred user leaves the old organization's projects, and the tasks
+// assigned to them there are unassigned.
+func TestTransferUserReleasesProjects(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/orgs/acme/users/cat/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: got %d %s", code, body)
+	}
+	for _, path := range []string{"/projects/web/tasks", "/projects/ops/tasks"} {
+		if code, _ := do(t, srv, "GET", path, "cat", ""); code != 404 {
+			t.Fatalf("GET %s as cat: got %d want 404", path, code)
+		}
+	}
+	for _, path := range []string{"/projects/web/tasks/t2", "/projects/ops/tasks/t4"} {
+		code, body := do(t, srv, "GET", path, "ann", "")
+		if code != 200 {
+			t.Fatalf("GET %s: got %d", path, code)
+		}
+		if !strings.Contains(body, `"assignee":""`) {
+			t.Fatalf("GET %s: task still assigned: %s", path, body)
+		}
+	}
+}
+
+// Org-admin rights do not follow the user into the new organization.
