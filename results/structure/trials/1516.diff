+// UserTableTransferInput is the input of UserTable.Transfer.
+type UserTableTransferInput struct {
+	ToOrgID string
+}
+
+// Transfer moves the user from the authorization's organization to another
+// one, all or nothing. The user leaves the projects of the old organization
+// (their memberships there are removed, and their tasks there are
+// unassigned), and loses org admin, since that role is per organization.
+func (*UserTable) Transfer(ctx context.Context, db DB, authz OrgAuthz, userID string, in UserTableTransferInput) (*User, error) {
+	if err := authz.CanTransferUsers(); err != nil {
+		return nil, err
+	}
+	if in.ToOrgID == "" {
+		return nil, deny(ErrInvalid, "toOrgId must not be empty")
+	}
+	var u *User
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadTransferUser(ctx, tx, authz.OrgID(), userID, in)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if u, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return u, nil
+}
+
+// OrgTable reads organizations. An organization has no table of its own: it
+// exists when some user or project belongs to it.
+type OrgTable struct{}
+
+// NewOrgTable returns the organizations.
+func NewOrgTable() *OrgTable { return &OrgTable{} }
+
+// Exists reports whether some user or project belongs to the organization.
+func (*OrgTable) Exists(ctx context.Context, db DB, id string) (bool, error) {
+	var n int
+	if err := db.QueryRowContext(ctx,
+		`SELECT EXISTS (SELECT 1 FROM users WHERE org_id = ?) OR EXISTS (SELECT 1 FROM projects WHERE org_id = ?)`,
+		id, id).Scan(&n); err != nil {
+		return false, err
+	}
+	return n != 0, nil
+}
