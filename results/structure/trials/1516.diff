+// transferUserAggregate moves one user to another organization. Every
+// membership and every task assignment the user has in a project outside the
+// target organization is removed, so the rules still hold.
+type transferUserAggregate struct {
+	user     *User
+	toOrg    string
+	leave    []*Membership // memberships in projects outside toOrg
+	unassign []*Task       // tasks assigned to the user in projects outside toOrg
+}
+
+func loadTransferUser(ctx context.Context, tx DB, fromOrg, userID string, in UserTableTransferInput) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) || (err == nil && u.Org != fromOrg) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &transferUserAggregate{user: u, toOrg: in.ToOrgID}
+
+	ok, err := NewOrgTable().Exists(ctx, tx, in.ToOrgID)
+	if err != nil {
+		return nil, err
+	}
+	if !ok {
+		return nil, deny(ErrInvalid, "target organization does not exist")
+	}
+
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, m := range ms {
+		p, err := m.Project(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		if p.Org != in.ToOrgID {
+			a.leave = append(a.leave, m)
+		}
+	}
+
+	ts, err := u.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, t := range ts {
+		p, err := t.Project(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		if p.Org != in.ToOrgID {
+			a.unassign = append(a.unassign, t)
+		}
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if a.user.Org == a.toOrg {
+		return deny(ErrInvalid, "user is already in that organization")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	for _, m := range a.leave {
+		if err := m.leave(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	for _, t := range a.unassign {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	u := a.user
+	u.Org = a.toOrg
+	u.OrgAdmin = false
+	if err := u.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return u, nil
+}
+
