+// Member is one entry of a project's membership list.
+type Member struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// Members returns the project's members sorted by user ID.
+func (s *Store) Members(projectID string) []Member {
+	out := []Member{}
+	for uid, role := range s.members[projectID] {
+		out = append(out, Member{UserID: uid, Role: role})
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].UserID < out[j].UserID })
+	return out
+}
+
+// FreezeProject demotes every member of the project (managers included) to viewer.
+// Since task writes require contributor or manager, this makes the project read-only.
+func (s *Store) FreezeProject(projectID string) {
+	for uid := range s.members[projectID] {
+		s.members[projectID][uid] = RoleViewer
+	}
+}
