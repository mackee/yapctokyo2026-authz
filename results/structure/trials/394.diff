+// setRolesAggregate changes the roles of several members of one project.
+type setRolesAggregate struct {
+	members []membershipRecord // one per requested user, sorted by user ID
+	roles   []string           // roles[i] is the new role for members[i]
+	project string
+}
+
+func loadSetRoles(x *tx, projectID string, roles map[string]string) (*setRolesAggregate, error) {
+	if _, ok := x.findProject(projectID); !ok {
+		return nil, deny(ErrInvalid, "members must belong to an existing project")
+	}
+	userIDs := make([]string, 0, len(roles))
+	for uid := range roles {
+		userIDs = append(userIDs, uid)
+	}
+	sort.Strings(userIDs)
+	a := &setRolesAggregate{project: projectID}
+	for _, uid := range userIDs {
+		m, ok := x.findMembership(projectID, uid)
+		if !ok {
+			return nil, deny(ErrInvalid, "user "+uid+" is not a member of the project")
+		}
+		a.members = append(a.members, m)
+		a.roles = append(a.roles, roles[uid])
+	}
+	return a, nil
+}
+
+func (a *setRolesAggregate) validate() error {
+	for i, m := range a.members {
+		if !isValidRole(a.roles[i]) {
+			return deny(ErrInvalid, "invalid role for "+m.UserID+": must be manager, contributor or viewer")
+		}
+	}
+	return nil
+}
+
+func (a *setRolesAggregate) apply(x *tx) []MemberView {
+	for i := range a.members {
+		m := a.members[i]
+		m.SetRole(x, a.roles[i])
+	}
+	out := []MemberView{}
+	for _, m := range x.membershipsOf(a.project) {
+		out = append(out, MemberView{UserID: m.UserID, Role: m.Role})
+	}
+	return out
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task taskRecord
