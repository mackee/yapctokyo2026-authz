+		{UserID: "ben", Role: "viewer"},
+		{UserID: "cat", Role: "contributor"},
+		{UserID: "dan", Role: "contributor"},
+		{UserID: "ivy", Role: "manager"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("entry %d: got %+v want %+v", i, got[i], want[i])
+		}
+	}
+}
+
+func TestSetMembersIsAllOrNothing(t *testing.T) {
+	h := newServer()
+
+	// One entry is a non-member, one is valid: nothing may change.
+	code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","hal":"viewer"}}`)
+	if code != 400 {
+		t.Fatalf("non-member entry: got %d want 400", code)
+	}
+	// One entry has an invalid role, one is valid: nothing may change.
+	code, _ = do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"owner"}}`)
+	if code != 400 {
+		t.Fatalf("invalid role entry: got %d want 400", code)
+	}
+
+	// A later successful call returns the full list: ben and dan must be unchanged.
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"cat":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []capability.MemberView
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	for _, m := range got {
+		if m.UserID == "ben" && m.Role != "contributor" {
+			t.Fatalf("rejected batch leaked: ben is %s", m.Role)
+		}
+		if m.UserID == "dan" && m.Role != "viewer" {
+			t.Fatalf("rejected batch leaked: dan is %s", m.Role)
+		}
+	}
+}
+
+func TestSetMembersTakesEffect(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer"}}`); code != 200 {
+		t.Fatalf("demote: got %d: %s", code, body)
+	}
+	// ben is now a viewer and can no longer create tasks.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Fatalf("demoted ben create: got %d want 403", code)
+	}
+}
