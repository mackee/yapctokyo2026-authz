+// MemberView is the public representation of a project member.
+type MemberView struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// ManageProject may change member roles in one project.
+type ManageProject interface {
+	ReadProject
+	// SetRoles changes the roles of several members at once. It validates the
+	// whole map first and applies it atomically: if any entry is rejected,
+	// nothing changes. It returns the members after the change.
+	SetRoles(roles map[string]string) ([]MemberView, error)
+}
+
+type manageProject struct {
+	readProject
+}
+
+func (p *manageProject) SetRoles(roles map[string]string) ([]MemberView, error) {
+	if len(roles) == 0 {
+		return nil, deny(ErrInvalid, "roles must not be empty")
+	}
+	var out []MemberView
+	err := p.ps.as.a.db.update(func(x *tx) error {
+		agg, err := loadSetRoles(x, p.ps.pid, roles)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		out = agg.apply(x)
+		return nil
+	})
+	return out, err
+}
+
 type writeProject struct {
