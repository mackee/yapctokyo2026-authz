+	// ivy is a manager of ops and still is.
+	code, body = do(t, h, "POST", "/projects/ops/tasks", "ivy", `{"title":"x"}`)
+	if code != 201 {
+		t.Fatalf("ops create after web freeze: got %d: %s", code, body)
+	}
+}
