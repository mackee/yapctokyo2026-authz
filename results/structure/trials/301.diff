+func freeze(t *testing.T, h http.Handler, user, project string) (int, string) {
+	t.Helper()
+	return do(t, h, "POST", "/projects/"+project+"/freeze", user, "")
+}
+
+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+		{"archived", "ann", "legacy", 409},
+		{"unknown project", "ann", "nope", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := freeze(t, newServer(), c.user, c.project)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeDemotesEveryMember(t *testing.T) {
+	code, body := freeze(t, newServer(), "ann", "web")
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	// Managers (ann, ivy) included; sorted by user ID.
+	want := `[{"userId":"ann","role":"viewer"},{"userId":"ben","role":"viewer"},{"userId":"cat","role":"viewer"},{"userId":"dan","role":"viewer"},{"userId":"ivy","role":"viewer"}]`
+	if got := strings.TrimSpace(body); got != want {
+		t.Fatalf("body mismatch\n got: %s\nwant: %s", got, want)
+	}
+}
+
+func TestFrozenProjectRejectsTaskWrites(t *testing.T) {
+	cases := []struct {
+		name, user, method, path, body string
+	}{
+		{"contributor edits own task", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"contributor edits other task", "cat", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"former manager edits", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"former manager reassigns", "ivy", "PATCH", "/projects/web/tasks/t2", `{"assignee":"ben"}`},
+		{"former manager creates", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"contributor creates", "ben", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"former manager deletes", "ann", "DELETE", "/projects/web/tasks/t1", ""},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			if code, body := freeze(t, h, "ann", "web"); code != 200 {
+				t.Fatalf("freeze: got %d: %s", code, body)
+			}
+			code, _ := do(t, h, c.method, c.path, c.user, c.body)
+			if code != 403 {
+				t.Fatalf("got %d want 403", code)
+			}
+		})
+	}
+}
+
+func TestFrozenProjectKeepsReadsAndTasks(t *testing.T) {
+	h := newServer()
+	if code, body := freeze(t, h, "ann", "web"); code != 200 {
+		t.Fatalf("freeze: got %d: %s", code, body)
+	}
+
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ben", "")
+	if code != 200 {
+		t.Fatalf("read after freeze: got %d: %s", code, body)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	// Nothing about the task changed; its assignment is kept as a record.
+	if task.Status != "open" || task.Assignee != "ben" || task.Title != "Fix header" {
+		t.Fatalf("task changed by freeze: %+v", task)
+	}
+
+	code, body = do(t, h, "GET", "/projects/web/tasks", "dan", "")
+	if code != 200 {
+		t.Fatalf("list after freeze: got %d: %s", code, body)
+	}
+	var tasks []Task
+	if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+		t.Fatal(err)
+	}
+	if len(tasks) != 3 {
+		t.Fatalf("want 3 tasks, got %d", len(tasks))
+	}
+}
+
+func TestFreezeLeavesOtherProjectsAlone(t *testing.T) {
+	h := newServer()
+	if code, body := freeze(t, h, "ann", "web"); code != 200 {
