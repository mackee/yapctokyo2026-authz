+func (p *manageProject) Freeze() ([]Member, error) {
+	var out []Member
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		pr := s.projects[p.ps.pid]
+		pr.frozen = true
+		s.projects[pr.id] = pr
+		for uid := range s.members[p.ps.pid] {
+			s.members[p.ps.pid][uid] = RoleViewer
+		}
+		out = s.membersIn(p.ps.pid)
+		return nil
+	})
+	return out, err
