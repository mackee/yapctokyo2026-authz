+func TestUpdateMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, project, target, body string
+		want                              int
+	}{
+		{"manager promotes", "ann", "web", "dan", `{"role":"contributor"}`, 200},
+		{"manager demotes", "ann", "web", "ben", `{"role":"viewer"}`, 200},
+		{"other manager", "ivy", "web", "cat", `{"role":"viewer"}`, 200},
+		{"manager changes self", "ann", "web", "ann", `{"role":"viewer"}`, 200},
+		{"contributor", "ben", "web", "cat", `{"role":"viewer"}`, 403},
+		{"viewer", "dan", "web", "ben", `{"role":"viewer"}`, 403},
+		{"org admin", "eve", "web", "ben", `{"role":"viewer"}`, 403},
+		{"non member", "hal", "web", "ben", `{"role":"viewer"}`, 404},
+		{"other org", "gus", "web", "ben", `{"role":"viewer"}`, 404},
+		{"anonymous", "", "web", "ben", `{"role":"viewer"}`, 401},
+		{"unknown user", "zed", "web", "ben", `{"role":"viewer"}`, 401},
+		{"target not a member", "ann", "web", "hal", `{"role":"viewer"}`, 404},
+		{"target member of other project only", "ann", "web", "gus", `{"role":"viewer"}`, 404},
+		{"bad role", "ann", "web", "ben", `{"role":"owner"}`, 400},
+		{"missing role", "ann", "web", "ben", `{}`, 400},
+		{"bad json", "ann", "web", "ben", `{"role":`, 400},
+		{"bad body beats forbidden", "ben", "web", "cat", `{"role":"owner"}`, 400},
+		{"archived", "ann", "legacy", "ben", `{"role":"viewer"}`, 409},
+		{"archived contributor", "ben", "legacy", "ben", `{"role":"viewer"}`, 403},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members/"+c.target, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRoleResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["userId"] != "dan" || got["role"] != "contributor" || len(got) != 2 {
+		t.Fatalf("bad body: %s", body)
+	}
+}
+
+// A role change is applied to the rules that follow it, on the same server.
+func TestUpdateMemberRoleTakesEffect(t *testing.T) {
+	srv := newServer()
+
+	// dan is a viewer: cannot create tasks.
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 403 {
+		t.Fatalf("viewer create: got %d want 403", code)
+	}
+	if code, _ := do(t, srv, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`); code != 200 {
+		t.Fatalf("promote: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"x","assignee":"dan"}`); code != 200 {
+		t.Fatalf("contributor create after promote: got %d want 200", code)
+	}
+
+	// ben is a contributor: can edit t1 (assigned to him). After demotion he cannot.
+	if code, _ := do(t, srv, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"doing"}`); code != 200 {
+		t.Fatalf("contributor edit before demote: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 403 {
+		t.Fatalf("viewer edit after demote: got %d want 403", code)
+	}
+}
+
+// Changing a role does not touch the other members, and a contributor cannot
+// promote himself.
+func TestUpdateMemberRoleOnlyTarget(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "PUT", "/projects/web/members/ben", "ben", `{"role":"manager"}`); code != 403 {
+		t.Fatalf("self promote: got %d want 403", code)
+	}
+	if code, _ := do(t, srv, "PUT", "/projects/web/members/dan", "ann", `{"role":"manager"}`); code != 200 {
+		t.Fatalf("promote dan: got %d want 200", code)
+	}
+	// cat was not changed: still a contributor, so cannot delete tasks.
+	if code, _ := do(t, srv, "DELETE", "/projects/web/tasks/t3", "cat", ""); code != 403 {
+		t.Fatalf("contributor delete: got %d want 403", code)
+	}
+	// dan was changed: now a manager, so can delete tasks.
+	if code, _ := do(t, srv, "DELETE", "/projects/web/tasks/t3", "dan", ""); code != 204 {
+		t.Fatalf("promoted manager delete: got %d want 204", code)
+	}
+}
