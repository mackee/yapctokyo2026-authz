+// updateMembershipRoleAggregate changes the role of one member of one project.
+type updateMembershipRoleAggregate struct {
+	membership *Membership
+	project    *Project // membership.Project()
+	user       *User    // membership.User()
+	role       string
+}
+
+func loadUpdateMembershipRole(ctx context.Context, tx DB, projectID string, in MembershipTableUpdateRoleInput) (*updateMembershipRoleAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, projectID, in.UserID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "member not found")
+	} else if err != nil {
+		return nil, err
+	}
+	p, err := m.Project(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	u, err := m.User(ctx, tx)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "member must be a user of the project's organization")
+	} else if err != nil {
+		return nil, err
+	}
+	return &updateMembershipRoleAggregate{membership: m, project: p, user: u, role: in.Role}, nil
+}
+
+func (a *updateMembershipRoleAggregate) validate() error {
+	if a.user.Org != a.project.Org {
+		return deny(ErrInvalid, "member must be a user of the project's organization")
+	}
+	if !validRoles[a.role] {
+		return deny(ErrInvalid, "invalid role")
+	}
+	return nil
+}
+
+func (a *updateMembershipRoleAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.membership.setRole(ctx, tx, a.role); err != nil {
+		return nil, err
+	}
+	return a.membership, nil
+}
+
