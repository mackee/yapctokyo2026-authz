@@ -0,0 +1,65 @@
+package main
+
+import (
+	"net/http"
+	"testing"
+)
+
+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes user", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes user without memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"non-admin is forbidden", "ann", "/orgs/acme/users/ben", 403},
+		{"unknown caller", "nobody", "/orgs/acme/users/ben", 401},
+		{"other org is not found", "gus", "/orgs/acme/users/ben", 404},
+		{"user of another org is not found", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown user is not found", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != http.StatusNoContent {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	// ben lost access to every project, including the archived one.
+	for _, p := range []string{"/projects/web/tasks", "/projects/legacy/tasks"} {
+		if code, body := do(t, h, "GET", p, "ben", ""); code != http.StatusNotFound {
+			t.Fatalf("%s: got %d want 404 body=%s", p, code, body)
+		}
+	}
+	// his tasks are unassigned, so no assignee is left outside the project.
+	for _, p := range []string{"/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		code, body := do(t, h, "GET", p, "ann", "")
+		if code != http.StatusOK {
+			t.Fatalf("%s: got %d body=%s", p, code, body)
+		}
+		if want := `"assignee":""`; !contains(body, want) {
+			t.Fatalf("%s: want %s in %s", p, want, body)
+		}
+	}
+	// other members are untouched.
+	if code, body := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != http.StatusOK {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+}
+
+func contains(s, sub string) bool {
+	for i := 0; i+len(sub) <= len(s); i++ {
+		if s[i:i+len(sub)] == sub {
+			return true
+		}
+	}
+	return false
+}
