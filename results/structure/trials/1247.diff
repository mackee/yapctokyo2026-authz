+// Move moves the member userID out of the project of from and into toProjectID,
+// keeping the role. The actor must be a manager of both projects
+// (CanManageMembers). A member who is not in the source project is 404; a
+// destination the actor cannot read is 404.
+func (*MembershipTable) Move(ctx context.Context, db DB, from ProjectAuthz, userID, toProjectID string) (*Membership, error) {
+	if toProjectID == from.ProjectID() {
+		return nil, deny(ErrInvalid, "destination must be a different project")
+	}
+	if err := from.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	to, err := NewProjectAuthz(ctx, db, from.Actor(), toProjectID)
+	if err != nil {
+		return nil, err
+	}
+	if err := to.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveMember(ctx, tx, from.ProjectID(), userID, toProjectID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		m, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
