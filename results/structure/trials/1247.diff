+func TestMoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, project, uid, body string
+		want                           int
+	}{
+		{"manager of both", "ivy", "web", "ben", `{"toProjectId":"ops"}`, 200},
+		{"contributor", "ben", "web", "cat", `{"toProjectId":"ops"}`, 403},
+		{"viewer", "dan", "web", "ben", `{"toProjectId":"ops"}`, 403},
+		{"org admin", "eve", "web", "ben", `{"toProjectId":"ops"}`, 403},
+		{"destination viewer", "ann", "web", "ben", `{"toProjectId":"ops"}`, 403},
+		{"non member", "hal", "web", "ben", `{"toProjectId":"ops"}`, 404},
+		{"other org", "gus", "web", "ben", `{"toProjectId":"ops"}`, 404},
+		{"destination other org", "ann", "web", "ben", `{"toProjectId":"gx"}`, 404},
+		{"destination missing", "ivy", "web", "ben", `{"toProjectId":"nope"}`, 404},
+		{"anonymous", "", "web", "ben", `{"toProjectId":"ops"}`, 401},
+		{"unknown user", "zed", "web", "ben", `{"toProjectId":"ops"}`, 401},
+		{"archived source", "ann", "legacy", "ben", `{"toProjectId":"web"}`, 409},
+		{"archived destination", "ann", "web", "cat", `{"toProjectId":"legacy"}`, 409},
+		{"member not in source", "ivy", "web", "hal", `{"toProjectId":"ops"}`, 404},
+		{"unknown member", "ivy", "web", "zed", `{"toProjectId":"ops"}`, 404},
+		{"already in destination", "ivy", "web", "cat", `{"toProjectId":"ops"}`, 400},
+		{"same project", "ivy", "web", "ben", `{"toProjectId":"web"}`, 400},
+		{"empty destination", "ivy", "web", "ben", `{"toProjectId":""}`, 400},
+		{"missing destination", "ivy", "web", "ben", `{}`, 400},
+		{"malformed body", "ivy", "web", "ben", `{"toProjectId":`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			path := "/projects/" + c.project + "/members/" + c.uid + "/move"
+			code, _ := do(t, newServer(), "POST", path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveMemberResult(t *testing.T) {
+	srv := newServer()
+	code, body := do(t, srv, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]string{"userId": "ben", "projectId": "ops", "role": "contributor"}
+	for k, v := range want {
+		if got[k] != v {
+			t.Fatalf("response %s = %q, want %q (body %s)", k, got[k], v, body)
+		}
+	}
+	if len(got) != len(want) {
+		t.Fatalf("unexpected fields in response: %s", body)
+	}
+
+	// Removed from the source project.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben still reads web: got %d", code)
+	}
+	// Added to the destination with the same role: a contributor can create there.
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben cannot read ops: got %d", code)
+	}
+	if code, body := do(t, srv, "POST", "/projects/ops/tasks", "ben", `{"title":"x","assignee":"ben"}`); code != 200 {
+		t.Fatalf("ben cannot create in ops: got %d %s", code, body)
+	}
+	// Ben's assigned task in web (t1) is unassigned, so the assignee stays a member.
+	code, body = do(t, srv, "GET", "/projects/web/tasks/t1", "ivy", "")
+	if code != 200 {
+		t.Fatalf("get t1: got %d %s", code, body)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "" {
+		t.Fatalf("t1 still assigned to %q after move", task.AssigneeID)
+	}
+	// Ben's task in another project is untouched.
+	code, body = do(t, srv, "GET", "/projects/legacy/tasks/t5", "ann", "")
+	if code != 200 || !strings.Contains(body, `"assignee":"ben"`) {
+		t.Fatalf("t5 changed: got %d %s", code, body)
+	}
+}
