+
+// moveMemberAggregate moves one member from the source project to the
+// destination project, keeping the role. The member's tasks in the source
+// project are unassigned, so every assignee stays a member of its task's project.
+type moveMemberAggregate struct {
+	from     *Membership // the member in the source project
+	to       *Project    // the destination project
+	user     *User
+	existing *Membership // the member's membership in the destination; nil if none
+	tasks    []*Task     // the source project's tasks assigned to the member
+}
+
+func loadMoveMember(ctx context.Context, tx DB, fromProjectID, userID, toProjectID string) (*moveMemberAggregate, error) {
+	fromProject, err := NewProjectTable().Find(ctx, tx, fromProjectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	m, err := fromProject.Membership(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	to, err := NewProjectTable().Find(ctx, tx, toProjectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	user, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	existing, err := to.Membership(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		existing = nil
+	} else if err != nil {
+		return nil, err
+	}
+	tasks, err := m.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &moveMemberAggregate{from: m, to: to, user: user, existing: existing, tasks: tasks}, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.existing != nil {
+		return deny(ErrInvalid, "user is already a member of the destination project")
+	}
+	if a.user.Org != a.to.Org {
+		return deny(ErrInvalid, "project members must belong to the project's organization")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.from.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	dest := &Membership{ProjectID: a.to.ID, UserID: a.from.UserID, Role: a.from.Role}
+	if err := dest.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return dest, nil
+}
