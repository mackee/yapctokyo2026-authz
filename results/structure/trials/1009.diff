+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager of both", "ivy", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 200},
+		{"contributor source", "ben", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer in destination", "ann", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"not a member of destination", "ann", "/projects/web/tasks/t1/move", `{"toProjectId":"gx"}`, 404},
+		{"other org destination", "ivy", "/projects/web/tasks/t1/move", `{"toProjectId":"gx"}`, 404},
+		{"unknown destination", "ivy", "/projects/web/tasks/t1/move", `{"toProjectId":"nope"}`, 404},
+		{"archived destination", "ann", "/projects/web/tasks/t1/move", `{"toProjectId":"legacy"}`, 409},
+		{"archived source", "ann", "/projects/legacy/tasks/t5/move", `{"toProjectId":"web"}`, 409},
+		{"same project", "ann", "/projects/web/tasks/t1/move", `{"toProjectId":"web"}`, 400},
+		{"missing body field", "ann", "/projects/web/tasks/t1/move", `{}`, 400},
+		{"cross project task", "ivy", "/projects/web/tasks/t4/move", `{"toProjectId":"ops"}`, 404},
+		{"org admin not member", "eve", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"unauthenticated", "zed", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestMoveCarriesFields(t *testing.T) {
+	s := newServer()
+	code, body := do(t, s, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	want := `{"id":"t2","projectId":"ops","title":"Update footer","status":"doing","assignee":"cat"}`
+	if strings.TrimSpace(body) != want {
+		t.Fatalf("got %s want %s", body, want)
+	}
+	if code, _ := do(t, s, "GET", "/projects/web/tasks/t2", "ivy", ""); code != 404 {
+		t.Fatalf("old location: got %d want 404", code)
+	}
+	if code, _ := do(t, s, "GET", "/projects/ops/tasks/t2", "ivy", ""); code != 200 {
+		t.Fatalf("new location: got %d want 200", code)
+	}
+}
