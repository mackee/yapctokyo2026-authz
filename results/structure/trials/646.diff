+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, project, task, body string
+		want                            int
+	}{
+		{"contributor others", "cat", "web", "t1", `{"toProjectId":"ops"}`, 403},
+		{"viewer", "dan", "web", "t1", `{"toProjectId":"ops"}`, 403},
+		{"org admin read-only source", "eve", "web", "t1", `{"toProjectId":"ops"}`, 403},
+		{"manager but viewer in target", "ann", "web", "t1", `{"toProjectId":"ops"}`, 403},
+		{"contributor, no role in target", "ben", "web", "t1", `{"toProjectId":"ops"}`, 404},
+		{"non member", "hal", "web", "t1", `{"toProjectId":"ops"}`, 404},
+		{"cross org target", "ann", "web", "t1", `{"toProjectId":"gx"}`, 404},
+		{"missing target", "ann", "web", "t1", `{"toProjectId":"nope"}`, 404},
+		{"same project", "ivy", "web", "t1", `{"toProjectId":"web"}`, 400},
+		{"missing toProjectId", "ivy", "web", "t1", `{}`, 400},
+		{"archived target", "ann", "web", "t2", `{"toProjectId":"legacy"}`, 409},
+		{"archived source", "ann", "legacy", "t5", `{"toProjectId":"web"}`, 409},
+		{"cross project task id", "ann", "web", "t4", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "web", "t1", `{"toProjectId":"ops"}`, 401},
+		{"unknown user", "zed", "web", "t1", `{"toProjectId":"ops"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/tasks/"+c.task+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsFields(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/tasks/t1/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t1", ProjectID: "ops", Title: "Fix header", Status: "open", Assignee: "ben"}
+	if task != want {
+		t.Fatalf("got %+v want %+v", task, want)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t1", "ann", ""); code != 404 {
+		t.Fatalf("task still readable in source project: %d", code)
+	}
+	code, body = do(t, h, "GET", "/projects/ops/tasks/t1", "ivy", "")
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+}
