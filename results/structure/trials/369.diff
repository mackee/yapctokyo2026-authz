+// setMemberRoleAggregate changes the role of one member of one project.
+type setMemberRoleAggregate struct {
+	membership membershipRecord
+	role       string
+	assigned   []taskRecord // tasks of the project assigned to the member
+}
+
+func loadSetMemberRole(x *tx, projectID, userID, role string) (*setMemberRoleAggregate, error) {
+	p, ok := x.findProject(projectID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	m, ok := p.Membership(x, userID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	return &setMemberRoleAggregate{membership: m, role: role, assigned: m.AssignedTasks(x)}, nil
+}
+
+func (a *setMemberRoleAggregate) validate() error {
+	if !isWriterRole(a.role) && len(a.assigned) > 0 {
+		return deny(ErrInvalid, "member is still assigned tasks in this project; reassign them before making the member a viewer")
+	}
+	return nil
+}
+
+func (a *setMemberRoleAggregate) apply(x *tx) MemberView {
+	m := a.membership
+	m.ChangeRole(x, a.role)
+	return MemberView{UserID: m.UserID, Role: m.Role}
+}
