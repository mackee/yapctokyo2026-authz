diff --git a/member_test.go b/member_test.go
new file mode 100644
index 0000000..61f2e04
--- /dev/null
+++ b/member_test.go
@@ -0,0 +1,102 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestSetMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, project, target, body string
+		want                              int
+	}{
+		{"manager promotes viewer", "ann", "web", "dan", `{"role":"contributor"}`, 200},
+		{"manager promotes contributor", "ann", "web", "ben", `{"role":"manager"}`, 200},
+		{"manager demotes member without tasks", "ann", "web", "ivy", `{"role":"viewer"}`, 200},
+		{"manager sets own role", "ann", "web", "ann", `{"role":"contributor"}`, 200},
+		{"contributor", "ben", "web", "dan", `{"role":"contributor"}`, 403},
+		{"viewer", "dan", "web", "ben", `{"role":"viewer"}`, 403},
+		{"org admin is not a manager", "eve", "web", "dan", `{"role":"contributor"}`, 403},
+		{"non member", "hal", "web", "dan", `{"role":"contributor"}`, 404},
+		{"other org", "gus", "web", "dan", `{"role":"contributor"}`, 404},
+		{"anonymous", "", "web", "dan", `{"role":"contributor"}`, 401},
+		{"unknown actor", "zed", "web", "dan", `{"role":"contributor"}`, 401},
+		{"target not a member", "ann", "web", "hal", `{"role":"contributor"}`, 404},
+		{"target unknown user", "ann", "web", "zed", `{"role":"contributor"}`, 404},
+		{"archived", "ann", "legacy", "ben", `{"role":"viewer"}`, 409},
+		{"invalid role", "ann", "web", "dan", `{"role":"owner"}`, 400},
+		{"missing role", "ann", "web", "dan", `{}`, 400},
+		{"malformed body", "ann", "web", "dan", `not json`, 400},
+		{"demote member with assigned tasks", "ann", "web", "ben", `{"role":"viewer"}`, 400},
+		{"manager of ops promotes viewer", "ivy", "ops", "ann", `{"role":"contributor"}`, 200},
+		{"manager of web is viewer in ops", "ann", "ops", "cat", `{"role":"viewer"}`, 403},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members/"+c.target, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMemberRoleResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["userId"] != "dan" || got["role"] != "contributor" || len(got) != 2 {
+		t.Fatalf("unexpected body %s", body)
+	}
+}
+
+func TestSetMemberRoleTakesEffect(t *testing.T) {
+	srv := newServer()
+
+	// dan is a viewer: cannot create tasks.
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 403 {
+		t.Fatalf("viewer create: got %d want 403", code)
+	}
+	if code, _ := do(t, srv, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`); code != 200 {
+		t.Fatalf("promote: got %d want 200", code)
+	}
+	// dan is now a contributor: can create tasks.
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 201 {
+		t.Fatalf("contributor create: got %d want 201", code)
+	}
+	// Demoting dan again removes write access.
+	if code, _ := do(t, srv, "PUT", "/projects/web/members/dan", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"y"}`); code != 403 {
+		t.Fatalf("demoted create: got %d want 403", code)
+	}
+}
+
+func TestDemoteAfterReassign(t *testing.T) {
+	srv := newServer()
+
+	// ben holds t1: demotion is refused while the task is still assigned to ben.
+	if code, _ := do(t, srv, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 400 {
+		t.Fatalf("demote with task: got %d want 400", code)
+	}
+	// A refused change changes nothing: ben can still edit own task.
+	if code, _ := do(t, srv, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ben after refused demotion: got %d want 200", code)
+	}
+	// Reassign t1 away from ben, then the demotion is allowed.
+	if code, _ := do(t, srv, "PATCH", "/projects/web/tasks/t1", "ann", `{"assignee":"cat"}`); code != 200 {
+		t.Fatalf("reassign: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote after reassign: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Fatalf("demoted ben create: got %d want 403", code)
+	}
+}
