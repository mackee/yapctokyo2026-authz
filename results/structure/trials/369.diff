+func (p *manageProject) SetMemberRole(userID, role string) (MemberView, error) {
+	if !isProjectRole(role) {
+		return MemberView{}, deny(ErrInvalid, "role must be manager, contributor or viewer")
+	}
+	var v MemberView
+	err := p.ps.as.a.db.update(func(x *tx) error {
+		agg, err := loadSetMemberRole(x, p.ps.pid, userID, role)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		v = agg.apply(x)
+		return nil
+	})
+	return v, err
+}
