--- /dev/null
+++ b/internal/model/member_table.go
@@ -0,0 +1,20 @@
+package model
+
+import "context"
+
+// Remove removes the member from the project and unassigns their tasks there.
+func (*MembershipTable) Remove(ctx context.Context, db DB, authz MemberAuthz) error {
+	if err := authz.CanRemove(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveMember(ctx, tx, authz.Project().ProjectID(), authz.UserID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
