+// MemberAuthz is what the actor may do with one membership of one project.
+type MemberAuthz struct {
+	project ProjectAuthz
+	member  string
+}
+
+// Project returns the project-level authorization the member object came from.
+func (a MemberAuthz) Project() ProjectAuthz { return a.project }
+
+// UserID returns the member the object is bound to.
+func (a MemberAuthz) UserID() string { return a.member }
+
+// CanRead reports whether the actor may read the membership. NewMemberAuthz
+// only returns objects that can read, so this is true for every built object.
+func (a MemberAuthz) CanRead() bool { return a.member != "" && a.project.CanRead() }
+
+// CanRemove returns nil if the actor may remove the member: managers only
+// (else ErrForbidden) and not archived (else ErrArchived).
+func (a MemberAuthz) CanRemove() error {
+	if !a.CanRead() || a.project.role != RoleManager {
+		return deny(ErrForbidden, "forbidden")
+	}
+	if a.project.archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	return nil
+}
+
 // ---- building authorization objects -------------------------------------------------
 
+// NewMemberAuthz builds the actor's authorization object for one member of the
+// project. The user must be a member of the project; otherwise ErrNotFound.
+func NewMemberAuthz(ctx context.Context, db DB, pa ProjectAuthz, userID string) (MemberAuthz, error) {
+	if !pa.CanRead() {
+		return MemberAuthz{}, deny(ErrNotFound, "not found")
+	}
+	m, err := NewMembershipTable().Find(ctx, db, pa.project, userID)
+	if errors.Is(err, ErrNoRows) {
+		return MemberAuthz{}, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return MemberAuthz{}, err
+	}
+	return MemberAuthz{project: pa, member: m.UserID}, nil
+}
