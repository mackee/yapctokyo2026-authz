+// moveTaskAggregate moves one task into another project of the same
+// organization. The task keeps its assignee, which must be a contributor or
+// manager of the destination project.
+type moveTaskAggregate struct {
+	task     *Task
+	dest     *Project
+	assignee *Membership // the assignee as a member of dest; nil when unassigned or not a member
+}
+
+func loadMoveTask(ctx context.Context, tx DB, taskID, destProjectID string) (*moveTaskAggregate, error) {
+	t, err := NewTaskTable().Find(ctx, tx, taskID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	dest, err := NewProjectTable().Find(ctx, tx, destProjectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveTaskAggregate{task: t, dest: dest}
+	if t.AssigneeID != "" {
+		m, err := dest.Membership(ctx, tx, t.AssigneeID)
+		if err == nil {
+			a.assignee = m
+		} else if !errors.Is(err, ErrNoRows) {
+			return nil, err
+		}
+	}
+	return a, nil
+}
+
+func (a *moveTaskAggregate) validate() error {
+	if a.task.ProjectID == a.dest.ID {
+		return deny(ErrInvalid, "task is already in the project")
+	}
+	if a.task.AssigneeID != "" && (a.assignee == nil || !isWriterRole(a.assignee.Role)) {
+		return deny(ErrInvalid, "assignee must be a contributor or manager of the destination project")
+	}
+	return nil
+}
+
+func (a *moveTaskAggregate) apply(ctx context.Context, tx DB) (*Task, error) {
+	if err := a.task.moveTo(ctx, tx, a.dest.ID); err != nil {
+		return nil, err
+	}
+	return a.task, nil
+}
+
