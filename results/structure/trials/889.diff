+// CanMoveTo returns nil if the actor may move the task into the project dest
+// (built by NewProjectAuthz for the same actor). The actor must be able to edit
+// the task in its current project (CanEdit) and be a contributor or manager in
+// dest (CanWrite, else ErrArchived when dest is archived). A manager in both
+// projects may move any task; otherwise the task must be assigned to the actor.
+func (a TaskAuthz) CanMoveTo(dest ProjectAuthz) error {
+	if err := a.CanEdit(); err != nil {
+		return err
+	}
+	if err := dest.CanWrite(); err != nil {
+		return err
+	}
+	if a.project.role == RoleManager && dest.role == RoleManager {
+		return nil
+	}
+	if !a.isAssignee {
+		return deny(ErrForbidden, "only managers in both projects may move tasks assigned to others")
+	}
+	return nil
+}
