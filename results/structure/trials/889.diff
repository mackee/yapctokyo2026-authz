+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"contributor own, both contributors", "cat", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 200},
+		{"contributor not assignee", "cat", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 403},
+		{"manager both, others' task", "ivy", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 200},
+		{"manager both, assignee not in dest", "ivy", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 400},
+		{"manager source, viewer dest", "ann", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"contributor, dest not member", "ben", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 404},
+		{"viewer source, dest not readable", "dan", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 404},
+		{"viewer dest", "ann", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 403},
+		{"org admin no role in source", "eve", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"dest archived", "ann", "/projects/web/tasks/t1", `{"toProjectId":"legacy"}`, 409},
+		{"dest missing", "ivy", "/projects/web/tasks/t1", `{"toProjectId":"nope"}`, 404},
+		{"dest other org", "ivy", "/projects/web/tasks/t1", `{"toProjectId":"gx"}`, 404},
+		{"source other org", "gus", "/projects/web/tasks/t1", `{"toProjectId":"gx"}`, 404},
+		{"non member source", "hal", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 404},
+		{"cross project id", "ivy", "/projects/web/tasks/t4", `{"toProjectId":"ops"}`, 404},
+		{"same project", "ivy", "/projects/web/tasks/t2", `{"toProjectId":"web"}`, 400},
+		{"missing toProjectId", "ivy", "/projects/web/tasks/t2", `{}`, 400},
+		{"archived source", "ann", "/projects/legacy/tasks/t5", `{"toProjectId":"web"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveResponseKeepsTask(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", AssigneeID: "cat"}
+	if task != want {
+		t.Fatalf("got %+v want %+v", task, want)
+	}
+	// The task is gone from the source and readable in the destination.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t2", "ann", ""); code != 404 {
+		t.Fatalf("source still has task: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks/t2", "ann", ""); code != 200 {
+		t.Fatalf("destination lacks task: %d", code)
+	}
+}
