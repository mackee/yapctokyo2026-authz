+// setMemberRoleAggregate changes the role of one existing member of a project.
+type setMemberRoleAggregate struct {
+	member   membershipRecord
+	role     string
+	assigned []taskRecord // the member's tasks in this project
+}
+
+func loadSetMemberRole(x *tx, projectID, userID, role string) (*setMemberRoleAggregate, error) {
+	p, ok := x.findProject(projectID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	m, ok := p.Membership(x, userID)
+	if !ok {
+		return nil, deny(ErrNotFound, "member not found")
+	}
+	return &setMemberRoleAggregate{member: m, role: role, assigned: m.AssignedTasks(x)}, nil
+}
+
+func (a *setMemberRoleAggregate) validate() error {
+	// An assignee must stay a contributor or manager of the task's project.
+	if !isWriterRole(a.role) && len(a.assigned) > 0 {
+		return deny(ErrInvalid, "member has assigned tasks; reassign them before making the member a viewer")
+	}
+	return nil
+}
+
+func (a *setMemberRoleAggregate) apply(x *tx) MemberView {
+	m := a.member
+	m.SetRole(x, a.role)
+	return MemberView{UserID: m.UserID, Role: m.Role}
+}
