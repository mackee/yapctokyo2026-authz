+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager any", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 200},
+		{"contributor own", "cat", "/projects/web/tasks/t2/move", `{"toProjectId":"ops"}`, 200},
+		{"contributor others", "ben", "/projects/web/tasks/t2/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer", "dan", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin no role", "eve", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"non member", "hal", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 404},
+		{"other org caller", "gus", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 401},
+		{"unknown user", "zed", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 401},
+		{"source project missing", "ivy", "/projects/missing/tasks/t1/move", `{"toProjectId":"ops"}`, 404},
+		{"task in other project", "ivy", "/projects/web/tasks/t4/move", `{"toProjectId":"ops"}`, 404},
+		{"source archived", "ann", "/projects/legacy/tasks/t5/move", `{"toProjectId":"ops"}`, 409},
+		{"destination missing", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"missing"}`, 404},
+		{"destination other org", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"gx"}`, 404},
+		{"destination non member", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"legacy"}`, 404},
+		{"destination viewer", "ann", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 403},
+		{"destination archived", "ann", "/projects/web/tasks/t3/move", `{"toProjectId":"legacy"}`, 409},
+		{"same project", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"web"}`, 400},
+		{"empty destination", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":""}`, 400},
+		{"missing destination", "ivy", "/projects/web/tasks/t3/move", `{}`, 400},
+		{"bad json", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":`, 400},
+		{"assignee not writer there", "ivy", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveResponseKeepsFields(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/tasks/t2/move", "cat", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", Assignee: "cat"}
+	if task != want {
+		t.Fatalf("got %+v want %+v", task, want)
+	}
+}
+
+func TestMoveThenRead(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/projects/web/tasks/t3/move", "ivy", `{"toProjectId":"ops"}`); code != 200 {
+		t.Fatalf("move got %d: %s", code, body)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks/t3", "ivy", ""); code != 200 {
+		t.Fatalf("task not readable in destination: %d", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks/t3", "ivy", ""); code != 404 {
+		t.Fatalf("task still readable in source: %d", code)
+	}
+	code, body := do(t, srv, "GET", "/projects/web/tasks", "ivy", "")
+	if code != 200 {
+		t.Fatal(code)
+	}
+	var tasks []Task
+	json.Unmarshal([]byte(body), &tasks)
+	if len(tasks) != 2 {
+		t.Fatalf("source should have 2 tasks left, got %d", len(tasks))
+	}
+}
