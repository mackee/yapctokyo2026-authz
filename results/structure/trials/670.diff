@@ -0,0 +1,84 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"other manager", "ivy", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"unknown user", "zed", "web", 401},
+		{"anonymous", "", "web", 401},
+		{"archived", "ann", "legacy", 409},
+		{"missing project", "ann", "nope", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestFreezeResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var members []struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &members); err != nil {
+		t.Fatal(err)
+	}
+	want := []string{"ann", "ben", "cat", "dan", "ivy"}
+	if len(members) != len(want) {
+		t.Fatalf("want %d members, got %d: %s", len(want), len(members), body)
+	}
+	for i, m := range members {
+		if m.UserID != want[i] || m.Role != "viewer" {
+			t.Fatalf("member %d = %+v, want {%s viewer}", i, m, want[i])
+		}
+	}
+}
+
+func TestFreezeBlocksTaskWrites(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze got %d body=%s", code, body)
+	}
+	cases := []struct {
+		name, user, method, path, body string
+		want                           int
+	}{
+		{"manager patches", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"contributor patches own", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`, 403},
+		{"manager creates", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"contributor creates", "cat", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"manager deletes", "ann", "DELETE", "/projects/web/tasks/t1", "", 403},
+		{"former manager cannot refreeze", "ann", "POST", "/projects/web/freeze", "", 403},
+		{"reads still work", "ben", "GET", "/projects/web/tasks/t1", "", 200},
+		{"other project unaffected", "cat", "PATCH", "/projects/ops/tasks/t4", `{"status":"done"}`, 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, srv, c.method, c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
