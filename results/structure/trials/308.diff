+// Transfer applies the transfer rule: the actor must belong to the organization
+// in the path (else 404), must be an org admin of it (else 403), and the user
+// must belong to it (else 404).
+func (s *userScope) Transfer() (TransferUser, error) {
+	err := s.os.as.a.st.read(func(st *state) error {
+		act := s.os.as.actor
+		if act.org != s.os.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		if !act.orgAdmin {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if u, ok := st.users[s.uid]; !ok || u.org != s.os.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &transferUser{us: s}, nil
