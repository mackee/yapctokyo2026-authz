+// ---- organization capabilities -------------------------------------------------
+
+// TransferUser may move one user to another organization.
+type TransferUser interface {
+	// Move changes the user's organization. The user must hold no project
+	// memberships in the current organization (else 409; remove them first),
+	// which keeps the model invariants intact without silently dropping access.
+	// The user loses org-admin rights. toOrgID must be an existing organization
+	// other than the current one (else 400).
+	Move(toOrgID string) (UserView, error)
+}
+
+type transferUser struct{ us *userScope }
+
+func (t *transferUser) Move(toOrgID string) (UserView, error) {
+	var v UserView
+	err := t.us.os.as.a.st.tx(func(s *state) error {
+		u, ok := s.users[t.us.uid]
+		if !ok || u.org != t.us.os.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		if toOrgID == "" {
+			return deny(ErrInvalid, "toOrgId is required")
+		}
+		if toOrgID == u.org {
+			return deny(ErrInvalid, "user is already in that organization")
+		}
+		if !orgExists(s, toOrgID) {
+			return deny(ErrInvalid, "unknown organization")
+		}
+		for pid, m := range s.members {
+			if _, ok := m[u.id]; ok {
+				return deny(ErrConflict, fmt.Sprintf("user is still a member of project %s; remove project memberships before transfer", pid))
+			}
+		}
+		u.org = toOrgID
+		u.orgAdmin = false
+		s.users[u.id] = u
+		v = UserView{ID: u.id, OrgID: u.org}
+		return nil
+	})
+	return v, err
+}
+
+// orgExists reports whether any user or project belongs to the organization.
+func orgExists(s *state, orgID string) bool {
+	for _, u := range s.users {
+		if u.org == orgID {
+			return true
+		}
+	}
+	for _, p := range s.projects {
+		if p.org == orgID {
+			return true
+		}
+	}
+	return false
+}
 
