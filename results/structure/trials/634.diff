+// updateRolesAggregate changes the roles of several members of one project.
+type updateRolesAggregate struct {
+	project *Project
+	changes []roleChange // ordered by user ID
+}
+
+type roleChange struct {
+	member *Membership
+	role   string
+}
+
+func loadUpdateRoles(ctx context.Context, tx DB, projectID string, in MembershipTableUpdateRolesInput) (*updateRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	userIDs := make([]string, 0, len(in.Roles))
+	for id := range in.Roles {
+		userIDs = append(userIDs, id)
+	}
+	sort.Strings(userIDs)
+	a := &updateRolesAggregate{project: p}
+	for _, id := range userIDs {
+		m, err := p.Membership(ctx, tx, id)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, fmt.Sprintf("%s is not a member of the project", id))
+		} else if err != nil {
+			return nil, err
+		}
+		a.changes = append(a.changes, roleChange{member: m, role: in.Roles[id]})
+	}
+	return a, nil
+}
+
+func (a *updateRolesAggregate) validate() error {
+	for _, c := range a.changes {
+		if !isRole(c.role) {
+			return deny(ErrInvalid, fmt.Sprintf("invalid role %q", c.role))
+		}
+	}
+	return nil
+}
+
+func (a *updateRolesAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for _, c := range a.changes {
+		if err := c.member.setRole(ctx, tx, c.role); err != nil {
+			return nil, err
+		}
+	}
+	return a.project.Memberships(ctx, tx)
+}
+
