+// MembershipTableUpdateRolesInput is the input of MembershipTable.UpdateRoles:
+// the new role of each member, by user ID.
+type MembershipTableUpdateRolesInput struct {
+	Roles map[string]string
+}
+
+// UpdateRoles changes the roles of several members of the project, all or
+// nothing. Every user ID must already be a member and every role must be valid;
+// otherwise nothing changes. It returns the project's members after the change,
+// ordered by user ID.
+func (*MembershipTable) UpdateRoles(ctx context.Context, db DB, authz ProjectAuthz, in MembershipTableUpdateRolesInput) ([]*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if len(in.Roles) == 0 {
+		return nil, deny(ErrInvalid, "roles must not be empty")
+	}
+	var out []*Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadUpdateRoles(ctx, tx, authz.ProjectID(), in)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if out, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
