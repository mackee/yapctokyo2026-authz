+// After a transfer the user belongs to the new organization: they can no
+// longer see the old organization's projects, and keep no project roles or
+// task assignments there (project members belong to the project's org).
+func TestTransferEffects(t *testing.T) {
+	s := newServer()
+	if code, body := do(t, s, "POST", "/orgs/acme/users/cat/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatal(code, body)
+	}
+
+	// cat is gone from acme: the old org can no longer address them.
+	if code, _ := do(t, s, "POST", "/orgs/acme/users/cat/transfer", "eve", `{"toOrgId":"globex"}`); code != 404 {
+		t.Fatalf("second transfer from old org: got %d want 404", code)
+	}
+	// cat lost access to acme projects.
+	if code, _ := do(t, s, "GET", "/projects/web/tasks", "cat", ""); code != 404 {
+		t.Fatalf("old project readable: got %d want 404", code)
+	}
+	if code, _ := do(t, s, "GET", "/projects/ops/tasks", "cat", ""); code != 404 {
+		t.Fatalf("old project readable: got %d want 404", code)
+	}
+	// cat's tasks are unassigned; nobody else's are touched.
+	assignee := func(project, tid string) string {
+		code, body := do(t, s, "GET", "/projects/"+project+"/tasks/"+tid, "ann", "")
+		if code != 200 {
+			t.Fatalf("get %s: %d", tid, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		return task.AssigneeID
+	}
+	if a := assignee("web", "t2"); a != "" {
+		t.Fatalf("t2 assignee %q, want unassigned", a)
+	}
+	if a := assignee("ops", "t4"); a != "" {
+		t.Fatalf("t4 assignee %q, want unassigned", a)
+	}
+	if a := assignee("web", "t1"); a != "ben" {
+		t.Fatalf("t1 assignee %q, want ben", a)
+	}
+	// cat is no longer assignable in the old org's projects.
+	if code, _ := do(t, s, "POST", "/projects/web/tasks", "ann", `{"title":"x","assignee":"cat"}`); code != 400 {
+		t.Fatalf("assign transferred user: got %d want 400", code)
+	}
+	// The new org can address cat.
+	if code, body := do(t, s, "POST", "/orgs/globex/users/cat/transfer", "gus", `{"toOrgId":"acme"}`); code != 403 {
+		t.Fatalf("non admin of new org: got %d want 403 (%s)", code, body)
+	}
+}
+
+// Org admin rights belong to one organization: a transferred admin is an
+// ordinary member of the new one.
+func TestTransferDropsOrgAdmin(t *testing.T) {
+	s := newServer()
+	if code, _ := do(t, s, "GET", "/projects/web/tasks", "eve", ""); code != 200 {
+		t.Fatal("eve should read acme projects")
+	}
+	if code, body := do(t, s, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatal(code, body)
+	}
+	if code, _ := do(t, s, "GET", "/projects/gx/tasks", "eve", ""); code != 404 {
+		t.Fatalf("transferred admin reads new org projects: got %d want 404", code)
+	}
+	if code, _ := do(t, s, "GET", "/projects/web/tasks", "eve", ""); code != 404 {
+		t.Fatalf("transferred admin reads old org projects: got %d want 404", code)
+	}
+	if code, _ := do(t, s, "POST", "/orgs/globex/users/gus/transfer", "eve", `{"toOrgId":"acme"}`); code != 403 {
+		t.Fatalf("transferred admin acts as admin of new org: got %d want 403", code)
+	}
+}
+
+// A refused transfer changes nothing.
+func TestTransferRefusedChangesNothing(t *testing.T) {
+	s := newServer()
+	if code, _ := do(t, s, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 409 {
+		t.Fatal("expected 409")
+	}
+	if code, _ := do(t, s, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben lost access: got %d", code)
+	}
+	if code, _ := do(t, s, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 409 {
+		t.Fatal("ben moved after refusal")
+	}
+}
