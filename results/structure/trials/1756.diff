+// transferUserAggregate moves one user to another organization. Project
+// members must belong to the project's organization, so the user's memberships
+// and assignments in the old organization's projects are dropped.
+type transferUserAggregate struct {
+	user        *User
+	toOrg       string
+	memberships []*Membership
+	tasks       []*Task
+	archived    bool // some affected project is archived (read-only)
+}
+
+func loadTransferUser(ctx context.Context, tx DB, fromOrg, userID, toOrg string) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != fromOrg {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	ok, err := NewUserTable().OrgExists(ctx, tx, toOrg)
+	if err != nil {
+		return nil, err
+	}
+	if !ok {
+		return nil, deny(ErrInvalid, "target organization does not exist")
+	}
+	a := &transferUserAggregate{user: u, toOrg: toOrg}
+	if a.memberships, err = u.Memberships(ctx, tx); err != nil {
+		return nil, err
+	}
+	if a.tasks, err = u.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	archived := func(p *Project, err error) error {
+		if errors.Is(err, ErrNoRows) {
+			return nil
+		} else if err != nil {
+			return err
+		}
+		if p.Archived {
+			a.archived = true
+		}
+		return nil
+	}
+	for _, m := range a.memberships {
+		if err := archived(m.Project(ctx, tx)); err != nil {
+			return nil, err
+		}
+	}
+	for _, t := range a.tasks {
+		if err := archived(t.Project(ctx, tx)); err != nil {
+			return nil, err
+		}
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if a.archived {
+		return deny(ErrArchived, "user has roles or tasks in an archived project")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.user.moveTo(ctx, tx, a.toOrg); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
+
