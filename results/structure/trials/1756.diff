+// Transfer moves the user from the organization of authz to another one.
+// The user leaves the old organization's projects (memberships removed, tasks
+// assigned to them unassigned) and loses org admin rights.
+func (ut *UserTable) Transfer(ctx context.Context, db DB, authz OrgAuthz, userID, toOrg string) (*User, error) {
+	if err := authz.CanTransfer(); err != nil {
+		return nil, err
+	}
+	if toOrg == "" || toOrg == authz.OrgID() {
+		return nil, deny(ErrInvalid, "toOrgId must be a different organization")
