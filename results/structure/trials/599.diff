+// changeRolesAggregate changes the roles of several members of one project.
+type changeRolesAggregate struct {
+	members  []*Membership     // the members to change, in ascending user ID order
+	roles    map[string]string // user ID -> new role
+	assigned map[string]int    // user ID -> number of tasks assigned to them in the project
+}
+
+func loadChangeRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*changeRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "project does not exist")
+	} else if err != nil {
+		return nil, err
+	}
+	all, err := p.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	a := &changeRolesAggregate{roles: roles, assigned: map[string]int{}}
+	found := 0
+	for _, m := range all {
+		if _, ok := roles[m.UserID]; !ok {
+			continue
+		}
+		found++
+		a.members = append(a.members, m)
+		ts, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.assigned[m.UserID] = len(ts)
+	}
+	if found != len(roles) {
+		return nil, deny(ErrInvalid, "every user must be a member of the project")
+	}
+	return a, nil
+}
+
+func (a *changeRolesAggregate) validate() error {
+	for _, m := range a.members {
+		role := a.roles[m.UserID]
+		if !isValidRole(role) {
+			return deny(ErrInvalid, "role must be manager, contributor or viewer")
+		}
+		if !isWriterRole(role) && a.assigned[m.UserID] > 0 {
+			return deny(ErrInvalid, "a member with assigned tasks must stay a contributor or manager: "+m.UserID)
+		}
+	}
+	return nil
+}
+
+// apply changes the roles and returns all members of the project.
+func (a *changeRolesAggregate) apply(ctx context.Context, tx DB) error {
+	for _, m := range a.members {
+		if err := m.changeRole(ctx, tx, a.roles[m.UserID]); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
