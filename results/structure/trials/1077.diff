+// updateRolesAggregate changes the roles of several members of one project.
+// Every target must already be a member; the check happens for all of them
+// before any role is changed.
+type updateRolesAggregate struct {
+	targets []*Membership // sorted by user ID
+	roles   map[string]string
+}
+
+func loadUpdateRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*updateRolesAggregate, error) {
+	userIDs := make([]string, 0, len(roles))
+	for userID := range roles {
+		userIDs = append(userIDs, userID)
+	}
+	sort.Strings(userIDs)
+	a := &updateRolesAggregate{roles: roles}
+	for _, userID := range userIDs {
+		m, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "user "+userID+" is not a member of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		a.targets = append(a.targets, m)
+	}
+	return a, nil
+}
+
+func (a *updateRolesAggregate) validate() error { return nil }
+
+func (a *updateRolesAggregate) apply(ctx context.Context, tx DB) error {
+	for _, m := range a.targets {
+		if err := m.setRole(ctx, tx, a.roles[m.UserID]); err != nil {
+			return err
+		}
+	}
+	return nil
+}
