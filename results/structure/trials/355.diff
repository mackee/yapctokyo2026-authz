+// setRolesAggregate changes the roles of several members of one project in one
+// batch. Either every change is applied or none is.
+type setRolesAggregate struct {
+	projectID string
+	changes   []membershipRecord // members with their new roles, sorted by user ID
+	tasks     []taskRecord       // the project's tasks, for the assignee rule
+}
+
+func loadSetRoles(x *tx, projectID string, roles map[string]string) (*setRolesAggregate, error) {
+	if len(roles) == 0 {
+		return nil, deny(ErrInvalid, "roles must not be empty")
+	}
+	userIDs := make([]string, 0, len(roles))
+	for uid := range roles {
+		userIDs = append(userIDs, uid)
+	}
+	sort.Strings(userIDs)
+
+	a := &setRolesAggregate{projectID: projectID, tasks: x.tasksIn(projectID)}
+	for _, uid := range userIDs {
+		m, ok := x.findMembership(projectID, uid)
+		if !ok {
+			return nil, deny(ErrInvalid, "user "+uid+" is not a member of the project")
+		}
+		m.Role = roles[uid]
+		a.changes = append(a.changes, m)
+	}
+	return a, nil
+}
+
+func (a *setRolesAggregate) validate() error {
+	for _, m := range a.changes {
+		if !isValidRole(m.Role) {
+			return deny(ErrInvalid, "role must be manager, contributor or viewer")
+		}
+		// An assignee is a contributor or manager of the task's project, so a
+		// member who still has tasks assigned cannot be demoted to viewer.
+		if !isWriterRole(m.Role) {
+			for _, t := range a.tasks {
+				if t.AssigneeID == m.UserID {
+					return deny(ErrInvalid, "user "+m.UserID+" has tasks assigned and must remain a contributor or manager")
+				}
+			}
+		}
+	}
+	return nil
+}
+
+func (a *setRolesAggregate) save(x *tx) []MemberView {
+	for _, m := range a.changes {
+		m.save(x)
+	}
+	ms := x.membershipsOf(a.projectID)
+	out := make([]MemberView, 0, len(ms))
+	for _, m := range ms {
+		out = append(out, MemberView{UserID: m.UserID, Role: m.Role})
+	}
+	return out
+}
