+	}
+	// And dan is still read-only: creating a task is still 403.
+	code, _ = do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`)
+	if code != 403 {
+		t.Fatalf("dan create: got %d want 403", code)
+	}
+}
