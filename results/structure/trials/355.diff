+func TestSetRolesAllOrNothing(t *testing.T) {
+	srv := newServer()
+	// hal is not a member, so the whole batch must be rejected, including the
+	// valid dan change.
+	code, _ := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","hal":"viewer"}}`)
+	if code != 400 {
+		t.Fatalf("got %d want 400", code)
