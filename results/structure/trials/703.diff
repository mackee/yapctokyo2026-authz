+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ann", 204},
+		{"org admin, user without memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"manager is not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"plain member", "ben", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ann", 401},
+		{"other org's admin", "gus", "/orgs/acme/users/ann", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserDropsMemberships(t *testing.T) {
+	h := newServer()
+	// ann is a member of web, ops and legacy (archived) before removal.
+	for _, p := range []string{"web", "ops", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ann", ""); code != 200 {
+			t.Fatalf("before: %s got %d", p, code)
+		}
+	}
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ann", "eve", ""); code != 204 {
+		t.Fatal(code)
+	}
+	for _, p := range []string{"web", "ops", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ann", ""); code != 404 {
+			t.Fatalf("after: %s got %d want 404", p, code)
+		}
+	}
+	// other members are untouched
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatal(code)
+	}
+}
