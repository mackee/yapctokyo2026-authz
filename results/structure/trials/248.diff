+func TestSetRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager demotes viewer->contributor", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"manager promotes", "ann", "/projects/web/members/ben", `{"role":"manager"}`, 200},
+		{"manager demotes unassigned member", "ann", "/projects/web/members/ivy", `{"role":"viewer"}`, 200},
+		{"contributor", "ben", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"viewer", "dan", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"org admin", "eve", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"non member", "hal", "/projects/web/members/dan", `{"role":"viewer"}`, 404},
+		{"cross org", "gus", "/projects/web/members/dan", `{"role":"viewer"}`, 404},
+		{"anonymous", "", "/projects/web/members/dan", `{"role":"viewer"}`, 401},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"unknown target", "ann", "/projects/web/members/nobody", `{"role":"viewer"}`, 404},
+		{"invalid role", "ann", "/projects/web/members/dan", `{"role":"owner"}`, 400},
+		{"empty role", "ann", "/projects/web/members/dan", `{}`, 400},
+		{"bad body", "ann", "/projects/web/members/dan", `nope`, 400},
+		{"demote assignee to viewer", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetRoleResponseAndEffect(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got struct{ UserID, Role string }
+	if err := json.Unmarshal([]byte(body), &got); err != nil || got.UserID != "dan" || got.Role != "contributor" {
+		t.Fatalf("unexpected body %s", body)
+	}
+	// dan can now write.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 201 {
+		t.Fatalf("dan should be able to create, got %d", code)
+	}
+}
+
+func TestSetRoleKeepsAManager(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ivy", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatal(code)
+	}
+	// ann is now the last manager of web.
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ann", "ann", `{"role":"contributor"}`); code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+}
