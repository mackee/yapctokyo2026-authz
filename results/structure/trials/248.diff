+func updateMemberRole(ctx tanukirpc.Context[*projectRegistry], _ struct{}) (*capability.MemberView, error) {
+	p, err := ctx.Registry().scope.Manage()
+	if err != nil {
+		return nil, err
+	}
+	var req roleRequest
+	if err := decodeBody(ctx.Request(), &req); err != nil {
+		return nil, errInvalidBody
+	}
+	v, err := p.SetRole(chi.URLParam(ctx.Request(), "uid"), req.Role)
+	if err != nil {
+		return nil, err
+	}
+	return &v, nil
