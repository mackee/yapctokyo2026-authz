+func transferUser(ctx tanukirpc.Context[*orgRegistry], req transferRequest) (*transferResponse, error) {
+	reg := ctx.Registry()
+	u, err := model.NewUserTable().Transfer(ctx, reg.db, reg.authz, chi.URLParam(ctx.Request(), "uid"), model.UserTableTransferInput{ToOrg: req.ToOrgID})
+	if err != nil {
+		return nil, err
+	}
+	return &transferResponse{ID: u.ID, OrgID: u.Org}, nil
+}
