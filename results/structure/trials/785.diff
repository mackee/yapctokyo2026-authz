+// removeUserAggregate removes one user from every project of the organization.
+// Tasks assigned to the user are unassigned, since an assignee must be a
+// contributor or manager of the task's project.
+type removeUserAggregate struct {
+	memberships []*Membership
+	tasks       []*Task
+}
+
+func loadRemoveUser(ctx context.Context, tx DB, org, userID string) (*removeUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) || (err == nil && u.Org != org) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	ts, err := u.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &removeUserAggregate{memberships: ms, tasks: ts}, nil
+}
+
+func (a *removeUserAggregate) validate() error { return nil }
+
+func (a *removeUserAggregate) apply(ctx context.Context, tx DB) error {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return err
+		}
+	}
+	return nil
+}
