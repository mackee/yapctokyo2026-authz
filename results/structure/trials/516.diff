+// moveMemberAggregate moves one member from the source project to the
+// destination project, keeping the role.
+type moveMemberAggregate struct {
+	from     *Membership // the member in the source project
+	to       string      // the destination project ID
+	existing *Membership // the member's membership in the destination, if any
+	assigned []*Task     // the member's tasks in the source project
+}
+
+func loadMoveMember(ctx context.Context, tx DB, fromID, userID, toID string) (*moveMemberAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, fromID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveMemberAggregate{from: m, to: toID}
+	existing, err := NewMembershipTable().Find(ctx, tx, toID, userID)
+	if err == nil {
+		a.existing = existing
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	if a.assigned, err = m.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.existing != nil {
+		return deny(ErrConflict, "user is already a member of the destination project")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	// An assignee must be a member of the task's project, so the member's tasks
+	// in the source project are unassigned when the member leaves it.
+	for _, t := range a.assigned {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.from.remove(ctx, tx); err != nil {
+		return nil, err
+	}
+	to := &Membership{ProjectID: a.to, UserID: a.from.UserID, Role: a.from.Role}
+	if err := to.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return to, nil
+}
