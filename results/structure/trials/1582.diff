index 0000000..93b4c3f
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,85 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager removes contributor", "ann", "/projects/web/members/ben", 204},
+		{"manager removes viewer", "ann", "/projects/web/members/dan", 204},
+		{"manager removes self", "ivy", "/projects/web/members/ivy", 204},
+		{"contributor", "ben", "/projects/web/members/cat", 403},
+		{"viewer", "dan", "/projects/web/members/cat", 403},
+		{"org admin", "eve", "/projects/web/members/ben", 403},
+		{"non member actor", "hal", "/projects/web/members/ben", 404},
+		{"other org actor", "gus", "/projects/web/members/ben", 404},
+		{"anonymous", "", "/projects/web/members/ben", 401},
+		{"target not a member", "ann", "/projects/web/members/hal", 404},
+		{"target unknown", "ann", "/projects/web/members/zed", 404},
+		{"target member of other project only", "ann", "/projects/web/members/gus", 404},
+		{"archived", "ann", "/projects/legacy/members/ben", 409},
+		{"missing project", "ann", "/projects/nope/members/ben", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveMemberTwice(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 204 {
+		t.Fatalf("first: got %d", code)
+	}
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 404 {
+		t.Fatalf("second: got %d", code)
+	}
+}
+
+// The removed user loses access, keeps nothing assigned in the project, and
+// other projects and members are untouched.
+func TestRemoveMemberEffects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/cat", "ann", ""); code != 204 {
+		t.Fatalf("got %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 404 {
+		t.Fatalf("removed member still reads web: %d", code)
+	}
+	// cat's own membership of ops is untouched, and so is the task assigned there.
+	code, body := do(t, h, "GET", "/projects/ops/tasks/t4", "cat", "")
+	if code != 200 {
+		t.Fatalf("ops: got %d", code)
+	}
+	var t4 Task
+	json.Unmarshal([]byte(body), &t4)
+	if t4.AssigneeID != "cat" {
+		t.Fatalf("ops task t4 assignee = %q, want cat", t4.AssigneeID)
+	}
+	// cat's web task is unassigned; other tasks keep their assignees.
+	code, body = do(t, h, "GET", "/projects/web/tasks", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d", code)
+	}
+	var tasks []Task
+	json.Unmarshal([]byte(body), &tasks)
+	want := map[string]string{"t1": "ben", "t2": "", "t3": ""}
+	for _, task := range tasks {
+		if task.AssigneeID != want[task.ID] {
+			t.Errorf("task %s assignee = %q, want %q", task.ID, task.AssigneeID, want[task.ID])
+		}
+	}
+	// other members stay.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben lost access: %d", code)
+	}
+}
