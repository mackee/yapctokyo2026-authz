+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes", "eve", "/orgs/acme/users/ann", 204},
+		{"org admin removes user without roles", "eve", "/orgs/acme/users/hal", 204},
+		{"manager not admin", "ann", "/orgs/acme/users/ben", 403},
+		{"contributor not admin", "ben", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ann", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ann", 401},
+		{"other org path", "eve", "/orgs/globex/users/gus", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserDropsAllMemberships(t *testing.T) {
+	h := newServer()
+	// ann is a member of web, ops and legacy (archived).
+	for _, p := range []string{"web", "ops", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ann", ""); code != 200 {
+			t.Fatalf("before: %s got %d", p, code)
+		}
+	}
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ann", "eve", ""); code != 204 {
+		t.Fatalf("remove got %d", code)
+	}
+	for _, p := range []string{"web", "ops", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ann", ""); code != 404 {
+			t.Fatalf("after: %s got %d want 404", p, code)
+		}
+	}
+	// Other members and other orgs are untouched.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben got %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatalf("gus got %d", code)
+	}
+}
