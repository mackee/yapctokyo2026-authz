new file mode 100644
index 0000000..a37d9d7
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,113 @@
+package main
+
+import (
+	"encoding/json"
+	"reflect"
+	"testing"
+)
+
+func TestSetMemberRolesAccess(t *testing.T) {
+	const body = `{"roles":{"ivy":"contributor"}}`
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager", "ann", "/projects/web/members", 200},
+		{"contributor", "ben", "/projects/web/members", 403},
+		{"viewer", "dan", "/projects/web/members", 403},
+		{"org admin", "eve", "/projects/web/members", 403},
+		{"non member", "hal", "/projects/web/members", 404},
+		{"other org", "gus", "/projects/web/members", 404},
+		{"anonymous", "", "/projects/web/members", 401},
+		{"unknown user", "zed", "/projects/web/members", 401},
+		{"missing project", "ann", "/projects/nope/members", 404},
+		{"archived", "ann", "/projects/legacy/members", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMemberRolesValidation(t *testing.T) {
+	cases := []struct {
+		name, body string
+	}{
+		{"not json", `{"roles":`},
+		{"missing roles", `{}`},
+		{"empty roles", `{"roles":{}}`},
+		{"invalid role", `{"roles":{"ivy":"admin"}}`},
+		{"not a member", `{"roles":{"hal":"viewer"}}`},
+		{"unknown user", `{"roles":{"zed":"viewer"}}`},
+		{"demote assigned member", `{"roles":{"ben":"viewer"}}`},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/web/members", "ann", c.body)
+			if code != 400 {
+				t.Fatalf("got %d want 400", code)
+			}
+		})
+	}
+}
+
+// Full bulk change with a valid request: the response is the whole member
+// list after the change, sorted by userId.
+func TestSetMemberRolesResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","ivy":"viewer"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []memberRole
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []memberRole{
+		{"ann", "manager"},
+		{"ben", "contributor"},
+		{"cat", "contributor"},
+		{"dan", "contributor"},
+		{"ivy", "viewer"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+}
+
+// One bad entry rejects the whole request: the valid change in the same
+// request must not be applied, and a later request sees the old role.
+func TestSetMemberRolesAllOrNothing(t *testing.T) {
+	srv := newServer()
+
+	// ben is assigned t1, so demoting him is rejected; dan's change must not stick.
+	code, _ := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+
+	code, body := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"ivy":"manager"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []memberRole
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	for _, m := range got {
+		if m.UserID == "dan" && m.Role != "viewer" {
+			t.Fatalf("dan changed despite rejected request: %s", m.Role)
+		}
+	}
+}
+
+// A viewer demotion is fine once the member has no tasks in the project.
+func TestSetMemberRolesDemoteUnassigned(t *testing.T) {
+	code, _ := do(t, newServer(), "PUT", "/projects/web/members", "ann", `{"roles":{"ivy":"viewer"}}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+}
