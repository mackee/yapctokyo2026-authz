+type membersRequest struct {
+	Roles map[string]string `json:"roles"`
+}
+
+// updateMembers changes several members' roles at once. Every change is
+// validated before any is applied, so a failure leaves all roles untouched.
+func (s *server) updateMembers(w http.ResponseWriter, r *http.Request) {
+	s.store.mu.Lock()
+	defer s.store.mu.Unlock()
+
+	user := s.store.User(r.Header.Get("X-User"))
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project := s.store.Project(r.PathValue("pid"))
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role := s.store.Role(project.ID, user.ID)
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "only managers may change member roles")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req membersRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || len(req.Roles) == 0 {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+
+	// Validate in sorted order so the reported error is deterministic.
+	userIDs := make([]string, 0, len(req.Roles))
+	for uid := range req.Roles {
+		userIDs = append(userIDs, uid)
+	}
+	sort.Strings(userIDs)
+	for _, uid := range userIDs {
+		newRole := req.Roles[uid]
+		if newRole != RoleManager && newRole != RoleContributor && newRole != RoleViewer {
+			writeError(w, 400, "invalid role for "+uid)
+			return
+		}
+		if s.store.Role(project.ID, uid) == "" {
+			writeError(w, 404, uid+" is not a member of the project")
+			return
+		}
+	}
+
+	// The project must keep at least one manager after the change.
+	managers := 0
+	for _, m := range s.store.MembersInProject(project.ID) {
+		effective := m.Role
+		if newRole, ok := req.Roles[m.UserID]; ok {
+			effective = newRole
+		}
+		if effective == RoleManager {
+			managers++
+		}
+	}
+	if managers == 0 {
+		writeError(w, 409, "project must keep at least one manager")
+		return
+	}
+
+	for _, uid := range userIDs {
+		s.store.SetRole(project.ID, uid, req.Roles[uid])
+	}
+	writeJSON(w, 200, s.store.MembersInProject(project.ID))
+}
