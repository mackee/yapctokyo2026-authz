+func TestUpdateMembers(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager batch", "ann", "web", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 200},
+		{"manager self demote with other manager", "ann", "web", `{"roles":{"ann":"contributor"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"ben":"viewer"}}`, 403},
+		{"org admin without role", "eve", "web", `{"roles":{"ben":"viewer"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"ben":"viewer"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"ben":"viewer"}}`, 404},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"unknown target user", "ann", "web", `{"roles":{"zed":"viewer"}}`, 404},
+		{"non member target", "ann", "web", `{"roles":{"hal":"viewer"}}`, 404},
+		{"invalid role", "ann", "web", `{"roles":{"ben":"owner"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"malformed body", "ann", "web", `{"roles":`, 400},
+		{"demote all managers", "ann", "web", `{"roles":{"ann":"viewer","ivy":"contributor"}}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMembersAnonymous(t *testing.T) {
+	code, _ := do(t, newServer(), "PUT", "/projects/web/members", "", `{"roles":{"ben":"viewer"}}`)
+	if code != 401 {
+		t.Fatalf("got %d want 401", code)
+	}
+}
+
+func TestUpdateMembersResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann",
+		`{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []Member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []Member{
+		{UserID: "ann", Role: "manager"},
+		{UserID: "ben", Role: "viewer"},
+		{UserID: "cat", Role: "contributor"},
+		{UserID: "dan", Role: "contributor"},
+		{UserID: "ivy", Role: "manager"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %d members, want %d: %s", len(got), len(want), body)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("member %d: got %+v want %+v", i, got[i], want[i])
+		}
+	}
+}
+
+func TestUpdateMembersIsAllOrNothing(t *testing.T) {
+	h := newServer()
+	// hal is not a member, so the whole batch must be rejected...
+	code, _ := do(t, h, "PUT", "/projects/web/members", "ann",
+		`{"roles":{"ben":"viewer","hal":"viewer"}}`)
+	if code != 404 {
+		t.Fatalf("got %d want 404", code)
+	}
+	// ...and ben's role must be unchanged, as shown by a later successful call.
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"cat":"viewer"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []Member
+	json.Unmarshal([]byte(body), &got)
+	for _, m := range got {
+		if m.UserID == "ben" && m.Role != "contributor" {
+			t.Fatalf("ben changed despite failed batch: %+v", m)
+		}
+	}
+}
