+// Member is one project membership as returned by the members API.
+type Member struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// MembersInProject returns the project's members sorted by user ID.
+func (s *Store) MembersInProject(projectID string) []Member {
+	out := []Member{}
+	for uid, role := range s.members[projectID] {
+		out = append(out, Member{UserID: uid, Role: role})
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].UserID < out[j].UserID })
+	return out
+}
+
+func (s *Store) SetRole(projectID, userID, role string) { s.members[projectID][userID] = role }
