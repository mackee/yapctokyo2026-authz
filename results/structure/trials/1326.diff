+
+type moveRequest struct {
+	ToProjectID string `json:"toProjectId"`
+}
+
+type moveResponse struct {
+	UserID    string `json:"userId"`
+	ProjectID string `json:"projectId"`
+	Role      string `json:"role"`
+}
+
+// moveMember takes the member {uid} out of the path project and adds them to
+// toProjectId with the same role. Only managers of both projects may do this.
+func (s *server) moveMember(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role, err := findRole(ctx, s.db, project.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req moveRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || req.ToProjectID == "" {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	if req.ToProjectID == project.ID {
+		writeError(w, 400, "toProjectId must differ from the project")
+		return
+	}
+	target, err := findProject(ctx, s.db, req.ToProjectID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if target == nil || target.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	targetRole, err := findRole(ctx, s.db, target.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if targetRole == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if targetRole != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if target.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	memberID := r.PathValue("uid")
+	memberRole, err := findRole(ctx, s.db, project.ID, memberID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if memberRole == "" {
+		writeError(w, 404, "not a member of the project")
+		return
+	}
+	existing, err := findRole(ctx, s.db, target.ID, memberID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if existing != "" {
+		writeError(w, 409, "already a member of the target project")
+		return
+	}
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+	if _, err := tx.ExecContext(ctx, `DELETE FROM memberships WHERE project_id = ? AND user_id = ?`, project.ID, memberID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if _, err := tx.ExecContext(ctx, `INSERT INTO memberships (project_id, user_id, role) VALUES (?, ?, ?)`, target.ID, memberID, memberRole); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	// The member no longer belongs to the source project, so their tasks there
+	// become unassigned.
+	if _, err := tx.ExecContext(ctx, `UPDATE tasks SET assignee = '' WHERE project_id = ? AND assignee = ?`, project.ID, memberID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, moveResponse{UserID: memberID, ProjectID: target.ID, Role: memberRole})
+}
diff --git a/move_test.go b/move_test.go
new file mode 100644
index 0000000..ce21202
--- /dev/null
+++ b/move_test.go
@@ -0,0 +1,119 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestMoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager of both moves", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 200},
+		{"archived target", "ann", "/projects/web/members/ben/move", `{"toProjectId":"legacy"}`, 409},
+		{"viewer of target", "ann", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"contributor of source", "ben", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer of source", "dan", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin", "eve", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"non member of source", "hal", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"other org target", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"gx"}`, 404},
+		{"missing target", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"missing"}`, 404},
+		{"target caller cannot read", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"legacy"}`, 404},
+		{"same project", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"web"}`, 400},
+		{"missing toProjectId", "ivy", "/projects/web/members/ben/move", `{}`, 400},
+		{"bad body", "ivy", "/projects/web/members/ben/move", `not json`, 400},
+		{"subject not a member", "ivy", "/projects/web/members/hal/move", `{"toProjectId":"ops"}`, 404},
+		{"already in target", "ivy", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 409},
+		{"archived source", "ann", "/projects/legacy/members/ben/move", `{"toProjectId":"web"}`, 409},
+		{"archived target", "ann", "/projects/web/members/dan/move", `{"toProjectId":"legacy"}`, 409},
+		{"anonymous", "", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 401},
+		{"unknown user", "zed", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveMemberResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]string{"userId": "ben", "projectId": "ops", "role": "contributor"}
+	for k, v := range want {
+		if got[k] != v {
+			t.Fatalf("%s: got %q want %q (body %s)", k, got[k], v, body)
+		}
+	}
+}
+
+func TestMoveMemberEffects(t *testing.T) {
+	srv := newServer()
+
+	if code, body := do(t, srv, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`); code != 200 {
+		t.Fatalf("move: got %d: %s", code, body)
+	}
+
+	// ben keeps the contributor role in ops, so they can create tasks there.
+	if code, body := do(t, srv, "POST", "/projects/ops/tasks", "ben", `{"title":"x","assignee":"ben"}`); code != 200 {
+		t.Fatalf("ben create in ops: got %d: %s", code, body)
+	}
+
+	// ben is no longer a member of web.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben list web: got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 404 {
+		t.Fatalf("ben patch web: got %d want 404", code)
+	}
+
+	// t1 was assigned to ben in web and is now unassigned; other tasks keep their assignee.
+	code, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ivy", "")
+	if code != 200 {
+		t.Fatalf("get t1: got %d", code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.Assignee != "" {
+		t.Fatalf("t1 assignee: got %q want unassigned", task.Assignee)
+	}
+	code, body = do(t, srv, "GET", "/projects/web/tasks/t2", "ivy", "")
+	if code != 200 {
+		t.Fatalf("get t2: got %d", code)
+	}
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.Assignee != "cat" {
+		t.Fatalf("t2 assignee: got %q want cat", task.Assignee)
+	}
+
+	// Moving ben out of web does not touch their legacy task t5.
+	code, body = do(t, srv, "GET", "/projects/legacy/tasks/t5", "ann", "")
+	if code != 200 {
+		t.Fatalf("get t5: got %d", code)
+	}
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.Assignee != "ben" {
+		t.Fatalf("t5 assignee: got %q want ben", task.Assignee)
+	}
+
+	// A second move of the same member from web now fails: they are gone from web.
+	if code, _ := do(t, srv, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`); code != 404 {
+		t.Fatalf("second move: got %d want 404", code)
+	}
+}
