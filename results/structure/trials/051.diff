+// Member is a project member and their role, as returned by the members API.
+type Member struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// ProjectMembers returns the members of a project sorted by user ID.
+func (s *Store) ProjectMembers(projectID string) []Member {
+	out := []Member{}
+	for uid, role := range s.members[projectID] {
+		out = append(out, Member{UserID: uid, Role: role})
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].UserID < out[j].UserID })
+	return out
+}
+
+// SetRole changes the role of an existing project member. The caller must
+// have verified that userID is a member of projectID.
+func (s *Store) SetRole(projectID, userID, role string) { s.members[projectID][userID] = role }
