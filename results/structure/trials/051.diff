+func TestUpdateMembers(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager changes roles", "ann", "web", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 200},
+		{"manager promotes viewer", "ivy", "web", `{"roles":{"dan":"manager"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"ben":"viewer"}}`, 403},
+		{"org admin is not manager", "eve", "web", `{"roles":{"ben":"viewer"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"ben":"viewer"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"ben":"viewer"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"ben":"viewer"}}`, 401},
+		{"unknown user", "zed", "web", `{"roles":{"ben":"viewer"}}`, 401},
+		{"missing project", "ann", "nope", `{"roles":{"ben":"viewer"}}`, 404},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"invalid role", "ann", "web", `{"roles":{"ben":"owner"}}`, 400},
+		{"target not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"bad json", "ann", "web", `{"roles":`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMembersResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann",
+		`{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []Member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []Member{
+		{UserID: "ann", Role: "manager"},
+		{UserID: "ben", Role: "viewer"},
+		{UserID: "cat", Role: "contributor"},
+		{UserID: "dan", Role: "contributor"},
+		{UserID: "ivy", Role: "manager"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %d members, want %d: %s", len(got), len(want), body)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("member %d: got %+v want %+v", i, got[i], want[i])
+		}
+	}
+}
+
+func TestUpdateMembersPersists(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer"}}`); code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	// Ben is now a viewer, so he can no longer create tasks.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Fatalf("demoted ben create: got %d want 403", code)
+	}
+}
+
+func TestUpdateMembersAllOrNothing(t *testing.T) {
+	h := newServer()
+	// dan is a valid target, but hal is not a member, so the whole request fails.
+	if code, _ := do(t, h, "PUT", "/projects/web/members", "ann",
+		`{"roles":{"dan":"contributor","hal":"viewer"}}`); code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	// An invalid role on one entry also fails the whole request.
+	if code, _ := do(t, h, "PUT", "/projects/web/members", "ann",
+		`{"roles":{"dan":"contributor","ben":"owner"}}`); code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	// Nothing changed: dan is still a viewer and ben still a contributor.
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ann":"manager"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []Member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	roles := map[string]string{}
+	for _, m := range got {
+		roles[m.UserID] = m.Role
+	}
+	if roles["dan"] != "viewer" || roles["ben"] != "contributor" {
+		t.Fatalf("partial update applied: %v", roles)
+	}
+}
