+func TestSetMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager promotes", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"manager demotes", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 200},
+		{"contributor forbidden", "ben", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"viewer forbidden", "dan", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"org admin forbidden", "eve", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"non member caller", "hal", "/projects/web/members/dan", `{"role":"viewer"}`, 404},
+		{"other org caller", "gus", "/projects/web/members/dan", `{"role":"viewer"}`, 404},
+		{"target not member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"missing project", "ann", "/projects/nope/members/dan", `{"role":"viewer"}`, 404},
+		{"unknown user", "nobody", "/projects/web/members/dan", `{"role":"viewer"}`, 401},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"invalid role", "ann", "/projects/web/members/dan", `{"role":"boss"}`, 400},
+		{"bad body", "ann", "/projects/web/members/dan", `nope`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMemberRoleEffects(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["userId"] != "dan" || got["role"] != "contributor" {
+		t.Fatalf("unexpected response %v", got)
+	}
+	// dan can now write.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("dan create got %d", code)
+	}
+	// Demoting ben (assigned t1) to viewer unassigns his tasks and blocks writes.
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote got %d", code)
+	}
+	_, task := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if !strings.Contains(task, `"assignee":""`) {
+		t.Fatalf("t1 should be unassigned: %s", task)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"y"}`); code != 403 {
+		t.Fatalf("ben create got %d", code)
+	}
+	// His role in another project is untouched (legacy is archived => 409).
+	if code, _ := do(t, h, "PATCH", "/projects/legacy/tasks/t5", "ben", `{"status":"done"}`); code != 409 {
+		t.Fatalf("ben legacy got %d", code)
+	}
+}
