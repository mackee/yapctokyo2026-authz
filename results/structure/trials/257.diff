@@ -111,6 +111,66 @@ func (a *Authorizer) Authenticate(userID string) (ActorScope, error) {
 type ActorScope interface {
 	Actor() Actor
 	Project(projectID string) ProjectScope
+	Org(orgID string) OrgScope
+}
+
+// OrgScope is bound to one actor and one organization ID. It grants nothing by
+// itself; call Admin to acquire a capability.
+type OrgScope interface {
+	Admin() (AdminOrg, error)
+}
+
+// AdminOrg is the org-admin capability for one organization.
+type AdminOrg interface {
+	// RemoveUser removes a user from every project of the organization
+	// (offboarding), including archived ones, and unassigns their tasks.
+	// A user who is not in the organization is 404.
+	RemoveUser(userID string) error
+}
+
+type orgScope struct {
+	as  *actorScope
+	oid string
+}
+
+func (s *actorScope) Org(orgID string) OrgScope { return &orgScope{as: s, oid: orgID} }
+
+// Admin applies the org-admin rule: the organization is the actor's own (else
+// 404) and the actor is an org admin of it (else 403).
+func (s *orgScope) Admin() (AdminOrg, error) {
+	act := s.as.actor
+	if s.oid != act.org {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if !act.orgAdmin {
+		return nil, deny(ErrForbidden, "forbidden")
+	}
+	return &adminOrg{os: s}, nil
+}
+
+type adminOrg struct{ os *orgScope }
+
+func (o *adminOrg) RemoveUser(userID string) error {
+	return o.os.as.a.st.tx(func(s *state) error {
+		if u, ok := s.users[userID]; !ok || u.org != o.os.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		for pid, m := range s.members {
+			if s.projects[pid].org != o.os.oid {
+				continue
+			}
+			delete(m, userID)
+		}
+		// Tasks assigned to the removed user become unassigned, which the
+		// model requires (an assignee must be a project writer).
+		for id, t := range s.tasks {
+			if t.assignee.user == userID {
+				t.assignee = Assignee{project: t.project}
+				s.tasks[id] = t
+			}
+		}
+		return nil
+	})
 }
 
