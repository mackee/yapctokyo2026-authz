+// setRoleAggregate changes one member's role in one project.
+type setRoleAggregate struct {
+	member *Membership
+	role   string
+	tasks  []*Task // member.AssignedTasks: they must stay assigned to a contributor or manager
+}
+
+func loadSetRole(ctx context.Context, tx DB, projectID, userID, role string) (*setRoleAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	tasks, err := m.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &setRoleAggregate{member: m, role: role, tasks: tasks}, nil
+}
+
+func (a *setRoleAggregate) validate() error {
+	if !validRoles[a.role] {
+		return deny(ErrInvalid, "invalid role")
+	}
+	if !isWriterRole(a.role) && len(a.tasks) > 0 {
+		return deny(ErrInvalid, "member has assigned tasks; reassign them before making the member a viewer")
+	}
+	return nil
+}
+
+func (a *setRoleAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.member.setRole(ctx, tx, a.role); err != nil {
+		return nil, err
+	}
+	return a.member, nil
+}
