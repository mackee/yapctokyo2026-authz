+// ---- operations -----------------------------------------------------------------------
+
+// RemoveFromOrg removes the user from every project of the organization (for
+// example when the user leaves the company), all or nothing. The user row
+// itself is kept. Tasks the user is assigned to in those projects are
+// unassigned, since an assignee must be a member of the task's project.
+// Archived projects are included. Removing a user who is in no project is a
+// no-op.
+func (*UserTable) RemoveFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanRemoveMembers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveOrgUser(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
