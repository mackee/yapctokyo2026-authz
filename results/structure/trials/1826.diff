diff --git a/org_test.go b/org_test.go
new file mode 100644
index 0000000..379363a
--- /dev/null
+++ b/org_test.go
@@ -0,0 +1,131 @@
+package main
+
+import (
+	"net/http"
+	"testing"
+)
+
+// membershipsOf returns the projects the user is a member of, read straight
+// from the database behind h.
+func membershipsOf(t *testing.T, h http.Handler, userID string) []string {
+	t.Helper()
+	app, ok := h.(*appHandler)
+	if !ok {
+		t.Fatalf("membershipsOf: %T is not the handler built by newServer", h)
+	}
+	rows, err := app.db.Query(`SELECT project_id FROM memberships WHERE user_id = ? ORDER BY project_id`, userID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer rows.Close()
+	var out []string
+	for rows.Next() {
+		var pid string
+		if err := rows.Scan(&pid); err != nil {
+			t.Fatal(err)
+		}
+		out = append(out, pid)
+	}
+	if err := rows.Err(); err != nil {
+		t.Fatal(err)
+	}
+	return out
+}
+
+// assigneeOf returns the assignee of the task, read straight from the database.
+func assigneeOf(t *testing.T, h http.Handler, taskID string) string {
+	t.Helper()
+	app := h.(*appHandler)
+	var assignee string
+	if err := app.db.QueryRow(`SELECT assignee FROM tasks WHERE id = ?`, taskID).Scan(&assignee); err != nil {
+		t.Fatal(err)
+	}
+	return assignee
+}
+
+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes manager", "eve", "/orgs/acme/users/ann", 204},
+		{"org admin removes user without roles", "eve", "/orgs/acme/users/hal", 204},
+		{"org admin removes user again", "eve", "/orgs/acme/users/hal", 204},
+		{"unknown user", "eve", "/orgs/acme/users/zed", 404},
+		{"user of another org", "eve", "/orgs/acme/users/gus", 404},
+		{"caller is a member, not an admin", "ann", "/orgs/acme/users/ben", 403},
+		{"caller is a viewer", "dan", "/orgs/acme/users/ben", 403},
+		{"caller of another org", "gus", "/orgs/acme/users/ben", 404},
+		{"org admin asks for another org", "eve", "/orgs/globex/users/gus", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ben", 404},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserRemovesAllMemberships(t *testing.T) {
+	h := newServer()
+	if got := membershipsOf(t, h, "ben"); len(got) != 2 {
+		t.Fatalf("seed: ben should be in 2 projects, got %v", got)
+	}
+
+	if code, body := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("got %d want 204: %s", code, body)
+	}
+
+	// Every project of the org, archived ones included: ben is in web and legacy.
+	if got := membershipsOf(t, h, "ben"); len(got) != 0 {
+		t.Fatalf("ben still a member of %v", got)
+	}
+	// Other members are untouched.
+	if got := membershipsOf(t, h, "cat"); len(got) != 2 {
+		t.Fatalf("cat's memberships changed: %v", got)
+	}
+	if got := membershipsOf(t, h, "ann"); len(got) != 3 {
+		t.Fatalf("ann's memberships changed: %v", got)
+	}
+}
+
+func TestRemoveOrgUserUnassignsTasks(t *testing.T) {
+	h := newServer()
+	// ben is assigned t1 (web) and t5 (legacy); cat keeps t2 and t4.
+	if code, body := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("got %d want 204: %s", code, body)
+	}
+	if got := assigneeOf(t, h, "t1"); got != "" {
+		t.Fatalf("t1 still assigned to %q", got)
+	}
+	if got := assigneeOf(t, h, "t5"); got != "" {
+		t.Fatalf("t5 still assigned to %q", got)
+	}
+	if got := assigneeOf(t, h, "t2"); got != "cat" {
+		t.Fatalf("t2 assignee changed to %q", got)
+	}
+}
+
+func TestRemoveOrgUserLocksOutProjects(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("got %d want 204: %s", code, body)
+	}
+	// ben is no longer a member of web, and not an org admin, so web is hidden.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads web: got %d want 404", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/legacy/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads legacy: got %d want 404", code)
+	}
+	// Other users are unaffected.
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "eve", ""); code != 200 {
+		t.Fatalf("eve reads ops: got %d want 200", code)
+	}
+}
