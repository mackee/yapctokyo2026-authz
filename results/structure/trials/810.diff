+type moveRequest struct {
+	ToProjectID string `json:"toProjectId"`
+}
+
+// isWriter reports whether a project role may modify tasks.
+func isWriter(role string) bool {
+	return role == RoleManager || role == RoleContributor
+}
+
+func (s *server) moveTask(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	src, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if src == nil || src.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	srcRole, err := findRole(ctx, s.db, src.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if srcRole == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	task, err := findTask(ctx, s.db, r.PathValue("tid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if task == nil || task.ProjectID != src.ID {
+		writeError(w, 404, "not found")
+		return
+	}
+	var req moveRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || req.ToProjectID == "" {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	dst, err := findProject(ctx, s.db, req.ToProjectID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if dst == nil || dst.OrgID != user.OrgID {
+		writeError(w, 404, "destination project not found")
+		return
+	}
+	dstRole, err := findRole(ctx, s.db, dst.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if dstRole == "" && !user.OrgAdmin {
+		writeError(w, 404, "destination project not found")
+		return
+	}
+	if !isWriter(srcRole) || !isWriter(dstRole) {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	bothManagers := srcRole == RoleManager && dstRole == RoleManager
+	if !bothManagers && task.Assignee != user.ID {
+		writeError(w, 403, "only managers of both projects may move tasks not assigned to them")
+		return
+	}
+	if src.Archived || dst.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	if dst.ID == src.ID {
+		writeError(w, 400, "task is already in that project")
+		return
+	}
+	if _, err := s.db.ExecContext(ctx, `UPDATE tasks SET project_id = ? WHERE id = ?`, dst.ID, task.ID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	task.ProjectID = dst.ID
+	writeJSON(w, 200, task)
+}
