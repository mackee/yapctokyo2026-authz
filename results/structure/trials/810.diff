+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"contributor own, both contributors", "cat", "/projects/web/tasks/t2/move", `{"toProjectId":"ops"}`, 200},
+		{"contributor others", "cat", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"manager of both, any task", "ivy", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 200},
+		{"manager src, viewer dest", "ann", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"contributor src, non member dest", "ben", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 404},
+		{"org admin", "eve", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"non member source", "hal", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 401},
+		{"unknown user", "zed", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 401},
+		{"task not in source", "ivy", "/projects/web/tasks/t4/move", `{"toProjectId":"ops"}`, 404},
+		{"missing dest", "ivy", "/projects/web/tasks/t1/move", `{"toProjectId":"nope"}`, 404},
+		{"cross org dest", "ann", "/projects/web/tasks/t1/move", `{"toProjectId":"gx"}`, 404},
+		{"archived dest", "ann", "/projects/web/tasks/t1/move", `{"toProjectId":"legacy"}`, 409},
+		{"archived source", "ann", "/projects/legacy/tasks/t5/move", `{"toProjectId":"web"}`, 409},
+		{"same project", "ivy", "/projects/web/tasks/t1/move", `{"toProjectId":"web"}`, 400},
+		{"empty dest", "ivy", "/projects/web/tasks/t1/move", `{}`, 400},
+		{"bad body", "ivy", "/projects/web/tasks/t1/move", `not json`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsTaskFields(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/tasks/t2/move", "cat", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d: %s", code, body)
+	}
+	var moved Task
+	if err := json.Unmarshal([]byte(body), &moved); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", Assignee: "cat"}
+	if moved != want {
+		t.Fatalf("moved task = %+v, want %+v", moved, want)
+	}
+
+	code, body = do(t, h, "GET", "/projects/ops/tasks/t2", "ivy", "")
+	if code != 200 || !strings.Contains(body, `"projectId":"ops"`) {
+		t.Fatalf("get in dest: got %d: %s", code, body)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t2", "ann", ""); code != 404 {
+		t.Fatalf("task still readable in source: got %d", code)
+	}
+}
