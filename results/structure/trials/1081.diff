+func TestMoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager of both", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 200},
+		{"manager of source only", "ann", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"contributor", "ben", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer", "dan", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin without role", "eve", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"non member actor", "hal", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"user not in source", "ivy", "/projects/web/members/hal/move", `{"toProjectId":"ops"}`, 404},
+		{"same project", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"web"}`, 400},
+		{"missing destination", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"nope"}`, 404},
+		{"destination in other org", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"gx"}`, 404},
+		{"destination archived", "ann", "/projects/web/members/dan/move", `{"toProjectId":"legacy"}`, 409},
+		{"source archived", "ann", "/projects/legacy/members/ben/move", `{"toProjectId":"ops"}`, 409},
+		{"already in destination", "ivy", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 400},
+		{"empty destination", "ivy", "/projects/web/members/ben/move", `{"toProjectId":""}`, 400},
+		{"malformed body", "ivy", "/projects/web/members/ben/move", `{"toProjectId":`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestMoveMemberEffects(t *testing.T) {
+	srv := newServer()
+	code, body := do(t, srv, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got struct {
+		UserID    string `json:"userId"`
+		ProjectID string `json:"projectId"`
+		Role      string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.UserID != "ben" || got.ProjectID != "ops" || got.Role != "contributor" {
+		t.Fatalf("unexpected response %s", body)
+	}
+	// ben left web: no longer a member, so web is unreadable for ben.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads web after move: got %d want 404", code)
+	}
+	// ben's task in web is released (an assignee must be a member of the task's project).
+	code, body = do(t, srv, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 || !strings.Contains(body, `"assignee":""`) {
+		t.Fatalf("t1 after move: got %d body=%s", code, body)
+	}
+	// ben joined ops with the same role: contributors may create there.
+	if code, body := do(t, srv, "POST", "/projects/ops/tasks", "ben", `{"title":"x","assignee":"ben"}`); code != 200 {
+		t.Fatalf("ben writes ops after move: got %d body=%s", code, body)
+	}
+}
+
