+// MembershipTableMoveInput is the input of MembershipTable.Move.
+type MembershipTableMoveInput struct {
+	UserID      string
+	ToProjectID string
+}
+
+// Move moves the user's membership from the authorized project to another
+// project, keeping the role. The actor must be a manager of both projects, and
+// neither may be archived. All or nothing.
+func (*MembershipTable) Move(ctx context.Context, db DB, authz ProjectAuthz, in MembershipTableMoveInput) (*Membership, error) {
+	if err := authz.CanMoveMembers(); err != nil {
+		return nil, err
+	}
+	if in.ToProjectID == authz.ProjectID() {
+		return nil, deny(ErrInvalid, "destination must be a different project")
+	}
+	// Unreadable destinations are 404 here; the actor must also manage them.
+	dest, err := NewProjectAuthz(ctx, db, authz.Actor(), in.ToProjectID)
+	if err != nil {
+		return nil, err
+	}
+	if err := dest.CanMoveMembers(); err != nil {
+		return nil, err
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveMember(ctx, tx, authz.ProjectID(), in.UserID, in.ToProjectID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if m, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
