+// MemberView is the public representation of a project member.
+type MemberView struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// ManageProject is the manager-only capability for one project.
+type ManageProject interface {
+	ReadProject
+	// Freeze moves every member of the project to the viewer role, managers
+	// included. Nobody can write the project's tasks afterwards, because
+	// writes require a contributor or manager role. It returns the members
+	// after the change, ordered by user ID.
+	Freeze() ([]MemberView, error)
+}
+
+type manageProject struct{ readProject }
+
+func (p *manageProject) Freeze() ([]MemberView, error) {
+	var out []MemberView
+	err := p.ps.as.a.db.update(func(x *tx) error {
+		agg, err := loadFreezeProject(x, p.ps.pid)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		out = agg.apply(x)
+		return nil
+	})
+	return out, err
+}
