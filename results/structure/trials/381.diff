 func (a *deleteTaskAggregate) apply(x *tx) { a.task.Destroy(x) }
+
+// freezeProjectAggregate moves every member of one project to the viewer role.
+type freezeProjectAggregate struct {
+	project projectRecord
+	members []membershipRecord
+}
+
+func loadFreezeProject(x *tx, projectID string) (*freezeProjectAggregate, error) {
+	p, ok := x.findProject(projectID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	return &freezeProjectAggregate{project: p, members: p.Memberships(x)}, nil
+}
+
+// validate has nothing to check: lowering every member to viewer admits no
+// assignee and moves no user out of the project's organization.
+func (a *freezeProjectAggregate) validate() error { return nil }
+
+func (a *freezeProjectAggregate) apply(x *tx) []MemberView {
+	out := []MemberView{}
+	for _, m := range a.members {
+		m.ChangeRole(x, RoleViewer)
+		out = append(out, MemberView{UserID: m.UserID, Role: RoleViewer})
+	}
+	return out
+}
