+func TestRemoveMemberUnassignsTasksAndRevokesAccess(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 204 {
+		t.Fatalf("remove: got %d body=%s", code, body)
+	}
+	// ben's task in web (t1) stays, unassigned.
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("get task: got %d body=%s", code, body)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "" {
+		t.Fatalf("task still assigned to %q", task.AssigneeID)
+	}
+	// ben is no longer a member: no access to web, and removing again is 404.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("removed member reads project: got %d want 404", code)
+	}
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 404 {
+		t.Fatalf("second remove: got %d want 404", code)
+	}
+	// ben's membership in legacy is untouched.
+	if code, _ := do(t, h, "GET", "/projects/legacy/tasks", "ben", ""); code != 200 {
+		t.Fatalf("other project: got %d want 200", code)
+	}
+}
