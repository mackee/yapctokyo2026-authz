+// ---- organization capabilities -------------------------------------------------
+
+type orgScope struct {
+	as  *actorScope
+	oid string
+}
+
+// Manage applies the organization admin rule: the organization must be the
+// actor's own (else 404), and the actor must be an org admin of it (else 403).
+func (s *orgScope) Manage() (ManageOrg, error) {
+	act := s.as.actor
+	if act.org != s.oid {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if !act.orgAdmin {
+		return nil, deny(ErrForbidden, "forbidden")
+	}
+	return &manageOrg{os: s}, nil
+}
+
+// ManageOrg is the org-admin capability for one organization.
+type ManageOrg interface {
+	// RemoveUser takes the user out of every project of the organization, for
+	// offboarding. Tasks assigned to the user in those projects are unassigned.
+	// The user itself is kept. A user who is not in this organization is 404.
+	RemoveUser(userID string) error
+}
+
+type manageOrg struct{ os *orgScope }
+
+func (m *manageOrg) RemoveUser(userID string) error {
+	return m.os.as.a.db.update(func(x *tx) error {
+		agg, err := loadRemoveUser(x, m.os.oid, userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		agg.save(x)
+		return nil
+	})
+}
+
