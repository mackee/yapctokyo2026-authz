+// removeUserAggregate takes one user out of every project of one organization
+// (offboarding). Tasks assigned to the user in those projects are unassigned,
+// so no task keeps an assignee who is no longer a member. The user record
+// itself is kept.
+type removeUserAggregate struct {
+	memberships []membershipRecord // to destroy
+	unassigned  []taskRecord       // to save with AssigneeID cleared
+}
+
+func loadRemoveUser(x *tx, orgID, userID string) (*removeUserAggregate, error) {
+	u, ok := x.findUser(userID)
+	if !ok || u.Org != orgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	a := &removeUserAggregate{}
+	for _, p := range x.projectsIn(orgID) {
+		if m, ok := x.findMembership(p.ID, userID); ok {
+			a.memberships = append(a.memberships, m)
+		}
+		for _, t := range x.tasksIn(p.ID) {
+			if t.AssigneeID == userID {
+				t.AssigneeID = ""
+				a.unassigned = append(a.unassigned, t)
+			}
+		}
+	}
+	return a, nil
+}
+
+func (a *removeUserAggregate) validate() error { return nil }
+
+func (a *removeUserAggregate) save(x *tx) {
+	for _, m := range a.memberships {
+		m.destroy(x)
+	}
+	for _, t := range a.unassigned {
+		t.save(x)
+	}
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task taskRecord
