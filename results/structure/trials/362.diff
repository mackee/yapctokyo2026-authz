+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager to project where writer", "ivy", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 200},
+		{"manager to project where viewer", "ann", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 403},
+		{"manager to project where non member", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"gx"}`, 404},
+		{"manager to missing project", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"nope"}`, 404},
+		{"manager to archived project", "ann", "/projects/web/tasks/t3", `{"toProjectId":"legacy"}`, 409},
+		{"manager to same project", "ivy", "/projects/web/tasks/t2", `{"toProjectId":"web"}`, 400},
+		{"assignee not in target", "ivy", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 400},
+		{"contributor own task", "ben", "/projects/web/tasks/t1", `{"toProjectId":"legacy"}`, 403},
+		{"contributor assigned to task", "cat", "/projects/ops/tasks/t4", `{"toProjectId":"web"}`, 403},
+		{"viewer", "dan", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"org admin", "eve", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"non member source", "hal", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 404},
+		{"cross project id", "ivy", "/projects/web/tasks/t4", `{"toProjectId":"legacy"}`, 404},
+		{"cross org", "gus", "/projects/gx/tasks/t6", `{"toProjectId":"web"}`, 404},
+		{"archived source", "ann", "/projects/legacy/tasks/t5", `{"toProjectId":"web"}`, 409},
+		{"missing target", "ivy", "/projects/web/tasks/t3", `{}`, 400},
+		{"bad body", "ivy", "/projects/web/tasks/t3", `nope`, 400},
+		{"anonymous", "", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsFields(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d: %s", code, body)
+	}
+	var moved Task
+	if err := json.Unmarshal([]byte(body), &moved); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", Assignee: "cat"}
+	if moved != want {
+		t.Fatalf("moved task = %+v, want %+v", moved, want)
+	}
+
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks/t2", "ivy", ""); code != 200 {
+		t.Fatalf("read in target: got %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t2", "ivy", ""); code != 404 {
+		t.Fatalf("read in source after move: got %d, want 404", code)
+	}
+}
+
+func TestMoveUnassignedTask(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/tasks/t3/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var moved Task
+	json.Unmarshal([]byte(body), &moved)
+	if moved.ID != "t3" || moved.ProjectID != "ops" || moved.Assignee != "" {
+		t.Fatalf("unexpected task %+v", moved)
+	}
+}
+
+func TestMoveFailureChangesNothing(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/tasks/t1/move", "ivy", `{"toProjectId":"ops"}`); code != 400 {
+		t.Fatalf("got %d, want 400", code)
+	}
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d", code)
+	}
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.ProjectID != "web" || task.Assignee != "ben" {
+		t.Fatalf("task changed after failed move: %+v", task)
+	}
+}
