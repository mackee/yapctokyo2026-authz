+// moveTaskAggregate moves one task into another project. The task keeps its
+// ID, title, status and assignee, so the assignee must be a contributor or
+// manager of the target project.
+type moveTaskAggregate struct {
+	task     taskRecord
+	target   projectRecord
+	assignee *membershipRecord // target.Membership(current assignee); nil when unassigned
+}
+
+func loadMoveTask(x *tx, taskID, toProjectID string) (*moveTaskAggregate, error) {
+	t, ok := x.findTask(taskID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if t.ProjectID == toProjectID {
+		return nil, deny(ErrInvalid, "task is already in that project")
+	}
+	target, ok := x.findProject(toProjectID)
+	if !ok {
+		return nil, deny(ErrInvalid, "task must belong to an existing project")
+	}
+	a := &moveTaskAggregate{task: t, target: target}
+	if t.AssigneeID != "" {
+		m, ok := target.Membership(x, t.AssigneeID)
+		if !ok {
+			return nil, deny(ErrInvalid, "assignee must be a contributor or manager of the project")
+		}
+		a.assignee = &m
+	}
+	return a, nil
+}
+
+func (a *moveTaskAggregate) validate() error {
+	if a.assignee != nil && !isWriterRole(a.assignee.Role) {
+		return deny(ErrInvalid, "assignee must be a contributor or manager of the project")
+	}
+	return nil
+}
+
+func (a *moveTaskAggregate) apply(x *tx) TaskView {
+	t := a.task
+	t.MoveTo(x, a.target.ID)
+	return t.view()
+}
