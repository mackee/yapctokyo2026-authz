+func TestTransfer(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin transfers", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 200},
+		{"manager of project not admin", "ann", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 403},
+		{"contributor not admin", "ben", "/orgs/acme/users/cat/transfer", `{"toOrgId":"globex"}`, 403},
+		{"caller in other org", "gus", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 404},
+		{"anonymous", "", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown target user", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"unknown target org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"initech"}`, 400},
+		{"same org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"acme"}`, 400},
+		{"missing toOrgId", "eve", "/orgs/acme/users/ben/transfer", `{}`, 400},
+		{"bad body", "eve", "/orgs/acme/users/ben/transfer", `not json`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got transferResponse
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.ID != "ben" || got.OrgID != "globex" {
+		t.Fatalf("got %+v", got)
+	}
+}
+
+func TestTransferRevokesOldOrgAccess(t *testing.T) {
+	s := newServer()
+	if code, body := do(t, s, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer got %d: %s", code, body)
+	}
+	// ben was a contributor on web (acme); after the move the project is out of reach.
+	if code, _ := do(t, s, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("old project: got %d want 404", code)
+	}
+	if code, _ := do(t, s, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 404 {
+		t.Fatalf("old project write: got %d want 404", code)
+	}
+}
+
+func TestTransferClearsOrgAdmin(t *testing.T) {
+	s := newServer()
+	if code, body := do(t, s, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer got %d: %s", code, body)
+	}
+	// eve is no longer an acme admin, so she must not be able to act as one.
+	if code, _ := do(t, s, "POST", "/orgs/globex/users/gus/transfer", "eve", `{"toOrgId":"acme"}`); code != 403 {
+		t.Fatalf("admin call after move: got %d want 403", code)
+	}
+	if code, _ := do(t, s, "GET", "/projects/gx/tasks", "eve", ""); code != 404 {
+		t.Fatalf("globex project as former acme admin: got %d want 404", code)
+	}
+}
