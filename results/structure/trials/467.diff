+// orgExists reports whether any user belongs to the organization. Organizations
+// have no table of their own, so an org exists once it has members.
+func orgExists(ctx context.Context, db *sql.DB, orgID string) (bool, error) {
+	var exists bool
+	err := db.QueryRowContext(ctx, `SELECT EXISTS (SELECT 1 FROM users WHERE org_id = ?)`, orgID).Scan(&exists)
+	return exists, err
+}
