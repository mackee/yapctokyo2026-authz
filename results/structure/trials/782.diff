+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestRemoveUserDenied(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"manager is not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"member is not org admin", "ben", "/orgs/acme/users/ben", 403},
+		{"other org admin cannot see org", "gus", "/orgs/acme/users/ben", 404},
+		{"org admin of other org path", "eve", "/orgs/globex/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			code, body := do(t, h, "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+			// nothing changed
+			if code, _ := do(t, h, "GET", "/projects/web/tasks/t1", "ben", ""); code != 200 {
+				t.Fatalf("ben lost access after denied removal: %d", code)
+			}
+		})
+	}
+}
+
+func TestRemoveUserEffects(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	// ben is out of every project, including the archived one
+	for _, p := range []string{"/projects/web/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, h, "GET", p, "ben", ""); code != 404 {
+			t.Fatalf("ben still reads %s: %d", p, code)
+		}
+	}
+	// others are unaffected
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat lost access: %d", code)
+	}
+	// ben's tasks are unassigned
+	for _, p := range []string{"/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		_, body := do(t, h, "GET", p, "ann", "")
+		if !strings.Contains(body, `"assignee":""`) {
+			t.Fatalf("%s still assigned: %s", p, body)
+		}
+	}
+	// removing again is a no-op on memberships: user still exists, so 204
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("repeat removal: %d", code)
+	}
+}
