new file mode 100644
index 0000000..6c6c737
--- /dev/null
+++ b/move.go
@@ -0,0 +1,131 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+)
+
+type moveRequest struct {
+	ToProjectID string `json:"toProjectId"`
+}
+
+// canReadProject reports whether user may read project p (same org, and a member or org admin).
+func (s *server) canReadProject(r *http.Request, u *user, p *project) (role string, ok bool, err error) {
+	if p == nil || p.OrgID != u.OrgID {
+		return "", false, nil
+	}
+	role, err = findRole(r.Context(), s.db, p.ID, u.ID)
+	if err != nil {
+		return "", false, err
+	}
+	return role, role != "" || u.OrgAdmin, nil
+}
+
+// moveMember: POST /projects/{pid}/members/{uid}/move {"toProjectId"}
+// Mirrors moveOutcome/moveMember in spec/taskboard.qnt. The caller must be a
+// manager of both projects. The member keeps their role in the target project,
+// and tasks of the source project assigned to them become unassigned.
+func (s *server) moveMember(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	caller, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if caller == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	src, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	srcRole, ok, err := s.canReadProject(r, caller, src)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if !ok {
+		writeError(w, 404, "not found")
+		return
+	}
+	memberID := r.PathValue("uid")
+	memberRole, err := findRole(ctx, s.db, src.ID, memberID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if memberRole == "" {
+		writeError(w, 404, "not found")
+		return
+	}
+	if srcRole != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	var req moveRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || req.ToProjectID == "" {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	dst, err := findProject(ctx, s.db, req.ToProjectID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	dstRole, ok, err := s.canReadProject(r, caller, dst)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if !ok {
+		writeError(w, 404, "not found")
+		return
+	}
+	if dstRole != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if dst.ID == src.ID {
+		writeError(w, 400, "target project must differ from the source project")
+		return
+	}
+	if src.Archived || dst.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+	// Re-check inside the transaction that the member is not already in the target.
+	var n int
+	if err := tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM memberships WHERE project_id = ? AND user_id = ?`, dst.ID, memberID).Scan(&n); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if n > 0 {
+		writeError(w, 409, "user is already a member of the target project")
+		return
+	}
+	if _, err := tx.ExecContext(ctx, `DELETE FROM memberships WHERE project_id = ? AND user_id = ?`, src.ID, memberID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if _, err := tx.ExecContext(ctx, `INSERT INTO memberships (project_id, user_id, role) VALUES (?, ?, ?)`, dst.ID, memberID, memberRole); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if _, err := tx.ExecContext(ctx, `UPDATE tasks SET assignee = '' WHERE project_id = ? AND assignee = ?`, src.ID, memberID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, map[string]string{"userId": memberID, "projectId": dst.ID, "role": memberRole})
+}
diff --git a/move_test.go b/move_test.go
new file mode 100644
index 0000000..181dccb
--- /dev/null
+++ b/move_test.go
@@ -0,0 +1,92 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestMoveMemberStatuses(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"no user", "", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 401},
+		{"unknown user", "nobody", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 401},
+		{"caller cannot read source", "hal", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"other org caller", "gus", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"missing source", "ivy", "/projects/nope/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"user not a member", "ivy", "/projects/web/members/hal/move", `{"toProjectId":"ops"}`, 404},
+		{"contributor caller", "ben", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin caller", "eve", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"bad body", "ivy", "/projects/web/members/ben/move", `{}`, 400},
+		{"missing target", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"nope"}`, 404},
+		{"other org target", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"gx"}`, 404},
+		{"caller not manager of target", "ann", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"same project", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"web"}`, 400},
+		{"archived target", "ann", "/projects/web/members/ben/move", `{"toProjectId":"legacy"}`, 409},
+		{"archived source", "ann", "/projects/legacy/members/ben/move", `{"toProjectId":"web"}`, 409},
+		{"already member of target", "ivy", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 409},
+		{"ok", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			if got, body := do(t, h, "POST", c.path, c.user, c.body); got != c.want {
+				t.Fatalf("got %d, want %d: %s", got, c.want, body)
+			}
+		})
+	}
+}
+
+func TestMoveMemberEffects(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var resp map[string]string
+	if err := json.Unmarshal([]byte(body), &resp); err != nil {
+		t.Fatal(err)
+	}
+	if resp["userId"] != "ben" || resp["projectId"] != "ops" || resp["role"] != "contributor" {
+		t.Fatalf("unexpected response: %v", resp)
+	}
+	// ben is no longer a web member and can read ops.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben should lose web, got %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben should read ops, got %d", code)
+	}
+	// ben's web task t1 is now unassigned (assignees must be writers of the project).
+	_, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.Assignee != "" {
+		t.Fatalf("t1 assignee = %q, want unassigned", task.Assignee)
+	}
+	// Moving again from web fails: ben is no longer a member there.
+	if code, _ := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`); code != 404 {
+		t.Fatalf("second move got %d, want 404", code)
+	}
+}
+
+func TestMoveMemberRejectedChangesNothing(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/members/cat/move", "ivy", `{"toProjectId":"ops"}`); code != 409 {
+		t.Fatalf("got %d, want 409", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat should stay in web, got %d", code)
+	}
+	_, body := do(t, h, "GET", "/projects/web/tasks/t2", "ann", "")
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.Assignee != "cat" {
+		t.Fatalf("t2 assignee = %q, want cat", task.Assignee)
+	}
+}
