+  // POST /projects/{p}/members/{m}/move {"toProjectId": q}
+  // Caller u must be a manager of both the source p and the target q.
+  def moveOutcome(u: UserId, p: ProjectId, m: UserId, q: ProjectId): int =
+    if (not(userExists(u))) 401
+    else if (not(canRead(u, p))) 404
+    else if (roleOf(p, m) == "") 404
+    else if (roleOf(p, u) != "manager") 403
+    else if (not(canRead(u, q))) 404
+    else if (roleOf(q, u) != "manager") 403
+    else if (p == q) 400
+    else if (projects.get(p).archived or projects.get(q).archived) 409
+    else if (roleOf(q, m) != "") 409
+    else 200
+
   // ---- actions -------------------------------------------------------------
 
   action unchanged = all {
@@ -164,6 +178,21 @@ module taskboard {
       members' = members,
     } else unchanged
 
+  // The member leaves p and joins q with the same role. Tasks of p assigned to
+  // the member become unassigned (the member is no longer a writer of p).
+  action moveMember(u: UserId, p: ProjectId, m: UserId, q: ProjectId): bool =
+    if (moveOutcome(u, p, m, q) == 200) all {
+      members' = members.keys().exclude(Set((p, m))).mapBy(k => members.get(k))
+        .put((q, m), members.get((p, m))),
+      tasks' = tasks.keys().mapBy(k =>
+        if (tasks.get(k).project == p and tasks.get(k).assignee == m)
+          { ...tasks.get(k), assignee: "" }
+        else tasks.get(k)),
+      nextTask' = nextTask,
+      users' = users,
+      projects' = projects,
+    } else unchanged
+
   // ---- seed data and steps -------------------------------------------------
 
   action init = all {
@@ -202,7 +231,9 @@ module taskboard {
     nondet t = 1.to(nextTask).oneOf()
     nondet s = STATUSES.oneOf()
     nondet changeAssignee = Set(true, false).oneOf()
+    nondet q = PROJECTS.oneOf()
     any {
+      moveMember(u, p, a, q),
       createTask(u, p, a),
       updateTask(u, p, t, s, changeAssignee, a),
       deleteTask(u, p, t),
@@ -230,6 +261,25 @@ module taskboard {
       assert(deleteOutcome("ann", "web", 1) == 204),
       assert(deleteOutcome("ben", "web", 1) == 403),
       assert(deleteOutcome("ann", "web", 4) == 404),
+      assert(moveOutcome("ivy", "web", "ben", "ops") == 200),
+      assert(moveOutcome("ivy", "web", "ann", "ops") == 409),
+      assert(moveOutcome("ivy", "web", "ben", "web") == 400),
+      assert(moveOutcome("ivy", "web", "hal", "ops") == 404),
+      assert(moveOutcome("ben", "web", "cat", "ops") == 403),
+      assert(moveOutcome("ann", "web", "ben", "ops") == 403),
