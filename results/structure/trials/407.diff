+// updateMembershipAggregate changes the role of one member of one project.
+type updateMembershipAggregate struct {
+	membership *Membership
+	role       string
+	assigned   []*Task // the member's tasks in the project; loaded when the new role is not a writer role
+}
+
+func loadUpdateMembership(ctx context.Context, x *Tx, projectID, userID, role string) (*updateMembershipAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, x, projectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &updateMembershipAggregate{membership: m, role: role}
+	if !isWriterRole(role) {
+		a.assigned, err = m.AssignedTasks(ctx, x)
+		if err != nil {
+			return nil, err
+		}
+	}
+	return a, nil
+}
+
+func (a *updateMembershipAggregate) validate() error {
+	if !isWriterRole(a.role) && len(a.assigned) > 0 {
+		return deny(ErrInvalid, "member has assigned tasks in the project; reassign them before making the member a viewer")
+	}
+	return nil
+}
+
+func (a *updateMembershipAggregate) apply(ctx context.Context, x *Tx) (*Membership, error) {
+	if err := a.membership.setRole(ctx, x, a.role); err != nil {
+		return nil, err
+	}
+	return a.membership, nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
