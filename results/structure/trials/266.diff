+// ---- organization capabilities -------------------------------------------------
+
+// UserView is the public representation of a user.
+type UserView struct {
+	ID    string `json:"id"`
+	OrgID string `json:"orgId"`
+}
+
+// AdminOrg may manage the users of one organization.
+type AdminOrg interface {
+	ID() string
+	// TransferUser moves a user of this organization to another existing
+	// organization. The user loses their project memberships and task
+	// assignments in this organization and any org admin status, because
+	// none of those can follow them into another organization.
+	TransferUser(userID, toOrgID string) (UserView, error)
+}
+
+type orgScope struct {
+	as  *actorScope
+	org string
+}
+
+func (s *orgScope) ID() string { return s.org }
+
+// Admin applies the org admin rule: the organization is the actor's own
+// (else 404) and the actor is an org admin of it (else 403).
+func (s *orgScope) Admin() (AdminOrg, error) {
+	act := s.as.actor
+	if s.org != act.org {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if !act.orgAdmin {
+		return nil, deny(ErrForbidden, "forbidden")
+	}
+	return &adminOrg{os: s}, nil
+}
+
+type adminOrg struct{ os *orgScope }
+
+func (o *adminOrg) ID() string { return o.os.org }
+
+func (o *adminOrg) TransferUser(userID, toOrgID string) (UserView, error) {
+	var v UserView
+	err := o.os.as.a.st.tx(func(s *state) error {
+		u, ok := s.users[userID]
+		if !ok || u.org != o.os.org {
+			return deny(ErrNotFound, "not found")
+		}
+		if toOrgID == "" || !s.orgExists(toOrgID) || toOrgID == u.org {
+			return deny(ErrInvalid, "invalid destination organization")
+		}
+		// Memberships and assignments are bound to the old organization.
+		for _, m := range s.members {
+			delete(m, userID)
+		}
+		for id, t := range s.tasks {
+			if t.assignee.user == userID {
+				t.assignee = Assignee{project: t.project}
+				s.tasks[id] = t
+			}
+		}
+		u.org = toOrgID
+		u.orgAdmin = false
+		s.users[userID] = u
+		v = UserView{ID: u.id, OrgID: u.org}
+		return nil
+	})
+	return v, err
+}
+
