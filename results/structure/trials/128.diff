+// MemberView is one project membership.
+type MemberView struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// ManageProject may manage the membership of one project.
+type ManageProject interface {
+	ReadProject
+	// Freeze sets every member's role to viewer, so nobody can write to the
+	// project's tasks afterwards. Assignments are kept. It returns the
+	// resulting membership, sorted by user ID.
+	Freeze() ([]MemberView, error)
+}
+
+type manageProject struct{ readProject }
+
+func (p *manageProject) Freeze() ([]MemberView, error) {
+	var out []MemberView
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		for uid := range s.members[p.ps.pid] {
+			s.members[p.ps.pid][uid] = RoleViewer
+		}
+		out = s.membersOf(p.ps.pid)
+		return nil
+	})
+	return out, err
+}
