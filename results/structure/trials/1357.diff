diff --git a/transfer.go b/transfer.go
new file mode 100644
index 0000000..8265397
--- /dev/null
+++ b/transfer.go
@@ -0,0 +1,86 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+)
+
+type transferRequest struct {
+	ToOrgID string `json:"toOrgId"`
+}
+
+// transferUser moves a user to another organization (spec: transferOutcome and
+// transferUser in spec/taskboard.qnt).
+//
+// Only an org admin of the user's current org (the {orgID} in the path) may do
+// it. The user's project memberships belong to the old org, so they are removed
+// and the user's tasks become unassigned; the user is no longer an org admin.
+// All of this happens in one transaction.
+func (s *server) transferUser(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	caller, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if caller == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	orgID := r.PathValue("orgID")
+	if caller.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	if !caller.OrgAdmin {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	target, err := findUser(ctx, s.db, r.PathValue("uid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if target == nil || target.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	var req transferRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || req.ToOrgID == "" || req.ToOrgID == orgID {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	var known bool
+	if err := s.db.QueryRowContext(ctx,
+		`SELECT EXISTS (SELECT 1 FROM users WHERE org_id = ?1 UNION ALL SELECT 1 FROM projects WHERE org_id = ?1)`,
+		req.ToOrgID).Scan(&known); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if !known {
+		writeError(w, 400, "unknown organization")
+		return
+	}
+
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+	for _, q := range []string{
+		`UPDATE users SET org_id = ?, org_admin = 0 WHERE id = ?`,
+		`DELETE FROM memberships WHERE user_id = ?2`,
+		`UPDATE tasks SET assignee = '' WHERE assignee = ?2`,
+	} {
+		if _, err := tx.ExecContext(ctx, q, req.ToOrgID, target.ID); err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, map[string]string{"id": target.ID, "orgId": req.ToOrgID})
+}
