 // NewMembershipTable returns the memberships table.
 func NewMembershipTable() *MembershipTable { return &MembershipTable{} }
 
+// Remove removes the user from the project and unassigns the tasks the user
+// holds in it, all or nothing. It asks the authorization object whether the
+// actor may manage the project's members first.
+func (mt *MembershipTable) Remove(ctx context.Context, db DB, authz ProjectAuthz, userID string) error {
+	if err := authz.CanManageMembers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveMember(ctx, tx, authz.ProjectID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
