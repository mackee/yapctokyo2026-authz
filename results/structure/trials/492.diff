+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager", "ann", "/projects/web/members/dan", 204},
+		{"manager removes manager", "ann", "/projects/web/members/ivy", 204},
+		{"not a member", "ann", "/projects/web/members/hal", 404},
+		{"unknown member", "ann", "/projects/web/members/zed", 404},
+		{"contributor", "ben", "/projects/web/members/cat", 403},
+		{"viewer", "dan", "/projects/web/members/ben", 403},
+		{"org admin", "eve", "/projects/web/members/ben", 403},
+		{"non member", "hal", "/projects/web/members/ben", 404},
+		{"other org", "gus", "/projects/web/members/ben", 404},
+		{"unknown project", "ann", "/projects/nope/members/ben", 404},
+		{"archived manager", "ann", "/projects/legacy/members/ben", 409},
+		{"archived contributor", "ben", "/projects/legacy/members/ben", 403},
+		{"anonymous", "", "/projects/web/members/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveMemberEffects(t *testing.T) {
+	h := newServer()
+
+	// ben holds t1 in web; it is unassigned once ben is removed.
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+
+	// ben is no longer a member, so the project is no longer readable to ben.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("removed member read: got %d want 404", code)
+	}
+
+	// t1 is unassigned; t2 (cat's) is untouched.
+	var task Task
+	_, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "" {
+		t.Fatalf("t1 still assigned to %q", task.AssigneeID)
+	}
+	_, body = do(t, h, "GET", "/projects/web/tasks/t2", "ann", "")
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "cat" {
+		t.Fatalf("t2 assignee changed to %q", task.AssigneeID)
+	}
+
+	// Removing ben again: ben is no longer a member.
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 404 {
+		t.Fatalf("second remove: got %d want 404", code)
+	}
+
+	// The same user can still be a member of another project.
+	if code, _ := do(t, h, "GET", "/projects/legacy/tasks", "ben", ""); code != 200 {
+		t.Fatalf("other project read: got %d want 200", code)
+	}
+}
