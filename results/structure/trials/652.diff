+func TestUpdateMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, project, target, body string
+		want                              int
+	}{
+		{"manager promotes", "ann", "web", "ben", `{"role":"manager"}`, 200},
+		{"manager demotes", "ann", "web", "ivy", `{"role":"viewer"}`, 200},
+		{"contributor", "ben", "web", "cat", `{"role":"manager"}`, 403},
+		{"viewer", "dan", "web", "cat", `{"role":"viewer"}`, 403},
+		{"org admin readable not writable", "eve", "web", "cat", `{"role":"viewer"}`, 403},
+		{"non member", "hal", "web", "cat", `{"role":"viewer"}`, 404},
+		{"other org", "gus", "web", "cat", `{"role":"viewer"}`, 404},
+		{"archived", "ann", "legacy", "ben", `{"role":"viewer"}`, 409},
+		{"invalid role", "ann", "web", "ben", `{"role":"owner"}`, 400},
+		{"missing role", "ann", "web", "ben", `{}`, 400},
+		{"bad body", "ann", "web", "ben", `nope`, 400},
+		{"target not a member", "ann", "web", "hal", `{"role":"viewer"}`, 404},
+		{"promote viewer", "ann", "web", "dan", `{"role":"manager"}`, 200},
+		{"target only in other project", "ivy", "ops", "ben", `{"role":"viewer"}`, 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members/"+c.target, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRoleResponseAndEffect(t *testing.T) {
+	srv := newServer()
+	code, body := do(t, srv, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.UserID != "ben" || got.Role != "viewer" {
+		t.Fatalf("got %+v", got)
+	}
+	// ben was demoted to viewer, so writes are now forbidden on the same server.
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Fatalf("demoted ben create: got %d want 403", code)
+	}
+	// and can be promoted back, after which writes work again.
+	if code, _ := do(t, srv, "PUT", "/projects/web/members/ben", "ann", `{"role":"contributor"}`); code != 200 {
+		t.Fatalf("re-promote: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 200 {
+		t.Fatalf("contributor create: got %d want 200", code)
+	}
+}
