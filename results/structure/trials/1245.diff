+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager of both moves", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 200},
+		{"manager moves viewer", "ivy", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 200},
+		{"contributor source", "ben", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer source", "dan", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin source", "eve", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"non member source", "hal", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"other org source", "gus", "/projects/web/members/ben/move", `{"toProjectId":"gx"}`, 404},
+		{"anonymous", "", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 401},
+		{"archived source", "ann", "/projects/legacy/members/ben/move", `{"toProjectId":"web"}`, 409},
+		{"viewer destination", "ann", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"archived destination", "ann", "/projects/web/members/dan/move", `{"toProjectId":"legacy"}`, 409},
+		{"destination not readable", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"gx"}`, 404},
+		{"destination missing", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"nope"}`, 404},
+		{"member not in source", "ivy", "/projects/web/members/hal/move", `{"toProjectId":"ops"}`, 404},
+		{"unknown member", "ivy", "/projects/web/members/zed/move", `{"toProjectId":"ops"}`, 404},
+		{"already in destination", "ivy", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 409},
+		{"same project", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"web"}`, 400},
+		{"missing toProjectId", "ivy", "/projects/web/members/ben/move", `{}`, 400},
+		{"malformed body", "ivy", "/projects/web/members/ben/move", `{`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveResult(t *testing.T) {
+	h := newServer()
+
+	code, body := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["userId"] != "ben" || got["projectId"] != "ops" || got["role"] != "contributor" {
+		t.Fatalf("response = %v", got)
+	}
+
+	// ben is no longer a member of web, and is now a member of ops.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads web after move: got %d want 404", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben reads ops after move: got %d want 200", code)
+	}
+
+	// ben's task in web is unassigned; cat's task in web is untouched.
+	code, body = do(t, h, "GET", "/projects/web/tasks/t1", "ivy", "")
+	if code != 200 {
+		t.Fatalf("get t1: got %d", code)
+	}
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.AssigneeID != "" {
+		t.Fatalf("t1 assignee = %q, want unassigned", task.AssigneeID)
+	}
+	code, body = do(t, h, "GET", "/projects/web/tasks/t2", "ivy", "")
+	json.Unmarshal([]byte(body), &task)
+	if code != 200 || task.AssigneeID != "cat" {
+		t.Fatalf("t2: code %d assignee %q, want cat", code, task.AssigneeID)
+	}
+
+	// Moving again from web is now a 404: the member is gone from the source.
+	if code, _ := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`); code != 404 {
+		t.Fatalf("second move: got %d want 404", code)
+	}
+}
+
+func TestMoveKeepsRole(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/members/dan/move", "ivy", `{"toProjectId":"ops"}`)
