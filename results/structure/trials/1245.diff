+// moveMemberAggregate moves one member from the source project to another
+// project, with the same role.
+type moveMemberAggregate struct {
+	from      *Membership // the member's membership in the source project
+	toProject string
+	existing  *Membership // the member's membership in the destination, if any
+	assigned  []*Task     // the member's tasks in the source project
+}
+
+func loadMoveMember(ctx context.Context, tx DB, sourceProjectID, userID, toProjectID string) (*moveMemberAggregate, error) {
+	from, err := NewMembershipTable().Find(ctx, tx, sourceProjectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "member not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveMemberAggregate{from: from, toProject: toProjectID}
+	existing, err := NewMembershipTable().Find(ctx, tx, toProjectID, userID)
+	if err == nil {
+		a.existing = existing
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	// The member's tasks in the source project would be assigned to a non-member
+	// there, so they are unassigned.
+	if a.assigned, err = from.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.existing != nil {
+		return deny(ErrConflict, "already a member of the destination project")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	for _, t := range a.assigned {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.from.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	to := &Membership{ProjectID: a.toProject, UserID: a.from.UserID, Role: a.from.Role}
+	if err := to.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return to, nil
+}
+
