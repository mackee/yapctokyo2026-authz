+// moveMemberAggregate moves one member from a source project to a destination
+// project. It starts from the member's membership in the source project.
+type moveMemberAggregate struct {
+	from     *Membership // the member's membership in the source project
+	to       *Project    // destination project
+	toExists *Membership // the member's membership in the destination project, if any
+	user     *User
+	tasks    []*Task // the member's tasks in the source project
+}
+
+func loadMoveMember(ctx context.Context, tx DB, fromProjectID, toProjectID, userID string) (*moveMemberAggregate, error) {
+	src, err := NewProjectTable().Find(ctx, tx, fromProjectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	m, err := src.Membership(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "member not found")
+	} else if err != nil {
+		return nil, err
+	}
+	dst, err := NewProjectTable().Find(ctx, tx, toProjectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveMemberAggregate{from: m, to: dst}
+	existing, err := dst.Membership(ctx, tx, userID)
+	if err == nil {
+		a.toExists = existing
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	u, err := m.User(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	a.user = u
+	if a.tasks, err = m.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.toExists != nil {
+		return deny(ErrConflict, "user is already a member of the destination project")
+	}
+	if a.user.Org != a.to.Org {
+		return deny(ErrInvalid, "project members must belong to the project's organization")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.from.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	to := &Membership{ProjectID: a.to.ID, UserID: a.from.UserID, Role: a.from.Role}
+	if err := to.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return to, nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
