+// UserTableTransferInput is the input of UserTable.Transfer.
+type UserTableTransferInput struct {
+	ToOrgID string
+}
+
+// Transfer moves the user to another organization. The user's memberships and
+// task assignments are dropped, since they cannot carry over to the new
+// organization, and the user loses org admin rights. The user must be in the
+// authorization object's organization.
+func (*UserTable) Transfer(ctx context.Context, db DB, authz OrgAuthz, userID string, in UserTableTransferInput) (*User, error) {
+	if err := authz.CanTransferUsers(); err != nil {
+		return nil, err
+	}
+	if in.ToOrgID == "" {
+		return nil, deny(ErrInvalid, "toOrgId must not be empty")
+	}
+	var u *User
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadTransferUser(ctx, tx, authz.OrgID(), userID, in.ToOrgID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if u, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return u, nil
+}
