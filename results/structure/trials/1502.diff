+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager removes contributor", "ann", "/projects/web/members/cat", 204},
+		{"manager removes viewer", "ann", "/projects/web/members/dan", 204},
+		{"contributor", "ben", "/projects/web/members/cat", 403},
+		{"viewer", "dan", "/projects/web/members/ben", 403},
+		{"org admin", "eve", "/projects/web/members/ben", 403},
+		{"non member", "hal", "/projects/web/members/ben", 404},
+		{"other org", "gus", "/projects/web/members/ben", 404},
+		{"anonymous", "", "/projects/web/members/ben", 401},
+		{"not a member", "ann", "/projects/web/members/eve", 404},
+		{"unknown user", "ann", "/projects/web/members/zed", 404},
+		{"user is not in this project", "ivy", "/projects/ops/members/ben", 404},
+		{"archived", "ann", "/projects/legacy/members/ben", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveMemberUnassignsTasks(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 204 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	app := h.(*appHandler)
+
+	var n int
+	if err := app.db.QueryRow(`SELECT COUNT(*) FROM memberships WHERE project_id = 'web' AND user_id = 'ben'`).Scan(&n); err != nil {
+		t.Fatal(err)
+	}
+	if n != 0 {
+		t.Fatalf("ben is still a member of web")
+	}
+
+	var assignee string
+	if err := app.db.QueryRow(`SELECT assignee FROM tasks WHERE id = 't1'`).Scan(&assignee); err != nil {
+		t.Fatal(err)
+	}
+	if assignee != "" {
+		t.Fatalf("t1 still assigned to %q after ben was removed", assignee)
+	}
+
+	// Removing ben does not touch tasks assigned to others, or ben's tasks in other projects.
+	var t5 string
+	if err := app.db.QueryRow(`SELECT assignee FROM tasks WHERE id = 't5'`).Scan(&t5); err != nil {
+		t.Fatal(err)
+	}
+	if t5 != "ben" {
+		t.Fatalf("t5 in legacy changed to %q", t5)
+	}
+}
+
+func TestRemoveMemberThenNoLongerReadable(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/dan", "ann", ""); code != 204 {
+		t.Fatalf("remove: got %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "dan", ""); code != 404 {
+		t.Fatalf("removed member read: got %d want 404", code)
+	}
+}
