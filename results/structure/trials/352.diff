+func TestChangeRoles(t *testing.T) {
+	const ok = `{"roles":{"ben":"viewer","dan":"contributor"}}`
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager changes roles", "ann", "/projects/web/members", ok, 200},
+		{"manager, unknown role", "ann", "/projects/web/members", `{"roles":{"ben":"owner"}}`, 400},
+		{"manager, non-member target", "ann", "/projects/web/members", `{"roles":{"hal":"viewer"}}`, 400},
+		{"manager, one bad entry in batch", "ann", "/projects/web/members", `{"roles":{"ben":"viewer","hal":"viewer"}}`, 400},
+		{"manager, empty roles", "ann", "/projects/web/members", `{"roles":{}}`, 400},
+		{"manager, null roles", "ann", "/projects/web/members", `{"roles":null}`, 400},
+		{"manager, malformed body", "ann", "/projects/web/members", `{"roles":`, 400},
+		{"manager, archived project", "ann", "/projects/legacy/members", `{"roles":{"ben":"viewer"}}`, 409},
+		{"contributor", "ben", "/projects/web/members", ok, 403},
+		{"viewer", "dan", "/projects/web/members", ok, 403},
+		{"org admin", "eve", "/projects/web/members", ok, 403},
+		{"non member", "hal", "/projects/web/members", ok, 404},
+		{"other org", "gus", "/projects/web/members", ok, 404},
+		{"anonymous", "", "/projects/web/members", ok, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+type member struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func TestChangeRolesResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann",
+		`{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []member{
+		{"ann", "manager"},
+		{"ben", "viewer"},
+		{"cat", "contributor"},
+		{"dan", "contributor"},
+		{"ivy", "manager"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("entry %d: got %v want %v", i, got[i], want[i])
+		}
+	}
+}
+
+// A batch with any entry that cannot be applied changes nothing.
+func TestChangeRolesAllOrNothing(t *testing.T) {
+	bad := []string{
+		`{"roles":{"ben":"viewer","dan":"contributor","hal":"viewer"}}`, // non-member
+		`{"roles":{"ben":"viewer","cat":"owner"}}`,                      // invalid role
+	}
+	for _, body := range bad {
+		t.Run(body, func(t *testing.T) {
+			s := newServer()
+			if code, _ := do(t, s, "PUT", "/projects/web/members", "ann", body); code != 400 {
+				t.Fatalf("got %d want 400", code)
+			}
+			// A later valid request reports the roles as they were before the failed one.
+			code, resp := do(t, s, "PUT", "/projects/web/members", "ann", `{"roles":{"cat":"contributor"}}`)
+			if code != 200 {
+				t.Fatalf("got %d: %s", code, resp)
+			}
+			var got []member
+			json.Unmarshal([]byte(resp), &got)
+			for _, m := range got {
+				if m.UserID == "ben" && m.Role != "contributor" {
+					t.Fatalf("ben changed to %s by a failed request", m.Role)
+				}
+				if m.UserID == "dan" && m.Role != "viewer" {
+					t.Fatalf("dan changed to %s by a failed request", m.Role)
+				}
+			}
+		})
+	}
+}
+
+// Changed roles take effect on the following requests.
+func TestChangeRolesTakesEffect(t *testing.T) {
+	s := newServer()
+	if code, body := do(t, s, "PUT", "/projects/web/members", "ann",
+		`{"roles":{"ben":"viewer","dan":"contributor"}}`); code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	if code, _ := do(t, s, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 201 {
+		t.Fatalf("promoted dan create: got %d want 201", code)
+	}
+	if code, _ := do(t, s, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 403 {
+		t.Fatalf("demoted ben edit own task: got %d want 403", code)
+	}
+}
