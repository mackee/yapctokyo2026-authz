+// changeRolesAggregate sets the roles of several existing members of one project.
+type changeRolesAggregate struct {
+	projectID string
+	changes   []membershipRecord
+}
+
+func loadChangeRoles(x *tx, projectID string, roles map[string]string) (*changeRolesAggregate, error) {
+	userIDs := make([]string, 0, len(roles))
+	for uid := range roles {
+		userIDs = append(userIDs, uid)
+	}
+	sort.Strings(userIDs)
+
+	a := &changeRolesAggregate{projectID: projectID}
+	for _, uid := range userIDs {
+		m, ok := x.findMembership(projectID, uid)
+		if !ok {
+			return nil, deny(ErrInvalid, "user is not a member of the project: "+uid)
+		}
+		m.Role = roles[uid]
+		a.changes = append(a.changes, m)
+	}
+	return a, nil
+}
+
+func (a *changeRolesAggregate) validate() error {
+	for _, m := range a.changes {
+		if !validRoles[m.Role] {
+			return deny(ErrInvalid, "invalid role: "+m.Role)
+		}
+	}
+	return nil
+}
+
+func (a *changeRolesAggregate) save(x *tx) []MemberView {
+	for _, m := range a.changes {
+		m.save(x)
+	}
+	members := x.membershipsOf(a.projectID)
+	out := make([]MemberView, 0, len(members))
+	for _, m := range members {
+		out = append(out, MemberView{UserID: m.UserID, Role: m.Role})
+	}
+	return out
+}
