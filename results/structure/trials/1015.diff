+func TestMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"unauthenticated", "", "/projects/web/members/dan", `{"role":"viewer"}`, 401},
+		{"contributor", "ben", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"viewer", "dan", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"org admin", "eve", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"non member", "hal", "/projects/web/members/dan", `{"role":"contributor"}`, 404},
+		{"other org", "gus", "/projects/web/members/dan", `{"role":"contributor"}`, 404},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"invalid role", "ann", "/projects/web/members/dan", `{"role":"boss"}`, 400},
+		{"empty body", "ann", "/projects/web/members/dan", ``, 400},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"unknown project", "ann", "/projects/nope/members/dan", `{"role":"viewer"}`, 404},
+		{"manager of other project", "ann", "/projects/ops/members/cat", `{"role":"viewer"}`, 403},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestMemberRoleResultAndEffects(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil || got["userId"] != "ben" || got["role"] != "viewer" {
+		t.Fatalf("bad body %s", body)
+	}
+	// ben is now a viewer: cannot write, and his task was unassigned.
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 403 {
+		t.Fatalf("demoted user write: got %d want 403", code)
+	}
+	_, task := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if !strings.Contains(task, `"assignee":""`) {
+		t.Fatalf("task not unassigned: %s", task)
+	}
+}
+
+func TestLastManagerCannotBeDemoted(t *testing.T) {
+	h := newServer()
+	// ops has one manager (ivy); ann is only a viewer there, so use web: demote ann, then ivy.
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ann", "ivy", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("first demotion: got %d", code)
+	}
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ivy", "ivy", `{"role":"viewer"}`); code != 409 {
+		t.Fatalf("last manager demotion: got %d want 409", code)
+	}
+}
