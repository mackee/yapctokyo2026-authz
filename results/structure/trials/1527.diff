+// moveMemberAggregate moves one member from one project to another.
+type moveMemberAggregate struct {
+	from        *Membership // the user's membership in the source project
+	fromProject *Project
+	toProject   *Project
+	existing    *Membership // the user's membership in the target project; nil if none
+	assigned    []*Task     // the user's tasks in the source project
+}
+
+func loadMoveMember(ctx context.Context, tx DB, fromProjectID, userID, toProjectID string) (*moveMemberAggregate, error) {
+	from, err := NewMembershipTable().Find(ctx, tx, fromProjectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	fromProject, err := from.Project(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	toProject, err := NewProjectTable().Find(ctx, tx, toProjectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveMemberAggregate{from: from, fromProject: fromProject, toProject: toProject}
+	existing, err := toProject.Membership(ctx, tx, userID)
+	if err == nil {
+		a.existing = existing
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	if a.assigned, err = from.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.toProject.Org != a.fromProject.Org {
+		return deny(ErrInvalid, "members must stay in the project's organization")
+	}
+	if a.existing != nil {
+		return deny(ErrInvalid, "user is already a member of the target project")
+	}
+	// Leaving the project would leave these tasks assigned to a non-member.
+	if len(a.assigned) > 0 {
+		return deny(ErrInvalid, "user is assigned tasks in the project; unassign or reassign them first")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.from.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	m := &Membership{ProjectID: a.toProject.ID, UserID: a.from.UserID, Role: a.from.Role}
+	if err := m.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
+
