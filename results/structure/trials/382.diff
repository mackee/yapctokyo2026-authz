+// freezeProjectAggregate demotes every member of one project to viewer.
+type freezeProjectAggregate struct {
+	members []membershipRecord // project.Memberships, sorted by user ID
+}
+
+func loadFreezeProject(x *tx, projectID string) (*freezeProjectAggregate, error) {
+	p, ok := x.findProject(projectID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	return &freezeProjectAggregate{members: p.Memberships(x)}, nil
+}
+
+func (a *freezeProjectAggregate) apply(x *tx) []MemberView {
+	out := []MemberView{}
+	for _, m := range a.members {
+		m.SetRole(x, RoleViewer)
+		out = append(out, MemberView{UserID: m.UserID, Role: RoleViewer})
+	}
+	return out
+}
