+// ManageProject may freeze one project. Managers only.
+type ManageProject interface {
+	// Freeze demotes every member of the project, managers included, to viewer.
+	// Afterwards nobody can change the project's tasks. It returns the members
+	// after the change, sorted by user ID.
+	Freeze() ([]MemberView, error)
+}
+
+type manageProject struct{ ps *projectScope }
+
+func (p *manageProject) Freeze() ([]MemberView, error) {
+	var out []MemberView
+	err := p.ps.as.a.db.update(func(x *tx) error {
+		agg, err := loadFreezeProject(x, p.ps.pid)
+		if err != nil {
+			return err
+		}
+		out = agg.apply(x)
+		return nil
+	})
+	return out, err
+}
