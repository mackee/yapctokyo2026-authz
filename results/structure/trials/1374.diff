+
+// validRoles lists the project roles a member may be given.
+var validRoles = map[string]bool{RoleManager: true, RoleContributor: true, RoleViewer: true}
+
+// UpdateRole changes the role of the member bound to authz and returns the
+// membership. Demoting a member to a non-writer role is rejected (ErrInvalid)
+// while the member still holds tasks in the project; nothing changes then.
+func (*MembershipTable) UpdateRole(ctx context.Context, db DB, authz MemberAuthz, role string) (*Membership, error) {
+	if err := authz.CanChangeRole(); err != nil {
+		return nil, err
+	}
+	if !validRoles[role] {
+		return nil, deny(ErrInvalid, "invalid role")
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadUpdateMemberRole(ctx, tx, authz.project.ProjectID(), authz.MemberID(), role)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if m, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
