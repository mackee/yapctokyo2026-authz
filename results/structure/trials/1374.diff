+// MemberAuthz is what the actor may do with one member of one project.
+type MemberAuthz struct {
+	project ProjectAuthz
+	userID  string // the member the object is bound to
+}
+
+// MemberID returns the user ID of the member the object is bound to.
+func (a MemberAuthz) MemberID() string { return a.userID }
+
+// CanChangeRole returns nil if the actor may change the member's role: managers
+// only (else ErrForbidden) and not archived (else ErrArchived). Call it after
+// NewMemberAuthz, which already rejects a target that is not a member.
+func (a MemberAuthz) CanChangeRole() error {
+	if !a.project.CanRead() || a.project.role != RoleManager {
+		return deny(ErrForbidden, "only managers may change roles")
+	}
+	if a.project.archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	return nil
+}
