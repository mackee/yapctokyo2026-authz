+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"contributor", "ben", "/projects/web/members/cat/move", `{"toProjectId":"legacy"}`, 403},
+		{"viewer", "dan", "/projects/web/members/ben/move", `{"toProjectId":"web"}`, 403},
+		{"org admin", "eve", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"manager of source only", "ann", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"non member", "hal", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"other org", "gus", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 401},
+		{"target unreadable", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"gx"}`, 404},
+		{"target missing", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"nope"}`, 404},
+		{"target archived", "ann", "/projects/web/members/cat/move", `{"toProjectId":"legacy"}`, 409},
+		{"source archived", "ann", "/projects/legacy/members/ben/move", `{"toProjectId":"ops"}`, 409},
+		{"same project", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"web"}`, 400},
+		{"user not in source", "ivy", "/projects/web/members/hal/move", `{"toProjectId":"ops"}`, 404},
+		{"user already in target", "ivy", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 400},
+		{"empty target", "ivy", "/projects/web/members/ben/move", `{"toProjectId":""}`, 400},
+		{"missing target", "ivy", "/projects/web/members/ben/move", `{}`, 400},
+		{"bad json", "ivy", "/projects/web/members/ben/move", `{`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveEffects(t *testing.T) {
+	srv := newServer()
+	code, body := do(t, srv, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]string{"userId": "ben", "projectId": "ops", "role": "contributor"}
+	for k, v := range want {
+		if got[k] != v {
+			t.Fatalf("body %s: %s = %q, want %q", body, k, got[k], v)
+		}
+	}
+
+	// ben is no longer a member of web ...
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads web after move: got %d want 404", code)
+	}
+	// ... is a contributor of ops now, with the same role ...
+	if code, _ := do(t, srv, "POST", "/projects/ops/tasks", "ben", `{"title":"x","assignee":"ben"}`); code != 200 {
+		t.Fatalf("ben creates in ops after move: got %d want 200", code)
+	}
+	// ... and the task he held in web is unassigned.
+	code, body = do(t, srv, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "" {
+		t.Fatalf("t1 still assigned to %q after move", task.AssigneeID)
+	}
+}
