+// moveMemberAggregate moves one member from the source project to the target
+// project, keeping the role.
+type moveMemberAggregate struct {
+	from  *Membership // the member's membership in the source project
+	to    *Project    // the target project
+	user  *User       // the member
+	tasks []*Task     // the member's tasks in the source project
+}
+
+func loadMoveMember(ctx context.Context, tx DB, fromProjectID, toProjectID, userID string) (*moveMemberAggregate, error) {
+	from, err := NewMembershipTable().Find(ctx, tx, fromProjectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	to, err := NewProjectTable().Find(ctx, tx, toProjectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if _, err := NewMembershipTable().Find(ctx, tx, toProjectID, userID); err == nil {
+		return nil, deny(ErrInvalid, "user is already a member of the target project")
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	user, err := from.User(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	tasks, err := from.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &moveMemberAggregate{from: from, to: to, user: user, tasks: tasks}, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.user.Org != a.to.Org {
+		return deny(ErrInvalid, "project members must belong to the project's organization")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	// The member's tasks in the source project would be assigned to a
+	// non-member, so they are unassigned.
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.from.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	to := &Membership{ProjectID: a.to.ID, UserID: a.from.UserID, Role: a.from.Role}
+	if err := to.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return to, nil
+}
+
