 func NewMembershipTable() *MembershipTable { return &MembershipTable{} }
 
+// UpdateRole changes the role of a member of the project, all or nothing.
+// It returns ErrNotFound when the user is not a member, ErrInvalid for an
+// unknown role or for demoting an assignee of the project to viewer.
+func (mt *MembershipTable) UpdateRole(ctx context.Context, db DB, authz ProjectAuthz, userID, role string) (*Membership, error) {
+	if !isRole(role) {
+		return nil, deny(ErrInvalid, "invalid role")
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadChangeMemberRole(ctx, tx, authz.ProjectID(), userID, role)
+		if err != nil {
+			return err
+		}
+		if err := authz.CanManageMembers(); err != nil {
+			return err
+		}
+		if err := agg.validate(ctx, tx); err != nil {
+			return err
+		}
+		if m, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
