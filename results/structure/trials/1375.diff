+// changeMemberRoleAggregate changes the role of one member of one project.
+type changeMemberRoleAggregate struct {
+	membership *Membership
+	newRole    string
+}
+
+func loadChangeMemberRole(ctx context.Context, tx DB, projectID, userID, role string) (*changeMemberRoleAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	return &changeMemberRoleAggregate{membership: m, newRole: role}, nil
+}
+
+// validate keeps assignees writers: a member who is assigned tasks in the
+// project may not become a viewer.
+func (a *changeMemberRoleAggregate) validate(ctx context.Context, tx DB) error {
+	if isWriterRole(a.newRole) {
+		return nil
+	}
+	assigned, err := a.membership.AssignedTasks(ctx, tx)
+	if err != nil {
+		return err
+	}
+	if len(assigned) > 0 {
+		return deny(ErrInvalid, "member is assigned tasks in the project and must stay a contributor or manager")
+	}
+	return nil
+}
+
+func (a *changeMemberRoleAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.membership.setRole(ctx, tx, a.newRole); err != nil {
+		return nil, err
+	}
+	return a.membership, nil
+}
+
