+func TestFreezeStatuses(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"missing project", "ann", "nope", 404},
+		{"anonymous", "", "web", 401},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreeze(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("freeze: %d %s", code, body)
+	}
+	var got []memberView
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []memberView{{"ann", "viewer"}, {"ben", "viewer"}, {"cat", "viewer"}, {"dan", "viewer"}, {"ivy", "viewer"}}
+	if len(got) != len(want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("got %v want %v", got, want)
+		}
+	}
+	if !strings.Contains(body, `"userId":"ann","role":"viewer"`) {
+		t.Fatalf("unexpected JSON shape: %s", body)
+	}
+
+	// Nobody can change tasks any more, not even the former managers.
+	for _, u := range []string{"ann", "ivy", "ben", "cat"} {
+		if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", u, `{"status":"done"}`); code != 403 {
+			t.Fatalf("%s update after freeze: %d", u, code)
+		}
+		if code, _ := do(t, h, "POST", "/projects/web/tasks", u, `{"title":"x"}`); code != 403 {
+			t.Fatalf("%s create after freeze: %d", u, code)
+		}
+		if code, _ := do(t, h, "DELETE", "/projects/web/tasks/t1", u, ""); code != 403 {
+			t.Fatalf("%s delete after freeze: %d", u, code)
+		}
+	}
+	// Members can still read.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("read after freeze: %d", code)
+	}
+	// Other projects are untouched.
+	if code, _ := do(t, h, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ops update: %d", code)
+	}
+	// A second freeze is refused: nobody is a manager any more.
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 403 {
+		t.Fatalf("second freeze: %d", code)
+	}
+}
+
+func TestFreezeDeniedChangesNothing(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ben", ""); code != 403 {
+		t.Fatal(code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ben should still be a contributor: %d", code)
+	}
+}
