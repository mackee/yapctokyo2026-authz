+// Freeze changes every member of the project to the viewer role. A project with
+// no writer cannot have its tasks changed, so this freezes the project. It
+// returns the members after the change, ordered by user ID.
+func (*ProjectTable) Freeze(ctx context.Context, db DB, authz ProjectAuthz) ([]*Membership, error) {
+	if err := authz.CanFreeze(); err != nil {
+		return nil, err
+	}
+	var members []*Membership
+	if err := db.update(ctx, func(x *Tx) error {
+		agg, err := loadFreezeProject(ctx, x, authz.ProjectID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		members, err = agg.apply(ctx, x)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return members, nil
+}
