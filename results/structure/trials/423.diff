+// A frozen project accepts no task writes from anyone, while reads and other
+// projects keep working.
+func TestFreezeBlocksTaskWrites(t *testing.T) {
+	srv := newServer()
+
+	// Before the freeze, the contributor can edit their own task.
+	if code, body := do(t, srv, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 200 {
+		t.Fatalf("before freeze: got %d want 200: %s", code, body)
+	}
+
+	if code, body := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d want 200: %s", code, body)
+	}
+
+	cases := []struct {
+		name, user, method, path, body string
+		want                           int
+	}{
+		{"contributor edit own", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"open"}`, 403},
+		{"former manager edit", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"former manager create", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"former manager delete", "ann", "DELETE", "/projects/web/tasks/t1", "", 403},
+		{"former manager freeze again", "ann", "POST", "/projects/web/freeze", "", 403},
+		{"former manager of ivy", "ivy", "POST", "/projects/web/freeze", "", 403},
+		{"read still works", "ben", "GET", "/projects/web/tasks/t1", "", 200},
+		{"other project unaffected", "cat", "POST", "/projects/ops/tasks", `{"title":"x"}`, 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, srv, c.method, c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+		})
+	}
+}
+
