+// CanRemoveMember returns nil if the actor may remove a member from the
+// project: managers only (else ErrForbidden) and not archived (else ErrArchived).
+func (a ProjectAuthz) CanRemoveMember() error {
+	if !a.CanRead() || a.role != RoleManager {
+		return deny(ErrForbidden, "only managers may remove members")
+	}
+	if a.archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	return nil
+}
