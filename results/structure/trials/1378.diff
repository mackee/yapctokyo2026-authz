+// Remove removes the user from the project and unassigns the user's tasks in
+// it. The target is looked up before the actor's role is checked, so a missing
+// member is 404 for every actor who can read the project (as in
+// spec/taskboard.qnt removeMemberOutcome).
+func (*MembershipTable) Remove(ctx context.Context, db DB, authz ProjectAuthz, userID string) error {
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveMember(ctx, tx, authz.ProjectID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := authz.CanRemoveMember(); err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
