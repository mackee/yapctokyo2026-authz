new file mode 100644
index 0000000..0dd6f98
--- /dev/null
+++ b/member_test.go
@@ -0,0 +1,74 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager removes contributor", "ann", "/projects/web/members/ben", 204},
+		{"manager removes viewer", "ann", "/projects/web/members/dan", 204},
+		{"manager removes self", "ann", "/projects/web/members/ann", 204},
+		{"contributor", "ben", "/projects/web/members/cat", 403},
+		{"viewer", "dan", "/projects/web/members/ben", 403},
+		{"org admin without role", "eve", "/projects/web/members/dan", 403},
+		{"non member caller", "hal", "/projects/web/members/dan", 404},
+		{"other org", "gus", "/projects/web/members/dan", 404},
+		{"target not a member", "ann", "/projects/web/members/hal", 404},
+		{"target unknown user", "ann", "/projects/web/members/zed", 404},
+		{"archived", "ann", "/projects/legacy/members/ben", 409},
+		{"anonymous", "", "/projects/web/members/dan", 401},
+		{"unknown user", "zed", "/projects/web/members/dan", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveMemberUnassignsTasksAndRevokesAccess(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+
+	assignee := func(path string) string {
+		t.Helper()
+		code, body := do(t, h, "GET", path, "ann", "")
+		if code != 200 {
+			t.Fatalf("GET %s: got %d want 200", path, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		return task.AssigneeID
+	}
+	// ben's task in web is unassigned; cat's task keeps its assignee.
+	if got := assignee("/projects/web/tasks/t1"); got != "" {
+		t.Fatalf("t1 assignee = %q, want unassigned", got)
+	}
+	if got := assignee("/projects/web/tasks/t2"); got != "cat" {
+		t.Fatalf("t2 assignee = %q, want cat", got)
+	}
+	// ben's task in another project is untouched.
+	if got := assignee("/projects/legacy/tasks/t5"); got != "ben" {
+		t.Fatalf("t5 assignee = %q, want ben", got)
+	}
+
+	// ben can no longer read the project, and removing ben again is 404.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("removed member read: got %d want 404", code)
+	}
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 404 {
+		t.Fatalf("second remove: got %d want 404", code)
+	}
+}
