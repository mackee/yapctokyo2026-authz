+// moveMemberAggregate moves one member from one project to another, keeping
+// the role.
+type moveMemberAggregate struct {
+	from       *Project
+	to         *Project
+	membership *Membership // the member's membership in from
+	user       *User       // the member
+	assigned   []*Task     // tasks of from assigned to the member
+	existing   *Membership // the member's membership in to; nil if none
+}
+
+func loadMoveMember(ctx context.Context, tx DB, fromID, userID, toID string) (*moveMemberAggregate, error) {
+	from, err := NewProjectTable().Find(ctx, tx, fromID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	to, err := NewProjectTable().Find(ctx, tx, toID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	m, err := from.Membership(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	u, err := m.User(ctx, tx)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveMemberAggregate{from: from, to: to, membership: m, user: u}
+	if a.assigned, err = m.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	if from.ID != to.ID {
+		e, err := to.Membership(ctx, tx, userID)
+		if err == nil {
+			a.existing = e
+		} else if !errors.Is(err, ErrNoRows) {
+			return nil, err
+		}
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.from.ID == a.to.ID {
+		return deny(ErrInvalid, "the destination must be a different project")
+	}
+	if a.existing != nil {
+		return deny(ErrInvalid, "the user is already a member of the destination project")
+	}
+	if a.user.Org != a.to.Org {
+		return deny(ErrInvalid, "project members must belong to the project's organization")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	// The member leaves the project, so the tasks assigned to them become
+	// unassigned (an assignee must be a contributor or manager of the project).
+	for _, t := range a.assigned {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.membership.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	m := a.to.newMembership(a.membership.UserID, a.membership.Role)
+	if err := m.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
+
