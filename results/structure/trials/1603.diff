+// Move moves the user from the project of authz to the destination project,
+// keeping the role. The actor must be a manager of both projects, neither
+// archived. Tasks assigned to the user in the source project are unassigned.
+// A destination the actor cannot read is ErrNotFound.
+func (*MembershipTable) Move(ctx context.Context, db DB, authz ProjectAuthz, userID, toProjectID string) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	destAuthz, err := NewProjectAuthz(ctx, db, authz.Actor(), toProjectID)
+	if err != nil {
+		return nil, err
+	}
+	if err := destAuthz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var moved *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveMember(ctx, tx, authz.ProjectID(), userID, destAuthz.ProjectID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if moved, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return moved, nil
+}
