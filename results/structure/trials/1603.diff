+// moveMemberAggregate moves one member from a project to another, keeping the
+// role. Tasks assigned to the member in the source project are unassigned,
+// because the member stops being a contributor or manager there.
+type moveMemberAggregate struct {
+	source   *Project
+	dest     *Project
+	member   *Membership // the member's membership in source
+	user     *User       // member.User
+	existing *Membership // the user's membership in dest, nil if none
+	tasks    []*Task     // member.AssignedTasks
+}
+
+func loadMoveMember(ctx context.Context, tx DB, sourceID, userID, destID string) (*moveMemberAggregate, error) {
+	src, err := NewProjectTable().Find(ctx, tx, sourceID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	dst, err := NewProjectTable().Find(ctx, tx, destID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	m, err := src.Membership(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	u, err := m.User(ctx, tx)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveMemberAggregate{source: src, dest: dst, member: m, user: u}
+	if a.existing, err = dst.Membership(ctx, tx, userID); errors.Is(err, ErrNoRows) {
+		a.existing = nil
+	} else if err != nil {
+		return nil, err
+	}
+	if a.tasks, err = m.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.source.ID == a.dest.ID {
+		return deny(ErrInvalid, "destination must be a different project")
+	}
+	if a.user.Org != a.dest.Org {
+		return deny(ErrInvalid, "member must belong to the destination project's organization")
+	}
+	if a.existing != nil {
+		return deny(ErrInvalid, "user is already a member of the destination project")
+	}
+	switch a.member.Role {
+	case RoleManager, RoleContributor, RoleViewer:
+	default:
+		return deny(ErrInvalid, "invalid role")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.member.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	moved := a.dest.newMembership(a.member.UserID, a.member.Role)
+	if err := moved.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return moved, nil
+}
