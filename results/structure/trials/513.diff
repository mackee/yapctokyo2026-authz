+// ---- operations -----------------------------------------------------------------------
+
+// MembershipTableUpdateRolesInput is the input of MembershipTable.UpdateRoles.
+type MembershipTableUpdateRolesInput struct {
+	Roles map[string]string // user ID -> new role
+}
+
+// UpdateRoles changes the roles of the named members of the project, all or
+// nothing. It returns the project's members after the change, ordered by user
+// ID. Only managers may do this (CanManageMembers).
+func (mt *MembershipTable) UpdateRoles(ctx context.Context, db DB, authz ProjectAuthz, in MembershipTableUpdateRolesInput) ([]*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var out []*Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadUpdateRoles(ctx, tx, authz.ProjectID(), in)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		out, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
