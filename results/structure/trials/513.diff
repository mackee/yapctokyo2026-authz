+func TestUpdateMembers(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager", "ann", "web", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 200},
+		{"manager sets manager", "ann", "web", `{"roles":{"cat":"manager"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"cat":"viewer"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"cat":"viewer"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"cat":"viewer"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"target not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"invalid role", "ann", "web", `{"roles":{"ben":"owner"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"malformed body", "ann", "web", `{"roles":`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMembersReturnsMembersAndChangesRoles(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var members []Member
+	if err := json.Unmarshal([]byte(body), &members); err != nil {
+		t.Fatal(err)
+	}
+	want := []Member{
+		{UserID: "ann", Role: "manager"},
+		{UserID: "ben", Role: "viewer"},
+		{UserID: "cat", Role: "contributor"},
+		{UserID: "dan", Role: "contributor"},
+		{UserID: "ivy", Role: "manager"},
+	}
+	if len(members) != len(want) {
+		t.Fatalf("got %d members, want %d: %s", len(members), len(want), body)
+	}
+	for i := range want {
+		if members[i] != want[i] {
+			t.Fatalf("member %d: got %+v want %+v", i, members[i], want[i])
+		}
+	}
+
+	// dan is a contributor now, so may create tasks.
+	if code, body := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("dan create after promotion: got %d: %s", code, body)
+	}
+	// ben is a viewer now, so may no longer write.
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 403 {
+		t.Fatalf("ben update after demotion: got %d want 403", code)
+	}
+}
+
+func TestUpdateMembersUnassignsDemotedMembersTasks(t *testing.T) {
+	h := newServer()
+	// ben holds t1 in web as a contributor.
+	if code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer"}}`); code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "" {
+		t.Fatalf("t1 still assigned to %q after ben became a viewer", task.AssigneeID)
+	}
+	// ben's task in another project is not touched by a change in web.
+	code, body = do(t, h, "GET", "/projects/legacy/tasks/t5", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "ben" {
+		t.Fatalf("t5 in legacy: assignee %q, want ben", task.AssigneeID)
+	}
+}
+
+func TestUpdateMembersIsAllOrNothing(t *testing.T) {
+	h := newServer()
+	// hal is not a member of web: the whole request is refused.
+	if code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","hal":"viewer"}}`); code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	// Nothing changed: ben still holds t1, which a demotion would have cleared.
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "ben" {
+		t.Fatalf("t1 assignee %q after refused request, want ben", task.AssigneeID)
+	}
+	if code, body := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 200 {
+		t.Fatalf("ben should still be a contributor: got %d: %s", code, body)
+	}
+}
