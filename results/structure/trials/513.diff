+// updateRolesAggregate changes the roles of some members of one project.
+type updateRolesAggregate struct {
+	project *Project
+	// user ID -> new role
+	roles map[string]string
+	// user ID -> membership, for every user in roles
+	members map[string]*Membership
+}
+
+func loadUpdateRoles(ctx context.Context, tx DB, projectID string, in MembershipTableUpdateRolesInput) (*updateRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &updateRolesAggregate{project: p, roles: in.Roles, members: map[string]*Membership{}}
+	for userID := range in.Roles {
+		m, err := p.Membership(ctx, tx, userID)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "roles must name members of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		a.members[userID] = m
+	}
+	return a, nil
+}
+
+func (a *updateRolesAggregate) validate() error {
+	if len(a.roles) == 0 {
+		return deny(ErrInvalid, "roles must not be empty")
+	}
+	for _, role := range a.roles {
+		if !validRoles[role] {
+			return deny(ErrInvalid, "role must be manager, contributor or viewer")
+		}
+	}
+	return nil
+}
+
+// apply changes the roles and returns the project's members after the change.
+// A member who stops being a contributor or manager cannot stay the assignee
+// of a task, so their tasks in the project are unassigned first.
+func (a *updateRolesAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	userIDs := make([]string, 0, len(a.roles))
+	for userID := range a.roles {
+		userIDs = append(userIDs, userID)
+	}
+	sort.Strings(userIDs)
+	for _, userID := range userIDs {
+		m := a.members[userID]
+		role := a.roles[userID]
+		if !isWriterRole(role) {
+			tasks, err := m.AssignedTasks(ctx, tx)
+			if err != nil {
+				return nil, err
+			}
+			for _, t := range tasks {
+				if err := t.unassign(ctx, tx); err != nil {
+					return nil, err
+				}
+			}
+		}
+		if err := m.changeRole(ctx, tx, role); err != nil {
+			return nil, err
+		}
+	}
+	return NewMembershipTable().ListByProject(ctx, tx, a.project.ID)
+}
+
