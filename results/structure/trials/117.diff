 // ---- project capabilities ----------------------------------------------------
 
 // ReadProject may list and read the tasks of one project.
@@ -219,6 +244,35 @@ type WriteProject interface {
 	CreateTask(title string, assignee Assignee) (TaskView, error)
 }
 
+// ManageProject is the manager-only capability for one project's membership.
+type ManageProject interface {
+	ReadProject
+	// RemoveMember removes userID from the project. Tasks the user was assigned
+	// in this project become unassigned. A user who is not a member is 404.
+	RemoveMember(userID string) error
+}
+
+type manageProject struct {
+	readProject
+	role string
+}
+
+func (p *manageProject) RemoveMember(userID string) error {
+	return p.ps.as.a.st.tx(func(s *state) error {
+		if _, ok := s.members[p.ps.pid][userID]; !ok {
+			return deny(ErrNotFound, "not found")
+		}
+		delete(s.members[p.ps.pid], userID)
+		for tid, t := range s.tasks {
+			if t.project == p.ps.pid && t.assignee.user == userID {
+				t.assignee = Assignee{project: p.ps.pid}
+				s.tasks[tid] = t
+			}
+		}
+		return nil
+	})
+}
+
 type readProject struct{ ps *projectScope }
 
 func (p *readProject) ID() string { return p.ps.pid }
