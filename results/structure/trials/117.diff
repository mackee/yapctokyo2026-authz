+func removeMember(ctx tanukirpc.Context[*projectRegistry], _ struct{}) (*struct{}, error) {
+	m, err := ctx.Registry().scope.Manage()
+	if err != nil {
+		return nil, err
+	}
+	if err := m.RemoveMember(chi.URLParam(ctx.Request(), "uid")); err != nil {
+		return nil, err
+	}
+	ctx.Response().WriteHeader(http.StatusNoContent)
+	return nil, nil
+}
