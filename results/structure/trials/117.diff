+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager removes contributor", "ann", "/projects/web/members/cat", 204},
+		{"manager removes viewer", "ann", "/projects/web/members/dan", 204},
+		{"manager removes self", "ivy", "/projects/ops/members/ivy", 204},
+		{"contributor", "ben", "/projects/web/members/cat", 403},
+		{"contributor self", "ben", "/projects/web/members/ben", 403},
+		{"viewer", "dan", "/projects/web/members/ben", 403},
+		{"org admin", "eve", "/projects/web/members/cat", 403},
+		{"non member caller", "hal", "/projects/web/members/cat", 404},
+		{"other org caller", "gus", "/projects/web/members/ben", 404},
+		{"anonymous", "", "/projects/web/members/cat", 401},
+		{"unknown caller", "zed", "/projects/web/members/cat", 401},
+		{"target not a member", "ann", "/projects/web/members/hal", 404},
+		{"target in other org", "ann", "/projects/web/members/gus", 404},
+		{"unknown project", "ann", "/projects/nope/members/cat", 404},
+		{"archived", "ann", "/projects/legacy/members/ben", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveMemberEffects(t *testing.T) {
+	h := newServer()
+
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/cat", "ann", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+
+	// The removed user loses access to the project.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 404 {
+		t.Fatalf("removed user read: got %d want 404", code)
+	}
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/cat", "ann", ""); code != 404 {
+		t.Fatalf("second remove: got %d want 404", code)
+	}
+
+	// Tasks assigned to the removed user are unassigned, others are untouched.
+	code, body := do(t, h, "GET", "/projects/web/tasks/t2", "ann", "")
+	if code != 200 {
+		t.Fatalf("get t2: got %d", code)
+	}
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" {
+		t.Fatalf("t2 assignee = %q, want unassigned", task.Assignee)
+	}
+	code, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	json.Unmarshal([]byte(body), &task)
+	if code != 200 || task.Assignee != "ben" {
+		t.Fatalf("t1: got %d assignee %q, want 200 ben", code, task.Assignee)
+	}
+
+	// Membership is per project: cat is still a contributor of ops.
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat in ops: got %d want 200", code)
+	}
+}
