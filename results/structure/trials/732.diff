+// Member is the JSON shape of a project membership's role change.
+type Member struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+type updateMemberRequest struct {
+	Role string `json:"role" validate:"required,oneof=manager contributor viewer"`
+}
+
+func updateMemberRole(ctx tanukirpc.Context[*projectRegistry], req updateMemberRequest) (*Member, error) {
+	reg := ctx.Registry()
+	uid := chi.URLParam(ctx.Request(), "uid")
+	m, err := model.NewMembershipTable().UpdateRole(ctx, reg.db, reg.authz, model.MembershipTableUpdateRoleInput{UserID: uid, Role: req.Role})
+	if err != nil {
+		return nil, err
+	}
+	return &Member{UserID: m.UserID, Role: m.Role}, nil
+}
