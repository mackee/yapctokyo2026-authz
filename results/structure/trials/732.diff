+// updateMembershipAggregate changes the role of one project member.
+type updateMembershipAggregate struct {
+	membership *Membership
+	role       string
+	assigned   []*Task // the member's tasks in the project
+}
+
+func loadUpdateMembership(ctx context.Context, tx DB, projectID string, in MembershipTableUpdateRoleInput) (*updateMembershipAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if err != nil {
+		return nil, err
+	}
+	m, err := p.Membership(ctx, tx, in.UserID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &updateMembershipAggregate{membership: m, role: in.Role}
+	if a.role == RoleViewer {
+		if a.assigned, err = m.AssignedTasks(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	return a, nil
+}
+
+func (a *updateMembershipAggregate) validate() error {
+	if a.role == RoleViewer && len(a.assigned) > 0 {
+		return deny(ErrInvalid, "member has tasks assigned in the project; reassign them before making the member a viewer")
+	}
+	return nil
+}
+
+func (a *updateMembershipAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.membership.setRole(ctx, tx, a.role); err != nil {
+		return nil, err
+	}
+	return a.membership, nil
+}
