@@ -59,3 +64,23 @@ func (*MembershipTable) ListByUser(ctx context.Context, db DB, userID string) ([
 	sort.Slice(out, func(i, j int) bool { return out[i].ProjectID < out[j].ProjectID })
 	return out, nil
 }
+
+// ---- operations -----------------------------------------------------------------------
+
+// Delete removes the user from the project's members. The user's tasks in the
+// project are unassigned in the same transaction.
+func (*MembershipTable) Delete(ctx context.Context, db DB, authz ProjectAuthz, userID string) error {
+	if err := authz.CanManageMembers(); err != nil {
+		return err
+	}
+	return db.update(ctx, func(x *Tx) error {
+		agg, err := loadDeleteMembership(ctx, x, authz.ProjectID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, x)
+	})
+}
