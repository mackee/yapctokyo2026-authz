 func (a *deleteTaskAggregate) apply(ctx context.Context, x *Tx) error { return a.task.destroy(ctx, x) }
+
+// deleteMembershipAggregate removes one user from one project. The user's tasks
+// in the project are unassigned, so that no task keeps an assignee who is no
+// longer a member (model rule: an assignee is a member of the task's project).
+type deleteMembershipAggregate struct {
+	membership *Membership
+	assigned   []*Task // the project's tasks assigned to the member
+}
+
+func loadDeleteMembership(ctx context.Context, x *Tx, projectID, userID string) (*deleteMembershipAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, x, projectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	tasks, err := m.AssignedTasks(ctx, x)
+	if err != nil {
+		return nil, err
+	}
+	return &deleteMembershipAggregate{membership: m, assigned: tasks}, nil
+}
+
+func (a *deleteMembershipAggregate) validate() error { return nil }
+
+func (a *deleteMembershipAggregate) apply(ctx context.Context, x *Tx) error {
+	for _, t := range a.assigned {
+		if err := t.unassign(ctx, x); err != nil {
+			return err
+		}
+	}
+	return a.membership.destroy(ctx, x)
+}
