+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager removes contributor", "ann", "/projects/web/members/ben", 204},
+		{"manager removes viewer", "ann", "/projects/web/members/dan", 204},
+		{"contributor", "ben", "/projects/web/members/cat", 403},
+		{"viewer", "dan", "/projects/web/members/ben", 403},
+		{"org admin", "eve", "/projects/web/members/ben", 403},
+		{"non member", "hal", "/projects/web/members/ben", 404},
+		{"other org", "gus", "/projects/web/members/ben", 404},
+		{"anonymous", "", "/projects/web/members/ben", 401},
+		{"target not a member", "ann", "/projects/web/members/hal", 404},
+		{"target unknown", "ann", "/projects/web/members/zed", 404},
+		{"archived", "ann", "/projects/legacy/members/ben", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveMemberEffects(t *testing.T) {
+	srv := newServer()
+
+	// ben is the assignee of t1 in web; cat is the assignee of t2.
+	code, _ := do(t, srv, "DELETE", "/projects/web/members/ben", "ann", "")
+	if code != 204 {
+		t.Fatalf("remove ben: got %d want 204", code)
+	}
+
+	// ben is no longer a member: the project is not readable for ben.
+	code, _ = do(t, srv, "GET", "/projects/web/tasks", "ben", "")
+	if code != 404 {
+		t.Fatalf("ben after removal: got %d want 404", code)
+	}
+
+	// Removing again: the membership is gone.
+	code, _ = do(t, srv, "DELETE", "/projects/web/members/ben", "ann", "")
+	if code != 404 {
+		t.Fatalf("second remove: got %d want 404", code)
+	}
+
+	// t1 is unassigned; t2 keeps its assignee.
+	code, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("get t1: got %d want 200", code)
+	}
+	var t1 Task
+	if err := json.Unmarshal([]byte(body), &t1); err != nil {
+		t.Fatal(err)
+	}
+	if t1.AssigneeID != "" {
+		t.Fatalf("t1 assignee = %q, want unassigned", t1.AssigneeID)
+	}
+	if t1.Title != "Fix header" || t1.Status != "open" {
+		t.Fatalf("t1 changed beyond its assignee: %+v", t1)
+	}
+
+	code, body = do(t, srv, "GET", "/projects/web/tasks/t2", "ann", "")
+	if code != 200 {
+		t.Fatalf("get t2: got %d want 200", code)
+	}
+	var t2 Task
+	if err := json.Unmarshal([]byte(body), &t2); err != nil {
+		t.Fatal(err)
+	}
+	if t2.AssigneeID != "cat" {
+		t.Fatalf("t2 assignee = %q, want cat", t2.AssigneeID)
+	}
+
+	// The task of ben in another project is untouched.
+	code, body = do(t, srv, "GET", "/projects/legacy/tasks/t5", "ann", "")
+	if code != 200 {
+		t.Fatalf("get t5: got %d want 200", code)
+	}
+	var t5 Task
+	if err := json.Unmarshal([]byte(body), &t5); err != nil {
+		t.Fatal(err)
+	}
+	if t5.AssigneeID != "ben" {
+		t.Fatalf("t5 assignee = %q, want ben", t5.AssigneeID)
+	}
+}
