+type updateMembersRequest struct {
+	Roles map[string]string `json:"roles"`
+}
+
+// updateMembers changes several members' roles atomically: every entry is
+// validated first, and nothing is applied unless all of them are valid.
+func (s *server) updateMembers(w http.ResponseWriter, r *http.Request) {
+	s.store.mu.Lock()
+	defer s.store.mu.Unlock()
+
+	user := s.store.User(r.Header.Get("X-User"))
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project := s.store.Project(r.PathValue("pid"))
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role := s.store.Role(project.ID, user.ID)
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "only managers may change member roles")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req updateMembersRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || len(req.Roles) == 0 {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	managers := 0
+	for uid, cur := range s.store.members[project.ID] {
+		newRole, changing := req.Roles[uid]
+		if !changing {
+			newRole = cur
+		}
+		if newRole == RoleManager {
+			managers++
+		}
+	}
+	for uid, newRole := range req.Roles {
+		if !validRole(newRole) {
+			writeError(w, 400, "invalid role for "+uid)
+			return
+		}
+		if s.store.Role(project.ID, uid) == "" {
+			writeError(w, 400, uid+" is not a member of the project")
+			return
+		}
+	}
+	if managers == 0 {
+		writeError(w, 400, "project must keep at least one manager")
+		return
+	}
+	for uid, newRole := range req.Roles {
+		s.store.members[project.ID][uid] = newRole
+	}
+	writeJSON(w, 200, s.store.Members(project.ID))
+}
+
 func writeJSON(w http.ResponseWriter, code int, v any) {
