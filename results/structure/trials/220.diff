+type Member struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func validRole(r string) bool {
+	return r == RoleManager || r == RoleContributor || r == RoleViewer
+}
+
+// Members returns the project's members sorted by user ID.
+func (s *Store) Members(projectID string) []Member {
+	out := []Member{}
+	for uid, role := range s.members[projectID] {
+		out = append(out, Member{UserID: uid, Role: role})
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].UserID < out[j].UserID })
+	return out
+}
