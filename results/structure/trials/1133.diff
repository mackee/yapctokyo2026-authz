+func TestUpdateMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager demotes", "ann", "/projects/web/members/ivy", `{"role":"viewer"}`, 200},
+		{"manager promotes", "ann", "/projects/web/members/ben", `{"role":"manager"}`, 200},
+		{"manager same role", "ann", "/projects/web/members/ben", `{"role":"contributor"}`, 200},
+		{"demote with assigned tasks", "ann", "/projects/web/members/cat", `{"role":"viewer"}`, 409},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"contributor", "ben", "/projects/web/members/cat", `{"role":"viewer"}`, 403},
+		{"viewer", "dan", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"org admin", "eve", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"non member", "hal", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"cross org caller", "gus", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"anonymous", "", "/projects/web/members/ben", `{"role":"viewer"}`, 401},
+		{"unknown caller", "zed", "/projects/web/members/ben", `{"role":"viewer"}`, 401},
+		{"missing project", "ann", "/projects/missing/members/ben", `{"role":"viewer"}`, 404},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"target in other org", "ann", "/projects/web/members/gus", `{"role":"viewer"}`, 404},
+		{"unknown target", "ann", "/projects/web/members/zed", `{"role":"viewer"}`, 404},
+		{"invalid role", "ann", "/projects/web/members/ben", `{"role":"admin"}`, 400},
+		{"missing role", "ann", "/projects/web/members/ben", `{}`, 400},
+		{"invalid json", "ann", "/projects/web/members/ben", `{"role":`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRoleResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members/ivy", "ann", `{"role":"viewer"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+	var got memberResponse
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.UserID != "ivy" || got.Role != "viewer" {
+		t.Fatalf("got %+v", got)
+	}
+}
+
+func TestUpdateMemberRolePersists(t *testing.T) {
+	h := newServer()
+
+	// ivy is a web manager; after demotion she can read but not write.
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ivy", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ivy", ""); code != 200 {
+		t.Fatalf("read after demote: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ivy", `{"title":"x"}`); code != 403 {
+		t.Fatalf("create after demote: got %d want 403", code)
+	}
+
+	// ben is promoted to manager, so he may now delete any task in web.
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"manager"}`); code != 200 {
+		t.Fatalf("promote: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "DELETE", "/projects/web/tasks/t2", "ben", ""); code != 204 {
+		t.Fatalf("delete after promote: got %d want 204", code)
+	}
+}
+
+func TestRejectedDemotionKeepsRole(t *testing.T) {
+	h := newServer()
+
+	// cat holds t2 in web, so the demotion is refused and cat stays a contributor.
+	if code, _ := do(t, h, "PUT", "/projects/web/members/cat", "ann", `{"role":"viewer"}`); code != 409 {
+		t.Fatalf("got %d want 409", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "cat", `{"title":"x"}`); code != 200 {
+		t.Fatalf("cat create after refused demotion: got %d want 200", code)
+	}
+}
