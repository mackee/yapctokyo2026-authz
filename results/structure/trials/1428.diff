+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"missing project", "ann", "missing", 404},
+		{"anonymous", "", "web", 401},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreeze(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got []struct{ UserID, Role string }
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []string{"ann", "ben", "cat", "dan", "ivy"}
+	if len(got) != len(want) {
+		t.Fatalf("got %s", body)
+	}
+	for i, m := range got {
+		if m.UserID != want[i] || m.Role != "viewer" {
+			t.Fatalf("got %s", body)
+		}
+	}
+	if !strings.Contains(body, `"userId":"ann","role":"viewer"`) {
+		t.Fatalf("unexpected shape: %s", body)
+	}
+
+	// Nobody can change tasks any more, not even the former manager.
+	for _, c := range []struct{ user, method, path, body string }{
+		{"ann", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"ivy", "DELETE", "/projects/web/tasks/t3", ""},
+		{"ann", "POST", "/projects/web/freeze", ""},
+	} {
+		if code, _ := do(t, h, c.method, c.path, c.user, c.body); code != 403 {
+			t.Fatalf("%s %s by %s: got %d want 403", c.method, c.path, c.user, code)
+		}
+	}
+
+	// Tasks are unassigned (an assignee must be a writer); reads still work.
+	code, body = do(t, h, "GET", "/projects/web/tasks", "dan", "")
+	if code != 200 {
+		t.Fatal(code)
+	}
+	var tasks []Task
+	json.Unmarshal([]byte(body), &tasks)
+	for _, task := range tasks {
+		if task.AssigneeID != "" {
+			t.Fatalf("task %s still assigned to %s", task.ID, task.AssigneeID)
+		}
+	}
+
+	// Other projects are untouched.
+	if code, _ := do(t, h, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ops task: got %d want 200", code)
+	}
+}
