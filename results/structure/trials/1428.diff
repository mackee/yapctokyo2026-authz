+// freezeProjectAggregate makes every member of one project a viewer. An
+// assignee must be a contributor or manager, so the project's tasks are
+// unassigned in the same transaction.
+type freezeProjectAggregate struct {
+	project *Project
+	members []*Membership
+	tasks   []*Task
+}
+
+func loadFreezeProject(ctx context.Context, tx DB, projectID string) (*freezeProjectAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	ms, err := p.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	ts, err := p.Tasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &freezeProjectAggregate{project: p, members: ms, tasks: ts}, nil
+}
+
+func (a *freezeProjectAggregate) validate() error { return nil }
+
+func (a *freezeProjectAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for _, m := range a.members {
+		if err := m.demote(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	for _, t := range a.tasks {
+		if t.AssigneeID == "" {
+			continue
+		}
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	return a.members, nil
+}
+
