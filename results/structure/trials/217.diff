+// OrgExists reports whether any user or project belongs to the organization.
+func (s *Store) OrgExists(orgID string) bool {
+	for _, u := range s.users {
+		if u.OrgID == orgID {
+			return true
+		}
+	}
+	for _, p := range s.projects {
+		if p.OrgID == orgID {
+			return true
+		}
+	}
+	return false
+}
+
+// TransferUser moves a user to another organization. Everything that was
+// scoped to the old organization is dropped: project roles, task assignments
+// and the org-admin flag, so nothing leaks into (or is resurrected by) an org.
+func (s *Store) TransferUser(u *User, toOrgID string) {
+	for _, m := range s.members {
+		delete(m, u.ID)
+	}
+	for _, t := range s.tasks {
+		if t.Assignee == u.ID {
+			t.Assignee = ""
+		}
+	}
+	u.OrgID = toOrgID
+	u.OrgAdmin = false
+}
