diff --git a/internal/model/membership_table.go b/internal/model/membership_table.go
index 3e01344..f74e0c1 100644
--- a/internal/model/membership_table.go
+++ b/internal/model/membership_table.go
@@ -2,6 +2,26 @@ package model
 
 import "context"
 
+// ---- operations -----------------------------------------------------------------------
+
+// Remove removes the user from the project and unassigns the user's tasks in
+// the project, all or nothing. The user must be a member; otherwise ErrNotFound.
+func (*MembershipTable) Remove(ctx context.Context, db DB, authz ProjectAuthz, userID string) error {
+	if err := authz.CanManageMembers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveMember(ctx, tx, authz.ProjectID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
+
 // MembershipTable reads the memberships table.
 type MembershipTable struct{}
 
