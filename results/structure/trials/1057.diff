+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager removes contributor", "ann", "/projects/web/members/ben", 204},
+		{"manager removes viewer", "ann", "/projects/web/members/dan", 204},
+		{"contributor", "ben", "/projects/web/members/cat", 403},
+		{"viewer", "dan", "/projects/web/members/cat", 403},
+		{"org admin", "eve", "/projects/web/members/cat", 403},
+		{"archived", "ann", "/projects/legacy/members/ben", 409},
+		{"not a member of project", "ann", "/projects/web/members/hal", 404},
+		{"user of other org", "ann", "/projects/web/members/gus", 404},
+		{"unknown user", "ann", "/projects/web/members/zed", 404},
+		{"non member caller", "hal", "/projects/web/members/ben", 404},
+		{"other org caller", "gus", "/projects/web/members/ben", 404},
+		{"anonymous", "", "/projects/web/members/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveMemberRevokesAccessAndUnassigns(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "DELETE", "/projects/web/members/ben", "ann", ""); code != 204 {
+		t.Fatalf("remove: got %d body=%s", code, body)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("removed member still reads project: got %d", code)
+	}
+	if code, _ := do(t, srv, "DELETE", "/projects/web/members/ben", "ann", ""); code != 404 {
+		t.Fatalf("second remove: got %d want 404", code)
+	}
+	code, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("get task: got %d", code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "" {
+		t.Fatalf("t1 still assigned to %q after its assignee was removed", task.AssigneeID)
+	}
+	// Other projects are untouched: ben is still a contributor of legacy.
+	if code, _ := do(t, srv, "GET", "/projects/legacy/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben lost legacy: got %d", code)
+	}
+}
