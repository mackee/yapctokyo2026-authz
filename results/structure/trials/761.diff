+// CanMoveMemberTo returns nil if the actor may move a member from this project
+// to dst: the actor must be a manager of both projects (else ErrForbidden), and
+// neither project may be archived (else ErrArchived).
+func (a ProjectAuthz) CanMoveMemberTo(dst ProjectAuthz) error {
+	if !a.CanRead() || a.role != RoleManager || !dst.CanRead() || dst.role != RoleManager {
+		return deny(ErrForbidden, "forbidden")
+	}
+	if a.archived || dst.archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	return nil
+}
