+// Move moves the user's membership from the authorized project to the
+// destination project, keeping the role. Only managers of both projects may
+// move a member. All or nothing.
+func (*MembershipTable) Move(ctx context.Context, db DB, src ProjectAuthz, toProjectID, userID string) (*Membership, error) {
+	dst, err := NewProjectAuthz(ctx, db, src.Actor(), toProjectID)
+	if err != nil {
+		return nil, err
+	}
+	if err := src.CanMoveMemberTo(dst); err != nil {
+		return nil, err
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveMember(ctx, tx, src.ProjectID(), toProjectID, userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if m, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
