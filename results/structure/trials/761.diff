+// moveMemberAggregate moves one member from the source project to the
+// destination project.
+type moveMemberAggregate struct {
+	from *Membership // the member in the source project
+	dst  *Project    // the destination project
+	user *User
+}
+
+func loadMoveMember(ctx context.Context, tx DB, srcProjectID, dstProjectID, userID string) (*moveMemberAggregate, error) {
+	if srcProjectID == dstProjectID {
+		return nil, deny(ErrInvalid, "destination must be a different project")
+	}
+	from, err := NewMembershipTable().Find(ctx, tx, srcProjectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	_, err = NewMembershipTable().Find(ctx, tx, dstProjectID, userID)
+	if err == nil {
+		return nil, deny(ErrInvalid, "user is already a member of the destination project")
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	dst, err := NewProjectTable().Find(ctx, tx, dstProjectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "destination project does not exist")
+	} else if err != nil {
+		return nil, err
+	}
+	user, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	// The member's tasks in the source project would be left assigned to a
+	// non-member, which breaks the assignee rule. Reassign them first.
+	tasks, err := NewTaskTable().ListByProjectAndAssignee(ctx, tx, srcProjectID, userID)
+	if err != nil {
+		return nil, err
+	}
+	if len(tasks) > 0 {
+		return nil, deny(ErrInvalid, "member has tasks assigned in the source project; reassign them first")
+	}
+	return &moveMemberAggregate{from: from, dst: dst, user: user}, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.user.Org != a.dst.Org {
+		return deny(ErrInvalid, "project members must belong to the project's organization")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.from.remove(ctx, tx); err != nil {
+		return nil, err
+	}
+	to := &Membership{ProjectID: a.dst.ID, UserID: a.from.UserID, Role: a.from.Role}
+	if err := to.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return to, nil
+}
+
