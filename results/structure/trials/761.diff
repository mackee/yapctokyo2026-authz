@@ -0,0 +1,117 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestMoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		// who may move: managers of both the source and the destination
+		{"source manager only", "ann", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 403},
+		{"contributor in source, not readable destination", "ben", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 404},
+		{"contributor in both", "cat", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin", "eve", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 403},
+		{"source unreadable", "hal", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 404},
+		{"destination unreadable", "ivy", "/projects/web/members/dan/move", `{"toProjectId":"gx"}`, 404},
+		{"destination missing", "ivy", "/projects/web/members/dan/move", `{"toProjectId":"nope"}`, 404},
+		{"anonymous", "", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 401},
+		{"unknown user", "zed", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 401},
+
+		// request and rules
+		{"missing destination", "ivy", "/projects/web/members/dan/move", `{}`, 400},
+		{"same project", "ivy", "/projects/web/members/dan/move", `{"toProjectId":"web"}`, 400},
+		{"user not in source", "ivy", "/projects/web/members/eve/move", `{"toProjectId":"ops"}`, 404},
+		{"already in destination", "ivy", "/projects/web/members/ann/move", `{"toProjectId":"ops"}`, 400},
+		{"tasks assigned in source", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 400},
+		{"archived destination", "ann", "/projects/web/members/dan/move", `{"toProjectId":"legacy"}`, 409},
+		{"archived source", "ann", "/projects/legacy/members/ben/move", `{"toProjectId":"web"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestMoveMemberResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/members/dan/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got struct {
+		UserID    string `json:"userId"`
+		ProjectID string `json:"projectId"`
+		Role      string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.UserID != "dan" || got.ProjectID != "ops" || got.Role != "viewer" {
+		t.Fatalf("got %+v", got)
+	}
+}
+
+func TestMoveMemberChangesAccess(t *testing.T) {
+	srv := newServer()
+
+	// dan is a viewer of web; after the move he reads ops and not web.
+	if code, body := do(t, srv, "POST", "/projects/web/members/dan/move", "ivy", `{"toProjectId":"ops"}`); code != 200 {
+		t.Fatalf("move: got %d body=%s", code, body)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "dan", ""); code != 200 {
+		t.Fatalf("dan reads ops: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "dan", ""); code != 404 {
+		t.Fatalf("dan reads web: got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/members/dan/move", "ivy", `{"toProjectId":"ops"}`); code != 404 {
+		t.Fatalf("move again from web: got %d want 404", code)
+	}
+}
+
+func TestMoveMemberKeepsContributorRole(t *testing.T) {
+	srv := newServer()
+
+	// ben is a contributor of web with one task (t1). Reassign it, then move him.
+	if code, body := do(t, srv, "PATCH", "/projects/web/tasks/t1", "ivy", `{"assignee":""}`); code != 200 {
+		t.Fatalf("unassign: got %d body=%s", code, body)
+	}
+	code, body := do(t, srv, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d body=%s", code, body)
+	}
+	var got struct {
+		Role string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.Role != "contributor" {
+		t.Fatalf("role: got %q want contributor", got.Role)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben reads ops: got %d want 200", code)
+	}
+}
+
+func TestMoveMemberRejectedChangesNothing(t *testing.T) {
+	srv := newServer()
+
+	// ben still has t1 in web, so the move is rejected and ben stays in web.
+	if code, _ := do(t, srv, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`); code != 400 {
+		t.Fatalf("move: got %d want 400", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben reads web: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads ops: got %d want 404", code)
+	}
+}
