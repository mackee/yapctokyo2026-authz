index 0000000..da4d8cb
--- /dev/null
+++ b/move_test.go
@@ -0,0 +1,69 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"viewer in source", "dan", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"contributor other's task", "cat", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 403},
+		{"manager source, viewer target", "ann", "/projects/web/tasks/t2/move", `{"toProjectId":"ops"}`, 403},
+		{"target not readable", "ben", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 404},
+		{"target missing", "ivy", "/projects/web/tasks/t2/move", `{"toProjectId":"nope"}`, 404},
+		{"target other org", "ivy", "/projects/web/tasks/t2/move", `{"toProjectId":"gx"}`, 404},
+		{"target archived", "ann", "/projects/web/tasks/t1/move", `{"toProjectId":"legacy"}`, 409},
+		{"source archived", "ann", "/projects/legacy/tasks/t5/move", `{"toProjectId":"web"}`, 409},
+		{"same project", "ivy", "/projects/web/tasks/t2/move", `{"toProjectId":"web"}`, 400},
+		{"missing target", "ivy", "/projects/web/tasks/t2/move", `{}`, 400},
+		{"org admin", "eve", "/projects/ops/tasks/t4/move", `{"toProjectId":"web"}`, 403},
+		{"cross project task id", "ivy", "/projects/web/tasks/t4/move", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/tasks/t2/move", `{"toProjectId":"ops"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsTaskFields(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got Task
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", Assignee: "cat"}
+	if got != want {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+
+	// The task now belongs to ops: it is listed there and gone from web.
+	_, body = do(t, h, "GET", "/projects/ops/tasks", "ivy", "")
+	var ops []Task
+	json.Unmarshal([]byte(body), &ops)
+	found := false
+	for _, task := range ops {
+		if task.ID == "t2" {
+			found = true
+		}
+	}
+	if !found {
+		t.Fatalf("t2 not listed in ops: %s", body)
+	}
+	code, _ = do(t, h, "GET", "/projects/web/tasks/t2", "ivy", "")
+	if code != 404 {
+		t.Fatalf("t2 still reachable under web: got %d", code)
+	}
+}
