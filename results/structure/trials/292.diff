+// ManageProject is the manager-only capability for one project.
+type ManageProject interface {
+	// RemoveMember removes a user from the project. A user who is not a member
+	// is 404. Tasks in the project assigned to that user become unassigned in
+	// the same commit, so the assignee invariant still holds.
+	RemoveMember(userID string) error
+}
+
+type manageProject struct{ ps *projectScope }
+
+func (p *manageProject) RemoveMember(userID string) error {
+	return p.ps.as.a.st.tx(func(s *state) error {
+		if _, ok := s.members[p.ps.pid][userID]; !ok {
+			return deny(ErrNotFound, "not found")
+		}
+		delete(s.members[p.ps.pid], userID)
+		for id, t := range s.tasks {
+			if t.project == p.ps.pid && t.assignee.user == userID {
+				t.assignee = Assignee{project: p.ps.pid}
+				s.tasks[id] = t
+			}
+		}
+		return nil
+	})
+}
