+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager removes contributor", "ann", "/projects/web/members/ben", 204},
+		{"manager removes viewer", "ann", "/projects/web/members/dan", 204},
+		{"contributor", "ben", "/projects/web/members/cat", 403},
+		{"viewer", "dan", "/projects/web/members/ben", 403},
+		{"org admin", "eve", "/projects/web/members/ben", 403},
+		{"non member", "hal", "/projects/web/members/ben", 404},
+		{"other org", "gus", "/projects/web/members/ben", 404},
+		{"anonymous", "", "/projects/web/members/ben", 401},
+		{"not a member", "ann", "/projects/web/members/hal", 404},
+		{"unknown project", "ann", "/projects/nope/members/ben", 404},
+		{"archived", "ann", "/projects/legacy/members/ben", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveMemberRevokesAccessAndUnassigns(t *testing.T) {
+	srv := newServer()
+
+	// ben is assigned t1 in web before removal.
+	code, body := do(t, srv, "DELETE", "/projects/web/members/ben", "ann", "")
+	if code != 204 {
+		t.Fatalf("remove: got %d want 204 (%s)", code, body)
+	}
+
+	// The removed member loses read access.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("removed member read: got %d want 404", code)
+	}
+
+	// Their tasks in the project are unassigned; other assignments are kept.
+	code, body = do(t, srv, "GET", "/projects/web/tasks", "ann", "")
+	if code != 200 {
+		t.Fatal(code)
+	}
+	var tasks []Task
+	if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+		t.Fatal(err)
+	}
+	got := map[string]string{}
+	for _, task := range tasks {
+		got[task.ID] = task.Assignee
+	}
+	if got["t1"] != "" {
+		t.Fatalf("t1 assignee: got %q want unassigned", got["t1"])
+	}
+	if got["t2"] != "cat" {
+		t.Fatalf("t2 assignee: got %q want cat", got["t2"])
+	}
+
+	// Removing again is now 404.
+	if code, _ := do(t, srv, "DELETE", "/projects/web/members/ben", "ann", ""); code != 404 {
+		t.Fatalf("second remove: got %d want 404", code)
+	}
+}
