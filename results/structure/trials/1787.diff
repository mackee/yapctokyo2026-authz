--- /dev/null
+++ b/orgs.go
@@ -0,0 +1,65 @@
+package main
+
+import (
+	"net/http"
+)
+
+// removeOrgUser handles DELETE /orgs/{orgID}/users/{uid}. It removes the user from
+// every project of the organization (offboarding) and clears the user's task
+// assignments in those projects, since an assignee must be a member of the
+// task's project. Tasks keep their status. Only org admins of the organization
+// may call it. Removing a user who has no memberships is not an error.
+func (s *server) removeOrgUser(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	caller, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if caller == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	orgID := r.PathValue("orgID")
+	if caller.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	if !caller.OrgAdmin {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	target, err := findUser(ctx, s.db, r.PathValue("uid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if target == nil || target.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+	const orgProjects = `SELECT id FROM projects WHERE org_id = ?`
+	if _, err := tx.ExecContext(ctx,
+		`UPDATE tasks SET assignee = '' WHERE assignee = ? AND project_id IN (`+orgProjects+`)`,
+		target.ID, orgID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if _, err := tx.ExecContext(ctx,
+		`DELETE FROM memberships WHERE user_id = ? AND project_id IN (`+orgProjects+`)`,
+		target.ID, orgID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	w.WriteHeader(204)
+}
