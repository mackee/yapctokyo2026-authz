+++ b/orgs_test.go
@@ -0,0 +1,101 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+// DELETE /orgs/{orgID}/users/{uid} removes a user from every project of the org
+// (offboarding). Only organization admins of that org may call it.
+
+func TestRemoveUserFromOrg(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"user with no memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"project manager is not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"caller from another org", "gus", "/orgs/acme/users/ben", 404},
+		{"org missing", "eve", "/orgs/nope/users/ben", 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed", 404},
+		{"user in another org", "eve", "/orgs/acme/users/gus", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveUserFromOrgRemovesAllMemberships(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("got %d want 204: %s", code, body)
+	}
+	// ben was a contributor in web and in the archived legacy project.
+	for _, path := range []string{"/projects/web/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, h, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("ben still reads %s: got %d want 404", path, code)
+		}
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 404 {
+		t.Fatalf("ben can still create in web: got %d want 404", code)
+	}
+	// Other members keep their access.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat lost access to web: got %d want 200", code)
+	}
+}
+
+func TestRemoveUserFromOrgUnassignsTheirTasks(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("got %d want 204: %s", code, body)
+	}
+	cases := []struct {
+		path, wantAssignee, wantStatus string
+	}{
+		{"/projects/web/tasks/t1", "", "open"},     // was assigned to ben
+		{"/projects/legacy/tasks/t5", "", "open"},  // was assigned to ben, archived project
+		{"/projects/web/tasks/t2", "cat", "doing"}, // assigned to cat, untouched
+	}
+	for _, c := range cases {
+		code, body := do(t, h, "GET", c.path, "eve", "")
+		if code != 200 {
+			t.Fatalf("%s: got %d want 200: %s", c.path, code, body)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.Assignee != c.wantAssignee || task.Status != c.wantStatus {
+			t.Fatalf("%s: got assignee %q status %q, want %q %q",
+				c.path, task.Assignee, task.Status, c.wantAssignee, c.wantStatus)
+		}
+	}
+}
+
+func TestRemoveUserFromOrgTwice(t *testing.T) {
+	h := newServer()
+	for i := 1; i <= 2; i++ {
+		if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+			t.Fatalf("call %d: got %d want 204", i, code)
+		}
+	}
+}
+
+func TestRemoveUserFromOrgByNonAdminChangesNothing(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "ann", ""); code != 403 {
+		t.Fatalf("got %d want 403", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben lost access after a refused removal: got %d want 200", code)
+	}
+}
