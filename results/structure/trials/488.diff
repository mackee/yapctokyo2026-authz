+type MembershipTableSetRoleInput struct {
+	UserID string
+	Role   string
+}
+
+// SetRole changes the role of a project member. It is a model operation: the
+// authorization object must allow managing members, and the aggregate rejects
+// a role that would leave the member's assigned tasks with an invalid assignee.
+func (*MembershipTable) SetRole(ctx context.Context, db DB, authz ProjectAuthz, in MembershipTableSetRoleInput) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if !isRole(in.Role) {
+		return nil, deny(ErrInvalid, "role must be manager, contributor or viewer")
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadSetMemberRole(ctx, tx, authz.ProjectID(), in)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if m, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
