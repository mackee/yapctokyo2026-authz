+// setMemberRoleAggregate changes the role of one project member.
+type setMemberRoleAggregate struct {
+	membership *Membership
+	role       string
+	tasks      []*Task // the member's tasks in the project, assigned to them
+}
+
+func loadSetMemberRole(ctx context.Context, tx DB, projectID string, in MembershipTableSetRoleInput) (*setMemberRoleAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, projectID, in.UserID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	tasks, err := m.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &setMemberRoleAggregate{membership: m, role: in.Role, tasks: tasks}, nil
+}
+
+func (a *setMemberRoleAggregate) validate() error {
+	if !isWriterRole(a.role) && len(a.tasks) > 0 {
+		return deny(ErrInvalid, "member has assigned tasks; reassign or unassign them before making the member a viewer")
+	}
+	return nil
+}
+
+func (a *setMemberRoleAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.membership.setRole(ctx, tx, a.role); err != nil {
+		return nil, err
+	}
+	return a.membership, nil
+}
+
