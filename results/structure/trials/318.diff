+
+func (p *manageProject) MoveMemberTo(userID string, dst ManageProject) (MemberView, error) {
+	d, ok := dst.(*manageProject)
+	if !ok || d == nil {
+		return MemberView{}, deny(ErrInvalid, "invalid destination project")
+	}
+	src, dstID := p.ps.pid, d.ps.pid
+	if src == dstID {
+		return MemberView{}, deny(ErrInvalid, "destination must be a different project")
+	}
+	var out MemberView
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		role := s.role(src, userID)
+		if role == "" {
+			return deny(ErrNotFound, "not found")
+		}
+		if s.role(dstID, userID) != "" {
+			return deny(ErrInvalid, "user is already a member of the destination project")
+		}
+		delete(s.members[src], userID)
+		if s.members[dstID] == nil {
+			s.members[dstID] = map[string]string{}
+		}
+		s.members[dstID][userID] = role
+		for tid, t := range s.tasks {
+			if t.project == src && t.assignee.user == userID {
+				t.assignee = Assignee{project: src}
+				s.tasks[tid] = t
+			}
+		}
+		out = MemberView{UserID: userID, ProjectID: dstID, Role: role}
+		return nil
+	})
+	return out, err
+}
