diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..d882401
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,72 @@
+package main
+
+import (
+	"net/http"
+	"strings"
+	"testing"
+)
+
+func TestChangeMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager changes role", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"manager promotes", "ann", "/projects/web/members/ben", `{"role":"manager"}`, 200},
+		{"contributor forbidden", "ben", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"viewer forbidden", "dan", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"org admin forbidden", "eve", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"non-member 404", "hal", "/projects/web/members/dan", `{"role":"viewer"}`, 404},
+		{"other org 404", "gus", "/projects/web/members/dan", `{"role":"viewer"}`, 404},
+		{"unknown user 401", "nobody", "/projects/web/members/dan", `{"role":"viewer"}`, 401},
+		{"no user 401", "", "/projects/web/members/dan", `{"role":"viewer"}`, 401},
+		{"target not a member 404", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"archived 409", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"invalid role 400", "ann", "/projects/web/members/dan", `{"role":"owner"}`, 400},
+		{"missing role 400", "ann", "/projects/web/members/dan", `{}`, 400},
+		{"bad json 400", "ann", "/projects/web/members/dan", `{`, 400},
+		{"400 before 403", "dan", "/projects/web/members/dan", `{"role":"owner"}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), http.MethodPut, c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d, want %d (%s)", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestChangeMemberRoleResponseAndEffect(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, http.MethodPut, "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 || strings.TrimSpace(body) != `{"userId":"dan","role":"contributor"}` {
+		t.Fatalf("got %d %s", code, body)
+	}
+	// dan can now write.
+	if code, body := do(t, h, http.MethodPost, "/projects/web/tasks", "dan", `{"title":"x"}`); code != 201 && code != 200 {
+		t.Fatalf("dan could not create a task after promotion: %d %s", code, body)
+	}
+	// Demoting ann herself removes her ability to change roles.
+	if code, _ := do(t, h, http.MethodPut, "/projects/web/members/ann", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("self-demotion: got %d", code)
+	}
+	if code, _ := do(t, h, http.MethodPut, "/projects/web/members/dan", "ann", `{"role":"viewer"}`); code != 403 {
+		t.Fatalf("demoted manager: got %d, want 403", code)
+	}
+}
+
+func TestDemotionUnassignsTasks(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, http.MethodPost, "/projects/web/tasks", "ann", `{"title":"t","assignee":"ben"}`); code >= 300 {
+		t.Fatalf("setup: %d %s", code, body)
+	}
+	// do() runs the model rules after the write: the assignee rule must hold.
+	if code, body := do(t, h, http.MethodPut, "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("got %d %s", code, body)
+	}
+	_, body := do(t, h, http.MethodGet, "/projects/web/tasks", "ann", "")
+	if strings.Contains(body, `"assignee":"ben"`) {
+		t.Fatalf("ben is still assigned after demotion: %s", body)
+	}
+}
