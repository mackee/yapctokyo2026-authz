+// setRoleAggregate changes one member's role in one project.
+type setRoleAggregate struct {
+	member *Membership
+	role   string
+	tasks  []*Task // the member's tasks in the project; checked when the role stops being a writer role
+}
+
+func loadSetRole(ctx context.Context, tx DB, projectID, userID, role string) (*setRoleAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &setRoleAggregate{member: m, role: role}
+	if !isWriterRole(role) {
+		a.tasks, err = m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+	}
+	return a, nil
+}
+
+func (a *setRoleAggregate) validate() error {
+	if len(a.tasks) > 0 {
+		return deny(ErrInvalid, "member has tasks assigned in the project; reassign or unassign them first")
+	}
+	return nil
+}
+
+func (a *setRoleAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.member.setRole(ctx, tx, a.role); err != nil {
+		return nil, err
+	}
+	return a.member, nil
+}
+
 // deleteTaskAggregate removes one task.
