diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..8e209a1
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,98 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestSetMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager demotes member without tasks", "ann", "/projects/web/members/ivy", `{"role":"viewer"}`, 200},
+		{"manager promotes contributor", "ann", "/projects/web/members/ben", `{"role":"manager"}`, 200},
+		{"manager sets same role", "ann", "/projects/web/members/ben", `{"role":"contributor"}`, 200},
+		{"contributor", "ben", "/projects/web/members/cat", `{"role":"viewer"}`, 403},
+		{"viewer", "dan", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"org admin", "eve", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"non member", "hal", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"other org", "gus", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"anonymous", "", "/projects/web/members/ben", `{"role":"viewer"}`, 401},
+		{"unknown user", "zed", "/projects/web/members/ben", `{"role":"viewer"}`, 401},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"target in other org", "ann", "/projects/web/members/gus", `{"role":"viewer"}`, 404},
+		{"unknown target", "ann", "/projects/web/members/zed", `{"role":"viewer"}`, 404},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"bad role", "ann", "/projects/web/members/ben", `{"role":"owner"}`, 400},
+		{"missing role", "ann", "/projects/web/members/ben", `{}`, 400},
+		{"bad json", "ann", "/projects/web/members/ben", `{`, 400},
+		{"demote while tasks assigned", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMemberRoleResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members/ivy", "ann", `{"role":"viewer"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("response is not a JSON object: %v: %s", err, body)
+	}
+	if len(got) != 2 || got["userId"] != "ivy" || got["role"] != "viewer" {
+		t.Fatalf(`got %s, want {"userId":"ivy","role":"viewer"}`, body)
+	}
+}
+
+func TestSetMemberRoleTakesEffect(t *testing.T) {
+	h := newServer()
+
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ivy", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ivy", `{"title":"x"}`); code != 403 {
+		t.Fatalf("demoted viewer create: got %d want 403", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ivy", ""); code != 200 {
+		t.Fatalf("demoted viewer still reads: got %d want 200", code)
+	}
+
+	if code, _ := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`); code != 200 {
+		t.Fatalf("promote: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("promoted contributor create: got %d want 200", code)
+	}
+}
+
+func TestSetMemberRoleRejectedLeavesRoleUnchanged(t *testing.T) {
+	h := newServer()
+
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 400 {
+		t.Fatalf("demote with assigned task: got %d want 400", code)
+	}
+	// ben is still a contributor, so he may still edit his own task t1.
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 200 {
+		t.Fatalf("contributor after rejected demotion: got %d want 200", code)
+	}
+}
+
+func TestSetMemberRoleAfterReassigning(t *testing.T) {
+	h := newServer()
+
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ann", `{"assignee":""}`); code != 200 {
+		t.Fatalf("unassign: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote after unassigning: got %d want 200", code)
+	}
+}
