diff --git a/move_member_test.go b/move_member_test.go
new file mode 100644
index 0000000..8fc71c9
--- /dev/null
+++ b/move_member_test.go
@@ -0,0 +1,112 @@
+package main
+
+import (
+	"encoding/json"
+	"reflect"
+	"testing"
+)
+
+// POST /projects/{pid}/members/{uid}/move moves a member out of {pid} into the
+// project named by toProjectId, keeping the role.
+
+func TestMoveMemberCases(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager of both projects", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 200},
+		{"anonymous", "", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 401},
+		{"unknown user", "zed", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 401},
+		{"source contributor", "ben", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 403},
+		{"source viewer", "dan", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin", "eve", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"non member of source", "hal", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"source archived", "ann", "/projects/legacy/members/ben/move", `{"toProjectId":"web"}`, 409},
+		{"target not a member of source", "ivy", "/projects/web/members/hal/move", `{"toProjectId":"ops"}`, 404},
+		{"unknown destination", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"nope"}`, 404},
+		{"destination in other org", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"gx"}`, 404},
+		{"caller only viewer of destination", "ann", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"destination archived", "ann", "/projects/web/members/dan/move", `{"toProjectId":"legacy"}`, 409},
+		{"same project", "ann", "/projects/web/members/dan/move", `{"toProjectId":"web"}`, 400},
+		{"already a member of destination", "ivy", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 400},
+		{"missing destination", "ivy", "/projects/web/members/ben/move", `{}`, 400},
+		{"malformed body", "ivy", "/projects/web/members/ben/move", `{`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveMemberResponseKeepsRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body, wantUser, wantRole string
+	}{
+		{"contributor", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, "ben", "contributor"},
+		{"viewer", "ivy", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, "dan", "viewer"},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != 200 {
+				t.Fatalf("got %d want 200: %s", code, body)
+			}
+			var got map[string]string
+			if err := json.Unmarshal([]byte(body), &got); err != nil {
+				t.Fatal(err)
+			}
+			want := map[string]string{"userId": c.wantUser, "projectId": "ops", "role": c.wantRole}
+			if !reflect.DeepEqual(got, want) {
+				t.Fatalf("got %v want %v", got, want)
+			}
+		})
+	}
+}
+
+// After a move the member is in the destination and out of the source, and the
+// member's tasks in the source are unassigned. Other tasks are untouched.
+func TestMoveMemberEffects(t *testing.T) {
+	h := newServer()
+
+	if code, body := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`); code != 200 {
+		t.Fatalf("move: got %d %s", code, body)
+	}
+
+	// ben is a contributor of ops: may create tasks there.
+	if code, body := do(t, h, "POST", "/projects/ops/tasks", "ben", `{"title":"x"}`); code != 200 {
+		t.Fatalf("ben in ops create: got %d %s", code, body)
+	}
+	// ben is no longer a member of web.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben in web after move: got %d want 404", code)
+	}
+
+	// ben's task t1 stays in web, unassigned.
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ivy", "")
+	if code != 200 {
+		t.Fatalf("get t1: got %d", code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "" || task.ProjectID != "web" {
+		t.Fatalf("t1 after move: assignee %q project %q, want unassigned in web", task.AssigneeID, task.ProjectID)
+	}
+
+	// cat's task t2 in web is untouched.
+	code, body = do(t, h, "GET", "/projects/web/tasks/t2", "ivy", "")
+	if code != 200 {
+		t.Fatalf("get t2: got %d", code)
+	}
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "cat" {
+		t.Fatalf("t2 assignee %q, want cat", task.AssigneeID)
+	}
+}
