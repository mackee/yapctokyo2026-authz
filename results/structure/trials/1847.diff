+// ---- operations -----------------------------------------------------------------------
+
+// MembershipTableMoveInput is the input of MembershipTable.Move.
+type MembershipTableMoveInput struct {
+	UserID      string // a member of the authorized project
+	ToProjectID string // the project the member moves to
+}
+
+// Move moves a member out of the authorized project into another project,
+// keeping the role. The caller must manage both projects. The member's tasks in
+// the project are unassigned, since an assignee must be a member of the task's
+// project. It returns the member's membership in the destination.
+func (*MembershipTable) Move(ctx context.Context, db DB, authz ProjectAuthz, in MembershipTableMoveInput) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if in.ToProjectID == "" {
+		return nil, deny(ErrInvalid, "toProjectId must not be empty")
+	}
+	if in.ToProjectID == authz.ProjectID() {
+		return nil, deny(ErrInvalid, "toProjectId must be another project")
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveMember(ctx, tx, authz.Actor(), authz.ProjectID(), in)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if m, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
