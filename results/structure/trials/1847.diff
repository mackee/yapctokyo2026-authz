+// moveMemberAggregate moves one member from the source project to the destination.
+type moveMemberAggregate struct {
+	from *Membership  // the member in the source project
+	to   ProjectAuthz // the caller's authorization in the destination project
+}
+
+func loadMoveMember(ctx context.Context, tx DB, act Actor, fromProjectID string, in MembershipTableMoveInput) (*moveMemberAggregate, error) {
+	from, err := NewMembershipTable().Find(ctx, tx, fromProjectID, in.UserID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	// Unreadable or other-org destinations are 404 here.
+	to, err := NewProjectAuthz(ctx, tx, act, in.ToProjectID)
+	if err != nil {
+		return nil, err
+	}
+	if err := to.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if _, err := NewMembershipTable().Find(ctx, tx, in.ToProjectID, in.UserID); err == nil {
+		return nil, deny(ErrInvalid, "member is already in the destination project")
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	return &moveMemberAggregate{from: from, to: to}, nil
+}
+
+func (a *moveMemberAggregate) validate() error { return nil }
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	// An assignee must be a member of the task's project, so the member's tasks
+	// in the source project are unassigned first.
+	tasks, err := a.from.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, t := range tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.from.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	to := &Membership{ProjectID: a.to.ProjectID(), UserID: a.from.UserID, Role: a.from.Role}
+	if err := to.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return to, nil
+}
+
