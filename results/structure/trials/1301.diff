+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager removes contributor", "ann", "/projects/web/members/ben", 204},
+		{"manager removes viewer", "ann", "/projects/web/members/dan", 204},
+		{"manager removes other manager", "ann", "/projects/web/members/ivy", 204},
+		{"contributor", "ben", "/projects/web/members/cat", 403},
+		{"viewer", "dan", "/projects/web/members/ben", 403},
+		{"org admin is not a manager", "eve", "/projects/web/members/ben", 403},
+		{"non member caller", "hal", "/projects/web/members/ben", 404},
+		{"other org caller", "gus", "/projects/web/members/ben", 404},
+		{"anonymous", "", "/projects/web/members/ben", 401},
+		{"unknown caller", "zed", "/projects/web/members/ben", 401},
+		{"target not a member", "ann", "/projects/web/members/hal", 404},
+		{"manager removes self while another manager remains", "ann", "/projects/web/members/ann", 204},
+		{"unknown project", "ann", "/projects/missing/members/ben", 404},
+		{"cross org project", "ann", "/projects/gx/members/gus", 404},
+		{"archived", "ann", "/projects/legacy/members/ben", 409},
+		{"last manager", "ann", "/projects/legacy/members/ann", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveMemberTakesEffect(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "DELETE", "/projects/web/members/cat", "ann", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+	// The removed member can no longer see the project.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "cat", ""); code != 404 {
+		t.Fatalf("removed member read: got %d want 404", code)
+	}
+	// Their task in the project is unassigned.
+	code, body := do(t, srv, "GET", "/projects/web/tasks/t2", "ann", "")
+	if code != 200 {
+		t.Fatalf("get task: got %d want 200", code)
+	}
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" {
+		t.Fatalf("assignee = %q, want unassigned", task.Assignee)
+	}
+	// Their tasks in other projects are untouched.
+	code, body = do(t, srv, "GET", "/projects/ops/tasks/t4", "ann", "")
+	if code != 200 {
+		t.Fatalf("get ops task: got %d want 200", code)
+	}
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "cat" {
+		t.Fatalf("ops assignee = %q, want cat", task.Assignee)
+	}
+	// Removing the same member again is a 404.
+	if code, _ := do(t, srv, "DELETE", "/projects/web/members/cat", "ann", ""); code != 404 {
+		t.Fatalf("second remove: got %d want 404", code)
+	}
+}
