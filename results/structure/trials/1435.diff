+// transferUserAggregate moves one user to another organization. Memberships
+// and assignments belong to the old organization, so they are removed.
+type transferUserAggregate struct {
+	user        *User
+	memberships []*Membership // user.Memberships
+	tasks       []*Task       // user.AssignedTasks
+	toOrg       string
+	toOrgExists bool
+}
+
+func loadTransferUser(ctx context.Context, tx DB, orgID string, in UserTableTransferInput) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, in.UserID)
+	if errors.Is(err, ErrNoRows) || (err == nil && u.Org != orgID) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &transferUserAggregate{user: u, toOrg: in.ToOrgID}
+	if a.memberships, err = u.Memberships(ctx, tx); err != nil {
+		return nil, err
+	}
+	if a.tasks, err = u.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	if a.toOrgExists, err = NewUserTable().ExistsInOrg(ctx, tx, in.ToOrgID); err != nil {
+		return nil, err
+	}
+	if !a.toOrgExists {
+		if a.toOrgExists, err = NewProjectTable().ExistsInOrg(ctx, tx, in.ToOrgID); err != nil {
+			return nil, err
+		}
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if a.toOrg == a.user.Org {
+		return deny(ErrInvalid, "user is already in that organization")
+	}
+	if !a.toOrgExists {
+		return deny(ErrInvalid, "destination organization does not exist")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.user.moveToOrg(ctx, tx, a.toOrg); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
