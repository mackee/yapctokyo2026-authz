 }
 
+// OrgAuthz is what the actor may do in one organization (the actor's own).
+type OrgAuthz struct {
+	actor Actor
+	org   string
+}
+
+// OrgID returns the organization the object is bound to.
+func (a OrgAuthz) OrgID() string { return a.org }
+
+// CanTransfer returns nil if the actor may transfer users out of the
+// organization: org admins only (else ErrForbidden).
+func (a OrgAuthz) CanTransfer() error {
+	if a.org == "" || !a.actor.orgAdmin {
+		return deny(ErrForbidden, "only org admins may transfer users")
+	}
+	return nil
+}
+
+// NewOrgAuthz builds the actor's authorization object for an organization.
+// Other organizations are not visible to the actor: ErrNotFound.
+func NewOrgAuthz(act Actor, orgID string) (OrgAuthz, error) {
+	if orgID == "" || orgID != act.org {
+		return OrgAuthz{}, deny(ErrNotFound, "not found")
+	}
+	return OrgAuthz{actor: act, org: orgID}, nil
+}
+
