diff --git a/transfer_test.go b/transfer_test.go
new file mode 100644
index 0000000..f21882e
--- /dev/null
+++ b/transfer_test.go
@@ -0,0 +1,83 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestTransferStatus(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 200},
+		{"anonymous", "", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown user", "zed", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 401},
+		{"other org path", "eve", "/orgs/globex/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"not admin", "ann", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 403},
+		{"target in other org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"globex"}`, 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"unknown destination", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"initech"}`, 400},
+		{"same org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"acme"}`, 400},
+		{"missing toOrgId", "eve", "/orgs/acme/users/ben/transfer", `{}`, 400},
+		{"bad json", "eve", "/orgs/acme/users/ben/transfer", `{`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferEffects(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got struct{ ID, OrgID string }
+	if err := json.Unmarshal([]byte(body), &got); err != nil || got.ID != "ben" || got.OrgID != "globex" {
+		t.Fatalf("response %s (%v)", body, err)
+	}
+	// ben is now a globex user: no access to acme projects, none of his old
+	// memberships remain, and his tasks are unassigned.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads acme project: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben is not a gx member: %d", code)
+	}
+	for _, path := range []string{"/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		_, body := do(t, h, "GET", path, "ann", "")
+		var task Task
+		json.Unmarshal([]byte(body), &task)
+		if task.AssigneeID != "" {
+			t.Fatalf("%s still assigned to %q", path, task.AssigneeID)
+		}
+	}
+	if _, body := do(t, h, "GET", "/projects/web/tasks/t2", "ann", ""); body == "" {
+		t.Fatal("unrelated task lost")
+	}
+	// ben can no longer be assigned in web.
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t3", "ann", `{"assignee":"ben"}`); code != 400 {
+		t.Fatalf("assign transferred user: %d", code)
+	}
+}
+
+func TestTransferDropsOrgAdmin(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatal(code)
+	}
+	// eve is no longer an admin anywhere: she cannot read gx without membership
+	// and cannot transfer in globex.
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "eve", ""); code != 404 {
+		t.Fatalf("admin rights carried over: %d", code)
+	}
+	if code, _ := do(t, h, "POST", "/orgs/globex/users/gus/transfer", "eve", `{"toOrgId":"acme"}`); code != 403 {
+		t.Fatalf("got %d want 403", code)
+	}
+}
