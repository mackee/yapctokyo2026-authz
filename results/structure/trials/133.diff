+// MemberView is the public representation of a project member.
+type MemberView struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// ManageProject may change the roles of existing members of one project.
+type ManageProject interface {
+	// SetRoles changes the roles of the given members as one all-or-nothing
+	// operation and returns the project's members after the change, sorted by
+	// user ID. Any user that is not a member of the project, or any role that
+	// is not manager/contributor/viewer, is 400 and nothing changes.
+	//
+	// A member who loses the writer role (demoted to viewer) is removed as the
+	// assignee of the tasks they hold in this project, so the assignee
+	// invariant still holds.
+	SetRoles(roles map[string]string) ([]MemberView, error)
+}
+
+type manageProject struct{ ps *projectScope }
+
+func (p *manageProject) SetRoles(roles map[string]string) ([]MemberView, error) {
+	if len(roles) == 0 {
+		return nil, deny(ErrInvalid, "roles must not be empty")
+	}
+	uids := make([]string, 0, len(roles))
+	for uid, role := range roles {
+		if role != RoleManager && role != RoleContributor && role != RoleViewer {
+			return nil, deny(ErrInvalid, fmt.Sprintf("invalid role for %s", uid))
+		}
+		uids = append(uids, uid)
+	}
+	sort.Strings(uids)
+
+	var out []MemberView
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		members := s.members[p.ps.pid]
+		for _, uid := range uids {
+			if _, ok := members[uid]; !ok {
+				return deny(ErrInvalid, fmt.Sprintf("%s is not a member of the project", uid))
+			}
+		}
+		for _, uid := range uids {
+			members[uid] = roles[uid]
+			if !isWriterRole(roles[uid]) {
+				for id, t := range s.tasks {
+					if t.project == p.ps.pid && t.assignee.user == uid {
+						t.assignee = Assignee{project: p.ps.pid}
+						s.tasks[id] = t
+					}
+				}
+			}
+		}
+		out = s.membersIn(p.ps.pid)
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return out, nil
+}
