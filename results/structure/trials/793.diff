@@ -0,0 +1,73 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestTransfer(t *testing.T) {
+	const ok = `{"toOrgId":"globex"}`
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin transfers", "eve", "/orgs/acme/users/ben/transfer", ok, 200},
+		{"non admin", "ann", "/orgs/acme/users/ben/transfer", ok, 403},
+		{"admin of other org", "gus", "/orgs/acme/users/ben/transfer", ok, 404},
+		{"anonymous", "", "/orgs/acme/users/ben/transfer", ok, 401},
+		{"user of another org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed/transfer", ok, 404},
+		{"same org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"acme"}`, 400},
+		{"unknown destination", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"nowhere"}`, 400},
+		{"missing body field", "eve", "/orgs/acme/users/ben/transfer", `{}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestTransferEffects(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var resp map[string]string
+	if err := json.Unmarshal([]byte(body), &resp); err != nil {
+		t.Fatal(err)
+	}
+	if resp["id"] != "ben" || resp["orgId"] != "globex" || len(resp) != 2 {
+		t.Fatalf("unexpected response %s", body)
+	}
+	// ben lost access to acme projects.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("old project still readable: %d", code)
+	}
+	// tasks assigned to ben were unassigned (t1 in web).
+	code, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	_ = json.Unmarshal([]byte(body), &task)
+	if code != 200 || task.AssigneeID != "" {
+		t.Fatalf("t1 still assigned: %d %s", code, body)
+	}
+	// ben is no longer in acme, so cannot be transferred again from acme.
+	if code, _ := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 404 {
+		t.Fatalf("got %d", code)
+	}
+}
+
+func TestTransferDoesNotCarryAdminRights(t *testing.T) {
+	h := newServer()
+	// eve (org admin) moves herself; she must not be an admin in globex.
+	if code, body := do(t, h, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatal(code, body)
+	}
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "eve", ""); code != 404 {
+		t.Fatalf("admin flag carried over: %d", code)
+	}
+}
