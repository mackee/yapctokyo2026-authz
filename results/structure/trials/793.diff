+// transferUserAggregate moves one user to another organization.
+type transferUserAggregate struct {
+	user        *User
+	toOrg       string
+	toOrgExists bool
+	memberships []*Membership
+	tasks       []*Task
+}
+
+func loadTransferUser(ctx context.Context, tx DB, fromOrg, userID string, in UserTableTransferInput) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != fromOrg {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	a := &transferUserAggregate{user: u, toOrg: in.ToOrgID}
+	if a.toOrgExists, err = NewUserTable().OrgExists(ctx, tx, in.ToOrgID); err != nil {
+		return nil, err
+	}
+	if a.memberships, err = u.Memberships(ctx, tx); err != nil {
+		return nil, err
+	}
+	if a.tasks, err = u.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if a.toOrg == "" || a.toOrg == a.user.Org {
+		return deny(ErrInvalid, "destination must be a different organization")
+	}
+	if !a.toOrgExists {
+		return deny(ErrInvalid, "destination organization does not exist")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.user.moveTo(ctx, tx, a.toOrg); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
+
