+// setMemberRoleAggregate changes the role of one project member.
+type setMemberRoleAggregate struct {
+	member   membershipRecord // the membership with the new role applied
+	assigned int              // tasks in the project assigned to the member
+}
+
+func loadSetMemberRole(x *tx, projectID, userID, role string) (*setMemberRoleAggregate, error) {
+	m, ok := x.findMembership(projectID, userID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	a := &setMemberRoleAggregate{member: m}
+	a.member.Role = role
+	for _, t := range x.tasksIn(projectID) {
+		if t.AssigneeID == userID {
+			a.assigned++
+		}
+	}
+	return a, nil
+}
+
+func (a *setMemberRoleAggregate) validate() error {
+	if a.assigned > 0 && !isWriterRole(a.member.Role) {
+		return deny(ErrInvalid, "assignee must be a contributor or manager of the project; reassign the member's tasks first")
+	}
+	return nil
+}
+
+func (a *setMemberRoleAggregate) save(x *tx) MemberView {
+	a.member.save(x)
+	return MemberView{UserID: a.member.UserID, Role: a.member.Role}
+}
