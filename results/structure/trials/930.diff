+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"contributor own", "cat", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 200},
+		{"contributor not own", "cat", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"manager both unassigned", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 200},
+		{"manager both others", "ivy", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 200},
+		{"assignee not in dest", "ivy", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 400},
+		{"viewer in dest", "ann", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"not member of dest", "ben", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 404},
+		{"unknown dest", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"nope"}`, 404},
+		{"other org dest", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"gx"}`, 404},
+		{"same project", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"web"}`, 400},
+		{"archived source", "ann", "/projects/legacy/tasks/t5", `{"toProjectId":"web"}`, 409},
+		{"archived dest", "ann", "/projects/web/tasks/t3", `{"toProjectId":"legacy"}`, 409},
+		{"missing body field", "ivy", "/projects/web/tasks/t3", `{}`, 400},
+		{"wrong project in path", "ivy", "/projects/web/tasks/t4", `{"toProjectId":"ops"}`, 404},
+		{"unauthenticated", "", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+
+	t.Run("keeps fields", func(t *testing.T) {
+		h := newServer()
+		code, body := do(t, h, "POST", "/projects/web/tasks/t2/move", "cat", `{"toProjectId":"ops"}`)
+		if code != 200 {
+			t.Fatalf("got %d: %s", code, body)
+		}
+		var got Task
+		if err := json.Unmarshal([]byte(body), &got); err != nil {
+			t.Fatal(err)
+		}
+		want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", AssigneeID: "cat"}
+		if got != want {
+			t.Fatalf("got %+v want %+v", got, want)
+		}
+		if code, _ := do(t, h, "GET", "/projects/web/tasks/t2", "cat", ""); code != 404 {
+			t.Fatalf("old location: got %d want 404", code)
+		}
+		if code, _ := do(t, h, "GET", "/projects/ops/tasks/t2", "cat", ""); code != 200 {
+			t.Fatalf("new location: got %d want 200", code)
+		}
+	})
+}
