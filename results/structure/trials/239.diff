+// MoveMember removes userID from fromID and adds them to toID with the same
+// role. Tasks in the source project assigned to the user become unassigned,
+// since the assignee must be a member. Callers must validate beforehand.
+func (s *Store) MoveMember(fromID, toID, userID string) {
+	role := s.members[fromID][userID]
+	delete(s.members[fromID], userID)
+	if s.members[toID] == nil {
+		s.members[toID] = map[string]string{}
+	}
+	s.members[toID][userID] = role
+	for _, t := range s.tasks {
+		if t.ProjectID == fromID && t.Assignee == userID {
+			t.Assignee = ""
+		}
+	}
+}
