@@ -0,0 +1,124 @@
+package main
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+		{"missing project", "ann", "nope", 404},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeReturnsAllMembersAsViewers(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+	want := `[{"userId":"ann","role":"viewer"},{"userId":"ben","role":"viewer"},{"userId":"cat","role":"viewer"},{"userId":"dan","role":"viewer"},{"userId":"ivy","role":"viewer"}]`
+	if got := strings.TrimSpace(body); got != want {
+		t.Fatalf("body\n got %s\nwant %s", got, want)
+	}
+}
+
+func TestFreezeKeepsAssigneesAndReads(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d want 200", code)
+	}
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "dan", "")
+	if code != 200 {
+		t.Fatalf("read after freeze: got %d want 200", code)
+	}
+	if !strings.Contains(body, `"assignee":"ben"`) {
+		t.Fatalf("assignee was lost: %s", body)
+	}
+}
+
+func TestFrozenProjectRejectsTaskWrites(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d want 200", code)
+	}
+	// Every former member is a viewer now, so each write is refused with 403.
+	for _, user := range []string{"ann", "ben", "cat", "dan", "ivy"} {
+		t.Run(user, func(t *testing.T) {
+			if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", user, `{"status":"done"}`); code != 403 {
+				t.Errorf("PATCH: got %d want 403", code)
+			}
+			if code, _ := do(t, h, "POST", "/projects/web/tasks", user, `{"title":"x"}`); code != 403 {
+				t.Errorf("POST: got %d want 403", code)
+			}
+			if code, _ := do(t, h, "DELETE", "/projects/web/tasks/t1", user, ""); code != 403 {
+				t.Errorf("DELETE: got %d want 403", code)
+			}
+		})
+	}
+}
+
+func TestFreezeIsRejectedWhenAlreadyFrozen(t *testing.T) {
+	h := newServer()
+	do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	// Former managers are viewers now, so a second freeze is refused.
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 403 {
+		t.Fatalf("second freeze: got %d want 403", code)
+	}
+}
+
+// The role checks above would also refuse writes on a frozen project. This checks
+// the frozen flag itself: a manager who is back in the project (added directly in
+// the database, which breaks a model rule on purpose) still gets 409.
+func TestFrozenFlagRejectsWritesEvenForManager(t *testing.T) {
+	h := newServer()
+	do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	app := h.(*appHandler)
+	if _, err := app.db.Exec(`INSERT INTO memberships (project_id, user_id, role) VALUES ('web', 'hal', 'manager')`); err != nil {
+		t.Fatal(err)
+	}
+	// Sent without do(): the broken model rule is intentional here.
+	for _, c := range []struct{ method, path, body string }{
+		{"PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"DELETE", "/projects/web/tasks/t1", ""},
+	} {
+		req := httptest.NewRequest(c.method, c.path, strings.NewReader(c.body))
+		req.Header.Set("X-User", "hal")
+		w := httptest.NewRecorder()
+		h.ServeHTTP(w, req)
+		if w.Code != http.StatusConflict {
+			t.Errorf("%s %s: got %d want 409", c.method, c.path, w.Code)
+		}
+	}
+}
+
+func TestFreezeOnlyAffectsThatProject(t *testing.T) {
+	h := newServer()
+	do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	// ops is untouched: ivy is still a manager there and can write.
+	if code, _ := do(t, h, "POST", "/projects/ops/tasks", "ivy", `{"title":"x"}`); code != 200 {
+		t.Fatalf("ops write: got %d want 200", code)
+	}
+}
