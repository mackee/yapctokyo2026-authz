@@ -0,0 +1,99 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+)
+
+// Organizations are not a table: an organization exists when some user or
+// project carries its ID.
+func orgExists(ctx context.Context, s *server, orgID string) (bool, error) {
+	var ok bool
+	err := s.db.QueryRowContext(ctx, `
+		SELECT EXISTS(SELECT 1 FROM users WHERE org_id = ?)
+		    OR EXISTS(SELECT 1 FROM projects WHERE org_id = ?)`, orgID, orgID).Scan(&ok)
+	return ok, err
+}
+
+type transferRequest struct {
+	ToOrgID string `json:"toOrgId"`
+}
+
+type transferResponse struct {
+	ID    string `json:"id"`
+	OrgID string `json:"orgId"`
+}
+
+// transferUser moves a user from the organization in the path to another
+// organization (POST /orgs/{orgID}/users/{uid}/transfer).
+//
+// Only an org admin of the source organization may transfer its users. The
+// org_admin flag is cleared, because it grants rights in the organization the
+// user is leaving, not in the one they join. Project memberships are kept:
+// they are only effective inside the project's own organization.
+func (s *server) transferUser(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	caller, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if caller == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	orgID := r.PathValue("orgID")
+	if caller.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	if !caller.OrgAdmin {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	var req transferRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || req.ToOrgID == "" {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	target, err := findUser(ctx, s.db, r.PathValue("uid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if target == nil || target.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	if req.ToOrgID == orgID {
+		writeError(w, 409, "user is already in that organization")
+		return
+	}
+	exists, err := orgExists(ctx, s, req.ToOrgID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if !exists {
+		writeError(w, 400, "unknown organization")
+		return
+	}
+	// The WHERE clause on the old org makes this a compare-and-set: a concurrent
+	// transfer that already moved the user matches zero rows and is refused.
+	res, err := s.db.ExecContext(ctx,
+		`UPDATE users SET org_id = ?, org_admin = 0 WHERE id = ? AND org_id = ?`,
+		req.ToOrgID, target.ID, orgID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if n, err := res.RowsAffected(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	} else if n == 0 {
+		writeError(w, 409, "user was modified concurrently")
+		return
+	}
+	writeJSON(w, 200, transferResponse{ID: target.ID, OrgID: req.ToOrgID})
+}
