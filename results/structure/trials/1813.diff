+// changeRoleAggregate changes the role of one project member.
+type changeRoleAggregate struct {
+	member   *Membership
+	role     string
+	assigned []*Task // the member's tasks in the project
+}
+
+func loadChangeRole(ctx context.Context, tx DB, projectID string, in MembershipTableUpdateRoleInput) (*changeRoleAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, projectID, in.UserID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &changeRoleAggregate{member: m, role: in.Role}
+	if !isWriterRole(in.Role) {
+		a.assigned, err = m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+	}
+	return a, nil
+}
+
+func (a *changeRoleAggregate) validate() error {
+	// An assignee must be a contributor or manager of the task's project.
+	if !isWriterRole(a.role) && len(a.assigned) > 0 {
+		return deny(ErrInvalid, "member has tasks assigned in this project; reassign them before making them a viewer")
+	}
+	return nil
+}
+
+func (a *changeRoleAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.member.setRole(ctx, tx, a.role); err != nil {
+		return nil, err
+	}
+	return a.member, nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
