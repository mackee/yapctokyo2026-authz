+// ManageMember may change the role of one member of one project.
+type ManageMember interface {
+	// SetRole changes the member's role. Only managers may do this. A member
+	// who is still assigned tasks cannot be demoted to viewer (400).
+	SetRole(role string) (MemberView, error)
+}
+
+type memberScope struct {
+	ps  *projectScope
+	uid string
+}
+
+// Manage applies the member rule: the project is readable, the member exists
+// in it (else 404), the actor is a manager (else 403), and the project is not
+// archived (else 409).
+func (s *memberScope) Manage() (ManageMember, error) {
+	err := s.ps.as.a.db.view(func(x *tx) error {
+		p, r, err := readable(x, s.ps.as.actor, s.ps.pid)
+		if err != nil {
+			return err
+		}
+		if _, ok := x.findMembership(s.ps.pid, s.uid); !ok {
+			return deny(ErrNotFound, "member not found")
+		}
+		if r != RoleManager {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if p.Archived {
+			return deny(ErrArchived, "project is archived")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &manageMember{ms: s}, nil
+}
+
+type manageMember struct{ ms *memberScope }
+
+func (m *manageMember) SetRole(role string) (MemberView, error) {
+	var v MemberView
+	err := m.ms.ps.as.a.db.update(func(x *tx) error {
+		agg, err := loadSetMemberRole(x, m.ms.ps.pid, m.ms.uid, role)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		v = agg.apply(x)
+		return nil
+	})
+	return v, err
+}
+
