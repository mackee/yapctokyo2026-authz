+func TestUpdateMembers(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager", "ann", "web", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 200},
+		{"manager, manager target", "ann", "web", `{"roles":{"ivy":"contributor"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"org admin without role", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"unknown project", "ann", "missing", `{"roles":{"dan":"contributor"}}`, 404},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"invalid role", "ann", "web", `{"roles":{"dan":"owner"}}`, 400},
+		{"target not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"bad body", "ann", "web", `not json`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMembersResponse(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("bad JSON %q: %v", body, err)
+	}
+	want := []map[string]string{
+		{"userId": "ann", "role": "manager"},
+		{"userId": "ben", "role": "viewer"},
+		{"userId": "cat", "role": "contributor"},
+		{"userId": "dan", "role": "contributor"},
+		{"userId": "ivy", "role": "manager"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("members = %v, want %v", got, want)
+	}
+	// The changes take effect: ben can no longer write, dan now can.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Fatalf("ben after demotion: got %d want 403", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("dan after promotion: got %d want 200", code)
+	}
+}
+
+func TestUpdateMembersAllOrNothing(t *testing.T) {
+	cases := []struct {
+		name, body string
+	}{
+		{"one target is not a member", `{"roles":{"ben":"viewer","hal":"viewer"}}`},
+		{"one role is invalid", `{"roles":{"ben":"viewer","cat":"owner"}}`},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			if code, _ := do(t, h, "PUT", "/projects/web/members", "ann", c.body); code != 400 {
+				t.Fatalf("got %d want 400", code)
+			}
+			// ben must still be a contributor, so he can still create tasks.
+			if code, body := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 200 {
+				t.Fatalf("ben: got %d want 200: %s", code, body)
+			}
+			// cat must still be a contributor too.
+			if code, body := do(t, h, "POST", "/projects/web/tasks", "cat", `{"title":"x"}`); code != 200 {
+				t.Fatalf("cat: got %d want 200: %s", code, body)
+			}
+		})
+	}
+}
