+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes non member", "eve", "/orgs/acme/users/hal", 204},
+		{"org admin, target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"org admin, unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"org admin, other org", "eve", "/orgs/globex/users/gus", 404},
+		{"manager of the org", "ann", "/orgs/acme/users/ben", 403},
+		{"member of other org", "gus", "/orgs/acme/users/ben", 404},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d %s", code, body)
+	}
+
+	// The removed user loses access to every project of the org.
+	for _, path := range []string{"/projects/web/tasks", "/projects/legacy/tasks/t5"} {
+		if code, _ := do(t, srv, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("GET %s as ben: got %d want 404", path, code)
+		}
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 404 {
+		t.Fatalf("POST as ben: got %d want 404", code)
+	}
+
+	// Their assignments in the org's projects are cleared.
+	for _, c := range []struct{ project, id string }{{"web", "t1"}, {"legacy", "t5"}} {
+		var task Task
+		_, body := do(t, srv, "GET", "/projects/"+c.project+"/tasks/"+c.id, "ann", "")
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.Assignee != "" {
+			t.Fatalf("task %s still assigned to %q", c.id, task.Assignee)
+		}
+	}
+
+	// Everything else is untouched: other members, other assignments, other orgs.
+	checks := []struct {
+		user, path, assignee string
+	}{
+		{"ann", "/projects/web/tasks/t2", "cat"},
+		{"gus", "/projects/gx/tasks/t6", "gus"},
+	}
+	for _, c := range checks {
+		var task Task
+		code, body := do(t, srv, "GET", c.path, c.user, "")
+		if code != 200 {
+			t.Fatalf("GET %s: got %d", c.path, code)
+		}
+		json.Unmarshal([]byte(body), &task)
+		if task.Assignee != c.assignee {
+			t.Fatalf("GET %s: assignee %q want %q", c.path, task.Assignee, c.assignee)
+		}
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ann", ""); code != 200 {
+		t.Fatalf("ann lost web access: %d", code)
+	}
+}
