 // NewMembershipTable returns the memberships table.
 func NewMembershipTable() *MembershipTable { return &MembershipTable{} }
 
+// List returns the members of the project.
+func (mt *MembershipTable) List(ctx context.Context, db DB, authz ProjectAuthz) ([]*Membership, error) {
+	if !authz.CanRead() {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	return mt.ListByProject(ctx, db, authz.ProjectID())
+}
+
+// UpdateRoles changes the roles of several members at once (userID -> role),
+// all or nothing, and returns the project's members afterwards.
+func (mt *MembershipTable) UpdateRoles(ctx context.Context, db DB, authz ProjectAuthz, roles map[string]string) ([]*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if len(roles) == 0 {
+		return nil, deny(ErrInvalid, "roles must not be empty")
+	}
+	var out []*Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadUpdateRoles(ctx, tx, authz.ProjectID(), roles)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if err := agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		out, err = mt.ListByProject(ctx, tx, authz.ProjectID())
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
