+// updateRolesAggregate changes the roles of several members of one project.
+type updateRolesAggregate struct {
+	members  []*Membership // the memberships to change, ordered by user ID
+	roles    map[string]string
+	assigned map[string]int // user ID -> number of tasks of the project assigned to them
+}
+
+func loadUpdateRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*updateRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	all, err := p.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	a := &updateRolesAggregate{roles: roles, assigned: map[string]int{}}
+	found := map[string]bool{}
+	for _, m := range all {
+		if _, ok := roles[m.UserID]; !ok {
+			continue
+		}
+		found[m.UserID] = true
+		a.members = append(a.members, m)
+		ts, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.assigned[m.UserID] = len(ts)
+	}
+	for id := range roles {
+		if !found[id] {
+			return nil, deny(ErrInvalid, "every user in roles must be a member of the project")
+		}
+	}
+	return a, nil
+}
+
+func (a *updateRolesAggregate) validate() error {
+	for _, m := range a.members {
+		role := a.roles[m.UserID]
+		if role != RoleManager && role != RoleContributor && role != RoleViewer {
+			return deny(ErrInvalid, "role must be manager, contributor or viewer")
+		}
+		// an assignee must stay a contributor or manager
+		if !isWriterRole(role) && a.assigned[m.UserID] > 0 {
+			return deny(ErrInvalid, "member "+m.UserID+" has assigned tasks and must stay a contributor or manager")
+		}
+	}
+	return nil
+}
+
+func (a *updateRolesAggregate) apply(ctx context.Context, tx DB) error {
+	for _, m := range a.members {
+		if err := m.setRole(ctx, tx, a.roles[m.UserID]); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
