+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, project, member, body string
+		want                              int
+	}{
+		{"manager of both moves", "ivy", "web", "ben", `{"toProjectId":"ops"}`, 200},
+		{"manager of source only", "ann", "web", "ben", `{"toProjectId":"ops"}`, 403},
+		{"viewer", "dan", "web", "ben", `{"toProjectId":"ops"}`, 403},
+		{"contributor", "ben", "web", "cat", `{"toProjectId":"ops"}`, 403},
+		{"org admin without roles", "eve", "web", "ben", `{"toProjectId":"ops"}`, 403},
+		{"non member", "hal", "web", "ben", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "web", "ben", `{"toProjectId":"ops"}`, 401},
+		{"unknown user", "zed", "web", "ben", `{"toProjectId":"ops"}`, 401},
+		{"other org", "gus", "web", "ben", `{"toProjectId":"ops"}`, 404},
+		{"project missing", "ivy", "nope", "ben", `{"toProjectId":"ops"}`, 404},
+		{"member not in project", "ivy", "web", "hal", `{"toProjectId":"ops"}`, 404},
+		{"archived source", "ann", "legacy", "ben", `{"toProjectId":"ops"}`, 409},
+		{"empty body", "ivy", "web", "ben", ``, 400},
+		{"missing toProjectId", "ivy", "web", "ben", `{}`, 400},
+		{"destination missing", "ivy", "web", "ben", `{"toProjectId":"nope"}`, 404},
+		{"destination other org", "ivy", "web", "ben", `{"toProjectId":"gx"}`, 404},
+		{"destination not readable", "ivy", "web", "ben", `{"toProjectId":"legacy"}`, 404},
+		{"same project", "ivy", "web", "ben", `{"toProjectId":"web"}`, 400},
+		{"destination archived", "ann", "web", "ben", `{"toProjectId":"legacy"}`, 409},
+		{"already in destination", "ivy", "web", "cat", `{"toProjectId":"ops"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			path := "/projects/" + c.project + "/members/" + c.member + "/move"
+			code, _ := do(t, newServer(), "POST", path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveResponseAndMembership(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got struct {
+		UserID    string `json:"userId"`
+		ProjectID string `json:"projectId"`
+		Role      string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.UserID != "ben" || got.ProjectID != "ops" || got.Role != RoleContributor {
+		t.Fatalf("unexpected response: %+v", got)
+	}
+
+	// ben is no longer a member of web: web reads now 404 for ben.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("source read: got %d want 404", code)
+	}
+	// ben is now a contributor of ops and can work there.
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+		t.Fatalf("destination read: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/ops/tasks", "ben", `{"title":"x"}`); code != 201 {
+		t.Fatalf("destination create: got %d want 201", code)
+	}
+	// Tasks stay with their project; ben's web task is still there for managers.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t1", "ivy", ""); code != 200 {
+		t.Fatalf("task after move: got %d want 200", code)
+	}
+}
+
+func TestMoveKeepsViewerRole(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/members/dan/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	if !strings.Contains(body, `"role":"viewer"`) {
+		t.Fatalf("role not preserved: %s", body)
+	}
+	if code, _ := do(t, h, "POST", "/projects/ops/tasks", "dan", `{"title":"x"}`); code != 403 {
+		t.Fatalf("viewer write after move: got %d want 403", code)
+	}
+}
