+
+type moveRequest struct {
+	ToProjectID string `json:"toProjectId"`
+}
+
+type moveResponse struct {
+	UserID    string `json:"userId"`
+	ProjectID string `json:"projectId"`
+	Role      string `json:"role"`
+}
+
+// moveMember removes a member from the path project and adds them to
+// toProjectId with the same role. The caller must be a manager of both projects.
+func (s *server) moveMember(w http.ResponseWriter, r *http.Request) {
+	s.store.mu.Lock()
+	defer s.store.mu.Unlock()
+
+	user := s.store.User(r.Header.Get("X-User"))
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project := s.store.Project(r.PathValue("pid"))
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role := s.store.Role(project.ID, user.ID)
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	memberID := r.PathValue("uid")
+	memberRole := s.store.Role(project.ID, memberID)
+	if memberRole == "" {
+		writeError(w, 404, "member not found")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req moveRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || req.ToProjectID == "" {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	dest := s.store.Project(req.ToProjectID)
+	if dest == nil || dest.OrgID != user.OrgID {
+		writeError(w, 404, "destination project not found")
+		return
+	}
+	if dest.ID == project.ID {
+		writeError(w, 400, "destination must differ from the source project")
+		return
+	}
+	destRole := s.store.Role(dest.ID, user.ID)
+	if destRole == "" && !user.OrgAdmin {
+		writeError(w, 404, "destination project not found")
+		return
+	}
+	if destRole != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if dest.Archived {
+		writeError(w, 409, "destination project is archived")
+		return
+	}
+	if s.store.Role(dest.ID, memberID) != "" {
+		writeError(w, 409, "member already belongs to destination project")
+		return
+	}
+	s.store.RemoveMember(project.ID, memberID)
+	s.store.SetRole(dest.ID, memberID, memberRole)
+	writeJSON(w, 200, moveResponse{UserID: memberID, ProjectID: dest.ID, Role: memberRole})
+}
