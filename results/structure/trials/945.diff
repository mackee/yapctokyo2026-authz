 	return &p, nil
 }
+
+// ListByOrg returns the projects of the organization, ordered by ID.
+func (*ProjectTable) ListByOrg(ctx context.Context, db DB, orgID string) ([]*Project, error) {
+	rows, err := db.QueryContext(ctx,
+		`SELECT id, org_id, name, archived FROM projects WHERE org_id = ? ORDER BY id`, orgID)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	out := []*Project{}
+	for rows.Next() {
+		var p Project
+		if err := rows.Scan(&p.ID, &p.Org, &p.Name, &p.Archived); err != nil {
+			return nil, err
+		}
+		out = append(out, &p)
+	}
+	if err := rows.Err(); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
