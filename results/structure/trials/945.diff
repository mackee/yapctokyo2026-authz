 }
+
+// RemoveFromOrg removes the user from every project of the organization
+// (offboarding): their memberships there are deleted and the tasks assigned to
+// them in those projects are unassigned, so the model rules keep holding. The
+// user must belong to the organization (else ErrNotFound). Archived projects
+// are included; this is not a task write.
+func (*UserTable) RemoveFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanRemoveUser(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveUserFromOrg(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
