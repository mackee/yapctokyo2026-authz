new file mode 100644
index 0000000..100a714
--- /dev/null
+++ b/member.go
@@ -0,0 +1,148 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+)
+
+type moveRequest struct {
+	ToProjectID string `json:"toProjectId"`
+}
+
+type moveResponse struct {
+	UserID    string `json:"userId"`
+	ProjectID string `json:"projectId"`
+	Role      string `json:"role"`
+}
+
+// moveMember handles POST /projects/{pid}/members/{uid}/move.
+//
+// The caller must be a manager of both the source and the destination project
+// (moving a member writes to both). Order of checks:
+//
+//	401 unknown user; 404 source project not readable; 403 caller not a manager of source;
+//	400 bad body or destination == source; 404 {uid} not a member of source;
+//	404 destination missing/other org/not readable; 403 caller not a manager of destination;
+//	409 either project archived; 409 {uid} already a member of destination.
+//
+// The member keeps the same role. Tasks in the source project assigned to the
+// moved user become unassigned, because an assignee must be a contributor or
+// manager of the task's project.
+func (s *server) moveMember(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	src, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if src == nil || src.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	srcRole, err := findRole(ctx, s.db, src.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if srcRole == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if srcRole != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	var req moveRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || req.ToProjectID == "" {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	if req.ToProjectID == src.ID {
+		writeError(w, 400, "destination must be a different project")
+		return
+	}
+	uid := r.PathValue("uid")
+	memberRole, err := findRole(ctx, s.db, src.ID, uid)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if memberRole == "" {
+		writeError(w, 404, "not found")
+		return
+	}
+	dst, err := findProject(ctx, s.db, req.ToProjectID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if dst == nil || dst.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	dstRole, err := findRole(ctx, s.db, dst.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if dstRole == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if dstRole != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if src.Archived || dst.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+	// Re-check inside the transaction so concurrent moves cannot duplicate or lose the member.
+	var exists int
+	if err := tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM memberships WHERE project_id = ? AND user_id = ?`, dst.ID, uid).Scan(&exists); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if exists > 0 {
+		writeError(w, 409, "user is already a member of the destination project")
+		return
+	}
+	res, err := tx.ExecContext(ctx, `DELETE FROM memberships WHERE project_id = ? AND user_id = ?`, src.ID, uid)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if n, err := res.RowsAffected(); err != nil || n == 0 {
+		writeError(w, 404, "not found")
+		return
+	}
+	if _, err := tx.ExecContext(ctx, `INSERT INTO memberships (project_id, user_id, role) VALUES (?, ?, ?)`, dst.ID, uid, memberRole); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if _, err := tx.ExecContext(ctx, `UPDATE tasks SET assignee = '' WHERE project_id = ? AND assignee = ?`, src.ID, uid); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, moveResponse{UserID: uid, ProjectID: dst.ID, Role: memberRole})
+}
