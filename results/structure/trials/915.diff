@@ -144,3 +144,94 @@ func loadDeleteTask(ctx context.Context, tx DB, taskID string) (*deleteTaskAggre
 func (a *deleteTaskAggregate) validate() error { return nil }
 
 func (a *deleteTaskAggregate) apply(ctx context.Context, tx DB) error { return a.task.destroy(ctx, tx) }
+
+// transferUserAggregate moves one user from the source organization to another.
+// The user's memberships in the source organization's projects are removed, and
+// the tasks they hold there are unassigned, so no project keeps a member or an
+// assignee from another organization. The org admin flag is cleared: it applies
+// to the source organization only.
+type transferUserAggregate struct {
+	user        *User
+	toOrg       string
+	memberships []*Membership // the user's memberships in source-org projects
+	tasks       []*Task       // the user's tasks in source-org projects
+	archived    bool          // one of those projects is archived (its writes are refused)
+}
+
+func loadTransferUser(ctx context.Context, tx DB, fromOrg, userID, toOrg string) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != fromOrg {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	a := &transferUserAggregate{user: u, toOrg: toOrg}
+
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, m := range ms {
+		p, err := m.Project(ctx, tx)
+		if errors.Is(err, ErrNoRows) {
+			continue
+		} else if err != nil {
+			return nil, err
+		}
+		if p.Org != fromOrg {
+			continue
+		}
+		a.archived = a.archived || p.Archived
+		a.memberships = append(a.memberships, m)
+	}
+
+	ts, err := u.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, t := range ts {
+		p, err := t.Project(ctx, tx)
+		if errors.Is(err, ErrNoRows) {
+			continue
+		} else if err != nil {
+			return nil, err
+		}
+		if p.Org != fromOrg {
+			continue
+		}
+		a.archived = a.archived || p.Archived
+		a.tasks = append(a.tasks, t)
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	// Archived projects reject all writes, and removing a member or unassigning
+	// a task there is a write.
+	if a.archived {
+		return deny(ErrArchived, "user belongs to an archived project; it cannot be transferred")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	a.user.Org = a.toOrg
+	a.user.OrgAdmin = false
+	if err := a.user.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
