--- /dev/null
+++ b/transfer_test.go
@@ -0,0 +1,99 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestTransferUser(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 200},
+		{"member not admin", "ann", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 403},
+		{"contributor not admin", "ben", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 403},
+		{"source org not yours", "gus", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 404},
+		{"user in other org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"globex"}`, 404},
+		{"no such user", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"anonymous", "", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown actor", "zed", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 401},
+		{"missing toOrgId", "eve", "/orgs/acme/users/hal/transfer", `{}`, 400},
+		{"empty toOrgId", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":""}`, 400},
+		{"same org", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"acme"}`, 400},
+		{"archived project member", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferUserResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/hal/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got struct {
+		ID    string `json:"id"`
+		OrgID string `json:"orgId"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.ID != "hal" || got.OrgID != "globex" {
+		t.Fatalf("got %+v", got)
+	}
+}
+
+func TestTransferUserEffects(t *testing.T) {
+	h := newServer()
+
+	// cat is a contributor on web (assigned t2) and ops (assigned t4).
+	if code, body := do(t, h, "POST", "/orgs/acme/users/cat/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: got %d: %s", code, body)
+	}
+
+	// Her acme memberships are gone: acme projects are no longer visible to her.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 404 {
+		t.Fatalf("cat reads web: got %d want 404", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "cat", ""); code != 404 {
+		t.Fatalf("cat reads ops: got %d want 404", code)
+	}
+
+	// The tasks she held in acme projects are unassigned.
+	for _, p := range []struct{ project, task string }{{"web", "t2"}, {"ops", "t4"}} {
+		code, body := do(t, h, "GET", "/projects/"+p.project+"/tasks/"+p.task, "ann", "")
+		if code != 200 {
+			t.Fatalf("get %s: got %d", p.task, code)
+		}
+		var task Task
+		json.Unmarshal([]byte(body), &task)
+		if task.AssigneeID != "" {
+			t.Fatalf("%s still assigned to %q", p.task, task.AssigneeID)
+		}
+	}
+
+	// She is now a globex user: acme admins cannot transfer her again.
+	if code, _ := do(t, h, "POST", "/orgs/acme/users/cat/transfer", "eve", `{"toOrgId":"globex"}`); code != 404 {
+		t.Fatalf("second transfer: got %d want 404", code)
+	}
+}
+
+func TestTransferClearsOrgAdmin(t *testing.T) {
+	h := newServer()
+
+	// eve is an acme org admin. Moving her to globex makes her an ordinary globex user.
+	if code, body := do(t, h, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: got %d: %s", code, body)
+	}
+	// Still a globex user, but not an admin: a globex admin action is refused.
+	if code, _ := do(t, h, "POST", "/orgs/globex/users/gus/transfer", "eve", `{"toOrgId":"acme"}`); code != 403 {
+		t.Fatalf("eve as globex non-admin: got %d want 403", code)
+	}
+}
