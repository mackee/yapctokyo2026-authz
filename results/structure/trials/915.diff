+
+// UserTransferInput is the input of UserTable.Transfer.
+type UserTransferInput struct {
+	ToOrgID string
+}
+
+// Transfer moves a user of the authorization object's organization to another
+// organization, all or nothing. The user leaves the source organization's
+// projects (see transferUserAggregate). Only org admins of the source
+// organization may do this.
+func (*UserTable) Transfer(ctx context.Context, db DB, authz OrgAuthz, userID string, in UserTransferInput) (*User, error) {
+	if err := authz.CanTransferUsers(); err != nil {
+		return nil, err
+	}
+	if in.ToOrgID == "" {
+		return nil, deny(ErrInvalid, "toOrgId must not be empty")
+	}
+	if in.ToOrgID == authz.OrgID() {
+		return nil, deny(ErrInvalid, "user is already in that organization")
+	}
+	var u *User
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadTransferUser(ctx, tx, authz.OrgID(), userID, in.ToOrgID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if u, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return u, nil
+}
