+// changeRoleAggregate changes the role of one project member. A member who
+// would lose write rights may not hold assigned tasks (the assignee rule).
+type changeRoleAggregate struct {
+	membership *Membership
+	assigned   []*Task // membership.AssignedTasks
+	role       string
+}
+
+func loadChangeRole(ctx context.Context, tx DB, projectID, userID, role string) (*changeRoleAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	tasks, err := m.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &changeRoleAggregate{membership: m, assigned: tasks, role: role}, nil
+}
+
+func (a *changeRoleAggregate) validate() error {
+	if !validRoles[a.role] {
+		return deny(ErrInvalid, "invalid role")
+	}
+	if !isWriterRole(a.role) && len(a.assigned) > 0 {
+		return deny(ErrInvalid, "member has assigned tasks; reassign them before removing write access")
+	}
+	return nil
+}
+
+func (a *changeRoleAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.membership.setRole(ctx, tx, a.role); err != nil {
+		return nil, err
+	}
+	return a.membership, nil
+}
+
