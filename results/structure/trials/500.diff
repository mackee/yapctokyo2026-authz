+// ---- operations -----------------------------------------------------------------------
+
+// RemoveFromOrg removes the user from every project of the authorization's
+// organization (for example when the user leaves the company). Their
+// memberships in those projects are deleted, archived projects included, and
+// the tasks they hold there are unassigned, all in one transaction. The user
+// row itself is kept. The user must belong to the organization (else
+// ErrNotFound); the actor must be an org admin of it (else ErrForbidden).
+func (*UserTable) RemoveFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanManageMembers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveUserFromOrg(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
