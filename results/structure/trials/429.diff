 }
 
+// transferUserAggregate moves one user to another organization. Its rules: the
+// user must be in the authorized organization; the target must be a known,
+// different organization; and after the move no membership or assignment may
+// point at a project of the old organization.
+type transferUserAggregate struct {
+	user        *User
+	toOrg       string
+	memberships []*Membership // the user's memberships in the old organization's projects
+	tasks       []*Task       // tasks the user is assigned to in those projects
+}
+
+func loadTransferUser(ctx context.Context, x *Tx, authz OrgAuthz, userID string, in UserTableTransferInput) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, x, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != authz.Org() {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if in.ToOrgID == u.Org {
+		return nil, deny(ErrInvalid, "user already belongs to that organization")
+	}
+	known, err := NewUserTable().OrgExists(ctx, x, in.ToOrgID)
+	if err != nil {
+		return nil, err
+	}
+	if !known {
+		return nil, deny(ErrInvalid, "unknown organization")
+	}
+	a := &transferUserAggregate{user: u, toOrg: in.ToOrgID}
+	ms, err := NewMembershipTable().ListByUser(ctx, x, u.ID)
+	if err != nil {
+		return nil, err
+	}
+	for _, m := range ms {
+		p, err := m.Project(ctx, x)
+		if err != nil {
+			return nil, err
+		}
+		if p.Org != u.Org {
+			continue
+		}
+		a.memberships = append(a.memberships, m)
+		ts, err := m.AssignedTasks(ctx, x)
+		if err != nil {
+			return nil, err
+		}
+		a.tasks = append(a.tasks, ts...)
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error { return nil }
+
+func (a *transferUserAggregate) apply(ctx context.Context, x *Tx) (*User, error) {
+	for _, m := range a.memberships {
+		if err := m.remove(ctx, x); err != nil {
+			return nil, err
+		}
+	}
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, x); err != nil {
+			return nil, err
+		}
+	}
+	u := a.user
+	u.Org = a.toOrg
+	u.OrgAdmin = false
+	if err := u.save(ctx, x); err != nil {
+		return nil, err
+	}
+	return u, nil
+}
+
