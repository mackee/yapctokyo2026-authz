+
+// OrgExists reports whether the organization is known, that is, at least one
+// user or project belongs to it. There is no organizations table.
+func (*UserTable) OrgExists(ctx context.Context, db DB, org string) (bool, error) {
+	found := false
+	if err := db.view(ctx, func(x *Tx) error {
+		for _, u := range x.t.users {
+			if u.Org == org {
+				found = true
+				return nil
+			}
+		}
+		for _, p := range x.t.projects {
+			if p.Org == org {
+				found = true
+				return nil
+			}
+		}
+		return nil
+	}); err != nil {
+		return false, err
+	}
+	return found, nil
+}
+
+// UserTableTransferInput is the input of UserTable.Transfer.
+type UserTableTransferInput struct {
+	ToOrgID string
+}
+
+// Transfer moves the user from the organization of the authorization object to
+// another organization. The user leaves the old organization's projects: their
+// memberships there are removed and their tasks in those projects are
+// unassigned. Org admin rights do not carry over.
+func (*UserTable) Transfer(ctx context.Context, db DB, authz OrgAuthz, userID string, in UserTableTransferInput) (*User, error) {
+	if err := authz.CanTransferUsers(); err != nil {
+		return nil, err
+	}
+	if in.ToOrgID == "" {
+		return nil, deny(ErrInvalid, "toOrgId must not be empty")
+	}
+	var u *User
+	if err := db.update(ctx, func(x *Tx) error {
+		agg, err := loadTransferUser(ctx, x, authz, userID, in)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if u, err = agg.apply(ctx, x); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return u, nil
+}
