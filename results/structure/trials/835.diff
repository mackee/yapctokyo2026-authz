+func TestTransfer(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin transfers user", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 200},
+		{"non admin member", "ann", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 403},
+		{"contributor self", "ben", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 403},
+		{"other org admin", "gus", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 404},
+		{"path org mismatch", "eve", "/orgs/globex/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"anonymous", "", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown target org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"initech"}`, 400},
+		{"same org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"acme"}`, 400},
+		{"missing toOrgId", "eve", "/orgs/acme/users/ben/transfer", `{}`, 400},
+		{"bad body", "eve", "/orgs/acme/users/ben/transfer", `nope`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferResponseAndEffects(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var resp map[string]string
+	if err := json.Unmarshal([]byte(body), &resp); err != nil {
+		t.Fatal(err)
+	}
+	if resp["id"] != "ben" || resp["orgId"] != "globex" {
+		t.Fatalf("bad response: %s", body)
+	}
+	// ben's acme project memberships no longer grant access.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads acme project after transfer: got %d want 404", code)
+	}
+	// ben is now in globex, so the acme org admin can no longer move him.
+	if code, _ := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"acme"}`); code != 404 {
+		t.Fatalf("transfer of user already moved: got %d want 404", code)
+	}
+}
+
+func TestTransferClearsOrgAdmin(t *testing.T) {
+	h := newServer()
+	// eve moves herself to globex (self-transfer is allowed).
+	if code, body := do(t, h, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	// eve must not gain admin rights over globex projects.
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "eve", ""); code != 404 {
+		t.Fatalf("eve reads globex project after transfer: got %d want 404", code)
+	}
+}
