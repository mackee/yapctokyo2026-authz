+func TestUpdateMembers(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager batch", "ann", "web", `{"roles":{"dan":"contributor","cat":"manager"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"unknown user", "zed", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"manager"}}`, 409},
+		{"invalid role", "ann", "web", `{"roles":{"dan":"owner"}}`, 400},
+		{"non member target", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"malformed body", "ann", "web", `{"roles":`, 400},
+		{"demote assignee", "ann", "web", `{"roles":{"ben":"viewer"}}`, 409},
+		{"issue example", "ann", "web", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMembersResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","cat":"manager"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}{
+		{"ann", "manager"}, {"ben", "contributor"}, {"cat", "manager"}, {"dan", "contributor"}, {"ivy", "manager"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %s", body)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("entry %d: got %+v want %+v", i, got[i], want[i])
+		}
+	}
+}
+
+// A rejected batch must leave every role as it was, including changes that were
+// valid on their own.
+func TestUpdateMembersIsAtomic(t *testing.T) {
+	cases := []struct {
+		name, body string
+	}{
+		{"invalid role later in batch", `{"roles":{"dan":"contributor","hal":"viewer"}}`},
+		{"assignee demotion with valid change", `{"roles":{"dan":"contributor","ben":"viewer"}}`},
+		{"invalid role value", `{"roles":{"dan":"contributor","cat":"owner"}}`},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			app := h.(*appHandler)
+			do(t, h, "PUT", "/projects/web/members", "ann", c.body)
+			ctx := context.Background()
+			for uid, want := range map[string]string{"dan": "viewer", "ben": "contributor", "cat": "contributor"} {
+				got, err := findRole(ctx, app.db, "web", uid)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if got != want {
+					t.Fatalf("%s: role %q, want %q", uid, got, want)
+				}
+			}
+		})
+	}
+}
