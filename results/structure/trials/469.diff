+// orgExists reports whether any user belongs to the organization. There is no
+// organizations table; an organization exists while it has users.
+func orgExists(ctx context.Context, db *sql.DB, id string) (bool, error) {
+	var one int
+	err := db.QueryRowContext(ctx, `SELECT 1 FROM users WHERE org_id = ? LIMIT 1`, id).Scan(&one)
+	if errors.Is(err, sql.ErrNoRows) {
+		return false, nil
+	}
+	if err != nil {
+		return false, err
+	}
+	return true, nil
+}
