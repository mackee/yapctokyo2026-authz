+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestMoveMemberSuccess(t *testing.T) {
+	h := newServer()
+
+	// ivy manages both web and ops; dan is a viewer in web.
+	code, body := do(t, h, "POST", "/projects/web/members/dan/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]string{"userId": "dan", "projectId": "ops", "role": "viewer"}
+	if len(got) != len(want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	for k, v := range want {
+		if got[k] != v {
+			t.Fatalf("got %v want %v", got, want)
+		}
+	}
+
+	// dan left web and is now a member of ops.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "dan", ""); code != 404 {
+		t.Fatalf("dan still reads web: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "dan", ""); code != 200 {
+		t.Fatalf("dan cannot read ops: %d", code)
+	}
+}
+
+func TestMoveMemberKeepsRole(t *testing.T) {
+	h := newServer()
+	// ben is a contributor in web: after the move he can create tasks in ops
+	// (assigning himself) but is not a manager.
+	code, body := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got map[string]string
+	json.Unmarshal([]byte(body), &got)
+	if got["role"] != "contributor" {
+		t.Fatalf("role %q", got["role"])
+	}
+	if code, _ := do(t, h, "POST", "/projects/ops/tasks", "ben", `{"title":"x","assignee":"ben"}`); code != 200 {
+		t.Fatalf("contributor create: %d", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/ops/tasks", "ben", `{"title":"x","assignee":"cat"}`); code != 403 {
+		t.Fatalf("contributor assigns other: %d", code)
+	}
+}
+
+// A member who leaves a project can no longer be the assignee of its tasks.
+func TestMoveMemberUnassignsLeftBehindTasks(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`); code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatal(code)
+	}
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.ProjectID != "web" || task.AssigneeID != "" {
+		t.Fatalf("task after move: %+v", task)
+	}
+}
+
+func TestMoveMemberRules(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager of both", "ivy", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 400}, // cat is already in ops
+		{"contributor", "ben", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer", "dan", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin", "eve", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 403},
+		{"not manager of target", "ann", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 403},
+		{"non member of source", "hal", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 404},
+		{"other org caller", "gus", "/projects/web/members/dan/move", `{"toProjectId":"gx"}`, 404},
+		{"anonymous", "", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 401},
+		{"unknown user", "zed", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 401},
+		{"target missing", "ivy", "/projects/web/members/dan/move", `{"toProjectId":"nope"}`, 404},
+		{"target other org", "ivy", "/projects/web/members/dan/move", `{"toProjectId":"gx"}`, 404},
+		{"target unreadable", "ann", "/projects/web/members/dan/move", `{"toProjectId":"gx"}`, 404},
+		{"target archived", "ann", "/projects/web/members/dan/move", `{"toProjectId":"legacy"}`, 409},
+		{"source archived", "ann", "/projects/legacy/members/ben/move", `{"toProjectId":"web"}`, 409},
+		{"user not in source", "ivy", "/projects/web/members/hal/move", `{"toProjectId":"ops"}`, 404},
+		{"same project", "ivy", "/projects/web/members/dan/move", `{"toProjectId":"web"}`, 400},
+		{"missing toProjectId", "ivy", "/projects/web/members/dan/move", `{}`, 400},
+		{"empty toProjectId", "ivy", "/projects/web/members/dan/move", `{"toProjectId":""}`, 400},
+		{"malformed body", "ivy", "/projects/web/members/dan/move", `{`, 400},
+		{"malformed body beats access", "hal", "/projects/web/members/dan/move", `{}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+		})
+	}
+}
+
+// A rejected move changes nothing.
+func TestMoveMemberRejectedChangesNothing(t *testing.T) {
+	h := newServer()
+	// cat is already in ops: the move is rejected, cat must stay in web.
+	if code, _ := do(t, h, "POST", "/projects/web/members/cat/move", "ivy", `{"toProjectId":"ops"}`); code != 400 {
+		t.Fatal(code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat lost web: %d", code)
+	}
+	// and t2 is still assigned to cat
+	_, body := do(t, h, "GET", "/projects/web/tasks/t2", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.AssigneeID != "cat" {
+		t.Fatalf("t2 assignee %q", task.AssigneeID)
+	}
+}
