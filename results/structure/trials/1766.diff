+// moveMemberAggregate moves one member from one project to another, keeping
+// the role. Tasks the member leaves behind are unassigned, since an assignee
+// must be a contributor or manager of the task's project.
+type moveMemberAggregate struct {
+	membership *Membership // the member's membership in the source project
+	user       *User       // membership.User()
+	target     *Project    // the destination project
+	existing   *Membership // the user's membership in the target; nil when none
+	tasks      []*Task     // membership.AssignedTasks()
+}
+
+func loadMoveMember(ctx context.Context, tx DB, fromID, userID, toID string) (*moveMemberAggregate, error) {
+	src, err := NewProjectTable().Find(ctx, tx, fromID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	m, err := src.Membership(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	target, err := NewProjectTable().Find(ctx, tx, toID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveMemberAggregate{membership: m, target: target}
+	if a.user, err = m.User(ctx, tx); err != nil {
+		return nil, err
+	}
+	if a.existing, err = target.Membership(ctx, tx, userID); errors.Is(err, ErrNoRows) {
+		a.existing = nil
+	} else if err != nil {
+		return nil, err
+	}
+	if a.tasks, err = m.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.membership.ProjectID == a.target.ID {
+		return deny(ErrInvalid, "the member is already in that project")
+	}
+	if a.existing != nil {
+		return deny(ErrInvalid, "the user is already a member of the destination project")
+	}
+	if a.user.Org != a.target.Org {
+		return deny(ErrInvalid, "project members must belong to the project's organization")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.membership.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	moved := a.membership.moveTo(a.target)
+	if err := moved.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return moved, nil
+}
