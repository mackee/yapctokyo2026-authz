+func TestFreeze(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"missing project", "ann", "nope", 404},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeEffects(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var members []Member
+	if err := json.Unmarshal([]byte(body), &members); err != nil {
+		t.Fatal(err)
+	}
+	if len(members) != 5 {
+		t.Fatalf("want 5 members, got %d", len(members))
+	}
+	for i, m := range members {
+		if m.Role != "viewer" {
+			t.Fatalf("%s is %s", m.UserID, m.Role)
+		}
+		if i > 0 && members[i-1].UserID >= m.UserID {
+			t.Fatal("members not sorted")
+		}
+	}
+	if !strings.Contains(body, `"userId":"ann","role":"viewer"`) {
+		t.Fatalf("unexpected body %s", body)
+	}
+
+	writes := []struct{ method, path, user, body string }{
+		{"POST", "/projects/web/tasks", "ann", `{"title":"x"}`},
+		{"PATCH", "/projects/web/tasks/t1", "ann", `{"status":"done"}`},
+		{"PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`},
+		{"DELETE", "/projects/web/tasks/t1", "ann", ""},
+		{"POST", "/projects/web/freeze", "ann", ""},
+	}
+	for _, w := range writes {
+		if code, _ := do(t, h, w.method, w.path, w.user, w.body); code != 403 {
+			t.Fatalf("%s %s as %s: got %d want 403", w.method, w.path, w.user, code)
+		}
+	}
+	// Members can still read, and other projects are unaffected.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ann", ""); code != 200 {
+		t.Fatalf("read after freeze: %d", code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`); code != 200 {
+		t.Fatalf("other project affected: %d", code)
+	}
+}
