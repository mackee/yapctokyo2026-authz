+// ---- organization scope -------------------------------------------------------
+
+// OrgScope is bound to one actor and one organization ID. It grants nothing by
+// itself; call Export to acquire the export capability.
+type OrgScope interface {
+	ID() string
+	Export() (ExportOrg, error)
+}
+
+type orgScope struct {
+	as  *actorScope
+	oid string
+}
+
+func (s *orgScope) ID() string { return s.oid }
+
+// Export applies the export rule: the organization must be the actor's own
+// (else 404, like projects in another organization), and the actor must be an
+// org admin (else 403). Org admins can read every project of their organization,
+// so the export covers archived projects too.
+func (s *orgScope) Export() (ExportOrg, error) {
+	err := s.as.a.st.read(func(st *state) error {
+		if s.oid != s.as.actor.org {
+			return deny(ErrNotFound, "not found")
+		}
+		if !s.as.actor.orgAdmin {
+			return deny(ErrForbidden, "forbidden")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &exportOrg{os: s}, nil
+}
+
+// ExportOrg may read the tasks of every project in one organization.
+type ExportOrg interface {
+	ID() string
+	Tasks() []TaskView
+}
+
+type exportOrg struct{ os *orgScope }
+
+func (o *exportOrg) ID() string { return o.os.oid }
+func (o *exportOrg) Tasks() []TaskView {
+	var out []TaskView
+	_ = o.os.as.a.st.read(func(s *state) error { out = s.tasksInOrg(o.os.oid); return nil })
+	return out
+}
+
