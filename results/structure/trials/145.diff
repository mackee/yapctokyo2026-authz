+func TestExportContents(t *testing.T) {
+	code, body := do(t, newServer(), "GET", "/orgs/acme/export", "eve", "")
+	if code != 200 {
+		t.Fatal(code)
+	}
+	var tasks []map[string]any
+	if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+		t.Fatal(err)
+	}
+	// acme has 5 tasks: t1-t4 in web and ops, t5 in the archived legacy project.
+	if len(tasks) != 5 {
+		t.Fatalf("want 5 tasks, got %d: %s", len(tasks), body)
+	}
+	wantKeys := []string{"id", "projectId", "title", "status", "assignee"}
+	projects := map[string]bool{}
+	for _, task := range tasks {
+		if len(task) != len(wantKeys) {
+			t.Fatalf("want exactly keys %v, got %v", wantKeys, task)
+		}
+		for _, k := range wantKeys {
+			if _, ok := task[k]; !ok {
+				t.Fatalf("missing key %s in %v", k, task)
+			}
+		}
+		if task["title"] == "Globex secret plan" {
+			t.Fatalf("leaked task of another org: %v", task)
+		}
+		projects[task["projectId"].(string)] = true
+	}
+	for _, p := range []string{"web", "ops", "legacy"} {
+		if !projects[p] {
+			t.Fatalf("export is missing project %s", p)
+		}
+	}
+	if projects["gx"] {
+		t.Fatal("export leaked project gx of another org")
+	}
+}
