+// tasksInOrg returns the tasks of every project in the organization, including
+// archived projects, ordered by project ID and then task ID.
+func (s *state) tasksInOrg(orgID string) []TaskView {
+	out := []TaskView{}
+	for _, t := range s.tasks {
+		if p, ok := s.projects[t.project]; ok && p.org == orgID {
+			out = append(out, t.view())
+		}
+	}
+	sort.Slice(out, func(i, j int) bool {
+		if out[i].ProjectID != out[j].ProjectID {
+			return out[i].ProjectID < out[j].ProjectID
+		}
+		return out[i].ID < out[j].ID
+	})
+	return out
+}
