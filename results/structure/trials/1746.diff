+func TestRemoveUserFromOrg(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ann", 204},
+		{"org admin removes user without memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"org admin removes self", "eve", "/orgs/acme/users/eve", 204},
+		{"project manager", "ann", "/orgs/acme/users/ben", 403},
+		{"plain user", "hal", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown actor", "zed", "/orgs/acme/users/ben", 401},
+		{"other org actor", "gus", "/orgs/acme/users/ben", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ben", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"own org name but other org's admin path", "eve", "/orgs/globex/users/gus", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveUserFromOrgRemovesAllMemberships(t *testing.T) {
+	h := newServer()
+	// ann is a member of web, ops and legacy (archived).
+	for _, p := range []string{"web", "ops", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ann", ""); code != 200 {
+			t.Fatalf("before: %s got %d", p, code)
+		}
+	}
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ann", "eve", ""); code != 204 {
+		t.Fatalf("remove got %d", code)
+	}
+	for _, p := range []string{"web", "ops", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ann", ""); code != 404 {
+			t.Fatalf("after: %s got %d want 404", p, code)
+		}
+	}
+	// Other members are untouched.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "dan", ""); code != 200 {
+		t.Fatalf("dan lost access: %d", code)
+	}
+	// Removing again is not an error.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ann", "eve", ""); code != 204 {
+		t.Fatalf("second remove got %d", code)
+	}
+}
+
+func TestRemoveUserFromOrgUnassignsTasks(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove got %d", code)
+	}
+	assignee := func(path string) string {
+		code, body := do(t, h, "GET", path, "eve", "")
+		if code != 200 {
+			t.Fatalf("%s got %d", path, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		return task.AssigneeID
+	}
+	// ben's tasks, including the one in the archived project, are unassigned.
+	if a := assignee("/projects/web/tasks/t1"); a != "" {
+		t.Fatalf("t1 assignee %q", a)
+	}
+	if a := assignee("/projects/legacy/tasks/t5"); a != "" {
+		t.Fatalf("t5 assignee %q", a)
+	}
+	// Other people's tasks keep their assignee.
+	if a := assignee("/projects/web/tasks/t2"); a != "cat" {
+		t.Fatalf("t2 assignee %q", a)
+	}
+	if a := assignee("/projects/ops/tasks/t4"); a != "cat" {
+		t.Fatalf("t4 assignee %q", a)
+	}
+}
