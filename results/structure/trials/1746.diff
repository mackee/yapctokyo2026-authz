+// RemoveFromOrg removes the user from all projects of the organization (the
+// offboarding operation), all or nothing. The user's tasks are unassigned.
+// Removing a user who has no memberships succeeds.
+func (*UserTable) RemoveFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanManageMembers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveUser(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
