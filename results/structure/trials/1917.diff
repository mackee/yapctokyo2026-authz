+// transferUserAggregate moves one user to another organization. The user's
+// memberships in projects of the old organization end, and the tasks assigned
+// to them through those memberships become unassigned.
+type transferUserAggregate struct {
+	user    *User
+	toOrg   string
+	orgOK   bool
+	leaving []*leavingMembership
+}
+
+type leavingMembership struct {
+	membership *Membership
+	tasks      []*Task // membership.AssignedTasks
+}
+
+func loadTransferUser(ctx context.Context, tx DB, orgID, userID, toOrg string) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) || (err == nil && u.Org != orgID) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &transferUserAggregate{user: u, toOrg: toOrg}
+	if a.orgOK, err = NewUserTable().OrgExists(ctx, tx, toOrg); err != nil {
+		return nil, err
+	}
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, m := range ms {
+		p, err := m.Project(ctx, tx)
+		if err != nil && !errors.Is(err, ErrNoRows) {
+			return nil, err
+		}
+		if err == nil && p.Org == toOrg {
+			continue // still the project's organization
+		}
+		tasks, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.leaving = append(a.leaving, &leavingMembership{membership: m, tasks: tasks})
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if a.toOrg == a.user.Org {
+		return deny(ErrInvalid, "user already belongs to that organization")
+	}
+	if !a.orgOK {
+		return deny(ErrInvalid, "unknown organization")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	for _, l := range a.leaving {
+		for _, t := range l.tasks {
+			if err := t.unassign(ctx, tx); err != nil {
+				return nil, err
+			}
+		}
+		if err := l.membership.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.user.moveTo(ctx, tx, a.toOrg); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
