+// OrgAuthz is what the actor may do in one organization.
+type OrgAuthz struct {
+	actor Actor
+	org   string
+}
+
+// OrgID returns the organization the object is bound to.
+func (a OrgAuthz) OrgID() string { return a.org }
+
+// CanTransfer returns nil if the actor may move users out of the organization:
+// org admins of that organization only (else ErrForbidden).
+func (a OrgAuthz) CanTransfer() error {
+	if a.org == "" || a.actor.org != a.org || !a.actor.orgAdmin {
+		return deny(ErrForbidden, "only org admins may transfer users")
+	}
+	return nil
+}
