+// updateRolesAggregate changes the roles of several members of one project.
+type updateRolesAggregate struct {
+	members []*Membership // all members of the project, ordered by user ID
+	in      map[string]string
+}
+
+func loadUpdateRoles(ctx context.Context, tx DB, projectID string, in map[string]string) (*updateRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	members, err := p.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &updateRolesAggregate{members: members, in: in}, nil
+}
+
+func (a *updateRolesAggregate) validate() error {
+	if len(a.in) == 0 {
+		return deny(ErrInvalid, "roles must not be empty")
+	}
+	isMember := map[string]bool{}
+	managers := 0
+	for _, m := range a.members {
+		isMember[m.UserID] = true
+		role := m.Role
+		if r, ok := a.in[m.UserID]; ok {
+			role = r
+		}
+		if role == RoleManager {
+			managers++
+		}
+	}
+	for uid, role := range a.in {
+		switch role {
+		case RoleManager, RoleContributor, RoleViewer:
+		default:
+			return deny(ErrInvalid, "invalid role for "+uid)
+		}
+		if !isMember[uid] {
+			return deny(ErrInvalid, uid+" is not a member of the project")
+		}
+	}
+	if managers == 0 {
+		return deny(ErrInvalid, "project must keep at least one manager")
+	}
+	return nil
+}
+
+// apply saves the new roles and returns the project's members.
+func (a *updateRolesAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for _, m := range a.members {
+		if role, ok := a.in[m.UserID]; ok && role != m.Role {
+			if err := m.setRole(ctx, tx, role); err != nil {
+				return nil, err
+			}
+		}
+	}
+	return a.members, nil
+}
+
