+// move a member: POST /projects/{pid}/members/{uid}/move {"toProjectId":...}
+func move(t *testing.T, h http.Handler, user, from, uid, body string) (int, string) {
+	t.Helper()
+	return do(t, h, "POST", "/projects/"+from+"/members/"+uid+"/move", user, body)
+}
+
+func TestMoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, from, uid, body string
+		want                        int
+	}{
+		{"manager of both moves contributor", "ivy", "web", "ben", `{"toProjectId":"ops"}`, 200},
+		{"manager of both moves viewer", "ivy", "web", "dan", `{"toProjectId":"ops"}`, 200},
+		{"manager of source only", "ann", "web", "ben", `{"toProjectId":"ops"}`, 403},
+		{"viewer of source", "dan", "web", "ben", `{"toProjectId":"ops"}`, 403},
+		{"org admin", "eve", "web", "ben", `{"toProjectId":"ops"}`, 403},
+		{"non member of source", "hal", "web", "ben", `{"toProjectId":"ops"}`, 404},
+		{"other org caller", "gus", "web", "ben", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "web", "ben", `{"toProjectId":"ops"}`, 401},
+		{"unknown user", "zed", "web", "ben", `{"toProjectId":"ops"}`, 401},
+		{"missing source project", "ivy", "nope", "ben", `{"toProjectId":"ops"}`, 404},
+		{"archived source", "ann", "legacy", "ben", `{"toProjectId":"web"}`, 409},
+		{"missing target project", "ivy", "web", "ben", `{"toProjectId":"nope"}`, 404},
+		{"target in other org", "ivy", "web", "ben", `{"toProjectId":"gx"}`, 404},
+		{"target not writable by caller", "ann", "web", "ben", `{"toProjectId":"ops"}`, 403},
+		{"archived target", "ann", "web", "ben", `{"toProjectId":"legacy"}`, 409},
+		{"user not in source", "ivy", "web", "hal", `{"toProjectId":"ops"}`, 404},
+		{"user already in target", "ivy", "web", "cat", `{"toProjectId":"ops"}`, 409},
+		{"same project", "ivy", "web", "ben", `{"toProjectId":"web"}`, 400},
+		{"empty target", "ivy", "web", "ben", `{"toProjectId":""}`, 400},
+		{"invalid body", "ivy", "web", "ben", `not json`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := move(t, newServer(), c.user, c.from, c.uid, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveMemberResponse(t *testing.T) {
+	code, body := move(t, newServer(), "ivy", "web", "dan", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+	var got struct {
+		UserID    string `json:"userId"`
+		ProjectID string `json:"projectId"`
+		Role      string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("bad json %q: %v", body, err)
+	}
+	if got.UserID != "dan" || got.ProjectID != "ops" || got.Role != "viewer" {
+		t.Fatalf("got %+v", got)
+	}
+}
+
+func TestMoveMemberTransfersAccess(t *testing.T) {
+	h := newServer()
+	if code, _ := move(t, h, "ivy", "web", "ben", `{"toProjectId":"ops"}`); code != 200 {
+		t.Fatalf("move got %d want 200", code)
+	}
+	// ben is no longer a member of web ...
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reading web after move: got %d want 404", code)
+	}
+	// ... and is now a contributor of ops, so may act there.
+	if code, _ := do(t, h, "POST", "/projects/ops/tasks", "ben", `{"title":"x"}`); code != 200 {
+		t.Fatalf("ben creating in ops after move: got %d want 200", code)
+	}
+}
+
+func TestMoveMemberFailureLeavesMembershipsUnchanged(t *testing.T) {
+	h := newServer()
+	// cat is already in ops, so the move must fail and cat must stay in web.
+	if code, _ := move(t, h, "ivy", "web", "cat", `{"toProjectId":"ops"}`); code != 409 {
+		t.Fatalf("got %d want 409", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t2", "cat", ""); code != 200 {
+		t.Fatalf("cat lost web access after failed move: got %d want 200", code)
+	}
+}
