diff --git a/move_test.go b/move_test.go
new file mode 100644
index 0000000..224083f
--- /dev/null
+++ b/move_test.go
@@ -0,0 +1,57 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"testing"
+)
+
+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager moves assigned task", "ivy", "/projects/web/tasks/t2/move", `{"toProjectId":"ops"}`, 200},
+		{"manager moves unassigned task", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 200},
+		{"assignee not in destination", "ivy", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 400},
+		{"contributor cannot move", "cat", "/projects/web/tasks/t2/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer in destination", "ann", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 403},
+		{"archived destination", "ann", "/projects/web/tasks/t3/move", `{"toProjectId":"legacy"}`, 409},
+		{"other org destination", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"gx"}`, 404},
+		{"unknown destination", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"nope"}`, 404},
+		{"same project", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"web"}`, 400},
+		{"missing destination", "ivy", "/projects/web/tasks/t3/move", `{}`, 400},
+		{"task of another project", "ivy", "/projects/web/tasks/t4/move", `{"toProjectId":"ops"}`, 404},
+		{"unauthenticated", "", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			if code, body := do(t, h, http.MethodPost, c.path, c.user, c.body); code != c.want {
+				t.Fatalf("got %d, want %d: %s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsFields(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, http.MethodPost, "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got Task
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", AssigneeID: "cat"}
+	if got != want {
+		t.Fatalf("got %+v, want %+v", got, want)
+	}
+	if code, _ := do(t, h, http.MethodGet, "/projects/web/tasks/t2", "ivy", ""); code != 404 {
+		t.Fatalf("task still in source project: %d", code)
+	}
+	if code, _ := do(t, h, http.MethodGet, "/projects/ops/tasks/t2", "ivy", ""); code != 200 {
+		t.Fatalf("task not in destination project: %d", code)
+	}
+}
