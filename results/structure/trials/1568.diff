+// Move moves the task to the destination project, keeping its ID, title,
+// status and assignee. The actor must be a manager of the task's project (as
+// for Delete) and able to write to the destination; the assignee must be a
+// contributor or manager there.
+func (*TaskTable) Move(ctx context.Context, db DB, authz TaskAuthz, dest ProjectAuthz) (*Task, error) {
+	if err := authz.CanManage(); err != nil {
+		return nil, err
+	}
+	if err := dest.CanWrite(); err != nil {
+		return nil, err
+	}
+	if dest.ProjectID() == authz.Project().ProjectID() {
+		return nil, deny(ErrInvalid, "task is already in the project")
+	}
+	var t *Task
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveTask(ctx, tx, authz.TaskID(), dest.ProjectID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if err := dest.CanAssign(agg.task.AssigneeID); err != nil {
+			return err
+		}
+		t, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return t, nil
+}
