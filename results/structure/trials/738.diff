 }
 
+// MembershipTableDeleteInput is the input of MembershipTable.Delete.
+type MembershipTableDeleteInput struct {
+	UserID string
+}
+
+// Delete removes the user from the project. Managers only; the user must be a
+// member, and must have no tasks assigned in the project (see
+// deleteMembershipAggregate).
+func (*MembershipTable) Delete(ctx context.Context, db DB, authz ProjectAuthz, in MembershipTableDeleteInput) error {
+	if err := authz.CanManageMembers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadDeleteMembership(ctx, tx, authz.ProjectID(), in.UserID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
