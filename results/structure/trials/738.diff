+// deleteMembershipAggregate removes one user from one project. The model rule
+// "an assignee is a member of the task's project" must keep holding, so a
+// member who still has tasks assigned in the project cannot be removed.
+type deleteMembershipAggregate struct {
+	membership *Membership
+	assigned   []*Task // the member's tasks in the project
+}
+
+func loadDeleteMembership(ctx context.Context, tx DB, projectID, userID string) (*deleteMembershipAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	tasks, err := m.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &deleteMembershipAggregate{membership: m, assigned: tasks}, nil
+}
+
+func (a *deleteMembershipAggregate) validate() error {
+	if len(a.assigned) > 0 {
+		return deny(ErrInvalid, "member still has tasks assigned in the project")
+	}
+	return nil
+}
+
+func (a *deleteMembershipAggregate) apply(ctx context.Context, tx DB) error {
+	return a.membership.destroy(ctx, tx)
+}
+
