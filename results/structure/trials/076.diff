+
+type outOfOfficeRequest struct {
+	Delegate string `json:"delegate"`
+}
+
+// outOfOffice moves every task assigned to {uid} in the organization to the
+// delegate and returns the moved tasks. Tasks in archived projects are left
+// alone, since archived projects reject writes. The operation is all-or-nothing:
+// if the delegate is not a contributor or manager of an affected project,
+// nothing is changed.
+func (s *server) outOfOffice(w http.ResponseWriter, r *http.Request) {
+	s.store.mu.Lock()
+	defer s.store.mu.Unlock()
+
+	caller := s.store.User(r.Header.Get("X-User"))
+	if caller == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	orgID := r.PathValue("orgID")
+	if caller.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	if !caller.OrgAdmin {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	uid := r.PathValue("uid")
+	target := s.store.User(uid)
+	if target == nil || target.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	var req outOfOfficeRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || req.Delegate == "" {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	if req.Delegate == uid {
+		writeError(w, 400, "delegate must be a different user")
+		return
+	}
+	delegate := s.store.User(req.Delegate)
+	if delegate == nil || delegate.OrgID != orgID {
+		writeError(w, 400, "delegate must belong to the organization")
+		return
+	}
+
+	var moved []*Task
+	for _, t := range s.store.TasksAssignedTo(uid) {
+		project := s.store.Project(t.ProjectID)
+		if project == nil || project.OrgID != orgID || project.Archived {
+			continue
+		}
+		role := s.store.Role(project.ID, delegate.ID)
+		if role != RoleManager && role != RoleContributor {
+			writeError(w, 400, "delegate must be a contributor or manager of project "+project.ID)
+			return
+		}
+		moved = append(moved, t)
+	}
+	for _, t := range moved {
+		t.Assignee = delegate.ID
+	}
+	if moved == nil {
+		moved = []*Task{}
+	}
+	writeJSON(w, 200, moved)
+}
diff --git a/out_of_office_test.go b/out_of_office_test.go
new file mode 100644
index 0000000..1f70b7a
--- /dev/null
+++ b/out_of_office_test.go
@@ -0,0 +1,97 @@
+package main
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func TestOutOfOfficeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin delegates", "eve", "/orgs/acme/users/ben/out-of-office", `{"delegate":"cat"}`, 200},
+		{"manager is not org admin", "ann", "/orgs/acme/users/ben/out-of-office", `{"delegate":"cat"}`, 403},
+		{"contributor is not org admin", "ben", "/orgs/acme/users/ben/out-of-office", `{"delegate":"cat"}`, 403},
+		{"anonymous", "", "/orgs/acme/users/ben/out-of-office", `{"delegate":"cat"}`, 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben/out-of-office", `{"delegate":"cat"}`, 401},
+		{"admin of other org", "eve", "/orgs/globex/users/gus/out-of-office", `{"delegate":"gus"}`, 404},
+		{"other org caller", "gus", "/orgs/acme/users/ben/out-of-office", `{"delegate":"cat"}`, 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed/out-of-office", `{"delegate":"cat"}`, 404},
+		{"user in other org", "eve", "/orgs/acme/users/gus/out-of-office", `{"delegate":"cat"}`, 404},
+		{"missing delegate", "eve", "/orgs/acme/users/ben/out-of-office", `{}`, 400},
+		{"bad body", "eve", "/orgs/acme/users/ben/out-of-office", `not json`, 400},
+		{"delegate is self", "eve", "/orgs/acme/users/ben/out-of-office", `{"delegate":"ben"}`, 400},
+		{"delegate unknown", "eve", "/orgs/acme/users/ben/out-of-office", `{"delegate":"zed"}`, 400},
+		{"delegate in other org", "eve", "/orgs/acme/users/ben/out-of-office", `{"delegate":"gus"}`, 400},
+		{"delegate is viewer", "eve", "/orgs/acme/users/ben/out-of-office", `{"delegate":"dan"}`, 400},
+		{"delegate not in project", "eve", "/orgs/acme/users/cat/out-of-office", `{"delegate":"ben"}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestOutOfOfficeMovesOnlyActiveTasks(t *testing.T) {
+	srv := newServer()
+	code, body := do(t, srv, "POST", "/orgs/acme/users/ben/out-of-office", "eve", `{"delegate":"cat"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var moved []Task
+	if err := json.Unmarshal([]byte(body), &moved); err != nil {
+		t.Fatal(err)
+	}
+	if len(moved) != 1 || moved[0].ID != "t1" || moved[0].Assignee != "cat" {
+		t.Fatalf("want [t1 assigned to cat], got %s", body)
+	}
+
+	// The change is visible through the normal API.
+	_, body = do(t, srv, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "cat" {
+		t.Fatalf("t1 assignee = %q, want cat", task.Assignee)
+	}
+
+	// Ben's task in the archived project is left untouched.
+	_, body = do(t, srv, "GET", "/projects/legacy/tasks/t5", "ann", "")
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "ben" {
+		t.Fatalf("archived t5 assignee = %q, want ben", task.Assignee)
+	}
+}
+
+func TestOutOfOfficeIsAllOrNothing(t *testing.T) {
+	srv := newServer()
+	// cat holds t2 (web) and t4 (ops). ben is a contributor in web but not in ops,
+	// so the operation must fail and leave t2 unchanged even though it could move.
+	code, _ := do(t, srv, "POST", "/orgs/acme/users/cat/out-of-office", "eve", `{"delegate":"ben"}`)
+	if code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	for _, path := range []string{"/projects/web/tasks/t2", "/projects/ops/tasks/t4"} {
+		_, body := do(t, srv, "GET", path, "ann", "")
+		var task Task
+		json.Unmarshal([]byte(body), &task)
+		if task.Assignee != "cat" {
+			t.Fatalf("%s assignee = %q, want cat", path, task.Assignee)
+		}
+	}
+}
+
+func TestOutOfOfficeNoTasks(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/hal/out-of-office", "eve", `{"delegate":"cat"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	if strings.TrimSpace(body) != "[]" {
+		t.Fatalf("want [], got %s", body)
+	}
+}
