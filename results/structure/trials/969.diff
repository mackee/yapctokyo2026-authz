index 0000000..2f6b238
--- /dev/null
+++ b/move_test.go
@@ -0,0 +1,59 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"contributor source", "ben", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer source", "dan", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin source", "eve", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"non member", "hal", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 404},
+		{"other org", "gus", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 401},
+		{"task in other project", "ivy", "/projects/ops/tasks/t1/move", `{"toProjectId":"web"}`, 404},
+		{"destination missing", "ivy", "/projects/web/tasks/t1/move", `{"toProjectId":"nope"}`, 404},
+		{"destination other org", "ivy", "/projects/web/tasks/t1/move", `{"toProjectId":"gx"}`, 404},
+		{"destination viewer only", "ann", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"destination archived", "ann", "/projects/web/tasks/t1/move", `{"toProjectId":"legacy"}`, 409},
+		{"source archived", "ann", "/projects/legacy/tasks/t5/move", `{"toProjectId":"web"}`, 409},
+		{"same project", "ivy", "/projects/web/tasks/t1/move", `{"toProjectId":"web"}`, 400},
+		{"missing destination", "ivy", "/projects/web/tasks/t1/move", `{}`, 400},
+		{"bad body", "ivy", "/projects/web/tasks/t1/move", `not json`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsTaskFields(t *testing.T) {
+	srv := newServer()
+	code, body := do(t, srv, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got Task
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", Assignee: "cat"}
+	if got != want {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks/t2", "ann", ""); code != 404 {
+		t.Fatalf("task still readable in source project: %d", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks/t2", "ann", ""); code != 200 {
+		t.Fatalf("task not readable in destination project: %d", code)
+	}
+}
