 }
 
+// changeRolesAggregate changes the roles of several members of one project.
+// Members demoted to viewer are no longer allowed to be assignees, so their
+// tasks in the project are unassigned in the same transaction.
+type changeRolesAggregate struct {
+	changes []roleChange
+}
+
+type roleChange struct {
+	member *Membership
+	role   string
+	tasks  []*Task // member.AssignedTasks, loaded when the new role cannot be an assignee
+}
+
+func loadChangeRoles(ctx context.Context, tx DB, projectID string, in MembershipTableChangeRolesInput) (*changeRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	userIDs := make([]string, 0, len(in.Roles))
+	for id := range in.Roles {
+		userIDs = append(userIDs, id)
+	}
+	sort.Strings(userIDs)
+	a := &changeRolesAggregate{}
+	for _, id := range userIDs {
+		m, err := p.Membership(ctx, tx, id)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "user "+id+" is not a member of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		c := roleChange{member: m, role: in.Roles[id]}
+		if isValidRole(c.role) && !isWriterRole(c.role) {
+			if c.tasks, err = m.AssignedTasks(ctx, tx); err != nil {
+				return nil, err
+			}
+		}
+		a.changes = append(a.changes, c)
+	}
+	return a, nil
+}
+
+func (a *changeRolesAggregate) validate() error {
+	for _, c := range a.changes {
+		if !isValidRole(c.role) {
+			return deny(ErrInvalid, "invalid role for user "+c.member.UserID)
+		}
+	}
+	return nil
+}
+
+func (a *changeRolesAggregate) apply(ctx context.Context, tx DB) error {
+	for _, c := range a.changes {
+		for _, t := range c.tasks {
+			if err := t.unassign(ctx, tx); err != nil {
+				return err
+			}
+		}
+		if err := c.member.setRole(ctx, tx, c.role); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
