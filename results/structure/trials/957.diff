+// the new role of each listed member, by user ID.
+type MembershipTableChangeRolesInput struct {
+	Roles map[string]string
+}
+
+// ChangeRoles changes the roles of several members of the project, all or
+// nothing, and returns the project's members afterwards. Every listed user must
+// be a member and every role valid, else ErrInvalid and nothing changes.
+func (mt *MembershipTable) ChangeRoles(ctx context.Context, db DB, authz ProjectAuthz, in MembershipTableChangeRolesInput) ([]*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if len(in.Roles) == 0 {
+		return nil, deny(ErrInvalid, "roles must not be empty")
+	}
+	var out []*Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadChangeRoles(ctx, tx, authz.ProjectID(), in)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if err := agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		out, err = mt.ListByProject(ctx, tx, authz.ProjectID())
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
