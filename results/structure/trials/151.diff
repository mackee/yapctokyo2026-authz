+func TestTransfer(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin moves unassigned user", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 200},
+		{"user holding project roles", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 409},
+		{"project manager is not org admin", "ann", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 403},
+		{"other org admin", "gus", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 404},
+		{"anonymous", "", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown caller", "zed", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown user", "eve", "/orgs/acme/users/nobody/transfer", `{"toOrgId":"globex"}`, 404},
+		{"user in another org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"unknown destination org", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"initech"}`, 400},
+		{"same organization", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"acme"}`, 400},
+		{"empty destination", "eve", "/orgs/acme/users/hal/transfer", `{}`, 400},
+		{"malformed body", "eve", "/orgs/acme/users/hal/transfer", `{`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferResponseAndEffect(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/orgs/acme/users/hal/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got struct {
+		ID    string `json:"id"`
+		OrgID string `json:"orgId"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.ID != "hal" || got.OrgID != "globex" {
+		t.Fatalf("got %+v", got)
+	}
+
+	// hal is no longer a user of acme, so acme's admin cannot act on hal again.
+	code, _ = do(t, h, "POST", "/orgs/acme/users/hal/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 404 {
+		t.Fatalf("second transfer from acme: got %d want 404", code)
+	}
+	// hal is now a globex user, so the acme admin cannot move them back.
+	code, _ = do(t, h, "POST", "/orgs/globex/users/hal/transfer", "eve", `{"toOrgId":"acme"}`)
+	if code != 404 {
+		t.Fatalf("globex path from acme caller: got %d want 404", code)
+	}
+}
+
+func TestTransferLeavesOthersIntact(t *testing.T) {
+	h := newServer()
+	do(t, h, "POST", "/orgs/acme/users/hal/transfer", "eve", `{"toOrgId":"globex"}`)
+	code, _ := do(t, h, "GET", "/projects/web/tasks", "ann", "")
+	if code != 200 {
+		t.Fatalf("ann lost access to web: got %d", code)
+	}
+}
