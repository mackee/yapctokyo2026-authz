--- /dev/null
+++ b/internal/capability/org.go
@@ -0,0 +1,71 @@
+package capability
+
+// UserView is the public representation of a user's organization.
+type UserView struct {
+	ID    string `json:"id"`
+	OrgID string `json:"orgId"`
+}
+
+// OrgScope is bound to one actor and one organization ID. It grants nothing by
+// itself; call Admin to acquire the capability.
+type OrgScope interface {
+	ID() string
+	Admin() (AdminOrg, error)
+}
+
+// AdminOrg may administer the users of one organization.
+type AdminOrg interface {
+	ID() string
+	// TransferUser moves a user of this organization to toOrgID (for example a
+	// move between group companies). The user must hold no project roles, so
+	// the move cannot leave memberships or task assignments that cross
+	// organizations.
+	TransferUser(userID, toOrgID string) (UserView, error)
+}
+
+type orgScope struct {
+	as  *actorScope
+	oid string
+}
+
+func (s *orgScope) ID() string { return s.oid }
+
+// Admin applies the org-admin rule: the actor must belong to this organization
+// (else 404) and be an org admin of it (else 403).
+func (s *orgScope) Admin() (AdminOrg, error) {
+	if s.as.actor.org != s.oid {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if !s.as.actor.orgAdmin {
+		return nil, deny(ErrForbidden, "forbidden")
+	}
+	return &adminOrg{os: s}, nil
+}
+
+type adminOrg struct{ os *orgScope }
+
+func (o *adminOrg) ID() string { return o.os.oid }
+
+func (o *adminOrg) TransferUser(userID, toOrgID string) (UserView, error) {
+	var v UserView
+	err := o.os.as.a.st.tx(func(s *state) error {
+		u, ok := s.users[userID]
+		if !ok || u.org != o.os.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		if !s.orgs[toOrgID] {
+			return deny(ErrInvalid, "unknown organization")
+		}
+		if toOrgID == u.org {
+			return deny(ErrInvalid, "user already belongs to that organization")
+		}
+		if s.hasProjectRole(userID) {
+			return deny(ErrConflict, "user still holds project roles; remove them before transferring")
+		}
+		u.org = toOrgID
+		s.users[u.id] = u
+		v = UserView{ID: u.id, OrgID: u.org}
+		return nil
+	})
+	return v, err
+}
