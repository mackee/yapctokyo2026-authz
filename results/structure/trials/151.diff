+func transferUser(ctx tanukirpc.Context[*orgRegistry], _ struct{}) (*capability.UserView, error) {
+	a, err := ctx.Registry().scope.Admin()
+	if err != nil {
+		return nil, err
+	}
+	var req transferRequest
+	if err := decodeBody(ctx.Request(), &req); err != nil || req.ToOrgID == "" {
+		return nil, errInvalidBody
+	}
+	v, err := a.TransferUser(chi.URLParam(ctx.Request(), "uid"), req.ToOrgID)
+	if err != nil {
+		return nil, err
+	}
+	return &v, nil
+}
