+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestTransferUser(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin transfers member", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 200},
+		{"contributor is not org admin", "ben", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 403},
+		{"manager is not org admin", "ann", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 403},
+		{"anonymous", "", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown caller", "zed", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 401},
+		{"caller in other org", "gus", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 404},
+		{"target user in other org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"unknown target user", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"missing toOrgId", "eve", "/orgs/acme/users/hal/transfer", `{}`, 400},
+		{"invalid json", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":`, 400},
+		{"unknown target org", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"nowhere"}`, 400},
+		{"same org", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"acme"}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d (body %s)", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestTransferUserResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/hal/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200 (body %s)", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("response is not a JSON object: %v (body %s)", err, body)
+	}
+	if got["id"] != "hal" || got["orgId"] != "globex" || len(got) != 2 {
+		t.Fatalf("got %v want {id: hal, orgId: globex}", got)
+	}
+}
+
+func TestTransferUserRevokesOldOrgAccess(t *testing.T) {
+	s := newServer()
+	if code, body := do(t, s, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: got %d want 200 (body %s)", code, body)
+	}
+	// ben was a contributor of acme's "web" project; after the move that
+	// project belongs to another organization and must not be readable.
+	if code, _ := do(t, s, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("transferred user still reads old org project: got %d want 404", code)
+	}
+}
+
+func TestTransferredAdminLosesAdminRights(t *testing.T) {
+	s := newServer()
+	if code, body := do(t, s, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: got %d want 200 (body %s)", code, body)
+	}
+	// eve is now a globex user with no project membership. Org admin rights
+	// are per organization, so they must not carry over to globex's projects.
+	if code, _ := do(t, s, "GET", "/projects/gx/tasks", "eve", ""); code != 404 {
+		t.Fatalf("transferred admin keeps org admin rights: got %d want 404", code)
+	}
+}
