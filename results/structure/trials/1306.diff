+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, org, target string
+		want                    int
+	}{
+		{"org admin removes member", "eve", "acme", "ben", 204},
+		{"org admin removes user without memberships", "eve", "acme", "hal", 204},
+		{"manager is not org admin", "ann", "acme", "ben", 403},
+		{"contributor is not org admin", "ben", "acme", "cat", 403},
+		{"anonymous", "", "acme", "ben", 401},
+		{"unknown caller", "zed", "acme", "ben", 401},
+		{"caller from other org", "gus", "acme", "ben", 404},
+		{"org path is other org", "eve", "globex", "gus", 404},
+		{"unknown org", "eve", "initech", "ben", 404},
+		{"target in other org", "eve", "acme", "gus", 404},
+		{"unknown target", "eve", "acme", "zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", "/orgs/"+c.org+"/users/"+c.target, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("got %d want 204: %s", code, body)
+	}
+
+	// ben is no longer a member of any acme project, archived ones included.
+	for _, path := range []string{"/projects/web/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, srv, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("GET %s as ben: got %d want 404", path, code)
+		}
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 404 {
+		t.Fatalf("POST as ben: got %d want 404", code)
+	}
+
+	// Tasks ben was assigned to in acme projects are unassigned.
+	for _, p := range []struct{ project, task string }{{"web", "t1"}, {"legacy", "t5"}} {
+		var task Task
+		_, body := do(t, srv, "GET", "/projects/"+p.project+"/tasks/"+p.task, "ann", "")
+		json.Unmarshal([]byte(body), &task)
+		if task.Assignee != "" {
+			t.Fatalf("task %s: assignee %q, want unassigned", p.task, task.Assignee)
+		}
+	}
+
+	// Everyone else keeps their memberships and assignments.
+	var task Task
+	_, body := do(t, srv, "GET", "/projects/web/tasks/t2", "ann", "")
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "cat" {
+		t.Fatalf("t2 assignee %q, want cat", task.Assignee)
+	}
+	if code, _ := do(t, srv, "PATCH", "/projects/web/tasks/t2", "cat", `{"status":"done"}`); code != 200 {
+		t.Fatalf("cat still contributes to web: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "ann", ""); code != 200 {
+		t.Fatalf("ann keeps ops viewer role: got %d want 200", code)
+	}
+
+	// Another org's membership is untouched.
+	if code, _ := do(t, srv, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatalf("gus keeps gx access: got %d want 200", code)
+	}
+
+	// Removing again is still a 204, and the org admin keeps reading.
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("second removal: got %d want 204", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "eve", ""); code != 200 {
+		t.Fatalf("eve reads web as org admin: got %d want 200", code)
+	}
+}
