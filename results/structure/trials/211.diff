+func TestRemoveUserFromOrgMemberships(t *testing.T) {
+	s := newSeededStore()
+	s.RemoveUserFromOrg("ann")
+	for _, p := range []string{"web", "ops", "legacy"} {
+		if r := s.Role(p, "ann"); r != "" {
+			t.Fatalf("still %s in %s", r, p)
+		}
+	}
+	if s.Role("web", "ben") == "" {
+		t.Fatal("other member removed")
+	}
+}
