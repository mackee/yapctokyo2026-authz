+// removeOrgUser offboards a user (e.g. on leaving the company). Only org
+// admins of the org may do it; other orgs see 404, non-admins 403.
+func (s *server) removeOrgUser(w http.ResponseWriter, r *http.Request) {
+	s.store.mu.Lock()
+	defer s.store.mu.Unlock()
+
+	user := s.store.User(r.Header.Get("X-User"))
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	if user.OrgID != r.PathValue("oid") {
+		writeError(w, 404, "not found")
+		return
+	}
+	if !user.OrgAdmin {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	target := s.store.User(r.PathValue("uid"))
+	if target == nil || target.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	s.store.RemoveUserFromOrg(target.ID)
+	w.WriteHeader(204)
+}
