+// RemoveUserFromOrg removes the user from every project's membership
+// (archived ones included), clears their task assignments, and deletes the
+// user so they lose org-wide access too (e.g. org admin read access).
+// The caller must hold s.mu.
+func (s *Store) RemoveUserFromOrg(userID string) {
+	for _, m := range s.members {
+		delete(m, userID)
+	}
+	for _, t := range s.tasks {
+		if t.Assignee == userID {
+			t.Assignee = ""
+		}
+	}
+	delete(s.users, userID)
+}
