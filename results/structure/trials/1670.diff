+// Freezing: POST /projects/{pid}/freeze. Only managers may freeze a project
+// (like deleting tasks); archived projects reject it with 409.
+func TestFreeze(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"other manager", "ivy", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+		{"archived", "ann", "legacy", 409},
+		{"missing project", "ann", "nope", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+// The response lists the project's members after the change, every role viewer,
+// including the managers.
+func TestFreezeResponse(t *testing.T) {
+	type member struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got []member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("response is not a member list: %v: %s", err, body)
+	}
+	want := []member{
+		{"ann", "viewer"},
+		{"ben", "viewer"},
+		{"cat", "viewer"},
+		{"dan", "viewer"},
+		{"ivy", "viewer"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+}
+
+// After a freeze nobody can change the project's tasks, and the project can
+// still be read. Other projects are not affected.
+func TestFreezeBlocksTaskWrites(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d: %s", code, body)
+	}
+	cases := []struct {
+		name, method, path, user, body string
+		want                           int
+	}{
+		{"manager create", "POST", "/projects/web/tasks", "ann", `{"title":"x"}`, 403},
+		{"manager update", "PATCH", "/projects/web/tasks/t2", "ann", `{"status":"done"}`, 403},
+		{"manager delete", "DELETE", "/projects/web/tasks/t1", "ann", "", 403},
+		{"former manager ivy update", "PATCH", "/projects/web/tasks/t1", "ivy", `{"status":"done"}`, 403},
+		{"contributor own update", "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`, 403},
+		{"contributor create", "POST", "/projects/web/tasks", "cat", `{"title":"x"}`, 403},
+		{"frozen manager cannot freeze again", "POST", "/projects/web/freeze", "ann", "", 403},
+		{"read still works", "GET", "/projects/web/tasks/t1", "dan", "", 200},
+		{"other project unaffected", "PATCH", "/projects/ops/tasks/t4", "ivy", `{"status":"done"}`, 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, srv, c.method, c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
