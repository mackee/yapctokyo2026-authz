+
+// removeOrgUser takes uid out of every project of orgID (offboarding). Tasks in
+// those projects that were assigned to uid become unassigned, so the assignee
+// rule keeps holding. The user record itself is kept.
+func (s *server) removeOrgUser(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	caller, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if caller == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	orgID := r.PathValue("orgID")
+	if caller.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	if !caller.OrgAdmin {
+		writeError(w, 403, "only org admins may remove users")
+		return
+	}
+	uid := r.PathValue("uid")
+	target, err := findUser(ctx, s.db, uid)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if target == nil || target.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+	if _, err := tx.ExecContext(ctx, `UPDATE tasks SET assignee = '' WHERE assignee = ?
+		AND project_id IN (SELECT id FROM projects WHERE org_id = ?)`, uid, orgID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if _, err := tx.ExecContext(ctx, `DELETE FROM memberships WHERE user_id = ?
+		AND project_id IN (SELECT id FROM projects WHERE org_id = ?)`, uid, orgID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	w.WriteHeader(204)
+}
diff --git a/org_users_test.go b/org_users_test.go
new file mode 100644
index 0000000..f610ffd
--- /dev/null
+++ b/org_users_test.go
@@ -0,0 +1,121 @@
+package main
+
+import "testing"
+
+func TestRemoveOrgUserAccess(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin, user with no memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"manager of org projects is not admin", "ann", "/orgs/acme/users/ben", 403},
+		{"contributor is not admin", "ben", "/orgs/acme/users/cat", 403},
+		{"other org admin", "gus", "/orgs/acme/users/ben", 404},
+		{"path org is another org", "eve", "/orgs/globex/users/gus", 404},
+		{"target in another org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserRemovesAllMemberships(t *testing.T) {
+	h := newServer()
+	code, _ := do(t, h, "DELETE", "/orgs/acme/users/ivy", "eve", "")
+	if code != 204 {
+		t.Fatalf("got %d want 204", code)
+	}
+	app := h.(*appHandler)
+	if n := countQuery(t, app, `SELECT COUNT(*) FROM memberships WHERE user_id = 'ivy'`); n != 0 {
+		t.Fatalf("ivy still has %d memberships", n)
+	}
+	// Other members are untouched.
+	if role := roleOf(t, app, "web", "ann"); role != "manager" {
+		t.Fatalf("ann in web: got role %q want manager", role)
+	}
+	if role := roleOf(t, app, "ops", "cat"); role != "contributor" {
+		t.Fatalf("cat in ops: got role %q want contributor", role)
+	}
+	// The removed user loses access to projects they were in.
+	code, _ = do(t, h, "GET", "/projects/web/tasks", "ivy", "")
+	if code != 404 {
+		t.Fatalf("ivy reads web: got %d want 404", code)
+	}
+}
+
+func TestRemoveOrgUserUnassignsTasks(t *testing.T) {
+	h := newServer()
+	code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", "")
+	if code != 204 {
+		t.Fatalf("got %d want 204", code)
+	}
+	app := h.(*appHandler)
+	if n := countQuery(t, app, `SELECT COUNT(*) FROM memberships WHERE user_id = 'ben'`); n != 0 {
+		t.Fatalf("ben still has %d memberships", n)
+	}
+	if got := taskAssignee(t, app, "t1"); got != "" {
+		t.Fatalf("t1 (web, was ben's) assignee = %q want unassigned", got)
+	}
+	if got := taskAssignee(t, app, "t5"); got != "" {
+		t.Fatalf("t5 (archived legacy, was ben's) assignee = %q want unassigned", got)
+	}
+	// Assignments to other users stay.
+	if got := taskAssignee(t, app, "t2"); got != "cat" {
+		t.Fatalf("t2 assignee = %q want cat", got)
+	}
+	if got := taskAssignee(t, app, "t4"); got != "cat" {
+		t.Fatalf("t4 assignee = %q want cat", got)
+	}
+}
+
+func TestRemoveOrgUserLeavesOtherOrgsAlone(t *testing.T) {
+	h := newServer()
+	// gus is in globex, so removing him from acme must not touch globex.
+	code, _ := do(t, h, "DELETE", "/orgs/acme/users/gus", "eve", "")
+	if code != 404 {
+		t.Fatalf("got %d want 404", code)
+	}
+	app := h.(*appHandler)
+	if role := roleOf(t, app, "gx", "gus"); role != "manager" {
+		t.Fatalf("gus in gx: got role %q want manager", role)
+	}
+	if got := taskAssignee(t, app, "t6"); got != "gus" {
+		t.Fatalf("t6 assignee = %q want gus", got)
+	}
+}
+
+func countQuery(t *testing.T, app *appHandler, query string) int {
+	t.Helper()
+	var n int
+	if err := app.db.QueryRow(query).Scan(&n); err != nil {
+		t.Fatal(err)
+	}
+	return n
+}
+
+func roleOf(t *testing.T, app *appHandler, project, user string) string {
+	t.Helper()
+	role, err := findRole(t.Context(), app.db, project, user)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return role
+}
+
+func taskAssignee(t *testing.T, app *appHandler, task string) string {
+	t.Helper()
+	var a string
+	if err := app.db.QueryRow(`SELECT assignee FROM tasks WHERE id = ?`, task).Scan(&a); err != nil {
+		t.Fatal(err)
+	}
+	return a
+}
