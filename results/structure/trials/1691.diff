+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager of both", "ivy", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 200},
+		{"unassigned task", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 200},
+		{"contributor in source", "ben", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"viewer in source", "dan", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"org admin", "eve", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"destination viewer only", "ann", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"destination not a member", "ivy", "/projects/web/tasks/t1", `{"toProjectId":"legacy"}`, 404},
+		{"destination other org", "ann", "/projects/web/tasks/t1", `{"toProjectId":"gx"}`, 404},
+		{"destination missing", "ann", "/projects/web/tasks/t1", `{"toProjectId":"nope"}`, 404},
+		{"destination archived", "ann", "/projects/web/tasks/t1", `{"toProjectId":"legacy"}`, 409},
+		{"source archived", "ann", "/projects/legacy/tasks/t5", `{"toProjectId":"web"}`, 409},
+		{"same project", "ann", "/projects/web/tasks/t1", `{"toProjectId":"web"}`, 400},
+		{"empty body", "ann", "/projects/web/tasks/t1", ``, 400},
+		{"empty destination", "ann", "/projects/web/tasks/t1", `{"toProjectId":""}`, 400},
+		{"cross project id", "ivy", "/projects/web/tasks/t4", `{"toProjectId":"ops"}`, 404},
+		{"non member source", "hal", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 404},
+		{"cross org source", "gus", "/projects/web/tasks/t1", `{"toProjectId":"gx"}`, 404},
+		{"anonymous", "", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveCarriesTaskOver(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var moved Task
+	if err := json.Unmarshal([]byte(body), &moved); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", Assignee: "cat"}
+	if moved != want {
+		t.Fatalf("got %+v want %+v", moved, want)
+	}
+
+	// The task now lives in ops and no longer in web.
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks/t2", "ivy", ""); code != 200 {
+		t.Fatalf("task not in destination: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t2", "ivy", ""); code != 404 {
+		t.Fatalf("task still in source: %d", code)
+	}
+	_, list := do(t, h, "GET", "/projects/web/tasks", "ivy", "")
+	var tasks []Task
+	json.Unmarshal([]byte(list), &tasks)
+	if len(tasks) != 2 {
+		t.Fatalf("want 2 tasks left in web, got %d", len(tasks))
+	}
+}
+
+func TestMoveRejectedLeavesTaskInPlace(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/tasks/t1/move", "ann", `{"toProjectId":"ops"}`); code != 403 {
+		t.Fatalf("got %d want 403", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t1", "ann", ""); code != 200 {
+		t.Fatalf("task left source after rejected move: %d", code)
+	}
+}
