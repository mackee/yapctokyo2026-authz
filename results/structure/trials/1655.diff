+// updateMembershipAggregate changes the role of one member of a project.
+type updateMembershipAggregate struct {
+	membership *Membership // the member, found in the project
+	role       string
+	assigned   []*Task // the tasks of the project assigned to the member
+}
+
+func loadUpdateMembership(ctx context.Context, tx DB, projectID string, in MembershipTableUpdateInput) (*updateMembershipAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, projectID, in.UserID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	assigned, err := m.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &updateMembershipAggregate{membership: m, role: in.Role, assigned: assigned}, nil
+}
+
+// validate: an assignee must be a contributor or manager, so a member with
+// tasks assigned in the project cannot become a viewer.
+func (a *updateMembershipAggregate) validate() error {
+	if !isWriterRole(a.role) && len(a.assigned) > 0 {
+		return deny(ErrInvalid, "member has tasks assigned in the project; reassign them before making them a viewer")
+	}
+	return nil
+}
+
+func (a *updateMembershipAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.membership.setRole(ctx, tx, a.role); err != nil {
+		return nil, err
+	}
+	return a.membership, nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
