 import "context"
 
-// MembershipTable reads the memberships table.
+// MembershipTable is the memberships table.
+//
+// Find and List* read rows. UpdateRole is an operation: it takes the
+// database, the project's authorization object and an input, asks the
+// authorization object whether the actor may manage members, then runs its
+// aggregate (aggregate.go) in a transaction.
 type MembershipTable struct{}
 
 // NewMembershipTable returns the memberships table.
 func NewMembershipTable() *MembershipTable { return &MembershipTable{} }
 
+// MembershipTableUpdateInput is the input of MembershipTable.UpdateRole.
+type MembershipTableUpdateInput struct {
+	UserID string
+	Role   string
+}
+
+var validRoles = map[string]bool{RoleManager: true, RoleContributor: true, RoleViewer: true}
+
+// UpdateRole changes the role of a member of the project and returns the
+// membership. A member who is not in the project is ErrNotFound; a member with
+// tasks assigned in the project cannot become a viewer (ErrInvalid).
+func (*MembershipTable) UpdateRole(ctx context.Context, db DB, authz ProjectAuthz, in MembershipTableUpdateInput) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if !validRoles[in.Role] {
+		return nil, deny(ErrInvalid, "role must be manager, contributor or viewer")
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadUpdateMembership(ctx, tx, authz.ProjectID(), in)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		m, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
+
 // Find returns the membership of the user in the project, or ErrNoRows.
