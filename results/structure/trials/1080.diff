+// updateRolesAggregate changes the roles of several members of one project.
+type updateRolesAggregate struct {
+	members []*Membership // the target memberships, ordered by user ID
+	roles   map[string]string
+}
+
+func loadUpdateRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*updateRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	userIDs := make([]string, 0, len(roles))
+	for userID := range roles {
+		userIDs = append(userIDs, userID)
+	}
+	sort.Strings(userIDs)
+	a := &updateRolesAggregate{roles: roles}
+	for _, userID := range userIDs {
+		m, err := p.Membership(ctx, tx, userID)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, fmt.Sprintf("%s is not a member of the project", userID))
+		} else if err != nil {
+			return nil, err
+		}
+		a.members = append(a.members, m)
+	}
+	return a, nil
+}
+
+func (a *updateRolesAggregate) validate(ctx context.Context, tx DB) error {
+	for _, m := range a.members {
+		if a.roles[m.UserID] != RoleViewer {
+			continue
+		}
+		// An assignee must be a contributor or manager, so a member with assigned
+		// tasks cannot become a viewer.
+		tasks, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return err
+		}
+		if len(tasks) > 0 {
+			return deny(ErrInvalid, fmt.Sprintf("%s has assigned tasks in the project and cannot become a viewer", m.UserID))
+		}
+	}
+	return nil
+}
+
+func (a *updateRolesAggregate) apply(ctx context.Context, tx DB) error {
+	for _, m := range a.members {
+		if err := m.setRole(ctx, tx, a.roles[m.UserID]); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
