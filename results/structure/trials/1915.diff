+// orgRegistry is the whole handler-visible surface under /orgs/{orgID}. It only
+// carries the authenticated actor: the organization's authorization object is
+// built in the handler, after tanukirpc has validated the request body, so a
+// malformed body is a 400 before any access decision.
+type orgRegistry struct {
+	db    model.DB
+	actor model.Actor
+}
+
+func orgTransformer(conn *sql.DB) tanukirpc.Transformer[*rootRegistry, *orgRegistry] {
+	return tanukirpc.NewTransformer(func(ctx tanukirpc.Context[*rootRegistry]) (*orgRegistry, error) {
+		actor, err := model.Authenticate(ctx, conn, ctx.Request().Header.Get("X-User"))
+		if err != nil {
+			return nil, err
+		}
+		return &orgRegistry{db: conn, actor: actor}, nil
+	})
+}
+
+type transferRequest struct {
+	ToOrgID string `json:"toOrgId" validate:"required"`
+}
+
+func transferUser(ctx tanukirpc.Context[*orgRegistry], req transferRequest) (*model.User, error) {
+	reg := ctx.Registry()
+	authz, err := model.NewOrgAuthz(reg.actor, chi.URLParam(ctx.Request(), "orgID"))
+	if err != nil {
+		return nil, err
+	}
+	return model.NewUserTable().Transfer(ctx, reg.db, authz, chi.URLParam(ctx.Request(), "uid"), model.UserTableTransferInput{ToOrg: req.ToOrgID})
+}
