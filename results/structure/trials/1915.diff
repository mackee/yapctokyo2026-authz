diff --git a/transfer_test.go b/transfer_test.go
new file mode 100644
index 0000000..5716e75
--- /dev/null
+++ b/transfer_test.go
@@ -0,0 +1,132 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+const transferBody = `{"toOrgId":"globex"}`
+
+func TestTransferStatus(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben/transfer", transferBody, 200},
+		{"member with project roles", "eve", "/orgs/acme/users/ann/transfer", transferBody, 200},
+		{"user without memberships", "eve", "/orgs/acme/users/hal/transfer", transferBody, 200},
+		{"anonymous", "", "/orgs/acme/users/ben/transfer", transferBody, 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben/transfer", transferBody, 401},
+		{"not an org admin", "ann", "/orgs/acme/users/ben/transfer", transferBody, 403},
+		{"project manager is not org admin", "ivy", "/orgs/acme/users/ben/transfer", transferBody, 403},
+		{"caller from other org", "gus", "/orgs/acme/users/ben/transfer", transferBody, 404},
+		{"unknown org", "eve", "/orgs/nowhere/users/ben/transfer", transferBody, 404},
+		{"user in another org", "eve", "/orgs/acme/users/gus/transfer", transferBody, 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed/transfer", transferBody, 404},
+		{"malformed body", "eve", "/orgs/acme/users/ben/transfer", `{`, 400},
+		{"missing toOrgId", "eve", "/orgs/acme/users/ben/transfer", `{}`, 400},
+		{"empty toOrgId", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":""}`, 400},
+		{"malformed body beats access", "ann", "/orgs/acme/users/ben/transfer", `{}`, 400},
+		{"unknown target org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"nowhere"}`, 400},
+		{"same org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"acme"}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d (%s)", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/ben/transfer", "eve", transferBody)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got map[string]any
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 2 || got["id"] != "ben" || got["orgId"] != "globex" {
+		t.Fatalf("got %s", body)
+	}
+}
+
+// The user leaves the old organization completely: project roles in the old
+// organization are dropped and tasks assigned to the user become unassigned
+// (the model rules in rules_test.go are checked after every write by do()).
+func TestTransferDropsOldOrgAccess(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", transferBody); code != 200 {
+		t.Fatal(code, body)
+	}
+
+	// ben now belongs to globex: no access to acme projects, none to gx either.
+	for _, p := range []string{"web", "legacy", "gx"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ben", ""); code != 404 {
+			t.Fatalf("ben reads %s: got %d want 404", p, code)
+		}
+	}
+	// gus (globex) still reads gx.
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatalf("gus reads gx: got %d", code)
+	}
+
+	// tasks ben held, including one in an archived project, are unassigned.
+	for _, path := range []string{"/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		code, body := do(t, h, "GET", path, "ann", "")
+		if code != 200 {
+			t.Fatal(path, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.AssigneeID != "" {
+			t.Fatalf("%s still assigned to %q", path, task.AssigneeID)
+		}
+	}
+	// other tasks are untouched.
+	code, body := do(t, h, "GET", "/projects/web/tasks/t2", "ann", "")
+	var t2 Task
+	json.Unmarshal([]byte(body), &t2)
+	if code != 200 || t2.AssigneeID != "cat" {
+		t.Fatalf("t2 changed: %d %s", code, body)
+	}
+	// others keep their access.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ann", ""); code != 200 {
+		t.Fatalf("ann reads web: got %d", code)
+	}
+}
+
+// Organization admin rights belong to one organization: a transferred admin is
+// an ordinary member of the new one, and the old organization cannot be
+// administered by them any more.
+func TestTransferResetsOrgAdmin(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/orgs/acme/users/eve/transfer", "eve", transferBody); code != 200 {
+		t.Fatal(code, body)
+	}
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "eve", ""); code != 404 {
+		t.Fatalf("eve reads gx: got %d want 404", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "eve", ""); code != 404 {
+		t.Fatalf("eve reads web: got %d want 404", code)
+	}
+	if code, _ := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", transferBody); code != 404 {
+		t.Fatalf("eve administers acme: got %d want 404", code)
+	}
+}
+
+// A rejected transfer changes nothing.
+func TestTransferRejectedChangesNothing(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "ann", transferBody); code != 403 {
+		t.Fatal(code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t1", "ben", ""); code != 200 {
+		t.Fatalf("ben lost access: %d", code)
+	}
+}
