+package main
+
+import "testing"
+
+func countRows(t *testing.T, h *appHandler, query string, args ...any) int {
+	t.Helper()
+	var n int
+	if err := h.db.QueryRow(query, args...).Scan(&n); err != nil {
+		t.Fatal(err)
+	}
+	return n
+}
+
+func TestRemoveUserStatuses(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes viewer-only user", "eve", "/orgs/acme/users/dan", 204},
+		{"org admin removes user without memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"org admin removes themself", "eve", "/orgs/acme/users/eve", 204},
+		{"non admin", "ann", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"caller not in that org", "eve", "/orgs/globex/users/gus", 404},
+		{"non admin of other org", "gus", "/orgs/acme/users/ben", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveUserIsRepeatable404(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("first delete: %d", code)
+	}
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 404 {
+		t.Fatalf("second delete: %d", code)
+	}
+}
+
+func TestRemoveUserLeavesAllProjects(t *testing.T) {
+	h := newServer()
+	app := h.(*appHandler)
+	// ben is a member of web and legacy (archived); cat of web and ops.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("got %d", code)
+	}
+	if n := countRows(t, app, `SELECT COUNT(*) FROM memberships WHERE user_id = 'ben'`); n != 0 {
+		t.Fatalf("ben still has %d memberships", n)
+	}
+	// Others are untouched.
+	if n := countRows(t, app, `SELECT COUNT(*) FROM memberships WHERE user_id <> 'ben'`); n != 9 {
+		t.Fatalf("other memberships changed: %d", n)
+	}
+	// The removed user can no longer act.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 401 {
+		t.Fatalf("removed user got %d, want 401", code)
+	}
+}
+
+func TestRemoveUserUnassignsTasks(t *testing.T) {
+	h := newServer()
+	app := h.(*appHandler)
+	// t1 (web) and t5 (legacy, archived) are assigned to ben.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("got %d", code)
+	}
+	if n := countRows(t, app, `SELECT COUNT(*) FROM tasks WHERE assignee = 'ben'`); n != 0 {
+		t.Fatalf("%d tasks still assigned to ben", n)
+	}
+	// The tasks themselves survive; other assignments are untouched.
+	if n := countRows(t, app, `SELECT COUNT(*) FROM tasks`); n != 6 {
+		t.Fatalf("tasks deleted: %d left", n)
+	}
+	if n := countRows(t, app, `SELECT COUNT(*) FROM tasks WHERE id IN ('t2','t4') AND assignee = 'cat'`); n != 2 {
+		t.Fatal("cat's tasks changed")
+	}
+}
+
+func TestRemovedOrgAdminLosesAccess(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/eve", "eve", ""); code != 204 {
+		t.Fatalf("got %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "eve", ""); code != 401 {
+		t.Fatalf("removed admin got %d, want 401", code)
+	}
+}
+
+func TestRemoveUserDoesNotTouchOtherOrgs(t *testing.T) {
+	h := newServer()
+	app := h.(*appHandler)
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ann", "eve", ""); code != 204 {
+		t.Fatalf("got %d", code)
+	}
+	if n := countRows(t, app, `SELECT COUNT(*) FROM memberships WHERE project_id = 'gx'`); n != 1 {
+		t.Fatalf("globex memberships changed: %d", n)
+	}
+}
