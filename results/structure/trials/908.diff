+// Freeze sets every member of the project, managers included, to the viewer
+// role, so that no one can change the project's tasks. It is all-or-nothing and
+// returns the members after the change, ordered by user ID. Only managers may
+// freeze (ErrForbidden otherwise), and an archived project rejects it (ErrArchived).
+func (*ProjectTable) Freeze(ctx context.Context, db DB, authz ProjectAuthz) ([]*Membership, error) {
+	if err := authz.CanFreeze(); err != nil {
+		return nil, err
+	}
+	var out []*Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadFreezeProject(ctx, tx, authz.ProjectID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		out, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
