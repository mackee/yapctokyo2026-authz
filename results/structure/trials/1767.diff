+// moveMemberAggregate moves one member from a project to another, keeping the
+// role. Tasks the member had in the source project lose their assignee, since
+// an assignee must be a contributor or manager of the task's project.
+type moveMemberAggregate struct {
+	from  *Membership
+	to    *Project
+	user  *User
+	tasks []*Task // from.AssignedTasks
+	// existing is the user's membership in the destination, or nil.
+	existing *Membership
+}
+
+func loadMoveMember(ctx context.Context, tx DB, fromProjectID, userID, toProjectID string) (*moveMemberAggregate, error) {
+	from, err := NewMembershipTable().Find(ctx, tx, fromProjectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	to, err := NewProjectTable().Find(ctx, tx, toProjectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	u, err := from.User(ctx, tx)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "project members must be existing users")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveMemberAggregate{from: from, to: to, user: u}
+	if a.tasks, err = from.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	m, err := to.Membership(ctx, tx, userID)
+	if err == nil {
+		a.existing = m
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.from.ProjectID == a.to.ID {
+		return deny(ErrInvalid, "the user is already a member of that project")
+	}
+	if a.existing != nil {
+		return deny(ErrInvalid, "the user is already a member of the destination project")
+	}
+	if a.user.Org != a.to.Org {
+		return deny(ErrInvalid, "project members must belong to the project's organization")
+	}
+	switch a.from.Role {
+	case RoleManager, RoleContributor, RoleViewer:
+	default:
+		return deny(ErrInvalid, "invalid role")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.from.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	m := a.to.newMembership(a.user.ID, a.from.Role)
+	if err := m.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
