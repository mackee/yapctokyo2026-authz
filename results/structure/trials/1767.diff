+// Move removes the user from the project of authz and adds them to the
+// destination project with the same role. The actor must be able to manage the
+// members of both projects; a destination the actor cannot read is ErrNotFound.
+func (*MembershipTable) Move(ctx context.Context, db DB, authz ProjectAuthz, userID, toProjectID string) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	to, err := NewProjectAuthz(ctx, db, authz.Actor(), toProjectID)
+	if err != nil {
+		return nil, err
+	}
+	if err := to.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveMember(ctx, tx, authz.ProjectID(), userID, toProjectID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if m, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
