 type ManageTask interface {
 	EditTask
 	Delete() error
+	// MoveTo moves the task into another project and returns it. The caller
+	// must also be a manager of the destination project, which must not be
+	// archived. The task keeps its ID, title, status and assignee; if it has
+	// an assignee, that user must be a contributor or manager of the
+	// destination (else 400 and nothing changes).
+	MoveTo(toProjectID string) (TaskView, error)
 }
 
 type taskScope struct {
@@ -437,3 +443,44 @@ func (t *manageTask) Delete() error {
 		return nil
 	})
 }
+
+// requireManagerOf applies the rule for a destination project: readable (else
+// 404), manager role (else 403), not archived (else 409).
+func requireManagerOf(x *tx, act Actor, pid string) error {
+	p, role, err := readable(x, act, pid)
+	if err != nil {
+		return err
+	}
+	if role != RoleManager {
+		return deny(ErrForbidden, "forbidden")
+	}
+	if p.Archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	return nil
+}
+
+func (t *manageTask) MoveTo(toProjectID string) (TaskView, error) {
+	if toProjectID == "" {
+		return TaskView{}, deny(ErrInvalid, "toProjectId is required")
+	}
+	if toProjectID == t.ts.ps.pid {
+		return TaskView{}, deny(ErrInvalid, "task is already in that project")
+	}
+	var v TaskView
+	err := t.ts.ps.as.a.db.update(func(x *tx) error {
+		if err := requireManagerOf(x, t.ts.ps.as.actor, toProjectID); err != nil {
+			return err
+		}
+		agg, err := loadMoveTask(x, t.ts.tid, toProjectID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		v = agg.apply(x)
+		return nil
+	})
+	return v, err
+}
