+type moveRequest struct {
+	ToProjectID string `json:"toProjectId"`
+}
+
+func moveTask(ctx tanukirpc.Context[*taskRegistry], _ struct{}) (*Task, error) {
+	t, err := ctx.Registry().scope.Manage()
+	if err != nil {
+		return nil, err
+	}
+	var req moveRequest
+	if err := decodeBody(ctx.Request(), &req); err != nil {
+		return nil, errInvalidBody
+	}
+	v, err := t.MoveTo(req.ToProjectID)
+	if err != nil {
+		return nil, err
+	}
+	return &v, nil
+}
