diff --git a/internal/capability/aggregate.go b/internal/capability/aggregate.go
index 1c6ebfe..bb5a7cb 100644
--- a/internal/capability/aggregate.go
+++ b/internal/capability/aggregate.go
@@ -118,3 +118,45 @@ func loadDeleteTask(x *tx, taskID string) (*deleteTaskAggregate, error) {
 func (a *deleteTaskAggregate) validate() error { return nil }
 
 func (a *deleteTaskAggregate) apply(x *tx) { a.task.Destroy(x) }
+
+// moveTaskAggregate moves one task into another project. The task keeps its
+// ID, title, status and assignee, so the assignee must already be a
+// contributor or manager of the destination project.
+type moveTaskAggregate struct {
+	task     taskRecord
+	to       projectRecord
+	assignee *membershipRecord // to.Membership(assignee); nil means unassigned
+}
+
+func loadMoveTask(x *tx, taskID, toProjectID string) (*moveTaskAggregate, error) {
+	t, ok := x.findTask(taskID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	to, ok := x.findProject(toProjectID)
+	if !ok {
+		return nil, deny(ErrInvalid, "task must belong to an existing project")
+	}
+	a := &moveTaskAggregate{task: t, to: to}
+	if t.AssigneeID != "" {
+		m, ok := to.Membership(x, t.AssigneeID)
+		if !ok {
+			return nil, deny(ErrInvalid, "assignee must be a contributor or manager of the project")
+		}
+		a.assignee = &m
+	}
+	return a, nil
+}
+
+func (a *moveTaskAggregate) validate() error {
+	if a.assignee != nil && !isWriterRole(a.assignee.Role) {
+		return deny(ErrInvalid, "assignee must be a contributor or manager of the project")
+	}
+	return nil
+}
+
+func (a *moveTaskAggregate) apply(x *tx) TaskView {
+	t := a.task
+	t.MoveTo(x, a.to)
+	return t.view()
+}
