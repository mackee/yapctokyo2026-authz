+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager in both, unassigned", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 200},
+		{"manager in both, assignee kept", "ivy", "/projects/web/tasks/t2/move", `{"toProjectId":"ops"}`, 200},
+		{"contributor source", "ben", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer source", "dan", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin source", "eve", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer destination", "ann", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 403},
+		{"non member source", "hal", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 404},
+		{"other org source", "gus", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 404},
+		{"destination missing", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"nope"}`, 404},
+		{"destination other org", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"gx"}`, 404},
+		{"destination archived", "ann", "/projects/web/tasks/t3/move", `{"toProjectId":"legacy"}`, 409},
+		{"archived source", "ann", "/projects/legacy/tasks/t5/move", `{"toProjectId":"web"}`, 409},
+		{"same project", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"web"}`, 400},
+		{"missing destination", "ivy", "/projects/web/tasks/t3/move", `{}`, 400},
+		{"bad body", "ivy", "/projects/web/tasks/t3/move", `not json`, 400},
+		{"assignee not in destination", "ivy", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 400},
+		{"cross project path", "ivy", "/projects/ops/tasks/t3/move", `{"toProjectId":"web"}`, 404},
+		{"unknown task", "ivy", "/projects/web/tasks/t99/move", `{"toProjectId":"ops"}`, 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsTask(t *testing.T) {
+	srv := newServer()
+
+	code, body := do(t, srv, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d: %s", code, body)
+	}
+	var moved Task
+	if err := json.Unmarshal([]byte(body), &moved); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", Assignee: "cat"}
+	if moved != want {
+		t.Fatalf("moved task = %+v, want %+v", moved, want)
+	}
+
+	// Gone from the source project.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks/t2", "ann", ""); code != 404 {
+		t.Fatalf("source still has task: got %d", code)
+	}
+	// Present in the destination, with the same data.
+	code, body = do(t, srv, "GET", "/projects/ops/tasks/t2", "ann", "")
+	if code != 200 {
+		t.Fatalf("destination get: got %d: %s", code, body)
+	}
+	var got Task
+	json.Unmarshal([]byte(body), &got)
+	if got != want {
+		t.Fatalf("destination task = %+v, want %+v", got, want)
+	}
+}
+
+func TestMoveRejectedChangesNothing(t *testing.T) {
+	srv := newServer()
+
+	// ben is a contributor in web but not in ops, so t1 cannot move there.
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks/t1/move", "ivy", `{"toProjectId":"ops"}`); code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	code, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ben", "")
+	if code != 200 {
+		t.Fatalf("task gone after rejected move: got %d", code)
+	}
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.ProjectID != "web" || task.Assignee != "ben" {
+		t.Fatalf("task changed by rejected move: %+v", task)
+	}
+}
+
+func TestMoveVisibleInListings(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks/t3/move", "ivy", `{"toProjectId":"ops"}`); code != 200 {
+		t.Fatal("move failed")
+	}
+	count := func(path string) int {
+		code, body := do(t, srv, "GET", path, "ivy", "")
+		if code != 200 {
+			t.Fatalf("list %s: got %d", path, code)
+		}
+		var tasks []Task
+		json.Unmarshal([]byte(body), &tasks)
+		return len(tasks)
+	}
+	if n := count("/projects/web/tasks"); n != 2 {
+		t.Fatalf("web: want 2 tasks, got %d", n)
+	}
+	if n := count("/projects/ops/tasks"); n != 2 {
+		t.Fatalf("ops: want 2 tasks (t3 added to t4), got %d", n)
+	}
+}
