@@ -0,0 +1,67 @@
+package main
+
+import (
+	"net/http"
+	"strings"
+	"testing"
+)
+
+func TestTransfer(t *testing.T) {
+	h := newServer()
+	body := `{"toOrgId":"globex"}`
+
+	// ben is a contributor in web and legacy and is assigned t1 and t5.
+	code, out := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", body)
+	if code != http.StatusOK || strings.TrimSpace(out) != `{"id":"ben","orgId":"globex"}` {
+		t.Fatalf("transfer = %d %s", code, out)
+	}
+	// model rules were checked by do(); the old projects are no longer visible to ben.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != http.StatusNotFound {
+		t.Errorf("ben reading web = %d, want 404", code)
+	}
+	// ben's tasks were unassigned, not deleted.
+	code, out = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != http.StatusOK || !strings.Contains(out, `"assignee":""`) {
+		t.Errorf("t1 = %d %s, want unassigned", code, out)
+	}
+}
+
+func TestTransferResetsOrgAdmin(t *testing.T) {
+	h := newServer()
+	if code, out := do(t, h, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != http.StatusOK {
+		t.Fatalf("transfer = %d %s", code, out)
+	}
+	// eve is no longer an admin of anything: she can't read globex's project.
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "eve", ""); code != http.StatusNotFound {
+		t.Errorf("eve reading gx = %d, want 404", code)
+	}
+}
+
+func TestTransferErrors(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"unauthenticated", "", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 401},
+		{"non-admin", "ann", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 403},
+		{"other org's admin sees nothing", "eve", "/orgs/globex/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"user in another org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"globex"}`, 404},
+		{"unknown user", "eve", "/orgs/acme/users/nobody/transfer", `{"toOrgId":"globex"}`, 404},
+		{"unknown destination", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"nowhere"}`, 400},
+		{"same org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"acme"}`, 400},
+		{"missing body field", "eve", "/orgs/acme/users/ben/transfer", `{}`, 400},
+		{"bad json", "eve", "/orgs/acme/users/ben/transfer", `{`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			if code, out := do(t, h, "POST", c.path, c.user, c.body); code != c.want {
+				t.Errorf("got %d %s, want %d", code, out, c.want)
+			}
+			// a rejected transfer changes nothing
+			if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != http.StatusOK {
+				t.Errorf("ben lost access after a rejected transfer: %d", code)
+			}
+		})
+	}
+}
