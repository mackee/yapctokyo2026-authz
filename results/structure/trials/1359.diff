@@ -123,6 +123,21 @@ module taskboard {
     else if (projects.get(p).archived) 409
     else 204
 
+  // PUT /projects/{pid}/members {"roles": {user: role, ...}}
+  // All-or-nothing: only managers may change roles; every target must be a
+  // current member and every role valid; a member who is the assignee of a
+  // task in the project cannot be demoted to viewer (would break
+  // inv_assigneeIsWriter) -> 409.
+  def setRolesOutcome(u: UserId, p: ProjectId, rs: UserId -> Role): int =
+    if (not(userExists(u))) 401
+    else if (not(canRead(u, p))) 404
+    else if (roleOf(p, u) != "manager") 403
+    else if (projects.get(p).archived) 409
+    else if (rs.keys().exists(k => not(members.keys().contains((p, k))) or not(ROLES.contains(rs.get(k))))) 400
+    else if (rs.keys().exists(k => rs.get(k) == "viewer" and
+        tasks.keys().exists(t => tasks.get(t).project == p and tasks.get(t).assignee == k))) 409
+    else 200
+
   // ---- actions -------------------------------------------------------------
 
   action unchanged = all {
@@ -164,6 +179,16 @@ module taskboard {
       members' = members,
     } else unchanged
 
+  action setRoles(u: UserId, p: ProjectId, rs: UserId -> Role): bool =
+    if (setRolesOutcome(u, p, rs) == 200) all {
+      members' = members.keys().mapBy(k =>
+        if (k._1 == p and rs.keys().contains(k._2)) rs.get(k._2) else members.get(k)),
+      tasks' = tasks,
+      nextTask' = nextTask,
+      users' = users,
+      projects' = projects,
+    } else unchanged
+
   // ---- seed data and steps -------------------------------------------------
 
   action init = all {
@@ -202,7 +227,13 @@ module taskboard {
     nondet t = 1.to(nextTask).oneOf()
