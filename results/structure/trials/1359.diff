+    nondet u2 = USERS.oneOf()
+    nondet r1 = ROLES.union(Set("bogus")).oneOf()
+    nondet r2 = ROLES.union(Set("bogus")).oneOf()
+    nondet n = Set(0, 1, 2).oneOf()
+    val rs = if (n == 0) Map() else if (n == 1) Map(a -> r1) else Map(a -> r1, u2 -> r2)
     any {
+      setRoles(u, p, rs),
       createTask(u, p, a),
       updateTask(u, p, t, s, changeAssignee, a),
       deleteTask(u, p, t),
@@ -230,6 +261,13 @@ module taskboard {
       assert(deleteOutcome("ann", "web", 1) == 204),
       assert(deleteOutcome("ben", "web", 1) == 403),
       assert(deleteOutcome("ann", "web", 4) == 404),
+      assert(setRolesOutcome("ann", "web", Map("dan" -> "contributor")) == 200),
