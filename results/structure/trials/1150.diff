+func TestFreezeStatus(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin without role", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+		{"unknown project", "ann", "missing", 404},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeBody(t *testing.T) {
+	_, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	var got []memberRole
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("bad body %q: %v", body, err)
+	}
+	want := []memberRole{
+		{"ann", "viewer"}, {"ben", "viewer"}, {"cat", "viewer"},
+		{"dan", "viewer"}, {"ivy", "viewer"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("member %d: got %v want %v", i, got[i], want[i])
+		}
+	}
+}
+
+func TestFreezeBlocksTaskWrites(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ivy", ""); code != 200 {
+		t.Fatalf("freeze: got %d", code)
+	}
+	cases := []struct {
+		name, method, path, user, body string
+		want                           int
+	}{
+		{"former manager create", "POST", "/projects/web/tasks", "ann", `{"title":"x"}`, 403},
+		{"former contributor create", "POST", "/projects/web/tasks", "ben", `{"title":"x"}`, 403},
+		{"former contributor update own", "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`, 403},
+		{"former manager update", "PATCH", "/projects/web/tasks/t2", "ann", `{"status":"done"}`, 403},
+		{"former manager delete", "DELETE", "/projects/web/tasks/t1", "ann", "", 403},
+		{"members can still read", "GET", "/projects/web/tasks/t1", "ben", "", 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, h, c.method, c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeOnlyAffectsProject(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d", code)
+	}
+	// cat is a contributor in ops, which was not frozen.
+	if code, _ := do(t, h, "POST", "/projects/ops/tasks", "cat", `{"title":"x"}`); code != 200 {
+		t.Fatalf("ops create after web freeze: got %d want 200", code)
+	}
+	// ann's manager role in legacy is untouched too; legacy is archived, so 409 not 403.
+	if code, _ := do(t, h, "POST", "/projects/legacy/tasks", "ann", `{"title":"x"}`); code != 409 {
+		t.Fatalf("legacy create: got %d want 409", code)
+	}
+}
+
+func TestFreezeTwiceRefusedForFormerManager(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/ops/freeze", "ivy", ""); code != 200 {
+		t.Fatalf("first freeze: got %d", code)
+	}
+	// ivy is a viewer now, so a second freeze by her is refused.
+	if code, _ := do(t, h, "POST", "/projects/ops/freeze", "ivy", ""); code != 403 {
+		t.Fatalf("second freeze by former manager: got %d want 403", code)
+	}
+}
