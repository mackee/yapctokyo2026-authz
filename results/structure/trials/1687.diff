+// moveMemberAggregate moves one member from the source project to the
+// destination project.
+type moveMemberAggregate struct {
+	src          *Membership // the member's membership in the source project
+	dstProjectID string
+	tasks        []*Task // the member's tasks in the source project; they are unassigned
+}
+
+func loadMoveMember(ctx context.Context, tx DB, srcProjectID, dstProjectID, userID string) (*moveMemberAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, srcProjectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if _, err := NewMembershipTable().Find(ctx, tx, dstProjectID, userID); err == nil {
+		return nil, deny(ErrInvalid, "user is already a member of the destination project")
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	tasks, err := m.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &moveMemberAggregate{src: m, dstProjectID: dstProjectID, tasks: tasks}, nil
+}
+
+func (a *moveMemberAggregate) validate() error { return nil }
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.src.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	moved := &Membership{ProjectID: a.dstProjectID, UserID: a.src.UserID, Role: a.src.Role}
+	if err := moved.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return moved, nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
