+// Move moves a member from the source project to the destination project,
+// keeping the member's role. The member's tasks in the source project are
+// unassigned, since an assignee must belong to the task's project.
+//
+// The actor must be a manager of the source project, and of the destination
+// project, which must be readable by the actor (else ErrNotFound). The source
+// check comes first, so a caller who may not manage the source learns nothing
+// about the destination.
+func (*MembershipTable) Move(ctx context.Context, db DB, src ProjectAuthz, toProjectID, userID string) (*Membership, error) {
+	if src.ProjectID() == toProjectID {
+		return nil, deny(ErrInvalid, "destination must be a different project")
+	}
+	if err := src.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	dst, err := NewProjectAuthz(ctx, db, src.Actor(), toProjectID)
+	if err != nil {
+		return nil, err
+	}
+	if err := dst.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var moved *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveMember(ctx, tx, src.ProjectID(), dst.ProjectID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if moved, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return moved, nil
+}
