diff --git a/org_test.go b/org_test.go
new file mode 100644
index 0000000..6bd1d43
--- /dev/null
+++ b/org_test.go
@@ -0,0 +1,125 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestTransferAccess(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin transfers", "eve", "/orgs/acme/users/cat/transfer", `{"toOrgId":"globex"}`, 200},
+		{"member cannot transfer", "ann", "/orgs/acme/users/cat/transfer", `{"toOrgId":"globex"}`, 403},
+		{"viewer cannot transfer", "dan", "/orgs/acme/users/cat/transfer", `{"toOrgId":"globex"}`, 403},
+		{"other org invisible", "gus", "/orgs/acme/users/cat/transfer", `{"toOrgId":"globex"}`, 404},
+		{"anonymous", "", "/orgs/acme/users/cat/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown actor", "zed", "/orgs/acme/users/cat/transfer", `{"toOrgId":"globex"}`, 401},
+		{"user in other org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"unknown target org", "eve", "/orgs/acme/users/cat/transfer", `{"toOrgId":"initech"}`, 400},
+		{"same org", "eve", "/orgs/acme/users/cat/transfer", `{"toOrgId":"acme"}`, 400},
+		{"missing target", "eve", "/orgs/acme/users/cat/transfer", `{}`, 400},
+		{"malformed body", "eve", "/orgs/acme/users/cat/transfer", `{"toOrgId":`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["id"] != "ben" || got["orgId"] != "globex" {
+		t.Fatalf("got %s", body)
+	}
+}
+
+// After a transfer the user sees only the new organization, and the old
+// organization's project roles and task assignments for them are gone.
+func TestTransferEffects(t *testing.T) {
+	h := newServer()
+
+	if code, body := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: %d %s", code, body)
+	}
+
+	// The moved user can no longer see acme projects.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads web after transfer: got %d want 404", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/legacy/tasks/t5", "ben", ""); code != 404 {
+		t.Fatalf("ben reads legacy after transfer: got %d want 404", code)
+	}
+
+	// Their assignments in acme are cleared; other people's tasks are untouched.
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("ann reads t1: %d %s", code, body)
+	}
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" {
+		t.Fatalf("t1 still assigned to %q", task.Assignee)
+	}
+	code, body = do(t, h, "GET", "/projects/web/tasks/t2", "ann", "")
+	json.Unmarshal([]byte(body), &task)
+	if code != 200 || task.Assignee != "cat" {
+		t.Fatalf("t2 changed: %d %+v", code, task)
+	}
+
+	// Ben is no longer a member, so the old project does not let ben be assigned.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ann", `{"title":"x","assignee":"ben"}`); code != 400 {
+		t.Fatalf("assign moved user: got %d want 400", code)
+	}
+
+	// Transferring again from acme is not possible: the user is no longer there.
+	if code, _ := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"acme"}`); code != 404 {
+		t.Fatalf("second transfer from acme: got %d want 404", code)
+	}
+}
+
+// Org admin status does not follow the user to the new organization.
+func TestTransferDropsOrgAdmin(t *testing.T) {
+	h := newServer()
+
+	if code, body := do(t, h, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: %d %s", code, body)
+	}
+	// eve is now a globex user without admin rights there.
+	if code, _ := do(t, h, "POST", "/orgs/acme/users/cat/transfer", "eve", `{"toOrgId":"globex"}`); code != 404 {
+		t.Fatalf("eve admin acme after move: got %d want 404", code)
+	}
+	if code, _ := do(t, h, "POST", "/orgs/globex/users/gus/transfer", "eve", `{"toOrgId":"acme"}`); code != 403 {
+		t.Fatalf("eve admin globex: got %d want 403", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "eve", ""); code != 404 {
+		t.Fatalf("eve reads acme ops after move: got %d want 404", code)
+	}
+}
+
+// A moved org admin's project roles in the old organization are removed too.
+func TestTransferRemovesMemberships(t *testing.T) {
+	h := newServer()
+
+	if code, body := do(t, h, "POST", "/orgs/acme/users/ivy/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: %d %s", code, body)
+	}
+	// ivy was a manager of web and ops. Those roles are gone, so ann (manager of web)
+	// sees ivy as no longer a member when assigning.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ann", `{"title":"x","assignee":"ivy"}`); code != 400 {
+		t.Fatalf("assign ivy after move: got %d want 400", code)
+	}
+}
