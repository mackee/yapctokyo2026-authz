diff --git a/internal/capability/aggregate.go b/internal/capability/aggregate.go
index af9c3c6..cffff67 100644
--- a/internal/capability/aggregate.go
+++ b/internal/capability/aggregate.go
@@ -108,3 +108,66 @@ func loadDeleteTask(x *tx, taskID string) (*deleteTaskAggregate, error) {
 func (a *deleteTaskAggregate) validate() error { return nil }
 
 func (a *deleteTaskAggregate) save(x *tx) { a.task.destroy(x) }
+
+// transferUserAggregate moves one user from one organization to another.
+// Project roles and task assignments were granted inside the old organization,
+// so the transfer drops them in the same write: the user's memberships in the
+// old organization's projects are removed, and tasks assigned to the user in
+// those projects are unassigned (keeps "assignee is a member" true). Org admin
+// status does not carry over.
+type transferUserAggregate struct {
+	user        userRecord
+	toOrg       orgRecord
+	memberships []membershipRecord
+	tasks       []taskRecord
+}
+
+func loadTransferUser(x *tx, fromOrgID, userID, toOrgID string) (*transferUserAggregate, error) {
+	u, ok := x.findUser(userID)
+	if !ok || u.Org != fromOrgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	to, ok := x.findOrg(toOrgID)
+	if !ok {
+		return nil, deny(ErrInvalid, "target organization does not exist")
+	}
+	a := &transferUserAggregate{user: u, toOrg: to}
+	for pid, members := range x.t.members {
+		if p, ok := x.findProject(pid); !ok || p.Org != fromOrgID {
+			continue
+		}
+		if role, ok := members[userID]; ok {
+			a.memberships = append(a.memberships, membershipRecord{ProjectID: pid, UserID: userID, Role: role})
+		}
+	}
+	for _, t := range x.t.tasks {
+		if t.AssigneeID != userID {
+			continue
+		}
+		if p, ok := x.findProject(t.ProjectID); ok && p.Org == fromOrgID {
+			a.tasks = append(a.tasks, t)
+		}
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if a.toOrg.ID == a.user.Org {
+		return deny(ErrInvalid, "user already belongs to that organization")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) save(x *tx) UserView {
+	for _, m := range a.memberships {
+		m.destroy(x)
+	}
+	for _, t := range a.tasks {
+		t.AssigneeID = ""
+		t.save(x)
+	}
+	a.user.Org = a.toOrg.ID
+	a.user.OrgAdmin = false
+	a.user.save(x)
+	return UserView{ID: a.user.ID, OrgID: a.user.Org}
+}
