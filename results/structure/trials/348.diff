 }
+func (s *actorScope) Org(orgID string) OrgScope {
+	return &orgScope{as: s, oid: orgID}
+}
+
+type orgScope struct {
+	as  *actorScope
+	oid string
+}
+
+// Admin applies the org admin rule: the organization is the actor's own (else
+// 404, as other organizations are invisible), and the actor is its org admin
+// (else 403).
+func (s *orgScope) Admin() (AdminOrg, error) {
+	if s.as.actor.org != s.oid {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if !s.as.actor.orgAdmin {
+		return nil, deny(ErrForbidden, "forbidden")
+	}
+	return &adminOrg{os: s}, nil
+}
+
+// AdminOrg may move users out of one organization. Only org admins get it.
+type AdminOrg interface {
+	// Transfer moves a user of this organization to toOrgID. The user's project
+	// roles and task assignments in this organization are dropped. Unknown users
+	// are 404; an unknown or same target is 400.
+	Transfer(userID, toOrgID string) (UserView, error)
+}
+
+type adminOrg struct{ os *orgScope }
+
+func (o *adminOrg) Transfer(userID, toOrgID string) (UserView, error) {
+	var v UserView
+	err := o.os.as.a.db.update(func(x *tx) error {
+		agg, err := loadTransferUser(x, o.os.oid, userID, toOrgID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		v = agg.save(x)
+		return nil
+	})
+	return v, err
+}
 
