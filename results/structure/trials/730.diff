+// moveTaskAggregate moves one task to another project. The task keeps its ID,
+// title, status and assignee, so the assignee must already be a contributor or
+// manager of the destination project.
+type moveTaskAggregate struct {
+	task     *Task
+	dest     *Project
+	assignee *Membership // the assignee's membership in dest; nil means unassigned
+}
+
+func loadMoveTask(ctx context.Context, tx DB, taskID, destProjectID string) (*moveTaskAggregate, error) {
+	t, err := NewTaskTable().Find(ctx, tx, taskID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	dest, err := NewProjectTable().Find(ctx, tx, destProjectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "task must belong to an existing project")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveTaskAggregate{task: t, dest: dest}
+	if t.AssigneeID != "" {
+		m, err := dest.Membership(ctx, tx, t.AssigneeID)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "assignee must be a contributor or manager of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		a.assignee = m
+	}
+	return a, nil
+}
+
+func (a *moveTaskAggregate) validate() error {
+	if a.assignee != nil && !isWriterRole(a.assignee.Role) {
+		return deny(ErrInvalid, "assignee must be a contributor or manager of the project")
+	}
+	return nil
+}
+
+func (a *moveTaskAggregate) apply(ctx context.Context, tx DB) (*Task, error) {
+	if err := a.task.moveTo(ctx, tx, a.dest.ID); err != nil {
+		return nil, err
+	}
+	return a.task, nil
+}
+
