+// CanMove returns nil if the actor may move the task to the destination project
+// (dest, built by NewProjectAuthz for the destination). The actor must be able
+// to edit the task in its project (CanEdit). The destination must be writable
+// by the actor (contributor or manager, else ErrForbidden) and not archived
+// (else ErrArchived). A manager in both projects may move any task; otherwise
+// the task must be assigned to the actor.
+func (a TaskAuthz) CanMove(dest ProjectAuthz) error {
+	if err := a.CanEdit(); err != nil {
+		return err
+	}
+	if !isWriterRole(dest.role) {
+		return deny(ErrForbidden, "forbidden")
+	}
+	if dest.archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	bothManagers := a.project.role == RoleManager && dest.role == RoleManager
+	if !bothManagers && !a.isAssignee {
+		return deny(ErrForbidden, "only managers in both projects may move tasks assigned to others")
+	}
+	return nil
+}
