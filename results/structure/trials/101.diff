+	err := t.ts.ps.as.a.st.tx(func(s *state) error {
+		cur := s.tasks[t.ts.tid]
+		if toProjectID == cur.project {
+			return deny(ErrInvalid, "task is already in that project")
+		}
+		dest, role, err := readable(s, t.ts.ps.as.actor, toProjectID)
+		if err != nil {
+			return err
+		}
+		if !isWriterRole(role) {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if dest.archived {
+			return deny(ErrArchived, "project is archived")
+		}
+		// Re-admit the current assignee for the destination; this fails (400)
+		// if they are not a contributor or manager there.
+		a, err := admit(s, toProjectID, cur.assignee.user)
+		if err != nil {
+			return err
+		}
+		cur.project = toProjectID
+		cur.assignee = a
+		s.tasks[cur.id] = cur
+		v = cur.view()
+		return nil
+	})
+	return v, err
