+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager of both", "ivy", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 200},
+		{"manager of source, viewer of dest", "ann", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"contributor cannot move", "ben", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"viewer cannot move", "dan", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"non member of source", "hal", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 404},
+		{"other org source", "gus", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 404},
+		{"cross project task id", "ivy", "/projects/web/tasks/t4", `{"toProjectId":"legacy"}`, 404},
+		{"archived source", "ann", "/projects/legacy/tasks/t5", `{"toProjectId":"web"}`, 409},
+		{"archived destination", "ann", "/projects/web/tasks/t1", `{"toProjectId":"legacy"}`, 409},
+		{"destination not visible", "ivy", "/projects/web/tasks/t2", `{"toProjectId":"gx"}`, 404},
+		{"destination missing", "ivy", "/projects/web/tasks/t2", `{"toProjectId":"nope"}`, 404},
+		{"same project", "ivy", "/projects/web/tasks/t2", `{"toProjectId":"web"}`, 400},
+		{"missing toProjectId", "ivy", "/projects/web/tasks/t2", `{}`, 400},
+		{"empty toProjectId", "ivy", "/projects/web/tasks/t2", `{"toProjectId":""}`, 400},
+		{"bad body", "ivy", "/projects/web/tasks/t2", `not json`, 400},
+		{"assignee not in destination", "ivy", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsFields(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d body %s", code, body)
+	}
+	var got Task
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", Assignee: "cat"}
+	if got != want {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+
+	// The task is now listed under ops and no longer under web.
+	code, body = do(t, h, "GET", "/projects/ops/tasks/t2", "ivy", "")
+	if code != 200 || !strings.Contains(body, `"projectId":"ops"`) {
+		t.Fatalf("get in ops: %d %s", code, body)
+	}
+	code, _ = do(t, h, "GET", "/projects/web/tasks/t2", "ivy", "")
+	if code != 404 {
+		t.Fatalf("old project still has task: %d", code)
+	}
+}
+
+func TestMoveUnassignedAndFailureLeavesTask(t *testing.T) {
+	h := newServer()
+
+	// An unassigned task moves with no assignee.
+	code, body := do(t, h, "POST", "/projects/web/tasks/t3/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move unassigned: got %d body %s", code, body)
+	}
+	if !strings.Contains(body, `"assignee":""`) {
+		t.Fatalf("assignee should stay empty: %s", body)
+	}
+
+	// A rejected move (assignee ben is not in ops) changes nothing.
+	code, _ = do(t, h, "POST", "/projects/web/tasks/t1/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	code, body = do(t, h, "GET", "/projects/web/tasks/t1", "ivy", "")
+	if code != 200 || !strings.Contains(body, `"projectId":"web"`) || !strings.Contains(body, `"assignee":"ben"`) {
+		t.Fatalf("t1 changed after failed move: %d %s", code, body)
+	}
+}
