+// transferUserAggregate moves one user to another organization.
+type transferUserAggregate struct {
+	user        *User
+	toOrg       string
+	memberships []*Membership // the user's project memberships; must be empty
+}
+
+func loadTransferUser(ctx context.Context, tx DB, orgID, userID string, in UserTableTransferInput) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != orgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if in.ToOrgID == orgID {
+		return nil, deny(ErrInvalid, "user already belongs to that organization")
+	}
+	if _, err := NewOrgTable().Find(ctx, tx, in.ToOrgID); errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "unknown organization")
+	} else if err != nil {
+		return nil, err
+	}
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &transferUserAggregate{user: u, toOrg: in.ToOrgID, memberships: ms}, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if len(a.memberships) > 0 {
+		return deny(ErrConflict, "user still has project memberships; remove them before transferring")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	if err := a.user.transferTo(ctx, tx, a.toOrg); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
