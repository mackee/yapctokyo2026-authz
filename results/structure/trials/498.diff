+func TestRemoveUserFromOrg(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes user with no memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"org admin removes manager", "eve", "/orgs/acme/users/ivy", 204},
+		{"org admin, user in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"org admin, unknown user", "eve", "/orgs/acme/users/zed", 404},
+		{"org admin, other org", "eve", "/orgs/globex/users/gus", 404},
+		{"manager of org projects", "ann", "/orgs/acme/users/ben", 403},
+		{"contributor", "ben", "/orgs/acme/users/cat", 403},
+		{"viewer", "dan", "/orgs/acme/users/ben", 403},
+		{"same org, no roles", "hal", "/orgs/acme/users/ben", 403},
+		{"caller from other org", "gus", "/orgs/acme/users/ben", 404},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func taskAssignee(t *testing.T, h http.Handler, user, path string) string {
+	t.Helper()
+	code, body := do(t, h, "GET", path, user, "")
+	if code != 200 {
+		t.Fatalf("GET %s as %s: got %d", path, user, code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	return task.AssigneeID
+}
+
+func TestRemoveUserFromOrgEffects(t *testing.T) {
+	srv := newServer()
+
+	// ben is a contributor in web (assigned t1) and legacy (archived, assigned t5).
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove ben: got %d want 204", code)
+	}
+
+	// ben is no longer a member of any project of the org.
+	for _, p := range []string{"/projects/web/tasks", "/projects/ops/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, srv, "GET", p, "ben", ""); code != 404 {
+			t.Fatalf("GET %s as ben: got %d want 404", p, code)
+		}
+	}
+
+	// ben's assigned tasks are unassigned, in web and in the archived legacy project.
+	if got := taskAssignee(t, srv, "ann", "/projects/web/tasks/t1"); got != "" {
+		t.Fatalf("t1 assignee: got %q want unassigned", got)
+	}
+	if got := taskAssignee(t, srv, "ann", "/projects/legacy/tasks/t5"); got != "" {
+		t.Fatalf("t5 assignee: got %q want unassigned", got)
+	}
+
+	// Other members and their tasks are untouched.
+	if got := taskAssignee(t, srv, "ann", "/projects/web/tasks/t2"); got != "cat" {
+		t.Fatalf("t2 assignee: got %q want cat", got)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("GET web as cat: got %d want 200", code)
+	}
+
+	// Repeating the removal succeeds and changes nothing.
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove ben again: got %d want 204", code)
+	}
+	if got := taskAssignee(t, srv, "ann", "/projects/web/tasks/t2"); got != "cat" {
+		t.Fatalf("t2 assignee after repeat: got %q want cat", got)
+	}
+}
+
