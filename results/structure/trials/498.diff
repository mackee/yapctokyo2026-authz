+
+// ---- operations -----------------------------------------------------------------------
+
+// RemoveFromOrg removes the user from every project of the organization (the
+// archived ones included): their memberships there are deleted and the tasks
+// they were assigned in those projects are unassigned, all in one transaction.
+// The user must belong to the organization (else ErrNotFound). Removing a user
+// who has no memberships there succeeds and changes nothing. The users row,
+// including the org admin flag, is not changed.
+func (*UserTable) RemoveFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanManageMembers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveUserFromOrg(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
