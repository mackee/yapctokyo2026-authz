+// updateMemberAggregate changes the role of one member of one project.
+type updateMemberAggregate struct {
+	member   *Membership
+	role     string
+	assigned []*Task // the member's tasks in the project; loaded only when the new role is not a writer role
+}
+
+func loadUpdateMember(ctx context.Context, tx DB, projectID, userID, role string) (*updateMemberAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &updateMemberAggregate{member: m, role: role}
+	if !isWriterRole(role) {
+		a.assigned, err = m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+	}
+	return a, nil
+}
+
+func (a *updateMemberAggregate) validate() error {
+	if !isWriterRole(a.role) && len(a.assigned) > 0 {
+		return deny(ErrInvalid, "member has tasks assigned in the project; unassign them before changing the role to viewer")
+	}
+	return nil
+}
+
+func (a *updateMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.member.setRole(ctx, tx, a.role); err != nil {
+		return nil, err
+	}
+	return a.member, nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
