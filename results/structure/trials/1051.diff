@@ -2,12 +2,52 @@ package model
 
 import "context"
 
-// MembershipTable reads the memberships table.
+// MembershipTable is the memberships table.
+//
+// Find and List* read rows. UpdateRole is the API operation: it takes the
+// database, the project's authorization object and an input, asks the
+// authorization object whether the actor may change roles, then runs its
+// aggregate (aggregate.go) in a transaction.
 type MembershipTable struct{}
 
 // NewMembershipTable returns the memberships table.
 func NewMembershipTable() *MembershipTable { return &MembershipTable{} }
 
+var validRoles = map[string]bool{RoleManager: true, RoleContributor: true, RoleViewer: true}
+
+// MembershipTableUpdateRoleInput is the input of MembershipTable.UpdateRole.
+type MembershipTableUpdateRoleInput struct {
+	Role string
+}
+
+// UpdateRole changes the role of the user in the project, all or nothing.
+// Returns ErrNotFound when the user is not a member of the project.
+func (mt *MembershipTable) UpdateRole(ctx context.Context, db DB, authz ProjectAuthz, userID string, in MembershipTableUpdateRoleInput) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if !validRoles[in.Role] {
+		return nil, deny(ErrInvalid, "invalid role")
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadUpdateMember(ctx, tx, authz.ProjectID(), userID, in.Role)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if m, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
+
 // Find returns the membership of the user in the project, or ErrNoRows.
