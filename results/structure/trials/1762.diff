+func changeRoles(ctx tanukirpc.Context[*projectRegistry], req changeRolesRequest) ([]memberJSON, error) {
+	reg := ctx.Registry()
+	members, err := model.NewMembershipTable().ChangeRoles(ctx, reg.db, reg.authz, req.Roles)
+	if err != nil {
+		return nil, err
+	}
+	out := make([]memberJSON, 0, len(members))
+	for _, m := range members {
+		out = append(out, memberJSON{UserID: m.UserID, Role: m.Role})
+	}
+	return out, nil
+}
