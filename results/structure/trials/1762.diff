+// changeRolesAggregate changes the roles of several members of one project.
+type changeRolesAggregate struct {
+	project *Project
+	members []*Membership     // project.Membership(user) for every user in roles, ordered by user ID
+	roles   map[string]string // user ID -> new role
+	// assigned[userID] is true when the member has tasks assigned in the project.
+	assigned map[string]bool
+}
+
+func loadChangeRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*changeRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &changeRolesAggregate{project: p, roles: roles, assigned: map[string]bool{}}
+	all, err := p.Memberships(ctx, tx) // ordered by user ID
+	if err != nil {
+		return nil, err
+	}
+	for _, m := range all {
+		if _, ok := roles[m.UserID]; ok {
+			a.members = append(a.members, m)
+		}
+	}
+	if len(a.members) != len(roles) {
+		return nil, deny(ErrInvalid, "every user must be a member of the project")
+	}
+	for _, m := range a.members {
+		tasks, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.assigned[m.UserID] = len(tasks) > 0
+	}
+	return a, nil
+}
+
+func (a *changeRolesAggregate) validate() error {
+	for _, m := range a.members {
+		role := a.roles[m.UserID]
+		if !validRoles[role] {
+			return deny(ErrInvalid, "role must be manager, contributor or viewer")
+		}
+		if !isWriterRole(role) && a.assigned[m.UserID] {
+			return deny(ErrInvalid, "a member with assigned tasks must stay a contributor or manager")
+		}
+	}
+	return nil
+}
+
+func (a *changeRolesAggregate) apply(ctx context.Context, tx DB) error {
+	for _, m := range a.members {
+		if err := m.setRole(ctx, tx, a.roles[m.UserID]); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
