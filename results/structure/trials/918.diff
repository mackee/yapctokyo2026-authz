+func TestUpdateMembers(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager demotes and promotes", "ann", "web", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 200},
+		{"other manager", "ivy", "web", `{"roles":{"cat":"manager"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"cat":"viewer"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"cat":"viewer"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"cat":"viewer"}}`, 401},
+		{"unknown user", "zed", "web", `{"roles":{"cat":"viewer"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"bad role", "ann", "web", `{"roles":{"cat":"owner"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"bad json", "ann", "web", `{"roles":`, 400},
+		{"target not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"target org admin without membership", "ann", "web", `{"roles":{"eve":"manager"}}`, 400},
+		{"target in another org", "ann", "web", `{"roles":{"gus":"viewer"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMembersResponseAndEffect(t *testing.T) {
+	server := newServer()
+	code, body := do(t, server, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []map[string]string{
+		{"userId": "ann", "role": "manager"},
+		{"userId": "ben", "role": "viewer"},
+		{"userId": "cat", "role": "contributor"},
+		{"userId": "dan", "role": "contributor"},
+		{"userId": "ivy", "role": "manager"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %d members, want %d: %s", len(got), len(want), body)
+	}
+	for i := range want {
+		if len(got[i]) != 2 || got[i]["userId"] != want[i]["userId"] || got[i]["role"] != want[i]["role"] {
+			t.Fatalf("member %d: got %v want %v", i, got[i], want[i])
+		}
+	}
+
+	// The change is persisted: ben is now a viewer and cannot create tasks,
+	// dan is now a contributor and can.
+	if code, _ := do(t, server, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Fatalf("demoted ben: got %d want 403", code)
+	}
+	if code, _ := do(t, server, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("promoted dan: got %d want 200", code)
+	}
+}
+
+func TestUpdateMembersAllOrNothing(t *testing.T) {
+	server := newServer()
+	// cat is a valid member, hal is not: the whole request is rejected.
+	if code, _ := do(t, server, "PUT", "/projects/web/members", "ann", `{"roles":{"cat":"viewer","hal":"viewer"}}`); code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	// An invalid role for one member also rejects the whole request.
+	if code, _ := do(t, server, "PUT", "/projects/web/members", "ann", `{"roles":{"cat":"viewer","ben":"owner"}}`); code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	// Nothing changed: cat is still a contributor and can still create tasks.
+	code, body := do(t, server, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"viewer"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	if !strings.Contains(body, `{"userId":"cat","role":"contributor"}`) || !strings.Contains(body, `{"userId":"ben","role":"contributor"}`) {
+		t.Fatalf("earlier failed requests changed roles: %s", body)
+	}
+}
