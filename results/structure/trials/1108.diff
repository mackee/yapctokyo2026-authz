+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestFreeze(t *testing.T) {
+	h := newServer()
+
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("freeze: got %d (%s)", code, body)
+	}
+	var got []struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []string{"ann", "ben", "cat", "dan", "ivy"}
+	if len(got) != len(want) {
+		t.Fatalf("members: got %d want %d (%s)", len(got), len(want), body)
+	}
+	for i, m := range got {
+		if m.UserID != want[i] || m.Role != "viewer" {
+			t.Fatalf("member %d: %+v", i, m)
+		}
+	}
+
+	// Nobody can change tasks any more (manager included), but reads still work.
+	writes := []struct{ method, path, user, body string }{
+		{"POST", "/projects/web/tasks", "ann", `{"title":"x"}`},
+		{"PATCH", "/projects/web/tasks/t1", "ann", `{"status":"done"}`},
+		{"PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`},
+		{"DELETE", "/projects/web/tasks/t1", "ivy", ""},
+	}
+	for _, w := range writes {
+		if code, body := do(t, h, w.method, w.path, w.user, w.body); code != 403 {
+			t.Errorf("%s %s as %s: got %d (%s) want 403", w.method, w.path, w.user, code, body)
+		}
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ann", ""); code != 200 {
+		t.Errorf("read after freeze: got %d", code)
+	}
+	// Other projects are untouched.
+	if code, _ := do(t, h, "POST", "/projects/ops/tasks", "ivy", `{"title":"x"}`); code != 201 && code != 200 {
+		t.Errorf("other project write: got %d", code)
+	}
+}
+
+func TestFreezeDenied(t *testing.T) {
+	cases := []struct {
+		name, path, user string
+		want             int
+	}{
+		{"contributor", "/projects/web/freeze", "ben", 403},
+		{"viewer", "/projects/web/freeze", "dan", 403},
+		{"org admin", "/projects/web/freeze", "eve", 403},
+		{"non member", "/projects/web/freeze", "hal", 404},
+		{"anonymous", "/projects/web/freeze", "", 401},
+		{"archived", "/projects/legacy/freeze", "ann", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			if code, _ := do(t, h, "POST", c.path, c.user, ""); code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+			// A denied freeze changes nothing.
+			if code, _ := do(t, h, "POST", "/projects/web/tasks", "ann", `{"title":"x"}`); c.path == "/projects/web/freeze" && code == 403 {
+				t.Fatalf("denied freeze froze the project")
+			}
+		})
+	}
+}
