+func TestFreezeStatus(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"second manager", "ivy", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+		{"missing project", "ann", "nope", 404},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeReturnsViewers(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got []map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("bad body %q: %v", body, err)
+	}
+	want := []map[string]string{
+		{"userId": "ann", "role": "viewer"},
+		{"userId": "ben", "role": "viewer"},
+		{"userId": "cat", "role": "viewer"},
+		{"userId": "dan", "role": "viewer"},
+		{"userId": "ivy", "role": "viewer"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	for i := range want {
+		if got[i]["userId"] != want[i]["userId"] || got[i]["role"] != want[i]["role"] {
+			t.Fatalf("got %v want %v", got, want)
+		}
+	}
+}
+
+func TestFreezeOnlyAffectsItsProject(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d", code)
+	}
+	// ops was not frozen: its contributor can still update their own task.
+	if code, _ := do(t, h, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ops update after web freeze: got %d want 200", code)
+	}
+	// ivy is a manager of ops, so the web freeze must not touch that role.
+	if code, _ := do(t, h, "PATCH", "/projects/ops/tasks/t4", "ivy", `{"status":"open"}`); code != 200 {
+		t.Fatalf("ops manager after web freeze: got %d want 200", code)
+	}
+}
+
+func TestFrozenProjectRejectsTaskWrites(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d", code)
+	}
+	cases := []struct {
+		name, method, path, user, body string
+		want                           int
+	}{
+		{"create by former manager", "POST", "/projects/web/tasks", "ann", `{"title":"x"}`, 403},
+		{"create by former contributor", "POST", "/projects/web/tasks", "ben", `{"title":"x"}`, 403},
+		{"update own task", "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`, 403},
+		{"update any task by former manager", "PATCH", "/projects/web/tasks/t2", "ivy", `{"status":"done"}`, 403},
+		{"reassign by former manager", "PATCH", "/projects/web/tasks/t2", "ann", `{"assignee":"ben"}`, 403},
+		{"delete by former manager", "DELETE", "/projects/web/tasks/t3", "ann", "", 403},
+		{"refreeze by former manager", "POST", "/projects/web/freeze", "ann", "", 403},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, h, c.method, c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+	// Frozen projects stay readable.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "dan", ""); code != 200 {
+		t.Fatalf("read after freeze: got %d want 200", code)
+	}
+	// The tasks themselves are unchanged.
+	_, body := do(t, h, "GET", "/projects/web/tasks/t2", "dan", "")
+	if !strings.Contains(body, `"status":"doing"`) {
+		t.Fatalf("t2 changed after freeze: %s", body)
+	}
+}
