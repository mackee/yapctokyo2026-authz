+// UserTableTransferInput is the input of UserTable.Transfer.
+type UserTableTransferInput struct {
+	UserID  string
+	ToOrgID string
+}
+
+// Transfer moves a user of the authorization's organization to another
+// organization, all or nothing. The user's memberships in projects outside the
+// new organization are removed, and tasks assigned to the user in those
+// projects are unassigned. The user loses org admin rights.
+func (*UserTable) Transfer(ctx context.Context, db DB, authz OrgAuthz, in UserTableTransferInput) (*User, error) {
+	if err := authz.CanTransfer(); err != nil {
+		return nil, err
+	}
+	if in.ToOrgID == "" {
+		return nil, deny(ErrInvalid, "toOrgId must not be empty")
+	}
+	if in.ToOrgID == authz.OrgID() {
+		return nil, deny(ErrInvalid, "user is already in that organization")
+	}
+	var u *User
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadTransferUser(ctx, tx, authz.OrgID(), in)
+		if err != nil {
+			return err
+		}
+		if u, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return u, nil
+}
