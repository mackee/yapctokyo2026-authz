 func (a *deleteTaskAggregate) apply(ctx context.Context, tx DB) error { return a.task.destroy(ctx, tx) }
+
+// transferUserAggregate moves one user to another organization. Project members
+// belong to the project's organization, so the user's memberships in projects
+// outside the new organization go, and so do their assignments there.
+type transferUserAggregate struct {
+	user     *User
+	toOrg    string
+	leave    []*Membership // memberships in projects outside the new organization
+	unassign []*Task       // tasks assigned to the user in projects outside the new organization
+}
+
+func loadTransferUser(ctx context.Context, tx DB, fromOrg string, in UserTableTransferInput) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, in.UserID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != fromOrg {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	a := &transferUserAggregate{user: u, toOrg: in.ToOrgID}
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, m := range ms {
+		stays, err := a.projectInNewOrg(ctx, tx, m.ProjectID)
+		if err != nil {
+			return nil, err
+		}
+		if !stays {
+			a.leave = append(a.leave, m)
+		}
+	}
+	tasks, err := u.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, t := range tasks {
+		stays, err := a.projectInNewOrg(ctx, tx, t.ProjectID)
+		if err != nil {
+			return nil, err
+		}
+		if !stays {
+			a.unassign = append(a.unassign, t)
+		}
+	}
+	return a, nil
+}
+
+// projectInNewOrg reports whether the project belongs to the organization the
+// user is moving to. A project that does not exist does not.
+func (a *transferUserAggregate) projectInNewOrg(ctx context.Context, tx DB, projectID string) (bool, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return false, nil
+	} else if err != nil {
+		return false, err
+	}
+	return p.Org == a.toOrg, nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	for _, t := range a.unassign {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	for _, m := range a.leave {
+		if err := m.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	// Org admin rights belong to the organization being left.
+	a.user.Org = a.toOrg
+	a.user.OrgAdmin = false
+	if err := a.user.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
