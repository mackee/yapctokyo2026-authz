diff --git a/transfer_test.go b/transfer_test.go
new file mode 100644
index 0000000..715aa36
--- /dev/null
+++ b/transfer_test.go
@@ -0,0 +1,126 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"testing"
+)
+
+// dbInt runs a query that returns one integer, against the database behind h.
+func dbInt(t *testing.T, h http.Handler, query string, args ...any) int {
+	t.Helper()
+	app, ok := h.(*appHandler)
+	if !ok {
+		t.Fatalf("dbInt: %T is not the handler built by newServer", h)
+	}
+	var n int
+	if err := app.db.QueryRow(query, args...).Scan(&n); err != nil {
+		t.Fatalf("dbInt: %v", err)
+	}
+	return n
+}
+
+// POST /orgs/{orgID}/users/{uid}/transfer moves a user to another organization.
+// Only an org admin of the user's current organization may do it.
+func TestTransferAccess(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin moves a user", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 200},
+		{"project manager cannot transfer", "ann", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 403},
+		{"contributor cannot transfer", "ben", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 403},
+		{"anonymous", "", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown caller", "zed", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 401},
+		{"admin of another org", "gus", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 404},
+		{"user is in another org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"initech"}`, 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"same organization", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"acme"}`, 400},
+		{"missing toOrgId", "eve", "/orgs/acme/users/hal/transfer", `{}`, 400},
+		{"malformed body", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+// The response is {"id","orgId"} with the user's new organization.
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/hal/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("response is not JSON: %v: %s", err, body)
+	}
+	if len(got) != 2 || got["id"] != "hal" || got["orgId"] != "globex" {
+		t.Fatalf("got %s, want {\"id\":\"hal\",\"orgId\":\"globex\"}", body)
+	}
+}
+
+// After the transfer the user belongs to the new organization: the old
+// organization no longer sees them, and their reads of the old organization's
+// projects are refused.
+func TestTransferMovesUser(t *testing.T) {
+	srv := newServer()
+	if n := dbInt(t, srv, `SELECT COUNT(*) FROM users WHERE id = 'ben' AND org_id = 'acme'`); n != 1 {
+		t.Fatalf("ben should start in acme")
+	}
+	if code, body := do(t, srv, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: got %d: %s", code, body)
+	}
+	if n := dbInt(t, srv, `SELECT COUNT(*) FROM users WHERE id = 'ben' AND org_id = 'globex'`); n != 1 {
+		t.Fatalf("ben should now be in globex")
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads acme project after transfer: got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"initech"}`); code != 404 {
+		t.Fatalf("old org admin transfers a user who left: got %d want 404", code)
+	}
+}
+
+// Memberships in the old organization's projects go with the user, and tasks
+// assigned to the user there are unassigned, so the model rules still hold.
+func TestTransferLeavesOldOrgProjects(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: got %d: %s", code, body)
+	}
+	if n := dbInt(t, srv, `SELECT COUNT(*) FROM memberships WHERE user_id = 'ben'`); n != 0 {
+		t.Fatalf("ben still has %d memberships in acme projects", n)
+	}
+	for _, path := range []string{"/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		code, body := do(t, srv, "GET", path, "ann", "")
+		if code != 200 {
+			t.Fatalf("GET %s: got %d: %s", path, code, body)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.AssigneeID != "" {
+			t.Fatalf("%s is still assigned to %q", path, task.AssigneeID)
+		}
+	}
+}
+
+// Org admin rights belong to the organization being left, so they are cleared.
+func TestTransferClearsOrgAdmin(t *testing.T) {
+	srv := newServer()
+	if n := dbInt(t, srv, `SELECT org_admin FROM users WHERE id = 'eve'`); n != 1 {
+		t.Fatalf("eve should start as an org admin")
+	}
+	if code, body := do(t, srv, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: got %d: %s", code, body)
+	}
+	if n := dbInt(t, srv, `SELECT org_admin FROM users WHERE id = 'eve'`); n != 0 {
+		t.Fatalf("eve is still an org admin after moving to globex")
+	}
+}
