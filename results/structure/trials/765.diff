diff --git a/move_test.go b/move_test.go
new file mode 100644
index 0000000..80e8c85
--- /dev/null
+++ b/move_test.go
@@ -0,0 +1,67 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+// TestMoveDenied lists moves that must be refused, with the status each one
+// gets. Each row runs on a fresh server.
+func TestMoveDenied(t *testing.T) {
+	cases := []struct {
+		name, user, project, uid, body string
+		want                           int
+	}{
+		{"contributor in source", "ben", "web", "cat", `{"toProjectId":"ops"}`, 403},
+		{"viewer in source", "dan", "web", "ben", `{"toProjectId":"ops"}`, 403},
+		{"org admin without role", "eve", "web", "cat", `{"toProjectId":"ops"}`, 403},
+		{"non member of source", "hal", "web", "cat", `{"toProjectId":"ops"}`, 404},
+		{"other org", "gus", "web", "dan", `{"toProjectId":"ops"}`, 404},
+		{"manager of source, viewer of target", "ann", "web", "dan", `{"toProjectId":"ops"}`, 403},
+		{"target in other org", "ivy", "web", "dan", `{"toProjectId":"gx"}`, 404},
+		{"target missing", "ivy", "web", "dan", `{"toProjectId":"nope"}`, 404},
+		{"archived source", "ann", "legacy", "ben", `{"toProjectId":"web"}`, 409},
+		{"archived target", "ann", "web", "dan", `{"toProjectId":"legacy"}`, 409},
+		{"user not in source", "ivy", "web", "hal", `{"toProjectId":"ops"}`, 404},
+		{"user has tasks in source", "ivy", "web", "ben", `{"toProjectId":"ops"}`, 400},
+		{"user already in target", "ivy", "web", "ivy", `{"toProjectId":"ops"}`, 400},
+		{"same project", "ivy", "web", "dan", `{"toProjectId":"web"}`, 400},
+		{"missing toProjectId", "ivy", "web", "dan", `{}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", "/projects/"+c.project+"/members/"+c.uid+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+// TestMoveKeepsRole checks the response shape, that the role is kept, and that
+// the member leaves the source project and joins the target. dan is a viewer
+// in web and has no tasks there.
+func TestMoveKeepsRole(t *testing.T) {
+	srv := newServer()
+	code, body := do(t, srv, "POST", "/projects/web/members/dan/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d body=%s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]string{"userId": "dan", "projectId": "ops", "role": "viewer"}
+	for k, v := range want {
+		if got[k] != v {
+			t.Fatalf("response %s=%q, want %q (body=%s)", k, got[k], v, body)
+		}
+	}
+
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "dan", ""); code != 404 {
+		t.Fatalf("dan still reads web: got %d", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "dan", ""); code != 200 {
+		t.Fatalf("dan cannot read ops: got %d", code)
+	}
+}
