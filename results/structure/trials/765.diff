+// moveMemberAggregate moves one member from the source project to the target
+// project, keeping the role.
+type moveMemberAggregate struct {
+	from          *Membership // the member in the source project
+	user          *User
+	to            *Project // the target project
+	alreadyMember bool     // the user is already a member of the target project
+	assigned      []*Task  // the user's tasks in the source project
+}
+
+func loadMoveMember(ctx context.Context, tx DB, fromProjectID string, in MembershipTableMoveInput) (*moveMemberAggregate, error) {
+	from, err := NewMembershipTable().Find(ctx, tx, fromProjectID, in.UserID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	user, err := from.User(ctx, tx)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	to, err := NewProjectTable().Find(ctx, tx, in.ToProjectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveMemberAggregate{from: from, user: user, to: to}
+	if _, err := to.Membership(ctx, tx, user.ID); err == nil {
+		a.alreadyMember = true
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	if a.assigned, err = from.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.user.Org != a.to.Org {
+		return deny(ErrInvalid, "project members must belong to the project's organization")
+	}
+	if a.alreadyMember {
+		return deny(ErrInvalid, "user is already a member of the target project")
+	}
+	if len(a.assigned) > 0 {
+		return deny(ErrInvalid, "user has tasks assigned in the project; reassign them first")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	m := &Membership{ProjectID: a.to.ID, UserID: a.user.ID, Role: a.from.Role}
+	if err := m.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	if err := a.from.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
