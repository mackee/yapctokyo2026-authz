+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager of both moves", "ivy", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 200},
+		{"contributor forbidden", "cat", "/projects/web/tasks/t2/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer forbidden", "dan", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin forbidden", "eve", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"non member", "hal", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 404},
+		{"other org", "gus", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 401},
+		{"unknown source project", "ivy", "/projects/nope/tasks/t1/move", `{"toProjectId":"ops"}`, 404},
+		{"task in other project", "ivy", "/projects/web/tasks/t4/move", `{"toProjectId":"ops"}`, 404},
+		{"archived source", "ann", "/projects/legacy/tasks/t5/move", `{"toProjectId":"ops"}`, 409},
+		{"archived destination", "ann", "/projects/web/tasks/t1/move", `{"toProjectId":"legacy"}`, 409},
+		{"destination viewer forbidden", "ann", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"destination not readable", "ivy", "/projects/web/tasks/t1/move", `{"toProjectId":"legacy"}`, 404},
+		{"destination missing", "ivy", "/projects/web/tasks/t1/move", `{"toProjectId":"nope"}`, 404},
+		{"destination other org", "ivy", "/projects/web/tasks/t1/move", `{"toProjectId":"gx"}`, 404},
+		{"same project", "ivy", "/projects/web/tasks/t1/move", `{"toProjectId":"web"}`, 400},
+		{"missing destination field", "ivy", "/projects/web/tasks/t1/move", `{}`, 400},
+		{"invalid body", "ivy", "/projects/web/tasks/t1/move", `not json`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsTaskFieldsAndChangesProject(t *testing.T) {
+	srv := newServer()
+	code, body := do(t, srv, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d want 200 (body %s)", code, body)
+	}
+	var moved Task
+	if err := json.Unmarshal([]byte(body), &moved); err != nil {
+		t.Fatalf("move response is not a task: %v", err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", Assignee: "cat"}
+	if moved != want {
+		t.Fatalf("moved task = %+v, want %+v", moved, want)
+	}
+
+	// The task is now readable under the destination project...
+	code, _ = do(t, srv, "GET", "/projects/ops/tasks/t2", "ivy", "")
+	if code != 200 {
+		t.Fatalf("get in destination: got %d want 200", code)
+	}
+	// ...and no longer under the source project.
+	code, _ = do(t, srv, "GET", "/projects/web/tasks/t2", "ivy", "")
+	if code != 404 {
+		t.Fatalf("get in source: got %d want 404", code)
+	}
+	_, listBody := do(t, srv, "GET", "/projects/web/tasks", "ann", "")
+	if strings.Contains(listBody, `"id":"t2"`) {
+		t.Fatalf("task t2 still listed in source project: %s", listBody)
+	}
+}
