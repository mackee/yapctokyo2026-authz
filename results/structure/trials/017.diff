+type handoverRequest struct {
+	To string `json:"to"`
+}
+
+// handover moves all tasks of project member {uid} in {pid} to user "to".
+func (s *server) handover(w http.ResponseWriter, r *http.Request) {
+	s.store.mu.Lock()
+	defer s.store.mu.Unlock()
+
+	user := s.store.User(r.Header.Get("X-User"))
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project := s.store.Project(r.PathValue("pid"))
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role := s.store.Role(project.ID, user.ID)
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "only managers may hand over tasks")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req handoverRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	from := r.PathValue("uid")
+	if req.To == "" {
+		writeError(w, 400, "to is required")
+		return
+	}
+	if req.To == from {
+		writeError(w, 400, "to must be a different user")
+		return
+	}
+	toRole := s.store.Role(project.ID, req.To)
+	if toRole != RoleManager && toRole != RoleContributor {
+		writeError(w, 400, "to must be a contributor or manager of the project")
+		return
+	}
+	moved := s.store.ReassignTasks(project.ID, from, req.To)
+	if moved == nil {
+		moved = []*Task{}
+	}
+	writeJSON(w, 200, moved)
+}
+
