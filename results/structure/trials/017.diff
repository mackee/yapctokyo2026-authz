+// ReassignTasks moves every task of projectID assigned to from over to to,
+// and returns the moved tasks in ID order (nil if there were none).
+func (s *Store) ReassignTasks(projectID, from, to string) []*Task {
+	var moved []*Task
+	for _, t := range s.TasksInProject(projectID) {
+		if t.Assignee == from {
+			t.Assignee = to
+			moved = append(moved, t)
+		}
+	}
+	return moved
+}
+
 func (s *Store) PutTask(t *Task) { s.tasks[t.ID] = t }
 
 func (s *Store) DeleteTask(id string) { delete(s.tasks, id) }
