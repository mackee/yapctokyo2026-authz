+func TestHandoverAccess(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager", "ann", "/projects/web/members/ben/handover", `{"to":"cat"}`, 200},
+		{"contributor", "ben", "/projects/web/members/cat/handover", `{"to":"ben"}`, 403},
+		{"viewer", "dan", "/projects/web/members/ben/handover", `{"to":"cat"}`, 403},
+		{"org admin", "eve", "/projects/web/members/ben/handover", `{"to":"cat"}`, 403},
+		{"non member", "hal", "/projects/web/members/ben/handover", `{"to":"cat"}`, 404},
+		{"other org", "gus", "/projects/web/members/ben/handover", `{"to":"cat"}`, 404},
+		{"anonymous", "", "/projects/web/members/ben/handover", `{"to":"cat"}`, 401},
+		{"unknown user", "zed", "/projects/web/members/ben/handover", `{"to":"cat"}`, 401},
+		{"archived", "ann", "/projects/legacy/members/ben/handover", `{"to":"ann"}`, 409},
+		{"missing to", "ann", "/projects/web/members/ben/handover", `{}`, 400},
+		{"empty to", "ann", "/projects/web/members/ben/handover", `{"to":""}`, 400},
+		{"bad json", "ann", "/projects/web/members/ben/handover", `{"to":`, 400},
+		{"to self", "ann", "/projects/web/members/ben/handover", `{"to":"ben"}`, 400},
+		{"to viewer", "ann", "/projects/web/members/ben/handover", `{"to":"dan"}`, 400},
+		{"to non member", "ann", "/projects/web/members/ben/handover", `{"to":"hal"}`, 400},
+		{"to unknown", "ann", "/projects/web/members/ben/handover", `{"to":"zed"}`, 400},
+		{"no project", "ann", "/projects/nope/members/ben/handover", `{"to":"cat"}`, 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestHandoverMovesProjectTasks(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/members/ben/handover", "ann", `{"to":"cat"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var moved []Task
+	if err := json.Unmarshal([]byte(body), &moved); err != nil {
+		t.Fatal(err)
+	}
+	if len(moved) != 1 || moved[0].ID != "t1" || moved[0].Assignee != "cat" {
+		t.Fatalf("unexpected moved tasks: %+v", moved)
+	}
+
+	// The change is persisted: ben's task in web now belongs to cat.
+	_, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "cat" {
+		t.Fatalf("t1 assignee = %q, want cat", task.Assignee)
+	}
+
+	// Other projects are untouched: ben's task in legacy stays with ben.
+	_, body = do(t, h, "GET", "/projects/legacy/tasks/t5", "ann", "")
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "ben" {
+		t.Fatalf("legacy t5 assignee = %q, want ben", task.Assignee)
+	}
+
+	// Unassigned tasks and tasks of other members are untouched.
+	_, body = do(t, h, "GET", "/projects/web/tasks", "ann", "")
+	var tasks []Task
+	json.Unmarshal([]byte(body), &tasks)
+	for _, tk := range tasks {
+		if tk.ID == "t2" && tk.Assignee != "cat" {
+			t.Fatalf("t2 changed to %q", tk.Assignee)
+		}
+		if tk.ID == "t3" && tk.Assignee != "" {
+			t.Fatalf("t3 changed to %q", tk.Assignee)
+		}
+	}
+}
+
+func TestHandoverMultipleTasksAndEmpty(t *testing.T) {
+	h := newServer()
+
+	// cat holds t2 in web; the handover to ben should return exactly that task.
+	code, body := do(t, h, "POST", "/projects/web/members/cat/handover", "ann", `{"to":"ben"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var moved []Task
+	json.Unmarshal([]byte(body), &moved)
+	if len(moved) != 1 || moved[0].ID != "t2" || moved[0].Assignee != "ben" {
+		t.Fatalf("unexpected moved tasks: %+v", moved)
+	}
+
+	// Ben now holds t1 and t2 in web; handing them to ivy returns both, in ID order.
+	code, body = do(t, h, "POST", "/projects/web/members/ben/handover", "ann", `{"to":"ivy"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	moved = nil
+	json.Unmarshal([]byte(body), &moved)
+	if len(moved) != 2 || moved[0].ID != "t1" || moved[1].ID != "t2" {
+		t.Fatalf("unexpected moved tasks: %+v", moved)
+	}
+
+	// Nothing left for ben: empty array, not null.
+	code, body = do(t, h, "POST", "/projects/web/members/ben/handover", "ann", `{"to":"ivy"}`)
+	if code != 200 || body != "[]\n" {
+		t.Fatalf("got %d %q, want 200 []", code, body)
+	}
+}
