index 0000000..5157eda
--- /dev/null
+++ b/org_test.go
@@ -0,0 +1,96 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes self", "eve", "/orgs/acme/users/eve", 204},
+		{"org admin removes user without roles", "eve", "/orgs/acme/users/hal", 204},
+		{"member cannot remove", "ann", "/orgs/acme/users/ben", 403},
+		{"viewer cannot remove", "dan", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"caller in other org", "gus", "/orgs/acme/users/ben", 404},
+		{"org in other org", "eve", "/orgs/globex/users/gus", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ben", 404},
+		{"user in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	srv := newServer()
+
+	if code, body := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove ben: got %d %s", code, body)
+	}
+
+	// ben is no longer a member of web or legacy, so neither is readable.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads web: got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/legacy/tasks/t5", "ben", ""); code != 404 {
+		t.Fatalf("ben reads legacy: got %d want 404", code)
+	}
+	// ben cannot be assigned any more.
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "ann", `{"title":"x","assignee":"ben"}`); code != 400 {
+		t.Fatalf("assign ben: got %d want 400", code)
+	}
+
+	// Tasks ben was assigned are unassigned, including the archived legacy one;
+	// tasks of other members are untouched.
+	wantAssignee := map[string]string{"/projects/web/tasks/t1": "", "/projects/legacy/tasks/t5": "", "/projects/web/tasks/t2": "cat"}
+	for path, want := range wantAssignee {
+		code, body := do(t, srv, "GET", path, "ann", "")
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil || code != 200 {
+			t.Fatalf("%s: got %d %s", path, code, body)
+		}
+		if task.AssigneeID != want {
+			t.Fatalf("%s: assignee %q want %q", path, task.AssigneeID, want)
+		}
+	}
+
+	// Other memberships are unchanged.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat reads web: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "ann", ""); code != 200 {
+		t.Fatalf("ann reads ops: got %d want 200", code)
+	}
+
+	// Removing again is a no-op that still answers 204.
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove ben again: got %d want 204", code)
+	}
+}
+
+func TestRemoveOrgAdminLosesOrgReads(t *testing.T) {
+	srv := newServer()
+
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/eve", "eve", ""); code != 204 {
+		t.Fatalf("eve removes self: got %d want 204", code)
+	}
+	// Without the org-admin role and memberships, eve reads nothing in acme.
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "eve", ""); code != 404 {
+		t.Fatalf("eve reads ops: got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/hal", "eve", ""); code != 403 {
+		t.Fatalf("eve removes hal: got %d want 403", code)
+	}
+}
