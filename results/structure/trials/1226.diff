 func (a *deleteTaskAggregate) apply(ctx context.Context, tx DB) error { return a.task.destroy(ctx, tx) }
+
+// removeOrgUserAggregate removes one user from one organization: the user's
+// memberships in the organization's projects go, the tasks they were assigned
+// in those projects are unassigned (an assignee must be a member), and the
+// org-admin role is cleared (it would otherwise still read every project).
+type removeOrgUserAggregate struct {
+	user *User
+	org  string
+}
+
+func loadRemoveOrgUser(ctx context.Context, tx DB, orgID, userID string) (*removeOrgUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != orgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	return &removeOrgUserAggregate{user: u, org: orgID}, nil
+}
+
+func (a *removeOrgUserAggregate) validate() error { return nil }
+
+func (a *removeOrgUserAggregate) apply(ctx context.Context, tx DB) error {
+	ms, err := a.user.Memberships(ctx, tx)
+	if err != nil {
+		return err
+	}
+	for _, m := range ms {
+		p, err := m.Project(ctx, tx)
+		if err != nil {
+			return err
+		}
+		if p.Org != a.org {
+			continue
+		}
+		assigned, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return err
+		}
+		for _, t := range assigned {
+			if err := t.unassign(ctx, tx); err != nil {
+				return err
+			}
+		}
+		if err := m.destroy(ctx, tx); err != nil {
+			return err
+		}
+	}
+	a.user.OrgAdmin = false
+	return a.user.save(ctx, tx)
+}
