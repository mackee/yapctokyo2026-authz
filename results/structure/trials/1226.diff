+
+// Remove takes the user out of the organization of the authorization object:
+// the user leaves every project of the organization and loses the org-admin
+// role. The user row itself is kept. Org admins only; the user must belong to
+// the organization (else ErrNotFound).
+func (*UserTable) Remove(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanManageUsers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveOrgUser(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
