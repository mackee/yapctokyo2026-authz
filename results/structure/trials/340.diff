+
+// ---- organization capabilities -------------------------------------------------
+
+// OrgScope is bound to one actor and one organization ID.
+type OrgScope interface {
+	ID() string
+	// Admin acquires the org-admin capability. Another organization is 404; a
+	// member who is not an org admin is 403.
+	Admin() (AdminOrg, error)
+}
+
+// AdminOrg may manage the membership of one organization.
+type AdminOrg interface {
+	// RemoveUser takes a user out of every project of the organization. Tasks
+	// the user holds in those projects become unassigned. The user must belong
+	// to the organization (else 404). Removing a user who is already out of
+	// every project succeeds.
+	RemoveUser(userID string) error
+}
+
+type orgScope struct {
+	as  *actorScope
+	oid string
+}
+
+func (s *orgScope) ID() string { return s.oid }
+
+func (s *orgScope) Admin() (AdminOrg, error) {
+	if s.as.actor.org != s.oid {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if !s.as.actor.orgAdmin {
+		return nil, deny(ErrForbidden, "forbidden")
+	}
+	return &adminOrg{orgScope: s}, nil
+}
+
+type adminOrg struct{ *orgScope }
+
+func (o *adminOrg) RemoveUser(userID string) error {
+	return o.as.a.db.update(func(x *tx) error {
+		agg, err := loadRemoveUser(x, o.oid, userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		agg.save(x)
+		return nil
+	})
+}
