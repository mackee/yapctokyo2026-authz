+
+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes user with no projects", "eve", "/orgs/acme/users/hal", 204},
+		{"member is not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"other org's user cannot remove", "gus", "/orgs/acme/users/ben", 404},
+		{"org admin of other org", "eve", "/orgs/globex/users/gus", 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed", 404},
+		{"user of other org", "eve", "/orgs/acme/users/gus", 404},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown actor", "zed", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+// taskAssignee reads one task as the given user and returns its assignee.
+func taskAssignee(t *testing.T, h http.Handler, user, project, tid string) string {
+	t.Helper()
+	code, body := do(t, h, "GET", "/projects/"+project+"/tasks/"+tid, user, "")
+	if code != 200 {
+		t.Fatalf("get %s/%s as %s: got %d", project, tid, user, code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	return task.Assignee
+}
+
+func TestRemoveOrgUserTakesUserOutOfAllProjects(t *testing.T) {
+	h := newServer()
+
+	// cat is a contributor of web and ops, and holds t2 (web) and t4 (ops).
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/cat", "eve", ""); code != 204 {
+		t.Fatalf("remove cat: got %d want 204", code)
+	}
+
+	for _, p := range []string{"/projects/web/tasks", "/projects/ops/tasks"} {
+		if code, _ := do(t, h, "GET", p, "cat", ""); code != 404 {
+			t.Fatalf("cat GET %s: got %d want 404", p, code)
+		}
+	}
+
+	// Tasks cat held in those projects are unassigned; other people's tasks are untouched.
+	if got := taskAssignee(t, h, "ann", "web", "t2"); got != "" {
+		t.Fatalf("t2 assignee: got %q want unassigned", got)
+	}
+	if got := taskAssignee(t, h, "ann", "ops", "t4"); got != "" {
+		t.Fatalf("t4 assignee: got %q want unassigned", got)
+	}
+	if got := taskAssignee(t, h, "ann", "web", "t1"); got != "ben" {
+		t.Fatalf("t1 assignee: got %q want ben", got)
+	}
+
+	// The assignee rule now rejects cat, since cat is no longer a member.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ann", `{"title":"x","assignee":"cat"}`); code != 400 {
+		t.Fatalf("assign removed user: got %d want 400", code)
+	}
+
+	// Removing again is accepted.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/cat", "eve", ""); code != 204 {
+		t.Fatalf("remove cat again: got %d want 204", code)
+	}
+}
+
+func TestRemoveOrgUserKeepsOtherMembers(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove ben: got %d want 204", code)
+	}
+	// ben is out of web and legacy.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t1", "ben", ""); code != 404 {
+		t.Fatalf("ben GET web task: got %d want 404", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/legacy/tasks/t5", "ben", ""); code != 404 {
+		t.Fatalf("ben GET legacy task: got %d want 404", code)
+	}
+	// cat, who is not removed, keeps her membership and her task.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t2", "cat", ""); code != 200 {
+		t.Fatalf("cat GET t2: got %d want 200", code)
+	}
+	if got := taskAssignee(t, h, "ann", "web", "t2"); got != "cat" {
+		t.Fatalf("t2 assignee: got %q want cat", got)
+	}
+}
