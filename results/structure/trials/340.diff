diff --git a/internal/capability/aggregate.go b/internal/capability/aggregate.go
index af9c3c6..8ec3e65 100644
--- a/internal/capability/aggregate.go
+++ b/internal/capability/aggregate.go
@@ -108,3 +108,40 @@ func loadDeleteTask(x *tx, taskID string) (*deleteTaskAggregate, error) {
 func (a *deleteTaskAggregate) validate() error { return nil }
 
 func (a *deleteTaskAggregate) save(x *tx) { a.task.destroy(x) }
+
+// removeUserAggregate takes one user out of every project of an organization.
+// The membership rule for assignees means the user's tasks in those projects
+// must be unassigned in the same write, so the aggregate carries them too.
+type removeUserAggregate struct {
+	memberships []membershipRecord // the user's memberships to delete
+	tasks       []taskRecord       // the user's tasks in those projects, already unassigned
+}
+
+func loadRemoveUser(x *tx, orgID, userID string) (*removeUserAggregate, error) {
+	u, ok := x.findUser(userID)
+	if !ok || u.Org != orgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	a := &removeUserAggregate{}
+	for _, p := range x.projectsIn(orgID) {
+		if m, ok := x.findMembership(p.ID, userID); ok {
+			a.memberships = append(a.memberships, m)
+		}
+		for _, t := range x.tasksAssignedTo(p.ID, userID) {
+			t.AssigneeID = ""
+			a.tasks = append(a.tasks, t)
+		}
+	}
+	return a, nil
+}
+
+func (a *removeUserAggregate) validate() error { return nil }
+
+func (a *removeUserAggregate) save(x *tx) {
+	for _, m := range a.memberships {
+		m.destroy(x)
+	}
+	for _, t := range a.tasks {
+		t.save(x)
+	}
+}
