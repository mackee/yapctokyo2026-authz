+// Move moves the task to dest, keeping its ID, title, status and assignee.
+// The caller must hold Manage on the task (manager of the source project) and
+// Write on the destination. A contributor of the destination may only receive
+// tasks that are unassigned or assigned to themselves (403). If the assignee is
+// not a contributor or manager of the destination, nothing changes (400).
+func (t *manageTask) Move(dest WriteProject) (TaskView, error) {
+	destID := dest.ID()
+	if destID == t.ts.ps.pid {
+		return TaskView{}, deny(ErrInvalid, "task is already in that project")
+	}
+	var v TaskView
+	err := t.ts.ps.as.a.st.tx(func(s *state) error {
+		cur, ok := s.tasks[t.ts.tid]
+		if !ok || cur.project != t.ts.ps.pid {
+			return deny(ErrNotFound, "not found")
+		}
+		if dest.Role() == RoleContributor && cur.assignee.user != "" && cur.assignee.user != t.ts.ps.as.actor.id {
+			return deny(ErrForbidden, "contributors may only move tasks assigned to themselves into a project")
+		}
+		a, err := admit(s, destID, cur.assignee.user)
+		if err != nil {
+			return err
+		}
+		cur.project = destID
+		cur.assignee = a
+		s.tasks[cur.id] = cur
+		v = cur.view()
+		return nil
+	})
+	return v, err
+}
