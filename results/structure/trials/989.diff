+package main
+
+import (
+	"encoding/json"
+	"reflect"
+	"testing"
+)
+
+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"archived", "ann", "legacy", 409},
+		{"anonymous", "", "web", 401},
+		{"unknown project", "ann", "nope", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestFreezeResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got []memberRole
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	// web members in seed: ann (manager), ben, cat (contributors), dan (viewer), ivy (manager).
+	want := []memberRole{
+		{UserID: "ann", Role: "viewer"},
+		{UserID: "ben", Role: "viewer"},
+		{UserID: "cat", Role: "viewer"},
+		{UserID: "dan", Role: "viewer"},
+		{UserID: "ivy", Role: "viewer"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+}
+
+func TestFrozenProjectRejectsWrites(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze got %d body=%s", code, body)
+	}
+	cases := []struct {
+		name, user, method, path, body string
+		want                           int
+	}{
+		{"former manager patches", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"former manager creates", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"former manager deletes", "ann", "DELETE", "/projects/web/tasks/t1", "", 403},
+		{"former manager ivy patches", "ivy", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"former contributor patches own", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`, 403},
+		{"former contributor creates", "ben", "POST", "/projects/web/tasks", `{"title":"x","assignee":"ben"}`, 403},
+		{"org admin patches", "eve", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`, 403},
+		{"former manager cannot refreeze", "ann", "POST", "/projects/web/freeze", "", 403},
+		{"viewer still reads", "dan", "GET", "/projects/web/tasks/t1", "", 200},
+		{"other project unaffected", "cat", "PATCH", "/projects/ops/tasks/t4", `{"status":"done"}`, 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, h, c.method, c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+	// The rejected PATCH must not have changed t1.
+	_, body := do(t, h, "GET", "/projects/web/tasks/t1", "dan", "")
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.Status != "open" {
+		t.Fatalf("frozen task changed: status=%q", task.Status)
+	}
+}
+
+// The frozen flag is checked independently of roles: even if a non-viewer
+// membership exists in a frozen project, writes are rejected with 409.
+func TestFrozenFlagBlocksWritesEvenForManagers(t *testing.T) {
+	db, err := openSeededDB()
+	if err != nil {
+		t.Fatal(err)
+	}
+	h := (&server{db: db}).routes()
+	for _, q := range []string{
+		`UPDATE projects SET frozen = 1 WHERE id = 'web'`,
+		`UPDATE memberships SET role = 'manager' WHERE project_id = 'web' AND user_id = 'ben'`,
+	} {
+		if _, err := db.Exec(q); err != nil {
+			t.Fatal(err)
+		}
+	}
+	cases := []struct {
+		name, method, path, body string
+	}{
+		{"patch", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"create", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"delete", "DELETE", "/projects/web/tasks/t1", ""},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, h, c.method, c.path, "ben", c.body)
+			if code != 409 {
+				t.Fatalf("got %d want 409 body=%s", code, body)
+			}
+		})
+	}
+}
