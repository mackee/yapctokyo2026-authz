+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"testing"
+)
+
+func TestFreeze(t *testing.T) {
+	h := newServer()
+
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != http.StatusOK {
+		t.Fatalf("freeze: got %d %s", code, body)
+	}
+	var members []struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &members); err != nil {
+		t.Fatal(err)
+	}
+	want := []string{"ann", "ben", "cat", "dan", "ivy"}
+	if len(members) != len(want) {
+		t.Fatalf("members: got %s", body)
+	}
+	for i, m := range members {
+		if m.UserID != want[i] || m.Role != "viewer" {
+			t.Errorf("member %d: got %+v, want %s viewer", i, m, want[i])
+		}
+	}
+
+	// Nobody can change tasks any more, managers included.
+	writes := []struct{ method, path, user, body string }{
+		{"POST", "/projects/web/tasks", "ann", `{"title":"x"}`},
+		{"POST", "/projects/web/tasks", "ben", `{"title":"x"}`},
+		{"PATCH", "/projects/web/tasks/t1", "ann", `{"status":"done"}`},
+		{"PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`},
+		{"PATCH", "/projects/web/tasks/t3", "ivy", `{"title":"y"}`},
+		{"DELETE", "/projects/web/tasks/t3", "ann", ""},
+		{"DELETE", "/projects/web/tasks/t3", "ivy", ""},
+		{"PATCH", "/projects/web/tasks/t3", "eve", `{"title":"y"}`},
+	}
+	for _, w := range writes {
+		if code, body := do(t, h, w.method, w.path, w.user, w.body); code != http.StatusForbidden {
+			t.Errorf("%s %s as %s after freeze: got %d %s, want 403", w.method, w.path, w.user, code, body)
+		}
+	}
+
+	// Reads still work; assigned tasks were unassigned to keep the model rules.
+	code, body = do(t, h, "GET", "/projects/web/tasks", "dan", "")
+	if code != http.StatusOK {
+		t.Fatalf("list: got %d %s", code, body)
+	}
+	var tasks []Task
+	if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+		t.Fatal(err)
+	}
+	if len(tasks) != 3 {
+		t.Fatalf("tasks: got %s", body)
+	}
+	for _, task := range tasks {
+		if task.AssigneeID != "" {
+			t.Errorf("task %s still assigned to %s", task.ID, task.AssigneeID)
+		}
+	}
+
+	// Other projects are untouched.
+	if code, body := do(t, h, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`); code != http.StatusOK {
+		t.Errorf("ops task after freezing web: got %d %s", code, body)
+	}
+}
+
+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager", "ivy", "/projects/ops/freeze", http.StatusOK},
+		{"contributor", "cat", "/projects/ops/freeze", http.StatusForbidden},
+		{"viewer", "ann", "/projects/ops/freeze", http.StatusForbidden},
+		{"org admin", "eve", "/projects/ops/freeze", http.StatusForbidden},
+		{"non member", "hal", "/projects/ops/freeze", http.StatusNotFound},
+		{"other org", "gus", "/projects/ops/freeze", http.StatusNotFound},
+		{"unknown user", "nobody", "/projects/ops/freeze", http.StatusUnauthorized},
+		{"no user", "", "/projects/ops/freeze", http.StatusUnauthorized},
+		{"missing project", "ann", "/projects/nope/freeze", http.StatusNotFound},
+		{"archived", "ann", "/projects/legacy/freeze", http.StatusConflict},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			if code, body := do(t, h, "POST", c.path, c.user, ""); code != c.want {
+				t.Errorf("got %d %s, want %d", code, body, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeDeniedChangesNothing(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ben", ""); code != http.StatusForbidden {
+		t.Fatalf("got %d, want 403", code)
+	}
+	if code, body := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != http.StatusOK {
+		t.Errorf("ben should still write: got %d %s", code, body)
+	}
+}
