+
+// updateRolesAggregate changes the roles of some members of one project.
+type updateRolesAggregate struct {
+	changes []roleChange // ordered by user ID
+}
+
+type roleChange struct {
+	member *Membership
+	role   string
+	// tasks are the member's tasks in the project. They are loaded only when
+	// the member becomes a non-writer (viewer), and are unassigned so that
+	// every assignee stays a contributor or manager.
+	tasks []*Task
+}
+
+func loadUpdateRoles(ctx context.Context, tx DB, projectID string, in MembershipTableUpdateRolesInput) (*updateRolesAggregate, error) {
+	if _, err := NewProjectTable().Find(ctx, tx, projectID); errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	userIDs := make([]string, 0, len(in.Roles))
+	for id := range in.Roles {
+		userIDs = append(userIDs, id)
+	}
+	sort.Strings(userIDs)
+	a := &updateRolesAggregate{}
+	for _, id := range userIDs {
+		m, err := NewMembershipTable().Find(ctx, tx, projectID, id)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, fmt.Sprintf("%s is not a member of the project", id))
+		} else if err != nil {
+			return nil, err
+		}
+		c := roleChange{member: m, role: in.Roles[id]}
+		if !isWriterRole(c.role) {
+			if c.tasks, err = m.AssignedTasks(ctx, tx); err != nil {
+				return nil, err
+			}
+		}
+		a.changes = append(a.changes, c)
+	}
+	return a, nil
+}
+
+func (a *updateRolesAggregate) apply(ctx context.Context, tx DB) error {
+	for _, c := range a.changes {
+		for _, t := range c.tasks {
+			if err := t.unassign(ctx, tx); err != nil {
+				return err
+			}
+		}
+		if err := c.member.setRole(ctx, tx, c.role); err != nil {
+			return err
+		}
+	}
+	return nil
+}
