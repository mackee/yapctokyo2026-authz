+// MemberView is the public representation of a project membership.
+type MemberView struct {
+	UserID    string `json:"userId"`
+	ProjectID string `json:"projectId"`
+	Role      string `json:"role"`
+}
+
+// ManageProject may change the membership of one project.
+type ManageProject interface {
+	ReadProject
+	// MoveMember removes userID from this project and adds them to dst with the
+	// same role, atomically. The caller must be a manager of both projects, and
+	// both must be writable (not archived). The user must not already be a member
+	// of dst (409). Tasks the user held in this project are left unassigned,
+	// since their assignee must belong to the task's project.
+	MoveMember(userID string, dst ProjectScope) (MemberView, error)
+}
+
+type manageProject struct{ readProject }
+
+func (p *manageProject) MoveMember(userID string, dst ProjectScope) (MemberView, error) {
+	ds, ok := dst.(*projectScope)
+	if !ok || ds.as != p.ps.as {
+		return MemberView{}, deny(ErrInvalid, "destination project is not in this actor's scope")
+	}
+	if ds.pid == "" || ds.pid == p.ps.pid {
+		return MemberView{}, deny(ErrInvalid, "destination must be a different project")
+	}
+	src, actor := p.ps.pid, p.ps.as.actor
+	var v MemberView
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		// Source: the caller must still be a writable project's manager, and the
+		// user must be a member of it.
+		sp, srcRole, err := readable(s, actor, src)
+		if err != nil {
+			return err
+		}
+		if srcRole != RoleManager {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if sp.archived {
+			return deny(ErrArchived, "project is archived")
+		}
+		role := s.role(src, userID)
+		if role == "" {
+			return deny(ErrNotFound, "not found")
+		}
+		// Destination: readable, the caller must manage it, and it must be writable.
+		dp, dstRole, err := readable(s, actor, ds.pid)
+		if err != nil {
+			return err
+		}
+		if dstRole != RoleManager {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if dp.archived {
+			return deny(ErrArchived, "project is archived")
+		}
+		if s.role(ds.pid, userID) != "" {
+			return deny(ErrConflict, "user is already a member of the destination project")
+		}
+
+		for id, t := range s.tasks {
+			if t.project == src && t.assignee.user == userID {
+				t.assignee = Assignee{project: src}
+				s.tasks[id] = t
+			}
+		}
+		delete(s.members[src], userID)
+		if s.members[ds.pid] == nil {
+			s.members[ds.pid] = map[string]string{}
+		}
+		s.members[ds.pid][userID] = role
+		v = MemberView{UserID: userID, ProjectID: ds.pid, Role: role}
+		return nil
+	})
+	return v, err
+}
