+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if u, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return u, nil
