+// transferUserAggregate moves one user to another organization. The user's
+// memberships in projects outside the target organization are removed with
+// the move, since project members belong to the project's organization.
+type transferUserAggregate struct {
+	user    *User
+	toOrg   string
+	outside []outsideMembership
+}
+
+// outsideMembership is a membership in a project outside the target organization.
+type outsideMembership struct {
+	membership *Membership
+	project    *Project
+}
+
+func loadTransferUser(ctx context.Context, tx DB, fromOrg string, in UserTableTransferInput) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, in.UserID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != fromOrg {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	a := &transferUserAggregate{user: u, toOrg: in.ToOrgID}
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, m := range ms {
+		p, err := m.Project(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		if p.Org != in.ToOrgID {
+			a.outside = append(a.outside, outsideMembership{membership: m, project: p})
+		}
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	for _, o := range a.outside {
+		if o.project.Archived {
+			return deny(ErrArchived, "project is archived")
+		}
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	for _, o := range a.outside {
+		tasks, err := o.membership.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		for _, t := range tasks {
+			if err := t.unassign(ctx, tx); err != nil {
+				return nil, err
+			}
+		}
+		if err := o.membership.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	// Org admin rights belong to the organization the user left.
+	a.user.Org = a.toOrg
+	a.user.OrgAdmin = false
+	if err := a.user.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
+
