+// Transfer moves a user out of the authorization object's organization into
+// ToOrgID. Only org admins of that organization may do it. The user's
+// memberships in projects outside ToOrgID go with the move, and their tasks in
+// those projects are unassigned. The move is refused with ErrArchived if one of
+// those projects is archived. All or nothing.
+func (*UserTable) Transfer(ctx context.Context, db DB, authz OrgAuthz, in UserTableTransferInput) (*User, error) {
+	if err := authz.CanTransferUsers(); err != nil {
