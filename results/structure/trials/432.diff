index f2abe36..32c4695 100644
--- a/internal/model/membership_table.go
+++ b/internal/model/membership_table.go
@@ -42,6 +42,42 @@ func (*MembershipTable) ListByProject(ctx context.Context, db DB, projectID stri
 	return out, nil
 }
 
+// validRoles are the project roles a membership may have.
+var validRoles = map[string]bool{RoleManager: true, RoleContributor: true, RoleViewer: true}
+
+// UpdateRoles changes the roles of several members of one project, all or
+// nothing. roles maps user ID to the new role. It asks the authorization object
+// whether the actor may manage members, then runs the operation's aggregate
+// (aggregate.go). It returns the project's members after the change, ordered by
+// user ID.
+//
+// If any user is not a member of the project, or any role is not valid, nothing
+// changes and the error is ErrInvalid (400).
+func (*MembershipTable) UpdateRoles(ctx context.Context, db DB, authz ProjectAuthz, roles map[string]string) ([]*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var out []*Membership
+	if err := db.update(ctx, func(x *Tx) error {
+		agg, err := loadUpdateRoles(ctx, x, authz.ProjectID(), roles)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		members, err := agg.apply(ctx, x)
+		if err != nil {
+			return err
+		}
+		out = members
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
+
