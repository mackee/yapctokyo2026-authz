 }
 
+// updateRolesAggregate changes the roles of several members of one project.
+type updateRolesAggregate struct {
+	project *Project
+	changes []roleChange
+}
+
+// roleChange is one member's new role. member is the membership as loaded.
+type roleChange struct {
+	member *Membership
+	role   string
+}
+
+func loadUpdateRoles(ctx context.Context, x *Tx, projectID string, roles map[string]string) (*updateRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, x, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	userIDs := make([]string, 0, len(roles))
+	for uid := range roles {
+		userIDs = append(userIDs, uid)
+	}
+	sort.Strings(userIDs) // a fixed order keeps the aggregate deterministic
+	a := &updateRolesAggregate{project: p}
+	for _, uid := range userIDs {
+		m, err := p.Membership(ctx, x, uid)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "user is not a member of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		a.changes = append(a.changes, roleChange{member: m, role: roles[uid]})
+	}
+	return a, nil
+}
+
+func (a *updateRolesAggregate) validate() error {
+	if len(a.changes) == 0 {
+		return deny(ErrInvalid, "roles must not be empty")
+	}
+	for _, c := range a.changes {
+		if !validRoles[c.role] {
+			return deny(ErrInvalid, "role must be manager, contributor or viewer")
+		}
+	}
+	return nil
+}
+
+// apply changes the roles and returns the project's members. A member who
+// becomes a viewer cannot be a task assignee (an assignee is a contributor or
+// manager), so their tasks in the project are unassigned.
+func (a *updateRolesAggregate) apply(ctx context.Context, x *Tx) ([]*Membership, error) {
+	for _, c := range a.changes {
+		c.member.Role = c.role
+		if err := c.member.save(ctx, x); err != nil {
+			return nil, err
+		}
+		if c.role != RoleViewer {
+			continue
+		}
+		tasks, err := c.member.AssignedTasks(ctx, x)
+		if err != nil {
+			return nil, err
+		}
+		for _, t := range tasks {
+			if err := t.unassign(ctx, x); err != nil {
+				return nil, err
+			}
+		}
+	}
+	return NewMembershipTable().ListByProject(ctx, x, a.project.ID)
+}
+
