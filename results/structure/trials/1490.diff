diff --git a/move_test.go b/move_test.go
new file mode 100644
index 0000000..fb19ed7
--- /dev/null
+++ b/move_test.go
@@ -0,0 +1,102 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestMoveStatuses(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager moves to writable project", "ivy", "/projects/web/tasks/t2/move", `{"toProjectId":"ops"}`, 200},
+		{"contributor moves own task to project they write", "cat", "/projects/ops/tasks/t4/move", `{"toProjectId":"web"}`, 200},
+		{"contributor moves others' task", "cat", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer", "dan", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin without role", "eve", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"non member of source", "hal", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 404},
+		{"contributor not member of target", "ben", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 404},
+		{"viewer in target", "ann", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"archived source", "ann", "/projects/legacy/tasks/t5/move", `{"toProjectId":"web"}`, 409},
+		{"archived target", "ann", "/projects/web/tasks/t3/move", `{"toProjectId":"legacy"}`, 409},
+		{"assignee not in target", "ivy", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 400},
+		{"same project", "ivy", "/projects/web/tasks/t2/move", `{"toProjectId":"web"}`, 400},
+		{"missing target", "ivy", "/projects/web/tasks/t2/move", `{"toProjectId":"nope"}`, 404},
+		{"target in other org", "ivy", "/projects/web/tasks/t2/move", `{"toProjectId":"gx"}`, 404},
+		{"missing toProjectId", "ivy", "/projects/web/tasks/t2/move", `{}`, 400},
+		{"malformed body", "ivy", "/projects/web/tasks/t2/move", `{"toProjectId":`, 400},
+		{"task not in path project", "ann", "/projects/ops/tasks/t1/move", `{"toProjectId":"web"}`, 404},
+		{"cross org", "gus", "/projects/web/tasks/t2/move", `{"toProjectId":"gx"}`, 404},
+		{"anonymous", "", "/projects/web/tasks/t2/move", `{"toProjectId":"ops"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsTaskAndChangesProject(t *testing.T) {
+	h := newServer()
+
+	code, body := do(t, h, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d: %s", code, body)
+	}
+	var moved Task
+	if err := json.Unmarshal([]byte(body), &moved); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", AssigneeID: "cat"}
+	if moved != want {
+		t.Fatalf("moved task = %+v, want %+v", moved, want)
+	}
+
+	// The task is now found under the target project only.
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks/t2", "ivy", ""); code != 200 {
+		t.Fatalf("get in target: got %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t2", "ivy", ""); code != 404 {
+		t.Fatalf("get in source: got %d, want 404", code)
+	}
+	code, body = do(t, h, "GET", "/projects/ops/tasks", "ivy", "")
+	if code != 200 {
+		t.Fatal(code)
+	}
+	var tasks []Task
+	if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+		t.Fatal(err)
+	}
+	found := false
+	for _, task := range tasks {
+		if task.ID == "t2" {
+			found = true
+		}
+	}
+	if !found || len(tasks) != 2 {
+		t.Fatalf("ops should list t2 and t4, got %d tasks (found=%v)", len(tasks), found)
+	}
+}
+
+func TestMoveFailureChangesNothing(t *testing.T) {
+	h := newServer()
+	// ben is not a member of ops, so the move is refused (404) and t1 stays in web.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks/t1/move", "ben", `{"toProjectId":"ops"}`); code != 404 {
+		t.Fatalf("got %d want 404", code)
+	}
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("t1 should still be in web, got %d", code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.ProjectID != "web" {
+		t.Fatalf("t1 moved to %s despite the refusal", task.ProjectID)
+	}
+}
