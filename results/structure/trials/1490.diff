+// TaskTableMoveInput is the input of TaskTable.Move.
+type TaskTableMoveInput struct {
+	ToProjectID string
+}
+
+// Move moves the task to another project. The actor must be able to edit the
+// task in its current project and to write tasks in the target project. The
+// task keeps its ID, title, status and assignee; the assignee must be a
+// contributor or manager of the target project.
+func (*TaskTable) Move(ctx context.Context, db DB, authz TaskAuthz, in TaskTableMoveInput) (*Task, error) {
+	if err := authz.CanEdit(); err != nil {
+		return nil, err
+	}
+	target, err := NewProjectAuthz(ctx, db, authz.Project().Actor(), in.ToProjectID)
+	if err != nil {
+		return nil, err
+	}
+	if err := target.CanWrite(); err != nil {
+		return nil, err
+	}
+	var t *Task
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveTask(ctx, tx, authz.TaskID(), in.ToProjectID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if t, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return t, nil
+}
