+// moveTaskAggregate moves one task to another project.
+type moveTaskAggregate struct {
+	task     *Task
+	target   *Project
+	assignee *Membership // the assignee's membership in the target project; nil when unassigned
+}
+
+func loadMoveTask(ctx context.Context, tx DB, taskID, toProjectID string) (*moveTaskAggregate, error) {
+	t, err := NewTaskTable().Find(ctx, tx, taskID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	p, err := NewProjectTable().Find(ctx, tx, toProjectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveTaskAggregate{task: t, target: p}
+	if t.AssigneeID != "" {
+		m, err := p.Membership(ctx, tx, t.AssigneeID)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "the assignee must be a contributor or manager of the target project")
+		} else if err != nil {
+			return nil, err
+		}
+		a.assignee = m
+	}
+	return a, nil
+}
+
+func (a *moveTaskAggregate) validate() error {
+	if a.task.ProjectID == a.target.ID {
+		return deny(ErrInvalid, "task is already in that project")
+	}
+	if a.assignee != nil && !isWriterRole(a.assignee.Role) {
+		return deny(ErrInvalid, "the assignee must be a contributor or manager of the target project")
+	}
+	return nil
+}
+
+func (a *moveTaskAggregate) apply(ctx context.Context, tx DB) (*Task, error) {
+	if err := a.task.moveTo(ctx, tx, a.target); err != nil {
+		return nil, err
+	}
+	return a.task, nil
+}
+
