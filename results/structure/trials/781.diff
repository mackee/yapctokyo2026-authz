+func TestRemoveUserFromOrgEffects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatal(code)
+	}
+	// ben lost every membership, archived project included.
+	for _, p := range []string{"web", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ben", ""); code != 404 {
+			t.Fatalf("%s: got %d want 404", p, code)
+		}
+	}
+	// Others are untouched, and ben's tasks are unassigned.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatal(code)
+	}
+	for _, path := range []string{"/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		code, body := do(t, h, "GET", path, "ann", "")
+		var task Task
+		json.Unmarshal([]byte(body), &task)
+		if code != 200 || task.AssigneeID != "" {
+			t.Fatalf("%s: code %d assignee %q", path, code, task.AssigneeID)
+		}
+	}
+	// Removing again still succeeds (idempotent).
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatal(code)
+	}
+}
