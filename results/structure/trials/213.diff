+// FreezeMembers sets every member of the project to viewer and returns the
+// resulting member list sorted by user ID. Caller must hold s.mu.
+func (s *Store) FreezeMembers(projectID string) []memberResponse {
+	out := []memberResponse{}
+	for uid := range s.members[projectID] {
+		s.members[projectID][uid] = RoleViewer
+		out = append(out, memberResponse{UserID: uid, Role: RoleViewer})
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].UserID < out[j].UserID })
+	return out
+}
