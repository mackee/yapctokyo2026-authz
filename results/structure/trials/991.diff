+func TestTransfer(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/dan/transfer", `{"toOrgId":"globex"}`, 200},
+		{"org member not admin", "ann", "/orgs/acme/users/dan/transfer", `{"toOrgId":"globex"}`, 403},
+		{"anonymous", "", "/orgs/acme/users/dan/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown caller", "zed", "/orgs/acme/users/dan/transfer", `{"toOrgId":"globex"}`, 401},
+		{"caller in other org", "gus", "/orgs/acme/users/dan/transfer", `{"toOrgId":"globex"}`, 404},
+		{"path org unknown", "eve", "/orgs/initech/users/dan/transfer", `{"toOrgId":"globex"}`, 404},
+		{"user not in path org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"user missing", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"missing toOrgId", "eve", "/orgs/acme/users/dan/transfer", `{}`, 400},
+		{"bad json", "eve", "/orgs/acme/users/dan/transfer", `{`, 400},
+		{"unknown target org", "eve", "/orgs/acme/users/dan/transfer", `{"toOrgId":"initech"}`, 400},
+		{"same org", "eve", "/orgs/acme/users/dan/transfer", `{"toOrgId":"acme"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/dan/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["id"] != "dan" || got["orgId"] != "globex" || len(got) != 2 {
+		t.Fatalf("unexpected body %s", body)
+	}
+}
+
+func TestTransferRevokesOldOrgAccess(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/orgs/acme/users/dan/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer got %d body=%s", code, body)
+	}
+	// dan was a viewer of web (acme); after the move, web is in another org.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "dan", ""); code != 404 {
+		t.Fatalf("dan reads old-org project: got %d want 404", code)
+	}
+	// dan is not an admin in globex, so he cannot move himself back.
+	if code, _ := do(t, srv, "POST", "/orgs/globex/users/dan/transfer", "dan", `{"toOrgId":"acme"}`); code != 403 {
+		t.Fatalf("dan transfers self: got %d want 403", code)
+	}
+}
+
+func TestTransferOrgAdminCleared(t *testing.T) {
+	srv := newServer()
+	// eve is an acme org admin. Transfer her out; she must not keep admin rights.
+	if code, body := do(t, srv, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer got %d body=%s", code, body)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "eve", ""); code != 404 {
+		t.Fatalf("eve reads acme project after transfer: got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "POST", "/orgs/globex/users/gus/transfer", "eve", `{"toOrgId":"acme"}`); code != 403 {
+		t.Fatalf("eve (no longer admin) transfers: got %d want 403", code)
+	}
+}
