+  // PUT /projects/{pid}/members {"roles": {userId: role, ...}}
+  // All-or-nothing: every entry must be a valid role for an existing member of
+  // the project, and no member may lose write access while still being the
+  // assignee of a task in the project (that would break inv_assigneeIsWriter).
+  def setRolesOutcome(u: UserId, p: ProjectId, roles: UserId -> str): int =
+    if (not(userExists(u))) 401
+    else if (not(canRead(u, p))) 404
+    else if (roleOf(p, u) != "manager") 403
+    else if (projects.get(p).archived) 409
+    else if (roles.keys().size() == 0) 400
+    else if (roles.keys().exists(x => not(ROLES.contains(roles.get(x))) or roleOf(p, x) == "")) 400
+    else if (roles.keys().exists(x => and {
+      roles.get(x) == "viewer",
+      tasks.keys().exists(t => tasks.get(t).project == p and tasks.get(t).assignee == x),
+    })) 409
+    else 200
