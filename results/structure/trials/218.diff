+// OrgExists reports whether any user or project belongs to the organization.
+func (s *Store) OrgExists(orgID string) bool {
+	for _, u := range s.users {
+		if u.OrgID == orgID {
+			return true
+		}
+	}
+	for _, p := range s.projects {
+		if p.OrgID == orgID {
+			return true
+		}
+	}
+	return false
+}
+
+// TransferUser moves a user to another organization. Project memberships and
+// task assignments in the old organization are dropped, and org admin rights
+// are not carried over.
+func (s *Store) TransferUser(u *User, toOrgID string) {
+	for pid, p := range s.projects {
+		if p.OrgID == u.OrgID {
+			delete(s.members[pid], u.ID)
+		}
+	}
+	for _, t := range s.tasks {
+		if t.Assignee == u.ID && s.projects[t.ProjectID].OrgID == u.OrgID {
+			t.Assignee = ""
+		}
+	}
+	u.OrgID = toOrgID
+	u.OrgAdmin = false
+}
