+func TestMove(t *testing.T) {
+	t.Run("manager moves the task and keeps its id, title, status and assignee", func(t *testing.T) {
+		code, body := do(t, newServer(), "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+		if code != 200 {
+			t.Fatalf("got %d want 200: %s", code, body)
+		}
+		var got Task
+		if err := json.Unmarshal([]byte(body), &got); err != nil {
+			t.Fatal(err)
+		}
+		want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", AssigneeID: "cat"}
+		if got != want {
+			t.Fatalf("got %+v want %+v", got, want)
+		}
+	})
+
+	t.Run("unassigned task moves unassigned", func(t *testing.T) {
+		code, body := do(t, newServer(), "POST", "/projects/web/tasks/t3/move", "ivy", `{"toProjectId":"ops"}`)
+		if code != 200 {
+			t.Fatalf("got %d want 200: %s", code, body)
+		}
+		var got Task
+		if err := json.Unmarshal([]byte(body), &got); err != nil {
+			t.Fatal(err)
+		}
+		if got.ProjectID != "ops" || got.AssigneeID != "" {
+			t.Fatalf("got %+v", got)
+		}
+	})
+
+	t.Run("moved task leaves the source project and joins the target", func(t *testing.T) {
+		h := newServer()
+		if code, body := do(t, h, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`); code != 200 {
+			t.Fatalf("move: got %d want 200: %s", code, body)
+		}
+		if code, _ := do(t, h, "GET", "/projects/web/tasks/t2", "ivy", ""); code != 404 {
+			t.Fatalf("task still readable in source: got %d want 404", code)
+		}
+		code, body := do(t, h, "GET", "/projects/ops/tasks", "ivy", "")
+		if code != 200 {
+			t.Fatal(code)
+		}
+		var tasks []Task
+		if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+			t.Fatal(err)
+		}
+		ids := []string{}
+		for _, task := range tasks {
+			ids = append(ids, task.ID)
+		}
+		if strings.Join(ids, ",") != "t2,t4" {
+			t.Fatalf("ops tasks: got %v want [t2 t4]", ids)
+		}
+	})
+
+	t.Run("rejected move leaves the task unchanged", func(t *testing.T) {
+		h := newServer()
+		if code, _ := do(t, h, "POST", "/projects/web/tasks/t1/move", "ivy", `{"toProjectId":"ops"}`); code != 400 {
+			t.Fatalf("move: got %d want 400", code)
+		}
+		code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ben", "")
+		if code != 200 {
+			t.Fatal(code)
+		}
+		var got Task
+		if err := json.Unmarshal([]byte(body), &got); err != nil {
+			t.Fatal(err)
+		}
+		if got.ProjectID != "web" {
+			t.Fatalf("task moved despite rejection: %+v", got)
+		}
+	})
+
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"contributor", "ben", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer", "dan", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin", "eve", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer in target", "ann", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 403},
+		{"target not readable", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"legacy"}`, 404},
+		{"target in other org", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"gx"}`, 404},
+		{"target missing", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"nope"}`, 404},
+		{"target archived", "ann", "/projects/web/tasks/t3/move", `{"toProjectId":"legacy"}`, 409},
+		{"source archived", "ann", "/projects/legacy/tasks/t5/move", `{"toProjectId":"web"}`, 409},
+		{"same project", "ivy", "/projects/web/tasks/t2/move", `{"toProjectId":"web"}`, 400},
+		{"assignee not in target", "ivy", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 400},
+		{"empty target", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":""}`, 400},
+		{"task in other project", "ivy", "/projects/web/tasks/t4/move", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
