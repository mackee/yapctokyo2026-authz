+// Move moves the task to the project toProjectID. The actor must manage the
+// task's project (as for Delete); only then is the target project resolved, so
+// a denied actor learns nothing about it. The actor must be able to write to
+// the target project. The task keeps its ID, title, status and assignee; its
+// assignee must be a contributor or manager of the target.
+func (*TaskTable) Move(ctx context.Context, db DB, authz TaskAuthz, toProjectID string) (*Task, error) {
+	if err := authz.CanManage(); err != nil {
+		return nil, err
+	}
+	if toProjectID == authz.Project().ProjectID() {
+		return nil, deny(ErrInvalid, "task is already in the project")
+	}
+	to, err := NewProjectAuthz(ctx, db, authz.Project().Actor(), toProjectID)
+	if err != nil {
+		return nil, err
+	}
+	if err := to.CanWrite(); err != nil {
+		return nil, err
+	}
+	var t *Task
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveTask(ctx, tx, authz.TaskID(), toProjectID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if t, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return t, nil
+}
