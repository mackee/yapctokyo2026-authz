+func TestUpdateMembers(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager bulk", "ann", "web", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 200},
+		{"manager promotes viewer", "ann", "web", `{"roles":{"dan":"manager"}}`, 200},
+		{"manager demotes unassigned", "ann", "web", `{"roles":{"ivy":"viewer"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin non member", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"unknown project", "ann", "nope", `{"roles":{"ben":"viewer"}}`, 404},
+		{"invalid role", "ann", "web", `{"roles":{"dan":"owner"}}`, 400},
+		{"not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"bad json", "ann", "web", `{"roles":`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+	t.Run("anonymous", func(t *testing.T) {
+		code, _ := do(t, newServer(), "PUT", "/projects/web/members", "", `{"roles":{"dan":"contributor"}}`)
+		if code != 401 {
+			t.Fatalf("got %d want 401", code)
+		}
+	})
+}
+
+func TestUpdateMembersResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann",
+		`{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := `[{"userId":"ann","role":"manager"},{"userId":"ben","role":"viewer"},` +
+		`{"userId":"cat","role":"contributor"},{"userId":"dan","role":"contributor"},` +
+		`{"userId":"ivy","role":"manager"}]`
+	var gotJSON, wantJSON any
+	json.Unmarshal([]byte(body), &gotJSON)
+	json.Unmarshal([]byte(want), &wantJSON)
+	if !reflect.DeepEqual(gotJSON, wantJSON) {
+		t.Fatalf("got %s\nwant %s", body, want)
+	}
+}
+
+func TestDemoteUnassignsTasks(t *testing.T) {
+	h := newServer()
+	// t1 in web is assigned to ben, a contributor.
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	code, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	if want := `"assignee":""`; !strings.Contains(body, want) {
+		t.Fatalf("t1 should be unassigned after ben becomes a viewer: %s", body)
+	}
+}
+
+func TestUpdateMembersIsAllOrNothing(t *testing.T) {
+	h := newServer()
+	// dan is valid, hal is not a member: the whole request must be refused.
+	code, _ := do(t, h, "PUT", "/projects/web/members", "ann",
+		`{"roles":{"dan":"contributor","hal":"viewer"}}`)
+	if code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	// dan's role must still be viewer. Read it back with a no-op-free change
+	// that returns the whole member list.
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	if want := `{"userId":"dan","role":"viewer"}`; !strings.Contains(body, want) {
+		t.Fatalf("dan's role changed by a refused request: %s", body)
+	}
+}
