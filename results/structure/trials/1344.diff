+func TestRemoveOrgUserStatus(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben", 204},
+		{"no memberships is fine", "eve", "/orgs/acme/users/hal", 204},
+		{"not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"other org org", "eve", "/orgs/globex/users/gus", 404},
+		{"other org caller", "gus", "/orgs/acme/users/ben", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatal(code)
+	}
+	// ben lost access everywhere in acme, archived projects included.
+	for _, p := range []string{"web", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ben", ""); code != 404 {
+			t.Fatalf("ben still reads %s: %d", p, code)
+		}
+	}
+	// ben's tasks are unassigned; others are untouched.
+	assignee := func(project, id string) string {
+		code, body := do(t, h, "GET", "/projects/"+project+"/tasks/"+id, "eve", "")
+		if code != 200 {
+			t.Fatalf("%s/%s: %d", project, id, code)
+		}
+		var task Task
+		json.Unmarshal([]byte(body), &task)
+		return task.Assignee
+	}
+	for _, c := range []struct{ project, id, want string }{
+		{"web", "t1", ""}, {"legacy", "t5", ""}, {"web", "t2", "cat"}, {"ops", "t4", "cat"},
+	} {
+		if got := assignee(c.project, c.id); got != c.want {
+			t.Fatalf("%s assignee = %q, want %q", c.id, got, c.want)
+		}
+	}
+	// other members keep their roles, and the user itself still exists (404, not 401).
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatal(code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatal(code)
+	}
+}
