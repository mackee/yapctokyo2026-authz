+// ---- operations -----------------------------------------------------------------------
+
+// MembershipTableMoveInput is the input of MembershipTable.Move.
+type MembershipTableMoveInput struct {
+	ToProjectID string
+}
+
+// Move moves a member from the project of the authorization object to another
+// project, keeping the role. The actor must manage both projects. The member's
+// tasks in the source project become unassigned, since they are no longer
+// members there.
+func (mt *MembershipTable) Move(ctx context.Context, db DB, from ProjectAuthz, userID string, in MembershipTableMoveInput) (*Membership, error) {
+	if err := from.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if in.ToProjectID == from.ProjectID() {
+		return nil, deny(ErrInvalid, "member is already in this project")
+	}
+	to, err := NewProjectAuthz(ctx, db, from.Actor(), in.ToProjectID)
+	if err != nil {
+		return nil, err
+	}
+	if err := to.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveMember(ctx, tx, from.ProjectID(), to.ProjectID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if m, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
