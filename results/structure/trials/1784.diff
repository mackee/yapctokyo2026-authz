@@ -0,0 +1,68 @@
+package main
+
+import (
+	"net/http"
+)
+
+// removeUserFromOrg is the offboarding step: it removes uid from every project
+// of the org, archived projects included, and unassigns the tasks uid held in
+// those projects so that the "assignee is a member" model rule keeps holding.
+//
+// Only org admins of the org may call it. A caller from another org, or a
+// target that is not a user of the org, gets 404 (the org is invisible to them).
+func (s *server) removeUserFromOrg(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	orgID := r.PathValue("orgID")
+	targetID := r.PathValue("uid")
+
+	caller, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if caller == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	if caller.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	if !caller.OrgAdmin {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	target, err := findUser(ctx, s.db, targetID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if target == nil || target.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+	if _, err := tx.ExecContext(ctx,
+		`UPDATE tasks SET assignee = '' WHERE assignee = ? AND project_id IN (SELECT id FROM projects WHERE org_id = ?)`,
+		targetID, orgID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if _, err := tx.ExecContext(ctx,
+		`DELETE FROM memberships WHERE user_id = ? AND project_id IN (SELECT id FROM projects WHERE org_id = ?)`,
+		targetID, orgID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	w.WriteHeader(204)
+}
