+++ b/org_test.go
@@ -0,0 +1,89 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+// DELETE /orgs/{orgID}/users/{uid} is the offboarding step: it removes the user
+// from every project of the org (archived ones included) and returns 204.
+// Only org admins of the org may call it.
+
+func TestRemoveUserFromOrgAccess(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin, user with no memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"manager caller is not an org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"viewer caller", "dan", "/orgs/acme/users/ben", 403},
+		{"caller from another org", "gus", "/orgs/acme/users/ben", 404},
+		{"org that is not the caller's", "eve", "/orgs/globex/users/gus", 404},
+		{"user not in the org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed", 404},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveUserFromOrgRemovesEveryMembership(t *testing.T) {
+	s := newServer()
+	if code, body := do(t, s, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("got %d want 204: %s", code, body)
+	}
+
+	// ben is no longer a member of any acme project, archived legacy included.
+	for _, path := range []string{"/projects/web/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, s, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("ben reading %s: got %d want 404", path, code)
+		}
+	}
+	var n int
+	if err := s.(*appHandler).db.QueryRow(`SELECT COUNT(*) FROM memberships WHERE user_id = 'ben'`).Scan(&n); err != nil {
+		t.Fatal(err)
+	}
+	if n != 0 {
+		t.Fatalf("ben still has %d memberships", n)
+	}
+
+	// Tasks ben held are unassigned in their projects (web t1, legacy t5).
+	for _, path := range []string{"/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		_, body := do(t, s, "GET", path, "ann", "")
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.Assignee != "" {
+			t.Fatalf("%s still assigned to %q", path, task.Assignee)
+		}
+	}
+}
+
+func TestRemoveUserFromOrgLeavesOthersAlone(t *testing.T) {
+	s := newServer()
+	if code, body := do(t, s, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("got %d want 204: %s", code, body)
+	}
+
+	// Other acme members keep their roles: cat is still a contributor of web
+	// (may update her own task t2) and ann still manages web (may reassign t1).
+	if code, body := do(t, s, "PATCH", "/projects/web/tasks/t2", "cat", `{"status":"done"}`); code != 200 {
+		t.Fatalf("cat: got %d want 200: %s", code, body)
+	}
+	if code, body := do(t, s, "PATCH", "/projects/web/tasks/t1", "ann", `{"assignee":"cat"}`); code != 200 {
+		t.Fatalf("ann: got %d want 200: %s", code, body)
+	}
+
+	// The globex project and its member are untouched.
+	if code, body := do(t, s, "GET", "/projects/gx/tasks/t6", "gus", ""); code != 200 {
+		t.Fatalf("gus: got %d want 200: %s", code, body)
+	}
+}
