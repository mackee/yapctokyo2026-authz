+func TestUpdateMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager demotes contributor", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 200},
+		{"manager promotes viewer", "ann", "/projects/web/members/dan", `{"role":"manager"}`, 200},
+		{"manager sets same role", "ann", "/projects/web/members/cat", `{"role":"contributor"}`, 200},
+		{"contributor", "ben", "/projects/web/members/cat", `{"role":"viewer"}`, 403},
+		{"viewer", "dan", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"org admin", "eve", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"non member", "hal", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"other org", "gus", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"anonymous", "", "/projects/web/members/ben", `{"role":"viewer"}`, 401},
+		{"unknown user", "zed", "/projects/web/members/ben", `{"role":"viewer"}`, 401},
+		{"missing project", "ann", "/projects/nope/members/ben", `{"role":"viewer"}`, 404},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"target in other project", "ann", "/projects/web/members/gus", `{"role":"viewer"}`, 404},
+		{"unknown role", "ann", "/projects/web/members/ben", `{"role":"owner"}`, 400},
+		{"missing role", "ann", "/projects/web/members/ben", `{}`, 400},
+		{"bad body", "ann", "/projects/web/members/ben", `not json`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRoleResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+	var got memberRoleResponse
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.UserID != "ben" || got.Role != "viewer" {
+		t.Fatalf("got %+v", got)
+	}
+}
+
+func TestUpdateMemberRolePersists(t *testing.T) {
+	h := newServer()
+
+	// dan is a viewer, so cannot create tasks.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 403 {
+		t.Fatalf("before promotion: got %d want 403", code)
+	}
+	if code, _ := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`); code != 200 {
+		t.Fatalf("promote: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("after promotion: got %d want 200", code)
+	}
+
+	// ben is a contributor and can edit his own task t1; after demotion he cannot.
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"doing"}`); code != 200 {
+		t.Fatalf("before demotion: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 403 {
+		t.Fatalf("after demotion: got %d want 403", code)
+	}
+	// Demoted users keep read access as members.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("read after demotion: got %d want 200", code)
+	}
+}
