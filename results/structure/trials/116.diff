+// admitNew is admit for task creation. A user of the project's organization
+// who is not yet a member is admitted with joins set; they become a
+// contributor in the creating transaction.
+func admitNew(s *state, pid, userID string) (Assignee, error) {
+	if userID != "" && s.role(pid, userID) == "" {
+		if !inOrg(s, pid, userID) {
+			return Assignee{}, deny(ErrInvalid, "assignee must be a user of the project's organization")
+		}
+		return Assignee{project: pid, user: userID, joins: true}, nil
+	}
+	return admit(s, pid, userID)
+}
+
+// inOrg reports whether userID is a known user of the organization that owns pid.
+func inOrg(s *state, pid, userID string) bool {
+	u, ok := s.users[userID]
+	return ok && u.org == s.projects[pid].org
+}
+
+// joinAsContributor makes userID a contributor of pid, unless they already
+// have a role there. It runs inside store.tx, so the membership and the task
+// that needs it commit together or not at all.
+func joinAsContributor(s *state, pid, userID string) error {
+	if r := s.role(pid, userID); r != "" {
+		if !isWriterRole(r) {
+			return deny(ErrInvalid, "assignee must be a contributor or manager of the project")
+		}
+		return nil
+	}
+	if !inOrg(s, pid, userID) {
+		return deny(ErrInvalid, "assignee must be a user of the project's organization")
+	}
+	if s.members[pid] == nil {
+		s.members[pid] = map[string]string{}
+	}
+	s.members[pid][userID] = RoleContributor
+	return nil
+}
