+	}{
+		{"contributor assigns non-member", "ben", `{"title":"x","assignee":"hal"}`, 403},
+		{"unknown user", "ann", `{"title":"x","assignee":"hal2"}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			srv := newServer()
+			if code, _ := do(t, srv, "POST", "/projects/web/tasks", c.user, c.body); code != c.want {
+				t.Fatalf("create: got %d want %d", code, c.want)
+			}
+			if code, _ := do(t, srv, "GET", "/projects/web/tasks", "hal", ""); code != 404 {
+				t.Fatalf("hal list after rejected create: got %d want 404", code)
+			}
+		})
+	}
+}
