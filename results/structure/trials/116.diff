+// A manager may assign a task to a user of the organization who is not yet in
+// the project. That user joins as a contributor, atomically with the task.
+func TestCreateAddsNonMemberAsContributor(t *testing.T) {
+	srv := newServer()
+
+	code, body := do(t, srv, "POST", "/projects/web/tasks", "ann", `{"title":"new","assignee":"hal"}`)
+	if code != 201 {
+		t.Fatalf("create: got %d want 201 (%s)", code, body)
+	}
+	var created Task
+	if err := json.Unmarshal([]byte(body), &created); err != nil {
+		t.Fatal(err)
+	}
+	if created.ProjectID != "web" || created.Assignee != "hal" {
+		t.Fatalf("unexpected task %+v", created)
+	}
+
+	// hal is now a project member: can read the project...
+	if code, body := do(t, srv, "GET", "/projects/web/tasks", "hal", ""); code != 200 {
+		t.Fatalf("hal list: got %d want 200 (%s)", code, body)
+	}
+	// ...can edit the task assigned to them as a contributor...
+	if code, body := do(t, srv, "PATCH", "/projects/web/tasks/"+created.ID, "hal", `{"status":"done"}`); code != 200 {
+		t.Fatalf("hal patch own task: got %d want 200 (%s)", code, body)
+	}
+	// ...and can create tasks for themselves.
+	if code, body := do(t, srv, "POST", "/projects/web/tasks", "hal", `{"title":"mine","assignee":"hal"}`); code != 201 {
+		t.Fatalf("hal create: got %d want 201 (%s)", code, body)
+	}
+	// Contributor limits still apply: hal cannot reassign others' tasks.
+	if code, body := do(t, srv, "PATCH", "/projects/web/tasks/t2", "hal", `{"status":"done"}`); code != 403 {
+		t.Fatalf("hal patch others' task: got %d want 403 (%s)", code, body)
+	}
+
+	// Assigning the same user again is now an ordinary member assignment.
+	if code, body := do(t, srv, "POST", "/projects/web/tasks", "ann", `{"title":"again","assignee":"hal"}`); code != 201 {
+		t.Fatalf("second assign: got %d want 201 (%s)", code, body)
+	}
+
+	// The join is visible to other projects: hal is still not a member of ops.
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "hal", ""); code != 404 {
+		t.Fatalf("hal in ops: got %d want 404", code)
+	}
+}
+
+// A rejected create must not leave the assignee behind as a member.
