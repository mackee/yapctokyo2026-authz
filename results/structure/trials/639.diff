+// changeRoleAggregate changes the role of one member of a project.
+type changeRoleAggregate struct {
+	member  *Membership
+	members []*Membership // project members, to keep at least one manager
+	tasks   []*Task       // tasks assigned to the member (viewers cannot hold tasks)
+	role    string
+}
+
+func loadChangeRole(ctx context.Context, tx DB, projectID, userID, role string) (*changeRoleAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	m, err := p.Membership(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	members, err := p.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	tasks, err := m.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &changeRoleAggregate{member: m, members: members, tasks: tasks, role: role}, nil
+}
+
+func (a *changeRoleAggregate) validate() error {
+	if !validRoles[a.role] {
+		return deny(ErrInvalid, "invalid role")
+	}
+	if a.member.Role == RoleManager && a.role != RoleManager {
+		for _, m := range a.members {
+			if m.UserID != a.member.UserID && m.Role == RoleManager {
+				return nil
+			}
+		}
+		return deny(ErrInvalid, "a project must keep at least one manager")
+	}
+	return nil
+}
+
+func (a *changeRoleAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.member.changeRole(ctx, tx, a.role); err != nil {
+		return nil, err
+	}
+	if !isWriterRole(a.role) {
+		for _, t := range a.tasks {
+			if err := t.unassign(ctx, tx); err != nil {
+				return nil, err
+			}
+		}
+	}
+	return a.member, nil
+}
+
