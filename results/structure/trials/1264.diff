+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin, user without projects", "eve", "/orgs/acme/users/hal", 204},
+		{"manager is not admin", "ann", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"other org's admin", "gus", "/orgs/acme/users/ben", 404},
+		{"admin of another org path", "eve", "/orgs/globex/users/gus", 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed", 404},
+		{"user of other org", "eve", "/orgs/acme/users/gus", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("got %d", code)
+	}
+	// ben lost every membership, archived projects included.
+	for _, p := range []string{"web", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ben", ""); code != 404 {
+			t.Fatalf("ben still reads %s: %d", p, code)
+		}
+	}
+	// ben's tasks are unassigned; other members are untouched.
+	for tid, project := range map[string]string{"t1": "web", "t5": "legacy"} {
+		code, body := do(t, h, "GET", "/projects/"+project+"/tasks/"+tid, "eve", "")
+		var task Task
+		if code != 200 || json.Unmarshal([]byte(body), &task) != nil || task.AssigneeID != "" {
+			t.Fatalf("%s: %d %s", tid, code, body)
+		}
+	}
+	code, body := do(t, h, "GET", "/projects/web/tasks/t2", "eve", "")
+	var task Task
+	if code != 200 || json.Unmarshal([]byte(body), &task) != nil || task.AssigneeID != "cat" {
+		t.Fatalf("t2: %d %s", code, body)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat lost access: %d", code)
+	}
+	// removing again: the user is still in the org, nothing left to remove.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("second removal: %d", code)
+	}
+}
