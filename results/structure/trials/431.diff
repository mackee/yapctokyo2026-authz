+// updateMembersAggregate changes the roles of several members of one project,
+// all or nothing: every user must already be a member of the project.
+type updateMembersAggregate struct {
+	project *Project
+	roles   map[string]string // userID -> new role
+	members []*Membership     // one per key of roles, in sorted userID order
+}
+
+func loadUpdateMembers(ctx context.Context, x *Tx, projectID string, roles map[string]string) (*updateMembersAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, x, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &updateMembersAggregate{project: p, roles: roles}
+	for _, uid := range sortedKeys(roles) {
+		m, err := p.Membership(ctx, x, uid)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "user "+uid+" is not a member of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		a.members = append(a.members, m)
+	}
+	return a, nil
+}
+
+func (a *updateMembersAggregate) validate() error { return nil }
+
+func (a *updateMembersAggregate) apply(ctx context.Context, x *Tx) error {
+	for _, m := range a.members {
+		if err := m.setRole(ctx, x, a.roles[m.UserID]); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
