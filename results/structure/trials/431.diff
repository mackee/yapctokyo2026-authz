+// Member is the JSON shape of a project member in the members API.
+type Member struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// updateMembersRequest maps user IDs to their new project roles.
+type updateMembersRequest struct {
+	Roles map[string]string `json:"roles"`
+}
+
+// updateMembers changes several members' roles at once, all or nothing, and
+// returns the project's members after the change.
+func updateMembers(ctx tanukirpc.Context[*projectRegistry], req updateMembersRequest) ([]Member, error) {
+	reg := ctx.Registry()
+	ms, err := model.NewMembershipTable().UpdateRoles(ctx, reg.db, reg.authz, model.MembershipTableUpdateRolesInput{Roles: req.Roles})
+	if err != nil {
+		return nil, err
+	}
+	out := make([]Member, 0, len(ms))
+	for _, m := range ms {
+		out = append(out, Member{UserID: m.UserID, Role: m.Role})
+	}
+	return out, nil
+}
