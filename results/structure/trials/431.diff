-// MembershipTable reads the memberships table.
+// MembershipTable reads the memberships table. UpdateRoles is its API
+// operation: it takes the database, the authorization object of the project and
+// an input, asks the authorization object whether the actor may perform it, then
+// runs its aggregate (aggregate.go) in one transaction.
 type MembershipTable struct{}
 
 // NewMembershipTable returns the memberships table.
 func NewMembershipTable() *MembershipTable { return &MembershipTable{} }
 
+// MembershipTableUpdateRolesInput is the input of MembershipTable.UpdateRoles:
+// the new role of each member, keyed by user ID.
+type MembershipTableUpdateRolesInput struct {
+	Roles map[string]string
+}
+
+// UpdateRoles changes the roles of several members of the project in one
+// all-or-nothing transaction. It returns the project's members after the change,
+// ordered by user ID. If any user is not a member, or any role is not a valid
+// project role, nothing changes and an error is returned.
+func (mt *MembershipTable) UpdateRoles(ctx context.Context, db DB, authz ProjectAuthz, in MembershipTableUpdateRolesInput) ([]*Membership, error) {
+	if len(in.Roles) == 0 {
+		return nil, deny(ErrInvalid, "roles must not be empty")
+	}
+	for _, role := range in.Roles {
+		if !validRoles[role] {
+			return nil, deny(ErrInvalid, "role must be manager, contributor or viewer")
+		}
+	}
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var out []*Membership
+	if err := db.update(ctx, func(x *Tx) error {
+		agg, err := loadUpdateMembers(ctx, x, authz.ProjectID(), in.Roles)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if err := agg.apply(ctx, x); err != nil {
+			return err
+		}
+		out, err = mt.ListByProject(ctx, x, authz.ProjectID())
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
+
+var validRoles = map[string]bool{RoleManager: true, RoleContributor: true, RoleViewer: true}
+
+// sortedKeys returns the keys of m in ascending order, so that an operation
+// visits its entries, and reports the first error, deterministically.
+func sortedKeys(m map[string]string) []string {
+	keys := make([]string, 0, len(m))
+	for k := range m {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	return keys
+}
+
 // Find returns the membership of the user in the project, or ErrNoRows.
