diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..7a179d9
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,100 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestChangeMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager promotes viewer", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"manager makes manager", "ann", "/projects/web/members/dan", `{"role":"manager"}`, 200},
+		{"manager demotes other manager", "ann", "/projects/web/members/ivy", `{"role":"viewer"}`, 200},
+		{"manager demotes self when another manager exists", "ann", "/projects/web/members/ann", `{"role":"contributor"}`, 200},
+		{"same role is ok", "ann", "/projects/web/members/dan", `{"role":"viewer"}`, 200},
+		{"contributor", "ben", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"viewer", "dan", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"org admin", "eve", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"non member", "hal", "/projects/web/members/dan", `{"role":"contributor"}`, 404},
+		{"other org", "gus", "/projects/web/members/dan", `{"role":"contributor"}`, 404},
+		{"anonymous", "", "/projects/web/members/dan", `{"role":"contributor"}`, 401},
+		{"unknown user", "zed", "/projects/web/members/dan", `{"role":"contributor"}`, 401},
+		{"target is not a member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"target does not exist", "ann", "/projects/web/members/zed", `{"role":"viewer"}`, 404},
+		{"target in other org", "ann", "/projects/web/members/gus", `{"role":"viewer"}`, 404},
+		{"unknown project", "ann", "/projects/nope/members/dan", `{"role":"viewer"}`, 404},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"invalid role", "ann", "/projects/web/members/dan", `{"role":"owner"}`, 400},
+		{"missing role", "ann", "/projects/web/members/dan", `{}`, 400},
+		{"bad json", "ann", "/projects/web/members/dan", `{`, 400},
+		{"invalid role is 400 before access check", "dan", "/projects/web/members/dan", `{"role":"owner"}`, 400},
+		{"demote member with assigned tasks", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 400},
+		{"demote last manager", "ivy", "/projects/ops/members/ivy", `{"role":"contributor"}`, 400},
+		{"keep assigned tasks as contributor", "ann", "/projects/web/members/ben", `{"role":"manager"}`, 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestChangeMemberRoleResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err, body)
+	}
+	if len(got) != 2 || got["userId"] != "dan" || got["role"] != "contributor" {
+		t.Fatalf("unexpected body %s", body)
+	}
+}
+
+func TestChangeMemberRoleTakesEffect(t *testing.T) {
+	h := newServer()
+
+	// dan is a viewer: cannot create tasks.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 403 {
+		t.Fatalf("before promotion: got %d want 403", code)
+	}
+	if code, _ := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`); code != 200 {
+		t.Fatalf("promote: got %d", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x","assignee":"dan"}`); code != 200 {
+		t.Fatalf("after promotion: got %d want 200", code)
+	}
+
+	// Demoted manager loses manager rights.
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ivy", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote: got %d", code)
+	}
+	if code, _ := do(t, h, "DELETE", "/projects/web/tasks/t3", "ivy", ""); code != 403 {
+		t.Fatalf("after demotion: got %d want 403", code)
+	}
+	if code, _ := do(t, h, "PUT", "/projects/web/members/dan", "ivy", `{"role":"viewer"}`); code != 403 {
+		t.Fatalf("demoted manager changing roles: got %d want 403", code)
+	}
+}
+
+func TestChangeMemberRoleOtherProjectUntouched(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ann", "ann", `{"role":"contributor"}`); code != 200 {
+		t.Fatal(code)
+	}
+	// ann's role in ops (viewer) and legacy (manager) is unchanged.
+	if code, _ := do(t, h, "POST", "/projects/ops/tasks", "ann", `{"title":"x"}`); code != 403 {
+		t.Fatalf("ops: got %d want 403", code)
+	}
+	if code, _ := do(t, h, "PUT", "/projects/legacy/members/ben", "ann", `{"role":"viewer"}`); code != 409 {
+		t.Fatalf("legacy: got %d want 409 (still manager, archived)", code)
+	}
+}
