+
+// ---- operations -----------------------------------------------------------------------
+
+// Freeze makes every member of the project a viewer, so nobody can change its
+// tasks any more. It runs in one transaction, all or nothing, and returns the
+// members after the change (ordered by user ID). The authorization object
+// decides whether the actor may do it (CanFreeze).
+func (*ProjectTable) Freeze(ctx context.Context, db DB, authz ProjectAuthz) ([]*Membership, error) {
+	if err := authz.CanFreeze(); err != nil {
+		return nil, err
+	}
+	var members []*Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadFreezeProject(ctx, tx, authz.ProjectID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		members, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return members, nil
+}
