+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"other manager", "ivy", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"archived", "ann", "legacy", 409},
+		{"missing project", "ann", "nope", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResponse(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+	var got []member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("bad body %q: %v", body, err)
+	}
+	want := []member{
+		{"ann", "viewer"}, {"ben", "viewer"}, {"cat", "viewer"}, {"dan", "viewer"}, {"ivy", "viewer"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("member %d: got %v want %v", i, got[i], want[i])
+		}
+	}
+	// Freezing web must not touch ops: cat is still a contributor there.
+	if code, body := do(t, h, "POST", "/projects/ops/tasks", "cat", `{"title":"x"}`); code != 200 {
+		t.Fatalf("ops write after web freeze: got %d want 200: %s", code, body)
+	}
+}
+
+func TestFreezeBlocksTaskWrites(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d want 200: %s", code, body)
+	}
+	cases := []struct {
+		name, user, method, path, body string
+		want                           int
+	}{
+		{"manager create", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"former contributor create", "ben", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"former contributor own update", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`, 403},
+		{"former manager update", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"former manager reassign", "ivy", "PATCH", "/projects/web/tasks/t2", `{"assignee":"ben"}`, 403},
+		{"former manager delete", "ann", "DELETE", "/projects/web/tasks/t1", "", 403},
+		{"former manager cannot refreeze", "ann", "POST", "/projects/web/freeze", "", 403},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, h, c.method, c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+		})
+	}
+	// Reads still work, and the task is unchanged.
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 || !strings.Contains(body, `"status":"open"`) {
+		t.Fatalf("read after freeze: %d %s", code, body)
+	}
+}
