index 0000000..fcb67e9
--- /dev/null
+++ b/internal/capability/comment.go
@@ -0,0 +1,108 @@
+package capability
+
+// Comments are attached to tasks. Access rules:
+//
+//   - reading a comment, or the comments of a task, follows the task read rule
+//     (members and org admins; otherwise 404)
+//   - adding a comment needs any project role, viewers included (non-members
+//     are 404 because the project is not readable to them; org admins without a
+//     role are 403); archived projects reject it with 409
+
+// CommentTask may add comments to one task (and read them, via ReadTask).
+type CommentTask interface {
+	ReadTask
+	// AddComment appends a comment authored by the actor. An empty body is 400.
+	AddComment(body string) (CommentView, error)
+}
+
+// ReadComment may read one comment.
+type ReadComment interface {
+	View() CommentView
+}
+
+// Comment acquires the capability to comment on this task.
+func (s *taskScope) Comment() (CommentTask, error) {
+	err := s.ps.as.a.st.read(func(st *state) error {
+		p, r, _, err := locate(st, s.ps.as.actor, s.ps.pid, s.tid)
+		if err != nil {
+			return err
+		}
+		if r == "" {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if p.archived {
+			return deny(ErrArchived, "project is archived")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &commentTask{readTask{ts: s}}, nil
+}
+
+type commentTask struct {
+	readTask
+}
+
+func (t *commentTask) AddComment(body string) (CommentView, error) {
+	if body == "" {
+		return CommentView{}, deny(ErrInvalid, "comment body must not be empty")
+	}
+	var v CommentView
+	err := t.ts.ps.as.a.st.tx(func(s *state) error {
+		// Re-check under the write lock: the task may have been deleted since
+		// the capability was acquired.
+		tk, ok := s.tasks[t.ts.tid]
+		if !ok || tk.project != t.ts.ps.pid {
+			return deny(ErrNotFound, "not found")
+		}
+		id, seq := s.newCommentID()
+		c := comment{
+			id:      id,
+			seq:     seq,
+			task:    t.ts.tid,
+			project: t.ts.ps.pid,
+			author:  t.ts.ps.as.actor.id,
+			body:    body,
+		}
+		s.comments[c.id] = c
+		v = c.view()
+		return nil
+	})
+	return v, err
+}
+
+// commentScope is bound to one actor and one comment ID.
+type commentScope struct {
+	as  *actorScope
+	cid string
+}
+
+// Read applies the task read rule through the comment's project: the project
+// must be readable by the actor, otherwise 404 (as is an unknown comment).
+func (s *commentScope) Read() (ReadComment, error) {
+	var v CommentView
+	err := s.as.a.st.read(func(st *state) error {
+		c, ok := st.comments[s.cid]
+		if !ok {
+			return deny(ErrNotFound, "not found")
+		}
+		if _, _, err := readable(st, s.as.actor, c.project); err != nil {
+			return err
+		}
+		v = c.view()
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &readComment{v: v}, nil
+}
+
+// readComment holds the view captured when the capability was acquired.
+type readComment struct {
+	v CommentView
+}
+
+func (c *readComment) View() CommentView { return c.v }
