 func NewProjectTable() *ProjectTable { return &ProjectTable{} }
 
+// Freeze makes every member of the project (managers included) a viewer, so
+// nobody can change its tasks any more, and returns the memberships after the
+// change, ordered by user ID. Assignees are cleared with it: an assignee must
+// be a contributor or manager.
+func (*ProjectTable) Freeze(ctx context.Context, db DB, authz ProjectAuthz) ([]*Membership, error) {
+	if err := authz.CanFreeze(); err != nil {
+		return nil, err
+	}
+	var ms []*Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadFreezeProject(ctx, tx, authz.ProjectID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		ms, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return ms, nil
+}
