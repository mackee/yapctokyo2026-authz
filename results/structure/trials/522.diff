+// MembershipTableMoveInput is the input of MembershipTable.Move.
+type MembershipTableMoveInput struct {
+	ToProjectID string
+}
+
+// Move moves the user from the authorized project to another project of the
+// same organization, keeping the role. The actor must be a manager of both
+// projects. The result is the membership in the destination project.
+func (mt *MembershipTable) Move(ctx context.Context, db DB, authz ProjectAuthz, userID string, in MembershipTableMoveInput) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if in.ToProjectID == "" || in.ToProjectID == authz.ProjectID() {
+		return nil, deny(ErrInvalid, "toProjectId must name another project")
+	}
+	dstAuthz, err := NewProjectAuthz(ctx, db, authz.Actor(), in.ToProjectID)
+	if err != nil {
+		return nil, err
+	}
+	if err := dstAuthz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var to *Membership
+	if err := db.update(ctx, func(x *Tx) error {
+		agg, err := loadMoveMember(ctx, x, authz.ProjectID(), userID, in.ToProjectID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		to, err = agg.apply(ctx, x)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return to, nil
+}
+
