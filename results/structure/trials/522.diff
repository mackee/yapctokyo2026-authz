+// moveMemberAggregate moves one member from the source project to the
+// destination project, keeping the role. Tasks the member held in the source
+// project are unassigned, because an assignee must be a member of the task's
+// project.
+type moveMemberAggregate struct {
+	from  *Membership // the member in the source project
+	dst   *Project
+	inDst bool // the user is already a member of the destination project
+}
+
+func loadMoveMember(ctx context.Context, x *Tx, srcProjectID, userID, dstProjectID string) (*moveMemberAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, x, srcProjectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	dst, err := NewProjectTable().Find(ctx, x, dstProjectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveMemberAggregate{from: m, dst: dst}
+	if _, err := dst.Membership(ctx, x, userID); err == nil {
+		a.inDst = true
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.inDst {
+		return deny(ErrConflict, "user is already a member of the destination project")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, x *Tx) (*Membership, error) {
+	assigned, err := a.from.AssignedTasks(ctx, x)
+	if err != nil {
+		return nil, err
+	}
+	for _, t := range assigned {
+		if err := t.unassign(ctx, x); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.from.destroy(ctx, x); err != nil {
+		return nil, err
+	}
+	to := &Membership{ProjectID: a.dst.ID, UserID: a.from.UserID, Role: a.from.Role}
+	if err := to.save(ctx, x); err != nil {
+		return nil, err
+	}
+	return to, nil
+}
+
