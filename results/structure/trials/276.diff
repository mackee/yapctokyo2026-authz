+func TestMoveMember(t *testing.T) {
+	const toOps = `{"toProjectId":"ops"}`
+	cases := []struct {
+		name, user, from, uid, body string
+		want                        int
+	}{
+		{"manager of both", "ivy", "web", "ben", toOps, 200},
+		{"viewer role kept", "ivy", "web", "dan", toOps, 200},
+		{"manager of source only", "ann", "web", "ben", toOps, 403},
+		{"contributor", "ben", "web", "cat", toOps, 403},
+		{"org admin", "eve", "web", "ben", toOps, 403},
+		{"non member", "hal", "web", "ben", toOps, 404},
+		{"other org", "gus", "web", "ben", toOps, 404},
+		{"anonymous", "", "web", "ben", toOps, 401},
+		{"target not a member", "ivy", "web", "hal", toOps, 404},
+		{"already in destination", "ivy", "web", "cat", toOps, 400},
+		{"same project", "ivy", "web", "ben", `{"toProjectId":"web"}`, 400},
+		{"missing destination", "ivy", "web", "ben", `{}`, 400},
+		{"bad body", "ivy", "web", "ben", `nope`, 400},
+		{"unknown destination", "ivy", "web", "ben", `{"toProjectId":"zzz"}`, 404},
+		{"other org destination", "ivy", "web", "ben", `{"toProjectId":"gx"}`, 404},
+		{"archived source", "ann", "legacy", "ben", toOps, 409},
+		{"archived destination", "ann", "web", "ben", `{"toProjectId":"legacy"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.from+"/members/"+c.uid+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveMemberEffects(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got map[string]string
+	json.Unmarshal([]byte(body), &got)
+	want := map[string]string{"userId": "ben", "projectId": "ops", "role": "contributor"}
+	if len(got) != len(want) || got["userId"] != "ben" || got["projectId"] != "ops" || got["role"] != "contributor" {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben still reads web: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben cannot read ops: %d", code)
+	}
+	// ben's task in web is unassigned, not left dangling.
+	_, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" {
+		t.Fatalf("t1 still assigned to %q", task.Assignee)
+	}
+	// ben can now be assigned in ops, and moving again fails (no longer in web).
+	if code, _ := do(t, h, "POST", "/projects/ops/tasks", "ivy", `{"title":"x","assignee":"ben"}`); code != 201 {
+		t.Fatalf("assign ben in ops: %d", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`); code != 404 {
+		t.Fatalf("second move: %d", code)
+	}
+}
