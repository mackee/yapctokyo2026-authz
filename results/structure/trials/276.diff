 // ---- project capabilities ----------------------------------------------------
 
+// MemberView is the public representation of a project membership.
+type MemberView struct {
+	UserID    string `json:"userId"`
+	ProjectID string `json:"projectId"`
+	Role      string `json:"role"`
+}
+
+// ManageProject is the manager-only capability for one project.
+type ManageProject interface {
+	WriteProject
+	// MoveMember removes the user from this project and adds them, with the
+	// same role, to the project that "to" manages. Both capabilities must come
+	// from the same actor, so the caller must manage both projects.
+	//
+	// Tasks in this project assigned to the user become unassigned (an
+	// assignee must be a writer of the task's project). The user must be a
+	// member here (404), must not already be a member of the destination
+	// (400), and the destination must be a different project (400).
+	MoveMember(userID string, to ManageProject) (MemberView, error)
+}
+
+type manageProject struct{ writeProject }
+
+func (p *manageProject) MoveMember(userID string, to ManageProject) (MemberView, error) {
+	dst, ok := to.(*manageProject)
+	if !ok || dst.ps.as != p.ps.as {
+		return MemberView{}, deny(ErrInvalid, "destination was not acquired by the same actor")
+	}
+	from, target := p.ps.pid, dst.ps.pid
+	if from == target {
+		return MemberView{}, deny(ErrInvalid, "destination must be a different project")
+	}
+	var v MemberView
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		role := s.role(from, userID)
+		if role == "" {
+			return deny(ErrNotFound, "not found")
+		}
+		if s.role(target, userID) != "" {
+			return deny(ErrInvalid, "user is already a member of the destination project")
+		}
+		delete(s.members[from], userID)
+		if s.members[target] == nil {
+			s.members[target] = map[string]string{}
+		}
+		s.members[target][userID] = role
+		for id, t := range s.tasks {
+			if t.project == from && t.assignee.user == userID {
+				t.assignee = Assignee{project: from}
+				s.tasks[id] = t
+			}
+		}
+		v = MemberView{UserID: userID, ProjectID: target, Role: role}
+		return nil
+	})
+	return v, err
+}
