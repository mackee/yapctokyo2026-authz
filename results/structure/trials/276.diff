+type moveRequest struct {
+	ToProjectID string `json:"toProjectId"`
+}
+
+func moveMember(ctx tanukirpc.Context[*projectRegistry], _ struct{}) (*capability.MemberView, error) {
+	scope := ctx.Registry().scope
+	from, err := scope.Manage()
+	if err != nil {
+		return nil, err
+	}
+	var req moveRequest
+	if err := decodeBody(ctx.Request(), &req); err != nil || req.ToProjectID == "" {
+		return nil, errInvalidBody
+	}
+	to, err := scope.Actor().Project(req.ToProjectID).Manage()
+	if err != nil {
+		return nil, err
+	}
+	v, err := from.MoveMember(chi.URLParam(ctx.Request(), "uid"), to)
+	if err != nil {
+		return nil, err
+	}
+	return &v, nil
+}
