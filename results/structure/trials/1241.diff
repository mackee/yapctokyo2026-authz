+// updateRolesAggregate changes the roles of several members of one project.
+type updateRolesAggregate struct {
+	project *Project
+	changes []roleChange // ordered by user ID
+}
+
+type roleChange struct {
+	member   *Membership
+	role     string
+	assigned []*Task // the member's tasks in the project, loaded when the new role is viewer
+}
+
+func loadUpdateRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*updateRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &updateRolesAggregate{project: p}
+	for _, userID := range slices.Sorted(maps.Keys(roles)) {
+		m, err := p.Membership(ctx, tx, userID)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, userID+" is not a member of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		c := roleChange{member: m, role: roles[userID]}
+		if c.role == RoleViewer {
+			if c.assigned, err = m.AssignedTasks(ctx, tx); err != nil {
+				return nil, err
+			}
+		}
+		a.changes = append(a.changes, c)
+	}
+	return a, nil
+}
+
+func (a *updateRolesAggregate) validate() error {
+	for _, c := range a.changes {
+		if !isValidRole(c.role) {
+			return deny(ErrInvalid, "role must be manager, contributor or viewer")
+		}
+	}
+	return nil
+}
+
+// apply changes the roles and returns the project's members. A member who
+// becomes a viewer is unassigned from their tasks in the project, since an
+// assignee must be a contributor or manager.
+func (a *updateRolesAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for _, c := range a.changes {
+		for _, t := range c.assigned {
+			if err := t.unassign(ctx, tx); err != nil {
+				return nil, err
+			}
+		}
+		if err := c.member.setRole(ctx, tx, c.role); err != nil {
+			return nil, err
+		}
+	}
+	return NewMembershipTable().ListByProject(ctx, tx, a.project.ID)
+}
+
