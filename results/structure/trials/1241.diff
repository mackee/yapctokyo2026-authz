+// memberRole is the JSON shape of a project member.
+type memberRole struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+type updateMembersRequest struct {
+	Roles map[string]string `json:"roles" validate:"required,min=1,dive,keys,required,endkeys,oneof=manager contributor viewer"`
+}
+
+// updateMembers changes several members' roles at once and returns the
+// project's members after the change.
+func updateMembers(ctx tanukirpc.Context[*projectRegistry], req updateMembersRequest) ([]memberRole, error) {
+	reg := ctx.Registry()
+	members, err := model.NewMembershipTable().UpdateRoles(ctx, reg.db, reg.authz, model.MembershipTableUpdateRolesInput{Roles: req.Roles})
+	if err != nil {
+		return nil, err
+	}
+	out := make([]memberRole, 0, len(members))
+	for _, m := range members {
+		out = append(out, memberRole{UserID: m.UserID, Role: m.Role})
+	}
+	return out, nil
+}
