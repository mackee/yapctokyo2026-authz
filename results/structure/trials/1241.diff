+func TestUpdateMembers(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager", "ann", "web", `{"roles":{"cat":"viewer","ivy":"contributor"}}`, 200},
+		{"manager demotes self", "ann", "web", `{"roles":{"ann":"contributor"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"cat":"viewer"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"cat":"viewer"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"cat":"viewer"}}`, 401},
+		{"unknown user", "zed", "web", `{"roles":{"cat":"viewer"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"bad role", "ann", "web", `{"roles":{"cat":"owner"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"empty user id", "ann", "web", `{"roles":{"":"viewer"}}`, 400},
+		{"non member target", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"other org target", "ann", "web", `{"roles":{"gus":"viewer"}}`, 400},
+		{"bad json", "ann", "web", `{"roles":`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMembersReturnsProjectMembers(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []memberRole
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []memberRole{
+		{UserID: "ann", Role: "manager"},
+		{UserID: "ben", Role: "viewer"},
+		{UserID: "cat", Role: "contributor"},
+		{UserID: "dan", Role: "contributor"},
+		{UserID: "ivy", Role: "manager"},
+	}
+	if !slices.Equal(got, want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	if !strings.Contains(body, `{"userId":"ben","role":"viewer"}`) {
+		t.Fatalf("unexpected JSON shape: %s", body)
+	}
+}
+
+func TestUpdateMembersUnassignsDemotedViewer(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer"}}`); code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	// t1 was assigned to ben; it is now unassigned and keeps its other fields.
+	code, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "" || task.Title != "Fix header" || task.Status != "open" {
+		t.Fatalf("unexpected task after demotion: %+v", task)
+	}
+	// t2 is assigned to cat, who was not changed.
+	_, body = do(t, srv, "GET", "/projects/web/tasks/t2", "ann", "")
+	if !strings.Contains(body, `"assignee":"cat"`) {
+		t.Fatalf("cat's task changed: %s", body)
+	}
+}
+
+func TestUpdateMembersIsAllOrNothing(t *testing.T) {
+	srv := newServer()
+	// hal is not a member of web, so the whole request is rejected.
+	if code, _ := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"cat":"viewer","hal":"viewer","ben":"viewer"}}`); code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	// Nothing changed: cat is still a contributor and still assigned t2, ben still has t1.
+	code, body := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"ann":"manager"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	if !strings.Contains(body, `{"userId":"cat","role":"contributor"}`) || !strings.Contains(body, `{"userId":"ben","role":"contributor"}`) {
+		t.Fatalf("roles changed by a rejected request: %s", body)
+	}
+	if _, body := do(t, srv, "GET", "/projects/web/tasks/t2", "ann", ""); !strings.Contains(body, `"assignee":"cat"`) {
+		t.Fatalf("task changed by a rejected request: %s", body)
+	}
+	if _, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ann", ""); !strings.Contains(body, `"assignee":"ben"`) {
+		t.Fatalf("task changed by a rejected request: %s", body)
+	}
+}
