+// memberRoleJSON is one entry of the freeze response.
+type memberRoleJSON struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func freezeProject(ctx tanukirpc.Context[*projectRegistry], _ struct{}) ([]memberRoleJSON, error) {
+	reg := ctx.Registry()
+	members, err := model.NewProjectTable().Freeze(ctx, reg.db, reg.authz)
+	if err != nil {
+		return nil, err
+	}
+	out := make([]memberRoleJSON, 0, len(members))
+	for _, m := range members {
+		out = append(out, memberRoleJSON{UserID: m.UserID, Role: m.Role})
+	}
+	return out, nil
+}
