@@ -0,0 +1,136 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"testing"
+)
+
+// memberRole is one entry of the POST /projects/{pid}/freeze response.
+type memberRole struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func TestFreezeAuthorization(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown project", "ann", "nope", 404},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeDemotesEveryMember(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got []memberRole
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("response is not a member list: %v: %s", err, body)
+	}
+	// web's members, ordered by user ID; the manager ann and ivy are demoted too.
+	want := []memberRole{
+		{"ann", "viewer"}, {"ben", "viewer"}, {"cat", "viewer"}, {"dan", "viewer"}, {"ivy", "viewer"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %d members, want %d: %s", len(got), len(want), body)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("member %d: got %+v want %+v", i, got[i], want[i])
+		}
+	}
+}
+
+func TestFreezeLeavesOtherProjectsAlone(t *testing.T) {
+	srv := newServer()
+	do(t, srv, "POST", "/projects/web/freeze", "ann", "")
+
+	// ivy is a manager of ops, which was not frozen.
+	if code, _ := do(t, srv, "POST", "/projects/ops/tasks", "ivy", `{"title":"x"}`); code != 200 {
+		t.Fatalf("manager of an unfrozen project: got %d want 200", code)
+	}
+	// cat is a contributor of ops and keeps that role.
+	if code, _ := do(t, srv, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`); code != 200 {
+		t.Fatalf("contributor of an unfrozen project: got %d want 200", code)
+	}
+}
+
+func TestFreezeBlocksTaskChanges(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d want 200: %s", code, body)
+	}
+	cases := []struct {
+		name, user, method, path, body string
+	}{
+		{"contributor edits own former task", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"former manager edits", "ivy", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"former manager renames unassigned", "ann", "PATCH", "/projects/web/tasks/t3", `{"title":"y"}`},
+		{"former manager deletes", "ivy", "DELETE", "/projects/web/tasks/t2", ""},
+		{"former manager creates", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			if code, _ := do(t, srv, c.method, c.path, c.user, c.body); code != 403 {
+				t.Fatalf("got %d want 403", code)
+			}
+		})
+	}
+}
+
+func TestFreezeUnassignsTasks(t *testing.T) {
+	srv := newServer()
+	do(t, srv, "POST", "/projects/web/freeze", "ann", "")
+
+	// Members are no longer contributors or managers, so the tasks they were
+	// assigned to are unassigned (the model rule on assignees must still hold;
+	// do() checks it after the freeze request).
+	_, body := do(t, srv, "GET", "/projects/web/tasks", "ann", "")
+	var tasks []Task
+	if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+		t.Fatal(err)
+	}
+	for _, task := range tasks {
+		if task.AssigneeID != "" {
+			t.Fatalf("task %s is still assigned to %s", task.ID, task.AssigneeID)
+		}
+	}
+
+	// Other projects keep their assignments.
+	_, body = do(t, srv, "GET", "/projects/ops/tasks/t4", "ivy", "")
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "cat" {
+		t.Fatalf("task t4 in ops: assignee %q, want cat", task.AssigneeID)
+	}
+}
+
+func TestFreezeTwiceIsForbidden(t *testing.T) {
+	srv := newServer()
+	do(t, srv, "POST", "/projects/web/freeze", "ann", "")
+	// ann is a viewer after the first freeze.
+	if code, _ := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != http.StatusForbidden {
+		t.Fatalf("second freeze: got %d want 403", code)
+	}
+}
