diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..c40d31c
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,76 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager removes contributor", "ann", "/projects/web/members/cat", 204},
+		{"manager removes viewer", "ann", "/projects/web/members/dan", 204},
+		{"contributor", "ben", "/projects/web/members/cat", 403},
+		{"viewer", "dan", "/projects/web/members/cat", 403},
+		{"org admin", "eve", "/projects/web/members/cat", 403},
+		{"non member", "hal", "/projects/web/members/cat", 404},
+		{"other org", "gus", "/projects/web/members/cat", 404},
+		{"anonymous", "", "/projects/web/members/cat", 401},
+		{"unknown user", "zed", "/projects/web/members/cat", 401},
+		{"target is not a member", "ann", "/projects/web/members/hal", 404},
+		{"target is a member of another project", "ivy", "/projects/ops/members/ben", 404},
+		{"archived", "ann", "/projects/legacy/members/ben", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveMemberTakesAwayAccess(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "DELETE", "/projects/web/members/ben", "ann", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("removed member lists tasks: got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ann", ""); code != 200 {
+		t.Fatalf("manager lists tasks: got %d want 200", code)
+	}
+}
+
+func TestRemoveMemberUnassignsTheirTasks(t *testing.T) {
+	srv := newServer()
+	// t1 in web is assigned to ben; t2 is assigned to cat and must stay so.
+	if code, _ := do(t, srv, "DELETE", "/projects/web/members/ben", "ann", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+	code, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("get t1: got %d want 200", code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "" {
+		t.Fatalf("t1 still assigned to %q after its assignee left", task.AssigneeID)
+	}
+	code, body = do(t, srv, "GET", "/projects/web/tasks/t2", "ann", "")
+	if code != 200 {
+		t.Fatalf("get t2: got %d want 200", code)
+	}
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "cat" {
+		t.Fatalf("t2 assignee changed to %q, want cat", task.AssigneeID)
+	}
+}
