@@ -0,0 +1,74 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestTransferAuth(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin transfers", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 200},
+		{"non admin", "ann", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 403},
+		{"anonymous", "", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 401},
+		{"admin of other org path", "eve", "/orgs/globex/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"user in another org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"globex"}`, 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"unknown target org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"nope"}`, 400},
+		{"same org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"acme"}`, 400},
+		{"missing body field", "eve", "/orgs/acme/users/ben/transfer", `{}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d (%s)", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestTransferEffects(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got struct{ ID, OrgID string }
+	if err := json.Unmarshal([]byte(body), &got); err != nil || got.ID != "ben" || got.OrgID != "globex" {
+		t.Fatalf("bad response %s", body)
+	}
+
+	// ben is now a globex user: no access to his old acme projects.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("old project still readable: %d", code)
+	}
+	// his old memberships ended and his tasks are unassigned.
+	_, tb := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(tb), &task)
+	if task.AssigneeID != "" {
+		t.Fatalf("t1 still assigned to %q", task.AssigneeID)
+	}
+	// ben cannot be re-assigned in web any more.
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ann", `{"assignee":"ben"}`); code != 400 {
+		t.Fatalf("assigning transferred user: %d", code)
+	}
+	// acme admin can no longer transfer him.
+	if code, _ := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 404 {
+		t.Fatalf("second transfer: %d", code)
+	}
+}
+
+func TestTransferDropsOrgAdmin(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatal(code, body)
+	}
+	// eve must not carry admin rights into globex.
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "eve", ""); code != 404 {
+		t.Fatalf("admin flag carried over: %d", code)
+	}
+}
