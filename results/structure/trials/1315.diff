+func TestTransfer(t *testing.T) {
+	cases := []struct {
+		name, user, org, uid, body string
+		want                       int
+	}{
+		{"org admin moves user", "eve", "acme", "ben", `{"toOrgId":"globex"}`, 200},
+		{"manager is not org admin", "ann", "acme", "ben", `{"toOrgId":"globex"}`, 403},
+		{"contributor is not org admin", "ben", "acme", "cat", `{"toOrgId":"globex"}`, 403},
+		{"caller in other org", "gus", "acme", "ben", `{"toOrgId":"globex"}`, 404},
+		{"path org is not caller's org", "eve", "globex", "gus", `{"toOrgId":"acme"}`, 404},
+		{"target in other org", "eve", "acme", "gus", `{"toOrgId":"acme"}`, 404},
+		{"unknown target", "eve", "acme", "zed", `{"toOrgId":"globex"}`, 404},
+		{"anonymous", "", "acme", "ben", `{"toOrgId":"globex"}`, 401},
+		{"unknown caller", "zed", "acme", "ben", `{"toOrgId":"globex"}`, 401},
+		{"unknown target org", "eve", "acme", "ben", `{"toOrgId":"ghost"}`, 400},
+		{"missing toOrgId", "eve", "acme", "ben", `{}`, 400},
+		{"invalid body", "eve", "acme", "ben", `nope`, 400},
+		{"same org", "eve", "acme", "ben", `{"toOrgId":"acme"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/orgs/"+c.org+"/users/"+c.uid+"/transfer", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+	var got transferResponse
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.ID != "ben" || got.OrgID != "globex" {
+		t.Fatalf("got %+v", got)
+	}
+}
+
+func TestTransferEffects(t *testing.T) {
+	db, err := openSeededDB()
+	if err != nil {
+		t.Fatal(err)
+	}
+	s := &server{db: db}
+	h := s.routes()
+
+	if code, _ := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: got %d want 200", code)
+	}
+
+	// Ben's memberships in the old org are gone, and ben is no longer a member of anything.
+	var n int
+	if err := db.QueryRow(`SELECT COUNT(*) FROM memberships WHERE user_id = 'ben'`).Scan(&n); err != nil {
+		t.Fatal(err)
+	}
+	if n != 0 {
+		t.Fatalf("ben still has %d memberships", n)
+	}
+
+	// Tasks ben held are unassigned; other tasks keep their assignee.
+	code, body := do(t, h, "GET", "/projects/web/tasks", "ann", "")
+	if code != 200 {
+		t.Fatalf("list web: got %d", code)
+	}
+	var tasks []Task
+	if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+		t.Fatal(err)
+	}
+	for _, task := range tasks {
+		switch task.ID {
+		case "t1":
+			if task.Assignee != "" {
+				t.Fatalf("t1 still assigned to %q", task.Assignee)
+			}
+		case "t2":
+			if task.Assignee != "cat" {
+				t.Fatalf("t2 assignee = %q, want cat", task.Assignee)
+			}
+		}
+	}
+
+	// Ben is now in globex and can no longer see acme projects.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben list web: got %d want 404", code)
+	}
+	// Ben's own task in legacy is unassigned too.
+	if err := db.QueryRow(`SELECT COUNT(*) FROM tasks WHERE assignee = 'ben'`).Scan(&n); err != nil {
+		t.Fatal(err)
+	}
+	if n != 0 {
+		t.Fatalf("ben still assigned to %d tasks", n)
+	}
+}
+
+func TestTransferDropsOrgAdmin(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("self transfer: got %d want 200", code)
+	}
+	// Eve is now a globex user without admin rights.
+	if code, _ := do(t, h, "POST", "/orgs/globex/users/gus/transfer", "eve", `{"toOrgId":"acme"}`); code != 403 {
+		t.Fatalf("got %d want 403", code)
+	}
+}
