+// CanManage returns nil if the actor may manage the project's tasks as a whole,
+// such as moving a task into it: managers only (else ErrForbidden) and not
+// archived (else ErrArchived).
+func (a ProjectAuthz) CanManage() error {
+	if !a.CanRead() || a.role != RoleManager {
+		return deny(ErrForbidden, "forbidden")
+	}
+	if a.archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	return nil
