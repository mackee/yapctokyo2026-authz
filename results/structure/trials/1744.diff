+func TestRemoveOrgUserStatus(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes", "eve", "/orgs/acme/users/ben", 204},
+		{"member without any project", "eve", "/orgs/acme/users/hal", 204},
+		{"org admin removes self", "eve", "/orgs/acme/users/eve", 204},
+		{"project manager is not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"plain user", "hal", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"other org's path", "gus", "/orgs/acme/users/ben", 404},
+		{"admin on other org", "eve", "/orgs/globex/users/gus", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ben", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserRemovesAllMemberships(t *testing.T) {
+	h := newServer()
+	// ann is a member of web, ops and legacy (archived).
+	for _, p := range []string{"web", "ops", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ann", ""); code != 200 {
+			t.Fatalf("precondition: ann reads %s: %d", p, code)
+		}
+	}
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ann", "eve", ""); code != 204 {
+		t.Fatalf("delete: %d", code)
+	}
+	for _, p := range []string{"web", "ops", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ann", ""); code != 404 {
+			t.Fatalf("ann still reads %s: %d", p, code)
+		}
+	}
+	// Other members are untouched.
+	for user, project := range map[string]string{"ben": "web", "cat": "ops", "ivy": "web", "dan": "web"} {
+		if code, _ := do(t, h, "GET", "/projects/"+project+"/tasks", user, ""); code != 200 {
+			t.Fatalf("%s lost access to %s: %d", user, project, code)
+		}
+	}
+	// Removal is idempotent.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ann", "eve", ""); code != 204 {
+		t.Fatalf("second delete: %d", code)
+	}
+}
+
+func TestRemoveOrgUserUnassignsTheirTasks(t *testing.T) {
+	h := newServer()
+	// ben is assigned t1 (web) and t5 (legacy, archived); cat keeps t2 and t4.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("delete: %d", code)
+	}
+	assignee := func(project, tid string) string {
+		t.Helper()
+		code, body := do(t, h, "GET", "/projects/"+project+"/tasks/"+tid, "ivy", "")
+		if code == 404 { // ivy is not in legacy; read it as the org admin
+			code, body = do(t, h, "GET", "/projects/"+project+"/tasks/"+tid, "eve", "")
+		}
+		if code != 200 {
+			t.Fatalf("get %s: %d", tid, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		return task.AssigneeID
+	}
+	if got := assignee("web", "t1"); got != "" {
+		t.Fatalf("t1 assignee %q, want unassigned", got)
+	}
+	if got := assignee("legacy", "t5"); got != "" {
+		t.Fatalf("t5 assignee %q, want unassigned", got)
+	}
+	if got := assignee("web", "t2"); got != "cat" {
+		t.Fatalf("t2 assignee %q, want cat", got)
+	}
+	if got := assignee("ops", "t4"); got != "cat" {
+		t.Fatalf("t4 assignee %q, want cat", got)
+	}
+}
+
