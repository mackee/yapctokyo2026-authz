+// MoveMember removes userID from fromPID and adds them to toPID with the same
+// role. Tasks in fromPID assigned to the user become unassigned, so that
+// assignees always remain project members. Callers must validate beforehand.
+func (s *Store) MoveMember(fromPID, toPID, userID string) string {
+	role := s.members[fromPID][userID]
+	delete(s.members[fromPID], userID)
+	if s.members[toPID] == nil {
+		s.members[toPID] = map[string]string{}
+	}
+	s.members[toPID][userID] = role
+	for _, t := range s.tasks {
+		if t.ProjectID == fromPID && t.Assignee == userID {
+			t.Assignee = ""
+		}
+	}
+	return role
+}
