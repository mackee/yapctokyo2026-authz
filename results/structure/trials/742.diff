+// RemoveFromOrgProjects removes the user from every project of the
+// organization: the memberships in those projects are deleted, and the tasks
+// the user holds there are unassigned (an assignee must be a member). It runs
+// in one transaction. Archived projects are changed too, since removing access
+// is not a write that archived projects refuse. Only org admins may do it
+// (CanManageUsers, else ErrForbidden); a user outside the organization is
+// ErrNotFound.
+func (*UserTable) RemoveFromOrgProjects(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanManageUsers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveOrgUser(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
