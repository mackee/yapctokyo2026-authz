@@ -0,0 +1,81 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes manager", "eve", "/orgs/acme/users/ann", 204},
+		{"org admin removes user with no projects", "eve", "/orgs/acme/users/hal", 204},
+		{"manager of a project", "ann", "/orgs/acme/users/cat", 403},
+		{"contributor", "ben", "/orgs/acme/users/cat", 403},
+		{"viewer", "dan", "/orgs/acme/users/cat", 403},
+		{"non-admin org user", "hal", "/orgs/acme/users/hal", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"unknown org", "eve", "/orgs/initech/users/ben", 404},
+		{"org admin of another org", "eve", "/orgs/globex/users/gus", 404},
+		{"caller of another org", "gus", "/orgs/acme/users/ben", 404},
+		{"user of another org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d body=%s", code, body)
+	}
+	// Removing again is still a success.
+	if code, body := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove again: got %d body=%s", code, body)
+	}
+
+	// Ben is no longer a member of any acme project, archived ones included.
+	for _, path := range []string{"/projects/web/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, srv, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("ben GET %s: got %d want 404", path, code)
+		}
+	}
+
+	// Tasks Ben held in those projects are unassigned; other assignees stay.
+	cases := []struct {
+		path, assignee string
+	}{
+		{"/projects/web/tasks/t1", ""},
+		{"/projects/legacy/tasks/t5", ""},
+		{"/projects/web/tasks/t2", "cat"},
+	}
+	for _, c := range cases {
+		code, body := do(t, srv, "GET", c.path, "ann", "")
+		if code != 200 {
+			t.Fatalf("ann GET %s: got %d body=%s", c.path, code, body)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.AssigneeID != c.assignee {
+			t.Fatalf("%s assignee = %q, want %q", c.path, task.AssigneeID, c.assignee)
+		}
+	}
+
+	// Other organizations are untouched.
+	if code, body := do(t, srv, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatalf("gus GET gx: got %d body=%s", code, body)
+	}
+}
