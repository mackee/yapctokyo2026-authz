+// OrgExists reports whether the organization has any user or project.
+func (*UserTable) OrgExists(ctx context.Context, db DB, org string) (bool, error) {
+	var n int
+	if err := db.QueryRowContext(ctx,
+		`SELECT (SELECT COUNT(*) FROM users WHERE org_id = ?) + (SELECT COUNT(*) FROM projects WHERE org_id = ?)`,
+		org, org).Scan(&n); err != nil {
+		return false, err
+	}
+	return n > 0, nil
+}
+
+// UserTableTransferInput is the input of UserTable.Transfer.
+type UserTableTransferInput struct {
+	ToOrg string
+}
+
+// Transfer moves the user, who must belong to the authorized organization, to
+// another existing organization. Project members belong to the project's
+// organization, so the user's memberships (and the tasks assigned to them) in
+// the old organization are dropped, and org admin is reset.
+func (*UserTable) Transfer(ctx context.Context, db DB, authz OrgAuthz, userID string, in UserTableTransferInput) (*User, error) {
+	if !authz.CanRead() {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if err := authz.CanTransfer(); err != nil {
+		return nil, err
+	}
+	if in.ToOrg == "" {
+		return nil, deny(ErrInvalid, "toOrgId must not be empty")
+	}
+	var u *User
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadTransferUser(ctx, tx, authz.OrgID(), userID, in)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if u, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return u, nil
+}
