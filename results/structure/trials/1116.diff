+// updateRolesAggregate changes the roles of several members of one project.
+type updateRolesAggregate struct {
+	members []*Membership // the members to change, in user ID order
+	roles   map[string]string
+	tasks   map[string][]*Task // membership.AssignedTasks, by user ID
+}
+
+func loadUpdateRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*updateRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	ids := make([]string, 0, len(roles))
+	for id := range roles {
+		ids = append(ids, id)
+	}
+	sort.Strings(ids)
+	a := &updateRolesAggregate{roles: roles, tasks: map[string][]*Task{}}
+	for _, id := range ids {
+		m, err := p.Membership(ctx, tx, id)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "not a member of the project: "+id)
+		} else if err != nil {
+			return nil, err
+		}
+		a.members = append(a.members, m)
+		if !isWriterRole(roles[id]) {
+			if a.tasks[id], err = m.AssignedTasks(ctx, tx); err != nil {
+				return nil, err
+			}
+		}
+	}
+	return a, nil
+}
+
+func (a *updateRolesAggregate) validate() error {
+	for _, m := range a.members {
+		role := a.roles[m.UserID]
+		if role != RoleManager && role != RoleContributor && role != RoleViewer {
+			return deny(ErrInvalid, "invalid role for "+m.UserID)
+		}
+		if !isWriterRole(role) && len(a.tasks[m.UserID]) > 0 {
+			return deny(ErrInvalid, m.UserID+" has assigned tasks and must remain a contributor or manager")
+		}
+	}
+	return nil
+}
+
+func (a *updateRolesAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for _, m := range a.members {
+		if err := m.changeRole(ctx, tx, a.roles[m.UserID]); err != nil {
+			return nil, err
+		}
+	}
+	return a.members, nil
+}
+
