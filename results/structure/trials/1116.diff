diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..3fef6f1
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,80 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestUpdateMemberRoles(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager changes several", "ann", "web", `{"roles":{"ivy":"viewer","dan":"contributor"}}`, 200},
+		{"member with tasks demoted (cat)", "ann", "web", `{"roles":{"cat":"viewer"}}`, 400},
+		{"member with tasks demoted", "ann", "web", `{"roles":{"ben":"viewer"}}`, 400},
+		{"invalid role", "ann", "web", `{"roles":{"dan":"owner"}}`, 400},
+		{"not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"manager"}}`, 409},
+		{"anonymous", "", "web", `{"roles":{"dan":"contributor"}}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRolesResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann", `{"roles":{"ivy":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got []map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []map[string]string{
+		{"userId": "ann", "role": "manager"},
+		{"userId": "ben", "role": "contributor"},
+		{"userId": "cat", "role": "contributor"},
+		{"userId": "dan", "role": "contributor"},
+		{"userId": "ivy", "role": "viewer"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %v", got)
+	}
+	for i := range want {
+		if got[i]["userId"] != want[i]["userId"] || got[i]["role"] != want[i]["role"] {
+			t.Fatalf("got %v want %v", got, want)
+		}
+	}
+}
+
+// One bad entry rejects the whole request and changes nothing.
+func TestUpdateMemberRolesAllOrNothing(t *testing.T) {
+	h := newServer()
+	code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","hal":"viewer"}}`)
+	if code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	code, _ = do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","ben":"viewer"}}`)
+	if code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	// dan is still a viewer: cannot create tasks.
+	code, _ = do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`)
+	if code != 403 {
+		t.Fatalf("dan was changed: got %d want 403", code)
+	}
+}
