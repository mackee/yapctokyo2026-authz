+func TestRemoveOrgUserAccess(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin, user already gone", "eve", "/orgs/acme/users/hal", 204},
+		{"org admin, unknown user", "eve", "/orgs/acme/users/zed", 404},
+		{"org admin, user in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"org admin of other org", "gus", "/orgs/acme/users/ben", 404},
+		{"org admin, path is other org", "eve", "/orgs/globex/users/gus", 404},
+		{"manager, not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	s := newServer()
+
+	// ben is a contributor in web and legacy (archived), and is assigned t1 and t5.
+	if code, _ := do(t, s, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove ben: got %d want 204", code)
+	}
+	for _, path := range []string{"/projects/web/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, s, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("ben reads %s after removal: got %d want 404", path, code)
+		}
+	}
+	for _, path := range []string{"/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		code, body := do(t, s, "GET", path, "ann", "")
+		if code != 200 {
+			t.Fatalf("GET %s: got %d", path, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.Assignee != "" {
+			t.Fatalf("%s assignee = %q, want unassigned", path, task.Assignee)
+		}
+	}
+	// Other people's assignments are untouched.
+	code, body := do(t, s, "GET", "/projects/web/tasks/t2", "ann", "")
+	if code != 200 || !strings.Contains(body, `"assignee":"cat"`) {
+		t.Fatalf("t2 changed: %d %s", code, body)
+	}
+
+	// Removing again is harmless.
+	if code, _ := do(t, s, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("repeat remove: got %d want 204", code)
+	}
+}
+
+func TestRemoveOrgUserKeepsOthers(t *testing.T) {
+	s := newServer()
+
+	// ivy manages web and ops. Removing her must not touch cat's ops membership.
+	if code, _ := do(t, s, "DELETE", "/orgs/acme/users/ivy", "eve", ""); code != 204 {
+		t.Fatalf("remove ivy: got %d want 204", code)
+	}
+	if code, _ := do(t, s, "GET", "/projects/ops/tasks", "ivy", ""); code != 404 {
+		t.Fatalf("ivy reads ops after removal: got %d want 404", code)
+	}
+	if code, _ := do(t, s, "GET", "/projects/ops/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat reads ops after ivy's removal: got %d want 200", code)
+	}
+	if code, _ := do(t, s, "GET", "/projects/ops/tasks", "eve", ""); code != 200 {
+		t.Fatalf("org admin reads ops: got %d want 200", code)
+	}
+}
