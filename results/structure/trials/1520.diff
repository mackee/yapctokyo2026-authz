diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..714d4a0
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,161 @@
+package main
+
+import (
+	"net/http"
+	"strings"
+	"testing"
+)
+
+// memberRoles returns the role of every member of the project, read straight
+// from the database behind h.
+func memberRoles(t *testing.T, h http.Handler, projectID string) map[string]string {
+	t.Helper()
+	app, ok := h.(*appHandler)
+	if !ok {
+		t.Fatalf("memberRoles: %T is not the handler built by newServer", h)
+	}
+	rows, err := app.db.Query(`SELECT user_id, role FROM memberships WHERE project_id = ?`, projectID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer rows.Close()
+	out := map[string]string{}
+	for rows.Next() {
+		var uid, role string
+		if err := rows.Scan(&uid, &role); err != nil {
+			t.Fatal(err)
+		}
+		out[uid] = role
+	}
+	if err := rows.Err(); err != nil {
+		t.Fatal(err)
+	}
+	return out
+}
+
+func TestUpdateMembers(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+		// wantBody is the response of a 200 (the members after the change).
+		wantBody string
+	}{
+		{
+			name: "manager changes several roles", user: "ann", project: "web",
+			body: `{"roles":{"dan":"contributor","ivy":"contributor"}}`, want: 200,
+			wantBody: `[{"userId":"ann","role":"manager"},{"userId":"ben","role":"contributor"},` +
+				`{"userId":"cat","role":"contributor"},{"userId":"dan","role":"contributor"},{"userId":"ivy","role":"contributor"}]`,
+		},
+		{
+			name: "member without tasks may become a viewer", user: "ann", project: "web",
+			body: `{"roles":{"ivy":"viewer"}}`, want: 200,
+			wantBody: `[{"userId":"ann","role":"manager"},{"userId":"ben","role":"contributor"},` +
+				`{"userId":"cat","role":"contributor"},{"userId":"dan","role":"viewer"},{"userId":"ivy","role":"viewer"}]`,
+		},
+		{
+			name: "manager of another project can promote a viewer", user: "ivy", project: "ops",
+			body: `{"roles":{"ann":"manager"}}`, want: 200,
+			wantBody: `[{"userId":"ann","role":"manager"},{"userId":"cat","role":"contributor"},{"userId":"ivy","role":"manager"}]`,
+		},
+		{
+			name: "viewer who holds a task blocks the whole update", user: "ann", project: "web",
+			body: `{"roles":{"ben":"viewer","dan":"contributor"}}`, want: 400,
+		},
+		{
+			name: "contributor who holds a task cannot become a viewer", user: "ivy", project: "ops",
+			body: `{"roles":{"cat":"viewer"}}`, want: 400,
+		},
+		{
+			name: "user who is not a member blocks the whole update", user: "ann", project: "web",
+			body: `{"roles":{"dan":"contributor","hal":"viewer"}}`, want: 400,
+		},
+		{
+			name: "unknown user", user: "ann", project: "web",
+			body: `{"roles":{"zed":"viewer"}}`, want: 400,
+		},
+		{
+			name: "invalid role", user: "ann", project: "web",
+			body: `{"roles":{"dan":"owner"}}`, want: 400,
+		},
+		{
+			name: "empty roles", user: "ann", project: "web",
+			body: `{"roles":{}}`, want: 400,
+		},
+		{
+			name: "missing roles", user: "ann", project: "web",
+			body: `{}`, want: 400,
+		},
+		{
+			name: "bad json", user: "ann", project: "web",
+			body: `{"roles":`, want: 400,
+		},
+		{
+			name: "contributor", user: "ben", project: "web",
+			body: `{"roles":{"dan":"contributor"}}`, want: 403,
+		},
+		{
+			name: "viewer", user: "dan", project: "web",
+			body: `{"roles":{"dan":"contributor"}}`, want: 403,
+		},
+		{
+			name: "org admin who is not a member", user: "eve", project: "web",
+			body: `{"roles":{"dan":"contributor"}}`, want: 403,
+		},
+		{
+			name: "non member", user: "hal", project: "web",
+			body: `{"roles":{"dan":"contributor"}}`, want: 404,
+		},
+		{
+			name: "other org", user: "gus", project: "web",
+			body: `{"roles":{"dan":"contributor"}}`, want: 404,
+		},
+		{
+			name: "anonymous", user: "", project: "web",
+			body: `{"roles":{"dan":"contributor"}}`, want: 401,
+		},
+		{
+			name: "archived", user: "ann", project: "legacy",
+			body: `{"roles":{"ben":"viewer"}}`, want: 409,
+		},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			app := newServer()
+			before := memberRoles(t, app, c.project)
+			code, body := do(t, app, "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+			if c.want == 200 {
+				if got := strings.TrimSpace(body); got != c.wantBody {
+					t.Fatalf("body\n got: %s\nwant: %s", got, c.wantBody)
+				}
+				return
+			}
+			after := memberRoles(t, app, c.project)
+			for uid, role := range before {
+				if after[uid] != role {
+					t.Fatalf("rejected update changed %s from %s to %s", uid, role, after[uid])
+				}
+			}
+			if len(after) != len(before) {
+				t.Fatalf("rejected update changed the member count from %d to %d", len(before), len(after))
+			}
+		})
+	}
+}
+
+// A rejected update must leave the database as it was, even when the bad change
+// comes after valid ones in the request.
+func TestUpdateMembersIsAllOrNothing(t *testing.T) {
+	app := newServer()
+	code, _ := do(t, app, "PUT", "/projects/web/members", "ann",
+		`{"roles":{"dan":"manager","ivy":"viewer","ben":"viewer"}}`)
+	if code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	got := memberRoles(t, app, "web")
+	if got["dan"] != "viewer" || got["ivy"] != "manager" || got["ben"] != "contributor" {
+		t.Fatalf("roles changed despite the rejection: %v", got)
+	}
+}
