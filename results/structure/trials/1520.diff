 import "context"
 
-// MembershipTable reads the memberships table.
+// MembershipTable is the memberships table.
+//
+// Find and List* read rows. UpdateRoles is an operation: it takes the
+// database, the project's authorization object and an input, asks the
+// authorization object whether the actor may perform it, then runs its
+// aggregate (aggregate.go) in a transaction.
 type MembershipTable struct{}
 
 // NewMembershipTable returns the memberships table.
 func NewMembershipTable() *MembershipTable { return &MembershipTable{} }
 
+// MembershipTableUpdateRolesInput is the input of MembershipTable.UpdateRoles:
+// the new role of each member, by user ID.
+type MembershipTableUpdateRolesInput struct {
+	Roles map[string]string
+}
+
+var validRoles = map[string]bool{RoleManager: true, RoleContributor: true, RoleViewer: true}
+
+// UpdateRoles changes the roles of the members, all or nothing, and returns
+// the project's members after the change (ordered by user ID). A user who is
+// not a member, or a member who holds assigned tasks and would stop being a
+// contributor or manager, rejects the whole update with ErrInvalid.
+func (mt *MembershipTable) UpdateRoles(ctx context.Context, db DB, authz ProjectAuthz, in MembershipTableUpdateRolesInput) ([]*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if len(in.Roles) == 0 {
+		return nil, deny(ErrInvalid, "roles must not be empty")
+	}
+	for _, role := range in.Roles {
+		if !validRoles[role] {
+			return nil, deny(ErrInvalid, "invalid role: "+role)
+		}
+	}
+	var out []*Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadUpdateRoles(ctx, tx, authz.ProjectID(), in)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(ctx, tx); err != nil {
+			return err
+		}
+		if out, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
+
