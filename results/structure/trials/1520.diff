+// updateRolesAggregate changes the roles of several members of one project,
+// all or nothing.
+type updateRolesAggregate struct {
+	project *Project
+	changes []roleChange // ordered by user ID
+}
+
+type roleChange struct {
+	member  *Membership
+	newRole string
+}
+
+func loadUpdateRoles(ctx context.Context, tx DB, projectID string, in MembershipTableUpdateRolesInput) (*updateRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if err != nil {
+		return nil, err
+	}
+	userIDs := make([]string, 0, len(in.Roles))
+	for uid := range in.Roles {
+		userIDs = append(userIDs, uid)
+	}
+	sort.Strings(userIDs)
+	a := &updateRolesAggregate{project: p}
+	for _, uid := range userIDs {
+		m, err := p.Membership(ctx, tx, uid)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, fmt.Sprintf("%s is not a member of the project", uid))
+		} else if err != nil {
+			return nil, err
+		}
+		a.changes = append(a.changes, roleChange{member: m, newRole: in.Roles[uid]})
+	}
+	return a, nil
+}
+
+func (a *updateRolesAggregate) validate(ctx context.Context, tx DB) error {
+	for _, c := range a.changes {
+		if isWriterRole(c.newRole) {
+			continue
+		}
+		// An assignee must be a contributor or manager of the task's project,
+		// so a member who holds tasks here cannot become a viewer.
+		assigned, err := c.member.AssignedTasks(ctx, tx)
+		if err != nil {
+			return err
+		}
+		if len(assigned) > 0 {
+			return deny(ErrInvalid, fmt.Sprintf("%s has assigned tasks in the project and cannot become %s", c.member.UserID, c.newRole))
+		}
+	}
+	return nil
+}
+
+func (a *updateRolesAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for _, c := range a.changes {
+		if err := c.member.changeRole(ctx, tx, c.newRole); err != nil {
+			return nil, err
+		}
+	}
+	return a.project.Memberships(ctx, tx)
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
