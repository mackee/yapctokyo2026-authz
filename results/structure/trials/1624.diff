+func TestRemoveUserFromOrg(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes user with no memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"manager is not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"member without roles is not org admin", "hal", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"caller in other org", "gus", "/orgs/acme/users/ben", 404},
+		{"org admin of other org", "eve", "/orgs/globex/users/gus", 404},
+		{"target not in org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveUserFromOrgRemovesAllOrgMemberships(t *testing.T) {
+	s := newServer()
+
+	// cat is a contributor in web and ops (both acme projects).
+	if code, _ := do(t, s, "DELETE", "/orgs/acme/users/cat", "eve", ""); code != 204 {
+		t.Fatalf("delete: got %d want 204", code)
+	}
+
+	// The removed user loses access to every project of the org, including writes.
+	for _, c := range []struct{ method, path, body string }{
+		{"GET", "/projects/web/tasks", ""},
+		{"GET", "/projects/ops/tasks", ""},
+		{"GET", "/projects/web/tasks/t2", ""},
+		{"GET", "/projects/ops/tasks/t4", ""},
+		{"POST", "/projects/web/tasks", `{"title":"x"}`},
+	} {
+		if code, _ := do(t, s, c.method, c.path, "cat", c.body); code != 404 {
+			t.Errorf("%s %s as removed user: got %d want 404", c.method, c.path, code)
+		}
+	}
+
+	// Other members keep their access.
+	if code, _ := do(t, s, "GET", "/projects/web/tasks", "ann", ""); code != 200 {
+		t.Errorf("ann lists web after removing cat: got %d want 200", code)
+	}
+	if code, _ := do(t, s, "GET", "/projects/ops/tasks", "ivy", ""); code != 200 {
+		t.Errorf("ivy lists ops after removing cat: got %d want 200", code)
+	}
+	if code, _ := do(t, s, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Errorf("ben lists web after removing cat: got %d want 200", code)
+	}
+}
+
+func TestRemoveUserFromOrgIncludesArchivedProjects(t *testing.T) {
+	s := newServer()
+
+	// ben is a contributor in the archived legacy project.
+	if code, _ := do(t, s, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("delete: got %d want 204", code)
+	}
+	if code, _ := do(t, s, "GET", "/projects/legacy/tasks/t5", "ben", ""); code != 404 {
+		t.Errorf("ben reads archived legacy after removal: got %d want 404", code)
+	}
+	if code, _ := do(t, s, "GET", "/projects/legacy/tasks", "ann", ""); code != 200 {
+		t.Errorf("ann lists legacy after removing ben: got %d want 200", code)
+	}
+}
+
+func TestRemoveUserFromOrgIsIdempotent(t *testing.T) {
+	s := newServer()
+	for i := 0; i < 2; i++ {
+		if code, _ := do(t, s, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+			t.Fatalf("attempt %d: got %d want 204", i+1, code)
+		}
+	}
+}
