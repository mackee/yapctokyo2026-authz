+func TestCreateAddsNonMemberAssigneeAsContributor(t *testing.T) {
+	srv := newServer()
+
+	// hal is not in web: cannot read it yet.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "hal", ""); code != 404 {
+		t.Fatalf("before create: list got %d want 404", code)
+	}
+
+	code, body := do(t, srv, "POST", "/projects/web/tasks", "ann", `{"title":"new","assignee":"hal"}`)
+	if code != 201 {
+		t.Fatalf("create got %d want 201: %s", code, body)
+	}
+	var created Task
+	if err := json.Unmarshal([]byte(body), &created); err != nil {
+		t.Fatal(err)
+	}
+	if created.Assignee != "hal" || created.ProjectID != "web" {
+		t.Fatalf("unexpected task: %+v", created)
+	}
+
+	// hal is now a member, so can read the project...
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "hal", ""); code != 200 {
+		t.Fatalf("after create: list got %d want 200", code)
+	}
+	// ...and, as a contributor assigned the task, can modify it.
+	path := "/projects/web/tasks/" + created.ID
+	if code, _ := do(t, srv, "PATCH", path, "hal", `{"status":"doing"}`); code != 200 {
+		t.Fatalf("hal patch own task got %d want 200", code)
+	}
+	// Contributors still cannot delete, so role is contributor, not manager.
+	if code, _ := do(t, srv, "DELETE", path, "hal", ""); code != 403 {
+		t.Fatalf("hal delete got %d want 403", code)
+	}
+}
