+++ b/internal/capability/access.go
@@ -0,0 +1,140 @@
+package capability
+
+// Access requests let a user ask to join a project. Anyone in the project's
+// organization may ask, whether or not they can already read the project, and
+// managers decide. An approved request makes the requester a contributor.
+
+// Access request statuses.
+const (
+	RequestPending  = "pending"
+	RequestApproved = "approved"
+)
+
+// AccessRequestView is the public representation of a request to join a project.
+type AccessRequestView struct {
+	ID        string `json:"id"`
+	ProjectID string `json:"projectId"`
+	UserID    string `json:"userId"`
+	Status    string `json:"status"`
+}
+
+// joinable applies the join rule: the project exists in the actor's
+// organization (else 404), the actor is not already a member (409), and the
+// project is not archived (409). Membership is not required, so this is the
+// one place a non-member can get a capability for a project.
+func joinable(s *state, act Actor, pid string) error {
+	p, ok := s.projects[pid]
+	if !ok || p.org != act.org {
+		return deny(ErrNotFound, "not found")
+	}
+	if s.role(pid, act.id) != "" {
+		return deny(ErrConflict, "already a member")
+	}
+	if p.archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	return nil
+}
+
+// JoinProject may ask to join one project.
+type JoinProject interface {
+	// Request records a pending request for the actor. A second pending request
+	// from the same actor for the same project is 409.
+	Request() (AccessRequestView, error)
+}
+
+// ReviewProject may list and decide the access requests of one project. Only
+// managers hold it.
+type ReviewProject interface {
+	Requests() []AccessRequestView
+	// Approve adds the requester to the project as a contributor and marks the
+	// request approved. Only pending requests can be approved (else 409).
+	Approve(requestID string) (AccessRequestView, error)
+}
+
+type joinProject struct{ ps *projectScope }
+
+type reviewProject struct{ ps *projectScope }
+
+// Join applies the join rule (see joinable).
+func (s *projectScope) Join() (JoinProject, error) {
+	err := s.as.a.st.read(func(st *state) error {
+		return joinable(st, s.as.actor, s.pid)
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &joinProject{ps: s}, nil
+}
+
+// Review applies the review rule: readable, manager (else 403).
+func (s *projectScope) Review() (ReviewProject, error) {
+	err := s.as.a.st.read(func(st *state) error {
+		_, role, err := readable(st, s.as.actor, s.pid)
+		if err != nil {
+			return err
+		}
+		if role != RoleManager {
+			return deny(ErrForbidden, "forbidden")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &reviewProject{ps: s}, nil
+}
+
+func (j *joinProject) Request() (AccessRequestView, error) {
+	var v AccessRequestView
+	err := j.ps.as.a.st.tx(func(s *state) error {
+		// Re-check inside the write transaction so concurrent requests cannot
+		// slip past the rules that Join checked earlier.
+		if err := joinable(s, j.ps.as.actor, j.ps.pid); err != nil {
+			return err
+		}
+		if s.hasPendingRequest(j.ps.pid, j.ps.as.actor.id) {
+			return deny(ErrConflict, "already requested")
+		}
+		r := s.newRequest(j.ps.pid, j.ps.as.actor.id)
+		s.requests[r.id] = r
+		v = r.view()
+		return nil
+	})
+	return v, err
+}
+
+func (r *reviewProject) Requests() []AccessRequestView {
+	var out []AccessRequestView
+	_ = r.ps.as.a.st.read(func(s *state) error { out = s.requestsIn(r.ps.pid); return nil })
+	return out
+}
+
+func (r *reviewProject) Approve(requestID string) (AccessRequestView, error) {
+	var v AccessRequestView
+	err := r.ps.as.a.st.tx(func(s *state) error {
+		pid := r.ps.pid
+		req, ok := s.requests[requestID]
+		if !ok || req.project != pid {
+			return deny(ErrNotFound, "not found")
+		}
+		if s.projects[pid].archived {
+			return deny(ErrArchived, "project is archived")
+		}
+		if req.status != RequestPending {
+			return deny(ErrConflict, "request is not pending")
+		}
+		if s.role(pid, req.user) != "" {
+			return deny(ErrConflict, "already a member")
+		}
+		if s.members[pid] == nil {
+			s.members[pid] = map[string]string{}
+		}
+		s.members[pid][req.user] = RoleContributor
+		req.status = RequestApproved
+		s.requests[req.id] = req
+		v = req.view()
+		return nil
+	})
+	return v, err
+}
