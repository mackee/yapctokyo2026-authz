+func createAccessRequest(ctx tanukirpc.Context[*projectRegistry], _ struct{}) (*AccessRequest, error) {
+	j, err := ctx.Registry().scope.Join()
+	if err != nil {
+		return nil, err
+	}
+	v, err := j.Request()
+	if err != nil {
+		return nil, err
+	}
+	return writeJSON(ctx.Response(), http.StatusCreated, v)
+}
+
+func listAccessRequests(ctx tanukirpc.Context[*projectRegistry], _ struct{}) ([]AccessRequest, error) {
+	r, err := ctx.Registry().scope.Review()
+	if err != nil {
+		return nil, err
+	}
+	return r.Requests(), nil
+}
