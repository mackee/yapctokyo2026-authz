+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"testing"
+)
+
+type accessRequestJSON struct {
+	ID        string `json:"id"`
+	ProjectID string `json:"projectId"`
+	UserID    string `json:"userId"`
+	Status    string `json:"status"`
+}
+
+// newServerWithRequest returns a server in which hal has requested to join web
+// (request r1).
+func newServerWithRequest(t *testing.T) http.Handler {
+	t.Helper()
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/access-requests", "hal", ""); code != 201 {
+		t.Fatalf("setup: got %d: %s", code, body)
+	}
+	return h
+}
+
+func TestCreateAccessRequest(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"non member", "hal", "web", 201},
+		{"org admin non member", "eve", "web", 201},
+		{"already member", "ben", "web", 409},
+		{"viewer member", "dan", "web", 409},
+		{"other org", "gus", "web", 404},
+		{"unknown project", "hal", "nope", 404},
+		{"archived", "hal", "legacy", 409},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/access-requests", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestCreateAccessRequestBody(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/access-requests", "hal", "")
+	if code != 201 {
+		t.Fatalf("got %d", code)
+	}
+	var got accessRequestJSON
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := accessRequestJSON{ID: "r1", ProjectID: "web", UserID: "hal", Status: "pending"}
+	if got != want {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+}
+
+func TestDuplicatePendingRequest(t *testing.T) {
+	h := newServerWithRequest(t)
+	code, _ := do(t, h, "POST", "/projects/web/access-requests", "hal", "")
+	if code != 409 {
+		t.Fatalf("second pending request: got %d want 409", code)
+	}
+}
+
+func TestListAccessRequests(t *testing.T) {
+	cases := []struct {
+		name, user string
+		want       int
+	}{
+		{"manager", "ann", 200},
+		{"other manager", "ivy", 200},
+		{"contributor", "ben", 403},
+		{"viewer", "dan", 403},
+		{"org admin", "eve", 403},
+		{"non member", "hal", 404},
+		{"other org", "gus", 404},
+		{"anonymous", "", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServerWithRequest(t), "GET", "/projects/web/access-requests", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestListShowsRequests(t *testing.T) {
+	code, body := do(t, newServerWithRequest(t), "GET", "/projects/web/access-requests", "ann", "")
+	if code != 200 {
+		t.Fatal(code)
+	}
+	var got []accessRequestJSON
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []accessRequestJSON{{ID: "r1", ProjectID: "web", UserID: "hal", Status: "pending"}}
+	if len(got) != 1 || got[0] != want[0] {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+}
+
+func TestListEmpty(t *testing.T) {
+	code, body := do(t, newServer(), "GET", "/projects/web/access-requests", "ann", "")
+	if code != 200 || body != "[]\n" {
+		t.Fatalf("got %d %q", code, body)
+	}
+}
+
+func TestApproveAccessRequest(t *testing.T) {
+	cases := []struct {
+		name, user string
+		want       int
+	}{
+		{"manager", "ann", 200},
+		{"other manager", "ivy", 200},
+		{"contributor", "ben", 403},
+		{"viewer", "dan", 403},
+		{"org admin", "eve", 403},
+		{"non member", "hal", 404},
+		{"other org", "gus", 404},
+		{"anonymous", "", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServerWithRequest(t), "POST", "/projects/web/access-requests/r1/approve", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestApproveReturnsUpdatedRequest(t *testing.T) {
+	code, body := do(t, newServerWithRequest(t), "POST", "/projects/web/access-requests/r1/approve", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got accessRequestJSON
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := accessRequestJSON{ID: "r1", ProjectID: "web", UserID: "hal", Status: "approved"}
+	if got != want {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+}
+
+func TestApproveMakesRequesterContributor(t *testing.T) {
+	h := newServerWithRequest(t)
+	if code, body := do(t, h, "POST", "/projects/web/access-requests/r1/approve", "ann", ""); code != 200 {
+		t.Fatalf("approve: got %d: %s", code, body)
+	}
+
+	// hal can now read the project.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "hal", ""); code != 200 {
+		t.Fatalf("list tasks: got %d want 200", code)
+	}
+	// hal is a contributor: may create an unassigned task, may not assign others.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "hal", `{"title":"x"}`); code != 201 {
+		t.Fatalf("contributor create: got %d want 201", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "hal", `{"title":"x","assignee":"cat"}`); code != 403 {
+		t.Fatalf("contributor assigns other: got %d want 403", code)
+	}
+	// hal cannot manage requests: contributors are not managers.
+	if code, _ := do(t, h, "GET", "/projects/web/access-requests", "hal", ""); code != 403 {
+		t.Fatalf("contributor lists requests: got %d want 403", code)
+	}
+}
+
+func TestApproveTwice(t *testing.T) {
+	h := newServerWithRequest(t)
+	if code, _ := do(t, h, "POST", "/projects/web/access-requests/r1/approve", "ann", ""); code != 200 {
+		t.Fatalf("first approve: got %d", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/access-requests/r1/approve", "ann", ""); code != 409 {
+		t.Fatalf("second approve: got %d want 409", code)
+	}
+}
+
+func TestApproveUnknownRequest(t *testing.T) {
+	code, _ := do(t, newServerWithRequest(t), "POST", "/projects/web/access-requests/r99/approve", "ann", "")
+	if code != 404 {
+		t.Fatalf("got %d want 404", code)
+	}
+}
+
+func TestApproveRequestFromOtherProject(t *testing.T) {
+	h := newServer()
+	// hal's request is r1 on ops; approving it through web must not work.
+	if code, _ := do(t, h, "POST", "/projects/ops/access-requests", "hal", ""); code != 201 {
+		t.Fatalf("setup: got %d", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/access-requests/r1/approve", "ann", ""); code != 404 {
+		t.Fatalf("cross project approve: got %d want 404", code)
+	}
+	code, body := do(t, h, "GET", "/projects/ops/access-requests", "ivy", "")
+	if code != 200 {
+		t.Fatalf("list ops: got %d", code)
+	}
+	var got []accessRequestJSON
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 1 || got[0].Status != "pending" {
+		t.Fatalf("request was changed by cross project approve: %+v", got)
+	}
+}
+
+func TestApproveDoesNotLeakOtherProjectMembership(t *testing.T) {
+	// Approving hal for web must not make hal a member of ops.
+	h := newServerWithRequest(t)
+	if code, _ := do(t, h, "POST", "/projects/web/access-requests/r1/approve", "ann", ""); code != 200 {
+		t.Fatalf("approve: got %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "hal", ""); code != 404 {
+		t.Fatalf("hal on ops: got %d want 404", code)
+	}
+}
