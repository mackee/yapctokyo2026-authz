+// Move moves the user from the project of authz to the project toProjectID,
+// keeping the role. The actor must be a manager of both projects, neither
+// archived. The target project must be readable by the actor (else ErrNotFound).
+func (*MembershipTable) Move(ctx context.Context, db DB, authz ProjectAuthz, userID, toProjectID string) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	toAuthz, err := NewProjectAuthz(ctx, db, authz.Actor(), toProjectID)
+	if err != nil {
+		return nil, err
+	}
+	if err := toAuthz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if toAuthz.ProjectID() == authz.ProjectID() {
+		return nil, deny(ErrInvalid, "target project must differ from the current project")
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		to, err := NewProjectTable().Find(ctx, tx, toAuthz.ProjectID())
+		if errors.Is(err, ErrNoRows) {
+			return deny(ErrNotFound, "not found")
+		} else if err != nil {
+			return err
+		}
+		agg, err := loadMoveMember(ctx, tx, authz.ProjectID(), userID, to)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		m, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
