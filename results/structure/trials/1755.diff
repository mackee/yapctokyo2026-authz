@@ -126,6 +126,66 @@ func (a *updateTaskAggregate) apply(ctx context.Context, tx DB) (*Task, error) {
 	return t, nil
 }
 
+// transferUserAggregate moves one user to another organization. Project
+// members must belong to the project's organization and assignees must be
+// members, so the user leaves every project of the old organization: their
+// memberships are deleted and the tasks assigned to them are unassigned.
+type transferUserAggregate struct {
+	user        *User
+	fromOrg     string
+	toOrg       string
+	toOrgExists bool
+	memberships []*Membership
+	tasks       []*Task
+}
+
+func loadTransferUser(ctx context.Context, tx DB, fromOrg, userID, toOrg string) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) || (err == nil && u.Org != fromOrg) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &transferUserAggregate{user: u, fromOrg: fromOrg, toOrg: toOrg}
+	if a.toOrgExists, err = NewUserTable().OrgExists(ctx, tx, toOrg); err != nil {
+		return nil, err
+	}
+	if a.memberships, err = u.Memberships(ctx, tx); err != nil {
+		return nil, err
+	}
+	if a.tasks, err = u.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if a.toOrg == "" || a.toOrg == a.fromOrg {
+		return deny(ErrInvalid, "user must be moved to a different organization")
+	}
+	if !a.toOrgExists {
+		return deny(ErrInvalid, "destination organization does not exist")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.user.moveToOrg(ctx, tx, a.toOrg); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
