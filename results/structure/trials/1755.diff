--- a/internal/model/user_table.go
+++ b/internal/model/user_table.go
@@ -17,3 +17,38 @@ func (*UserTable) Find(ctx context.Context, db DB, id string) (*User, error) {
 	}
 	return &u, nil
 }
+
+// OrgExists reports whether the organization has any user or project.
+func (*UserTable) OrgExists(ctx context.Context, db DB, org string) (bool, error) {
+	var n int
+	if err := db.QueryRowContext(ctx,
+		`SELECT (SELECT COUNT(*) FROM users WHERE org_id = ?) + (SELECT COUNT(*) FROM projects WHERE org_id = ?)`,
+		org, org).Scan(&n); err != nil {
+		return false, err
+	}
+	return n > 0, nil
+}
+
+// Transfer moves the user of the authorized organization to another
+// organization, all or nothing. The user leaves the old organization's
+// projects (see transferUserAggregate).
+func (*UserTable) Transfer(ctx context.Context, db DB, authz OrgAuthz, userID, toOrg string) (*User, error) {
+	if err := authz.CanTransfer(); err != nil {
+		return nil, err
+	}
+	var u *User
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadTransferUser(ctx, tx, authz.OrgID(), userID, toOrg)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		u, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return u, nil
+}
