+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager of both projects", "ivy", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 200},
+		{"contributor moves own task", "cat", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 200},
+		{"contributor moves others task", "ben", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 403},
+		{"viewer at destination", "ann", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 403},
+		{"non member of destination", "ben", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 404},
+		{"missing destination", "ann", "/projects/web/tasks/t3", `{"toProjectId":"nope"}`, 404},
+		{"other org destination", "ann", "/projects/web/tasks/t3", `{"toProjectId":"gx"}`, 404},
+		{"archived destination", "ann", "/projects/web/tasks/t3", `{"toProjectId":"legacy"}`, 409},
+		{"archived source", "ann", "/projects/legacy/tasks/t5", `{"toProjectId":"web"}`, 409},
+		{"same project", "ann", "/projects/web/tasks/t3", `{"toProjectId":"web"}`, 400},
+		{"assignee not writer at destination", "ivy", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 400},
+		{"missing toProjectId", "ann", "/projects/web/tasks/t3", `{}`, 400},
+		{"cross project task id", "ann", "/projects/web/tasks/t4", `{"toProjectId":"web"}`, 404},
+		{"anonymous", "", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 401},
+		{"org admin without role", "eve", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 403},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestMoveReturnsTaskWithFieldsKept(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got Task
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", AssigneeID: "cat"}
+	if got != want {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+}
+
+func TestMoveChangesWhichProjectHoldsTheTask(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`); code != 200 {
+		t.Fatalf("move: got %d want 200: %s", code, body)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t2", "ivy", ""); code != 404 {
+		t.Fatalf("old project: got %d want 404", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks/t2", "ivy", ""); code != 200 {
+		t.Fatalf("new project: got %d want 200", code)
+	}
+}
