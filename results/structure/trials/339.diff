+// ---- organization capabilities -----------------------------------------------
+
+// ManageUser is the org-admin capability over one user of one organization.
+type ManageUser interface {
+	// Remove takes the user out of every project of the organization (the
+	// user record stays) and unassigns the user's tasks in those projects.
+	// Removing a user who is not a member of any project succeeds too.
+	Remove() error
+}
+
+type orgScope struct {
+	as  *actorScope
+	oid string
+}
+
+func (s *orgScope) User(userID string) UserScope {
+	return &userScope{os: s, uid: userID}
+}
+
+type userScope struct {
+	os  *orgScope
+	uid string
+}
+
+// Manage applies the org admin rule: the organization is the actor's own (else
+// 404), the actor is an org admin (else 403), and the user belongs to the
+// organization (else 404).
+func (s *userScope) Manage() (ManageUser, error) {
+	err := s.os.as.a.db.view(func(x *tx) error {
+		if s.os.oid != s.os.as.actor.org {
+			return deny(ErrNotFound, "not found")
+		}
+		if !s.os.as.actor.orgAdmin {
+			return deny(ErrForbidden, "forbidden")
+		}
+		u, ok := x.findUser(s.uid)
+		if !ok || u.Org != s.os.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &manageUser{us: s}, nil
+}
+
+type manageUser struct{ us *userScope }
+
+func (m *manageUser) Remove() error {
+	return m.us.os.as.a.db.update(func(x *tx) error {
+		agg, err := loadRemoveOrgUser(x, m.us.os.oid, m.us.uid)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		agg.save(x)
+		return nil
+	})
+}
