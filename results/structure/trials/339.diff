+
+// removeOrgUserAggregate takes one user out of every project of one
+// organization. The user record itself is kept. Tasks of those projects that
+// are assigned to the user are unassigned, so no task keeps an assignee who is
+// no longer a contributor or manager of its project.
+type removeOrgUserAggregate struct {
+	memberships []membershipRecord // the user's memberships in the organization's projects
+	tasks       []taskRecord       // the organization's tasks assigned to the user
+}
+
+func loadRemoveOrgUser(x *tx, orgID, userID string) (*removeOrgUserAggregate, error) {
+	u, ok := x.findUser(userID)
+	if !ok || u.Org != orgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	a := &removeOrgUserAggregate{}
+	for _, p := range x.projectsIn(orgID) {
+		if m, ok := x.findMembership(p.ID, userID); ok {
+			a.memberships = append(a.memberships, m)
+		}
+	}
+	for _, t := range x.tasksAssignedTo(userID) {
+		if p, ok := x.findProject(t.ProjectID); ok && p.Org == orgID {
+			a.tasks = append(a.tasks, t)
+		}
+	}
+	return a, nil
+}
+
+func (a *removeOrgUserAggregate) validate() error { return nil }
+
+func (a *removeOrgUserAggregate) save(x *tx) {
+	for _, m := range a.memberships {
+		m.destroy(x)
+	}
+	for _, t := range a.tasks {
+		t.AssigneeID = ""
+		t.save(x)
+	}
+}
