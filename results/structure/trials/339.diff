+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin again (idempotent)", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin, user with no memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"manager of a project", "ann", "/orgs/acme/users/ben", 403},
+		{"contributor", "ben", "/orgs/acme/users/cat", 403},
+		{"viewer", "dan", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown actor", "zed", "/orgs/acme/users/ben", 401},
+		{"org admin, other org", "eve", "/orgs/globex/users/gus", 404},
+		{"other org's admin, this org", "gus", "/orgs/acme/users/ben", 404},
+		{"org does not exist", "eve", "/orgs/nope/users/ben", 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed", 404},
+		{"user of another org", "eve", "/orgs/acme/users/gus", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserTakesEffect(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d: %s", code, body)
+	}
+
+	// ben's roles in web and legacy are gone: no longer readable as a member.
+	for _, path := range []string{"/projects/web/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, srv, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("ben GET %s: got %d want 404", path, code)
+		}
+	}
+
+	// ben's writes are refused now that they have no role.
+	if code, _ := do(t, srv, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 404 {
+		t.Fatalf("ben PATCH: got %d want 404", code)
+	}
+
+	// Tasks ben was assigned to in those projects are unassigned, not dangling.
+	for _, path := range []string{"/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		code, body := do(t, srv, "GET", path, "eve", "")
+		if code != 200 {
+			t.Fatalf("eve GET %s: got %d", path, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.Assignee != "" {
+			t.Fatalf("%s still assigned to %q", path, task.Assignee)
+		}
+	}
+
+	// Other members and their assignments are untouched.
+	if code, _ := do(t, srv, "PATCH", "/projects/web/tasks/t2", "ann", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ann PATCH t2: got %d want 200", code)
+	}
+	code, body := do(t, srv, "GET", "/projects/web/tasks/t2", "eve", "")
+	if code != 200 {
+		t.Fatal(code)
+	}
+	var t2 Task
+	json.Unmarshal([]byte(body), &t2)
+	if t2.Assignee != "cat" || t2.Status != "done" {
+		t.Fatalf("t2 = %+v, want assignee cat and status done", t2)
+	}
+}
