+type moveRequest struct {
+	ToProjectID string `json:"toProjectId"`
+}
+
+// moveMember moves {uid} from the path project to toProjectId, keeping the role.
+func moveMember(ctx tanukirpc.Context[*projectRegistry], _ struct{}) (*capability.Membership, error) {
+	m, err := ctx.Registry().scope.Members()
+	if err != nil {
+		return nil, err
+	}
+	var req moveRequest
+	if err := decodeBody(ctx.Request(), &req); err != nil || req.ToProjectID == "" {
+		return nil, errInvalidBody
+	}
+	dst, err := ctx.Registry().scope.Actor().Project(req.ToProjectID).Members()
+	if err != nil {
+		return nil, err
+	}
+	out, err := m.MoveTo(chi.URLParam(ctx.Request(), "uid"), dst)
+	if err != nil {
+		return nil, err
+	}
+	return &out, nil
+}
