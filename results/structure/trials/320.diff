+// ---- membership capabilities ---------------------------------------------------
+
+// Membership is the public representation of a project membership.
+type Membership struct {
+	UserID    string `json:"userId"`
+	ProjectID string `json:"projectId"`
+	Role      string `json:"role"`
+}
+
+// ManageMembers may change the membership of one project. It is manager-only.
+type ManageMembers interface {
+	ID() string
+	// MoveTo removes userID from this project and adds them to dst with the
+	// same role. dst must be a ManageMembers for a different project, so the
+	// caller must be a manager of both. Tasks the user holds in this project
+	// are unassigned, because an assignee must be a member of the task's
+	// project. The whole move is one commit.
+	MoveTo(userID string, dst ManageMembers) (Membership, error)
+}
+
+type manageMembers struct{ ps *projectScope }
+
+func (m *manageMembers) ID() string { return m.ps.pid }
+
+func (m *manageMembers) MoveTo(userID string, dst ManageMembers) (Membership, error) {
+	d, ok := dst.(*manageMembers)
+	if !ok {
+		return Membership{}, deny(ErrInvalid, "unknown destination project")
+	}
+	if d.ps.pid == m.ps.pid {
+		return Membership{}, deny(ErrInvalid, "source and destination are the same project")
+	}
+	var out Membership
+	err := m.ps.as.a.st.tx(func(s *state) error {
+		role := s.role(m.ps.pid, userID)
+		if role == "" {
+			return deny(ErrNotFound, "not found")
+		}
+		if s.role(d.ps.pid, userID) != "" {
+			return deny(ErrConflict, "user is already a member of the destination project")
+		}
+		delete(s.members[m.ps.pid], userID)
+		for id, t := range s.tasks {
+			if t.project == m.ps.pid && t.assignee.user == userID {
+				t.assignee = Assignee{project: m.ps.pid}
+				s.tasks[id] = t
+			}
+		}
+		if s.members[d.ps.pid] == nil {
+			s.members[d.ps.pid] = map[string]string{}
+		}
+		s.members[d.ps.pid][userID] = role
+		out = Membership{UserID: userID, ProjectID: d.ps.pid, Role: role}
+		return nil
+	})
+	if err != nil {
+		return Membership{}, err
+	}
+	return out, nil
+}
