diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..dd8380c
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,130 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"testing"
+)
+
+// roleOf reads a member's role straight from the database behind h.
+func roleOf(t *testing.T, h http.Handler, projectID, userID string) string {
+	t.Helper()
+	var role string
+	err := h.(*appHandler).db.QueryRow(
+		`SELECT role FROM memberships WHERE project_id = ? AND user_id = ?`, projectID, userID).Scan(&role)
+	if err != nil {
+		t.Fatalf("roleOf %s/%s: %v", projectID, userID, err)
+	}
+	return role
+}
+
+func TestSetMemberRolesSucceeds(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann",
+		`{"roles":{"dan":"contributor","cat":"manager"}}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	// The response is the project's member list after the change, ordered by user ID.
+	var got []struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("response is not a member list: %v: %s", err, body)
+	}
+	want := []struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}{
+		{"ann", "manager"},
+		{"ben", "contributor"},
+		{"cat", "manager"},
+		{"dan", "contributor"},
+		{"ivy", "manager"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %d members, want %d: %s", len(got), len(want), body)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("member %d: got %+v want %+v", i, got[i], want[i])
+		}
+	}
+	if r := roleOf(t, h, "web", "dan"); r != "contributor" {
+		t.Fatalf("dan's role is %q, want contributor", r)
+	}
+	if r := roleOf(t, h, "web", "cat"); r != "manager" {
+		t.Fatalf("cat's role is %q, want manager", r)
+	}
+}
+
+func TestSetMemberRolesCases(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		// Authorization: only managers of a non-archived project may change roles.
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"manager of another project only", "ann", "ops", `{"roles":{"cat":"viewer"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"unknown project", "ann", "nope", `{"roles":{"dan":"contributor"}}`, 404},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+
+		// Request body: checked before any access decision.
+		{"bad json", "ann", "web", `{"roles":`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"unknown role", "ann", "web", `{"roles":{"dan":"owner"}}`, 400},
+
+		// Targets: every user must be a member of the project.
+		{"user not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"user of another org", "ann", "web", `{"roles":{"gus":"viewer"}}`, 400},
+
+		// Model rule: an assignee must stay a contributor or manager.
+		// ben is assigned task t1 in web, so demoting him to viewer is refused.
+		{"demote assignee to viewer", "ann", "web", `{"roles":{"ben":"viewer"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestSetMemberRolesIsAllOrNothing(t *testing.T) {
+	h := newServer()
+	// dan's change is valid on its own, but ben's is not (he is assigned t1),
+	// so the whole request is refused and dan keeps his role.
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann",
+		`{"roles":{"dan":"contributor","ben":"viewer"}}`)
+	if code != 400 {
+		t.Fatalf("got %d want 400: %s", code, body)
+	}
+	if r := roleOf(t, h, "web", "dan"); r != "viewer" {
+		t.Fatalf("dan's role changed to %q after a refused request", r)
+	}
+	if r := roleOf(t, h, "web", "ben"); r != "contributor" {
+		t.Fatalf("ben's role changed to %q after a refused request", r)
+	}
+}
+
+func TestSetMemberRolesRefusesNonMemberWithoutChanges(t *testing.T) {
+	h := newServer()
+	// hal is not a member of web: the request is refused and dan (a valid target) stays a viewer.
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann",
+		`{"roles":{"dan":"manager","hal":"viewer"}}`)
+	if code != 400 {
+		t.Fatalf("got %d want 400: %s", code, body)
+	}
+	if r := roleOf(t, h, "web", "dan"); r != "viewer" {
+		t.Fatalf("dan's role changed to %q after a refused request", r)
+	}
+}
