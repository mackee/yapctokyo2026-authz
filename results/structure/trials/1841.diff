+// setRolesAggregate changes the roles of some members of one project.
+type setRolesAggregate struct {
+	changes []*roleChange // ordered by user ID
+}
+
+// roleChange is one member's new role. assigned holds the tasks assigned to the
+// member in the project; it is loaded only when the new role is not a writer role.
+type roleChange struct {
+	member   *Membership
+	role     string
+	assigned []*Task
+}
+
+func loadSetRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*setRolesAggregate, error) {
+	userIDs := make([]string, 0, len(roles))
+	for uid := range roles {
+		userIDs = append(userIDs, uid)
+	}
+	sort.Strings(userIDs)
+	a := &setRolesAggregate{}
+	for _, uid := range userIDs {
+		role := roles[uid]
+		if !isValidRole(role) {
+			return nil, deny(ErrInvalid, fmt.Sprintf("invalid role %q for %s", role, uid))
+		}
+		m, err := NewMembershipTable().Find(ctx, tx, projectID, uid)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, fmt.Sprintf("%s is not a member of the project", uid))
+		} else if err != nil {
+			return nil, err
+		}
+		c := &roleChange{member: m, role: role}
+		if !isWriterRole(role) {
+			c.assigned, err = m.AssignedTasks(ctx, tx)
+			if err != nil {
+				return nil, err
+			}
+		}
+		a.changes = append(a.changes, c)
+	}
+	return a, nil
+}
+
+func (a *setRolesAggregate) validate() error {
+	for _, c := range a.changes {
+		if !isWriterRole(c.role) && len(c.assigned) > 0 {
+			return deny(ErrInvalid, fmt.Sprintf("%s is assigned tasks in the project and must stay a contributor or manager", c.member.UserID))
+		}
+	}
+	return nil
+}
+
+func (a *setRolesAggregate) apply(ctx context.Context, tx DB) error {
+	for _, c := range a.changes {
+		if err := c.member.setRole(ctx, tx, c.role); err != nil {
+			return err
+		}
+	}
+	return nil
+}
