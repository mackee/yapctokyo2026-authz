+// setMembersRequest sets the roles of some members. The role values are checked
+// here, before any access decision, since they can be checked without the data.
+type setMembersRequest struct {
+	Roles map[string]string `json:"roles" validate:"required,min=1,dive,oneof=manager contributor viewer"`
+}
+
+// memberResponse is the JSON shape of a project member.
+type memberResponse struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func setMemberRoles(ctx tanukirpc.Context[*projectRegistry], req setMembersRequest) ([]memberResponse, error) {
+	reg := ctx.Registry()
+	members, err := model.NewMembershipTable().SetRoles(ctx, reg.db, reg.authz, model.MembershipTableSetRolesInput{Roles: req.Roles})
+	if err != nil {
+		return nil, err
+	}
+	out := make([]memberResponse, 0, len(members))
+	for _, m := range members {
+		out = append(out, memberResponse{UserID: m.UserID, Role: m.Role})
+	}
+	return out, nil
+}
