 func (a *deleteTaskAggregate) apply(ctx context.Context, tx DB) error { return a.task.destroy(ctx, tx) }
+
+// setRolesAggregate changes the roles of several members of one project.
+type setRolesAggregate struct {
+	// the memberships in the batch, ordered by user ID
+	members []*Membership
+	// user ID -> new role
+	roles map[string]string
+	// user ID -> the member has tasks assigned in the project (set only when the new role is not a writer's)
+	holdsTasks map[string]bool
+}
+
+func loadSetRoles(ctx context.Context, tx DB, projectID string, in MembershipTableSetRolesInput) (*setRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	userIDs := make([]string, 0, len(in.Roles))
+	for uid := range in.Roles {
+		userIDs = append(userIDs, uid)
+	}
+	sort.Strings(userIDs)
+	a := &setRolesAggregate{roles: in.Roles, holdsTasks: map[string]bool{}}
+	for _, uid := range userIDs {
+		m, err := p.Membership(ctx, tx, uid)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "every user in the batch must be a member of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		a.members = append(a.members, m)
+		if !isWriterRole(in.Roles[uid]) {
+			tasks, err := m.AssignedTasks(ctx, tx)
+			if err != nil {
+				return nil, err
+			}
+			a.holdsTasks[uid] = len(tasks) > 0
+		}
+	}
+	return a, nil
+}
+
+func (a *setRolesAggregate) validate() error {
+	for _, m := range a.members {
+		if a.holdsTasks[m.UserID] {
+			return deny(ErrInvalid, "a task is assigned to a member whose new role cannot be assigned tasks")
+		}
+	}
+	return nil
+}
+
+func (a *setRolesAggregate) apply(ctx context.Context, tx DB) error {
+	for _, m := range a.members {
+		if err := m.changeRole(ctx, tx, a.roles[m.UserID]); err != nil {
+			return err
+		}
+	}
+	return nil
+}
