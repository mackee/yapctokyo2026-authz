+func TestSetMemberRoles(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager", "ann", "web", `{"roles":{"dan":"contributor","ivy":"contributor"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"dan":"viewer"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"dan":"viewer"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"viewer"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"dan":"viewer"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"dan":"viewer"}}`, 401},
+		{"unknown user", "zed", "web", `{"roles":{"dan":"viewer"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"target not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"target in other org", "ann", "web", `{"roles":{"gus":"viewer"}}`, 400},
+		{"assignee would lose writer role", "ann", "web", `{"roles":{"ben":"viewer"}}`, 400},
+		{"invalid role", "ann", "web", `{"roles":{"dan":"owner"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"bad json", "ann", "web", `not json`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMemberRolesResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann",
+		`{"roles":{"dan":"contributor","ivy":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got []memberRole
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []memberRole{
+		{UserID: "ann", Role: "manager"},
+		{UserID: "ben", Role: "contributor"},
+		{UserID: "cat", Role: "contributor"},
+		{UserID: "dan", Role: "contributor"},
+		{UserID: "ivy", Role: "contributor"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %d members, want %d: %s", len(got), len(want), body)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("member %d: got %+v want %+v", i, got[i], want[i])
+		}
+	}
+}
+
+func TestSetMemberRolesAllOrNothing(t *testing.T) {
+	h := newServer()
+	// dan's change is valid, but ben holds a task (t1) and cannot become a viewer:
+	// the whole batch is rejected.
+	code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","ben":"viewer"}}`)
+	if code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	// A later successful call shows that dan is still a viewer.
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ivy":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got []memberRole
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	roles := map[string]string{}
+	for _, m := range got {
+		roles[m.UserID] = m.Role
+	}
+	if roles["dan"] != "viewer" || roles["ben"] != "contributor" || roles["ivy"] != "contributor" {
+		t.Fatalf("batch was partly applied: %v", roles)
+	}
+}
