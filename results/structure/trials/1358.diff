+  // Members of p listed in `roles` get their new role. A member who is demoted to
+  // viewer is unassigned from p's tasks (keeps inv_assigneeIsWriter).
+  action setRoles(u: UserId, p: ProjectId, roles: UserId -> Role): bool =
+    if (setRolesOutcome(u, p, roles) == 200) all {
+      members' = members.keys().mapBy(k =>
