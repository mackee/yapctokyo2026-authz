+  // PUT /projects/{pid}/members {"roles": {user: role, ...}}
+  // Only managers may change roles. All-or-nothing: any invalid entry rejects the
+  // whole request. The project must keep at least one manager.
+  def setRolesOutcome(u: UserId, p: ProjectId, roles: UserId -> Role): int =
+    if (not(userExists(u))) 401
+    else if (not(canRead(u, p))) 404
+    else if (roleOf(p, u) != "manager") 403
+    else if (projects.get(p).archived) 409
+    else if (roles.keys().size() == 0 or roles.keys().exists(k => not(ROLES.contains(roles.get(k))))) 400
+    else if (roles.keys().exists(k => roleOf(p, k) == "")) 404
+    else if (not(USERS.exists(x => newRoleOf(p, x, roles) == "manager"))) 409
+    else 200
+
