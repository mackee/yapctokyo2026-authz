index 0000000..ea329a5
--- /dev/null
+++ b/members.go
@@ -0,0 +1,143 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+)
+
+type setRolesRequest struct {
+	Roles map[string]string `json:"roles"`
+}
+
+type memberView struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// setRoles implements PUT /projects/{pid}/members (model: setRolesOutcome and
+// setRoles in spec/taskboard.qnt). Only managers may call it. It is
+// all-or-nothing, and a member demoted to viewer is unassigned from the
+// project's tasks.
+func (s *server) setRoles(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role, err := findRole(ctx, s.db, project.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req setRolesRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || len(req.Roles) == 0 {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	for _, newRole := range req.Roles {
+		if newRole != RoleManager && newRole != RoleContributor && newRole != RoleViewer {
+			writeError(w, 400, "invalid role")
+			return
+		}
+	}
+
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+
+	current := map[string]string{}
+	rows, err := tx.QueryContext(ctx, `SELECT user_id, role FROM memberships WHERE project_id = ? ORDER BY user_id`, project.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	var order []string
+	for rows.Next() {
+		var uid, rl string
+		if err := rows.Scan(&uid, &rl); err != nil {
+			rows.Close()
+			writeError(w, 500, "internal error")
+			return
+		}
+		current[uid] = rl
+		order = append(order, uid)
+	}
+	rows.Close()
+	if err := rows.Err(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+
+	for uid := range req.Roles {
+		if _, ok := current[uid]; !ok {
+			writeError(w, 404, "member not found: "+uid)
+			return
+		}
+	}
+	managers := 0
+	for uid, rl := range current {
+		if nr, ok := req.Roles[uid]; ok {
+			rl = nr
+		}
+		if rl == RoleManager {
+			managers++
+		}
+	}
+	if managers == 0 {
+		writeError(w, 409, "project must keep at least one manager")
+		return
+	}
+
+	for uid, nr := range req.Roles {
+		if _, err := tx.ExecContext(ctx, `UPDATE memberships SET role = ? WHERE project_id = ? AND user_id = ?`, nr, project.ID, uid); err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+		current[uid] = nr
+		if nr == RoleViewer {
+			if _, err := tx.ExecContext(ctx, `UPDATE tasks SET assignee = '' WHERE project_id = ? AND assignee = ?`, project.ID, uid); err != nil {
+				writeError(w, 500, "internal error")
+				return
+			}
+		}
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+
+	members := make([]memberView, 0, len(order))
+	for _, uid := range order {
+		members = append(members, memberView{UserID: uid, Role: current[uid]})
+	}
+	writeJSON(w, 200, members)
+}
diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..70c5c2e
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,104 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestSetRolesStatus(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager ok", "ann", "web", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 200},
+		{"anonymous", "", "web", `{"roles":{"ben":"viewer"}}`, 401},
+		{"unknown user", "zed", "web", `{"roles":{"ben":"viewer"}}`, 401},
+		{"non member", "hal", "web", `{"roles":{"ben":"viewer"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"ben":"viewer"}}`, 404},
+		{"missing project", "ann", "nope", `{"roles":{"ben":"viewer"}}`, 404},
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"invalid role", "ann", "web", `{"roles":{"ben":"boss"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"no roles", "ann", "web", `{}`, 400},
+		{"bad json", "ann", "web", `nope`, 400},
+		{"non member target", "ann", "web", `{"roles":{"hal":"viewer"}}`, 404},
+		{"other org target", "ann", "web", `{"roles":{"gus":"viewer"}}`, 404},
+		{"last manager", "ann", "web", `{"roles":{"ann":"viewer","ivy":"viewer"}}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d (%s)", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestSetRolesResult(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got []memberView
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []memberView{
+		{"ann", "manager"}, {"ben", "viewer"}, {"cat", "contributor"}, {"dan", "contributor"}, {"ivy", "manager"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("got %v want %v", got, want)
+		}
+	}
+
+	// dan is now a contributor and can create tasks; ben (viewer) cannot, and
+	// was unassigned from t1 so the assignee invariant still holds.
+	if c, b := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); c != 200 {
+		t.Fatal(c, b)
+	}
+	if c, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); c != 403 {
+		t.Fatal(c)
+	}
+	_, tb := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(tb), &task)
+	if task.Assignee != "" {
+		t.Fatalf("t1 assignee = %q, want unassigned", task.Assignee)
+	}
+}
+
+func TestSetRolesAllOrNothing(t *testing.T) {
+	h := newServer()
+	code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","hal":"viewer"}}`)
+	if code != 404 {
+		t.Fatal(code)
+	}
+	code, _ = do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"boss"}}`)
+	if code != 400 {
+		t.Fatal(code)
+	}
+	// ben is still a contributor on t1.
+	if c, b := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"doing"}`); c != 200 {
+		t.Fatal(c, b)
+	}
+}
+
+func TestSetRolesOtherProjectUntouched(t *testing.T) {
+	h := newServer()
+	if c, b := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"cat":"viewer"}}`); c != 200 {
+		t.Fatal(c, b)
+	}
+	// cat remains a contributor (and keeps t4) in ops.
+	if c, b := do(t, h, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"doing"}`); c != 200 {
+		t.Fatal(c, b)
+	}
+}
