+        if (x.project == p and x.assignee != "" and
+            not(Set("contributor", "manager").contains(newRoleOf(p, x.assignee, roles))))
+          { ...x, assignee: "" }
+        else x
+      }),
+      nextTask' = nextTask,
+      users' = users,
+      projects' = projects,
+    } else unchanged
+
