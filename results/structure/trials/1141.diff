+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager removes contributor", "ann", "/projects/web/members/ben", 204},
+		{"manager removes manager", "ann", "/projects/web/members/ivy", 204},
+		{"manager removes viewer", "ann", "/projects/web/members/dan", 204},
+		{"contributor", "ben", "/projects/web/members/cat", 403},
+		{"viewer", "dan", "/projects/web/members/cat", 403},
+		{"org admin non member", "eve", "/projects/web/members/ben", 403},
+		{"non member", "hal", "/projects/web/members/ben", 404},
+		{"other org", "gus", "/projects/web/members/ben", 404},
+		{"anonymous", "", "/projects/web/members/ben", 401},
+		{"unknown user", "zed", "/projects/web/members/ben", 401},
+		{"target not a member", "ann", "/projects/web/members/hal", 404},
+		{"missing project", "ann", "/projects/missing/members/ben", 404},
+		{"archived", "ann", "/projects/legacy/members/ben", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d (body %q)", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestRemoveMemberEffects(t *testing.T) {
+	h := newServer()
+
+	// ben holds t1 in web as a contributor.
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("setup: got %d", code)
+	}
+	var before Task
+	json.Unmarshal([]byte(body), &before)
+	if before.Assignee != "ben" {
+		t.Fatalf("setup: assignee %q want ben", before.Assignee)
+	}
+
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+
+	// The removed member loses access to the project.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("removed member read: got %d want 404", code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 404 {
+		t.Fatalf("removed member write: got %d want 404", code)
+	}
+
+	// Their task in the project is unassigned, not left pointing at a non-member.
+	code, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("after remove: got %d", code)
+	}
+	var after Task
+	json.Unmarshal([]byte(body), &after)
+	if after.Assignee != "" {
+		t.Fatalf("assignee %q after removal, want unassigned", after.Assignee)
+	}
+
+	// Removing again is a 404: the membership is gone.
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 404 {
+		t.Fatalf("second remove: got %d want 404", code)
+	}
+
+	// Removal is scoped to the project: ben's membership in legacy is untouched.
+	if code, _ := do(t, h, "GET", "/projects/legacy/tasks", "ben", ""); code != 200 {
+		t.Fatalf("other project read: got %d want 200", code)
+	}
+}
+
+func TestRemoveMemberKeepsOtherTasks(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/projects/ops/members/cat", "ivy", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+	// t4 in ops was assigned to cat and is cleared; t2 (web, also cat) is untouched.
+	code, body := do(t, h, "GET", "/projects/web/tasks/t2", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d", code)
+	}
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "cat" {
+		t.Fatalf("web task assignee %q want cat", task.Assignee)
+	}
+	code, body = do(t, h, "GET", "/projects/ops/tasks/t4", "ivy", "")
+	if code != 200 {
+		t.Fatalf("got %d", code)
+	}
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" {
+		t.Fatalf("ops task assignee %q want unassigned", task.Assignee)
+	}
+}
