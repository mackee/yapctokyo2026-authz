+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager removes contributor", "ann", "/projects/web/members/ben", 204},
+		{"manager removes viewer", "ann", "/projects/web/members/dan", 204},
+		{"contributor", "ben", "/projects/web/members/cat", 403},
+		{"viewer", "dan", "/projects/web/members/ben", 403},
+		{"org admin without role", "eve", "/projects/web/members/ben", 403},
+		{"non member", "hal", "/projects/web/members/ben", 404},
+		{"other org", "gus", "/projects/web/members/ben", 404},
+		{"anonymous", "", "/projects/web/members/ben", 401},
+		{"target not a member", "ann", "/projects/web/members/hal", 404},
+		{"archived", "ann", "/projects/legacy/members/ben", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveMemberEffects(t *testing.T) {
+	h := newServer()
+	getTask := func(project, id string) Task {
+		t.Helper()
+		code, body := do(t, h, "GET", "/projects/"+project+"/tasks/"+id, "ann", "")
+		if code != 200 {
+			t.Fatalf("get %s/%s: got %d", project, id, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		return task
+	}
+
+	// A refused removal changes nothing.
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "cat", ""); code != 403 {
+		t.Fatalf("contributor removal: got %d want 403", code)
+	}
+	if got := getTask("web", "t1").AssigneeID; got != "ben" {
+		t.Fatalf("refused removal unassigned t1: assignee %q", got)
+	}
+
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 204 {
+		t.Fatalf("manager removal: got %d want 204", code)
+	}
+
+	// The removed member's tasks in the project are unassigned; others are kept.
+	if got := getTask("web", "t1").AssigneeID; got != "" {
+		t.Fatalf("t1 still assigned to %q after removal", got)
+	}
+	if got := getTask("web", "t2").AssigneeID; got != "cat" {
+		t.Fatalf("t2 assignee changed to %q", got)
+	}
+	// The same user's tasks in another project are not touched.
+	if got := getTask("legacy", "t5").AssigneeID; got != "ben" {
+		t.Fatalf("legacy t5 assignee changed to %q", got)
+	}
+
+	// The removed user is no longer a member: no access to the project.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("removed member reads web: got %d want 404", code)
+	}
+	// And a second removal finds no membership.
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 404 {
+		t.Fatalf("second removal: got %d want 404", code)
+	}
+}
