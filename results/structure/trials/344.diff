+// freezeProjectAggregate moves every member of one project to the viewer role.
+type freezeProjectAggregate struct {
+	members []membershipRecord // already set to RoleViewer, sorted by user ID
+}
+
+func loadFreezeProject(x *tx, projectID string) (*freezeProjectAggregate, error) {
+	if _, ok := x.findProject(projectID); !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	a := &freezeProjectAggregate{members: x.membershipsOf(projectID)}
+	for i := range a.members {
+		a.members[i].Role = RoleViewer
+	}
+	return a, nil
+}
+
+func (a *freezeProjectAggregate) validate() error { return nil }
+
+func (a *freezeProjectAggregate) save(x *tx) []MemberView {
+	out := make([]MemberView, 0, len(a.members))
+	for _, m := range a.members {
+		m.save(x)
+		out = append(out, m.view())
+	}
+	return out
+}
