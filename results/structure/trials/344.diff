+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown project", "ann", "nope", 404},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got []struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []string{"ann", "ben", "cat", "dan", "ivy"}
+	if len(got) != len(want) {
+		t.Fatalf("got %d members, want %d: %s", len(got), len(want), body)
+	}
+	for i, u := range want {
+		if got[i].UserID != u || got[i].Role != "viewer" {
+			t.Fatalf("member %d: got %+v, want {%s viewer}: %s", i, got[i], u, body)
+		}
+	}
+}
+
+func TestFreezeBlocksTaskChanges(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d: %s", code, body)
+	}
+
+	cases := []struct {
+		name, method, user, path, body string
+		want                           int
+	}{
+		{"contributor create", "POST", "ben", "/projects/web/tasks", `{"title":"x","assignee":"ben"}`, 403},
+		{"manager create", "POST", "ann", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"contributor own edit", "PATCH", "ben", "/projects/web/tasks/t1", `{"status":"done"}`, 403},
+		{"manager edit", "PATCH", "ann", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"manager delete", "DELETE", "ann", "/projects/web/tasks/t1", "", 403},
+		{"freeze again", "POST", "ann", "/projects/web/freeze", "", 403},
+		{"read still works", "GET", "ann", "/projects/web/tasks/t1", "", 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, srv, c.method, c.path, c.user, c.body)
