+// Move moves the task to another project, all or nothing. The task keeps its
+// ID, title, status and assignee. A destination the actor cannot read is
+// ErrNotFound.
+func (*TaskTable) Move(ctx context.Context, db DB, authz TaskAuthz, in TaskTableMoveInput) (*Task, error) {
+	if err := authz.CanManage(); err != nil {
+		return nil, err
+	}
+	if in.ToProjectID == authz.Project().ProjectID() {
+		return nil, deny(ErrInvalid, "task is already in that project")
+	}
+	var t *Task
+	if err := inTx(ctx, db, func(tx DB) error {
+		dest, err := NewProjectAuthz(ctx, tx, authz.Project().Actor(), in.ToProjectID)
+		if err != nil {
+			return err
+		}
+		if err := authz.CanMove(dest); err != nil {
+			return err
+		}
+		agg, err := loadMoveTask(ctx, tx, authz.TaskID(), in.ToProjectID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if t, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return t, nil
+}
