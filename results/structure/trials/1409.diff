index 89224a1..daa1233 100644
--- a/internal/model/authz.go
+++ b/internal/model/authz.go
@@ -121,6 +121,29 @@ func (a TaskAuthz) CanManage() error {
 	return nil
 }
 
+// CanMove returns nil if the actor may move the task to the destination
+// project: the actor must be able to delete the task from its project
+// (CanManage), and be a manager of the destination, which must not be archived.
+// The destination's authorization object exists only if the actor can read it.
+func (a TaskAuthz) CanMove(dest ProjectAuthz) error {
+	if err := a.CanManage(); err != nil {
+		return err
+	}
+	if dest.project == a.project.project {
+		return deny(ErrInvalid, "task is already in that project")
+	}
+	if !dest.CanRead() {
+		return deny(ErrNotFound, "not found")
+	}
+	if dest.role != RoleManager {
+		return deny(ErrForbidden, "only managers may move tasks into the project")
+	}
+	if dest.archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	return nil
+}
