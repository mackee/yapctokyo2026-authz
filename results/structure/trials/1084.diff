+
+// Move moves the user from the authorized project to another project of the
+// same organization, keeping the role. The actor must be a manager of both
+// projects. Tasks the user holds in the source project are unassigned, since
+// the user is no longer a member there.
+func (mt *MembershipTable) Move(ctx context.Context, db DB, from ProjectAuthz, userID string, in MembershipTableMoveInput) (*Membership, error) {
+	if in.ToProjectID == from.ProjectID() {
+		return nil, deny(ErrInvalid, "destination must be a different project")
+	}
+	if err := from.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		to, err := NewProjectAuthz(ctx, tx, from.Actor(), in.ToProjectID)
+		if err != nil {
+			return err
+		}
+		if err := to.CanManageMembers(); err != nil {
+			return err
+		}
+		agg, err := loadMoveMember(ctx, tx, from.ProjectID(), userID, to.ProjectID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if m, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
