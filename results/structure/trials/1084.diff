new file mode 100644
index 0000000..2f197dc
--- /dev/null
+++ b/move_test.go
@@ -0,0 +1,102 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestMoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, project, uid, body string
+		want                           int
+	}{
+		{"manager of both projects", "ivy", "web", "ben", `{"toProjectId":"ops"}`, 200},
+		{"manager of source, viewer of destination", "ann", "web", "ben", `{"toProjectId":"ops"}`, 403},
+		{"contributor", "ben", "web", "cat", `{"toProjectId":"ops"}`, 403},
+		{"viewer", "dan", "web", "ben", `{"toProjectId":"ops"}`, 403},
+		{"org admin without role", "eve", "web", "ben", `{"toProjectId":"ops"}`, 403},
+		{"non member", "hal", "web", "ben", `{"toProjectId":"ops"}`, 404},
+		{"other org", "gus", "web", "ben", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "web", "ben", `{"toProjectId":"ops"}`, 401},
+		{"unknown user", "zed", "web", "ben", `{"toProjectId":"ops"}`, 401},
+		{"destination missing", "ivy", "web", "ben", `{"toProjectId":"nope"}`, 404},
+		{"destination in other org", "ivy", "web", "ben", `{"toProjectId":"gx"}`, 404},
+		{"destination not readable", "ivy", "web", "ben", `{"toProjectId":"legacy"}`, 404},
+		{"same project", "ivy", "web", "ben", `{"toProjectId":"web"}`, 400},
+		{"missing destination", "ivy", "web", "ben", `{}`, 400},
+		{"user not in source", "ivy", "web", "hal", `{"toProjectId":"ops"}`, 404},
+		{"user already in destination", "ivy", "web", "cat", `{"toProjectId":"ops"}`, 409},
+		{"archived source", "ann", "legacy", "ben", `{"toProjectId":"web"}`, 409},
+		{"archived destination", "ann", "web", "cat", `{"toProjectId":"legacy"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", "/projects/"+c.project+"/members/"+c.uid+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestMoveMemberResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got struct {
+		UserID    string `json:"userId"`
+		ProjectID string `json:"projectId"`
+		Role      string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.UserID != "ben" || got.ProjectID != "ops" || got.Role != "contributor" {
+		t.Fatalf("got %+v", got)
+	}
+}
+
+func TestMoveMemberEffects(t *testing.T) {
+	srv := newServer()
+
+	// ben leaves web, where he holds t1, and joins ops as a contributor.
+	if code, body := do(t, srv, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`); code != 200 {
+		t.Fatalf("move: got %d body=%s", code, body)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads web after move: got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben reads ops after move: got %d want 200", code)
+	}
+	if code, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ann", ""); code != 200 {
+		t.Fatalf("get t1: got %d body=%s", code, body)
+	} else {
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.AssigneeID != "" {
+			t.Fatalf("t1 still assigned to %q after ben left web", task.AssigneeID)
+		}
+	}
+	if code, body := do(t, srv, "POST", "/projects/ops/tasks", "ben", `{"title":"x","assignee":"ben"}`); code != 200 {
+		t.Fatalf("contributor role not kept in ops: got %d body=%s", code, body)
+	}
+}
+
+func TestMoveMemberFailureChangesNothing(t *testing.T) {
+	srv := newServer()
+
+	// cat is already in ops, so the move is refused and cat stays in web.
+	if code, _ := do(t, srv, "POST", "/projects/web/members/cat/move", "ivy", `{"toProjectId":"ops"}`); code != 409 {
+		t.Fatalf("move: got %d want 409", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat reads web after refused move: got %d want 200", code)
+	}
+	if code, body := do(t, srv, "GET", "/projects/web/tasks/t2", "cat", ""); code != 200 {
+		t.Fatalf("cat's t2 after refused move: got %d body=%s", code, body)
+	}
+}
