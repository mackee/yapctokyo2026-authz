+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestFreeze(t *testing.T) {
+	h := newServer()
+	for _, c := range []struct {
+		user, pid string
+		want      int
+	}{
+		{"", "web", 401},
+		{"gus", "web", 404}, // other org
+		{"eve", "web", 403}, // org admin, not a member
+		{"ben", "web", 403}, // contributor
+		{"dan", "web", 403}, // viewer
+		{"ann", "legacy", 409},
+		{"ann", "nope", 404},
+	} {
+		if code, body := do(t, h, "POST", "/projects/"+c.pid+"/freeze", c.user, ""); code != c.want {
+			t.Errorf("%s freeze %s: got %d want %d (%s)", c.user, c.pid, code, c.want, body)
+		}
+	}
+
+	// failed attempts must not have changed anything
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"doing"}`); code != 200 {
+		t.Fatalf("pre-freeze update: got %d", code)
+	}
+
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("freeze: got %d (%s)", code, body)
+	}
+	var got []map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 5 {
+		t.Fatalf("want 5 members, got %v", got)
+	}
+	for _, m := range got {
+		if m["role"] != "viewer" || m["userId"] == "" {
+			t.Errorf("bad member %v", m)
+		}
+	}
+
+	// nobody can modify tasks any more; members can still read
+	for _, u := range []string{"ann", "ivy", "ben", "cat", "dan"} {
+		if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", u, `{"status":"done"}`); code != 403 {
+			t.Errorf("%s update after freeze: got %d", u, code)
+		}
+		if code, _ := do(t, h, "POST", "/projects/web/tasks", u, `{"title":"x"}`); code != 403 {
+			t.Errorf("%s create after freeze: got %d", u, code)
+		}
+		if code, _ := do(t, h, "DELETE", "/projects/web/tasks/t1", u, ""); code != 403 {
+			t.Errorf("%s delete after freeze: got %d", u, code)
+		}
+		if code, _ := do(t, h, "GET", "/projects/web/tasks", u, ""); code != 200 {
+			t.Errorf("%s read after freeze: got %d", u, code)
+		}
+	}
+
+	// other projects are untouched
+	if code, _ := do(t, h, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"doing"}`); code != 200 {
+		t.Errorf("ops should be unaffected: got %d", code)
+	}
+}
