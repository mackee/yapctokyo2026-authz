+// TestFreezeAccess: only a project's managers may freeze it. Other callers get
+// the usual statuses (404 unreadable, 403 readable but not a manager, 401
+// anonymous, 409 archived).
+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"other manager", "ivy", "ops", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+		{"unknown project", "ann", "nope", 404},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+// TestFreezeResponse: the response is the project's members after the change,
+// ordered by user ID, every role set to viewer (managers included), with only
+// userId and role in each entry.
+func TestFreezeResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got []map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("bad body %q: %v", body, err)
+	}
+	want := []map[string]string{
+		{"userId": "ann", "role": "viewer"},
+		{"userId": "ben", "role": "viewer"},
+		{"userId": "cat", "role": "viewer"},
+		{"userId": "dan", "role": "viewer"},
+		{"userId": "ivy", "role": "viewer"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %v\nwant %v", got, want)
+	}
+}
+
+// TestFreezeBlocksTaskWrites: after a freeze nobody can change the project's
+// tasks, managers included. Reads still work.
+func TestFreezeBlocksTaskWrites(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d want 200: %s", code, body)
+	}
+	cases := []struct {
+		name, user, method, path, body string
+		want                           int
+	}{
+		{"manager create", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"contributor create", "ben", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"manager update", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"contributor own update", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`, 403},
+		{"manager delete", "ann", "DELETE", "/projects/web/tasks/t1", "", 403},
+		{"read list", "ben", "GET", "/projects/web/tasks", "", 200},
+		{"read task", "ben", "GET", "/projects/web/tasks/t1", "", 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, h, c.method, c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+		})
+	}
+}
