+// Freeze makes every member of the project a viewer, managers included, so
+// nobody can change the project's tasks afterwards. It returns the members
+// after the change, ordered by user ID.
+func (*ProjectTable) Freeze(ctx context.Context, db DB, authz ProjectAuthz) ([]*Membership, error) {
+	if err := authz.CanFreeze(); err != nil {
+		return nil, err
+	}
+	var members []*Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadFreezeProject(ctx, tx, authz.ProjectID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if members, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return members, nil
+}
