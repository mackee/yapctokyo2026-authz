@@ -0,0 +1,77 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestFreeze(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got []map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []string{"ann", "ben", "cat", "dan", "ivy"}
+	if len(got) != len(want) {
+		t.Fatalf("members = %v", got)
+	}
+	for i, m := range got {
+		if m["userId"] != want[i] || m["role"] != "viewer" || len(m) != 2 {
+			t.Fatalf("member %d = %v", i, m)
+		}
+	}
+
+	// nobody can change tasks any more
+	for _, c := range []struct{ user, method, path, body string }{
+		{"ann", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"ann", "DELETE", "/projects/web/tasks/t3", ""},
+		{"ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"ivy", "DELETE", "/projects/web/tasks/t1", ""},
+		{"eve", "POST", "/projects/web/tasks", `{"title":"x"}`},
+	} {
+		if code, body := do(t, h, c.method, c.path, c.user, c.body); code != 403 {
+			t.Errorf("%s %s by %s: got %d body=%s", c.method, c.path, c.user, code, body)
+		}
+	}
+	// reads still work, other projects untouched
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "dan", ""); code != 200 {
+		t.Errorf("read after freeze: %d", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/ops/tasks", "cat", `{"title":"x"}`); code != 200 {
+		t.Errorf("other project affected: %d", code)
+	}
+}
+
+func TestFreezeDenied(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"contributor", "ben", "/projects/web/freeze", 403},
+		{"viewer", "dan", "/projects/web/freeze", 403},
+		{"org admin", "eve", "/projects/web/freeze", 403},
+		{"non member", "hal", "/projects/web/freeze", 404},
+		{"other org", "gus", "/projects/web/freeze", 404},
+		{"unauthenticated", "", "/projects/web/freeze", 401},
+		{"archived", "ann", "/projects/legacy/freeze", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			if code, body := do(t, h, "POST", c.path, c.user, ""); code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+			// a denied freeze changes nothing
+			if c.want != 404 && c.name != "unauthenticated" && c.name != "archived" {
+				if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t2", "ann", `{"status":"done"}`); code != 200 {
+					t.Fatalf("project was frozen by a denied request: %d", code)
+				}
+			}
+		})
+	}
+}
