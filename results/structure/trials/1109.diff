+func freezeProject(ctx tanukirpc.Context[*projectRegistry], _ struct{}) ([]memberResponse, error) {
+	reg := ctx.Registry()
+	ms, err := model.NewProjectTable().Freeze(ctx, reg.db, reg.authz)
+	if err != nil {
+		return nil, err
+	}
+	out := make([]memberResponse, 0, len(ms))
+	for _, m := range ms {
+		out = append(out, memberResponse{UserID: m.UserID, Role: m.Role})
+	}
+	return out, nil
+}
