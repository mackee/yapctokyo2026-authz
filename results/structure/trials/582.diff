+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+	// ben: contributor in web and legacy (archived); assigned t1 (web), t5 (legacy).
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d", code)
+	}
+	// Lost access to every project, archived included.
+	for _, p := range []string{"web", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ben", ""); code != 404 {
+			t.Fatalf("%s: ben still reads: got %d", p, code)
+		}
+	}
+	// Their tasks are unassigned, not left pointing at a non-member.
+	for _, c := range []struct{ path, user string }{{"/projects/web/tasks/t1", "ann"}, {"/projects/legacy/tasks/t5", "ann"}} {
+		code, body := do(t, h, "GET", c.path, c.user, "")
+		if code != 200 || !strings.Contains(body, `"assignee":""`) {
+			t.Fatalf("%s: got %d %s", c.path, code, body)
+		}
+	}
+	// Others are untouched.
+	if code, body := do(t, h, "GET", "/projects/web/tasks/t2", "ann", ""); code != 200 || !strings.Contains(body, `"assignee":"cat"`) {
+		t.Fatalf("t2: got %d %s", code, body)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat lost access: got %d", code)
+	}
+	// Removing again: the user still exists, so it is idempotent.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("second remove: got %d", code)
+	}
+}
