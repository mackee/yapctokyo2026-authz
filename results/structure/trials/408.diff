+// setMemberRoleAggregate changes the role of one member of one project.
+type setMemberRoleAggregate struct {
+	membership *Membership // project.Membership(user); the user must be a member
+	role       string
+}
+
+func loadSetMemberRole(ctx context.Context, x *Tx, projectID, userID, role string) (*setMemberRoleAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, x, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	m, err := p.Membership(ctx, x, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	return &setMemberRoleAggregate{membership: m, role: role}, nil
+}
+
+func (a *setMemberRoleAggregate) validate() error {
+	if !validRoles[a.role] {
+		return deny(ErrInvalid, "role must be manager, contributor or viewer")
+	}
+	return nil
+}
+
+func (a *setMemberRoleAggregate) apply(ctx context.Context, x *Tx) (*Membership, error) {
+	if err := a.membership.setRole(ctx, x, a.role); err != nil {
+		return nil, err
+	}
+	return a.membership, nil
+}
