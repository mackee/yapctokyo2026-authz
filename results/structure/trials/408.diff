+func TestSetMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager demotes contributor", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 200},
+		{"manager promotes contributor", "ann", "/projects/web/members/cat", `{"role":"manager"}`, 200},
+		{"manager changes manager", "ann", "/projects/web/members/ivy", `{"role":"contributor"}`, 200},
+		{"manager sets same role", "ann", "/projects/web/members/ben", `{"role":"contributor"}`, 200},
+		{"contributor self", "ben", "/projects/web/members/ben", `{"role":"manager"}`, 403},
+		{"contributor other", "ben", "/projects/web/members/cat", `{"role":"viewer"}`, 403},
+		{"viewer self", "dan", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"org admin", "eve", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"non member", "hal", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"other org", "gus", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"anonymous", "", "/projects/web/members/ben", `{"role":"viewer"}`, 401},
+		{"unknown user", "zed", "/projects/web/members/ben", `{"role":"viewer"}`, 401},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"target member of another project", "ivy", "/projects/ops/members/ben", `{"role":"viewer"}`, 404},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"invalid role", "ann", "/projects/web/members/ben", `{"role":"owner"}`, 400},
+		{"empty role", "ann", "/projects/web/members/ben", `{"role":""}`, 400},
+		{"missing role", "ann", "/projects/web/members/ben", `{}`, 400},
+		{"bad json", "ann", "/projects/web/members/ben", `{"role":`, 400},
+		{"malformed body before access", "hal", "/projects/web/members/ben", `{"role":"owner"}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMemberRoleResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.UserID != "ben" || got.Role != "viewer" {
+		t.Fatalf("got %+v", got)
+	}
+}
+
+func TestSetMemberRoleTakesEffect(t *testing.T) {
+	srv := newServer()
+
+	// ben (contributor) cannot promote himself, and keeps write access.
+	if code, _ := do(t, srv, "PUT", "/projects/web/members/ben", "ben", `{"role":"manager"}`); code != 403 {
+		t.Fatalf("self-promotion: got %d want 403", code)
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 200 {
+		t.Fatalf("contributor create after refused change: got %d want 200", code)
+	}
+
+	// Demoted to viewer, ben loses write access but can still read.
+	if code, _ := do(t, srv, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Fatalf("viewer create: got %d want 403", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("viewer read: got %d want 200", code)
+	}
+
+	// Promoted back, ben can write again and be assigned tasks.
+	if code, _ := do(t, srv, "PUT", "/projects/web/members/ben", "ann", `{"role":"contributor"}`); code != 200 {
+		t.Fatalf("promote: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "ann", `{"title":"x","assignee":"ben"}`); code != 200 {
+		t.Fatalf("assign after promote: got %d want 200", code)
+	}
+}
