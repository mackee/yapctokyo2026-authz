+  // POST /projects/{pid}/members/{uid}/move {"toProjectId": dest}
+  // Moves a member from p to dest with the same role. The mover must be a
+  // manager of both projects. Tasks the member holds in p are unassigned, so
+  // that an assignee stays a writer of the task's project.
+  def moveOutcome(u: UserId, p: ProjectId, target: UserId, dest: ProjectId): int =
+    if (not(userExists(u))) 401
+    else if (not(canRead(u, p))) 404
+    else if (roleOf(p, target) == "") 404
+    else if (roleOf(p, u) != "manager") 403
+    else if (projects.get(p).archived) 409
+    else if (dest == p) 400
+    else if (not(projectExists(dest)) or projects.get(dest).org != users.get(u).org) 404
+    else if (not(canRead(u, dest))) 404
+    else if (roleOf(dest, u) != "manager") 403
+    else if (projects.get(dest).archived) 409
+    else if (roleOf(dest, target) != "") 409
+    else 200
+
   // ---- actions -------------------------------------------------------------
 
   action unchanged = all {
@@ -164,6 +182,19 @@ module taskboard {
       members' = members,
     } else unchanged
 
+  action moveMember(u: UserId, p: ProjectId, target: UserId, dest: ProjectId): bool =
+    if (moveOutcome(u, p, target, dest) == 200) all {
+      members' = members.keys().exclude(Set((p, target))).mapBy(k => members.get(k)).put((dest, target), roleOf(p, target)),
+      tasks' = tasks.keys().mapBy(k =>
+        if (tasks.get(k).project == p and tasks.get(k).assignee == target)
+          { ...tasks.get(k), assignee: "" }
+        else tasks.get(k)
+      ),
+      nextTask' = nextTask,
+      users' = users,
+      projects' = projects,
+    } else unchanged
+
