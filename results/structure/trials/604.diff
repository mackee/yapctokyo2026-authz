+// Move removes the user from the project of authz and adds them, with the same
+// role, to the destination project. The actor must be a manager of both
+// projects (the destination must be readable by the actor, else ErrNotFound).
+func (*MembershipTable) Move(ctx context.Context, db DB, authz ProjectAuthz, userID, toProjectID string) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	toAuthz, err := NewProjectAuthz(ctx, db, authz.Actor(), toProjectID)
+	if err != nil {
+		return nil, err
+	}
+	if err := toAuthz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveMember(ctx, tx, authz.ProjectID(), userID, toProjectID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(ctx, tx); err != nil {
+			return err
+		}
+		if m, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
