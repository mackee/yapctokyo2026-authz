diff --git a/transfer_test.go b/transfer_test.go
new file mode 100644
index 0000000..2a43712
--- /dev/null
+++ b/transfer_test.go
@@ -0,0 +1,123 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestTransferUser(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 200},
+		{"anonymous", "", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 401},
+		{"not an admin", "ann", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 403},
+		{"admin of another org path", "eve", "/orgs/globex/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"user of another org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"unknown destination", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"nowhere"}`, 400},
+		{"same org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"acme"}`, 400},
+		{"missing field", "eve", "/orgs/acme/users/ben/transfer", `{}`, 400},
+		{"bad json", "eve", "/orgs/acme/users/ben/transfer", `{`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferUserResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 2 || got["id"] != "ben" || got["orgId"] != "globex" {
+		t.Fatalf("unexpected response %s", body)
+	}
+}
+
+// The model rules must hold after a transfer: the user leaves the old
+// organization's projects and no task stays assigned to them.
+func TestTransferUserKeepsModelRules(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatal(code, body)
+	}
+
+	// ben no longer reads acme projects, and the new org's projects need a membership.
+	for _, path := range []string{"/projects/web/tasks", "/projects/legacy/tasks", "/projects/gx/tasks"} {
+		if code, _ := do(t, h, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("ben GET %s: got %d want 404", path, code)
+		}
+	}
+
+	// t1 (web) and t5 (legacy) were assigned to ben; they are now unassigned.
+	for _, path := range []string{"/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		code, body := do(t, h, "GET", path, "ann", "")
+		if code != 200 {
+			t.Fatal(path, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.AssigneeID != "" {
+			t.Fatalf("%s still assigned to %q", path, task.AssigneeID)
+		}
+	}
+
+	// Other users' assignments are untouched.
+	code, body := do(t, h, "GET", "/projects/web/tasks/t2", "ann", "")
+	var t2 Task
+	if code != 200 || json.Unmarshal([]byte(body), &t2) != nil || t2.AssigneeID != "cat" {
+		t.Fatalf("t2 changed: %d %s", code, body)
+	}
+
+	// ben can no longer be assigned in web.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ann", `{"title":"x","assignee":"ben"}`); code != 400 {
+		t.Fatalf("assigning ben: got %d want 400", code)
+	}
+
+	// A transferred user is a member of the new org's users: gus's org admin
+	// does not exist, but ben is now addressable from globex.
+	if code, _ := do(t, h, "POST", "/orgs/globex/users/ben/transfer", "gus", `{"toOrgId":"acme"}`); code != 403 {
+		t.Fatalf("non admin of globex: got %d want 403", code)
+	}
+}
+
+// Org admin rights belong to one organization and are dropped by a transfer.
+func TestTransferAdminLosesAdmin(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatal(code, body)
+	}
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "eve", ""); code != 404 {
+		t.Fatalf("eve reads gx: got %d want 404", code)
+	}
+	if code, _ := do(t, h, "POST", "/orgs/globex/users/gus/transfer", "eve", `{"toOrgId":"acme"}`); code != 403 {
+		t.Fatalf("eve transfers in globex: got %d want 403", code)
+	}
+}
+
+// A rejected transfer changes nothing.
+func TestTransferRejectedChangesNothing(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"nowhere"}`); code != 400 {
+		t.Fatal(code)
+	}
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ben", "")
+	var task Task
+	if code != 200 || json.Unmarshal([]byte(body), &task) != nil || task.AssigneeID != "ben" {
+		t.Fatalf("t1 changed: %d %s", code, body)
+	}
+}
