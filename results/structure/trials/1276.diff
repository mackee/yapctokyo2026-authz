+package model
+
+import "context"
+
+// OrgTable reads organizations. There is no orgs table: an organization exists
+// while some user or project belongs to it.
+type OrgTable struct{}
+
+// NewOrgTable returns the organizations.
+func NewOrgTable() *OrgTable { return &OrgTable{} }
+
+// Exists reports whether any user or project belongs to the organization.
+func (*OrgTable) Exists(ctx context.Context, db DB, orgID string) (bool, error) {
+	var n int
+	if err := db.QueryRowContext(ctx,
+		`SELECT (SELECT COUNT(*) FROM users WHERE org_id = ?) + (SELECT COUNT(*) FROM projects WHERE org_id = ?)`,
+		orgID, orgID).Scan(&n); err != nil {
+		return false, err
+	}
+	return n > 0, nil
+}
