+
+// ---- organization capabilities ---------------------------------------------------
+
+// OrgScope is bound to one actor and one organization ID.
+type OrgScope interface {
+	Manage() (ManageOrg, error)
+}
+
+// ManageOrg is the org-admin-only capability for one organization's members.
+type ManageOrg interface {
+	// RemoveUser removes a user of the organization from every project of the
+	// organization. Tasks the user was assigned to become unassigned. The user
+	// record itself is kept. A user who is not in the organization is 404.
+	RemoveUser(userID string) error
+}
+
+type orgScope struct {
+	as  *actorScope
+	oid string
+}
+
+// Manage applies the org rule: the organization must be the actor's own (else
+// 404, so other organizations are not revealed) and the actor must be an org
+// admin (else 403).
+func (s *orgScope) Manage() (ManageOrg, error) {
+	err := s.as.a.st.read(func(st *state) error {
+		if s.oid != s.as.actor.org {
+			return deny(ErrNotFound, "not found")
+		}
+		if !s.as.actor.orgAdmin {
+			return deny(ErrForbidden, "forbidden")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &manageOrg{os: s}, nil
+}
+
+type manageOrg struct{ os *orgScope }
+
+func (m *manageOrg) RemoveUser(userID string) error {
+	return m.os.as.a.st.tx(func(s *state) error {
+		u, ok := s.users[userID]
+		if !ok || u.org != m.os.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		for pid, p := range s.projects {
+			if p.org == m.os.oid {
+				delete(s.members[pid], userID)
+			}
+		}
+		for id, t := range s.tasks {
+			if t.assignee.user == userID {
+				t.assignee = Assignee{project: t.project}
+				s.tasks[id] = t
+			}
+		}
+		return nil
+	})
+}
