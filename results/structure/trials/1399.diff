-// MembershipTable reads the memberships table.
+// MembershipTable is the memberships table.
+//
+// Find and List* read rows. SetRoles is the API operation: it asks the
+// project's authorization object whether the actor may change roles, then runs
+// its aggregate (aggregate.go) in a transaction.
 type MembershipTable struct{}
 
 // NewMembershipTable returns the memberships table.
 func NewMembershipTable() *MembershipTable { return &MembershipTable{} }
 
+// MembershipTableSetRolesInput is the input of MembershipTable.SetRoles.
+type MembershipTableSetRolesInput struct {
+	Roles map[string]string // user ID -> new role
+}
+
+// SetRoles changes the roles of the named members of the project, all or
+// nothing, and returns the project's members after the change.
+func (mt *MembershipTable) SetRoles(ctx context.Context, db DB, authz ProjectAuthz, in MembershipTableSetRolesInput) ([]*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	for _, role := range in.Roles {
+		if role != RoleManager && role != RoleContributor && role != RoleViewer {
+			return nil, deny(ErrInvalid, "invalid role")
+		}
+	}
+	var out []*Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadSetRoles(ctx, tx, authz.ProjectID(), in.Roles)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(ctx, tx); err != nil {
+			return err
+		}
+		if out, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
+
