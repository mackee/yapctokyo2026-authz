+// setRolesAggregate changes the roles of several members of one project, all
+// or nothing.
+type setRolesAggregate struct {
+	project *Project
+	roles   map[string]string // user ID -> new role
+	members []*Membership     // the memberships named in roles, by user ID
+}
+
+func loadSetRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*setRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if err != nil {
+		return nil, err
+	}
+	a := &setRolesAggregate{project: p, roles: roles}
+	for _, userID := range slices.Sorted(maps.Keys(roles)) {
+		m, err := p.Membership(ctx, tx, userID)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "roles must name members of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		a.members = append(a.members, m)
+	}
+	return a, nil
+}
+
+// validate checks the model rules on the result: a member who is no longer a
+// contributor or manager must not be assigned any task of the project.
+func (a *setRolesAggregate) validate(ctx context.Context, tx DB) error {
+	for _, m := range a.members {
+		if isWriterRole(a.roles[m.UserID]) {
+			continue
+		}
+		tasks, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return err
+		}
+		if len(tasks) > 0 {
+			return deny(ErrInvalid, "assignee must be a contributor or manager of the project")
+		}
+	}
+	return nil
+}
+
+func (a *setRolesAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for _, m := range a.members {
+		if err := m.setRole(ctx, tx, a.roles[m.UserID]); err != nil {
+			return nil, err
+		}
+	}
+	return a.project.Memberships(ctx, tx)
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
