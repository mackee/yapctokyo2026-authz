+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager of org is not org admin", "ann", "/orgs/acme/users/cat", 403},
+		{"member of org is not org admin", "hal", "/orgs/acme/users/cat", 403},
+		{"org admin of other org", "gus", "/orgs/acme/users/cat", 404},
+		{"unknown org", "eve", "/orgs/nope/users/cat", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"anonymous", "", "/orgs/acme/users/cat", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserRevokesAccess(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "DELETE", "/orgs/acme/users/cat", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d body=%s", code, body)
+	}
+	// cat was a contributor in web and ops (both acme); all memberships go.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "cat", ""); code != 404 {
+		t.Fatalf("list web after removal: got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "cat", ""); code != 404 {
+		t.Fatalf("list ops after removal: got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "cat", `{"title":"x"}`); code != 404 {
+		t.Fatalf("create after removal: got %d want 404", code)
+	}
+	// other members are untouched.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("other member affected: got %d", code)
+	}
+	// removing again is fine.
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/cat", "eve", ""); code != 204 {
+		t.Fatalf("second remove: got %d want 204", code)
+	}
+}
+
+func TestRemoveOrgUserArchivedAndAdmin(t *testing.T) {
+	srv := newServer()
+	// ben is also a contributor on the archived legacy project.
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove ben: got %d want 204", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/legacy/tasks/t5", "ben", ""); code != 404 {
+		t.Fatalf("archived project after removal: got %d want 404", code)
+	}
+	// removing an org admin also revokes their org-wide read access.
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/eve", "eve", ""); code != 204 {
+		t.Fatalf("remove eve: got %d want 204", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "eve", ""); code != 404 {
+		t.Fatalf("eve reads ops after removal: got %d want 404", code)
+	}
+}
