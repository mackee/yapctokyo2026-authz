+// manageable applies the manage rule: readable, manager (else 403), not
+// archived (else 409).
+func manageable(x *tx, act Actor, pid string) (projectRecord, error) {
+	p, role, err := readable(x, act, pid)
+	if err != nil {
+		return projectRecord{}, err
+	}
+	if role != RoleManager {
+		return projectRecord{}, deny(ErrForbidden, "forbidden")
+	}
+	if p.Archived {
+		return projectRecord{}, deny(ErrArchived, "project is archived")
+	}
+	return p, nil
+}
+
+// Manage applies the manage rule (see manageable): managers only.
+func (s *projectScope) Manage() (ManageProject, error) {
+	err := s.as.a.db.view(func(x *tx) error {
+		_, err := manageable(x, s.as.actor, s.pid)
+		return err
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &manageProject{readProject: readProject{ps: s}}, nil
+}
