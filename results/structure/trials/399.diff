+}
+
+// moveMember takes {uid} out of the path project and adds them to toProjectId
+// with the same role. The caller must manage both projects.
+func moveMember(ctx tanukirpc.Context[*projectRegistry], _ struct{}) (*capability.MemberView, error) {
+	src, err := ctx.Registry().scope.Member(chi.URLParam(ctx.Request(), "uid")).Manage()
+	if err != nil {
+		return nil, err
+	}
+	var req moveRequest
+	if err := decodeBody(ctx.Request(), &req); err != nil || req.ToProjectID == "" {
+		return nil, errInvalidBody
+	}
+	dst, err := ctx.Registry().scope.Actor().Project(req.ToProjectID).Manage()
+	if err != nil {
+		return nil, err
+	}
+	v, err := src.MoveTo(dst)
+	if err != nil {
+		return nil, err
+	}
+	return &v, nil
+}
