+// ManageProject may change the membership of one project (managers only, the
+// project is not archived).
+type ManageProject interface {
+	ReadProject
+}
+
+// MemberView is the public representation of a project membership.
+type MemberView struct {
+	UserID    string `json:"userId"`
+	ProjectID string `json:"projectId"`
+	Role      string `json:"role"`
+}
+
+// ManageMember may change one membership in the project it was acquired from.
+type ManageMember interface {
+	// MoveTo takes the member out of this project and adds them to dest with
+	// the same role. dest must have been acquired with ProjectScope.Manage.
+	MoveTo(dest ManageProject) (MemberView, error)
+}
+
+type manageProject struct{ readProject }
+
+type memberScope struct {
+	ps  *projectScope
+	uid string
+}
+
+// Manage applies the manage rule to the source project and checks that the
+// user is a member of it (else 404).
+func (s *memberScope) Manage() (ManageMember, error) {
+	err := s.ps.as.a.db.view(func(x *tx) error {
+		if _, err := manageable(x, s.ps.as.actor, s.ps.pid); err != nil {
+			return err
+		}
+		if _, ok := x.findMembership(s.ps.pid, s.uid); !ok {
+			return deny(ErrNotFound, "not found")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &manageMember{ms: s}, nil
+}
+
+type manageMember struct{ ms *memberScope }
+
+func (m *manageMember) MoveTo(dest ManageProject) (MemberView, error) {
+	to, ok := dest.(*manageProject)
+	if !ok {
+		return MemberView{}, deny(ErrInvalid, "destination was not acquired for management")
+	}
+	var v MemberView
+	err := m.ms.ps.as.a.db.update(func(x *tx) error {
+		agg, err := loadMoveMember(x, m.ms.ps.pid, m.ms.uid, to.ID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		v = agg.apply(x)
+		return nil
+	})
+	return v, err
+}
+
