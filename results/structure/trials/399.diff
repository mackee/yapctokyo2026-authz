+// moveMemberAggregate moves one member from the source project to the
+// destination project, keeping their role.
+type moveMemberAggregate struct {
+	source     projectRecord
+	dest       projectRecord
+	member     membershipRecord  // the membership in the source project
+	destMember *membershipRecord // the membership in the destination project, if any
+}
+
+func loadMoveMember(x *tx, sourceID, userID, destID string) (*moveMemberAggregate, error) {
+	src, ok := x.findProject(sourceID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	m, ok := src.Membership(x, userID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	dst, ok := x.findProject(destID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	a := &moveMemberAggregate{source: src, dest: dst, member: m}
+	if dm, ok := dst.Membership(x, userID); ok {
+		a.destMember = &dm
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.source.ID == a.dest.ID {
+		return deny(ErrInvalid, "destination must be a different project")
+	}
+	if a.source.Org != a.dest.Org {
+		return deny(ErrInvalid, "project members must belong to the project's organization")
+	}
+	if a.destMember != nil {
+		return deny(ErrInvalid, "user is already a member of the destination project")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(x *tx) MemberView {
+	// The member leaves the source project, and an assignee must be a member of
+	// the task's project, so their tasks there are unassigned.
+	for _, t := range a.member.AssignedTasks(x) {
+		t.Unassign(x)
+	}
+	a.member.Destroy(x)
+	moved := membershipRecord{ProjectID: a.dest.ID, UserID: a.member.UserID, Role: a.member.Role}
+	moved.save(x)
+	return MemberView{UserID: moved.UserID, ProjectID: moved.ProjectID, Role: moved.Role}
+}
+
