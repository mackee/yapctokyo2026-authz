@@ -432,3 +438,36 @@ func (t *manageTask) Delete() error {
 		return nil
 	})
 }
+
+func (t *manageTask) MoveTo(toProjectID string) (TaskView, error) {
+	src := t.ts.ps.pid
+	if toProjectID == "" {
+		return TaskView{}, deny(ErrInvalid, "toProjectId is required")
+	}
+	if toProjectID == src {
+		return TaskView{}, deny(ErrInvalid, "task is already in that project")
+	}
+	dst, err := t.ts.ps.as.Project(toProjectID).Write()
+	if err != nil {
+		return TaskView{}, err
+	}
+	var v TaskView
+	err = t.ts.ps.as.a.st.tx(func(s *state) error {
+		cur, ok := s.tasks[t.ts.tid]
+		if !ok || cur.project != src {
+			return deny(ErrNotFound, "not found")
+		}
+		// Re-admit the current assignee for the destination project. A task's
+		// Assignee is bound to its project, so this is the only way it can move.
+		a, err := admit(s, dst.ID(), cur.assignee.user)
+		if err != nil {
+			return err
+		}
+		cur.project = dst.ID()
+		cur.assignee = a
+		s.tasks[cur.id] = cur
+		v = cur.view()
+		return nil
+	})
+	return v, err
+}
