+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"testing"
+)
+
+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ivy", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+		{"archived", "ann", "legacy", 409},
+		{"missing project", "ann", "missing", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResponseListsViewers(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+	var members []struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &members); err != nil {
+		t.Fatalf("bad body %q: %v", body, err)
+	}
+	want := []struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}{
+		{"ann", "viewer"},
+		{"ben", "viewer"},
+		{"cat", "viewer"},
+		{"dan", "viewer"},
+		{"ivy", "viewer"},
+	}
+	if len(members) != len(want) {
+		t.Fatalf("got %d members, want %d: %s", len(members), len(want), body)
+	}
+	for i := range want {
+		if members[i] != want[i] {
+			t.Fatalf("member %d: got %+v want %+v", i, members[i], want[i])
+		}
+	}
+}
+
+func TestFreezeOnlyAffectsProject(t *testing.T) {
+	s := newServer()
+	if code, _ := do(t, s, "POST", "/projects/web/freeze", "ivy", ""); code != 200 {
+		t.Fatalf("freeze: got %d want 200", code)
+	}
+	// Other projects keep their roles.
+	if code, _ := do(t, s, "PATCH", "/projects/ops/tasks/t4", "ivy", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ops manager after web freeze: got %d want 200", code)
+	}
+	if code, _ := do(t, s, "POST", "/projects/ops/tasks", "cat", `{"title":"x"}`); code != 200 {
+		t.Fatalf("ops contributor after web freeze: got %d want 200", code)
+	}
+}
+
+func TestFreezeBlocksTaskWrites(t *testing.T) {
+	s := newServer()
+	if code, _ := do(t, s, "POST", "/projects/web/freeze", "ivy", ""); code != 200 {
+		t.Fatalf("freeze: got %d want 200", code)
+	}
+	cases := []struct {
+		name, user, method, path, body string
+	}{
+		{"former contributor update own", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"former contributor update other", "cat", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"former manager update", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"former manager reassign", "ann", "PATCH", "/projects/web/tasks/t3", `{"assignee":"ben"}`},
+		{"former manager create", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"former manager delete", "ann", "DELETE", "/projects/web/tasks/t1", ""},
+		{"manager refreeze", "ivy", "POST", "/projects/web/freeze", ""},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, s, c.method, c.path, c.user, c.body)
+			if code != 403 {
+				t.Fatalf("got %d want 403", code)
+			}
+		})
+	}
+}
+
+func TestFreezeUnassignsTasks(t *testing.T) {
+	s := newServer()
+	if code, _ := do(t, s, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d want 200", code)
+	}
+	for _, id := range []string{"t1", "t2", "t3"} {
+		code, body := do(t, s, "GET", "/projects/web/tasks/"+id, "dan", "")
+		if code != 200 {
+			t.Fatalf("get %s: got %d", id, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.Assignee != "" {
+			t.Fatalf("%s still assigned to %q", id, task.Assignee)
+		}
+	}
+	// Tasks in other projects keep their assignees.
+	code, body := do(t, s, "GET", "/projects/ops/tasks/t4", "ann", "")
+	if code != 200 {
+		t.Fatalf("get t4: got %d", code)
+	}
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "cat" {
+		t.Fatalf("ops task t4 assignee %q, want cat", task.Assignee)
+	}
+}
+
+func TestFreezeReadsStillWork(t *testing.T) {
+	s := newServer()
+	do(t, s, "POST", "/projects/web/freeze", "ivy", "")
+	if code, _ := do(t, s, "GET", "/projects/web/tasks", "dan", ""); code != http.StatusOK {
+		t.Fatalf("list after freeze: got %d want 200", code)
+	}
+}
