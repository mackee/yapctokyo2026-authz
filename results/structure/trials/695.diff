+func TestUpdateMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager demotes", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 200},
+		{"manager promotes", "ann", "/projects/web/members/dan", `{"role":"manager"}`, 200},
+		{"contributor forbidden", "ben", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"viewer forbidden", "dan", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"org admin forbidden", "eve", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"non-member 404", "hal", "/projects/web/members/dan", `{"role":"viewer"}`, 404},
+		{"other org 404", "gus", "/projects/web/members/dan", `{"role":"viewer"}`, 404},
+		{"manager of other project", "ann", "/projects/ops/members/cat", `{"role":"viewer"}`, 403},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"invalid role", "ann", "/projects/web/members/ben", `{"role":"admin"}`, 400},
+		{"bad body", "ann", "/projects/web/members/ben", `x`, 400},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"unauthenticated", "", "/projects/web/members/ben", `{"role":"viewer"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			if code, body := do(t, h, "PUT", c.path, c.user, c.body); code != c.want {
+				t.Fatalf("got %d (%s), want %d", code, body, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRoleEffect(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`)
+	if code != 200 {
+		t.Fatalf("got %d", code)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil || got["userId"] != "ben" || got["role"] != "viewer" {
+		t.Fatalf("bad response %s", body)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 403 {
+		t.Fatalf("demoted user should lose write access, got %d", code)
+	}
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ann", "dan", `{"role":"viewer"}`); code != 403 {
+		t.Fatalf("got %d", code)
+	}
+	do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"manager"}`)
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ben", "dan", `{"role":"contributor"}`); code != 200 {
+		t.Fatalf("promoted manager should be able to change roles, got %d", code)
+	}
+}
