+// setRolesAggregate changes the roles of several members of one project.
+type setRolesAggregate struct {
+	members []*Membership // the memberships to change, in user ID order
+	roles   map[string]string
+}
+
+func loadSetRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*setRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "membership must belong to an existing project")
+	} else if err != nil {
+		return nil, err
+	}
+	all, err := p.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	a := &setRolesAggregate{roles: roles}
+	found := 0
+	for _, m := range all {
+		if _, ok := roles[m.UserID]; ok {
+			a.members = append(a.members, m)
+			found++
+		}
+	}
+	if found != len(roles) {
+		return nil, deny(ErrInvalid, "every user must be a member of the project")
+	}
+	return a, nil
+}
+
+func (a *setRolesAggregate) validate(ctx context.Context, tx DB) error {
+	for _, m := range a.members {
+		if isWriterRole(a.roles[m.UserID]) {
+			continue
+		}
+		// An assignee must be a contributor or manager: a member who still has
+		// tasks cannot become a viewer.
+		tasks, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return err
+		}
+		if len(tasks) > 0 {
+			return deny(ErrInvalid, "member "+m.UserID+" still has assigned tasks and must remain a contributor or manager")
+		}
+	}
+	return nil
+}
+
+func (a *setRolesAggregate) apply(ctx context.Context, tx DB) error {
+	for _, m := range a.members {
+		m.Role = a.roles[m.UserID]
+		if err := m.save(ctx, tx); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
