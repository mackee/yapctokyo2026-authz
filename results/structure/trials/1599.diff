 // NewMembershipTable returns the memberships table.
 func NewMembershipTable() *MembershipTable { return &MembershipTable{} }
 
+// ChangeRoles changes the roles of several members of the project at once
+// (user ID -> role) and returns the project's members. All or nothing.
+func (mt *MembershipTable) ChangeRoles(ctx context.Context, db DB, authz ProjectAuthz, roles map[string]string) ([]*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if len(roles) == 0 {
+		return nil, deny(ErrInvalid, "roles must not be empty")
+	}
+	var out []*Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadChangeRoles(ctx, tx, authz.ProjectID(), roles)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if err := agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		out, err = mt.ListByProject(ctx, tx, authz.ProjectID())
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
+
