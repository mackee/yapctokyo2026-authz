new file mode 100644
index 0000000..7a6d726
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,86 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"testing"
+)
+
+func memberRoles(t *testing.T, h http.Handler, pid string) map[string]string {
+	t.Helper()
+	app := h.(*appHandler)
+	rows, err := app.db.Query(`SELECT user_id, role FROM memberships WHERE project_id = ?`, pid)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer rows.Close()
+	out := map[string]string{}
+	for rows.Next() {
+		var u, r string
+		if err := rows.Scan(&u, &r); err != nil {
+			t.Fatal(err)
+		}
+		out[u] = r
+	}
+	return out
+}
+
+func TestChangeRoles(t *testing.T) {
+	h := newServer()
+
+	// ben has no tasks assigned in "ops"? use web: dan (viewer) -> contributor, ben -> manager.
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"manager","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d %s", code, body)
+	}
+	var got []struct{ UserID, Role string }
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	roles := map[string]string{}
+	for _, m := range got {
+		roles[m.UserID] = m.Role
+	}
+	if len(got) != 5 || roles["ben"] != "manager" || roles["dan"] != "contributor" || roles["ann"] != "manager" {
+		t.Errorf("unexpected response %s", body)
+	}
+	if r := memberRoles(t, h, "web"); r["ben"] != "manager" || r["dan"] != "contributor" {
+		t.Errorf("not persisted: %v", r)
+	}
+}
+
+func TestChangeRolesAllOrNothing(t *testing.T) {
+	cases := []struct {
+		name, user, pid, body string
+		want                  int
+	}{
+		{"unknown member", "ann", "web", `{"roles":{"dan":"contributor","hal":"viewer"}}`, 400},
+		{"member of another project", "ann", "web", `{"roles":{"dan":"contributor","gus":"viewer"}}`, 400},
+		{"invalid role", "ann", "web", `{"roles":{"dan":"contributor","cat":"boss"}}`, 400},
+		{"empty", "ann", "web", `{"roles":{}}`, 400},
+		{"missing", "ann", "web", `{}`, 400},
+		{"demote assignee", "ann", "web", `{"roles":{"dan":"contributor","ben":"viewer"}}`, 400},
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"dan":"manager"}}`, 403},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"manager"}}`, 409},
+		{"unreadable", "hal", "web", `{"roles":{"dan":"manager"}}`, 404},
+		{"unauthenticated", "", "web", `{"roles":{"dan":"manager"}}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			before := memberRoles(t, h, c.pid)
+			code, body := do(t, h, "PUT", "/projects/"+c.pid+"/members", c.user, c.body)
+			if code != c.want {
+				t.Errorf("got %d %s, want %d", code, body, c.want)
+			}
+			after := memberRoles(t, h, c.pid)
+			for u, r := range before {
+				if after[u] != r {
+					t.Errorf("%s changed from %s to %s", u, r, after[u])
+				}
+			}
+		})
+	}
+}
