+// changeRolesAggregate changes the roles of several members of one project.
+type changeRolesAggregate struct {
+	members []*Membership     // the members to change, ordered by user ID
+	roles   map[string]string // user ID -> new role
+	tasks   map[string]int    // user ID -> number of tasks assigned to the member in the project
+}
+
+func loadChangeRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*changeRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	all, err := p.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	a := &changeRolesAggregate{roles: roles, tasks: map[string]int{}}
+	found := map[string]bool{}
+	for _, m := range all {
+		if _, ok := roles[m.UserID]; !ok {
+			continue
+		}
+		found[m.UserID] = true
+		a.members = append(a.members, m)
+		ts, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.tasks[m.UserID] = len(ts)
+	}
+	for id := range roles {
+		if !found[id] {
+			return nil, deny(ErrInvalid, "user "+id+" is not a member of the project")
+		}
+	}
+	return a, nil
+}
+
+func (a *changeRolesAggregate) validate() error {
+	for _, m := range a.members {
+		role := a.roles[m.UserID]
+		if role != RoleManager && role != RoleContributor && role != RoleViewer {
+			return deny(ErrInvalid, "invalid role for "+m.UserID)
+		}
+		if !isWriterRole(role) && a.tasks[m.UserID] > 0 {
+			return deny(ErrInvalid, m.UserID+" has assigned tasks and must remain a contributor or manager")
+		}
+	}
+	return nil
+}
+
+func (a *changeRolesAggregate) apply(ctx context.Context, tx DB) error {
+	for _, m := range a.members {
+		if err := m.setRole(ctx, tx, a.roles[m.UserID]); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
