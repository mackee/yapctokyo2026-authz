index 0000000..b7ad837
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,88 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager removes contributor", "ann", "/projects/web/members/ben", 204},
+		{"manager removes viewer", "ann", "/projects/web/members/dan", 204},
+		{"contributor", "ben", "/projects/web/members/cat", 403},
+		{"viewer", "dan", "/projects/web/members/cat", 403},
+		{"org admin", "eve", "/projects/web/members/cat", 403},
+		{"non member", "hal", "/projects/web/members/cat", 404},
+		{"other org", "gus", "/projects/web/members/ann", 404},
+		{"anonymous", "", "/projects/web/members/cat", 401},
+		{"unknown user", "zed", "/projects/web/members/cat", 401},
+		{"target not a member", "ann", "/projects/web/members/hal", 404},
+		{"target unknown", "ann", "/projects/web/members/zed", 404},
+		{"archived", "ann", "/projects/legacy/members/ben", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveMemberEffects(t *testing.T) {
+	h := newServer()
+
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/cat", "ann", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+
+	// The removed user loses access to the project (404, not readable).
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 404 {
+		t.Fatalf("removed user list: got %d want 404", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t2", "cat", ""); code != 404 {
+		t.Fatalf("removed user get task: got %d want 404", code)
+	}
+
+	// Removing again is a 404: the user is no longer a member.
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/cat", "ann", ""); code != 404 {
+		t.Fatalf("second remove: got %d want 404", code)
+	}
+
+	// Tasks assigned to the removed user become unassigned; others are kept.
+	_, body := do(t, h, "GET", "/projects/web/tasks", "ann", "")
+	var tasks []Task
+	if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+		t.Fatal(err)
+	}
+	byID := map[string]Task{}
+	for _, task := range tasks {
+		byID[task.ID] = task
+	}
+	if got := byID["t2"].Assignee; got != "" {
+		t.Fatalf("t2 assignee: got %q want unassigned", got)
+	}
+	if got := byID["t1"].Assignee; got != "ben" {
+		t.Fatalf("t1 assignee: got %q want ben", got)
+	}
+
+	// Membership is per project: cat is still a contributor of ops.
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat ops list: got %d want 200", code)
+	}
+}
+
+func TestRemoveMemberAssignDenied(t *testing.T) {
+	// After removal the user is no longer an eligible assignee.
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ann", `{"title":"x","assignee":"ben"}`); code != 400 {
+		t.Fatalf("assign removed user: got %d want 400", code)
+	}
+}
