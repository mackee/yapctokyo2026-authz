+func TestSetMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, project, target, body string
+		want                              int
+	}{
+		{"manager demotes contributor", "ann", "web", "ben", `{"role":"viewer"}`, 200},
+		{"manager promotes viewer", "ann", "web", "dan", `{"role":"contributor"}`, 200},
+		{"manager promotes to manager", "ann", "web", "cat", `{"role":"manager"}`, 200},
+		{"contributor", "ben", "web", "cat", `{"role":"viewer"}`, 403},
+		{"viewer", "dan", "web", "ben", `{"role":"viewer"}`, 403},
+		{"org admin", "eve", "web", "ben", `{"role":"viewer"}`, 403},
+		{"non member", "hal", "web", "ben", `{"role":"viewer"}`, 404},
+		{"other org", "gus", "web", "ben", `{"role":"viewer"}`, 404},
+		{"anonymous", "", "web", "ben", `{"role":"viewer"}`, 401},
+		{"unknown user", "zed", "web", "ben", `{"role":"viewer"}`, 401},
+		{"missing project", "ann", "nope", "ben", `{"role":"viewer"}`, 404},
+		{"target not member", "ann", "web", "hal", `{"role":"viewer"}`, 404},
+		{"target in other project only", "ann", "web", "gus", `{"role":"viewer"}`, 404},
+		{"archived", "ann", "legacy", "ben", `{"role":"viewer"}`, 409},
+		{"invalid role", "ann", "web", "ben", `{"role":"owner"}`, 400},
+		{"empty role", "ann", "web", "ben", `{"role":""}`, 400},
+		{"bad body", "ann", "web", "ben", `{"role":`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members/"+c.target, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMemberRoleResponseAndEffect(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["userId"] != "ben" || got["role"] != "viewer" {
+		t.Fatalf("got body %s", body)
+	}
+	// ben was a contributor and could update his own task; as a viewer he cannot.
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 403 {
+		t.Fatalf("demoted ben PATCH got %d want 403", code)
+	}
+}
