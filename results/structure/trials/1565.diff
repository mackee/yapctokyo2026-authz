diff --git a/move.go b/move.go
new file mode 100644
index 0000000..90eead4
--- /dev/null
+++ b/move.go
@@ -0,0 +1,136 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+)
+
+type moveRequest struct {
+	ToProjectID string `json:"toProjectId"`
+}
+
+type moveResponse struct {
+	UserID    string `json:"userId"`
+	ProjectID string `json:"projectId"`
+	Role      string `json:"role"`
+}
+
+// moveMember moves a member from the path project to another project of the same
+// org, keeping their role. The caller must be a manager of both projects.
+func (s *server) moveMember(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	caller, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if caller == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	src, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if src == nil || src.OrgID != caller.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	callerRole, err := findRole(ctx, s.db, src.ID, caller.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if callerRole == "" && !caller.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if callerRole != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if src.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req moveRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || req.ToProjectID == "" {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	if req.ToProjectID == src.ID {
+		writeError(w, 400, "destination must be a different project")
+		return
+	}
+	uid := r.PathValue("uid")
+	memberRole, err := findRole(ctx, s.db, src.ID, uid)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if memberRole == "" {
+		writeError(w, 404, "not found")
+		return
+	}
+	dst, err := findProject(ctx, s.db, req.ToProjectID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if dst == nil || dst.OrgID != caller.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	dstCallerRole, err := findRole(ctx, s.db, dst.ID, caller.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if dstCallerRole == "" && !caller.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if dstCallerRole != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if dst.Archived {
+		writeError(w, 409, "destination project is archived")
+		return
+	}
+	existing, err := findRole(ctx, s.db, dst.ID, uid)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if existing != "" {
+		writeError(w, 409, "user is already a member of the destination project")
+		return
+	}
+
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+	// The user leaves the source project, so their tasks there become unassigned.
+	if _, err := tx.ExecContext(ctx, `UPDATE tasks SET assignee = '' WHERE project_id = ? AND assignee = ?`, src.ID, uid); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if _, err := tx.ExecContext(ctx, `DELETE FROM memberships WHERE project_id = ? AND user_id = ?`, src.ID, uid); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if _, err := tx.ExecContext(ctx, `INSERT INTO memberships (project_id, user_id, role) VALUES (?, ?, ?)`, dst.ID, uid, memberRole); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, moveResponse{UserID: uid, ProjectID: dst.ID, Role: memberRole})
+}
diff --git a/move_test.go b/move_test.go
new file mode 100644
index 0000000..3aaf30e
--- /dev/null
+++ b/move_test.go
@@ -0,0 +1,66 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestMoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		// ann manages web and legacy; ivy manages web and ops.
+		{"manager both", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 200},
+		{"not manager of destination", "ann", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"archived destination", "ann", "/projects/web/members/ben/move", `{"toProjectId":"legacy"}`, 409},
+		{"contributor caller", "ben", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin", "eve", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"non member caller", "hal", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 401},
+		{"target not a member", "ivy", "/projects/web/members/hal/move", `{"toProjectId":"ops"}`, 404},
+		{"already in destination", "ivy", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 409},
+		{"same project", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"web"}`, 400},
+		{"missing destination", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"nope"}`, 404},
+		{"other org destination", "ann", "/projects/web/members/ben/move", `{"toProjectId":"gx"}`, 404},
+		{"archived source", "ann", "/projects/legacy/members/ben/move", `{"toProjectId":"web"}`, 409},
+		{"bad body", "ivy", "/projects/web/members/ben/move", `{}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveMemberResult(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got moveResponse
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got != (moveResponse{UserID: "ben", ProjectID: "ops", Role: "contributor"}) {
+		t.Fatalf("unexpected response %+v", got)
+	}
+	// ben is no longer in web (404 on read) and is now in ops (200).
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben still reads web: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben cannot read ops: %d", code)
+	}
+	// His web task t1 was unassigned (model rules are checked by do()).
+	_, tb := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(tb), &task)
+	if task.Assignee != "" {
+		t.Fatalf("t1 still assigned to %q", task.Assignee)
+	}
+}
