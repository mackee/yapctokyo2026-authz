diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..bb91368
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,97 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestSetMemberRoles(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager changes roles", "ann", "web", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"cat":"viewer"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"cat":"viewer"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"cat":"viewer"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"unknown role", "ann", "web", `{"roles":{"ben":"owner"}}`, 400},
+		{"target not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"malformed body", "ann", "web", `not json`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMemberRolesResponseIsFullMemberList(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	type member struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	var got []member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []member{
+		{"ann", "manager"},
+		{"ben", "viewer"},
+		{"cat", "contributor"},
+		{"dan", "contributor"},
+		{"ivy", "manager"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %s", body)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("entry %d: got %+v want %+v (body %s)", i, got[i], want[i], body)
+		}
+	}
+}
+
+func TestSetMemberRolesIsAllOrNothing(t *testing.T) {
+	bodies := map[string]string{
+		"one member not in project": `{"roles":{"ben":"viewer","hal":"viewer"}}`,
+		"one role invalid":          `{"roles":{"ben":"viewer","cat":"owner"}}`,
+	}
+	for name, body := range bodies {
+		t.Run(name, func(t *testing.T) {
+			srv := newServer()
+			if code, resp := do(t, srv, "PUT", "/projects/web/members", "ann", body); code != 400 {
+				t.Fatalf("got %d want 400: %s", code, resp)
+			}
+			// ben is still a contributor, so he can still create tasks.
+			if code, resp := do(t, srv, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 201 {
+				t.Fatalf("ben changed despite the failed request: got %d: %s", code, resp)
+			}
+		})
+	}
+}
+
+func TestSetMemberRolesTakesEffect(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`); code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Fatalf("demoted ben: got %d want 403", code)
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 201 {
+		t.Fatalf("promoted dan: got %d want 201", code)
+	}
+}
