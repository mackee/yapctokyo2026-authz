 package capability
 
+import (
+	"fmt"
+	"sort"
+)
+
 // Aggregates: one per operation. An aggregate is built inside the transaction
 // for a single operation, starting from the record the operation is about and
 // loading the related records through the relation methods (record.go). It
@@ -118,3 +123,59 @@ func loadDeleteTask(x *tx, taskID string) (*deleteTaskAggregate, error) {
 func (a *deleteTaskAggregate) validate() error { return nil }
 
 func (a *deleteTaskAggregate) apply(x *tx) { a.task.Destroy(x) }
+
+// setRolesAggregate changes the roles of several members of one project. It is
+// all-or-nothing: every named user must already be a member, and every new role
+// must be valid, or nothing changes.
+type setRolesAggregate struct {
+	project projectRecord
+	changes []roleChange
+}
+
+type roleChange struct {
+	member membershipRecord
+	role   string
+}
+
+func loadSetRoles(x *tx, projectID string, roles map[string]string) (*setRolesAggregate, error) {
+	p, ok := x.findProject(projectID)
+	if !ok {
+		return nil, deny(ErrInvalid, "project does not exist")
+	}
+	userIDs := make([]string, 0, len(roles))
+	for uid := range roles {
+		userIDs = append(userIDs, uid)
+	}
+	sort.Strings(userIDs)
+
+	a := &setRolesAggregate{project: p}
+	for _, uid := range userIDs {
+		m, ok := p.Membership(x, uid)
+		if !ok {
+			return nil, deny(ErrInvalid, fmt.Sprintf("%s is not a member of the project", uid))
+		}
+		a.changes = append(a.changes, roleChange{member: m, role: roles[uid]})
+	}
+	return a, nil
+}
+
+func (a *setRolesAggregate) validate() error {
+	for _, c := range a.changes {
+		if !isValidRole(c.role) {
+			return deny(ErrInvalid, fmt.Sprintf("invalid role %q", c.role))
+		}
+	}
+	return nil
+}
+
+func (a *setRolesAggregate) apply(x *tx) []MemberView {
+	for _, c := range a.changes {
+		m := c.member
+		m.ChangeRole(x, c.role)
+	}
+	out := []MemberView{}
+	for _, m := range a.project.Memberships(x) {
+		out = append(out, MemberView{UserID: m.UserID, Role: m.Role})
+	}
+	return out
+}
