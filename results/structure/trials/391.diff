+// Admin applies the membership rule: readable, manager (else 403), not
+// archived (else 409). Org admins who are not managers of the project get 403.
+func (s *projectScope) Admin() (AdminProject, error) {
+	err := s.as.a.db.view(func(x *tx) error {
+		p, r, err := readable(x, s.as.actor, s.pid)
+		if err != nil {
+			return err
+		}
+		if r != RoleManager {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if p.Archived {
+			return deny(ErrArchived, "project is archived")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &adminProject{ps: s}, nil
+}
+
+// ---- membership capabilities -----------------------------------------------------
+
+// MemberView is the public representation of a project member.
+type MemberView struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// AdminProject may manage the members of one project. Only managers hold it.
+type AdminProject interface {
+	// SetRoles changes the roles of the named members in one all-or-nothing
+	// write. It returns the project's members after the change, sorted by user
+	// ID. If any user is not a member of the project, or any role is not valid,
+	// it is 400 and nothing changes.
+	SetRoles(roles map[string]string) ([]MemberView, error)
+}
+
+type adminProject struct{ ps *projectScope }
+
+func (p *adminProject) SetRoles(roles map[string]string) ([]MemberView, error) {
+	if len(roles) == 0 {
+		return nil, deny(ErrInvalid, "roles must not be empty")
+	}
+	var out []MemberView
+	err := p.ps.as.a.db.update(func(x *tx) error {
+		agg, err := loadSetRoles(x, p.ps.pid, roles)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		out = agg.apply(x)
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return out, nil
+}
+
