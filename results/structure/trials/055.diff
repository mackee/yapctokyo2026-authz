+type memberRolesRequest struct {
+	Roles map[string]string `json:"roles"`
+}
+
+// updateMemberRoles changes several members' roles in one request. The batch is
+// validated in full before anything is applied, so it either applies entirely or
+// not at all.
+func (s *server) updateMemberRoles(w http.ResponseWriter, r *http.Request) {
+	s.store.mu.Lock()
+	defer s.store.mu.Unlock()
+
+	user := s.store.User(r.Header.Get("X-User"))
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project := s.store.Project(r.PathValue("pid"))
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role := s.store.Role(project.ID, user.ID)
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "only managers may change member roles")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req memberRolesRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || len(req.Roles) == 0 {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	userIDs := make([]string, 0, len(req.Roles))
+	for uid := range req.Roles {
+		userIDs = append(userIDs, uid)
+	}
+	sort.Strings(userIDs)
+	for _, uid := range userIDs {
+		if !validRoles[req.Roles[uid]] {
+			writeError(w, 400, "invalid role for "+uid)
+			return
+		}
+		if s.store.Role(project.ID, uid) == "" {
+			writeError(w, 400, uid+" is not a member of the project")
+			return
+		}
+	}
+	for _, uid := range userIDs {
+		s.store.SetRole(project.ID, uid, req.Roles[uid])
+	}
+	writeJSON(w, 200, s.store.MembersOf(project.ID))
+}
