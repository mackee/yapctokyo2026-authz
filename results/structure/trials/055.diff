+func TestUpdateMemberRoles(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager batch", "ann", "web", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 200},
+		{"contributor caller", "ben", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"viewer caller", "dan", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"org admin caller", "eve", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"non member caller", "hal", "web", `{"roles":{"cat":"viewer"}}`, 404},
+		{"other org caller", "gus", "web", `{"roles":{"cat":"viewer"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"cat":"viewer"}}`, 401},
+		{"unknown user", "zed", "web", `{"roles":{"cat":"viewer"}}`, 401},
+		{"unknown project", "ann", "nope", `{"roles":{"cat":"viewer"}}`, 404},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"invalid role", "ann", "web", `{"roles":{"ben":"viewer","cat":"owner"}}`, 400},
+		{"empty role", "ann", "web", `{"roles":{"ben":""}}`, 400},
+		{"target not member", "ann", "web", `{"roles":{"ben":"viewer","hal":"viewer"}}`, 400},
+		{"target in other org", "ann", "web", `{"roles":{"gus":"viewer"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"bad json", "ann", "web", `{"roles":`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRolesApplies(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann",
+		`{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []Member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []Member{
+		{UserID: "ann", Role: RoleManager},
+		{UserID: "ben", Role: RoleViewer},
+		{UserID: "cat", Role: RoleContributor},
+		{UserID: "dan", Role: RoleContributor},
+		{UserID: "ivy", Role: RoleManager},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %d members want %d: %s", len(got), len(want), body)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("member %d: got %+v want %+v", i, got[i], want[i])
+		}
+	}
+}
+
+func TestUpdateMemberRolesIsAllOrNothing(t *testing.T) {
+	s := &server{store: newSeededStore()}
+	h := s.routes()
+	// ben -> viewer is valid, but hal is not a member, so the whole batch must be rejected.
+	code, _ := do(t, h, "PUT", "/projects/web/members", "ann",
+		`{"roles":{"ben":"viewer","hal":"viewer"}}`)
+	if code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	if got := s.store.Role("web", "ben"); got != RoleContributor {
+		t.Fatalf("ben's role changed to %q after rejected batch", got)
+	}
+	if got := s.store.Role("web", "dan"); got != RoleViewer {
+		t.Fatalf("dan's role changed to %q after rejected batch", got)
+	}
+}
