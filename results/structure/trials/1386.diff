+func TestRemoveUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin, user with no memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"manager", "ann", "/orgs/acme/users/ben", 403},
+		{"contributor", "ben", "/orgs/acme/users/cat", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"other org admin", "gus", "/orgs/acme/users/ben", 404},
+		{"org admin, other org", "eve", "/orgs/globex/users/gus", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ben", 404},
+		{"user in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveUserEffects(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d %s", code, body)
+	}
+
+	// ben is no longer a member of any acme project, so he cannot read them.
+	for _, path := range []string{"/projects/web/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, h, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("GET %s as ben: got %d want 404", path, code)
+		}
+	}
+
+	// Tasks ben held in acme projects are unassigned; other assignments stay.
+	assignee := func(path string) string {
+		t.Helper()
+		code, body := do(t, h, "GET", path, "ann", "")
+		if code != 200 {
+			t.Fatalf("GET %s: got %d", path, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		return task.AssigneeID
+	}
+	if got := assignee("/projects/web/tasks/t1"); got != "" {
+		t.Fatalf("t1 assignee: got %q want unassigned", got)
+	}
+	if got := assignee("/projects/legacy/tasks/t5"); got != "" {
+		t.Fatalf("t5 assignee: got %q want unassigned", got)
+	}
+	if got := assignee("/projects/web/tasks/t2"); got != "cat" {
+		t.Fatalf("t2 assignee: got %q want cat", got)
+	}
+
+	// Removing again is still 204, and other members keep their access.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("second remove: got %d want 204", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat lost access: got %d", code)
+	}
+}
