+// OrgExists reports whether any user or project belongs to the org.
+func (s *Store) OrgExists(orgID string) bool {
+	for _, u := range s.users {
+		if u.OrgID == orgID {
+			return true
+		}
+	}
+	for _, p := range s.projects {
+		if p.OrgID == orgID {
+			return true
+		}
+	}
+	return false
+}
+
+// TransferUser moves a user to another org. Because projects belong to a
+// single org, the user's memberships in projects of the old org are removed,
+// their tasks there become unassigned, and the org-admin flag is cleared so
+// no privileges carry over to the new org.
+func (s *Store) TransferUser(u *User, toOrgID string) {
+	for pid, m := range s.members {
+		if s.projects[pid] != nil && s.projects[pid].OrgID != toOrgID {
+			delete(m, u.ID)
+		}
+	}
+	for _, t := range s.tasks {
+		if t.Assignee != u.ID {
+			continue
+		}
+		if p := s.projects[t.ProjectID]; p != nil && p.OrgID != toOrgID {
+			t.Assignee = ""
+		}
+	}
+	u.OrgID = toOrgID
+	u.OrgAdmin = false
+}
