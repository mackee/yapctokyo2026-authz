+func TestAddMember(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager adds", "ann", "web", `{"userId":"hal","role":"contributor"}`, 201},
+		{"manager adds viewer", "ann", "web", `{"userId":"hal","role":"viewer"}`, 201},
+		{"manager adds manager", "ivy", "web", `{"userId":"hal","role":"manager"}`, 201},
+		{"contributor", "ben", "web", `{"userId":"hal","role":"contributor"}`, 403},
+		{"viewer", "dan", "web", `{"userId":"hal","role":"contributor"}`, 403},
+		{"org admin", "eve", "web", `{"userId":"hal","role":"contributor"}`, 403},
+		{"non member", "hal", "web", `{"userId":"ivy","role":"contributor"}`, 404},
+		{"anonymous", "", "web", `{"userId":"hal","role":"contributor"}`, 401},
+		{"unknown project", "ann", "nope", `{"userId":"hal","role":"contributor"}`, 404},
+		{"archived", "ann", "legacy", `{"userId":"hal","role":"contributor"}`, 409},
+		{"already member", "ann", "web", `{"userId":"ben","role":"viewer"}`, 409},
+		{"unknown user", "ann", "web", `{"userId":"zed","role":"contributor"}`, 400},
+		{"other org user", "ann", "web", `{"userId":"gus","role":"contributor"}`, 400},
+		{"invalid role", "ann", "web", `{"userId":"hal","role":"owner"}`, 400},
+		{"missing role", "ann", "web", `{"userId":"hal"}`, 400},
+		{"empty user id", "ann", "web", `{"userId":"","role":"contributor"}`, 400},
+		{"malformed body", "ann", "web", `{"userId":`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestAddMemberResponseAndAccess(t *testing.T) {
+	h := newServer()
+
+	// hal cannot see web before being added.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "hal", ""); code != 404 {
+		t.Fatalf("before add: got %d want 404", code)
+	}
+
+	code, body := do(t, h, "POST", "/projects/web/members", "ann", `{"userId":"hal","role":"contributor"}`)
+	if code != 201 {
+		t.Fatalf("add: got %d want 201", code)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["userId"] != "hal" || got["role"] != "contributor" || len(got) != 2 {
+		t.Fatalf("unexpected body: %s", body)
+	}
+
+	// The new contributor can now read the project and create tasks.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "hal", ""); code != 200 {
+		t.Fatalf("after add read: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "hal", `{"title":"x","assignee":"hal"}`); code != 201 {
+		t.Fatalf("after add create: got %d want 201", code)
+	}
+}
