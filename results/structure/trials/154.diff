+
+func (p *manageProject) AddMember(userID, role string) (MemberView, error) {
+	if userID == "" {
+		return MemberView{}, deny(ErrInvalid, "userId is required")
+	}
+	if role != RoleManager && role != RoleContributor && role != RoleViewer {
+		return MemberView{}, deny(ErrInvalid, "invalid role")
+	}
+	pid := p.ps.pid
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		u, ok := s.users[userID]
+		if !ok {
+			return deny(ErrInvalid, "unknown user")
+		}
+		if u.org != s.projects[pid].org {
+			return deny(ErrInvalid, "user is not part of the project's organization")
+		}
+		if s.role(pid, userID) != "" {
+			return deny(ErrConflict, "already a member")
+		}
+		if s.members[pid] == nil {
+			s.members[pid] = map[string]string{}
+		}
+		s.members[pid][userID] = role
+		return nil
+	})
+	if err != nil {
+		return MemberView{}, err
+	}
+	return MemberView{UserID: userID, Role: role}, nil
+}
