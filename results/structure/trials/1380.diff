+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager removes member", "ann", "/projects/web/members/ben", 204},
+		{"manager removes viewer", "ann", "/projects/web/members/dan", 204},
+		{"contributor", "ben", "/projects/web/members/cat", 403},
+		{"viewer", "dan", "/projects/web/members/ben", 403},
+		{"org admin without role", "eve", "/projects/web/members/ben", 403},
+		{"non member", "hal", "/projects/web/members/ben", 404},
+		{"other org", "gus", "/projects/web/members/ben", 404},
+		{"anonymous", "", "/projects/web/members/ben", 401},
+		{"unknown user", "zed", "/projects/web/members/ben", 401},
+		{"archived", "ann", "/projects/legacy/members/ben", 409},
+		{"target not a member", "ann", "/projects/web/members/hal", 404},
+		{"unknown target", "ann", "/projects/web/members/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveMemberUnassignsTasks(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 204 {
+		t.Fatalf("remove: got %d %s", code, body)
+	}
+
+	// ben is no longer a member of web: web is unreadable to him.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("removed member still reads project: got %d", code)
+	}
+
+	// His task in web is unassigned.
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.AssigneeID != "" {
+		t.Fatalf("task t1 still assigned to %q", task.AssigneeID)
+	}
+
+	// His membership and task in legacy are untouched.
+	code, body = do(t, h, "GET", "/projects/legacy/tasks/t5", "ben", "")
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	json.Unmarshal([]byte(body), &task)
+	if task.AssigneeID != "ben" {
+		t.Fatalf("task t5 in other project changed: assignee %q", task.AssigneeID)
+	}
+}
