new file mode 100644
index 0000000..c489ac3
--- /dev/null
+++ b/members.go
@@ -0,0 +1,143 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+)
+
+type moveRequest struct {
+	ToProjectID string `json:"toProjectId"`
+}
+
+type moveResponse struct {
+	UserID    string `json:"userId"`
+	ProjectID string `json:"projectId"`
+	Role      string `json:"role"`
+}
+
+// moveMember moves a member from the path project to another project of the same
+// organization, keeping the role. The caller must be a manager of both projects.
+// Tasks assigned to the user in the source project become unassigned, because an
+// assignee must be a contributor or manager of the task's project.
+func (s *server) moveMember(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	caller, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if caller == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	src, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if src == nil || src.OrgID != caller.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	srcRole, err := findRole(ctx, s.db, src.ID, caller.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if srcRole == "" && !caller.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if srcRole != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if src.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req moveRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || req.ToProjectID == "" {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	dst, err := findProject(ctx, s.db, req.ToProjectID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if dst == nil || dst.OrgID != caller.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	dstRole, err := findRole(ctx, s.db, dst.ID, caller.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if dstRole == "" && !caller.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if dstRole != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if dst.Archived {
+		writeError(w, 409, "target project is archived")
+		return
+	}
+	if dst.ID == src.ID {
+		writeError(w, 400, "target must be a different project")
+		return
+	}
+	uid := r.PathValue("uid")
+	role, err := findRole(ctx, s.db, src.ID, uid)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if role == "" {
+		writeError(w, 404, "not found")
+		return
+	}
+
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+	// Re-check inside the transaction so concurrent moves cannot duplicate or lose a member.
+	var n int
+	if err := tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM memberships WHERE project_id = ? AND user_id = ?`, dst.ID, uid).Scan(&n); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if n > 0 {
+		writeError(w, 409, "user is already a member of the target project")
+		return
+	}
+	res, err := tx.ExecContext(ctx, `DELETE FROM memberships WHERE project_id = ? AND user_id = ? AND role = ?`, src.ID, uid, role)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if k, _ := res.RowsAffected(); k != 1 {
+		writeError(w, 409, "membership changed concurrently")
+		return
+	}
+	if _, err := tx.ExecContext(ctx, `UPDATE tasks SET assignee = '' WHERE project_id = ? AND assignee = ?`, src.ID, uid); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if _, err := tx.ExecContext(ctx, `INSERT INTO memberships (project_id, user_id, role) VALUES (?, ?, ?)`, dst.ID, uid, role); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, moveResponse{UserID: uid, ProjectID: dst.ID, Role: role})
+}
