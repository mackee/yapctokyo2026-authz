diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..a5cb520
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,84 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestChangeMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager promotes viewer", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"manager keeps viewer", "ann", "/projects/web/members/dan", `{"role":"viewer"}`, 200},
+		{"manager demotes member without tasks", "ivy", "/projects/web/members/ann", `{"role":"viewer"}`, 200},
+		{"contributor", "ben", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"viewer", "dan", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"viewer in this project only", "ann", "/projects/ops/members/cat", `{"role":"manager"}`, 403},
+		{"org admin", "eve", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"non member", "hal", "/projects/web/members/dan", `{"role":"manager"}`, 404},
+		{"other org", "gus", "/projects/web/members/dan", `{"role":"manager"}`, 404},
+		{"anonymous", "", "/projects/web/members/dan", `{"role":"manager"}`, 401},
+		{"target is not a member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"target is in another project only", "ann", "/projects/web/members/gus", `{"role":"viewer"}`, 404},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"manager"}`, 409},
+		{"unknown role", "ann", "/projects/web/members/dan", `{"role":"owner"}`, 400},
+		{"missing role", "ann", "/projects/web/members/dan", `{}`, 400},
+		{"bad json", "ann", "/projects/web/members/dan", `{`, 400},
+		{"bad body beats forbidden", "ben", "/projects/web/members/dan", `{"role":"owner"}`, 400},
+		{"demote member with assigned tasks", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestChangeMemberRoleResponseAndEffect(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got struct{ UserID, Role string }
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.UserID != "dan" || got.Role != "contributor" {
+		t.Fatalf("unexpected response %s", body)
+	}
+	// The new role takes effect: dan can now create tasks.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("promoted member cannot write: %d", code)
+	}
+	// Demoting back to viewer is refused while dan has an assigned task...
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"y","assignee":"dan"}`); code != 200 {
+		t.Fatalf("create: %d", code)
+	}
+	if code, _ := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"viewer"}`); code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	// ...and the role is unchanged after the rejection.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"z"}`); code != 200 {
+		t.Fatalf("role changed despite rejection: %d", code)
+	}
+}
+
+func TestChangeMemberRoleDoesNotAffectOtherProjects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ann", "ivy", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("got %d", code)
+	}
+	// ann is now a viewer in web, but still a manager in legacy (rule: roles are per project).
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ann", `{"title":"x"}`); code != 403 {
+		t.Fatalf("got %d want 403", code)
+	}
+	if code, _ := do(t, h, "PUT", "/projects/legacy/members/ben", "ann", `{"role":"manager"}`); code != 409 {
+		t.Fatalf("got %d want 409 (still a manager there, project archived)", code)
+	}
+}
