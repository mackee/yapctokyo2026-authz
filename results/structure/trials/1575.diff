+// changeRoleAggregate changes the role of one member of one project.
+type changeRoleAggregate struct {
+	membership *Membership
+	assigned   []*Task // membership.AssignedTasks(): must stay assigned to a contributor or manager
+	role       string
+}
+
+func loadChangeRole(ctx context.Context, tx DB, projectID string, in MembershipTableChangeRoleInput) (*changeRoleAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	m, err := p.Membership(ctx, tx, in.UserID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	tasks, err := m.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &changeRoleAggregate{membership: m, assigned: tasks, role: in.Role}, nil
+}
+
+func (a *changeRoleAggregate) validate() error {
+	if !isWriterRole(a.role) && len(a.assigned) > 0 {
+		return deny(ErrInvalid, "member still has assigned tasks; reassign them before making the member a viewer")
+	}
+	return nil
+}
+
+func (a *changeRoleAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.membership.setRole(ctx, tx, a.role); err != nil {
+		return nil, err
+	}
+	return a.membership, nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
