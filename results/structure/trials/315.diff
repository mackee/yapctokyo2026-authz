+// ManageProject may administer the members of one project. Only managers hold it.
+type ManageProject interface {
+	Members() []MemberView
+	// SetRoles changes the roles of existing members as one all-or-nothing
+	// batch and returns the members after the change, sorted by user ID. The
+	// batch is rejected with ErrInvalid (and nothing changes) if any user is not
+	// a member of the project, any role is invalid, or the change would break a
+	// model invariant (for example, demoting a user to viewer while they hold a
+	// task in the project).
+	SetRoles(roles map[string]string) ([]MemberView, error)
+}
+
+type manageProject struct{ ps *projectScope }
+
+func (p *manageProject) Members() []MemberView {
+	var out []MemberView
+	_ = p.ps.as.a.st.read(func(s *state) error { out = s.membersIn(p.ps.pid); return nil })
+	return out
+}
+
+func (p *manageProject) SetRoles(roles map[string]string) ([]MemberView, error) {
+	if len(roles) == 0 {
+		return nil, deny(ErrInvalid, "roles must not be empty")
+	}
+	uids := make([]string, 0, len(roles))
+	for uid := range roles {
+		uids = append(uids, uid)
+	}
+	sort.Strings(uids)
+	for _, uid := range uids {
+		if !isRole(roles[uid]) {
+			return nil, deny(ErrInvalid, "invalid role for "+uid)
+		}
+	}
+	var out []MemberView
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		m := s.members[p.ps.pid]
+		for _, uid := range uids {
+			if _, ok := m[uid]; !ok {
+				return deny(ErrInvalid, uid+" is not a member of the project")
+			}
+			m[uid] = roles[uid]
+		}
+		out = s.membersIn(p.ps.pid)
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return out, nil
+}
+
 type readProject struct{ ps *projectScope }
 
 func (p *readProject) ID() string { return p.ps.pid }
