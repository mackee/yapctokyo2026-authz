diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..1c5ed2d
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,104 @@
+package main
+
+import (
+	"encoding/json"
+	"reflect"
+	"testing"
+)
+
+func TestSetMemberRolesCases(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager changes roles", "ann", "web", `{"roles":{"dan":"contributor"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"malformed body", "ann", "web", `nope`, 400},
+		{"invalid role", "ann", "web", `{"roles":{"dan":"owner"}}`, 400},
+		{"target not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"target unknown user", "ann", "web", `{"roles":{"zed":"viewer"}}`, 400},
+		{"demote assignee breaks invariant", "ann", "web", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMemberRolesResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann",
+		`{"roles":{"dan":"contributor","ben":"manager"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}{
+		{"ann", "manager"},
+		{"ben", "manager"},
+		{"cat", "contributor"},
+		{"dan", "contributor"},
+		{"ivy", "manager"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+}
+
+func TestSetMemberRolesTakesEffect(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 403 {
+		t.Fatalf("viewer create before change: got %d want 403", code)
+	}
+	if code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor"}}`); code != 200 {
+		t.Fatalf("change: got %d: %s", code, body)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 201 {
+		t.Fatalf("contributor create after change: got %d want 201", code)
+	}
+}
+
+// A batch that fails must change nothing, including the entries that were
+// individually valid.
+func TestSetMemberRolesIsAllOrNothing(t *testing.T) {
+	h := newServer()
+	batches := []string{
+		// ben holds t1 in web, so demoting him breaks the assignee invariant.
+		`{"roles":{"ben":"viewer","dan":"contributor"}}`,
+		// hal is not a member of web.
+		`{"roles":{"dan":"contributor","hal":"viewer"}}`,
+		// "owner" is not a role.
+		`{"roles":{"dan":"contributor","ben":"owner"}}`,
+	}
+	for _, b := range batches {
+		if code, _ := do(t, h, "PUT", "/projects/web/members", "ann", b); code != 400 {
+			t.Fatalf("batch %s: got %d want 400", b, code)
+		}
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 403 {
+		t.Fatalf("dan should still be viewer: got %d want 403", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 201 {
+		t.Fatalf("ben should still be contributor: got %d want 201", code)
+	}
+}
