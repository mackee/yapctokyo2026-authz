+// moveMemberAggregate moves one member between two projects of the same
+// organization, keeping the role. Its tasks in the source project are
+// unassigned so that no assignee is left outside the project.
+type moveMemberAggregate struct {
+	from        *Membership // the member's membership in the source project
+	toProjectID string
+	assigned    []*Task // the source project's tasks assigned to the member
+}
+
+func loadMoveMember(ctx context.Context, x *Tx, fromProjectID, toProjectID, userID string) (*moveMemberAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, x, fromProjectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if _, err := NewMembershipTable().Find(ctx, x, toProjectID, userID); err == nil {
+		return nil, deny(ErrInvalid, "user is already a member of the destination project")
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	tasks, err := m.AssignedTasks(ctx, x)
+	if err != nil {
+		return nil, err
+	}
+	return &moveMemberAggregate{from: m, toProjectID: toProjectID, assigned: tasks}, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if !isWriterRole(a.from.Role) && a.from.Role != RoleViewer {
+		return deny(ErrInvalid, "member must have a valid role")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, x *Tx) (*Membership, error) {
+	for _, t := range a.assigned {
+		if err := t.unassign(ctx, x); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.from.destroy(ctx, x); err != nil {
+		return nil, err
+	}
+	to := &Membership{ProjectID: a.toProjectID, UserID: a.from.UserID, Role: a.from.Role}
+	if err := to.save(ctx, x); err != nil {
+		return nil, err
+	}
+	return to, nil
+}
