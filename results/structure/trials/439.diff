+
+// moveMember moves {uid} from this project to toProjectId, keeping the role.
+// The destination is looked up as the actor (so an unreadable or foreign-org
+// destination is 404) before the table operation checks the rules.
+func moveMember(ctx tanukirpc.Context[*projectRegistry], req moveMemberRequest) (*moveMemberResponse, error) {
+	reg := ctx.Registry()
+	to, err := model.NewProjectAuthz(ctx, reg.db, reg.authz.Actor(), req.ToProjectID)
+	if err != nil {
+		return nil, err
+	}
+	m, err := model.NewMembershipTable().Move(ctx, reg.db, reg.authz, to, model.MembershipTableMoveInput{UserID: chi.URLParam(ctx.Request(), "uid")})
+	if err != nil {
+		return nil, err
+	}
+	return &moveMemberResponse{UserID: m.UserID, ProjectID: m.ProjectID, Role: m.Role}, nil
+}
