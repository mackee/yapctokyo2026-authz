 // NewMembershipTable returns the memberships table.
 func NewMembershipTable() *MembershipTable { return &MembershipTable{} }
 
+// MembershipTableMoveInput is the input of MembershipTable.Move.
+type MembershipTableMoveInput struct {
+	UserID string // the member to move; keeps its role
+}
+
+// Move moves a member from the source project to the destination project with
+// the same role. The actor must manage both projects (CanManageMembers). The
+// member's tasks in the source project are unassigned, and the member must not
+// already be in the destination. The move is all-or-nothing.
+func (*MembershipTable) Move(ctx context.Context, db DB, from, to ProjectAuthz, in MembershipTableMoveInput) (*Membership, error) {
+	if from.ProjectID() == to.ProjectID() {
+		return nil, deny(ErrInvalid, "destination must be a different project")
+	}
+	if err := from.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if err := to.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var out *Membership
+	if err := db.update(ctx, func(x *Tx) error {
+		agg, err := loadMoveMember(ctx, x, from.ProjectID(), to.ProjectID(), in.UserID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		out, err = agg.apply(ctx, x)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
