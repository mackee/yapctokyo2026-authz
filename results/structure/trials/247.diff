+// Manage applies the manage rule: readable, manager (else 403), not archived
+// (else 409).
+func (s *projectScope) Manage() (ManageProject, error) {
+	err := s.as.a.st.read(func(st *state) error {
+		p, r, err := readable(st, s.as.actor, s.pid)
+		if err != nil {
+			return err
+		}
+		if r != RoleManager {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if p.archived {
+			return deny(ErrArchived, "project is archived")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &manageProject{readProject: readProject{ps: s}}, nil
+}
+
 // ---- project capabilities ----------------------------------------------------
 
+// MemberView is the public representation of a project member.
+type MemberView struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// ManageProject is the manager-only capability for one project's membership.
+type ManageProject interface {
+	ReadProject
+	// SetRole changes a member's role. An invalid role is 400, a user who is
+	// not a member is 404. Changes that would break an invariant (demoting an
+	// assignee of an open task to viewer, removing the last manager) are 400.
+	SetRole(userID, role string) (MemberView, error)
+}
+
+type manageProject struct{ readProject }
+
+func (p *manageProject) SetRole(userID, role string) (MemberView, error) {
+	if role != RoleManager && role != RoleContributor && role != RoleViewer {
+		return MemberView{}, deny(ErrInvalid, "role must be manager, contributor or viewer")
+	}
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		if s.role(p.ps.pid, userID) == "" {
+			return deny(ErrNotFound, "not found")
+		}
+		s.members[p.ps.pid][userID] = role
+		return nil
+	})
+	if err != nil {
+		return MemberView{}, err
+	}
+	return MemberView{UserID: userID, Role: role}, nil
+}
