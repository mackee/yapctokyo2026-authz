+func TestSetRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager promotes", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"demote assignee", "ann", "/projects/web/members/cat", `{"role":"viewer"}`, 400}, // cat has t2
+		{"viewer in other project", "ann", "/projects/ops/members/cat", `{"role":"manager"}`, 403},
+		{"archived project", "ann", "/projects/legacy/members/ann", `{"role":"viewer"}`, 409},
+		{"manager demotes self with other manager", "ann", "/projects/web/members/ann", `{"role":"contributor"}`, 200},
+		{"contributor", "ben", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"viewer", "dan", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"org admin", "eve", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"non member", "hal", "/projects/web/members/dan", `{"role":"manager"}`, 404},
+		{"other org", "gus", "/projects/web/members/dan", `{"role":"manager"}`, 404},
+		{"anonymous", "", "/projects/web/members/dan", `{"role":"manager"}`, 401},
+		{"target not member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"invalid role", "ann", "/projects/web/members/dan", `{"role":"owner"}`, 400},
+		{"bad body", "ann", "/projects/web/members/dan", `nope`, 400},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetRoleResponseAndEffect(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["userId"] != "dan" || got["role"] != "contributor" || len(got) != 2 {
+		t.Fatalf("unexpected body %s", body)
+	}
+	// dan can now write.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x","assignee":"dan"}`); code != 201 {
+		t.Fatalf("dan create got %d", code)
+	}
+	// dan is now assigned a task, so demoting to viewer would break an invariant.
+	if code, _ := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"viewer"}`); code != 400 {
+		t.Fatalf("demote assignee got %d", code)
+	}
+}
+
+func TestLastManagerProtected(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "PUT", "/projects/ops/members/ivy", "ivy", `{"role":"viewer"}`); code != 400 {
+		t.Fatalf("sole manager demote got %d", code)
+	}
+	if code, _ := do(t, h, "PUT", "/projects/ops/members/cat", "ivy", `{"role":"manager"}`); code != 200 {
+		t.Fatalf("promote got %d", code)
+	}
+	if code, _ := do(t, h, "PUT", "/projects/ops/members/ivy", "ivy", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote with another manager got %d", code)
+	}
+}
