+// MemberView is the public representation of a project member.
+type MemberView struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// ManageProject may change the roles of members of one project.
+type ManageProject interface {
+	ReadProject
+	// SetMemberRole sets the project role of an existing member. The role must
+	// be manager, contributor or viewer (else 400); a user who is not a member
+	// of this project is 404. Demoting a user who is assigned a task in this
+	// project is rejected (400) by the model invariants; nothing changes.
+	SetMemberRole(userID, role string) (MemberView, error)
+}
+
+type manageProject struct {
+	readProject
+}
+
+func (p *manageProject) SetMemberRole(userID, role string) (MemberView, error) {
+	if role != RoleManager && role != RoleContributor && role != RoleViewer {
+		return MemberView{}, deny(ErrInvalid, "role must be manager, contributor or viewer")
+	}
+	var v MemberView
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		if _, ok := s.members[p.ps.pid][userID]; !ok {
+			return deny(ErrNotFound, "not found")
+		}
+		s.members[p.ps.pid][userID] = role
+		v = MemberView{UserID: userID, Role: role}
+		return nil
+	})
+	return v, err
+}
+
 type writeProject struct {
 	readProject
 	role string
