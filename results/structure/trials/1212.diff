+// TaskTableMoveInput is the input of TaskTable.Move.
+type TaskTableMoveInput struct {
+	ToProjectID string
+}
+
+// Move moves the task to another project. The actor must be able to edit the
+// task (CanEdit), and must be able to write in the destination (contributor or
+// manager there, and not archived). The destination must be readable by the
+// actor, else it is not found. The task keeps its ID, title, status and
+// assignee, so the assignee must be a contributor or manager of the destination.
+func (*TaskTable) Move(ctx context.Context, db DB, authz TaskAuthz, in TaskTableMoveInput) (*Task, error) {
+	if err := authz.CanEdit(); err != nil {
+		return nil, err
+	}
+	if in.ToProjectID == "" {
+		return nil, deny(ErrInvalid, "toProjectId must not be empty")
+	}
+	to, err := NewProjectAuthz(ctx, db, authz.Project().Actor(), in.ToProjectID)
+	if err != nil {
+		return nil, err
+	}
+	if err := to.CanWrite(); err != nil {
+		return nil, err
+	}
+	if to.ProjectID() == authz.Project().ProjectID() {
+		return nil, deny(ErrInvalid, "task is already in that project")
+	}
+	var t *Task
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveTask(ctx, tx, authz.TaskID(), to.ProjectID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if t, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return t, nil
+}
