diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..ca3b997
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,95 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+
+	"taskboard/internal/capability"
+)
+
+func TestSetMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager changes role", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"manager demotes another manager", "ann", "/projects/web/members/ivy", `{"role":"contributor"}`, 200},
+		{"contributor", "ben", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"viewer changes self", "dan", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"org admin", "eve", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"non member", "hal", "/projects/web/members/dan", `{"role":"contributor"}`, 404},
+		{"other org", "gus", "/projects/web/members/dan", `{"role":"contributor"}`, 404},
+		{"anonymous", "", "/projects/web/members/dan", `{"role":"contributor"}`, 401},
+		{"unknown user", "zed", "/projects/web/members/dan", `{"role":"contributor"}`, 401},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"invalid role", "ann", "/projects/web/members/dan", `{"role":"owner"}`, 400},
+		{"empty role", "ann", "/projects/web/members/dan", `{"role":""}`, 400},
+		{"invalid body", "ann", "/projects/web/members/dan", `not json`, 400},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"target unknown user", "ann", "/projects/web/members/zed", `{"role":"viewer"}`, 404},
+		{"target member of another project only", "ann", "/projects/web/members/gus", `{"role":"viewer"}`, 404},
+		{"demoting an assignee breaks invariant", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMemberRoleResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got capability.MemberView
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := capability.MemberView{UserID: "dan", Role: "contributor"}
+	if got != want {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+}
+
+// A role change must take effect on the very next request, and a manager's
+// demotion must take effect too.
+func TestSetMemberRoleTakesEffect(t *testing.T) {
+	srv := newServer()
+	const tasks = "/projects/web/tasks"
+	const dan = "/projects/web/members/dan"
+
+	if code, _ := do(t, srv, "POST", tasks, "dan", `{"title":"x"}`); code != 403 {
+		t.Fatalf("viewer create: got %d want 403", code)
+	}
+	if code, _ := do(t, srv, "PUT", dan, "ann", `{"role":"contributor"}`); code != 200 {
+		t.Fatalf("promote: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "POST", tasks, "dan", `{"title":"x"}`); code != 201 {
+		t.Fatalf("promoted create: got %d want 201", code)
+	}
+	if code, _ := do(t, srv, "PUT", dan, "dan", `{"role":"manager"}`); code != 403 {
+		t.Fatalf("self promote: got %d want 403", code)
+	}
+	if code, _ := do(t, srv, "PUT", dan, "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "POST", tasks, "dan", `{"title":"x"}`); code != 403 {
+		t.Fatalf("demoted create: got %d want 403", code)
+	}
+}
+
+// A rejected role change must leave the membership untouched.
+func TestSetMemberRoleRejectedLeavesStateUnchanged(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 400 {
+		t.Fatalf("demote assignee: got %d want 400", code)
+	}
+	// ben is still a contributor who can create tasks.
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 201 {
+		t.Fatalf("ben create after rejected demotion: got %d want 201", code)
+	}
+}
