+func newServerWithStore(st *Store) http.Handler {
+	s := &server{store: st}
 	mux := http.NewServeMux()
 	mux.HandleFunc("GET /projects/{pid}/tasks", s.listTasks)
 	mux.HandleFunc("POST /projects/{pid}/tasks", s.createTask)
 	mux.HandleFunc("GET /projects/{pid}/tasks/{tid}", s.getTask)
 	mux.HandleFunc("PATCH /projects/{pid}/tasks/{tid}", s.updateTask)
 	mux.HandleFunc("DELETE /projects/{pid}/tasks/{tid}", s.deleteTask)
+	mux.HandleFunc("DELETE /orgs/{orgID}/users/{uid}", s.removeOrgUser)
 	return mux
 }
 
+// removeOrgUser offboards a user from an org. Only org admins of that org may
+// do it (other orgs -> 404, non-admin members -> 403, unknown target -> 404).
+func (s *server) removeOrgUser(w http.ResponseWriter, r *http.Request) {
+	s.store.mu.Lock()
+	defer s.store.mu.Unlock()
+
+	user := s.store.User(r.Header.Get("X-User"))
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	orgID := r.PathValue("orgID")
+	if user.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	if !user.OrgAdmin {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	target := s.store.User(r.PathValue("uid"))
+	if target == nil || target.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	s.store.RemoveUserFromOrg(orgID, target.ID)
+	w.WriteHeader(204)
+}
+
