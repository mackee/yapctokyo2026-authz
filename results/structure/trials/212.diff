+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes", "eve", "/orgs/acme/users/ann", 204},
+		{"anonymous", "", "/orgs/acme/users/ann", 401},
+		{"non admin", "ann", "/orgs/acme/users/ben", 403},
+		{"other org caller", "gus", "/orgs/acme/users/ann", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	st := newSeededStore()
+	h := newServerWithStore(st)
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatal(code)
+	}
+	// ben is gone: no longer authenticates.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 401 {
+		t.Fatalf("removed user got %d want 401", code)
+	}
+	// removed from every project, archived included, and unassigned.
+	for _, p := range []string{"web", "ops", "legacy"} {
+		if role := st.Role(p, "ben"); role != "" {
+			t.Fatalf("ben still has role %q in %s", role, p)
+		}
+	}
+	_, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" {
+		t.Fatalf("t1 still assigned to %q", task.Assignee)
+	}
+	// other org untouched.
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatal(code)
+	}
+	// removing the same user again is 404.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 404 {
+		t.Fatalf("got %d want 404", code)
+	}
+}
+
+func TestRemoveOrgAdminLosesAccess(t *testing.T) {
