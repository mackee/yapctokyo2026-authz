+// RemoveUserFromOrg offboards a user: removes them from every project of the
+// org (archived ones included), unassigns their tasks there, and deletes the
+// user so no access (e.g. org-admin read) lingers.
+func (s *Store) RemoveUserFromOrg(orgID, userID string) {
+	for _, p := range s.projects {
+		if p.OrgID != orgID {
+			continue
+		}
+		delete(s.members[p.ID], userID)
+	}
+	for _, t := range s.tasks {
+		if t.Assignee != userID {
+			continue
+		}
+		if p := s.projects[t.ProjectID]; p != nil && p.OrgID == orgID {
+			t.Assignee = ""
+		}
+	}
+	delete(s.users, userID)
+}
