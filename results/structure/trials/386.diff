+// ManageOrg is the org admin capability for one organization.
+type ManageOrg interface {
+	// Transfer moves a user of this organization to another organization.
+	// The user leaves their project memberships and their assigned tasks are
+	// unassigned, in the same write. Org admin rights are cleared.
+	// An unknown user or a user of another organization is 404; an unknown
+	// target organization, or the same organization, is 400.
+	Transfer(userID, toOrgID string) (UserView, error)
+}
+
+type manageOrg struct{ os *orgScope }
+
+func (m *manageOrg) Transfer(userID, toOrgID string) (UserView, error) {
+	var v UserView
+	err := m.os.as.a.db.update(func(x *tx) error {
+		agg, err := loadTransferUser(x, m.os.oid, userID, toOrgID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		v = agg.apply(x)
+		return nil
+	})
+	return v, err
+}
