+func TestTransferAccess(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 200},
+		{"org member, not admin", "ann", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 403},
+		{"other org admin", "gus", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 404},
+		{"anonymous", "", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown user", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"user of another org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"unknown target org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"initech"}`, 400},
+		{"same org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"acme"}`, 400},
+		{"missing target org", "eve", "/orgs/acme/users/ben/transfer", `{}`, 400},
+		{"malformed body", "eve", "/orgs/acme/users/ben/transfer", ``, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got struct {
+		ID    string `json:"id"`
+		OrgID string `json:"orgId"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.ID != "ben" || got.OrgID != "globex" {
+		t.Fatalf("got %+v", got)
+	}
+}
+
+func TestTransferEffects(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: got %d: %s", code, body)
+	}
+
+	// The moved user loses access to the old org's projects, memberships and all.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("moved user reads old project: got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "PATCH", "/projects/legacy/tasks/t5", "ben", `{"status":"done"}`); code != 404 {
+		t.Fatalf("moved user writes old project: got %d want 404", code)
+	}
+
+	// Tasks assigned to the moved user are unassigned; the rest are untouched.
+	code, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" {
+		t.Fatalf("t1 still assigned to %q", task.Assignee)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("other member lost access: got %d", code)
+	}
+
+	// Transferring one user does not change another admin's access.
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "eve", ""); code != 200 {
+		t.Fatalf("eve lost acme admin read after transferring ben: got %d", code)
+	}
+}
+
+func TestTransferAdminRightsCleared(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: got %d: %s", code, body)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "eve", ""); code != 404 {
+		t.Fatalf("transferred admin reads old org: got %d want 404", code)
+	}
+}
+
+func TestTransferFailureChangesNothing(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"initech"}`); code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("failed transfer removed access: got %d", code)
+	}
+	code, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "ben" {
+		t.Fatalf("failed transfer unassigned t1: %q", task.Assignee)
+	}
+}
