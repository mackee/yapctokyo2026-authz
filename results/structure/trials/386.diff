+// ---- org capabilities ---------------------------------------------------------
+
+type orgScope struct {
+	as  *actorScope
+	oid string
+}
+
+func (s *orgScope) ID() string { return s.oid }
+
+// Manage applies the org admin rule: the actor must belong to this
+// organization (else 404), and must be an org admin of it (else 403).
+func (s *orgScope) Manage() (ManageOrg, error) {
+	if s.as.actor.org != s.oid {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if !s.as.actor.orgAdmin {
+		return nil, deny(ErrForbidden, "forbidden")
+	}
+	return &manageOrg{os: s}, nil
