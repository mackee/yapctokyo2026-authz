+// transferUserAggregate moves one user from their organization to another.
+// Project memberships belong to the organization of the project, so the user
+// leaves all their projects, and tasks assigned to them are unassigned.
+type transferUserAggregate struct {
+	fromOrg     string
+	user        userRecord
+	toOrg       orgRecord
+	memberships []membershipRecord
+	assigned    []taskRecord
+}
+
+func loadTransferUser(x *tx, fromOrg, userID, toOrgID string) (*transferUserAggregate, error) {
+	u, ok := x.findUser(userID)
+	if !ok || u.Org != fromOrg {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	o, ok := x.findOrg(toOrgID)
+	if !ok {
+		return nil, deny(ErrInvalid, "target organization does not exist")
+	}
+	return &transferUserAggregate{
+		fromOrg:     fromOrg,
+		user:        u,
+		toOrg:       o,
+		memberships: u.Memberships(x),
+		assigned:    u.AssignedTasks(x),
+	}, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if a.toOrg.ID == a.fromOrg {
+		return deny(ErrInvalid, "user is already in that organization")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(x *tx) UserView {
+	for _, m := range a.memberships {
+		m.Destroy(x)
+	}
+	for _, t := range a.assigned {
+		t.Unassign(x)
+	}
+	u := a.user
+	u.MoveTo(x, a.toOrg.ID)
+	return UserView{ID: u.ID, OrgID: u.Org}
+}
+
