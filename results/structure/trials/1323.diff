+// moveMember: POST /projects/{pid}/members/{uid}/move {"toProjectId": q}
+// Mirrors moveOutcome in spec/taskboard.qnt.
+func (s *server) moveMember(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	src, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if src == nil || src.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role, err := findRole(ctx, s.db, src.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	memberID := r.PathValue("uid")
+	memberRole, err := findRole(ctx, s.db, src.ID, memberID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if memberRole == "" {
+		writeError(w, 404, "member not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if src.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req moveRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || req.ToProjectID == "" {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	if req.ToProjectID == src.ID {
+		writeError(w, 400, "member is already in this project")
+		return
+	}
+	dst, err := findProject(ctx, s.db, req.ToProjectID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if dst == nil || dst.OrgID != user.OrgID {
+		writeError(w, 404, "destination project not found")
+		return
+	}
+	dstRole, err := findRole(ctx, s.db, dst.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if dstRole == "" && !user.OrgAdmin {
+		writeError(w, 404, "destination project not found")
+		return
+	}
+	if dstRole != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if dst.Archived {
+		writeError(w, 409, "destination project is archived")
+		return
+	}
+	existing, err := findRole(ctx, s.db, dst.ID, memberID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if existing != "" {
+		writeError(w, 409, "member already belongs to the destination project")
+		return
+	}
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+	if _, err := tx.ExecContext(ctx, `DELETE FROM memberships WHERE project_id = ? AND user_id = ?`, src.ID, memberID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if _, err := tx.ExecContext(ctx, `INSERT INTO memberships (project_id, user_id, role) VALUES (?, ?, ?)`, dst.ID, memberID, memberRole); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if _, err := tx.ExecContext(ctx, `UPDATE tasks SET assignee = '' WHERE project_id = ? AND assignee = ?`, src.ID, memberID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, moveResponse{UserID: memberID, ProjectID: dst.ID, Role: memberRole})
+}
