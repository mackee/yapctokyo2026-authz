+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager moves unassigned", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 200},
+		{"manager moves to target where assignee is contributor", "ivy", "/projects/web/tasks/t2/move", `{"toProjectId":"ops"}`, 200},
+		{"assignee not in target", "ivy", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 400},
+		{"contributor cannot move", "ben", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer cannot move", "dan", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"non member of source", "hal", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 404},
+		{"target is viewer only", "ann", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"target not readable", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"legacy"}`, 404},
+		{"target in other org", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"gx"}`, 404},
+		{"target missing", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"nope"}`, 404},
+		{"target archived", "ann", "/projects/web/tasks/t1/move", `{"toProjectId":"legacy"}`, 409},
+		{"source archived", "ann", "/projects/legacy/tasks/t5/move", `{"toProjectId":"web"}`, 409},
+		{"same project", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"web"}`, 400},
+		{"task in other project", "ivy", "/projects/ops/tasks/t1/move", `{"toProjectId":"web"}`, 404},
+		{"empty target", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":""}`, 400},
+		{"missing target", "ivy", "/projects/web/tasks/t3/move", `{}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsTask(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d: %s", code, body)
+	}
+	var moved Task
+	if err := json.Unmarshal([]byte(body), &moved); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", AssigneeID: "cat"}
+	if moved != want {
+		t.Fatalf("moved task = %+v, want %+v", moved, want)
+	}
+
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks/t2", "ivy", ""); code != 200 {
+		t.Fatalf("GET in target: got %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t2", "ivy", ""); code != 404 {
+		t.Fatalf("GET in source after move: got %d want 404", code)
+	}
+}
