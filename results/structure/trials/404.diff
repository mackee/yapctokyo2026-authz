+// Move moves the task to the project toProjectID. The actor must be a manager
+// of the task's current project (CanManage, checked first so a non-manager
+// learns nothing about the target). The target must be readable by the actor
+// (else 404) and the actor must be a contributor or manager there (CanWrite).
+// The task keeps its ID, title, status and assignee; an assignee who is not a
+// contributor or manager of the target makes the move invalid (400).
+func (tt *TaskTable) Move(ctx context.Context, db DB, authz TaskAuthz, toProjectID string) (*Task, error) {
+	if err := authz.CanManage(); err != nil {
+		return nil, err
+	}
+	to, err := NewProjectAuthz(ctx, db, authz.Project().Actor(), toProjectID)
+	if err != nil {
+		return nil, err
+	}
+	if err := to.CanWrite(); err != nil {
+		return nil, err
+	}
+	if to.ProjectID() == authz.Project().ProjectID() {
+		return nil, deny(ErrInvalid, "task is already in the project")
+	}
+	var t *Task
+	if err := db.update(ctx, func(x *Tx) error {
+		agg, err := loadMoveTask(ctx, x, authz.TaskID(), to.ProjectID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if t, err = agg.apply(ctx, x); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return t, nil
+}
