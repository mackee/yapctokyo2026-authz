+// moveTaskAggregate moves one task to another project.
+type moveTaskAggregate struct {
+	task     *Task
+	to       *Project
+	assignee *Membership // the assignee's membership in the target project; nil if unassigned or not a member
+}
+
+func loadMoveTask(ctx context.Context, x *Tx, taskID, toProjectID string) (*moveTaskAggregate, error) {
+	t, err := NewTaskTable().Find(ctx, x, taskID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	to, err := NewProjectTable().Find(ctx, x, toProjectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveTaskAggregate{task: t, to: to}
+	if t.AssigneeID != "" {
+		m, err := to.Membership(ctx, x, t.AssigneeID)
+		if err == nil {
+			a.assignee = m
+		} else if !errors.Is(err, ErrNoRows) {
+			return nil, err
+		}
+	}
+	return a, nil
+}
+
+// validate keeps the assignee rule: an assigned task must have a contributor
+// or manager as its assignee in the target project. The assignee is kept on
+// move, so a move that would break this is rejected.
+func (a *moveTaskAggregate) validate() error {
+	if a.task.AssigneeID != "" && (a.assignee == nil || !isWriterRole(a.assignee.Role)) {
+		return deny(ErrInvalid, "assignee must be a contributor or manager of the project")
+	}
+	return nil
+}
+
+func (a *moveTaskAggregate) apply(ctx context.Context, x *Tx) (*Task, error) {
+	if err := a.task.moveTo(ctx, x, a.to.ID); err != nil {
+		return nil, err
+	}
+	return a.task, nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
