+++ b/members_test.go
@@ -0,0 +1,106 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager removes contributor", "ann", "/projects/web/members/ben", 204},
+		{"manager removes viewer", "ann", "/projects/web/members/dan", 204},
+		{"contributor", "ben", "/projects/web/members/cat", 403},
+		{"viewer", "dan", "/projects/web/members/ben", 403},
+		{"org admin without role", "eve", "/projects/web/members/ben", 403},
+		{"non member actor", "hal", "/projects/web/members/ben", 404},
+		{"other org actor", "gus", "/projects/web/members/ben", 404},
+		{"anonymous", "", "/projects/web/members/ben", 401},
+		{"target not a member", "ann", "/projects/web/members/hal", 404},
+		{"unknown target", "ann", "/projects/web/members/zed", 404},
+		{"archived", "ann", "/projects/legacy/members/ben", 409},
+		{"project of another org", "ann", "/projects/gx/members/gus", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveMemberNoBody(t *testing.T) {
+	code, body := do(t, newServer(), "DELETE", "/projects/web/members/ben", "ann", "")
+	if code != 204 {
+		t.Fatalf("got %d want 204", code)
+	}
+	if body != "" {
+		t.Fatalf("want empty body, got %q", body)
+	}
+}
+
+func TestRemoveMemberRemovesAccess(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+	// ben is no longer a member, so the project is not readable by ben.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("former member read: got %d want 404", code)
+	}
+	// ben's write attempt is refused too.
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 404 {
+		t.Fatalf("former member write: got %d want 404", code)
+	}
+}
+
+func TestRemoveMemberUnassignsTasks(t *testing.T) {
+	h := newServer()
+	// t1 is assigned to ben (a contributor of web): it is unassigned, and its
+	// other fields are unchanged.
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+	_, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "" {
+		t.Fatalf("t1 still assigned to %q", task.AssigneeID)
+	}
+	if task.Title != "Fix header" || task.Status != "open" {
+		t.Fatalf("t1 changed beyond its assignee: %+v", task)
+	}
+	// t2 is assigned to cat, who stays a member: unchanged.
+	_, body = do(t, h, "GET", "/projects/web/tasks/t2", "ann", "")
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "cat" {
+		t.Fatalf("t2 assignee = %q, want cat", task.AssigneeID)
+	}
+}
+
+func TestRemoveMemberIsAllOrNothing(t *testing.T) {
+	h := newServer()
+	// Forbidden: nothing changes, so ben keeps t1 and the membership.
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "cat", ""); code != 403 {
+		t.Fatalf("got %d want 403", code)
+	}
+	_, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "ben" {
+		t.Fatalf("t1 assignee = %q after refused removal, want ben", task.AssigneeID)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben lost access after refused removal: got %d", code)
+	}
+}
