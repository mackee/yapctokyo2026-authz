+//
+// Find and List* read rows. Delete is an operation: it takes the database, the
+// authorization object of the project and the user to remove, asks the
+// authorization object whether the actor may remove members, then runs its
+// aggregate (aggregate.go) in a transaction.
 type MembershipTable struct{}
 
 // NewMembershipTable returns the memberships table.
 func NewMembershipTable() *MembershipTable { return &MembershipTable{} }
 
+// Delete removes the user from the project. The user's tasks in the project
+// are unassigned in the same transaction, so no task keeps an assignee who is
+// no longer a member.
+func (mt *MembershipTable) Delete(ctx context.Context, db DB, authz ProjectAuthz, userID string) error {
+	if err := authz.CanManageMembers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveMember(ctx, tx, authz.ProjectID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
