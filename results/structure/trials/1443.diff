+
+func TestMoveMemberEffects(t *testing.T) {
+	h := newServer()
+	// ben is a contributor of web and is assigned t1 there.
+	code, body := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 3 || got["userId"] != "ben" || got["projectId"] != "ops" || got["role"] != "contributor" {
+		t.Fatalf("unexpected response %v", got)
+	}
+
+	// ben is no longer a member of web (404), but is one of ops (200).
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben still reads web: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben cannot read ops: %d", code)
+	}
+	// moving ben again from web fails: he is not a member any more.
+	if code, _ := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`); code != 404 {
+		t.Fatalf("second move got %d", code)
+	}
+	// the task he held in web is unassigned (assignee must be a member).
+	_, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "" {
+		t.Fatalf("t1 still assigned to %q", task.AssigneeID)
+	}
+	// his role carries over: as a contributor in ops he cannot assign someone else.
+	if code, _ := do(t, h, "POST", "/projects/ops/tasks", "ben", `{"title":"x","assignee":"cat"}`); code != 403 {
+		t.Fatalf("ben as ops contributor got %d", code)
+	}
+}
+
+func TestMoveMemberKeepsOtherTasks(t *testing.T) {
+	h := newServer()
+	// moving dan must not touch cat's tasks.
+	if code, body := do(t, h, "POST", "/projects/web/members/dan/move", "ivy", `{"toProjectId":"ops"}`); code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	_, body := do(t, h, "GET", "/projects/web/tasks/t2", "ann", "")
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "cat" {
+		t.Fatalf("t2 assignee %q", task.AssigneeID)
+	}
+}
