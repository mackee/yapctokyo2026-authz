+// moveMemberAggregate moves one member from a project to another, keeping the
+// role. Tasks of the source project assigned to the member are unassigned,
+// since an assignee must be a member of the task's project.
+type moveMemberAggregate struct {
+	from  *Membership
+	dest  *Project
+	user  *User
+	tasks []*Task // from.AssignedTasks
+}
+
+func loadMoveMember(ctx context.Context, tx DB, projectID, userID, destID string) (*moveMemberAggregate, error) {
+	from, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	dest, err := NewProjectTable().Find(ctx, tx, destID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if _, err := dest.Membership(ctx, tx, userID); err == nil {
+		return nil, deny(ErrConflict, "user is already a member of the destination project")
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	u, err := from.User(ctx, tx)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "member must be an existing user")
+	} else if err != nil {
+		return nil, err
+	}
+	tasks, err := from.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &moveMemberAggregate{from: from, dest: dest, user: u, tasks: tasks}, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.user.Org != a.dest.Org {
+		return deny(ErrInvalid, "member must belong to the project's organization")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.from.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	m := a.dest.newMembership(a.user.ID, a.from.Role)
+	if err := m.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
