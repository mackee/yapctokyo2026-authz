+// Move moves the user from the authorized project to another one, keeping the
+// role, and returns the new membership. The actor must be a manager of both
+// projects (the destination must also be readable by the actor, else
+// ErrNotFound); tasks assigned to the user in the source project are
+// unassigned.
+func (*MembershipTable) Move(ctx context.Context, db DB, authz ProjectAuthz, userID, destID string) (*Membership, error) {
+	if !authz.CanRead() {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if _, err := NewMembershipTable().Find(ctx, db, authz.ProjectID(), userID); errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if destID == authz.ProjectID() {
+		return nil, deny(ErrInvalid, "destination must be a different project")
+	}
+	destAuthz, err := NewProjectAuthz(ctx, db, authz.Actor(), destID)
+	if err != nil {
+		return nil, err
+	}
+	if err := destAuthz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveMember(ctx, tx, authz.ProjectID(), userID, destID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		m, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
