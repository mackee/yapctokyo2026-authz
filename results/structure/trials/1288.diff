+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager moves", "ivy", "/projects/web/tasks/t2/move", `{"toProjectId":"ops"}`, 200},
+		{"contributor others", "ben", "/projects/web/tasks/t2/move", `{"toProjectId":"ops"}`, 403},
+		{"contributor own, dest not a member", "ben", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 404},
+		{"contributor own, dest archived", "ben", "/projects/web/tasks/t1/move", `{"toProjectId":"legacy"}`, 409},
+		{"dest viewer", "ann", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer source", "dan", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin source", "eve", "/projects/web/tasks/t2/move", `{"toProjectId":"ops"}`, 403},
+		{"cross org source", "gus", "/projects/web/tasks/t2/move", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/tasks/t2/move", `{"toProjectId":"ops"}`, 401},
+		{"task in other project", "ivy", "/projects/web/tasks/t4/move", `{"toProjectId":"ops"}`, 404},
+		{"source archived", "ann", "/projects/legacy/tasks/t5/move", `{"toProjectId":"ops"}`, 409},
+		{"dest archived", "ann", "/projects/web/tasks/t3/move", `{"toProjectId":"legacy"}`, 409},
+		{"dest missing", "ivy", "/projects/web/tasks/t2/move", `{"toProjectId":"missing"}`, 404},
+		{"dest other org", "ivy", "/projects/web/tasks/t2/move", `{"toProjectId":"gx"}`, 404},
+		{"same project", "ivy", "/projects/web/tasks/t2/move", `{"toProjectId":"web"}`, 400},
+		{"missing toProjectId", "ivy", "/projects/web/tasks/t2/move", `{}`, 400},
+		{"bad body", "ivy", "/projects/web/tasks/t2/move", `not json`, 400},
+		{"assignee not in dest", "ivy", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsTaskFields(t *testing.T) {
+	s := newServer()
+	code, body := do(t, s, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d: %s", code, body)
+	}
+	var moved Task
+	if err := json.Unmarshal([]byte(body), &moved); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", Assignee: "cat"}
+	if moved != want {
+		t.Fatalf("moved task = %+v, want %+v", moved, want)
+	}
+
+	code, body = do(t, s, "GET", "/projects/ops/tasks/t2", "ivy", "")
+	if code != 200 {
+		t.Fatalf("get from dest: got %d: %s", code, body)
+	}
+	code, _ = do(t, s, "GET", "/projects/web/tasks/t2", "ivy", "")
+	if code != 404 {
+		t.Fatalf("get from source: got %d want 404", code)
+	}
+
+	code, body = do(t, s, "GET", "/projects/web/tasks", "ivy", "")
+	var web []Task
+	json.Unmarshal([]byte(body), &web)
+	if code != 200 || len(web) != 2 {
+		t.Fatalf("web list: code %d, %d tasks; want 200 with 2", code, len(web))
+	}
+}
