+func TestUpdateMembersAccess(t *testing.T) {
+	const web = "/projects/web/members"
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager", "ann", web, `{"roles":{"ben":"viewer","dan":"contributor"}}`, 200},
+		{"manager, other project", "ivy", "/projects/ops/members", `{"roles":{"cat":"viewer"}}`, 200},
+		{"viewer in project as manager", "ann", "/projects/ops/members", `{"roles":{"cat":"viewer"}}`, 403},
+		{"contributor", "ben", web, `{"roles":{"cat":"viewer"}}`, 403},
+		{"viewer", "dan", web, `{"roles":{"ben":"viewer"}}`, 403},
+		{"org admin", "eve", web, `{"roles":{"ben":"viewer"}}`, 403},
+		{"non member", "hal", web, `{"roles":{"ben":"viewer"}}`, 404},
+		{"other org", "gus", web, `{"roles":{"ben":"viewer"}}`, 404},
+		{"anonymous", "", web, `{"roles":{"ben":"viewer"}}`, 401},
+		{"unknown user", "zed", web, `{"roles":{"ben":"viewer"}}`, 401},
+		{"archived", "ann", "/projects/legacy/members", `{"roles":{"ben":"viewer"}}`, 409},
+		{"unknown role", "ann", web, `{"roles":{"ben":"owner"}}`, 400},
+		{"empty roles", "ann", web, `{"roles":{}}`, 400},
+		{"missing roles", "ann", web, `{}`, 400},
+		{"malformed body", "ann", web, `{"roles":`, 400},
+		{"bad body before access", "dan", web, `{"roles":{"ben":"owner"}}`, 400},
+		{"user not a member", "ann", web, `{"roles":{"hal":"viewer"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMembersResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []memberJSON
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []memberJSON{
+		{"ann", "manager"},
+		{"ben", "viewer"},
+		{"cat", "contributor"},
+		{"dan", "contributor"},
+		{"ivy", "manager"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+}
+
+func TestUpdateMembersAllOrNothing(t *testing.T) {
+	srv := newServer()
+	// hal is not a member, so the whole request fails and ben stays a contributor.
+	if code, _ := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","hal":"viewer"}}`); code != 400 {
