+// updateRolesAggregate changes the roles of several members of one project.
+type updateRolesAggregate struct {
+	project *Project
+	members []*Membership // the members to change, ordered by user ID
+	roles   []string      // roles[i] is the new role of members[i]
+}
+
+func loadUpdateRoles(ctx context.Context, tx DB, projectID string, in MembershipTableUpdateRolesInput) (*updateRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &updateRolesAggregate{project: p}
+	for _, userID := range slices.Sorted(maps.Keys(in.Roles)) {
+		m, err := p.Membership(ctx, tx, userID)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "user "+userID+" is not a member of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		a.members = append(a.members, m)
+		a.roles = append(a.roles, in.Roles[userID])
+	}
+	return a, nil
+}
+
+func (a *updateRolesAggregate) validate() error {
+	for _, role := range a.roles {
+		if !isRole(role) {
+			return deny(ErrInvalid, "invalid role "+role)
+		}
+	}
+	return nil
+}
+
+// apply changes the roles and returns the project's members after the change.
+func (a *updateRolesAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for i, m := range a.members {
+		if err := m.setRole(ctx, tx, a.roles[i]); err != nil {
+			return nil, err
+		}
+	}
+	return a.project.Memberships(ctx, tx)
+}
