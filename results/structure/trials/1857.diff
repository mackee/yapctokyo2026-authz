@@ -0,0 +1,106 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestUpdateMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager changes role", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"manager demotes contributor", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 200},
+		{"manager demotes self with another manager", "ann", "/projects/web/members/ann", `{"role":"contributor"}`, 200},
+		{"contributor", "ben", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"viewer", "dan", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"org admin", "eve", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"non member", "hal", "/projects/web/members/dan", `{"role":"contributor"}`, 404},
+		{"other org", "gus", "/projects/web/members/dan", `{"role":"contributor"}`, 404},
+		{"anonymous", "", "/projects/web/members/dan", `{"role":"contributor"}`, 401},
+		{"unknown user", "zed", "/projects/web/members/dan", `{"role":"contributor"}`, 401},
+		{"missing project", "ann", "/projects/nope/members/dan", `{"role":"contributor"}`, 404},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"contributor"}`, 404},
+		{"target does not exist", "ann", "/projects/web/members/zed", `{"role":"contributor"}`, 404},
+		{"invalid role", "ann", "/projects/web/members/dan", `{"role":"boss"}`, 400},
+		{"empty role", "ann", "/projects/web/members/dan", `{}`, 400},
+		{"bad json", "ann", "/projects/web/members/dan", `nope`, 400},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"last manager", "ivy", "/projects/ops/members/ivy", `{"role":"contributor"}`, 409},
+		{"viewer in ops", "ann", "/projects/ops/members/ivy", `{"role":"viewer"}`, 403},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRoleResponseAndEffect(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 2 || got["userId"] != "dan" || got["role"] != "contributor" {
+		t.Fatalf("unexpected body %s", body)
+	}
+	// dan is now a contributor, so can create a task assigned to self.
+	code, _ = do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x","assignee":"dan"}`)
+	if code != 200 {
+		t.Fatalf("new contributor could not create task: %d", code)
+	}
+	// Other projects are untouched: ann is still a viewer in ops.
+	app := h.(*appHandler)
+	role, err := findRole(t.Context(), app.db, "ops", "ann")
+	if err != nil || role != RoleViewer {
+		t.Fatalf("ops role of ann = %q, %v", role, err)
+	}
+}
+
+func TestDemotedMemberIsUnassigned(t *testing.T) {
+	// ben is assigned t1. Demoting him to viewer must not leave him as assignee
+	// (model rule), so his tasks become unassigned.
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	code, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatal(code)
+	}
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" {
+		t.Fatalf("t1 assignee = %q, want unassigned", task.Assignee)
+	}
+	// Tasks in other projects are untouched (cat keeps t4 in ops).
+	code, body = do(t, h, "PUT", "/projects/web/members/cat", "ann", `{"role":"viewer"}`)
+	if code != 200 {
+		t.Fatal(code)
+	}
+	code, body = do(t, h, "GET", "/projects/ops/tasks/t4", "ivy", "")
+	json.Unmarshal([]byte(body), &task)
+	if code != 200 || task.Assignee != "cat" {
+		t.Fatalf("ops t4 assignee = %q", task.Assignee)
+	}
+}
+
+func TestRejectedRoleChangeChangesNothing(t *testing.T) {
+	h := newServer()
+	do(t, h, "PUT", "/projects/web/members/dan", "ben", `{"role":"manager"}`)
+	do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"boss"}`)
+	role, err := findRole(t.Context(), h.(*appHandler).db, "web", "dan")
+	if err != nil || role != RoleViewer {
+		t.Fatalf("dan role = %q, %v", role, err)
+	}
+}
