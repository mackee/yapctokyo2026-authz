+// transferUserAggregate moves one user to another organization.
+type transferUserAggregate struct {
+	user        *User
+	orgID       string // the organization the request is about (the user's current one)
+	toOrg       string
+	toOrgExists bool
+	memberships []*Membership // user.Memberships: all become invalid in the new org
+	tasks       []*Task       // user.AssignedTasks: assignees must stay project writers
+}
+
+func loadTransferUser(ctx context.Context, tx DB, orgID, userID string, in UserTableTransferInput) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) || (err == nil && u.Org != orgID) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &transferUserAggregate{user: u, orgID: orgID, toOrg: in.ToOrgID}
+	if a.toOrgExists, err = NewUserTable().OrgExists(ctx, tx, in.ToOrgID); err != nil {
+		return nil, err
+	}
+	if a.memberships, err = u.Memberships(ctx, tx); err != nil {
+		return nil, err
+	}
+	if a.tasks, err = u.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if !a.toOrgExists || a.toOrg == a.orgID {
+		return deny(ErrInvalid, "toOrgId must be another existing organization")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	// Project members belong to the project's organization and assignees are
+	// project members, so the old memberships and assignments go first.
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.user.moveTo(ctx, tx, a.toOrg); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
