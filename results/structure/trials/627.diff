+func updateMemberRole(ctx tanukirpc.Context[*projectRegistry], req updateMemberRoleRequest) (*memberResponse, error) {
+	reg := ctx.Registry()
+	m, err := model.NewMembershipTable().UpdateRole(ctx, reg.db, reg.authz, model.MembershipTableUpdateRoleInput{
+		UserID: chi.URLParam(ctx.Request(), "uid"),
+		Role:   req.Role,
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &memberResponse{UserID: m.UserID, Role: m.Role}, nil
