 // NewMembershipTable returns the memberships table.
 func NewMembershipTable() *MembershipTable { return &MembershipTable{} }
 
+// MembershipTableUpdateRoleInput is the input of MembershipTable.UpdateRole.
+type MembershipTableUpdateRoleInput struct {
+	UserID string
+	Role   string
+}
+
+var validRoles = map[string]bool{RoleManager: true, RoleContributor: true, RoleViewer: true}
+
+// UpdateRole changes the project role of one member. Only managers may do it
+// (CanManageMembers). The user must be a member of the project (else
+// ErrNotFound), and the role must be manager, contributor or viewer (else
+// ErrInvalid).
+func (*MembershipTable) UpdateRole(ctx context.Context, db DB, authz ProjectAuthz, in MembershipTableUpdateRoleInput) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if !validRoles[in.Role] {
+		return nil, deny(ErrInvalid, "role must be manager, contributor or viewer")
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadUpdateMembershipRole(ctx, tx, authz.ProjectID(), in)
+		if err != nil {
+			return err
+		}
+		if m, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
+
