diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..9a7d367
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,104 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestUpdateMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager demotes", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 200},
+		{"manager promotes", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"manager sets same role", "ann", "/projects/web/members/ann", `{"role":"manager"}`, 200},
+		{"manager other project", "ivy", "/projects/ops/members/cat", `{"role":"viewer"}`, 200},
+		{"contributor", "ben", "/projects/web/members/cat", `{"role":"viewer"}`, 403},
+		{"contributor self", "ben", "/projects/web/members/ben", `{"role":"manager"}`, 403},
+		{"viewer", "dan", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"viewer in project managed elsewhere", "ann", "/projects/ops/members/cat", `{"role":"viewer"}`, 403},
+		{"org admin", "eve", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"non member", "hal", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"other org", "gus", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"anonymous", "", "/projects/web/members/ben", `{"role":"viewer"}`, 401},
+		{"unknown user", "zed", "/projects/web/members/ben", `{"role":"viewer"}`, 401},
+		{"target not a member", "ann", "/projects/web/members/eve", `{"role":"viewer"}`, 404},
+		{"target unknown", "ann", "/projects/web/members/zed", `{"role":"viewer"}`, 404},
+		{"target member of other project", "ann", "/projects/web/members/gus", `{"role":"viewer"}`, 404},
+		{"invalid role", "ann", "/projects/web/members/ben", `{"role":"owner"}`, 400},
+		{"empty role", "ann", "/projects/web/members/ben", `{"role":""}`, 400},
+		{"missing role", "ann", "/projects/web/members/ben", `{}`, 400},
+		{"bad json", "ann", "/projects/web/members/ben", `{"role":`, 400},
+		{"archived manager", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"archived contributor", "ben", "/projects/legacy/members/ben", `{"role":"viewer"}`, 403},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRoleResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+	var got struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.UserID != "ben" || got.Role != "viewer" {
+		t.Fatalf("got %+v", got)
+	}
+}
+
+// The role change is stored: the new role decides what the member may do.
+func TestUpdateMemberRolePersists(t *testing.T) {
+	h := newServer()
+
+	// ben is a contributor: can create a task.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 200 {
+		t.Fatalf("before: contributor create got %d want 200", code)
+	}
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote got %d want 200", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Fatalf("after demotion: viewer create got %d want 403", code)
+	}
+
+	// dan is a viewer: cannot create a task; after promotion, can.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 403 {
+		t.Fatalf("before: viewer create got %d want 403", code)
+	}
+	if code, _ := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`); code != 200 {
+		t.Fatalf("promote got %d want 200", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("after promotion: contributor create got %d want 200", code)
+	}
+}
+
+// A role change affects only the target member and only that project.
+func TestUpdateMemberRoleIsScoped(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "PUT", "/projects/web/members/cat", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+	// cat is still a contributor on ops.
+	if code, _ := do(t, h, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`); code != 200 {
+		t.Fatalf("cat on ops got %d want 200", code)
+	}
+	// ben is untouched on web.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 200 {
+		t.Fatalf("ben on web got %d want 200", code)
+	}
+}
