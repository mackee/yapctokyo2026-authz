+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben", 204},
+		{"manager not admin", "ann", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"other org path", "eve", "/orgs/globex/users/gus", 404},
+		{"target other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffect(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ann", "eve", ""); code != 204 {
+		t.Fatal(code)
+	}
+	// ann had memberships in web, ops and legacy; her tasks are no longer reachable by her.
+	for _, p := range []string{"web", "ops", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ann", ""); code != 401 {
+			t.Fatalf("%s: got %d want 401", p, code)
+		}
+	}
+	// Other members are untouched; the same removal again is 404.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatal(code)
+	}
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ann", "eve", ""); code != 404 {
+		t.Fatal(code)
+	}
+}
