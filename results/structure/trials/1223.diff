+// RemoveFromOrg removes the user from every project of the organization: the
+// user's memberships in those projects are deleted, and tasks assigned to the
+// user in them are unassigned, all in one transaction. The user must belong to
+// the organization (else ErrNotFound). Org admins only (else ErrForbidden).
+func (*UserTable) RemoveFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanManageMembers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveOrgUser(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
