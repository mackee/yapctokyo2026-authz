+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes viewer", "eve", "/orgs/acme/users/dan", 204},
+		{"org admin removes user without roles", "eve", "/orgs/acme/users/hal", 204},
+		{"manager is not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"contributor is not org admin", "ben", "/orgs/acme/users/cat", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown actor", "zed", "/orgs/acme/users/ben", 401},
+		{"other org actor", "gus", "/orgs/acme/users/ben", 404},
+		{"org admin of other org", "eve", "/orgs/globex/users/gus", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ben", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+
+	// ben is a contributor in web (assigned t1) and legacy (assigned t5).
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+
+	// ben is no longer a member of any project of the org.
+	for _, path := range []string{"/projects/web/tasks", "/projects/legacy/tasks", "/projects/legacy/tasks/t5"} {
+		if code, _ := do(t, h, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("GET %s as ben: got %d want 404", path, code)
+		}
+	}
+
+	// Tasks ben was assigned to are unassigned; other assignments are kept.
+	for _, c := range []struct{ path, assignee string }{
+		{"/projects/web/tasks/t1", ""},
+		{"/projects/legacy/tasks/t5", ""},
+		{"/projects/web/tasks/t2", "cat"},
+	} {
+		code, body := do(t, h, "GET", c.path, "ann", "")
+		if code != 200 {
+			t.Fatalf("GET %s: got %d want 200", c.path, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.AssigneeID != c.assignee {
+			t.Fatalf("%s assignee: got %q want %q", c.path, task.AssigneeID, c.assignee)
+		}
+	}
+
+	// The model rule still holds: ben cannot be assigned a task in web any more.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ann", `{"title":"x","assignee":"ben"}`); code != 400 {
+		t.Fatalf("assign removed member: got %d want 400", code)
+	}
+
+	// Other members are untouched.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ann", `{"title":"x"}`); code != 200 {
+		t.Fatalf("manager create after removal: got %d want 200", code)
+	}
+
+	// Removing again is a no-op.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("second remove: got %d want 204", code)
+	}
+
+	// Another organization's users and projects are not affected by an acme request.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/gus", "eve", ""); code != 404 {
+		t.Fatalf("cross-org remove: got %d want 404", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatalf("gus in gx after rejected remove: got %d want 200", code)
+	}
+}
