+// transferUserAggregate moves one user to another organization. Project
+// membership is per organization, so the memberships in the old organization's
+// projects go, and the tasks the user held there are unassigned.
+type transferUserAggregate struct {
+	user        *User
+	toOrg       string
+	memberships []*Membership // memberships in projects outside toOrg (removed)
+	assigned    []*Task       // tasks assigned to the user in those projects (unassigned)
+}
+
+func loadTransferUser(ctx context.Context, tx DB, orgID string, in UserTableTransferInput) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, in.UserID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != orgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	exists, err := NewOrgTable().Exists(ctx, tx, in.ToOrgID)
+	if err != nil {
+		return nil, err
+	}
+	if !exists {
+		return nil, deny(ErrInvalid, "target organization does not exist")
+	}
+	if in.ToOrgID == u.Org {
+		return nil, deny(ErrInvalid, "user is already in that organization")
+	}
+	a := &transferUserAggregate{user: u, toOrg: in.ToOrgID}
+	memberships, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	removed := map[string]bool{}
+	for _, m := range memberships {
+		p, err := m.Project(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		if p.Org == a.toOrg {
+			continue
+		}
+		a.memberships = append(a.memberships, m)
+		removed[m.ProjectID] = true
+	}
+	tasks, err := u.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, t := range tasks {
+		if removed[t.ProjectID] {
+			a.assigned = append(a.assigned, t)
+		}
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error { return nil }
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	for _, t := range a.assigned {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.user.moveTo(ctx, tx, a.toOrg); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
+
