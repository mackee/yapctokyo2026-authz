diff --git a/transfer_test.go b/transfer_test.go
new file mode 100644
index 0000000..8183093
--- /dev/null
+++ b/transfer_test.go
@@ -0,0 +1,118 @@
+package main
+
+import (
+	"encoding/json"
+	"reflect"
+	"testing"
+)
+
+// POST /orgs/{orgID}/users/{uid}/transfer moves a user to another organization.
+
+const (
+	transferPath = "/orgs/acme/users/ben/transfer"
+	transferBody = `{"toOrgId":"globex"}`
+)
+
+func TestTransfer(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin", "eve", transferPath, transferBody, 200},
+		{"user with no roles", "eve", "/orgs/acme/users/hal/transfer", transferBody, 200},
+		{"anonymous", "", transferPath, transferBody, 401},
+		{"unknown actor", "zed", transferPath, transferBody, 401},
+		{"member, not org admin", "ann", transferPath, transferBody, 403},
+		{"viewer, not org admin", "dan", transferPath, transferBody, 403},
+		{"admin of another org", "gus", transferPath, transferBody, 404},
+		{"user is in another org", "eve", "/orgs/acme/users/gus/transfer", transferBody, 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed/transfer", transferBody, 404},
+		{"unknown target org", "eve", transferPath, `{"toOrgId":"initech"}`, 400},
+		{"target is the current org", "eve", transferPath, `{"toOrgId":"acme"}`, 400},
+		{"missing toOrgId", "eve", transferPath, `{}`, 400},
+		{"malformed body", "eve", transferPath, `{"toOrgId":`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d (body %s)", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", transferPath, "eve", transferBody)
+	if code != 200 {
+		t.Fatalf("got %d want 200 (body %s)", code, body)
+	}
+	var got map[string]any
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("response is not JSON: %v (%s)", err, body)
+	}
+	want := map[string]any{"id": "ben", "orgId": "globex"}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+}
+
+func TestTransferMovesUser(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", transferPath, "eve", transferBody); code != 200 {
+		t.Fatalf("transfer: got %d (body %s)", code, body)
+	}
+
+	// ben is no longer in acme, so a second transfer out of acme finds no such user.
+	if code, _ := do(t, h, "POST", transferPath, "eve", transferBody); code != 404 {
+		t.Fatalf("ben still in acme: got %d want 404", code)
+	}
+
+	// ben can no longer read acme projects.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads web: got %d want 404", code)
+	}
+
+	// ben's assignments in acme projects are cleared; the tasks themselves stay.
+	for _, path := range []string{"/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		code, body := do(t, h, "GET", path, "ann", "")
+		if code != 200 {
+			t.Fatalf("GET %s: got %d (body %s)", path, code, body)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.AssigneeID != "" {
+			t.Fatalf("GET %s: still assigned to %q", path, task.AssigneeID)
+		}
+	}
+
+	// Other acme users keep their memberships and assignments.
+	code, body := do(t, h, "GET", "/projects/web/tasks/t2", "cat", "")
+	if code != 200 {
+		t.Fatalf("cat reads t2: got %d (body %s)", code, body)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "cat" {
+		t.Fatalf("t2 assignee: got %q want cat", task.AssigneeID)
+	}
+}
+
+func TestTransferClearsOrgAdmin(t *testing.T) {
+	// eve is an org admin of acme. Admin rights belong to the org, so after
+	// moving to globex she must not keep them there.
+	h := newServer()
+	if code, body := do(t, h, "POST", "/orgs/acme/users/eve/transfer", "eve", transferBody); code != 200 {
+		t.Fatalf("transfer: got %d (body %s)", code, body)
+	}
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "eve", ""); code != 404 {
+		t.Fatalf("eve reads gx as a globex admin: got %d want 404", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "eve", ""); code != 404 {
+		t.Fatalf("eve reads ops after transfer: got %d want 404", code)
+	}
+}
