+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager of both, assignee member of dest", "ivy", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 200},
+		{"manager of both, unassigned", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 200},
+		{"contributor moves own task", "cat", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 200},
+		{"contributor moves others' task", "cat", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"assignee not in destination", "ivy", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 400},
+		{"viewer in destination", "ann", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 403},
+		{"viewer in source", "dan", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 403},
+		{"org admin", "eve", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 403},
+		{"destination archived", "ann", "/projects/web/tasks/t3", `{"toProjectId":"legacy"}`, 409},
+		{"source archived", "ann", "/projects/legacy/tasks/t5", `{"toProjectId":"web"}`, 409},
+		{"destination in other org", "ann", "/projects/web/tasks/t3", `{"toProjectId":"gx"}`, 404},
+		{"destination missing", "ann", "/projects/web/tasks/t3", `{"toProjectId":"nope"}`, 404},
+		{"destination not readable", "ben", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 404},
+		{"same project", "ann", "/projects/web/tasks/t3", `{"toProjectId":"web"}`, 400},
+		{"missing destination", "ann", "/projects/web/tasks/t3", `{}`, 400},
+		{"bad body", "ann", "/projects/web/tasks/t3", `nope`, 400},
+		{"task in other project", "ann", "/projects/web/tasks/t4", `{"toProjectId":"ops"}`, 404},
+		{"non member of source", "hal", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 404},
+		{"cross org caller", "gus", "/projects/web/tasks/t3", `{"toProjectId":"gx"}`, 404},
+		{"anonymous", "", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveCarriesTaskOver(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", Assignee: "cat"}
+	if task != want {
+		t.Fatalf("got %+v want %+v", task, want)
+	}
+
+	// The task is now in the destination and gone from the source.
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks/t2", "ivy", ""); code != 200 {
+		t.Fatalf("destination GET: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t2", "ivy", ""); code != 404 {
+		t.Fatalf("source GET: %d", code)
+	}
+}
+
+func TestMoveRejectedLeavesTaskInPlace(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/tasks/t1/move", "ivy", `{"toProjectId":"ops"}`); code != 400 {
+		t.Fatalf("got %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t1", "ivy", ""); code != 200 {
+		t.Fatalf("task left the source project: %d", code)
+	}
+}
