+// changeRolesAggregate changes the roles of several members of one project.
+type changeRolesAggregate struct {
+	project *Project
+	members []*Membership      // the members to change, ordered by user ID
+	roles   map[string]string  // user ID -> new role
+	tasks   map[string][]*Task // user ID -> tasks of the project assigned to them
+}
+
+func loadChangeRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*changeRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &changeRolesAggregate{project: p, roles: roles, tasks: map[string][]*Task{}}
+	ids := make([]string, 0, len(roles))
+	for id := range roles {
+		ids = append(ids, id)
+	}
+	sort.Strings(ids)
+	for _, id := range ids {
+		m, err := p.Membership(ctx, tx, id)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "user "+id+" is not a member of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		ts, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.members = append(a.members, m)
+		a.tasks[id] = ts
+	}
+	return a, nil
+}
+
+func (a *changeRolesAggregate) validate() error {
+	for _, m := range a.members {
+		role := a.roles[m.UserID]
+		if !validRoles[role] {
+			return deny(ErrInvalid, "invalid role for "+m.UserID)
+		}
+		if !isWriterRole(role) && len(a.tasks[m.UserID]) > 0 {
+			return deny(ErrInvalid, m.UserID+" has assigned tasks and must stay a contributor or manager")
+		}
+	}
+	return nil
+}
+
+func (a *changeRolesAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for _, m := range a.members {
+		if err := m.changeRole(ctx, tx, a.roles[m.UserID]); err != nil {
+			return nil, err
+		}
+	}
+	return a.project.Memberships(ctx, tx)
+}
+
