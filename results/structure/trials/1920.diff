diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..01c2878
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,156 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"reflect"
+	"testing"
+)
+
+type memberRow struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// webRoles is the seed membership of project web, ordered by user ID.
+var webRoles = []memberRow{
+	{"ann", "manager"}, {"ben", "contributor"}, {"cat", "contributor"}, {"dan", "viewer"}, {"ivy", "manager"},
+}
+
+func putMembers(t *testing.T, h http.Handler, user, project, body string) (int, string) {
+	t.Helper()
+	return do(t, h, "PUT", "/projects/"+project+"/members", user, body)
+}
+
+func decodeMembers(t *testing.T, body string) []memberRow {
+	t.Helper()
+	var rows []memberRow
+	if err := json.Unmarshal([]byte(body), &rows); err != nil {
+		t.Fatalf("response is not a member list: %q: %v", body, err)
+	}
+	return rows
+}
+
+// membersOf reads the stored memberships of a project, ordered by user ID.
+func membersOf(t *testing.T, h http.Handler, project string) []memberRow {
+	t.Helper()
+	rows, err := h.(*appHandler).db.Query(`SELECT user_id, role FROM memberships WHERE project_id = ? ORDER BY user_id`, project)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer rows.Close()
+	var out []memberRow
+	for rows.Next() {
+		var m memberRow
+		if err := rows.Scan(&m.UserID, &m.Role); err != nil {
+			t.Fatal(err)
+		}
+		out = append(out, m)
+	}
+	return out
+}
+
+func TestChangeRolesSuccess(t *testing.T) {
+	h := newServer()
+	// ben is promoted, dan is promoted, ivy has no tasks and can be demoted.
+	code, body := putMembers(t, h, "ann", "web", `{"roles":{"ben":"manager","dan":"contributor","ivy":"viewer"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	want := []memberRow{
+		{"ann", "manager"}, {"ben", "manager"}, {"cat", "contributor"}, {"dan", "contributor"}, {"ivy", "viewer"},
+	}
+	if got := decodeMembers(t, body); !reflect.DeepEqual(got, want) {
+		t.Fatalf("response %v want %v", got, want)
+	}
+	if got := membersOf(t, h, "web"); !reflect.DeepEqual(got, want) {
+		t.Fatalf("stored %v want %v", got, want)
+	}
+}
+
+func TestChangeRolesDoesNotTouchOtherProjects(t *testing.T) {
+	h := newServer()
+	before := membersOf(t, h, "ops")
+	if code, body := putMembers(t, h, "ann", "web", `{"roles":{"dan":"contributor"}}`); code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	if got := membersOf(t, h, "ops"); !reflect.DeepEqual(got, before) {
+		t.Fatalf("ops changed: %v want %v", got, before)
+	}
+}
+
+// Nothing is changed when any single entry cannot be applied.
+func TestChangeRolesAllOrNothing(t *testing.T) {
+	cases := []struct {
+		name, body string
+		want       int
+	}{
+		// ben is the assignee of t1: he cannot become a viewer.
+		{"demote assignee", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 400},
+		{"unknown user", `{"roles":{"dan":"contributor","zed":"viewer"}}`, 400},
+		{"user of another project", `{"roles":{"dan":"contributor","hal":"viewer"}}`, 400},
+		{"user of another org", `{"roles":{"dan":"contributor","gus":"viewer"}}`, 400},
+		{"invalid role", `{"roles":{"dan":"contributor","ivy":"admin"}}`, 400},
+		{"empty role", `{"roles":{"dan":"contributor","ivy":""}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			code, _ := putMembers(t, h, "ann", "web", c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+			if got := membersOf(t, h, "web"); !reflect.DeepEqual(got, webRoles) {
+				t.Fatalf("members changed: %v", got)
+			}
+		})
+	}
+}
+
+func TestChangeRolesRequest(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager", "ivy", "web", `{"roles":{"dan":"contributor"}}`, 200},
+		{"same role is fine", "ann", "web", `{"roles":{"dan":"viewer"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"manager"}}`, 403},
+		{"viewer in ops (manager in web)", "ann", "ops", `{"roles":{"cat":"viewer"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"unknown project", "ann", "nope", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"unknown user", "zed", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"manager"}}`, 409},
+		{"bad json", "ann", "web", `{"roles":`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"malformed body beats access rules", "dan", "web", `{"roles":{"dan":"boss"}}`, 400},
+		{"malformed body beats missing project", "ann", "nope", `{}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			code, body := putMembers(t, h, c.user, c.project, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+			if code != 200 {
+				if got := membersOf(t, h, "web"); !reflect.DeepEqual(got, webRoles) {
+					t.Fatalf("members changed: %v", got)
+				}
+			}
+		})
+	}
+}
+
+func TestChangeRolesArchivedUnchanged(t *testing.T) {
+	h := newServer()
+	before := membersOf(t, h, "legacy")
+	putMembers(t, h, "ann", "legacy", `{"roles":{"ben":"manager"}}`)
+	if got := membersOf(t, h, "legacy"); !reflect.DeepEqual(got, before) {
+		t.Fatalf("legacy changed: %v", got)
+	}
+}
