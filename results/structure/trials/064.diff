+func TestStatsAccess(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"member", "dan", "/projects/web/stats", 200},
+		{"org admin", "eve", "/projects/ops/stats", 200},
+		{"archived readable", "ben", "/projects/legacy/stats", 200},
+		{"non member", "hal", "/projects/web/stats", 404},
+		{"other org", "gus", "/projects/web/stats", 404},
+		{"missing project", "ann", "/projects/nope/stats", 404},
+		{"anonymous", "", "/projects/web/stats", 401},
+		{"unknown user", "zed", "/projects/web/stats", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "GET", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestStatsCounts(t *testing.T) {
+	// web seed: t1 open/ben, t2 doing/cat, t3 open/unassigned
+	code, body := do(t, newServer(), "GET", "/projects/web/stats", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d", code)
+	}
+	var got projectStats
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	wantStatus := map[string]int{"open": 2, "doing": 1, "done": 0}
+	wantAssignee := map[string]int{"ben": 1, "cat": 1}
+	if !equalCounts(got.ByStatus, wantStatus) {
+		t.Fatalf("byStatus: got %v want %v", got.ByStatus, wantStatus)
+	}
+	if !equalCounts(got.ByAssignee, wantAssignee) {
+		t.Fatalf("byAssignee: got %v want %v", got.ByAssignee, wantAssignee)
+	}
+}
+
+func TestStatsEmptyProjectAndJSONShape(t *testing.T) {
+	code, body := do(t, newServer(), "GET", "/projects/legacy/stats", "ben", "")
+	if code != 200 {
+		t.Fatalf("got %d", code)
+	}
+	var raw map[string]map[string]int
+	if err := json.Unmarshal([]byte(body), &raw); err != nil {
+		t.Fatal(err)
+	}
+	if raw["byStatus"] == nil || raw["byAssignee"] == nil {
+		t.Fatalf("want non-null byStatus and byAssignee, got %s", body)
+	}
+	if raw["byStatus"]["open"] != 1 || raw["byStatus"]["done"] != 0 {
+		t.Fatalf("legacy byStatus: %v", raw["byStatus"])
+	}
+	if raw["byAssignee"]["ben"] != 1 {
+		t.Fatalf("legacy byAssignee: %v", raw["byAssignee"])
+	}
+}
+
+func TestStatsReflectUpdates(t *testing.T) {
+	s := newServer()
+	if code, body := do(t, s, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 200 {
+		t.Fatalf("patch: got %d %s", code, body)
+	}
+	if code, body := do(t, s, "POST", "/projects/web/tasks", "ann", `{"title":"x","assignee":"cat"}`); code != 201 {
+		t.Fatalf("create: got %d %s", code, body)
+	}
+	if code, body := do(t, s, "DELETE", "/projects/web/tasks/t2", "ann", ""); code != 204 {
+		t.Fatalf("delete: got %d %s", code, body)
+	}
+	code, body := do(t, s, "GET", "/projects/web/stats", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d", code)
+	}
+	var got projectStats
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	// t1 done/ben, t3 open/unassigned, new task open/cat; t2 deleted
+	if want := map[string]int{"open": 2, "doing": 0, "done": 1}; !equalCounts(got.ByStatus, want) {
+		t.Fatalf("byStatus: got %v want %v", got.ByStatus, want)
+	}
+	if want := map[string]int{"ben": 1, "cat": 1}; !equalCounts(got.ByAssignee, want) {
+		t.Fatalf("byAssignee: got %v want %v", got.ByAssignee, want)
+	}
+}
+
+func equalCounts(a, b map[string]int) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for k, v := range b {
+		if a[k] != v {
+			return false
+		}
+	}
+	return true
+}
