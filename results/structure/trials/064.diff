+// projectStats reports task counts for a project: per status and per assignee.
+// Unassigned tasks are not counted in byAssignee.
+type projectStats struct {
+	ByStatus   map[string]int `json:"byStatus"`
+	ByAssignee map[string]int `json:"byAssignee"`
+}
+
+func (s *server) projectStats(w http.ResponseWriter, r *http.Request) {
+	s.store.mu.Lock()
+	defer s.store.mu.Unlock()
+
+	user := s.store.User(r.Header.Get("X-User"))
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project := s.store.Project(r.PathValue("pid"))
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role := s.store.Role(project.ID, user.ID)
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	stats := projectStats{
+		ByStatus:   map[string]int{},
+		ByAssignee: map[string]int{},
+	}
+	for status := range validStatuses {
+		stats.ByStatus[status] = 0
+	}
+	for _, t := range s.store.TasksInProject(project.ID) {
+		stats.ByStatus[t.Status]++
+		if t.Assignee != "" {
+			stats.ByAssignee[t.Assignee]++
+		}
+	}
+	writeJSON(w, 200, stats)
+}
+
 func writeJSON(w http.ResponseWriter, code int, v any) {
 	w.Header().Set("Content-Type", "application/json")
 	w.WriteHeader(code)
