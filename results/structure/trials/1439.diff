+// setRolesAggregate changes the roles of several members of one project. A
+// member who becomes a viewer can no longer be an assignee, so their tasks in
+// the project are unassigned to keep the assignee rule.
+type setRolesAggregate struct {
+	project *Project
+	roles   map[string]string
+	members []*Membership // the named members, ordered by user ID
+}
+
+func loadSetRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*setRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	all, err := p.Memberships(ctx, tx) // ordered by user ID
+	if err != nil {
+		return nil, err
+	}
+	a := &setRolesAggregate{project: p, roles: roles}
+	for _, m := range all {
+		if _, ok := roles[m.UserID]; ok {
+			a.members = append(a.members, m)
+		}
+	}
+	return a, nil
+}
+
+func (a *setRolesAggregate) validate() error {
+	if len(a.members) != len(a.roles) {
+		return deny(ErrInvalid, "every user must be a member of the project")
+	}
+	for _, role := range a.roles {
+		if role != RoleManager && role != RoleContributor && role != RoleViewer {
+			return deny(ErrInvalid, "invalid role")
+		}
+	}
+	return nil
+}
+
+func (a *setRolesAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for _, m := range a.members {
+		role := a.roles[m.UserID]
+		if role == RoleViewer {
+			tasks, err := m.AssignedTasks(ctx, tx)
+			if err != nil {
+				return nil, err
+			}
+			for _, t := range tasks {
+				if err := t.unassign(ctx, tx); err != nil {
+					return nil, err
+				}
+			}
+		}
+		if err := m.setRole(ctx, tx, role); err != nil {
+			return nil, err
+		}
+	}
+	return a.project.Memberships(ctx, tx)
+}
+
