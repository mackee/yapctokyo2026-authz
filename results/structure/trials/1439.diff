+func TestSetMemberRoles(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager", "ann", "web", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 200},
+		{"self demote", "ann", "web", `{"roles":{"ann":"viewer"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"dan":"manager"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"manager"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"dan":"manager"}}`, 404},
+		{"missing project", "ann", "nope", `{"roles":{"dan":"manager"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"dan":"manager"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"one not a member", "ann", "web", `{"roles":{"ben":"viewer","hal":"viewer"}}`, 400},
+		{"invalid role", "ann", "web", `{"roles":{"ben":"owner"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"no roles", "ann", "web", `{}`, 400},
+		{"bad json", "ann", "web", `{`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+type member struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func TestSetMemberRolesResult(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got []member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []member{{"ann", "manager"}, {"ben", "viewer"}, {"cat", "contributor"}, {"dan", "contributor"}, {"ivy", "manager"}}
+	if len(got) != len(want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("got %v want %v", got, want)
+		}
+	}
+	// ben is a viewer now: his task t1 is unassigned, and he cannot write.
+	_, tb := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(tb), &task)
+	if task.AssigneeID != "" {
+		t.Fatalf("t1 still assigned to %q", task.AssigneeID)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Fatalf("demoted member created a task: %d", code)
+	}
+	// dan is a contributor now and can be assigned.
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t3", "ann", `{"assignee":"dan"}`); code != 200 {
+		t.Fatalf("promoted member not assignable: %d", code)
+	}
+}
+
+func TestSetMemberRolesAllOrNothing(t *testing.T) {
+	h := newServer()
+	code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","hal":"viewer"}}`)
+	if code != 400 {
+		t.Fatal(code)
+	}
+	_, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ann":"manager"}}`)
+	var got []member
+	json.Unmarshal([]byte(body), &got)
+	for _, m := range got {
+		if m.UserID == "ben" && m.Role != "contributor" {
+			t.Fatalf("ben changed to %s despite the error", m.Role)
+		}
+	}
+	_, tb := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(tb), &task)
+	if task.AssigneeID != "ben" {
+		t.Fatalf("t1 assignee changed to %q", task.AssigneeID)
+	}
+}
