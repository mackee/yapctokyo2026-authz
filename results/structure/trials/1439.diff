+// SetRoles changes the roles of several members of the project at once, all or
+// nothing, and returns the project's memberships afterwards. Only managers may
+// do it; every user in roles must already be a member, and every role must be
+// manager, contributor or viewer (else ErrInvalid and nothing changes).
+func (mt *MembershipTable) SetRoles(ctx context.Context, db DB, authz ProjectAuthz, roles map[string]string) ([]*Membership, error) {
+	if len(roles) == 0 {
+		return nil, deny(ErrInvalid, "roles must not be empty")
+	}
+	for _, role := range roles {
+		if role != RoleManager && role != RoleContributor && role != RoleViewer {
+			return nil, deny(ErrInvalid, "invalid role")
+		}
+	}
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var out []*Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadSetRoles(ctx, tx, authz.ProjectID(), roles)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		out, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
