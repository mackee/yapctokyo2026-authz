@@ -0,0 +1,74 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestUpdateMembers(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager bulk", "ann", "/projects/web/members", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 200},
+		{"contributor", "ben", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin", "eve", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 401},
+		{"archived", "ann", "/projects/legacy/members", `{"roles":{"ben":"viewer"}}`, 409},
+		{"bad role", "ann", "/projects/web/members", `{"roles":{"ben":"boss"}}`, 400},
+		{"non member target", "ann", "/projects/web/members", `{"roles":{"ben":"viewer","hal":"viewer"}}`, 400},
+		{"empty", "ann", "/projects/web/members", `{"roles":{}}`, 400},
+		{"no manager left", "ann", "/projects/web/members", `{"roles":{"ann":"viewer","ivy":"viewer"}}`, 409},
+		{"manager steps down", "ann", "/projects/web/members", `{"roles":{"ann":"viewer"}}`, 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestUpdateMembersResultAndAtomic(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var ms []memberJSON
+	if err := json.Unmarshal([]byte(body), &ms); err != nil || len(ms) != 5 {
+		t.Fatalf("bad body %s", body)
+	}
+	got := map[string]string{}
+	for _, m := range ms {
+		got[m.UserID] = m.Role
+	}
+	if got["ben"] != "viewer" || got["dan"] != "contributor" || got["cat"] != "contributor" {
+		t.Fatalf("unexpected roles %v", got)
+	}
+	// ben became a viewer: his task must be unassigned.
+	_, tb := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(tb), &task)
+	if task.Assignee != "" {
+		t.Fatalf("t1 still assigned to %q", task.Assignee)
+	}
+
+	// A failing request changes nothing.
+	h = newServer()
+	if code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","hal":"viewer"}}`); code != 400 {
+		t.Fatal(code)
+	}
+	_, tb = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	json.Unmarshal([]byte(tb), &task)
+	if task.Assignee != "ben" {
+		t.Fatalf("partial change leaked: assignee %q", task.Assignee)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ben should still be a contributor, got %d", code)
+	}
+}
