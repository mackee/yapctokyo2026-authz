+// RemoveUserFromOrgProjects removes userID from the membership of every
+// project that belongs to orgID. Removing a non-member is a no-op.
+func (s *Store) RemoveUserFromOrgProjects(orgID, userID string) {
+	for _, p := range s.projects {
+		if p.OrgID == orgID {
+			delete(s.members[p.ID], userID)
+		}
+	}
+}
