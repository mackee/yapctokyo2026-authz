+// removeOrgUser takes a user out of every project of an organization,
+// e.g. when they leave the company. Only org admins may do this.
+func (s *server) removeOrgUser(w http.ResponseWriter, r *http.Request) {
+	s.store.mu.Lock()
+	defer s.store.mu.Unlock()
+
+	user := s.store.User(r.Header.Get("X-User"))
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	orgID := r.PathValue("orgID")
+	if user.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	if !user.OrgAdmin {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	target := s.store.User(r.PathValue("uid"))
+	if target == nil || target.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	s.store.RemoveUserFromOrgProjects(orgID, target.ID)
+	w.WriteHeader(204)
+}
