@@ -0,0 +1,71 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"testing"
+)
+
+func TestChangeRolesResult(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","ivy":"viewer"}}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got []struct{ UserID, Role string }
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]string{"ann": "manager", "ben": "contributor", "cat": "contributor", "dan": "contributor", "ivy": "viewer"}
+	if len(got) != len(want) {
+		t.Fatalf("got %v", got)
+	}
+	for _, m := range got {
+		if want[m.UserID] != m.Role {
+			t.Fatalf("%s: got %s want %s", m.UserID, m.Role, want[m.UserID])
+		}
+	}
+}
+
+func TestChangeRolesRejected(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"dan":"manager"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"manager"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"dan":"manager"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"invalid role", "ann", "web", `{"roles":{"dan":"boss"}}`, 400},
+		{"non member target", "ann", "web", `{"roles":{"dan":"contributor","hal":"viewer"}}`, 400},
+		{"demote assignee", "ann", "web", `{"roles":{"dan":"contributor","ben":"viewer"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"malformed", "ann", "web", `{"roles":`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			code, body := do(t, h, "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+			// Nothing may have changed: dan is still a viewer in web.
+			if c.project == "web" && c.user != "" {
+				checkDanViewer(t, h)
+			}
+		})
+	}
+}
+
+// checkDanViewer proves a rejected request changed nothing: dan (a viewer)
+// still cannot create tasks.
+func checkDanViewer(t *testing.T, h http.Handler) {
+	t.Helper()
+	code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`)
+	if code != 403 {
+		t.Fatalf("dan role changed: create got %d", code)
+	}
+}
