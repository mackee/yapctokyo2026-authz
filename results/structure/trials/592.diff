+// UserTableTransferInput is the input of UserTable.Transfer.
+type UserTableTransferInput struct {
+	UserID  string
+	ToOrgID string
+}
+
+// Transfer moves a user of the authorized organization to another
+// organization. The user's project memberships (all in the old organization)
+// are removed, tasks assigned to them are unassigned, and org admin status is
+// cleared, so the model rules keep holding.
+func (ut *UserTable) Transfer(ctx context.Context, db DB, authz OrgAuthz, in UserTableTransferInput) (*User, error) {
+	if err := authz.CanTransferUsers(); err != nil {
+		return nil, err
+	}
+	if in.ToOrgID == "" {
+		return nil, deny(ErrInvalid, "toOrgId must not be empty")
+	}
+	var u *User
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadTransferUser(ctx, tx, authz, in)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if u, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return u, nil
+}
