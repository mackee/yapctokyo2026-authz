+func TestTransferStatus(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ann/transfer", `{"toOrgId":"globex"}`, 200},
+		{"non admin", "ann", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 403},
+		{"anonymous", "", "/orgs/acme/users/ann/transfer", `{"toOrgId":"globex"}`, 401},
+		{"other org path", "eve", "/orgs/globex/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"user in other org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"unknown destination", "eve", "/orgs/acme/users/ann/transfer", `{"toOrgId":"nowhere"}`, 400},
+		{"same org", "eve", "/orgs/acme/users/ann/transfer", `{"toOrgId":"acme"}`, 400},
+		{"empty destination", "eve", "/orgs/acme/users/ann/transfer", `{"toOrgId":""}`, 400},
+		{"malformed body", "eve", "/orgs/acme/users/ann/transfer", `{`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferEffects(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var resp map[string]string
+	if err := json.Unmarshal([]byte(body), &resp); err != nil {
+		t.Fatal(err)
+	}
+	if len(resp) != 2 || resp["id"] != "ben" || resp["orgId"] != "globex" {
+		t.Fatalf("unexpected response %s", body)
+	}
+	// ben is now a globex user: authenticated, but no access to acme projects.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben still reads acme project: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben is not a gx member: %d", code)
+	}
+	// his memberships are gone and his tasks (t1, t5) are unassigned.
+	for _, id := range []string{"t1"} {
+		_, body := do(t, h, "GET", "/projects/web/tasks/"+id, "ann", "")
+		var task Task
+		json.Unmarshal([]byte(body), &task)
+		if task.AssigneeID != "" {
+			t.Fatalf("task %s still assigned to %q", id, task.AssigneeID)
+		}
+	}
+	// acme can no longer see him: he is not in the org any more.
+	if code, _ := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 404 {
+		t.Fatalf("repeat transfer got %d", code)
+	}
+	// ann cannot assign him to a task any more.
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t3", "ann", `{"assignee":"ben"}`); code != 400 {
+		t.Fatalf("assigning transferred user got %d", code)
+	}
+}
+
+func TestTransferClearsOrgAdmin(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
