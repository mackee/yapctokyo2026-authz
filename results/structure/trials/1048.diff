+// moveTaskAggregate moves one task to another project.
+type moveTaskAggregate struct {
+	task     *Task
+	target   ProjectAuthz // the actor's scope in the target project
+	assignee *Membership  // the assignee's membership in the target project; nil if none
+}
+
+func loadMoveTask(ctx context.Context, tx DB, actor Actor, taskID string, in TaskTableMoveInput) (*moveTaskAggregate, error) {
+	t, err := NewTaskTable().Find(ctx, tx, taskID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	target, err := NewProjectAuthz(ctx, tx, actor, in.ToProjectID)
+	if err != nil {
+		return nil, err
+	}
+	a := &moveTaskAggregate{task: t, target: target}
+	if t.AssigneeID != "" {
+		m, err := NewMembershipTable().Find(ctx, tx, target.ProjectID(), t.AssigneeID)
+		if err != nil && !errors.Is(err, ErrNoRows) {
+			return nil, err
+		}
+		a.assignee = m
+	}
+	return a, nil
+}
+
+func (a *moveTaskAggregate) validate() error {
+	if err := a.target.CanWrite(); err != nil {
+		return err
+	}
+	if a.target.ProjectID() == a.task.ProjectID {
+		return deny(ErrInvalid, "task is already in that project")
+	}
+	if a.task.AssigneeID != "" && (a.assignee == nil || !isWriterRole(a.assignee.Role)) {
+		return deny(ErrInvalid, "assignee must be a contributor or manager of the project")
+	}
+	return nil
+}
+
+func (a *moveTaskAggregate) apply(ctx context.Context, tx DB) (*Task, error) {
+	if err := a.task.moveTo(ctx, tx, a.target.ProjectID()); err != nil {
+		return nil, err
+	}
+	return a.task, nil
+}
+
