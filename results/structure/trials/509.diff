+// transferUserAggregate moves one user to another organization.
+type transferUserAggregate struct {
+	user        *User
+	toOrg       string
+	memberships []*Membership // the user's projects, all in the source organization
+}
+
+func loadTransferUser(ctx context.Context, tx DB, authz OrgAuthz, userID string, in UserTableTransferInput) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != authz.Org() {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if in.ToOrgID == u.Org {
+		return nil, deny(ErrInvalid, "user already belongs to the organization")
+	}
+	ok, err := NewOrgTable().Exists(ctx, tx, in.ToOrgID)
+	if err != nil {
+		return nil, err
+	}
+	if !ok {
+		return nil, deny(ErrInvalid, "destination organization does not exist")
+	}
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &transferUserAggregate{user: u, toOrg: in.ToOrgID, memberships: ms}, nil
+}
+
+func (a *transferUserAggregate) validate() error { return nil }
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	// Project members belong to the project's organization, so the user leaves
+	// the projects of the source organization. Tasks they hold there would then
+	// have an assignee who is not a member, so they are unassigned.
+	for _, m := range a.memberships {
+		tasks, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		for _, t := range tasks {
+			if err := t.unassign(ctx, tx); err != nil {
+				return nil, err
+			}
+		}
+		if err := m.remove(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	// Org admin rights belong to the source organization; they do not follow the user.
+	a.user.Org = a.toOrg
+	a.user.OrgAdmin = false
+	if err := a.user.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
+
