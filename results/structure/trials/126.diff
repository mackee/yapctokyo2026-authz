+func TestRenameUser(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin renames", "eve", "/orgs/acme/users/ben", `{"id":"benjamin"}`, 200},
+		{"same id is a no-op", "eve", "/orgs/acme/users/ben", `{"id":"ben"}`, 200},
+		{"manager is not org admin", "ann", "/orgs/acme/users/ben", `{"id":"benjamin"}`, 403},
+		{"self is not org admin", "ben", "/orgs/acme/users/ben", `{"id":"benjamin"}`, 403},
+		{"other org user", "gus", "/orgs/acme/users/ben", `{"id":"benjamin"}`, 404},
+		{"admin of other org", "eve", "/orgs/globex/users/gus", `{"id":"gustavo"}`, 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", `{"id":"gustavo"}`, 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", `{"id":"zack"}`, 404},
+		{"anonymous", "", "/orgs/acme/users/ben", `{"id":"benjamin"}`, 401},
+		{"unknown actor", "zed", "/orgs/acme/users/ben", `{"id":"benjamin"}`, 401},
+		{"taken id", "eve", "/orgs/acme/users/ben", `{"id":"cat"}`, 409},
+		{"empty id", "eve", "/orgs/acme/users/ben", `{"id":""}`, 400},
+		{"id with space", "eve", "/orgs/acme/users/ben", `{"id":"ben j"}`, 400},
+		{"id with slash", "eve", "/orgs/acme/users/ben", `{"id":"a/b"}`, 400},
+		{"missing id field", "eve", "/orgs/acme/users/ben", `{}`, 400},
+		{"malformed body", "eve", "/orgs/acme/users/ben", `{`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRenameUserResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/orgs/acme/users/ben", "eve", `{"id":"benjamin"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 1 || got["id"] != "benjamin" {
+		t.Fatalf("body %s, want {\"id\":\"benjamin\"}", body)
+	}
+}
+
+func TestRenameUserKeepsAccess(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "PUT", "/orgs/acme/users/ben", "eve", `{"id":"benjamin"}`); code != 200 {
+		t.Fatalf("rename: got %d %s", code, body)
+	}
+
+	// The new ID authenticates and keeps its project roles.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "benjamin", ""); code != 200 {
+		t.Fatalf("new id list web: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/legacy/tasks", "benjamin", ""); code != 200 {
+		t.Fatalf("new id list legacy membership: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "benjamin", `{"title":"x","assignee":"benjamin"}`); code != 201 {
+		t.Fatalf("new id contributor create: got %d want 201", code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "benjamin", `{"status":"done"}`); code != 200 {
+		t.Fatalf("new id edit own task: got %d want 200", code)
+	}
+
+	// The old ID no longer authenticates.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 401 {
+		t.Fatalf("old id: got %d want 401", code)
+	}
+
+	// Task assignments follow the rename.
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "dan", "")
+	if code != 200 {
+		t.Fatalf("get t1: got %d", code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.Assignee != "benjamin" {
+		t.Fatalf("t1 assignee %q, want benjamin", task.Assignee)
+	}
+
+	// The freed ID can be taken by someone else, and the rename is reversible.
+	if code, _ := do(t, h, "PUT", "/orgs/acme/users/benjamin", "eve", `{"id":"ben"}`); code != 200 {
+		t.Fatalf("rename back: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("restored id: got %d want 200", code)
+	}
+}
