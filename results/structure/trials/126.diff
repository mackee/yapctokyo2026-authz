+// ---- user capabilities ---------------------------------------------------------
+
+// ManageUser may administer one user of the actor's organization.
+type ManageUser interface {
+	// Rename changes the user's ID everywhere it is referenced (memberships and
+	// task assignees), atomically. The old ID stops authenticating.
+	Rename(newID string) (UserView, error)
+}
+
+// UserView is the public representation of a user.
+type UserView struct {
+	ID string `json:"id"`
+}
+
+// Manage applies the user-admin rule: the org in the path must be the actor's
+// own (else 404), the actor must be an org admin (else 403), and the target
+// user must belong to that org (else 404).
+func (s *userScope) Manage() (ManageUser, error) {
+	err := s.os.as.a.st.read(func(st *state) error {
+		act := s.os.as.actor
+		if act.org != s.os.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		if !act.orgAdmin {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if u, ok := st.users[s.uid]; !ok || u.org != act.org {
+			return deny(ErrNotFound, "not found")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &manageUser{us: s}, nil
+}
+
+type manageUser struct{ us *userScope }
+
+func (m *manageUser) Rename(newID string) (UserView, error) {
+	if !validUserID(newID) {
+		return UserView{}, deny(ErrInvalid, "invalid user id")
+	}
+	var v UserView
+	err := m.us.os.as.a.st.tx(func(s *state) error {
+		u, ok := s.users[m.us.uid]
+		if !ok || u.org != m.us.os.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		if newID == u.id {
+			v = UserView{ID: u.id}
+			return nil
+		}
+		if _, taken := s.users[newID]; taken {
+			return deny(ErrConflict, "user id already in use")
+		}
+		s.renameUser(u.id, newID)
+		v = UserView{ID: newID}
+		return nil
+	})
+	return v, err
+}
 
