+// renameUser moves every reference to oldID over to newID. The caller has
+// checked that oldID exists and newID is free; check() runs before commit.
+func (s *state) renameUser(oldID, newID string) {
+	u := s.users[oldID]
+	delete(s.users, oldID)
+	u.id = newID
+	s.users[newID] = u
+	for _, m := range s.members {
+		if role, ok := m[oldID]; ok {
+			delete(m, oldID)
+			m[newID] = role
+		}
+	}
+	for tid, t := range s.tasks {
+		if t.assignee.user == oldID {
+			t.assignee.user = newID
+			s.tasks[tid] = t
+		}
+	}
+}
+
+// validUserID rejects IDs that cannot be carried in an X-User header or a path
+// segment unambiguously.
+func validUserID(id string) bool {
+	if id == "" {
+		return false
+	}
+	return !strings.ContainsFunc(id, func(r rune) bool {
+		return unicode.IsSpace(r) || unicode.IsControl(r) || r == '/'
+	})
+}
