+++ b/members_test.go
@@ -0,0 +1,88 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func roleMap(t *testing.T, body string) map[string]string {
+	t.Helper()
+	var ms []memberView
+	if err := json.Unmarshal([]byte(body), &ms); err != nil {
+		t.Fatalf("bad body %q: %v", body, err)
+	}
+	m := map[string]string{}
+	for _, x := range ms {
+		m[x.UserID] = x.Role
+	}
+	return m
+}
+
+func TestUpdateMembers(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	m := roleMap(t, body)
+	if len(m) != 5 || m["ben"] != "viewer" || m["dan"] != "contributor" || m["ann"] != "manager" || m["cat"] != "contributor" {
+		t.Fatalf("unexpected members: %s", body)
+	}
+	// ben was demoted: his task t1 must be unassigned (model rules are checked by do()).
+	_, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" {
+		t.Fatalf("t1 still assigned to %q", task.Assignee)
+	}
+}
+
+func TestUpdateMembersErrors(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"invalid role", "ann", "web", `{"roles":{"ben":"viewer","dan":"boss"}}`, 400},
+		{"non member target", "ann", "web", `{"roles":{"ben":"viewer","hal":"viewer"}}`, 400},
+		{"empty", "ann", "web", `{"roles":{}}`, 400},
+		{"bad json", "ann", "web", `nope`, 400},
+		{"no managers left", "ann", "web", `{"roles":{"ann":"viewer","ivy":"contributor"}}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			code, _ := do(t, h, "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+			// Nothing may have changed.
+			_, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+			var task Task
+			json.Unmarshal([]byte(body), &task)
+			if task.Assignee != "ben" {
+				t.Fatalf("t1 assignee changed to %q", task.Assignee)
+			}
+			code, _ = do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x","assignee":"ben"}`)
+			if c.project == "web" && code != 200 {
+				t.Fatalf("ben's role changed: create got %d", code)
+			}
+		})
+	}
+}
+
+func TestUpdateMembersMultipleManagersOK(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann", `{"roles":{"ann":"viewer"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	if roleMap(t, body)["ann"] != "viewer" {
+		t.Fatal(body)
+	}
+}
