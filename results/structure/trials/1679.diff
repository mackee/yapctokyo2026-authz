+// updateMembersRequest maps user IDs to new roles. The roles are checked here,
+// before any access decision, as a malformed body is a 400.
+type updateMembersRequest struct {
+	Roles map[string]string `json:"roles" validate:"required,min=1,dive,oneof=manager contributor viewer"`
+}
+
+// memberResponse is one entry of the project's member list.
+type memberResponse struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func updateMembers(ctx tanukirpc.Context[*projectRegistry], req updateMembersRequest) ([]memberResponse, error) {
+	reg := ctx.Registry()
+	ms, err := model.NewMembershipTable().UpdateRoles(ctx, reg.db, reg.authz, model.MembershipTableUpdateRolesInput{Roles: req.Roles})
+	if err != nil {
+		return nil, err
+	}
+	out := make([]memberResponse, 0, len(ms))
+	for _, m := range ms {
+		out = append(out, memberResponse{UserID: m.UserID, Role: m.Role})
+	}
+	return out, nil
+}
