diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..91de161
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,161 @@
+package main
+
+import (
+	"encoding/json"
+	"reflect"
+	"testing"
+)
+
+type memberOut struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// decodeMembers decodes a members response body.
+func decodeMembers(t *testing.T, body string) []memberOut {
+	t.Helper()
+	var out []memberOut
+	if err := json.Unmarshal([]byte(body), &out); err != nil {
+		t.Fatalf("response is not a member list: %v; body %s", err, body)
+	}
+	return out
+}
+
+func TestUpdateMembersResponseShape(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	// Each element has exactly the keys userId and role.
+	var raw []map[string]any
+	if err := json.Unmarshal([]byte(body), &raw); err != nil {
+		t.Fatal(err)
+	}
+	for _, m := range raw {
+		if len(m) != 2 || m["userId"] == nil || m["role"] == nil {
+			t.Fatalf("element must be exactly {userId, role}: %v", m)
+		}
+	}
+	// The whole project member list after the change, ordered by user ID.
+	want := []memberOut{
+		{"ann", "manager"},
+		{"ben", "contributor"},
+		{"cat", "contributor"},
+		{"dan", "contributor"},
+		{"ivy", "manager"},
+	}
+	if got := decodeMembers(t, body); !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %v\nwant %v", got, want)
+	}
+}
+
+func TestUpdateMembersBatchApplies(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","cat":"manager"}}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	got := map[string]string{}
+	for _, m := range decodeMembers(t, body) {
+		got[m.UserID] = m.Role
+	}
+	if got["dan"] != "contributor" || got["cat"] != "manager" {
+		t.Fatalf("response does not show the new roles: %v", got)
+	}
+	// The change is effective: dan, now a contributor, can create a task.
+	if code, body := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("dan after promotion: got %d want 200: %s", code, body)
+	}
+}
+
+func TestUpdateMembersAuthorization(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager", "ann", "web", `{"roles":{"dan":"contributor"}}`, 200},
+		{"other manager", "ivy", "web", `{"roles":{"dan":"contributor"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"unknown user", "zed", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"missing project", "ann", "nope", `{"roles":{"dan":"contributor"}}`, 404},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestUpdateMembersBadBody(t *testing.T) {
+	cases := []struct {
+		name, user, body string
+	}{
+		{"not json", "ann", `{"roles":`},
+		{"missing roles", "ann", `{}`},
+		{"empty roles", "ann", `{"roles":{}}`},
+		{"unknown role", "ann", `{"roles":{"dan":"admin"}}`},
+		{"unknown role by viewer", "dan", `{"roles":{"dan":"admin"}}`},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "PUT", "/projects/web/members", c.user, c.body)
+			if code != 400 {
+				t.Fatalf("got %d want 400: %s", code, body)
+			}
+		})
+	}
+}
+
+// A change that cannot be made rejects the whole request, and nothing changes,
+// including the changes in the same request that could have been made.
+func TestUpdateMembersAllOrNothing(t *testing.T) {
+	cases := []struct {
+		name, body string
+	}{
+		{"non member target", `{"roles":{"dan":"contributor","hal":"viewer"}}`},
+		{"demotes an assignee", `{"roles":{"dan":"contributor","ben":"viewer"}}`},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			code, body := do(t, h, "PUT", "/projects/web/members", "ann", c.body)
+			if code != 400 {
+				t.Fatalf("got %d want 400: %s", code, body)
+			}
+			// dan is still a viewer: still cannot create tasks.
+			if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 403 {
+				t.Fatalf("dan: got %d want 403 (role must be unchanged)", code)
+			}
+			// ben is still a contributor and still assigned t1: may still edit it.
+			if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 200 {
+				t.Fatalf("ben: got %d want 200 (role must be unchanged)", code)
+			}
+		})
+	}
+}
+
+func TestUpdateMembersTargetMustBeMember(t *testing.T) {
+	// hal is not a member of web (only an org user of acme).
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann", `{"roles":{"hal":"viewer"}}`)
+	if code != 400 {
+		t.Fatalf("got %d want 400: %s", code, body)
+	}
+}
+
+func TestUpdateMembersDemotingAssigneeRejected(t *testing.T) {
+	// ben is assigned t1 in web, and an assignee must be a contributor or
+	// manager of the task's project.
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer"}}`)
+	if code != 400 {
+		t.Fatalf("got %d want 400: %s", code, body)
+	}
+}
