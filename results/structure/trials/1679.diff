+
+// updateRolesAggregate changes the roles of several members of one project,
+// all or nothing.
+type updateRolesAggregate struct {
+	projectID string
+	changes   []*roleChange // ordered by user ID
+}
+
+// roleChange is one member's new role, with the tasks the member is assigned
+// to in the project (loaded to check the assignee rule).
+type roleChange struct {
+	member   *Membership
+	role     string
+	assigned []*Task
+}
+
+func loadUpdateRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*updateRolesAggregate, error) {
+	a := &updateRolesAggregate{projectID: projectID}
+	for _, userID := range slices.Sorted(maps.Keys(roles)) {
+		m, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "roles can only be changed for members of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		c := &roleChange{member: m, role: roles[userID]}
+		if !isWriterRole(c.role) {
+			if c.assigned, err = m.AssignedTasks(ctx, tx); err != nil {
+				return nil, err
+			}
+		}
+		a.changes = append(a.changes, c)
+	}
+	return a, nil
+}
+
+func (a *updateRolesAggregate) validate() error {
+	for _, c := range a.changes {
+		if !isWriterRole(c.role) && len(c.assigned) > 0 {
+			return deny(ErrInvalid, "member has tasks assigned in the project and must stay a contributor or manager")
+		}
+	}
+	return nil
+}
+
+// apply changes the roles and returns the project's members after the change.
+func (a *updateRolesAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for _, c := range a.changes {
+		if err := c.member.setRole(ctx, tx, c.role); err != nil {
+			return nil, err
+		}
+	}
+	return NewMembershipTable().ListByProject(ctx, tx, a.projectID)
+}
