-// MembershipTable reads the memberships table.
+// MembershipTable is the memberships table.
+//
+// Find and List* read rows. UpdateRole is the API operation: it takes the
+// database, the project's authorization object and an input, asks the
+// authorization object whether the actor may manage members, then runs its
+// aggregate (aggregate.go) in a transaction.
 type MembershipTable struct{}
 
 // NewMembershipTable returns the memberships table.
 func NewMembershipTable() *MembershipTable { return &MembershipTable{} }
 
+// MembershipTableUpdateRoleInput is the input of MembershipTable.UpdateRole.
+type MembershipTableUpdateRoleInput struct {
+	UserID string
+	Role   string
+}
+
+var validRoles = map[string]bool{RoleManager: true, RoleContributor: true, RoleViewer: true}
+
+// UpdateRole changes the role of a member of the project. A user who is not a
+// member of the project is ErrNotFound.
+func (*MembershipTable) UpdateRole(ctx context.Context, db DB, authz ProjectAuthz, in MembershipTableUpdateRoleInput) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if !validRoles[in.Role] {
+		return nil, deny(ErrInvalid, "invalid role")
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadUpdateMemberRole(ctx, tx, authz.ProjectID(), in)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if m, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
+
