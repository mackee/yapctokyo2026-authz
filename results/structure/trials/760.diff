+// setRolesAggregate changes the roles of some members of one project. Every
+// member named in the input must be a member of the project; the change is
+// applied only when all of them are.
+type setRolesAggregate struct {
+	project *Project
+	members []*Membership // the named members, ordered by user ID
+	roles   []string      // roles[i] is the new role of members[i]
+}
+
+func loadSetRoles(ctx context.Context, tx DB, projectID string, in MembershipTableSetRolesInput) (*setRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	userIDs := make([]string, 0, len(in.Roles))
+	for userID := range in.Roles {
+		userIDs = append(userIDs, userID)
+	}
+	sort.Strings(userIDs)
+	a := &setRolesAggregate{project: p}
+	for _, userID := range userIDs {
+		m, err := p.Membership(ctx, tx, userID)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "every user must be a member of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		a.members = append(a.members, m)
+		a.roles = append(a.roles, in.Roles[userID])
+	}
+	return a, nil
+}
+
+func (a *setRolesAggregate) validate() error {
+	for _, role := range a.roles {
+		if !isValidRole(role) {
+			return deny(ErrInvalid, "role must be manager, contributor or viewer")
+		}
+	}
+	return nil
+}
+
+// apply changes the roles and returns the project's members after the change.
+func (a *setRolesAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for i, m := range a.members {
+		if err := m.setRole(ctx, tx, a.roles[i]); err != nil {
+			return nil, err
+		}
+	}
+	return a.project.Memberships(ctx, tx)
+}
