+// changeRolesAggregate changes the roles of several members of one project.
+type changeRolesAggregate struct {
+	project *Project
+	targets []roleChange // sorted by user ID
+}
+
+type roleChange struct {
+	member   *Membership // project.Membership(user)
+	role     string      // the new role
+	assigned []*Task     // member.AssignedTasks, loaded when the member loses write access
+}
+
+func loadChangeRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*changeRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &changeRolesAggregate{project: p}
+	userIDs := make([]string, 0, len(roles))
+	for id := range roles {
+		userIDs = append(userIDs, id)
+	}
+	sort.Strings(userIDs)
+	for _, id := range userIDs {
+		m, err := p.Membership(ctx, tx, id)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "user "+id+" is not a member of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		c := roleChange{member: m, role: roles[id]}
+		if !isWriterRole(c.role) {
+			if c.assigned, err = m.AssignedTasks(ctx, tx); err != nil {
+				return nil, err
+			}
+		}
+		a.targets = append(a.targets, c)
+	}
+	return a, nil
+}
+
+func (a *changeRolesAggregate) validate() error {
+	for _, c := range a.targets {
+		if !validRoles[c.role] {
+			return deny(ErrInvalid, "invalid role for user "+c.member.UserID)
+		}
+		if len(c.assigned) > 0 {
+			return deny(ErrInvalid, "user "+c.member.UserID+" has assigned tasks and must stay a contributor or manager")
+		}
+	}
+	return nil
+}
+
+// apply changes the roles and returns the project's members afterwards.
+func (a *changeRolesAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for _, c := range a.targets {
+		if err := c.member.changeRole(ctx, tx, c.role); err != nil {
+			return nil, err
+		}
+	}
+	return a.project.Memberships(ctx, tx)
+}
+
