new file mode 100644
index 0000000..822dc5d
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,124 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"testing"
+)
+
+type memberJSON struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func rolesOf(t *testing.T, h http.Handler, project string) map[string]string {
+	t.Helper()
+	rows, err := h.(*appHandler).db.Query(`SELECT user_id, role FROM memberships WHERE project_id = ?`, project)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer rows.Close()
+	out := map[string]string{}
+	for rows.Next() {
+		var u, r string
+		if err := rows.Scan(&u, &r); err != nil {
+			t.Fatal(err)
+		}
+		out[u] = r
+	}
+	return out
+}
+
+func TestChangeMemberRoles(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ivy":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var members []memberJSON
+	if err := json.Unmarshal([]byte(body), &members); err != nil {
+		t.Fatal(err)
+	}
+	want := []memberJSON{
+		{"ann", "manager"}, {"ben", "contributor"}, {"cat", "contributor"},
+		{"dan", "contributor"}, {"ivy", "viewer"},
+	}
+	if len(members) != len(want) {
+		t.Fatalf("got %v want %v", members, want)
+	}
+	for i := range want {
+		if members[i] != want[i] {
+			t.Fatalf("got %v want %v", members, want)
+		}
+	}
+	got := rolesOf(t, h, "web")
+	if got["ivy"] != "viewer" || got["dan"] != "contributor" {
+		t.Fatalf("not persisted: %v", got)
+	}
+	if got := rolesOf(t, h, "ops"); got["ivy"] != "manager" {
+		t.Fatalf("other project changed: %v", got)
+	}
+}
+
+func TestChangeMemberRolesStatus(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager", "ann", "web", `{"roles":{"dan":"contributor"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"unknown role", "ann", "web", `{"roles":{"dan":"boss"}}`, 400},
+		{"empty role", "ann", "web", `{"roles":{"dan":""}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"bad json", "ann", "web", `{"roles":`, 400},
+		{"bad body beats forbidden", "ben", "web", `{"roles":{"dan":"boss"}}`, 400},
+		{"not a member of project", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"other org user", "ann", "web", `{"roles":{"gus":"viewer"}}`, 400},
+		{"assignee demoted", "ann", "web", `{"roles":{"ben":"viewer"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+// One bad entry means nothing changes, in either order of evaluation.
+func TestChangeMemberRolesAllOrNothing(t *testing.T) {
+	bodies := []string{
+		// ben is assigned t1
+		`{"roles":{"ivy":"viewer","ben":"viewer"}}`,
+		`{"roles":{"ben":"viewer","ivy":"viewer"}}`,
+		// hal is not a member
+		`{"roles":{"ivy":"viewer","hal":"viewer"}}`,
+		// invalid role
+		`{"roles":{"ivy":"viewer","dan":"boss"}}`,
+	}
+	for _, b := range bodies {
+		h := newServer()
+		before := rolesOf(t, h, "web")
+		code, _ := do(t, h, "PUT", "/projects/web/members", "ann", b)
+		if code != 400 {
+			t.Fatalf("%s: got %d want 400", b, code)
+		}
+		after := rolesOf(t, h, "web")
+		if len(before) != len(after) {
+			t.Fatalf("%s: members changed: %v -> %v", b, before, after)
+		}
+		for u, r := range before {
+			if after[u] != r {
+				t.Fatalf("%s: %s changed %s -> %s", b, u, r, after[u])
+			}
+		}
+	}
+}
