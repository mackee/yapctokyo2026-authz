+++ b/internal/capability/org_test.go
@@ -0,0 +1,45 @@
+package capability
+
+import "testing"
+
+func TestTransferResetsOrgAdmin(t *testing.T) {
+	a := New()
+	act, err := a.Authenticate("eve")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !act.Actor().orgAdmin {
+		t.Fatal("eve should start as an org admin")
+	}
+	m, err := act.Org("acme").Manage()
+	if err != nil {
+		t.Fatal(err)
+	}
+	v, err := m.Transfer("eve", "globex")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if v.ID != "eve" || v.OrgID != "globex" {
+		t.Fatalf("unexpected view: %+v", v)
+	}
+	moved, err := a.Authenticate("eve")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if moved.Actor().org != "globex" || moved.Actor().orgAdmin {
+		t.Fatalf("after transfer: org=%s orgAdmin=%v", moved.Actor().org, moved.Actor().orgAdmin)
+	}
+}
+
+func TestTransferFailureChangesNothing(t *testing.T) {
+	a := New()
+	act, _ := a.Authenticate("eve")
+	m, _ := act.Org("acme").Manage()
+	if _, err := m.Transfer("ben", "globex"); err == nil {
+		t.Fatal("ben is a project member; transfer should fail")
+	}
+	ben, _ := a.Authenticate("ben")
+	if ben.Actor().org != "acme" {
+		t.Fatalf("ben moved despite failure: %s", ben.Actor().org)
+	}
+}
