@@ -0,0 +1,85 @@
+package capability
+
+import "fmt"
+
+// Organization administration: moving users between organizations (for example
+// between companies in the same group).
+//
+//	ActorScope -> Org(oid) OrgScope -> Manage() ManageOrg -> Transfer(uid, toOrg)
+
+// UserView is the public representation of a user's organization.
+type UserView struct {
+	ID    string `json:"id"`
+	OrgID string `json:"orgId"`
+}
+
+// OrgScope is bound to one actor and one organization ID. It grants nothing by
+// itself; call Manage to acquire the capability.
+type OrgScope interface {
+	ID() string
+	Manage() (ManageOrg, error)
+}
+
+// ManageOrg is the org-admin capability for one organization's users.
+type ManageOrg interface {
+	// Transfer moves a user of this organization to toOrgID. The user must not
+	// be a member of any project (remove them from projects first), and the
+	// admin flag is not carried over, since org admin rights are per organization.
+	Transfer(userID, toOrgID string) (UserView, error)
+}
+
+type orgScope struct {
+	as  *actorScope
+	oid string
+}
+
+func (s *actorScope) Org(orgID string) OrgScope {
+	return &orgScope{as: s, oid: orgID}
+}
+
+func (s *orgScope) ID() string { return s.oid }
+
+// Manage applies the org-admin rule: the organization must be the actor's own
+// (else 404, like any organization the actor cannot see), and the actor must be
+// an org admin of it (else 403).
+func (s *orgScope) Manage() (ManageOrg, error) {
+	if s.as.actor.org != s.oid {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if !s.as.actor.orgAdmin {
+		return nil, deny(ErrForbidden, "forbidden")
+	}
+	return &manageOrg{os: s}, nil
+}
+
+type manageOrg struct{ os *orgScope }
+
+func (m *manageOrg) Transfer(userID, toOrgID string) (UserView, error) {
+	var v UserView
+	err := m.os.as.a.st.tx(func(s *state) error {
+		u, ok := s.users[userID]
+		if !ok || u.org != m.os.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		if toOrgID == "" {
+			return deny(ErrInvalid, "toOrgId is required")
+		}
+		if !s.orgs[toOrgID] {
+			return deny(ErrInvalid, fmt.Sprintf("unknown organization %s", toOrgID))
+		}
+		if toOrgID == u.org {
+			return deny(ErrInvalid, "user already belongs to that organization")
+		}
+		for _, members := range s.members {
+			if _, ok := members[userID]; ok {
+				return deny(ErrConflict, "user is still a project member; remove them from projects first")
+			}
+		}
+		u.org = toOrgID
+		u.orgAdmin = false
+		s.users[userID] = u
+		v = UserView{ID: u.id, OrgID: u.org}
+		return nil
+	})
+	return v, err
+}
diff --git a/internal/capability/org_test.go b/internal/capability/org_test.go
new file mode 100644
