diff --git a/transfer_test.go b/transfer_test.go
new file mode 100644
index 0000000..e60b46c
--- /dev/null
+++ b/transfer_test.go
@@ -0,0 +1,67 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestTransfer(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin moves user without memberships", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 200},
+		{"org admin moves org admin", "eve", "/orgs/acme/users/eve/transfer", `{"toOrgId":"globex"}`, 200},
+		{"project member blocked", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 409},
+		{"viewer-only member blocked", "eve", "/orgs/acme/users/dan/transfer", `{"toOrgId":"globex"}`, 409},
+		{"manager of projects blocked", "eve", "/orgs/acme/users/ivy/transfer", `{"toOrgId":"globex"}`, 409},
+		{"non-admin member forbidden", "ann", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 403},
+		{"other org admin cannot see acme", "gus", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 404},
+		{"org in path must be actor's own", "eve", "/orgs/globex/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"user in another org not found", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"unknown user not found", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"unknown target org", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"initech"}`, 400},
+		{"same org is invalid", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"acme"}`, 400},
+		{"empty toOrgId", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":""}`, 400},
+		{"malformed body", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":`, 400},
+		{"anonymous", "", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown actor", "zed", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/hal/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["id"] != "hal" || got["orgId"] != "globex" || len(got) != 2 {
+		t.Fatalf("unexpected body: %s", body)
+	}
+}
+
+func TestTransferIsPersistentAndOneWay(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/orgs/acme/users/hal/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("first transfer: got %d: %s", code, body)
+	}
+	// hal is no longer in acme, so acme's admin can no longer move them.
+	if code, _ := do(t, h, "POST", "/orgs/acme/users/hal/transfer", "eve", `{"toOrgId":"globex"}`); code != 404 {
+		t.Fatalf("second transfer from acme: got %d want 404", code)
+	}
+	// Reads of acme projects are refused for hal now that they are in globex.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "hal", ""); code != 404 {
+		t.Fatalf("hal reading acme project: got %d want 404", code)
+	}
+}
