+// freezeProjectAggregate turns every member of one project into a viewer and
+// unassigns the project's tasks, so the assignee rule still holds afterwards.
+type freezeProjectAggregate struct {
+	project     *Project
+	memberships []*Membership // ordered by user ID
+	tasks       []*Task
+}
+
+func loadFreezeProject(ctx context.Context, tx DB, projectID string) (*freezeProjectAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	members, err := p.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	tasks, err := p.Tasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &freezeProjectAggregate{project: p, memberships: members, tasks: tasks}, nil
+}
+
+// validate has nothing to check: every member becomes a viewer and every task
+// is unassigned by apply, so no assignee is left without a writer role.
+func (a *freezeProjectAggregate) validate() error { return nil }
+
+func (a *freezeProjectAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for _, m := range a.memberships {
+		if err := m.setRole(ctx, tx, RoleViewer); err != nil {
+			return nil, err
+		}
+	}
+	for _, t := range a.tasks {
+		if t.AssigneeID == "" {
+			continue
+		}
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	return a.memberships, nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
