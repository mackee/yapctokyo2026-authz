+type moveRequest struct {
+	ToProjectID string `json:"toProjectId"`
+}
+
+// moveMember moves a member to another project with the same role.
+// The caller must be a manager of both the source and destination projects.
+func (s *server) moveMember(w http.ResponseWriter, r *http.Request) {
+	s.store.mu.Lock()
+	defer s.store.mu.Unlock()
+
+	user := s.store.User(r.Header.Get("X-User"))
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project := s.store.Project(r.PathValue("pid"))
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role := s.store.Role(project.ID, user.ID)
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	var req moveRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || req.ToProjectID == "" {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	dest := s.store.Project(req.ToProjectID)
+	if dest == nil || dest.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	destRole := s.store.Role(dest.ID, user.ID)
+	if destRole == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if destRole != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if dest.ID == project.ID {
+		writeError(w, 400, "destination must differ from source project")
+		return
+	}
+	if project.Archived || dest.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	uid := r.PathValue("uid")
+	memberRole := s.store.Role(project.ID, uid)
+	if memberRole == "" {
+		writeError(w, 404, "not found")
+		return
+	}
+	if s.store.Role(dest.ID, uid) != "" {
+		writeError(w, 409, "user is already a member of the destination project")
+		return
+	}
+	s.store.MoveMember(project.ID, dest.ID, uid, memberRole)
+	writeJSON(w, 200, map[string]string{"userId": uid, "projectId": dest.ID, "role": memberRole})
+}
+
 func writeJSON(w http.ResponseWriter, code int, v any) {
 	w.Header().Set("Content-Type", "application/json")
 	w.WriteHeader(code)
