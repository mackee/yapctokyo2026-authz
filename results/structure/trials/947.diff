+func TestFreeze(t *testing.T) {
+	cases := []struct {
+		name, user, pid string
+		want            int
+	}{
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"archived", "ann", "legacy", 409},
+		{"unauthenticated", "", "web", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.pid+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+
+	t.Run("manager freezes", func(t *testing.T) {
+		h := newServer()
+		code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+		if code != 200 {
+			t.Fatalf("got %d: %s", code, body)
+		}
+		var got []map[string]string
+		if err := json.Unmarshal([]byte(body), &got); err != nil {
+			t.Fatal(err)
+		}
+		if len(got) != 5 {
+			t.Fatalf("got %d members: %s", len(got), body)
+		}
+		for _, m := range got {
+			if m["role"] != "viewer" || m["userId"] == "" || len(m) != 2 {
+				t.Fatalf("bad member %v", m)
+			}
+		}
+		// nobody can change tasks now, including the former managers
+		for _, u := range []string{"ann", "ivy", "ben", "cat"} {
+			if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", u, `{"status":"done"}`); code != 403 {
+				t.Fatalf("%s patch: got %d", u, code)
+			}
+			if code, _ := do(t, h, "POST", "/projects/web/tasks", u, `{"title":"x"}`); code != 403 {
+				t.Fatalf("%s create: got %d", u, code)
+			}
+			if code, _ := do(t, h, "DELETE", "/projects/web/tasks/t1", u, ""); code != 403 {
+				t.Fatalf("%s delete: got %d", u, code)
+			}
+		}
+		// reads still work, other projects are untouched
+		if code, _ := do(t, h, "GET", "/projects/web/tasks", "ann", ""); code != 200 {
+			t.Fatalf("read after freeze: got %d", code)
+		}
+		if code, _ := do(t, h, "POST", "/projects/ops/tasks", "ivy", `{"title":"x"}`); code != 200 {
+			t.Fatalf("other project: got %d", code)
+		}
+		// a frozen project cannot be frozen again by its former manager
+		if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 403 {
+			t.Fatalf("refreeze: got %d", code)
+		}
+	})
+}
