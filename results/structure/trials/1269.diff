+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeMakesEveryoneViewer(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []string{"ann", "ben", "cat", "dan", "ivy"}
+	if len(got) != len(want) {
+		t.Fatalf("got %v", got)
+	}
+	for i, m := range got {
+		if m["userId"] != want[i] || m["role"] != "viewer" || len(m) != 2 {
+			t.Fatalf("member %d: %v", i, m)
+		}
+	}
+
+	// Nobody can change tasks of the frozen project any more.
+	writes := []struct{ method, path, body string }{
+		{"POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"PATCH", "/projects/web/tasks/t3", `{"title":"y"}`},
+		{"DELETE", "/projects/web/tasks/t1", ""},
+	}
+	for _, user := range []string{"ann", "ben", "cat", "dan", "ivy", "eve"} {
+		for _, w := range writes {
+			if code, _ := do(t, h, w.method, w.path, user, w.body); code != 403 {
+				t.Fatalf("%s %s %s: got %d want 403", user, w.method, w.path, code)
+			}
+		}
+	}
+
+	// Tasks stay readable; assignees were cleared to keep the model rules.
+	code, body = do(t, h, "GET", "/projects/web/tasks", "dan", "")
+	if code != 200 {
+		t.Fatal(code)
+	}
+	var tasks []Task
+	json.Unmarshal([]byte(body), &tasks)
+	if len(tasks) != 3 {
+		t.Fatalf("want 3 tasks, got %d", len(tasks))
+	}
+	for _, task := range tasks {
+		if task.AssigneeID != "" {
+			t.Fatalf("task %s still assigned to %s", task.ID, task.AssigneeID)
+		}
+	}
+
+	// A second freeze is refused: nobody is a manager any more.
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 403 {
+		t.Fatalf("second freeze: got %d want 403", code)
+	}
+}
+
+func TestFreezeOnlyAffectsProject(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatal(code)
+	}
+	// ops is untouched: cat is still a contributor and can edit her task.
+	if code, _ := do(t, h, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`); code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+}
