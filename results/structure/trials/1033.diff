+package main
+
+import "testing"
+
+func TestTransfer(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 200},
+		{"non admin", "ann", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 403},
+		{"anonymous", "", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 401},
+		{"admin of other org", "gus", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 404},
+		{"user not in org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"globex"}`, 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"same org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"acme"}`, 400},
+		{"unknown destination", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"nope"}`, 400},
+		{"missing body", "eve", "/orgs/acme/users/ben/transfer", `{}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestTransferEffects(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 || body != `{"id":"ben","orgId":"globex"}`+"\n" {
+		t.Fatalf("got %d %s", code, body)
+	}
+	// Lost access to the old org's projects.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("old project: got %d want 404", code)
+	}
+	// Old assignments are cleared.
+	_, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if want := `{"id":"t1","projectId":"web","title":"Fix header","status":"open","assignee":""}` + "\n"; body != want {
+		t.Fatalf("task: got %s", body)
+	}
+	// Moving back must not restore old memberships.
+	if code, _ := do(t, h, "POST", "/orgs/globex/users/ben/transfer", "gus", ""); code != 403 {
+		t.Fatalf("got %d want 403", code)
+	}
+}
+
+func TestTransferDropsOrgAdmin(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatal(code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "eve", ""); code != 404 {
+		t.Fatalf("got %d want 404: admin flag must not carry over", code)
+	}
+}
