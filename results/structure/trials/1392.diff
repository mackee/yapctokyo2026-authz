 type ProjectTable struct{}
 
 // NewProjectTable returns the projects table.
@@ -17,3 +17,29 @@ func (*ProjectTable) Find(ctx context.Context, db DB, id string) (*Project, erro
 	}
 	return &p, nil
 }
+
+// ---- operations -----------------------------------------------------------------------
+
+// Freeze freezes the project: every member becomes a viewer and no task keeps
+// an assignee, so nobody can change the project's tasks afterwards. It returns
+// the members after the change, ordered by user ID.
+func (*ProjectTable) Freeze(ctx context.Context, db DB, authz ProjectAuthz) ([]*Membership, error) {
+	if err := authz.CanFreeze(); err != nil {
+		return nil, err
+	}
+	var members []*Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadFreezeProject(ctx, tx, authz.ProjectID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		members, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return members, nil
+}
