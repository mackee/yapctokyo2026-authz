+// memberRole is one project member as the freeze response shows it.
+type memberRole struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func freezeProject(ctx tanukirpc.Context[*projectRegistry], _ struct{}) ([]memberRole, error) {
+	reg := ctx.Registry()
+	members, err := model.NewProjectTable().Freeze(ctx, reg.db, reg.authz)
+	if err != nil {
+		return nil, err
+	}
+	out := make([]memberRole, 0, len(members))
+	for _, m := range members {
+		out = append(out, memberRole{UserID: m.UserID, Role: m.Role})
+	}
+	return out, nil
+}
