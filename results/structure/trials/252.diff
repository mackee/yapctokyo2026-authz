+// ManageMembers applies the membership rule: readable, manager (else 403),
+// not archived (else 409).
+func (s *projectScope) ManageMembers() (ManageMembers, error) {
+	err := s.as.a.st.read(func(st *state) error {
+		p, r, err := readable(st, s.as.actor, s.pid)
+		if err != nil {
+			return err
+		}
+		if r != RoleManager {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if p.archived {
+			return deny(ErrArchived, "project is archived")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &manageMembers{ps: s}, nil
+}
+
+// ManageMembers is the manager-only capability to change a project's members.
+type ManageMembers interface {
+	// RemoveMember removes a member from the project (404 if the user is not a
+	// member). Tasks assigned to the user in this project become unassigned.
+	RemoveMember(userID string) error
+}
+
+type manageMembers struct{ ps *projectScope }
+
+func (m *manageMembers) RemoveMember(userID string) error {
+	return m.ps.as.a.st.tx(func(s *state) error {
+		if _, ok := s.members[m.ps.pid][userID]; !ok {
+			return deny(ErrNotFound, "not found")
+		}
+		delete(s.members[m.ps.pid], userID)
+		for id, t := range s.tasks {
+			if t.project == m.ps.pid && t.assignee.user == userID {
+				t.assignee = Assignee{project: m.ps.pid}
+				s.tasks[id] = t
+			}
+		}
+		return nil
+	})
+}
