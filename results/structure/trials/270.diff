+// ---- organization scope -------------------------------------------------------
+
+// UserView is the public representation of a user.
+type UserView struct {
+	ID    string `json:"id"`
+	OrgID string `json:"orgId"`
+}
+
+// OrgScope is bound to one actor and one organization ID.
+type OrgScope interface {
+	Manage() (ManageOrg, error)
+}
+
+// ManageOrg is the org-admin capability for one organization.
+type ManageOrg interface {
+	// TransferUser moves a user of this organization to another existing
+	// organization. The user's project memberships in this organization are
+	// dropped, tasks assigned to them become unassigned, and they lose any
+	// org-admin flag. Unknown user is 404; empty, unknown or identical target
+	// organization is 400.
+	TransferUser(userID, toOrgID string) (UserView, error)
+}
+
+func (s *actorScope) Org(orgID string) OrgScope { return &orgScope{as: s, oid: orgID} }
+
+type orgScope struct {
+	as  *actorScope
+	oid string
+}
+
+// Manage applies the org-management rule: the actor belongs to the
+// organization (else 404) and is an org admin of it (else 403).
+func (s *orgScope) Manage() (ManageOrg, error) {
+	act := s.as.actor
+	if act.org != s.oid {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if !act.orgAdmin {
+		return nil, deny(ErrForbidden, "forbidden")
+	}
+	return &manageOrg{os: s}, nil
+}
+
+type manageOrg struct{ os *orgScope }
+
+func (m *manageOrg) TransferUser(userID, toOrgID string) (UserView, error) {
+	var v UserView
+	err := m.os.as.a.st.tx(func(s *state) error {
+		u, ok := s.users[userID]
+		if !ok || u.org != m.os.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		if toOrgID == "" || !s.orgExists(toOrgID) {
+			return deny(ErrInvalid, "unknown destination organization")
+		}
+		if toOrgID == u.org {
+			return deny(ErrInvalid, "user already belongs to that organization")
+		}
+		for pid, members := range s.members {
+			delete(members, userID)
+			for tid, t := range s.tasks {
+				if t.project == pid && t.assignee.user == userID {
+					t.assignee = Assignee{project: pid}
+					s.tasks[tid] = t
+				}
+			}
+		}
+		u.org = toOrgID
+		u.orgAdmin = false
+		s.users[userID] = u
+		v = UserView{ID: u.id, OrgID: u.org}
+		return nil
+	})
+	return v, err
+}
+
 func (s *actorScope) Actor() Actor { return s.actor }
 func (s *actorScope) Project(projectID string) ProjectScope {
 	return &projectScope{as: s, pid: projectID}
