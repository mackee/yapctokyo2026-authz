+// RemoveFromOrg removes the user from every project of the organization, for
+// offboarding. The memberships go, the tasks the user held in those projects
+// are unassigned, and the user row stays. Only an org admin of the
+// organization may call it (CanManageMembers).
+func (*UserTable) RemoveFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanManageMembers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveFromOrg(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
