diff --git a/org_users_test.go b/org_users_test.go
new file mode 100644
index 0000000..3059111
--- /dev/null
+++ b/org_users_test.go
@@ -0,0 +1,118 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+// DELETE /orgs/{orgID}/users/{uid}: an org admin of the organization removes
+// the user from every project of the organization (offboarding) → 204.
+
+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes user with no memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"contributor cannot remove", "ben", "/orgs/acme/users/cat", 403},
+		{"manager cannot remove", "ann", "/orgs/acme/users/cat", 403},
+		{"viewer cannot remove", "dan", "/orgs/acme/users/cat", 403},
+		{"caller in other org", "gus", "/orgs/acme/users/cat", 404},
+		{"user in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed", 404},
+		{"unknown org", "eve", "/orgs/initech/users/cat", 404},
+		{"anonymous", "", "/orgs/acme/users/cat", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/cat", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserIsIdempotent(t *testing.T) {
+	srv := newServer()
+	for i := 0; i < 2; i++ {
+		code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", "")
+		if code != 204 {
+			t.Fatalf("call %d: got %d want 204", i+1, code)
+		}
+	}
+}
+
+func TestRemoveOrgUserDeniedChangesNothing(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/cat", "ann", ""); code != 403 {
+		t.Fatalf("got %d want 403", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat lost access after a denied removal: got %d want 200", code)
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+
+	// ben is a member of web (contributor) and legacy (contributor, archived).
+	// Both memberships go, so ben can no longer read either project.
+	for _, path := range []string{"/projects/web/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, srv, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("ben reads %s after removal: got %d want 404", path, code)
+		}
+	}
+
+	// ben cannot be assigned tasks any more: he is no longer a project member.
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "ann", `{"title":"x","assignee":"ben"}`); code != 400 {
+		t.Fatalf("assign removed user: got %d want 400", code)
+	}
+
+	// Tasks ben held in those projects are unassigned (t1 in web, t5 in legacy).
+	// Other members' tasks are untouched (t2 is cat's).
+	wantAssignee := map[string]string{"/projects/web/tasks/t1": "", "/projects/legacy/tasks/t5": "", "/projects/web/tasks/t2": "cat"}
+	for path, want := range wantAssignee {
+		code, body := do(t, srv, "GET", path, "ann", "")
+		if code != 200 {
+			t.Fatalf("get %s: got %d want 200", path, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.AssigneeID != want {
+			t.Fatalf("%s assignee = %q, want %q", path, task.AssigneeID, want)
+		}
+	}
+
+	// Other members keep their access.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ann", ""); code != 200 {
+		t.Fatalf("ann lost web access: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/legacy/tasks", "ann", ""); code != 200 {
+		t.Fatalf("ann lost legacy access: got %d want 200", code)
+	}
+}
+
+func TestRemoveOrgUserLeavesOtherOrgsAlone(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ivy", "eve", ""); code != 204 {
+		t.Fatalf("remove ivy: got %d want 204", code)
+	}
+	// ivy is a manager in web and ops; she is out of both.
+	for _, path := range []string{"/projects/web/tasks", "/projects/ops/tasks"} {
+		if code, _ := do(t, srv, "GET", path, "ivy", ""); code != 404 {
+			t.Fatalf("ivy reads %s after removal: got %d want 404", path, code)
+		}
+	}
+	// The globex project and its manager are not affected.
+	if code, _ := do(t, srv, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatalf("gus lost globex access: got %d want 200", code)
+	}
+}
