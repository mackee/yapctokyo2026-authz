+// moveMemberAggregate moves one member from one project to another.
+type moveMemberAggregate struct {
+	member *Membership // the member's membership in the source project
+	dest   *Project
+	user   *User
+	tasks  []*Task // tasks of the source project assigned to the member
+}
+
+func loadMoveMember(ctx context.Context, tx DB, fromID, userID, toID string) (*moveMemberAggregate, error) {
+	from, err := NewProjectTable().Find(ctx, tx, fromID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	m, err := from.Membership(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	dest, err := NewProjectTable().Find(ctx, tx, toID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	u, err := m.User(ctx, tx)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "member must be an existing user")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveMemberAggregate{member: m, dest: dest, user: u}
+	if _, err := dest.Membership(ctx, tx, userID); err == nil {
+		return nil, deny(ErrInvalid, "user is already a member of the destination project")
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	if a.tasks, err = m.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.member.ProjectID == a.dest.ID {
+		return deny(ErrInvalid, "destination must be a different project")
+	}
+	if a.user.Org != a.dest.Org {
+		return deny(ErrInvalid, "member must belong to the destination project's organization")
+	}
+	return nil
+}
+
+// apply moves the membership. The user leaves the source project, so tasks
+// there assigned to the user become unassigned (an assignee must be a member).
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.member.moveTo(ctx, tx, a.dest.ID); err != nil {
+		return nil, err
+	}
+	return a.member, nil
+}
+
