+type transferRequest struct {
+	ToOrgID string `json:"toOrgId"`
+}
+
+// transferUser moves a user to another org. Only an org admin of the user's
+// current org may do it. The user loses org admin rights, their memberships in
+// the old org's projects are removed and their tasks there become unassigned,
+// so nothing of the old org stays attached to them.
+func (s *server) transferUser(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	caller, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if caller == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	fromOrg := r.PathValue("orgID")
+	if caller.OrgID != fromOrg {
+		writeError(w, 404, "not found")
+		return
+	}
+	if !caller.OrgAdmin {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	target, err := findUser(ctx, s.db, r.PathValue("uid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if target == nil || target.OrgID != fromOrg {
+		writeError(w, 404, "not found")
+		return
+	}
+	var req transferRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || req.ToOrgID == "" {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	if req.ToOrgID == fromOrg {
+		writeError(w, 400, "user is already in that organization")
+		return
+	}
+	var known int
+	if err := s.db.QueryRowContext(ctx, `SELECT EXISTS (SELECT 1 FROM users WHERE org_id = ?1 UNION ALL SELECT 1 FROM projects WHERE org_id = ?1)`, req.ToOrgID).Scan(&known); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if known == 0 {
+		writeError(w, 400, "unknown destination organization")
+		return
+	}
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+	if _, err := tx.ExecContext(ctx, `UPDATE tasks SET assignee = '' WHERE assignee = ? AND project_id IN (SELECT id FROM projects WHERE org_id = ?)`, target.ID, fromOrg); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if _, err := tx.ExecContext(ctx, `DELETE FROM memberships WHERE user_id = ? AND project_id IN (SELECT id FROM projects WHERE org_id = ?)`, target.ID, fromOrg); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if _, err := tx.ExecContext(ctx, `UPDATE users SET org_id = ?, org_admin = 0 WHERE id = ?`, req.ToOrgID, target.ID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, map[string]string{"id": target.ID, "orgId": req.ToOrgID})
+}
