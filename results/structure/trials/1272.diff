+func TestFreeze(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"archived", "ann", "legacy", 409},
+		{"missing project", "ann", "nope", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeEffect(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got []map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	users := []string{"ann", "ben", "cat", "dan", "ivy"}
+	if len(got) != len(users) {
+		t.Fatalf("got %v", got)
+	}
+	for i, m := range got {
+		if m["userId"] != users[i] || m["role"] != "viewer" || len(m) != 2 {
+			t.Fatalf("member %d: %v", i, m)
+		}
+	}
+
+	// Nobody can change the project's tasks any more, managers included.
+	for _, u := range []string{"ann", "ivy", "ben", "cat"} {
+		if c, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", u, `{"status":"done"}`); c != 403 {
+			t.Fatalf("%s patch: %d", u, c)
+		}
+		if c, _ := do(t, h, "POST", "/projects/web/tasks", u, `{"title":"x"}`); c != 403 {
+			t.Fatalf("%s create: %d", u, c)
+		}
+		if c, _ := do(t, h, "DELETE", "/projects/web/tasks/t1", u, ""); c != 403 {
+			t.Fatalf("%s delete: %d", u, c)
+		}
+	}
+	// Reads still work, a second freeze is refused, other projects are untouched.
+	if c, _ := do(t, h, "GET", "/projects/web/tasks", "ann", ""); c != 200 {
+		t.Fatal(c)
+	}
+	if c, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); c != 403 {
+		t.Fatal(c)
+	}
+	if c, _ := do(t, h, "PATCH", "/projects/ops/tasks/t4", "ivy", `{"status":"done"}`); c != 200 {
+		t.Fatal(c)
+	}
+}
