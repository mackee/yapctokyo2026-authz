+// RemoveFromOrg removes the user from every project of the organization
+// (offboarding). It deletes the user's memberships in those projects and
+// unassigns the tasks the user held there. Archived projects are included.
+// The user's organization and org admin flag are not changed. Only org admins
+// may call it (else ErrForbidden); a user who is not in the organization is
+// ErrNotFound.
+func (*UserTable) RemoveFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanManageUsers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveOrgUser(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
