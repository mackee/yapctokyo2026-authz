@@ -0,0 +1,95 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestRemoveOrgUserDenials(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown actor", "zed", "/orgs/acme/users/ben", 401},
+		{"manager of the org's project", "ann", "/orgs/acme/users/ben", 403},
+		{"contributor removes self", "ben", "/orgs/acme/users/ben", 403},
+		{"viewer", "dan", "/orgs/acme/users/ben", 403},
+		{"other org admin", "gus", "/orgs/acme/users/ben", 404},
+		{"org admin asks about other org", "eve", "/orgs/globex/users/gus", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserIsIdempotent(t *testing.T) {
+	h := newServer()
+	for i := 0; i < 2; i++ {
+		if code, body := do(t, h, "DELETE", "/orgs/acme/users/hal", "eve", ""); code != 204 {
+			t.Fatalf("call %d: got %d body=%s", i+1, code, body)
+		}
+	}
+}
+
+// Removing ben from acme drops ben from every acme project (web and the
+// archived legacy), leaves the other orgs alone, and unassigns ben's tasks.
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+
+	// Before: ben reads web and legacy, and is the assignee of t1 and t5.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t1", "ben", ""); code != 200 {
+		t.Fatalf("before: web read got %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/legacy/tasks/t5", "ben", ""); code != 200 {
+		t.Fatalf("before: legacy read got %d", code)
+	}
+
+	if code, body := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d body=%s", code, body)
+	}
+
+	// ben is no longer a member of any acme project.
+	for _, path := range []string{"/projects/web/tasks", "/projects/legacy/tasks", "/projects/ops/tasks"} {
+		if code, _ := do(t, h, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("after: %s got %d want 404", path, code)
+		}
+	}
+
+	// Ben's tasks are unassigned, not reassigned.
+	for _, path := range []string{"/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		code, body := do(t, h, "GET", path, "ann", "")
+		if code != 200 {
+			t.Fatalf("%s: got %d", path, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.AssigneeID != "" {
+			t.Fatalf("%s: assignee still %q", path, task.AssigneeID)
+		}
+	}
+
+	// Other members' memberships and tasks are untouched.
+	var tasks []Task
+	_, body := do(t, h, "GET", "/projects/web/tasks", "ann", "")
+	json.Unmarshal([]byte(body), &tasks)
+	if len(tasks) != 3 {
+		t.Fatalf("web tasks: want 3, got %d", len(tasks))
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat lost web access: %d", code)
+	}
+	// Projects of other organizations are untouched.
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatalf("globex project changed: %d", code)
+	}
+}
