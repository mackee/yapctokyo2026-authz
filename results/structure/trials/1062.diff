+// RemoveFromOrgProjects removes the user from every project of the
+// organization (a retirement): the user's memberships in those projects are
+// deleted, and tasks assigned to the user there are unassigned. The user's
+// organization is unchanged. Org admins only; a user outside the organization
+// is ErrNotFound. All or nothing.
+func (*UserTable) RemoveFromOrgProjects(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanManageMembers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveOrgUser(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
