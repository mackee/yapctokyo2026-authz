new file mode 100644
index 0000000..df1163c
--- /dev/null
+++ b/members.go
@@ -0,0 +1,146 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"sort"
+)
+
+type memberView struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+type setRolesRequest struct {
+	Roles map[string]string `json:"roles"`
+}
+
+var validRoles = map[string]bool{RoleManager: true, RoleContributor: true, RoleViewer: true}
+
+// setMemberRoles changes the roles of several project members at once.
+//
+// Only managers of the project may do this. The change is all or nothing: any
+// unknown role, non-member, or a result with no manager left rejects the whole
+// request. A member who becomes a viewer is unassigned from the project's tasks
+// (an assignee must be a contributor or manager).
+func (s *server) setMemberRoles(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role, err := findRole(ctx, s.db, project.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "only managers may change member roles")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req setRolesRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || len(req.Roles) == 0 {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	for _, newRole := range req.Roles {
+		if !validRoles[newRole] {
+			writeError(w, 400, "role must be manager, contributor or viewer")
+			return
+		}
+	}
+
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+
+	current := map[string]string{}
+	rows, err := tx.QueryContext(ctx, `SELECT user_id, role FROM memberships WHERE project_id = ?`, project.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	for rows.Next() {
+		var uid, rl string
+		if err := rows.Scan(&uid, &rl); err != nil {
+			rows.Close()
+			writeError(w, 500, "internal error")
+			return
+		}
+		current[uid] = rl
+	}
+	rows.Close()
+	if err := rows.Err(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+
+	for uid := range req.Roles {
+		if _, ok := current[uid]; !ok {
+			writeError(w, 400, "not a member of the project: "+uid)
+			return
+		}
+	}
+	for uid, newRole := range req.Roles {
+		current[uid] = newRole
+	}
+	managers := 0
+	for _, rl := range current {
+		if rl == RoleManager {
+			managers++
+		}
+	}
+	if managers == 0 {
+		writeError(w, 409, "a project must keep at least one manager")
+		return
+	}
+
+	for uid, newRole := range req.Roles {
+		if _, err := tx.ExecContext(ctx, `UPDATE memberships SET role = ? WHERE project_id = ? AND user_id = ?`, newRole, project.ID, uid); err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+		if newRole == RoleViewer {
+			if _, err := tx.ExecContext(ctx, `UPDATE tasks SET assignee = '' WHERE project_id = ? AND assignee = ?`, project.ID, uid); err != nil {
+				writeError(w, 500, "internal error")
+				return
+			}
+		}
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+
+	members := make([]memberView, 0, len(current))
+	for uid, rl := range current {
+		members = append(members, memberView{UserID: uid, Role: rl})
+	}
+	sort.Slice(members, func(i, j int) bool { return members[i].UserID < members[j].UserID })
+	writeJSON(w, 200, members)
+}
diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..924857b
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,149 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"testing"
+)
+
+type member struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func TestBulkRoles(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager changes", "ann", "web", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 200},
+		{"manager promotes", "ivy", "web", `{"roles":{"cat":"manager"}}`, 200},
+		{"no-op change", "ann", "web", `{"roles":{"ben":"contributor"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"missing project", "ann", "nope", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"invalid role", "ann", "web", `{"roles":{"ben":"admin"}}`, 400},
+		{"empty role", "ann", "web", `{"roles":{"ben":""}}`, 400},
+		{"non member target", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"target in other org", "ann", "web", `{"roles":{"gus":"viewer"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"bad json", "ann", "web", `nope`, 400},
+		{"viewer of ops", "ann", "ops", `{"roles":{"ivy":"viewer"}}`, 403},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestBulkRolesResponse(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got []member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []member{{"ann", "manager"}, {"ben", "viewer"}, {"cat", "contributor"}, {"dan", "contributor"}, {"ivy", "manager"}}
+	if len(got) != len(want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("got %v want %v", got, want)
+		}
+	}
+	// The change persisted.
+	if role, _ := findRole(context.Background(), h.(*appHandler).db, "web", "ben"); role != "viewer" {
+		t.Fatalf("ben is %q", role)
+	}
+}
+
+// A demoted member must not keep tasks assigned to them (model rules are
+// checked by do()); the tasks become unassigned.
+func TestBulkRolesDemotedLosesTasks(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer"}}`); code != 200 {
+		t.Fatal(code, body)
+	}
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatal(code)
+	}
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" {
+		t.Fatalf("t1 still assigned to %q", task.Assignee)
+	}
+	// Tasks in other projects are untouched.
+	code, body = do(t, h, "GET", "/projects/legacy/tasks/t5", "ann", "")
+	json.Unmarshal([]byte(body), &task)
+	if code != 200 || task.Assignee != "ben" {
+		t.Fatalf("t5: %d %+v", code, task)
+	}
+}
+
+// All or nothing: one bad entry means no entry is applied.
+func TestBulkRolesAtomic(t *testing.T) {
+	bodies := []string{
+		// hal is not a member
+		`{"roles":{"ben":"viewer","hal":"viewer"}}`,
+		// invalid role
+		`{"roles":{"ben":"viewer","dan":"admin"}}`,
+		// would leave no manager
+		`{"roles":{"ann":"viewer","ivy":"viewer"}}`,
+		// gus is in another org
+		`{"roles":{"ben":"viewer","dan":"contributor","gus":"viewer"}}`,
+	}
+	for _, b := range bodies {
+		h := newServer()
+		code, _ := do(t, h, "PUT", "/projects/web/members", "ann", b)
+		if code < 400 {
+			t.Fatalf("%s: got %d, want an error", b, code)
+		}
+		code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"cat":"contributor"}}`)
+		if code != 200 {
+			t.Fatal(code)
+		}
+		var got []member
+		json.Unmarshal([]byte(body), &got)
+		want := []member{{"ann", "manager"}, {"ben", "contributor"}, {"cat", "contributor"}, {"dan", "viewer"}, {"ivy", "manager"}}
+		for i := range want {
+			if i >= len(got) || got[i] != want[i] {
+				t.Fatalf("%s: state changed: %v", b, got)
+			}
+		}
+		// tasks untouched
+		_, tb := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+		var task Task
+		json.Unmarshal([]byte(tb), &task)
+		if task.Assignee != "ben" {
+			t.Fatalf("%s: t1 assignee changed to %q", b, task.Assignee)
+		}
+	}
+}
+
+func TestBulkRolesKeepsAManager(t *testing.T) {
+	h := newServer()
+	code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ann":"viewer","ivy":"contributor"}}`)
+	if code != 409 {
+		t.Fatalf("got %d want 409", code)
+	}
+	// Swapping managers in one request is fine.
+	code, _ = do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ann":"viewer","cat":"manager"}}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+}
