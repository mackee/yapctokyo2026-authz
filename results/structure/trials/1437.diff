+// transferUserAggregate moves one user to another organization. The user's
+// memberships (and so their task assignments) belong to the old organization
+// and are dropped; a membership in an archived project blocks the transfer.
+type transferUserAggregate struct {
+	user     *User
+	toOrg    string
+	members  []*Membership
+	archived bool // some membership is in an archived project
+	assigned []*Task
+}
+
+func loadTransferUser(ctx context.Context, tx DB, orgID, userID, toOrg string) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) || (err == nil && u.Org != orgID) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &transferUserAggregate{user: u, toOrg: toOrg}
+	if a.members, err = u.Memberships(ctx, tx); err != nil {
+		return nil, err
+	}
+	for _, m := range a.members {
+		p, err := m.Project(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		if p.Archived {
+			a.archived = true
+		}
+	}
+	if a.assigned, err = u.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if a.toOrg == "" || a.toOrg == a.user.Org {
+		return deny(ErrInvalid, "user must be moved to a different organization")
+	}
+	if a.archived {
+		return deny(ErrArchived, "user is a member of an archived project")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	for _, t := range a.assigned {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	for _, m := range a.members {
+		if err := m.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.user.moveTo(ctx, tx, a.toOrg); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
+
