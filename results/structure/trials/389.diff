+func TestTransfer(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin transfers user without memberships", "eve", "/orgs/acme/users/eve/transfer", `{"toOrgId":"globex"}`, 200},
+		{"manager is not org admin", "ann", "/orgs/acme/users/eve/transfer", `{"toOrgId":"globex"}`, 403},
+		{"contributor is not org admin", "ben", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 403},
+		{"anonymous", "", "/orgs/acme/users/eve/transfer", `{"toOrgId":"globex"}`, 401},
+		{"admin of other org", "gus", "/orgs/acme/users/eve/transfer", `{"toOrgId":"globex"}`, 404},
+		{"unknown org", "eve", "/orgs/initech/users/eve/transfer", `{"toOrgId":"globex"}`, 404},
+		{"user in other org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"user with project memberships", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 409},
+		{"unknown target org", "eve", "/orgs/acme/users/eve/transfer", `{"toOrgId":"initech"}`, 400},
+		{"same org", "eve", "/orgs/acme/users/eve/transfer", `{"toOrgId":"acme"}`, 400},
+		{"missing toOrgId", "eve", "/orgs/acme/users/eve/transfer", `{}`, 400},
+		{"invalid body", "eve", "/orgs/acme/users/eve/transfer", `not json`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var v struct {
+		ID    string `json:"id"`
+		OrgID string `json:"orgId"`
+	}
+	if err := json.Unmarshal([]byte(body), &v); err != nil {
+		t.Fatal(err)
+	}
+	if v.ID != "eve" || v.OrgID != "globex" {
+		t.Fatalf("got %+v", v)
+	}
+}
+
+// TestTransferEffects checks what a transfer changes for the moved user and for
+// the rest of the data, using one server so the state carries across requests.
+func TestTransferEffects(t *testing.T) {
+	h := newServer()
+
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "eve", ""); code != 200 {
+		t.Fatalf("before transfer: eve reads web got %d want 200", code)
+	}
+
+	// A refused transfer changes nothing: ben keeps his web membership.
+	if code, _ := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 409 {
+		t.Fatalf("ben transfer got %d want 409", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("after refused transfer: ben reads web got %d want 200", code)
+	}
+
+	if code, _ := do(t, h, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("eve transfer got %d want 200", code)
+	}
+
+	// eve is now a globex user: no acme access.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "eve", ""); code != 404 {
+		t.Fatalf("after transfer: eve reads acme project got %d want 404", code)
+	}
+	// Org admin rights do not move with her: she is not an admin of globex.
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "eve", ""); code != 404 {
+		t.Fatalf("after transfer: eve reads globex project got %d want 404", code)
+	}
+	if code, _ := do(t, h, "POST", "/orgs/globex/users/eve/transfer", "eve", `{"toOrgId":"acme"}`); code != 403 {
+		t.Fatalf("after transfer: eve transfer in globex got %d want 403", code)
+	}
+}
