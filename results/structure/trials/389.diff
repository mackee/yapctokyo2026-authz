+// transferUserAggregate moves one user from one organization to another.
+type transferUserAggregate struct {
+	user        userRecord
+	toOrg       orgRecord
+	memberships []membershipRecord // the user's memberships in projects of the organization being left
+}
+
+func loadTransferUser(x *tx, orgID, userID, toOrgID string) (*transferUserAggregate, error) {
+	u, ok := x.findUser(userID)
+	if !ok || u.Org != orgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if toOrgID == "" {
+		return nil, deny(ErrInvalid, "toOrgId is required")
+	}
+	to, ok := x.findOrg(toOrgID)
+	if !ok {
+		return nil, deny(ErrInvalid, "unknown organization")
+	}
+	a := &transferUserAggregate{user: u, toOrg: to}
+	for _, m := range u.Memberships(x) {
+		if p, ok := m.Project(x); ok && p.Org == orgID {
+			a.memberships = append(a.memberships, m)
+		}
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if a.toOrg.ID == a.user.Org {
+		return deny(ErrInvalid, "user already belongs to that organization")
+	}
+	if len(a.memberships) > 0 {
+		return deny(ErrConflict, "user is a member of projects in the organization; remove the memberships first")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(x *tx) UserView {
+	u := a.user
+	u.Transfer(x, a.toOrg.ID)
+	return UserView{ID: u.ID, OrgID: u.Org}
+}
+
