+// ---- organization capabilities -------------------------------------------------
+
+// OrgScope is bound to one actor and one organization ID. It grants nothing by
+// itself; call Admin to acquire the capability.
+type OrgScope interface {
+	ID() string
+	Admin() (AdminOrg, error)
+}
+
+// AdminOrg may manage the users of one organization.
+type AdminOrg interface {
+	// TransferUser moves a user of this organization to another organization.
+	// The user must not belong to any project of this organization (409); the
+	// memberships have to be removed first.
+	TransferUser(userID, toOrgID string) (UserView, error)
+}
+
+// UserView is the public representation of a user.
+type UserView struct {
+	ID    string `json:"id"`
+	OrgID string `json:"orgId"`
+}
+
+type orgScope struct {
+	as  *actorScope
+	oid string
+}
+
+func (s *orgScope) ID() string { return s.oid }
+
+// Admin applies the org rule: the organization must be the actor's own (else
+// 404), and the actor must be an org admin of it (else 403).
+func (s *orgScope) Admin() (AdminOrg, error) {
+	if s.oid != s.as.actor.org {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if !s.as.actor.orgAdmin {
+		return nil, deny(ErrForbidden, "forbidden")
+	}
+	return &adminOrg{os: s}, nil
+}
+
+type adminOrg struct{ os *orgScope }
+
+func (o *adminOrg) TransferUser(userID, toOrgID string) (UserView, error) {
+	var v UserView
+	err := o.os.as.a.db.update(func(x *tx) error {
+		agg, err := loadTransferUser(x, o.os.oid, userID, toOrgID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		v = agg.apply(x)
+		return nil
+	})
+	return v, err
+}
+
