+// Members lists a project's members sorted by user ID.
+func (s *Store) Members(projectID string) []Member {
+	out := []Member{}
+	for uid, role := range s.members[projectID] {
+		out = append(out, Member{UserID: uid, Role: role})
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].UserID < out[j].UserID })
+	return out
+}
+
+// SetRoles applies role changes to existing members of a project.
+// Callers must validate the changes before calling it.
+func (s *Store) SetRoles(projectID string, roles map[string]string) {
+	for uid, role := range roles {
+		s.members[projectID][uid] = role
+	}
+}
