+func TestUpdateMembers(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager batch", "ann", "web", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 200},
+		{"manager single", "ann", "web", `{"roles":{"ben":"manager"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"ben":"viewer"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"ben":"viewer"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"ben":"viewer"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"ben":"viewer"}}`, 404},
+		{"unknown project", "ann", "nope", `{"roles":{"ben":"viewer"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"ben":"viewer"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"invalid role", "ann", "web", `{"roles":{"ben":"owner"}}`, 400},
+		{"target not member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"one bad in batch", "ann", "web", `{"roles":{"ben":"viewer","hal":"viewer"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"malformed body", "ann", "web", `{"roles":`, 400},
+		{"last manager demoted", "ann", "web", `{"roles":{"ann":"viewer","ivy":"contributor"}}`, 409},
+		{"one of two managers demoted", "ann", "web", `{"roles":{"ann":"viewer"}}`, 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMembersResponse(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []Member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []Member{
+		{UserID: "ann", Role: RoleManager},
+		{UserID: "ben", Role: RoleViewer},
+		{UserID: "cat", Role: RoleContributor},
+		{UserID: "dan", Role: RoleContributor},
+		{UserID: "ivy", Role: RoleManager},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %d members, want %d: %s", len(got), len(want), body)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("member %d: got %+v want %+v", i, got[i], want[i])
+		}
+	}
+
+	// The change took effect: ben is now a viewer and can no longer create tasks.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Fatalf("ben after demotion: got %d want 403", code)
+	}
+}
+
+func TestUpdateMembersIsAllOrNothing(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","hal":"viewer"}}`); code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	// ben's change from the rejected batch must not have been applied.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 201 {
+		t.Fatalf("ben after rejected batch: got %d want 201", code)
+	}
+}
