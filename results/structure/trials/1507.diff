+// removeOrgUserAggregate removes one user from the organization's projects.
+type removeOrgUserAggregate struct {
+	memberships []*Membership // the user's memberships in the organization's projects
+}
+
+func loadRemoveOrgUser(ctx context.Context, tx DB, authz OrgAuthz, userID string) (*removeOrgUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) || (err == nil && u.Org != authz.OrgID()) {
+		return nil, deny(ErrNotFound, "user not found in organization")
+	} else if err != nil {
+		return nil, err
+	}
+	ms, err := NewMembershipTable().ListByUserInOrg(ctx, tx, authz.OrgID(), u.ID)
+	if err != nil {
+		return nil, err
+	}
+	return &removeOrgUserAggregate{memberships: ms}, nil
+}
+
+func (a *removeOrgUserAggregate) validate() error { return nil }
+
+// apply unassigns the user's tasks in each project first, so that no task is
+// left assigned to someone who is no longer a member, then removes the membership.
+func (a *removeOrgUserAggregate) apply(ctx context.Context, tx DB) error {
+	for _, m := range a.memberships {
+		tasks, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return err
+		}
+		for _, t := range tasks {
+			if err := t.unassign(ctx, tx); err != nil {
+				return err
+			}
+		}
+		if err := m.destroy(ctx, tx); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
