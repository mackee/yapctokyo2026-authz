+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes contributor", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes manager", "eve", "/orgs/acme/users/ann", 204},
+		{"org admin removes user with no memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"org admin removes twice", "eve", "/orgs/acme/users/ben", 204},
+		{"member but not admin", "ann", "/orgs/acme/users/ben", 403},
+		{"contributor", "ben", "/orgs/acme/users/cat", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"other org", "eve", "/orgs/globex/users/gus", 404},
+		{"org caller is not in", "gus", "/orgs/acme/users/ben", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ben", 404},
+		{"user in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+	app := h.(*appHandler)
+	count := func(t *testing.T, query string, args ...any) int {
+		t.Helper()
+		var n int
+		if err := app.db.QueryRow(query, args...).Scan(&n); err != nil {
+			t.Fatal(err)
+		}
+		return n
+	}
+	assignee := func(t *testing.T, taskID string) string {
+		t.Helper()
+		var a string
+		if err := app.db.QueryRow(`SELECT assignee FROM tasks WHERE id = ?`, taskID).Scan(&a); err != nil {
+			t.Fatal(err)
+		}
+		return a
+	}
+
+	// ben is a contributor in web and legacy (archived), assigned t1 and t5.
+	if n := count(t, `SELECT COUNT(*) FROM memberships WHERE user_id = 'ben'`); n != 2 {
+		t.Fatalf("before: ben has %d memberships, want 2", n)
+	}
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("got %d want 204", code)
+	}
+
+	if n := count(t, `SELECT COUNT(*) FROM memberships WHERE user_id = 'ben'`); n != 0 {
+		t.Errorf("ben still has %d memberships", n)
+	}
+	if a := assignee(t, "t1"); a != "" {
+		t.Errorf("t1 still assigned to %q", a)
+	}
+	if a := assignee(t, "t5"); a != "" {
+		t.Errorf("t5 (archived project) still assigned to %q", a)
+	}
+	if a := assignee(t, "t2"); a != "cat" {
+		t.Errorf("t2 of another user changed to %q", a)
+	}
+	if n := count(t, `SELECT COUNT(*) FROM memberships`); n != 9 {
+		t.Errorf("memberships = %d, want 9 (seed has 11)", n)
+	}
+	if n := count(t, `SELECT COUNT(*) FROM users WHERE id = 'ben' AND org_id = 'acme'`); n != 1 {
+		t.Errorf("user row for ben was removed")
+	}
+
+	// A removed user can no longer read the project.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Errorf("removed user reads web: got %d want 404", code)
+	}
+}
