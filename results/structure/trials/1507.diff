+// ListByUserInOrg returns the memberships of the user in the organization's
+// projects (archived ones included), ordered by project ID.
+func (mt *MembershipTable) ListByUserInOrg(ctx context.Context, db DB, orgID, userID string) ([]*Membership, error) {
+	return mt.list(ctx, db,
+		`SELECT m.project_id, m.user_id, m.role FROM memberships m
+		   JOIN projects p ON p.id = m.project_id
+		  WHERE p.org_id = ? AND m.user_id = ? ORDER BY m.project_id`, orgID, userID)
+}
+
+// ---- operations -----------------------------------------------------------------------
+
+// RemoveUserFromOrg removes the user from every project of the organization
+// (archived projects included) and unassigns the user's tasks in them, all in
+// one transaction. It asks the authorization object first (org admins only).
+// Removing an already-removed user succeeds and changes nothing.
+func (*MembershipTable) RemoveUserFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanManageMembers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveOrgUser(ctx, tx, authz, userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
