+// CanMoveTo returns nil if the actor may move the task from its project to
+// dest. The actor must be a contributor or manager in both projects (else
+// ErrForbidden), neither project may be archived (else ErrArchived), and either
+// the actor is a manager in both projects, or the task is assigned to the actor.
+// Call it with the destination's ProjectAuthz built by NewProjectAuthz.
+func (a TaskAuthz) CanMoveTo(dest ProjectAuthz) error {
+	if err := a.CanEdit(); err != nil {
+		return err
+	}
+	if err := dest.CanWrite(); err != nil {
+		return err
+	}
+	if a.project.role == RoleManager && dest.role == RoleManager {
+		return nil
+	}
+	if !a.isAssignee {
+		return deny(ErrForbidden, "contributors may only move tasks assigned to themselves")
+	}
+	return nil
+}
