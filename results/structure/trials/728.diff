+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"anonymous", "", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 401},
+		{"non member source", "hal", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 404},
+		{"task in other project", "ivy", "/projects/ops/tasks/t1/move", `{"toProjectId":"web"}`, 404},
+		{"malformed body", "ann", "/projects/web/tasks/t3/move", `{}`, 400},
+		{"unknown destination", "ann", "/projects/web/tasks/t1/move", `{"toProjectId":"nope"}`, 404},
+		{"destination not readable", "dan", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 404},
+		{"contributor others task", "cat", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer destination", "ann", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin", "eve", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"archived source", "ann", "/projects/legacy/tasks/t5/move", `{"toProjectId":"web"}`, 409},
+		{"archived destination", "ben", "/projects/web/tasks/t1/move", `{"toProjectId":"legacy"}`, 409},
+		{"same project", "ann", "/projects/web/tasks/t1/move", `{"toProjectId":"web"}`, 400},
+		{"assignee not in destination", "ivy", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsTaskFields(t *testing.T) {
+	srv := newServer()
+	code, body := do(t, srv, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d body=%s", code, body)
+	}
+	var moved Task
+	if err := json.Unmarshal([]byte(body), &moved); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", AssigneeID: "cat"}
+	if moved != want {
+		t.Fatalf("moved task = %+v, want %+v", moved, want)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks/t2", "ann", ""); code != 200 {
+		t.Fatalf("task not in destination: got %d", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks/t2", "ann", ""); code != 404 {
+		t.Fatalf("task still in source: got %d", code)
+	}
+}
