+
+// Move moves the member from the authorized project to ToProjectID, keeping the
+// role. The member's tasks in the old project are unassigned, because they are
+// no longer a member there. The actor must be a manager of both projects.
+func (mt *MembershipTable) Move(ctx context.Context, db DB, authz ProjectAuthz, in MembershipTableMoveInput) (*Membership, error) {
+	if in.ToProjectID == authz.ProjectID() {
+		return nil, deny(ErrInvalid, "destination must be another project")
+	}
+	if err := authz.CanManageMembers(); err != nil {
