 func (a *deleteTaskAggregate) apply(ctx context.Context, tx DB) error { return a.task.destroy(ctx, tx) }
+
+// moveMemberAggregate moves one member from the authorized project to another.
+type moveMemberAggregate struct {
+	from      *Membership // the member's membership in the old project
+	toProject string      // the destination project ID
+	existing  *Membership // the member's membership in the destination; nil if none
+	tasks     []*Task     // the old project's tasks assigned to the member
+}
+
+func loadMoveMember(ctx context.Context, tx DB, authz ProjectAuthz, in MembershipTableMoveInput) (*moveMemberAggregate, error) {
+	// The destination must be readable by the actor (else 404: missing, another
+	// organization, or not readable) and manageable by them (else 403 or 409).
+	dst, err := NewProjectAuthz(ctx, tx, authz.Actor(), in.ToProjectID)
+	if err != nil {
+		return nil, err
+	}
+	if err := dst.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	from, err := NewMembershipTable().Find(ctx, tx, authz.ProjectID(), in.UserID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveMemberAggregate{from: from, toProject: dst.ProjectID()}
+	existing, err := NewMembershipTable().Find(ctx, tx, a.toProject, in.UserID)
+	switch {
+	case err == nil:
+		a.existing = existing
+	case !errors.Is(err, ErrNoRows):
+		return nil, err
+	}
+	if a.tasks, err = from.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.existing != nil {
+		return deny(ErrConflict, "user is already a member of the destination project")
+	}
+	return nil
+}
+
+// apply unassigns the member's tasks in the old project, removes the old
+// membership and adds the member to the destination with the same role.
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.from.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	moved := &Membership{ProjectID: a.toProject, UserID: a.from.UserID, Role: a.from.Role}
+	if err := moved.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return moved, nil
+}
