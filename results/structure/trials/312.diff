+type manageProject struct{ writeProject }
+
+func (p *manageProject) SetRoles(roles map[string]string) ([]MemberView, error) {
+	if len(roles) == 0 {
+		return nil, deny(ErrInvalid, "roles must not be empty")
+	}
+	// Validate the request shape before touching state. Iterate in sorted order
+	// so the reported error is deterministic.
+	uids := make([]string, 0, len(roles))
+	for uid := range roles {
+		uids = append(uids, uid)
+	}
+	sort.Strings(uids)
+	for _, uid := range uids {
+		if !isValidRole(roles[uid]) {
+			return nil, deny(ErrInvalid, fmt.Sprintf("invalid role for %s", uid))
+		}
+	}
+
+	var out []MemberView
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		for _, uid := range uids {
+			if s.role(p.ps.pid, uid) == "" {
+				return deny(ErrInvalid, fmt.Sprintf("%s is not a member of the project", uid))
+			}
+		}
+		for _, uid := range uids {
+			s.members[p.ps.pid][uid] = roles[uid]
+		}
+		out = s.membersIn(p.ps.pid)
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return out, nil
+}
