+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"reflect"
+	"testing"
+)
+
+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"manager of another project", "ivy", "ops", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"archived", "ann", "legacy", 409},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResponseListsMembersAsViewers(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != http.StatusOK {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got []memberRole
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("decode %q: %v", body, err)
+	}
+	want := []memberRole{
+		{UserID: "ann", Role: "viewer"},
+		{UserID: "ben", Role: "viewer"},
+		{UserID: "cat", Role: "viewer"},
+		{UserID: "dan", Role: "viewer"},
+		{UserID: "ivy", Role: "viewer"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+}
+
+func TestFreezeBlocksTaskChanges(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != http.StatusOK {
+		t.Fatalf("freeze: got %d: %s", code, body)
+	}
+
+	cases := []struct {
+		name, user, method, path, body string
+		want                           int
+	}{
+		{"create by former manager", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"create by former contributor", "ben", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"update own former task", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`, 403},
+		{"update by former manager", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"delete by former manager", "ann", "DELETE", "/projects/web/tasks/t3", "", 403},
+		{"freeze again", "ann", "POST", "/projects/web/freeze", "", 403},
+		{"read still works", "ben", "GET", "/projects/web/tasks/t1", "", 200},
+		{"other project unaffected", "cat", "PATCH", "/projects/ops/tasks/t4", `{"status":"done"}`, 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, srv, c.method, c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestFreezeClearsAssignees(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != http.StatusOK {
+		t.Fatalf("freeze: got %d: %s", code, body)
+	}
+	for _, id := range []string{"t1", "t2", "t3"} {
+		_, body := do(t, srv, "GET", "/projects/web/tasks/"+id, "ann", "")
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatalf("decode %q: %v", body, err)
+		}
+		if task.AssigneeID != "" {
+			t.Fatalf("task %s still assigned to %q", id, task.AssigneeID)
+		}
+	}
+	// The other project keeps its assignee.
+	_, body := do(t, srv, "GET", "/projects/ops/tasks/t4", "cat", "")
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatalf("decode %q: %v", body, err)
+	}
+	if task.AssigneeID != "cat" {
+		t.Fatalf("ops task t4 assignee = %q, want cat", task.AssigneeID)
+	}
+}
