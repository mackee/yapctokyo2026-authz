+func TestClaim(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"contributor unassigned", "ben", "/projects/web/tasks/t3", 200},
+		{"manager unassigned", "ann", "/projects/web/tasks/t3", 200},
+		{"viewer", "dan", "/projects/web/tasks/t3", 403},
+		{"org admin", "eve", "/projects/web/tasks/t3", 403},
+		{"non member", "hal", "/projects/web/tasks/t3", 404},
+		{"other org", "gus", "/projects/web/tasks/t3", 404},
+		{"anonymous", "", "/projects/web/tasks/t3", 401},
+		{"already assigned to other", "ben", "/projects/web/tasks/t2", 409},
+		{"already assigned to self", "ben", "/projects/web/tasks/t1", 409},
+		{"cross project id", "ann", "/projects/web/tasks/t4", 404},
+		{"unknown task", "ann", "/projects/web/tasks/t99", 404},
+		{"archived", "ben", "/projects/legacy/tasks/t5", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path+"/claim", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestClaimAssignsCaller(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/tasks/t3/claim", "ben", "")
+	if code != 200 {
+		t.Fatalf("claim got %d: %s", code, body)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.ID != "t3" || task.ProjectID != "web" || task.Assignee != "ben" || task.Status != "open" {
+		t.Fatalf("unexpected response: %+v", task)
+	}
+
+	// The change is visible to later reads.
+	code, body = do(t, h, "GET", "/projects/web/tasks/t3", "dan", "")
+	if code != 200 {
+		t.Fatalf("get got %d", code)
+	}
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "ben" {
+		t.Fatalf("assignee not persisted: %q", task.Assignee)
+	}
+
+	// A second claim by someone else is rejected and does not reassign.
+	code, _ = do(t, h, "POST", "/projects/web/tasks/t3/claim", "ann", "")
+	if code != 409 {
+		t.Fatalf("second claim got %d want 409", code)
+	}
+	code, body = do(t, h, "GET", "/projects/web/tasks/t3", "dan", "")
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "ben" {
+		t.Fatalf("second claim changed assignee to %q", task.Assignee)
+	}
+}
