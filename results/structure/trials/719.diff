+func TestUpdateMemberRoles(t *testing.T) {
+	const path = "/projects/web/members"
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"no user", "", path, `{"roles":{"ben":"viewer"}}`, 401},
+		{"other org", "gus", path, `{"roles":{"ben":"viewer"}}`, 404},
+		{"non member", "hal", path, `{"roles":{"ben":"viewer"}}`, 404},
+		{"missing project", "ann", "/projects/nope/members", `{"roles":{"ben":"viewer"}}`, 404},
+		{"contributor", "ben", path, `{"roles":{"ben":"manager"}}`, 403},
+		{"viewer", "dan", path, `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin", "eve", path, `{"roles":{"ben":"viewer"}}`, 403},
+		{"archived", "ann", "/projects/legacy/members", `{"roles":{"ben":"viewer"}}`, 409},
+		{"bad role", "ann", path, `{"roles":{"ben":"viewer","dan":"boss"}}`, 400},
+		{"non member target", "ann", path, `{"roles":{"ben":"viewer","hal":"viewer"}}`, 400},
+		{"empty roles", "ann", path, `{"roles":{}}`, 400},
+		{"bad body", "ann", path, `nope`, 400},
+		{"removes last manager", "ann", path, `{"roles":{"ann":"viewer","ivy":"viewer"}}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			code, body := do(t, h, "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+			// A failed request must not change anything.
+			_, after := do(t, h, "PUT", path, "ann", `{"roles":{"ann":"manager"}}`)
+			want := `[{"userId":"ann","role":"manager"},{"userId":"ben","role":"contributor"},{"userId":"cat","role":"contributor"},{"userId":"dan","role":"viewer"},{"userId":"ivy","role":"manager"}]`
+			if strings.TrimSpace(after) != want {
+				t.Fatalf("state changed: %s", after)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRolesResult(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	want := `[{"userId":"ann","role":"manager"},{"userId":"ben","role":"viewer"},{"userId":"cat","role":"contributor"},{"userId":"dan","role":"contributor"},{"userId":"ivy","role":"manager"}]`
+	if code != 200 || strings.TrimSpace(body) != want {
+		t.Fatalf("got %d %s", code, body)
+	}
+}
