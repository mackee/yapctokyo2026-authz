+	ToOrgID string `json:"toOrgId" validate:"required"`
+}
+
+type transferResponse struct {
+	ID    string `json:"id"`
+	OrgID string `json:"orgId"`
+}
+
+func transferUser(ctx tanukirpc.Context[*orgRegistry], req transferRequest) (*transferResponse, error) {
+	reg := ctx.Registry()
+	u, err := model.NewUserTable().Transfer(ctx, reg.db, reg.authz, model.UserTableTransferInput{
+		UserID:  chi.URLParam(ctx.Request(), "uid"),
+		ToOrgID: req.ToOrgID,
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &transferResponse{ID: u.ID, OrgID: u.Org}, nil
+}
