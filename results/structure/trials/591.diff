+// UserTable is the users table.
 type UserTable struct{}
 
+// OrgExists reports whether any user or project belongs to the organization.
+func (*UserTable) OrgExists(ctx context.Context, db DB, orgID string) (bool, error) {
+	var n int
+	if err := db.QueryRowContext(ctx,
+		`SELECT (SELECT COUNT(*) FROM users WHERE org_id = ?) + (SELECT COUNT(*) FROM projects WHERE org_id = ?)`,
+		orgID, orgID).Scan(&n); err != nil {
+		return false, err
+	}
+	return n > 0, nil
+}
+
+// UserTableTransferInput is the input of UserTable.Transfer.
+type UserTableTransferInput struct {
+	UserID  string
+	ToOrgID string
+}
+
+// Transfer moves a user of the authz organization to another organization.
+// The user's memberships and task assignments in the old organization's
+// projects are removed and the org admin flag is cleared, so that the model
+// rules keep holding.
+func (*UserTable) Transfer(ctx context.Context, db DB, authz OrgAuthz, in UserTableTransferInput) (*User, error) {
+	if err := authz.CanTransferUsers(); err != nil {
+		return nil, err
+	}
+	if in.ToOrgID == "" {
+		return nil, deny(ErrInvalid, "toOrgId must not be empty")
+	}
+	var u *User
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadTransferUser(ctx, tx, authz.OrgID(), in)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if u, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return u, nil
+}
+
 // NewUserTable returns the users table.
 func NewUserTable() *UserTable { return &UserTable{} }
 
