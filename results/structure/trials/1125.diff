+// Move moves the member userID out of the authz project into toProjectID with
+// the same role. The actor must be a manager of both projects (neither
+// archived); a destination the actor cannot read is ErrNotFound. Tasks of the
+// project assigned to the user become unassigned. All or nothing.
+func (*MembershipTable) Move(ctx context.Context, db DB, authz ProjectAuthz, userID, toProjectID string) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if toProjectID == authz.ProjectID() {
+		return nil, deny(ErrInvalid, "destination must be a different project")
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		toAuthz, err := NewProjectAuthz(ctx, tx, authz.Actor(), toProjectID)
+		if err != nil {
+			return err
+		}
+		if err := toAuthz.CanManageMembers(); err != nil {
+			return err
+		}
+		agg, err := loadMoveMember(ctx, tx, authz.ProjectID(), userID, toProjectID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(ctx, tx); err != nil {
+			return err
+		}
+		m, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
