+// moveMemberAggregate moves one member from a project to another, keeping the
+// role. The member's tasks in the source project are unassigned, since an
+// assignee must be a member of the task's project.
+type moveMemberAggregate struct {
+	from  *Membership
+	to    *Project
+	tasks []*Task // from.AssignedTasks
+}
+
+func loadMoveMember(ctx context.Context, tx DB, fromProjectID, userID, toProjectID string) (*moveMemberAggregate, error) {
+	if fromProjectID == toProjectID {
+		return nil, deny(ErrInvalid, "destination must be a different project")
+	}
+	from, err := NewMembershipTable().Find(ctx, tx, fromProjectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	to, err := NewProjectTable().Find(ctx, tx, toProjectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if _, err := to.Membership(ctx, tx, userID); err == nil {
+		return nil, deny(ErrInvalid, "user is already a member of the destination project")
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	tasks, err := from.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &moveMemberAggregate{from: from, to: to, tasks: tasks}, nil
+}
+
+func (a *moveMemberAggregate) validate(ctx context.Context, tx DB) error {
+	u, err := a.from.User(ctx, tx)
+	if err != nil {
+		return err
+	}
+	if u.Org != a.to.Org {
+		return deny(ErrInvalid, "project members must belong to the project's organization")
+	}
+	if !validRole(a.from.Role) {
+		return deny(ErrInvalid, "invalid role")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.from.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	m := &Membership{ProjectID: a.to.ID, UserID: a.from.UserID, Role: a.from.Role}
+	if err := m.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
+
