+// updateRolesAggregate changes the roles of several members of one project.
+type updateRolesAggregate struct {
+	projectID string
+	changes   []*roleChange // sorted by user ID
+}
+
+// roleChange is one member's role change.
+type roleChange struct {
+	membership    *Membership
+	role          string
+	assignedTasks int // tasks of the project assigned to the member
+}
+
+func loadUpdateRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*updateRolesAggregate, error) {
+	userIDs := make([]string, 0, len(roles))
+	for userID := range roles {
+		userIDs = append(userIDs, userID)
+	}
+	sort.Strings(userIDs)
+	a := &updateRolesAggregate{projectID: projectID}
+	for _, userID := range userIDs {
+		m, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, fmt.Sprintf("user %s is not a member of the project", userID))
+		} else if err != nil {
+			return nil, err
+		}
+		c := &roleChange{membership: m, role: roles[userID]}
+		if !isWriterRole(c.role) {
+			tasks, err := m.AssignedTasks(ctx, tx)
+			if err != nil {
+				return nil, err
+			}
+			c.assignedTasks = len(tasks)
+		}
+		a.changes = append(a.changes, c)
+	}
+	return a, nil
+}
+
+func (a *updateRolesAggregate) validate() error {
+	for _, c := range a.changes {
+		if c.role != RoleManager && c.role != RoleContributor && c.role != RoleViewer {
+			return deny(ErrInvalid, fmt.Sprintf("invalid role %q", c.role))
+		}
+		// An assignee must be a contributor or manager of the task's project.
+		if !isWriterRole(c.role) && c.assignedTasks > 0 {
+			return deny(ErrInvalid, fmt.Sprintf("user %s has assigned tasks and must stay a contributor or manager", c.membership.UserID))
+		}
+	}
+	return nil
+}
+
+// apply changes every member's role and returns the project's members.
+func (a *updateRolesAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for _, c := range a.changes {
+		if err := c.membership.setRole(ctx, tx, c.role); err != nil {
+			return nil, err
+		}
+	}
+	return NewMembershipTable().ListByProject(ctx, tx, a.projectID)
+}
