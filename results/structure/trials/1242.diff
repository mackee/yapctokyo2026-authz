+func TestUpdateMembers(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager", "ann", "web", `{"roles":{"dan":"contributor","ivy":"viewer"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"unknown project", "ann", "nope", `{"roles":{"dan":"contributor"}}`, 404},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"anonymous", "", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"user not in project", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"unknown user", "ann", "web", `{"roles":{"zed":"viewer"}}`, 400},
+		{"one bad member", "ann", "web", `{"roles":{"dan":"contributor","zed":"viewer"}}`, 400},
+		{"invalid role", "ann", "web", `{"roles":{"dan":"owner"}}`, 400},
+		{"non-string role", "ann", "web", `{"roles":{"dan":1}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"null roles", "ann", "web", `{"roles":null}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"malformed body", "ann", "web", `{"roles":`, 400},
+		{"assignee to viewer", "ann", "web", `{"roles":{"ben":"viewer"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMembersResponse(t *testing.T) {
+	srv := newServer()
+	code, body := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","ivy":"viewer"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []map[string]string{
+		{"userId": "ann", "role": "manager"},
+		{"userId": "ben", "role": "contributor"},
+		{"userId": "cat", "role": "contributor"},
+		{"userId": "dan", "role": "contributor"},
+		{"userId": "ivy", "role": "viewer"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %d members, want %d: %s", len(got), len(want), body)
+	}
+	for i := range want {
+		if got[i]["userId"] != want[i]["userId"] || got[i]["role"] != want[i]["role"] {
+			t.Fatalf("member %d: got %v want %v", i, got[i], want[i])
+		}
+	}
+
+	// dan is a contributor now, so may create tasks; ivy is a viewer, so may not.
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("promoted dan create: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "ivy", `{"title":"x"}`); code != 403 {
+		t.Fatalf("demoted ivy create: got %d want 403", code)
+	}
+}
+
+func TestUpdateMembersAllOrNothing(t *testing.T) {
+	cases := []struct{ name, body string }{
+		// dan's change is valid, but zed is not a member: nothing changes.
+		{"unknown member", `{"roles":{"dan":"contributor","zed":"viewer"}}`},
+		// ben is assigned t1, so he cannot become a viewer: nothing changes.
+		{"assigned member demoted", `{"roles":{"dan":"contributor","ben":"viewer"}}`},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			srv := newServer()
+			if code, body := do(t, srv, "PUT", "/projects/web/members", "ann", c.body); code != 400 {
+				t.Fatalf("got %d want 400: %s", code, body)
+			}
+			// dan is still a viewer, and ben still a contributor.
+			if code, _ := do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 403 {
+				t.Fatalf("dan create: got %d want 403", code)
+			}
+			if code, _ := do(t, srv, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 200 {
+				t.Fatalf("ben update: got %d want 200", code)
+			}
+		})
+	}
+}
