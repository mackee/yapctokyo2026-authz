+type membersRequest struct {
+	Roles map[string]string `json:"roles"`
+}
+
+type member struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+var validRoles = map[string]bool{RoleManager: true, RoleContributor: true, RoleViewer: true}
+
+// updateMembers changes the roles of several project members at once.
+// Either every change applies or none does; the response is the full member
+// list after the change.
+func (s *server) updateMembers(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role, err := findRole(ctx, s.db, project.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req membersRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || len(req.Roles) == 0 {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+	for userID, newRole := range req.Roles {
+		if !validRoles[newRole] {
+			writeError(w, 400, "invalid role")
+			return
+		}
+		var current string
+		err := tx.QueryRowContext(ctx, `SELECT role FROM memberships WHERE project_id = ? AND user_id = ?`, project.ID, userID).Scan(&current)
+		if errors.Is(err, sql.ErrNoRows) {
+			writeError(w, 400, "user is not a member of the project")
+			return
+		}
+		if err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+		if _, err := tx.ExecContext(ctx, `UPDATE memberships SET role = ? WHERE project_id = ? AND user_id = ?`, newRole, project.ID, userID); err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+	}
+	members, err := listMembers(ctx, tx, project.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, members)
+}
+
+func listMembers(ctx context.Context, tx *sql.Tx, projectID string) ([]member, error) {
+	rows, err := tx.QueryContext(ctx, `SELECT user_id, role FROM memberships WHERE project_id = ? ORDER BY user_id`, projectID)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	members := []member{}
+	for rows.Next() {
+		var m member
+		if err := rows.Scan(&m.UserID, &m.Role); err != nil {
+			return nil, err
+		}
+		members = append(members, m)
+	}
+	return members, rows.Err()
+}
diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..b088ce9
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,151 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"testing"
+)
+
+// memberList decodes a member-list response into userId -> role.
+func memberList(t *testing.T, body string) map[string]string {
+	t.Helper()
+	var list []struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &list); err != nil {
+		t.Fatalf("response is not a member list: %v: %s", err, body)
+	}
+	roles := map[string]string{}
+	for _, m := range list {
+		roles[m.UserID] = m.Role
+	}
+	return roles
+}
+
+func putMembers(t *testing.T, h http.Handler, user, project, body string) (int, string) {
+	t.Helper()
+	return do(t, h, "PUT", "/projects/"+project+"/members", user, body)
+}
+
+func TestBulkRoleChangeReturnsUpdatedMembers(t *testing.T) {
+	code, body := putMembers(t, newServer(), "ann", "web", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	got := memberList(t, body)
+	want := map[string]string{
+		"ann": "manager",
+		"ben": "viewer",
+		"cat": "contributor",
+		"dan": "contributor",
+		"ivy": "manager",
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %d members want %d: %v", len(got), len(want), got)
+	}
+	for id, role := range want {
+		if got[id] != role {
+			t.Errorf("%s: got role %q want %q", id, got[id], role)
+		}
+	}
+}
+
+func TestBulkRoleChangeIsPersisted(t *testing.T) {
+	srv := newServer()
+	if code, body := putMembers(t, srv, "ann", "web", `{"roles":{"ben":"viewer"}}`); code != 200 {
+		t.Fatalf("change: got %d want 200: %s", code, body)
+	}
+	// A later no-op request reports the stored state.
+	code, body := putMembers(t, srv, "ann", "web", `{"roles":{"ann":"manager"}}`)
+	if code != 200 {
+		t.Fatalf("follow-up: got %d want 200: %s", code, body)
+	}
+	if got := memberList(t, body)["ben"]; got != "viewer" {
+		t.Fatalf("ben: got role %q after change, want viewer", got)
+	}
+	// The change also takes effect for access control: a viewer cannot write.
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Fatalf("ben as viewer creating task: got %d want 403", code)
+	}
+}
+
+func TestBulkRoleChangeIsAllOrNothing(t *testing.T) {
+	cases := []struct {
+		name, body string
+	}{
+		{"non member target", `{"roles":{"ben":"viewer","hal":"viewer"}}`},
+		{"other org target", `{"roles":{"ben":"viewer","gus":"viewer"}}`},
+		{"unknown user target", `{"roles":{"ben":"viewer","zed":"viewer"}}`},
+		{"invalid role", `{"roles":{"ben":"viewer","cat":"admin"}}`},
+		{"empty role", `{"roles":{"ben":"viewer","cat":""}}`},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			srv := newServer()
+			code, body := putMembers(t, srv, "ann", "web", c.body)
+			if code != 400 {
+				t.Fatalf("got %d want 400: %s", code, body)
+			}
+			// Nothing was changed, including the valid entries.
+			code, body = putMembers(t, srv, "ann", "web", `{"roles":{"ann":"manager"}}`)
+			if code != 200 {
+				t.Fatalf("follow-up: got %d want 200: %s", code, body)
+			}
+			got := memberList(t, body)
+			if got["ben"] != "contributor" {
+				t.Errorf("ben: got role %q want contributor (partial update leaked)", got["ben"])
+			}
+			if got["cat"] != "contributor" {
+				t.Errorf("cat: got role %q want contributor (partial update leaked)", got["cat"])
+			}
+		})
+	}
+}
+
+func TestBulkRoleChangeAuthorization(t *testing.T) {
+	const body = `{"roles":{"ben":"viewer"}}`
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"other manager", "ivy", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin cannot write", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+		{"missing project", "ann", "nope", 404},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, resp := putMembers(t, newServer(), c.user, c.project, body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, resp)
+			}
+		})
+	}
+}
+
+func TestBulkRoleChangeBadRequest(t *testing.T) {
+	cases := []struct {
+		name, body string
+	}{
+		{"not json", `not json`},
+		{"missing roles", `{}`},
+		{"empty roles", `{"roles":{}}`},
+		{"roles is not an object", `{"roles":["ben"]}`},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, resp := putMembers(t, newServer(), "ann", "web", c.body)
+			if code != 400 {
+				t.Fatalf("got %d want 400: %s", code, resp)
+			}
+		})
+	}
+}
