+// removeOrgUser takes the user out of every project of the organization (for
+// example when they leave the company).
+func removeOrgUser(ctx tanukirpc.Context[*orgRegistry], _ struct{}) (*struct{}, error) {
+	a, err := ctx.Registry().scope.Admin()
+	if err != nil {
+		return nil, err
+	}
+	if err := a.RemoveUser(chi.URLParam(ctx.Request(), "uid")); err != nil {
+		return nil, err
+	}
+	ctx.Response().WriteHeader(http.StatusNoContent)
+	return nil, nil
+}
