+// ---- organization capabilities -------------------------------------------------
+
+// OrgScope is bound to one actor and one organization ID.
+type OrgScope interface {
+	Admin() (AdminOrg, error)
+}
+
+// AdminOrg may manage the membership of one organization. Org admins only.
+type AdminOrg interface {
+	// RemoveUser takes userID out of every project of the organization. Tasks
+	// of those projects that were assigned to the user become unassigned. The
+	// user must belong to the organization (else 404); removing a user who is
+	// in no project is a no-op.
+	RemoveUser(userID string) error
+}
+
+type orgScope struct {
+	as  *actorScope
+	oid string
+}
+
+// Admin applies the org-admin rule: the organization must be the actor's own
+// (else 404, as for projects of another organization), and the actor must be an
+// org admin (else 403).
+func (s *orgScope) Admin() (AdminOrg, error) {
+	if s.oid != s.as.actor.org {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if !s.as.actor.orgAdmin {
+		return nil, deny(ErrForbidden, "forbidden")
+	}
+	return &adminOrg{as: s.as, oid: s.oid}, nil
+}
+
+type adminOrg struct {
+	as  *actorScope
+	oid string
+}
+
+func (o *adminOrg) RemoveUser(userID string) error {
+	return o.as.a.st.tx(func(s *state) error {
+		if u, ok := s.users[userID]; !ok || u.org != o.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		for pid, p := range s.projects {
+			if p.org == o.oid {
+				delete(s.members[pid], userID)
+			}
+		}
+		for tid, t := range s.tasks {
+			if t.assignee.user == userID && s.projects[t.project].org == o.oid {
+				t.assignee = Assignee{project: t.project}
+				s.tasks[tid] = t
+			}
+		}
+		return nil
+	})
+}
