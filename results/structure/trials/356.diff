+func TestMoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager of both", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 200},
+		{"manager of source only", "ann", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"contributor of source", "ben", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer of source", "dan", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"non member of source", "hal", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 401},
+		{"unknown user", "zed", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 401},
+		{"not a member of source", "ivy", "/projects/ops/members/ben/move", `{"toProjectId":"web"}`, 404},
+		{"already in target", "ivy", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 400},
+		{"target missing", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"nope"}`, 404},
+		{"target other org", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"gx"}`, 404},
+		{"archived source", "ann", "/projects/legacy/members/ben/move", `{"toProjectId":"web"}`, 409},
+		{"same project", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"web"}`, 400},
+		{"missing target", "ivy", "/projects/web/members/ben/move", `{}`, 400},
+		{"bad body", "ivy", "/projects/web/members/ben/move", `not json`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveMemberEffects(t *testing.T) {
+	h := newServer()
+
+	code, body := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d %s", code, body)
+	}
+	var got struct {
+		UserID    string `json:"userId"`
+		ProjectID string `json:"projectId"`
+		Role      string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.UserID != "ben" || got.ProjectID != "ops" || got.Role != "contributor" {
+		t.Fatalf("response: %s", body)
+	}
+
+	// Access follows the membership.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("old project still readable: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+		t.Fatalf("new project not readable: %d", code)
+	}
+	// Membership in other projects is untouched.
+	if code, _ := do(t, h, "GET", "/projects/legacy/tasks", "ben", ""); code != 200 {
+		t.Fatalf("legacy membership changed: %d", code)
+	}
+	// The role is kept: a contributor can create in the new project.
+	if code, _ := do(t, h, "POST", "/projects/ops/tasks", "ben", `{"title":"x","assignee":"ben"}`); code != 201 {
+		t.Fatalf("contributor role not kept: %d", code)
+	}
+
+	// The member's tasks in the old project are released; others are kept.
+	code, body = do(t, h, "GET", "/projects/web/tasks/t1", "ivy", "")
+	if code != 200 || !strings.Contains(body, `"assignee":""`) {
+		t.Fatalf("t1 not released: %d %s", code, body)
+	}
+	code, body = do(t, h, "GET", "/projects/web/tasks/t2", "ivy", "")
+	if code != 200 || !strings.Contains(body, `"assignee":"cat"`) {
+		t.Fatalf("t2 changed: %d %s", code, body)
+	}
+
+	// A viewer keeps the viewer role.
+	code, body = do(t, h, "POST", "/projects/web/members/dan/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 || !strings.Contains(body, `"role":"viewer"`) {
+		t.Fatalf("viewer move: %d %s", code, body)
+	}
+}
