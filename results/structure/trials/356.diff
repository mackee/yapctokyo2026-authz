+// ManageProject may change the membership of one project.
+type ManageProject interface {
+	ReadProject
+	// MoveMember moves a member of this project to the project to, keeping the
+	// member's role. The caller must manage both projects. The member's tasks
+	// in this project become unassigned.
+	MoveMember(userID string, to ManageProject) (MemberView, error)
+}
+
+type manageProject struct{ readProject }
+
+func (p *manageProject) MoveMember(userID string, to ManageProject) (MemberView, error) {
+	dst, ok := to.(*manageProject)
+	if !ok || dst.ps.as.a != p.ps.as.a || dst.ps.as.actor.id != p.ps.as.actor.id {
+		return MemberView{}, deny(ErrForbidden, "forbidden")
+	}
+	if dst.ps.pid == p.ps.pid {
+		return MemberView{}, deny(ErrInvalid, "target must be a different project")
+	}
+	var v MemberView
+	err := p.ps.as.a.db.update(func(x *tx) error {
+		agg, err := loadMoveMember(x, p.ps.pid, dst.ps.pid, userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		v = agg.save(x)
+		return nil
+	})
+	return v, err
+}
