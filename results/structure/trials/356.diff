+// moveMemberAggregate moves one member from one project to another, keeping
+// the role. Tasks the member holds in the source project are unassigned, since
+// an assignee must belong to the task's project.
+type moveMemberAggregate struct {
+	from     membershipRecord // removed from the source project
+	user     userRecord
+	target   projectRecord
+	released []taskRecord // source-project tasks that become unassigned
+}
+
+func loadMoveMember(x *tx, fromProjectID, toProjectID, userID string) (*moveMemberAggregate, error) {
+	from, ok := x.findMembership(fromProjectID, userID)
+	if !ok {
+		return nil, deny(ErrNotFound, "member not found")
+	}
+	target, ok := x.findProject(toProjectID)
+	if !ok {
+		return nil, deny(ErrInvalid, "target project does not exist")
+	}
+	if _, ok := x.findMembership(toProjectID, userID); ok {
+		return nil, deny(ErrInvalid, "user is already a member of the target project")
+	}
+	user, ok := x.findUser(userID)
+	if !ok {
+		return nil, deny(ErrNotFound, "member not found")
+	}
+	a := &moveMemberAggregate{from: from, user: user, target: target}
+	for _, t := range x.tasksIn(fromProjectID) {
+		if t.AssigneeID == userID {
+			t.AssigneeID = ""
+			a.released = append(a.released, t)
+		}
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.user.Org != a.target.Org {
+		return deny(ErrInvalid, "member must belong to the target project's organization")
+	}
+	if !isProjectRole(a.from.Role) {
+		return deny(ErrInvalid, "invalid project role")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) save(x *tx) MemberView {
+	for _, t := range a.released {
+		t.save(x)
+	}
+	a.from.destroy(x)
+	to := membershipRecord{ProjectID: a.target.ID, UserID: a.user.ID, Role: a.from.Role}
+	to.save(x)
+	return MemberView{UserID: to.UserID, ProjectID: to.ProjectID, Role: to.Role}
+}
