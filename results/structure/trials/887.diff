+
+// moveTaskAggregate moves one task into another project.
+type moveTaskAggregate struct {
+	task     *Task
+	dest     *Project
+	assignee *Membership // dest.Membership(the task's assignee); nil when unassigned or not a member
+}
+
+func loadMoveTask(ctx context.Context, tx DB, taskID string, in TaskTableMoveInput) (*moveTaskAggregate, error) {
+	t, err := NewTaskTable().Find(ctx, tx, taskID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	dest, err := NewProjectTable().Find(ctx, tx, in.ToProjectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveTaskAggregate{task: t, dest: dest}
+	if t.AssigneeID != "" {
+		m, err := dest.Membership(ctx, tx, t.AssigneeID)
+		if err == nil {
+			a.assignee = m
+		} else if !errors.Is(err, ErrNoRows) {
+			return nil, err
+		}
+	}
+	return a, nil
+}
+
+func (a *moveTaskAggregate) validate() error {
+	// The assignee is kept, so it must be a contributor or manager of the destination.
+	if a.task.AssigneeID != "" && (a.assignee == nil || !isWriterRole(a.assignee.Role)) {
+		return deny(ErrInvalid, "assignee must be a contributor or manager of the project")
+	}
+	return nil
+}
+
+func (a *moveTaskAggregate) apply(ctx context.Context, tx DB) (*Task, error) {
+	if err := a.task.moveTo(ctx, tx, a.dest); err != nil {
+		return nil, err
+	}
+	return a.task, nil
+}
