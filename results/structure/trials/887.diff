@@ -121,6 +121,24 @@ func (a TaskAuthz) CanManage() error {
 	return nil
 }
 
+// CanMove returns nil if the actor may move the task to the project dst
+// (built with NewProjectAuthz for the destination). The actor must be able to
+// edit the task in its own project (CanEdit) and be a writer of dst (else
+// ErrForbidden; archived dst is ErrArchived). A contributor on either side may
+// move only tasks assigned to themselves; a manager on both sides may move any task.
+func (a TaskAuthz) CanMove(dst ProjectAuthz) error {
+	if err := a.CanEdit(); err != nil {
+		return err
+	}
+	if err := dst.CanWrite(); err != nil {
+		return err
+	}
+	if !(a.project.role == RoleManager && dst.role == RoleManager) && !a.isAssignee {
+		return deny(ErrForbidden, "contributors may only move their own tasks")
+	}
+	return nil
+}
+
