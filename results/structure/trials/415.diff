+// Remove removes the user from the project, all or nothing. The project's tasks
+// assigned to the user are unassigned in the same transaction. It requires
+// CanManageMembers, and ErrNotFound when the user is not a member.
+func (*MembershipTable) Remove(ctx context.Context, db DB, authz ProjectAuthz, userID string) error {
+	if err := authz.CanManageMembers(); err != nil {
+		return err
+	}
+	return db.update(ctx, func(x *Tx) error {
+		agg, err := loadRemoveMember(ctx, x, authz.ProjectID(), userID)
+		if err != nil {
+			return err
+		}
+		return agg.apply(ctx, x)
+	})
+}
