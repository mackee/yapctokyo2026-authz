+type memberRequest struct {
+	Role string `json:"role"`
+}
+
+type memberResponse struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// updateMemberRole changes a member's role. Only project managers may do so,
+// the target must already be a member, and the last manager cannot be demoted.
+func (s *server) updateMemberRole(w http.ResponseWriter, r *http.Request) {
+	s.store.mu.Lock()
+	defer s.store.mu.Unlock()
+
+	user := s.store.User(r.Header.Get("X-User"))
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project := s.store.Project(r.PathValue("pid"))
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role := s.store.Role(project.ID, user.ID)
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	targetID := r.PathValue("uid")
+	targetRole := s.store.Role(project.ID, targetID)
+	if targetRole == "" {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req memberRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || !validRoles[req.Role] {
+		writeError(w, 400, "invalid role")
+		return
+	}
+	if targetRole == RoleManager && req.Role != RoleManager && s.store.CountManagers(project.ID) <= 1 {
+		writeError(w, 409, "cannot demote the last manager")
+		return
+	}
+	s.store.SetRole(project.ID, targetID, req.Role)
+	writeJSON(w, 200, memberResponse{UserID: targetID, Role: req.Role})
+}
