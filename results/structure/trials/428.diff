+// transferUserAggregate moves one user to another organization. Memberships
+// in projects outside the new organization are removed, and the tasks the user
+// is assigned to outside it are unassigned, so the model rules still hold.
+type transferUserAggregate struct {
+	user     *User
+	toOrg    string
+	leave    []*Membership // memberships in projects outside toOrg
+	unassign []*Task       // tasks assigned to the user in projects outside toOrg
+}
+
+func loadTransferUser(ctx context.Context, x *Tx, fromOrg, userID, toOrg string) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, x, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != fromOrg {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if toOrg == fromOrg {
+		return nil, deny(ErrInvalid, "user already belongs to that organization")
+	}
+	ok, err := NewOrgTable().Exists(ctx, x, toOrg)
+	if err != nil {
+		return nil, err
+	}
+	if !ok {
+		return nil, deny(ErrInvalid, "unknown organization")
+	}
+	a := &transferUserAggregate{user: u, toOrg: toOrg}
+	ms, err := u.Memberships(ctx, x)
+	if err != nil {
+		return nil, err
+	}
+	for _, m := range ms {
+		p, err := m.Project(ctx, x)
+		if err != nil {
+			return nil, err
+		}
+		if p.Org != toOrg {
+			a.leave = append(a.leave, m)
+		}
+	}
+	ts, err := u.AssignedTasks(ctx, x)
+	if err != nil {
+		return nil, err
+	}
+	for _, t := range ts {
+		p, err := t.Project(ctx, x)
+		if errors.Is(err, ErrNoRows) {
+			a.unassign = append(a.unassign, t)
+			continue
+		} else if err != nil {
+			return nil, err
+		}
+		if p.Org != toOrg {
+			a.unassign = append(a.unassign, t)
+		}
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error { return nil }
+
+func (a *transferUserAggregate) apply(ctx context.Context, x *Tx) (*User, error) {
+	for _, t := range a.unassign {
+		if err := t.unassign(ctx, x); err != nil {
+			return nil, err
+		}
+	}
+	for _, m := range a.leave {
+		if err := m.destroy(ctx, x); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.user.moveTo(ctx, x, a.toOrg); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
