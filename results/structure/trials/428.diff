+// destroy removes the membership.
+func (r *Membership) destroy(ctx context.Context, db DB) error {
+	return db.update(ctx, func(x *Tx) error {
+		delete(x.t.members[r.ProjectID], r.UserID)
+		return nil
+	})
+}
+
+// moveTo puts the user in another organization. Org admin rights belong to
+// the organization they were granted in, so they are cleared.
+func (r *User) moveTo(ctx context.Context, db DB, org string) error {
+	r.Org = org
+	r.OrgAdmin = false
+	return r.save(ctx, db)
+}
