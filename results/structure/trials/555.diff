+func TestTransferAuth(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 200},
+		{"anonymous", "", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 401},
+		{"non admin", "ann", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 403},
+		{"other org caller", "gus", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 404},
+		{"user not in org", "eve", "/orgs/globex/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"user not in path org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"same org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"acme"}`, 400},
+		{"unknown dest", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"nowhere"}`, 400},
+		{"empty dest", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":""}`, 400},
+		{"bad body", "eve", "/orgs/acme/users/ben/transfer", `nope`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferEffects(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got map[string]string
+	json.Unmarshal([]byte(body), &got)
+	if got["id"] != "ben" || got["orgId"] != "globex" {
+		t.Fatalf("bad response %v", got)
+	}
+	// Lost access to the old org, no longer assigned there.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("old org access: got %d want 404", code)
+	}
+	_, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" {
+		t.Fatalf("task still assigned to %q", task.Assignee)
+	}
+	// Old memberships must not resurface if the user returns to acme.
+	if code, _ := do(t, h, "POST", "/orgs/globex/users/ben/transfer", "gus", `{"toOrgId":"acme"}`); code != 403 {
+		t.Fatalf("non-admin globex transfer: got %d want 403", code)
+	}
+}
+
+func TestTransferDropsOrgAdmin(t *testing.T) {
+	h := newServer()
+	// eve (org admin) transfers herself out; admin status must not carry over.
+	if code, body := do(t, h, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatal(code, body)
+	}
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "eve", ""); code != 404 {
+		t.Fatalf("carried-over admin read: got %d want 404", code)
+	}
+}
