+func TestMoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager of both", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 200},
+		{"manager of source only", "ann", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"manager of destination only", "ivy", "/projects/ops/members/cat/move", `{"toProjectId":"legacy"}`, 404},
+		{"contributor", "ben", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin", "eve", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"non member", "hal", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 401},
+		{"missing destination field", "ivy", "/projects/web/members/ben/move", `{}`, 400},
+		{"unknown destination", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"nope"}`, 404},
+		{"other org destination", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"gx"}`, 404},
+		{"archived source", "ann", "/projects/legacy/members/ben/move", `{"toProjectId":"web"}`, 409},
+		{"not a member of source", "ivy", "/projects/web/members/hal/move", `{"toProjectId":"ops"}`, 404},
+		{"already in destination", "ivy", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 400},
+		{"same project", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"web"}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestMoveMemberEffects(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/members/dan/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got map[string]string
+	json.Unmarshal([]byte(body), &got)
+	if got["userId"] != "dan" || got["projectId"] != "ops" || got["role"] != "viewer" {
+		t.Fatalf("unexpected response %v", got)
+	}
+	// dan left web (404) and can read ops (200).
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "dan", ""); code != 404 {
+		t.Fatalf("dan still reads web: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "dan", ""); code != 200 {
+		t.Fatalf("dan cannot read ops: %d", code)
+	}
+
+	// Moving ben unassigns his task t1 in web.
+	if code, body := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`); code != 200 {
+		t.Fatal(code, body)
+	}
+	_, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.AssigneeID != "" {
+		t.Fatalf("t1 still assigned to %q", task.AssigneeID)
+	}
+}
