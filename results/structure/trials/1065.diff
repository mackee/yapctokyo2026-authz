+
+// RemoveFromOrg removes the user from every project of the organization (the
+// user's memberships in the organization's projects), in one transaction. It
+// is idempotent: a user with no memberships there is left as is. Archived
+// projects are included: removing a member is not a task write, and offboarding
+// must reach every project. The user must belong to the organization
+// (otherwise ErrNotFound); only org admins may do this (else ErrForbidden).
+func (*UserTable) RemoveFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanManageUsers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveOrgUser(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
