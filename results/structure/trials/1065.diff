+func TestRemoveOrgUserRemovesMemberships(t *testing.T) {
+	h := newServer()
+	// ben is a contributor in web and legacy (archived), and is assigned t1 (web) and t5 (legacy).
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("before: ben reads web: got %d", code)
+	}
+	if code, body := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d body=%s", code, body)
+	}
+	for _, path := range []string{"/projects/web/tasks", "/projects/web/tasks/t1", "/projects/legacy/tasks", "/projects/legacy/tasks/t5"} {
+		if code, _ := do(t, h, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("after: ben GET %s: got %d want 404", path, code)
+		}
+	}
+	// The tasks stay, unassigned; other members' assignments are untouched.
+	for path, want := range map[string]string{"/projects/web/tasks/t1": "", "/projects/legacy/tasks/t5": ""} {
+		code, body := do(t, h, "GET", path, "ann", "")
+		if code != 200 {
+			t.Fatalf("GET %s: got %d", path, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.AssigneeID != want {
+			t.Fatalf("%s assignee = %q, want %q", path, task.AssigneeID, want)
+		}
+	}
+	if code, body := do(t, h, "GET", "/projects/web/tasks/t2", "ann", ""); code != 200 || !strings.Contains(body, `"assignee":"cat"`) {
+		t.Fatalf("t2 should still be assigned to cat: %d %s", code, body)
+	}
+	// Removing again is a no-op that still succeeds.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("second remove: got %d want 204", code)
+	}
+}
