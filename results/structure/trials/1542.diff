+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager removes", "ann", "/projects/web/members/dan", 204},
+		{"manager removes assignee", "ann", "/projects/web/members/ben", 204},
+		{"manager removes self", "ann", "/projects/web/members/ann", 204},
+		{"contributor", "ben", "/projects/web/members/dan", 403},
+		{"viewer", "dan", "/projects/web/members/ben", 403},
+		{"org admin", "eve", "/projects/web/members/dan", 403},
+		{"non member caller", "hal", "/projects/web/members/dan", 404},
+		{"other org", "gus", "/projects/web/members/dan", 404},
+		{"target not a member", "ann", "/projects/web/members/hal", 404},
+		{"archived", "ann", "/projects/legacy/members/ben", 409},
+		{"anonymous", "", "/projects/web/members/dan", 401},
+		{"missing project", "ann", "/projects/nope/members/dan", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveMemberEffects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 204 {
+		t.Fatal(code)
+	}
+	// ben lost access and his task is unassigned.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("removed member still has access: %d", code)
+	}
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatal(code)
+	}
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" {
+		t.Fatalf("assignee = %q, want unassigned", task.Assignee)
+	}
+	// Other projects are untouched: ben is still in legacy with t5.
+	code, body = do(t, h, "GET", "/projects/legacy/tasks/t5", "ann", "")
+	json.Unmarshal([]byte(body), &task)
+	if code != 200 || task.Assignee != "ben" {
+		t.Fatalf("legacy task changed: %d %q", code, task.Assignee)
+	}
+	// Removing again: no longer a member.
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 404 {
+		t.Fatalf("second removal got %d want 404", code)
+	}
+}
