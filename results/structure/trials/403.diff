+// moveTaskAggregate moves one task to another project. The task keeps its ID,
+// title, status and assignee, so the assignee must be a contributor or manager
+// of the destination project.
+type moveTaskAggregate struct {
+	task     *Task
+	dest     *Project
+	assignee *Membership // dest.Membership(assignee); nil when the task is unassigned
+}
+
+func loadMoveTask(ctx context.Context, x *Tx, taskID, toProjectID string) (*moveTaskAggregate, error) {
+	t, err := NewTaskTable().Find(ctx, x, taskID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	p, err := NewProjectTable().Find(ctx, x, toProjectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveTaskAggregate{task: t, dest: p}
+	if t.AssigneeID != "" {
+		m, err := p.Membership(ctx, x, t.AssigneeID)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "assignee must be a contributor or manager of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		a.assignee = m
+	}
+	return a, nil
+}
+
+func (a *moveTaskAggregate) validate() error {
+	if a.assignee != nil && !isWriterRole(a.assignee.Role) {
+		return deny(ErrInvalid, "assignee must be a contributor or manager of the project")
+	}
+	return nil
+}
+
+func (a *moveTaskAggregate) apply(ctx context.Context, x *Tx) (*Task, error) {
+	if err := a.task.moveTo(ctx, x, a.dest.ID); err != nil {
+		return nil, err
+	}
+	return a.task, nil
+}
+
