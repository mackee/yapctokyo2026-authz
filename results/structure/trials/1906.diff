diff --git a/org_test.go b/org_test.go
new file mode 100644
index 0000000..a786aed
--- /dev/null
+++ b/org_test.go
@@ -0,0 +1,106 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes user without projects", "eve", "/orgs/acme/users/hal", 204},
+		{"project manager", "ann", "/orgs/acme/users/ben", 403},
+		{"plain member", "hal", "/orgs/acme/users/ben", 403},
+		{"other org", "gus", "/orgs/acme/users/ben", 404},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown user", "zed", "/orgs/acme/users/ben", 401},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ben", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserRemovesAllProjectMemberships(t *testing.T) {
+	h := newServer()
+	// ben is a member of web and legacy (archived) before.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("before: web got %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/legacy/tasks", "ben", ""); code != 200 {
+		t.Fatalf("before: legacy got %d", code)
+	}
+
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove got %d", code)
+	}
+
+	for _, p := range []string{"web", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ben", ""); code != 404 {
+			t.Fatalf("after: %s got %d want 404", p, code)
+		}
+	}
+}
+
+func TestRemoveOrgUserUnassignsTheirTasks(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove got %d", code)
+	}
+	// t1 (web) and t5 (legacy, archived) were assigned to ben.
+	for _, path := range []string{"/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		code, body := do(t, h, "GET", path, "ann", "")
+		if code != 200 {
+			t.Fatalf("%s got %d", path, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.AssigneeID != "" {
+			t.Fatalf("%s still assigned to %q", path, task.AssigneeID)
+		}
+	}
+	// Other people's tasks are untouched.
+	code, body := do(t, h, "GET", "/projects/web/tasks/t2", "ann", "")
+	if code != 200 {
+		t.Fatal(code)
+	}
+	var t2 Task
+	json.Unmarshal([]byte(body), &t2)
+	if t2.AssigneeID != "cat" {
+		t.Fatalf("t2 assignee changed to %q", t2.AssigneeID)
+	}
+}
+
+func TestRemoveOrgUserKeepsOthers(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove got %d", code)
+	}
+	for _, user := range []string{"ann", "cat", "dan"} {
+		if code, _ := do(t, h, "GET", "/projects/web/tasks", user, ""); code != 200 {
+			t.Fatalf("%s lost access: %d", user, code)
+		}
+	}
+}
+
+func TestRemoveOrgUserDeniedChangesNothing(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "ann", ""); code != 403 {
+		t.Fatalf("got %d want 403", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben lost access after a denied request: %d", code)
+	}
+}
