index e558654..aa4880d 100644
--- a/internal/model/aggregate.go
+++ b/internal/model/aggregate.go
@@ -126,6 +126,54 @@ func (a *updateTaskAggregate) apply(ctx context.Context, tx DB) (*Task, error) {
 	return t, nil
 }
 
+// removeOrgUserAggregate takes one user out of every project of their
+// organization. Tasks assigned to the user are unassigned first, so that the
+// assignee rule holds once the memberships are gone. Archived projects are
+// included: this is an organization-level operation, not a project write.
+type removeOrgUserAggregate struct {
+	user        *User
+	memberships []*Membership
+	assigned    map[string][]*Task // project ID -> the user's tasks there
+}
+
+func loadRemoveOrgUser(ctx context.Context, tx DB, orgID, userID string) (*removeOrgUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) || (err == nil && u.Org != orgID) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	a := &removeOrgUserAggregate{user: u, memberships: ms, assigned: map[string][]*Task{}}
+	for _, m := range ms {
+		ts, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.assigned[m.ProjectID] = ts
+	}
+	return a, nil
+}
+
+func (a *removeOrgUserAggregate) validate() error { return nil }
+
+func (a *removeOrgUserAggregate) apply(ctx context.Context, tx DB) error {
+	for _, m := range a.memberships {
+		for _, t := range a.assigned[m.ProjectID] {
+			if err := t.unassign(ctx, tx); err != nil {
+				return err
+			}
+		}
+		if err := m.destroy(ctx, tx); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
