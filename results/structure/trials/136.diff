@@ -275,6 +284,74 @@ func (p *writeProject) CreateTask(title string, assignee Assignee) (TaskView, er
 	return v, err
 }
 
+// Manage applies the member-management rule: readable, manager only (else 403),
+// not archived (else 409).
+func (s *projectScope) Manage() (ManageProject, error) {
+	err := s.as.a.st.read(func(st *state) error {
+		p, r, err := readable(st, s.as.actor, s.pid)
+		if err != nil {
+			return err
+		}
+		if r != RoleManager {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if p.archived {
+			return deny(ErrArchived, "project is archived")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &manageProject{ps: s}, nil
+}
+
+// ManageProject may change the roles of existing members of one project.
+type ManageProject interface {
+	// SetRoles changes the roles of the given members (userID -> role) as one
+	// all-or-nothing change. Every user must already be a member of the project
+	// and every role must be valid; otherwise it returns ErrInvalid and changes
+	// nothing. It returns the members of the project after the change, sorted
+	// by user ID.
+	SetRoles(roles map[string]string) ([]MemberView, error)
+}
+
+type manageProject struct{ ps *projectScope }
+
+func (p *manageProject) SetRoles(roles map[string]string) ([]MemberView, error) {
+	if len(roles) == 0 {
+		return nil, deny(ErrInvalid, "roles must not be empty")
+	}
+	uids := make([]string, 0, len(roles))
+	for uid := range roles {
+		uids = append(uids, uid)
+	}
+	sort.Strings(uids)
+	for _, uid := range uids {
+		if !isRole(roles[uid]) {
+			return nil, deny(ErrInvalid, fmt.Sprintf("invalid role for %s", uid))
+		}
+	}
+	var out []MemberView
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		m := s.members[p.ps.pid]
+		for _, uid := range uids {
+			if _, ok := m[uid]; !ok {
+				return deny(ErrInvalid, fmt.Sprintf("%s is not a member of the project", uid))
+			}
+		}
+		for _, uid := range uids {
+			m[uid] = roles[uid]
+		}
+		out = s.membersIn(p.ps.pid)
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return out, nil
+}
+
