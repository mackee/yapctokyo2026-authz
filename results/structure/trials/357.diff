+func TestMoveMember(t *testing.T) {
+	const dan = "/projects/web/members/dan/move"
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager of both moves", "ivy", dan, `{"toProjectId":"ops"}`, 200},
+		{"actor only viewer of target", "ann", dan, `{"toProjectId":"ops"}`, 403},
+		{"contributor source", "ben", dan, `{"toProjectId":"ops"}`, 403},
+		{"org admin", "eve", dan, `{"toProjectId":"ops"}`, 403},
+		{"non member", "hal", dan, `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", dan, `{"toProjectId":"ops"}`, 401},
+		{"archived source", "ann", "/projects/legacy/members/ben/move", `{"toProjectId":"web"}`, 409},
+		{"archived target", "ann", dan, `{"toProjectId":"legacy"}`, 409},
+		{"unknown target", "ivy", dan, `{"toProjectId":"nope"}`, 404},
+		{"target in other org", "ivy", dan, `{"toProjectId":"gx"}`, 404},
+		{"same project", "ivy", dan, `{"toProjectId":"web"}`, 400},
+		{"not a member of source", "ivy", "/projects/web/members/hal/move", `{"toProjectId":"ops"}`, 404},
+		{"already in target", "ivy", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 400},
+		{"tasks still assigned", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 400},
+		{"missing target", "ivy", dan, `{}`, 400},
+		{"bad body", "ivy", dan, `nope`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestMoveMemberTransfers(t *testing.T) {
+	srv := newServer()
+
+	// ben still owns t1 in web, so the move is refused and nothing changes.
+	if code, body := do(t, srv, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`); code != 400 {
+		t.Fatalf("got %d want 400: %s", code, body)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben lost web membership after refused move: %d", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben joined ops after refused move: %d", code)
+	}
+
+	// Reassign t1, then the move goes through with the same role.
+	if code, body := do(t, srv, "PATCH", "/projects/web/tasks/t1", "ivy", `{"assignee":"ivy"}`); code != 200 {
+		t.Fatalf("reassign: got %d: %s", code, body)
+	}
+	code, body := do(t, srv, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d: %s", code, body)
+	}
+	var got struct {
+		UserID    string `json:"userId"`
+		ProjectID string `json:"projectId"`
+		Role      string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.UserID != "ben" || got.ProjectID != "ops" || got.Role != "contributor" {
+		t.Fatalf("unexpected response: %s", body)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben still reads web after move: %d", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben cannot read ops after move: %d", code)
+	}
+	// The moved contributor can write in the new project.
+	if code, body := do(t, srv, "POST", "/projects/ops/tasks", "ben", `{"title":"x","assignee":"ben"}`); code != 201 {
+		t.Fatalf("create in ops: got %d: %s", code, body)
+	}
+}
