+// ManageProject may change the membership of one project. Managers only.
+type ManageProject interface {
+	ReadProject
+	// MoveMember removes userID from this project and adds them to target with
+	// the same role. target must be acquired from ActorScope.Project(target).Manage(),
+	// so the actor must manage both projects.
+	MoveMember(userID string, target ManageProject) (MemberView, error)
+}
+
+type manageProject struct{ readProject }
+
+func (p *manageProject) MoveMember(userID string, target ManageProject) (MemberView, error) {
+	to, ok := target.(*manageProject)
+	if !ok {
+		return MemberView{}, deny(ErrInvalid, "invalid target project")
+	}
+	var v MemberView
+	err := p.ps.as.a.db.update(func(x *tx) error {
+		agg, err := loadMoveMember(x, p.ps.pid, to.ps.pid, userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		v = agg.save(x)
+		return nil
+	})
+	return v, err
+}
