+// moveMemberAggregate removes one member from the source project and adds them
+// to the target project with the same role.
+type moveMemberAggregate struct {
+	user     userRecord
+	to       projectRecord
+	from     membershipRecord // the membership being removed
+	moved    membershipRecord // the membership being added
+	assigned int              // tasks in the source project still assigned to the user
+}
+
+func loadMoveMember(x *tx, fromID, toID, userID string) (*moveMemberAggregate, error) {
+	if fromID == toID {
+		return nil, deny(ErrInvalid, "target project must be a different project")
+	}
+	to, ok := x.findProject(toID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	u, ok := x.findUser(userID)
+	if !ok {
+		return nil, deny(ErrNotFound, "member not found")
+	}
+	from, ok := x.findMembership(fromID, userID)
+	if !ok {
+		return nil, deny(ErrNotFound, "member not found")
+	}
+	if _, ok := x.findMembership(toID, userID); ok {
+		return nil, deny(ErrInvalid, "user is already a member of the target project")
+	}
+	a := &moveMemberAggregate{
+		user:  u,
+		to:    to,
+		from:  from,
+		moved: membershipRecord{ProjectID: toID, UserID: userID, Role: from.Role},
+	}
+	for _, t := range x.tasksIn(fromID) {
+		if t.AssigneeID == userID {
+			a.assigned++
+		}
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.user.Org != a.to.Org {
+		return deny(ErrInvalid, "project members must belong to the project's organization")
+	}
+	if a.assigned > 0 {
+		return deny(ErrInvalid, "member still has tasks assigned in this project; reassign them first")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) save(x *tx) MemberView {
+	a.from.destroy(x)
+	a.moved.save(x)
+	return MemberView{UserID: a.moved.UserID, ProjectID: a.moved.ProjectID, Role: a.moved.Role}
+}
