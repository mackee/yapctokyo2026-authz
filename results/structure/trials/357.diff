+// Manage applies the membership rule: readable, manager only (else 403), not
+// archived (else 409). Moving a member also touches a second project; that
+// project is checked by its own Manage acquisition (see MoveMember).
+func (s *projectScope) Manage() (ManageProject, error) {
+	err := s.as.a.db.view(func(x *tx) error {
+		p, r, err := readable(x, s.as.actor, s.pid)
+		if err != nil {
+			return err
+		}
+		if r != RoleManager {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if p.Archived {
+			return deny(ErrArchived, "project is archived")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &manageProject{readProject: readProject{ps: s}}, nil
+}
