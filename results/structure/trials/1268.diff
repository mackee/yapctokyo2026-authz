+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin non member", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"archived", "ann", "legacy", 409},
+		{"missing project", "ann", "nope", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeEffect(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got []struct{ UserID, Role string }
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 5 {
+		t.Fatalf("want 5 members, got %s", body)
+	}
+	for _, m := range got {
+		if m.Role != "viewer" {
+			t.Fatalf("%s is %s", m.UserID, m.Role)
+		}
+	}
+	if !strings.Contains(body, `"userId":"ann"`) || !strings.Contains(body, `"role":"viewer"`) {
+		t.Fatalf("unexpected shape: %s", body)
+	}
+
+	// Nobody can change tasks any more, but everybody can still read.
+	for _, user := range []string{"ann", "ivy", "ben", "cat", "dan"} {
+		for _, c := range []struct{ method, path, body string }{
+			{"POST", "/projects/web/tasks", `{"title":"x"}`},
+			{"PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+			{"DELETE", "/projects/web/tasks/t3", ""},
+			{"POST", "/projects/web/freeze", ""},
+		} {
+			if code, _ := do(t, h, c.method, c.path, user, c.body); code != 403 {
+				t.Fatalf("%s %s %s: got %d want 403", user, c.method, c.path, code)
+			}
+		}
+		if code, _ := do(t, h, "GET", "/projects/web/tasks", user, ""); code != 200 {
+			t.Fatalf("%s read: %d", user, code)
+		}
+	}
+
+	// Other projects are untouched.
+	if code, _ := do(t, h, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ops affected: %d", code)
+	}
+	// Assignees are cleared, keeping "assignee is a contributor or manager".
+	_, body = do(t, h, "GET", "/projects/web/tasks", "ann", "")
+	var tasks []Task
+	json.Unmarshal([]byte(body), &tasks)
+	for _, task := range tasks {
+		if task.AssigneeID != "" {
+			t.Fatalf("task %s still assigned to %s", task.ID, task.AssigneeID)
+		}
+	}
+}
