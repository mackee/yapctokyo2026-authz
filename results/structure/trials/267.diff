diff --git a/internal/capability/capability.go b/internal/capability/capability.go
index ab5f720..f931c7f 100644
--- a/internal/capability/capability.go
+++ b/internal/capability/capability.go
@@ -111,6 +111,93 @@ func (a *Authorizer) Authenticate(userID string) (ActorScope, error) {
 type ActorScope interface {
 	Actor() Actor
 	Project(projectID string) ProjectScope
+	Org(orgID string) OrgScope
+}
+
+// OrgScope is bound to one actor and one organization ID.
+type OrgScope interface {
+	// Admin acquires the org-admin capability: the org is the actor's own
+	// (else 404) and the actor is an org admin (else 403).
+	Admin() (AdminOrg, error)
+}
+
+// AdminOrg may manage the users of one organization.
+type AdminOrg interface {
+	ID() string
+	// TransferUser moves a user of this organization to another existing
+	// organization (group-company transfer). The user loses org admin rights and
+	// all project memberships in this organization, and tasks assigned to them
+	// there become unassigned. Returns the user's ID and new organization.
+	TransferUser(userID, toOrgID string) (UserView, error)
+}
+
+// UserView is the public representation of a user.
+type UserView struct {
+	ID    string `json:"id"`
+	OrgID string `json:"orgId"`
+}
+
+type orgScope struct {
+	as  *actorScope
+	oid string
+}
+
+func (s *orgScope) Admin() (AdminOrg, error) {
+	err := s.as.a.st.read(func(st *state) error {
+		if !st.orgExists(s.oid) || s.as.actor.org != s.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		if !s.as.actor.orgAdmin {
+			return deny(ErrForbidden, "forbidden")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &adminOrg{os: s}, nil
+}
+
+type adminOrg struct{ os *orgScope }
+
+func (o *adminOrg) ID() string { return o.os.oid }
+
+func (o *adminOrg) TransferUser(userID, toOrgID string) (UserView, error) {
+	if toOrgID == "" {
+		return UserView{}, deny(ErrInvalid, "toOrgId is required")
+	}
+	var v UserView
+	err := o.os.as.a.st.tx(func(s *state) error {
+		u, ok := s.users[userID]
+		if !ok || u.org != o.os.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		if !s.orgExists(toOrgID) {
+			return deny(ErrInvalid, "unknown destination organization")
+		}
+		if toOrgID == u.org {
+			return deny(ErrInvalid, "user already belongs to that organization")
+		}
+		// Memberships and assignments are tied to the old organization's
+		// projects; drop them so the model invariants hold in the new org.
+		for pid, members := range s.members {
+			if _, isMember := members[userID]; isMember && s.projects[pid].org != toOrgID {
+				delete(members, userID)
+			}
+		}
+		for id, t := range s.tasks {
+			if t.assignee.user == userID && s.projects[t.project].org != toOrgID {
+				t.assignee = Assignee{project: t.project}
+				s.tasks[id] = t
+			}
+		}
+		u.org = toOrgID
+		u.orgAdmin = false
+		s.users[userID] = u
+		v = UserView{ID: u.id, OrgID: u.org}
+		return nil
+	})
+	return v, err
 }
 
