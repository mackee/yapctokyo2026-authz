+// orgRegistry is the handler-visible surface under /orgs/{oid}.
+type orgRegistry struct {
+	scope capability.OrgScope
+}
+
+func orgTransformer(authz *capability.Authorizer) tanukirpc.Transformer[*rootRegistry, *orgRegistry] {
+	return tanukirpc.NewTransformer(func(ctx tanukirpc.Context[*rootRegistry]) (*orgRegistry, error) {
+		actor, err := authz.Authenticate(ctx.Request().Header.Get("X-User"))
+		if err != nil {
+			return nil, err
+		}
+		return &orgRegistry{scope: actor.Org(chi.URLParam(ctx.Request(), "oid"))}, nil
+	})
+}
+
+type transferRequest struct {
+	ToOrgID string `json:"toOrgId"`
+}
+
+func transferUser(ctx tanukirpc.Context[*orgRegistry], _ struct{}) (*capability.UserView, error) {
+	o, err := ctx.Registry().scope.Admin()
+	if err != nil {
+		return nil, err
+	}
+	var req transferRequest
+	if err := decodeBody(ctx.Request(), &req); err != nil || req.ToOrgID == "" {
+		return nil, errInvalidBody
+	}
+	v, err := o.TransferUser(chi.URLParam(ctx.Request(), "uid"), req.ToOrgID)
+	if err != nil {
+		return nil, err
+	}
+	return &v, nil
+}
+
