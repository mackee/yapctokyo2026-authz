+// orgExists reports whether any user or project belongs to the organization.
+func (s *state) orgExists(org string) bool {
+	for _, u := range s.users {
+		if u.org == org {
+			return true
+		}
+	}
+	for _, p := range s.projects {
+		if p.org == org {
+			return true
+		}
+	}
+	return false
