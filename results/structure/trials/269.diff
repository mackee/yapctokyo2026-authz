+// ---- organization capabilities -------------------------------------------------
+
+// OrgScope is bound to one actor and one organization ID.
+type OrgScope interface {
+	ID() string
+	Admin() (AdminOrg, error)
+}
+
+// AdminOrg may manage the users of one organization (org admins only).
+type AdminOrg interface {
+	ID() string
+	// TransferUser moves a user of this organization to another existing
+	// organization. The user loses their project memberships and org-admin
+	// status, and is unassigned from their tasks in this organization.
+	TransferUser(userID, toOrgID string) (UserView, error)
+}
+
+// UserView is the public representation of a user.
+type UserView struct {
+	ID    string `json:"id"`
+	OrgID string `json:"orgId"`
+}
+
+type orgScope struct {
+	as  *actorScope
+	oid string
+}
+
+func (s *orgScope) ID() string { return s.oid }
+
+// Admin applies the org-admin rule: the org must be the actor's own (else 404)
+// and the actor must be an org admin of it (else 403).
+func (s *orgScope) Admin() (AdminOrg, error) {
+	act := s.as.actor
+	if act.org != s.oid {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if !act.orgAdmin {
+		return nil, deny(ErrForbidden, "forbidden")
+	}
+	return &adminOrg{os: s}, nil
+}
+
+type adminOrg struct{ os *orgScope }
+
+func (o *adminOrg) ID() string { return o.os.oid }
+
+func (o *adminOrg) TransferUser(userID, toOrgID string) (UserView, error) {
+	var v UserView
+	err := o.os.as.a.st.tx(func(s *state) error {
+		u, ok := s.users[userID]
+		if !ok || u.org != o.os.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		if toOrgID == "" || toOrgID == u.org || !s.orgExists(toOrgID) {
+			return deny(ErrInvalid, "invalid destination organization")
+		}
+		for pid, m := range s.members {
+			if s.projects[pid].org == u.org {
+				delete(m, userID)
+			}
+		}
+		for id, t := range s.tasks {
+			if t.assignee.user == userID && s.projects[t.project].org == u.org {
+				t.assignee = Assignee{project: t.project}
+				s.tasks[id] = t
+			}
+		}
+		u.org, u.orgAdmin = toOrgID, false
+		s.users[userID] = u
+		v = UserView{ID: u.id, OrgID: u.org}
+		return nil
+	})
+	return v, err
+}
+
