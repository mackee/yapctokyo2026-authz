--- /dev/null
+++ b/freeze_test.go
@@ -0,0 +1,67 @@
+package main
+
+import "testing"
+
+func TestFreeze(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	want := `[{"userId":"ann","role":"viewer"},{"userId":"ben","role":"viewer"},{"userId":"cat","role":"viewer"},{"userId":"dan","role":"viewer"},{"userId":"ivy","role":"viewer"}]` + "\n"
+	if body != want {
+		t.Fatalf("body=%s want=%s", body, want)
+	}
+
+	// Nobody can change tasks any more, managers included.
+	writes := []struct{ user, method, path, body string }{
+		{"ann", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"ivy", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"ann", "DELETE", "/projects/web/tasks/t1", ""},
+		{"eve", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+	}
+	for _, w := range writes {
+		if code, b := do(t, h, w.method, w.path, w.user, w.body); code != 403 {
+			t.Fatalf("%s %s by %s: got %d body=%s", w.method, w.path, w.user, code, b)
+		}
+	}
+	// Reads still work, and other projects are untouched.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "dan", ""); code != 200 {
+		t.Fatalf("read after freeze: %d", code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`); code != 200 {
+		t.Fatalf("other project: %d", code)
+	}
+	// A second freeze is forbidden: the caller is now a viewer.
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 403 {
+		t.Fatalf("refreeze: %d", code)
+	}
+}
+
+func TestFreezeDenied(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"contributor", "ben", "/projects/web/freeze", 403},
+		{"viewer", "dan", "/projects/web/freeze", 403},
+		{"org admin non-member", "eve", "/projects/web/freeze", 403},
+		{"non member", "hal", "/projects/web/freeze", 404},
+		{"other org", "gus", "/projects/web/freeze", 404},
+		{"anonymous", "", "/projects/web/freeze", 401},
+		{"archived", "ann", "/projects/legacy/freeze", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			if code, b := do(t, h, "POST", c.path, c.user, ""); code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, b)
+			}
+			// A denied freeze changes nothing.
+			if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t2", "ann", `{"status":"done"}`); code != 200 {
+				t.Fatalf("manager lost write access: %d", code)
+			}
+		})
+	}
+}
