+// Freeze makes every member of the project (managers included) a viewer and
+// returns the resulting memberships, all or nothing.
+func (pt *ProjectTable) Freeze(ctx context.Context, db DB, authz ProjectAuthz) ([]*Membership, error) {
+	if err := authz.CanFreeze(); err != nil {
+		return nil, err
+	}
+	var ms []*Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		var err error
+		if ms, err = NewMembershipTable().ListByProject(ctx, tx, authz.ProjectID()); err != nil {
+			return err
+		}
+		for _, m := range ms {
+			if err := m.setRole(ctx, tx, RoleViewer); err != nil {
+				return err
+			}
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return ms, nil
+}
