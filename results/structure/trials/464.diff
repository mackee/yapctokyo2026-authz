+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"archived", "ann", "legacy", 409},
+		{"missing project", "ann", "nope", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeReturnsViewers(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got []struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []string{"ann", "ben", "cat", "dan", "ivy"}
+	if len(got) != len(want) {
+		t.Fatalf("got %d members, want %d: %s", len(got), len(want), body)
+	}
+	for i, m := range got {
+		if m.UserID != want[i] || m.Role != "viewer" {
+			t.Fatalf("member %d: got %+v, want {%s viewer}", i, m, want[i])
+		}
+	}
+}
+
+func TestFreezeBlocksTaskWrites(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze got %d: %s", code, body)
+	}
+	cases := []struct {
+		name, method, path, user, body string
+	}{
+		{"manager create", "POST", "/projects/web/tasks", "ann", `{"title":"x"}`},
+		{"contributor create", "POST", "/projects/web/tasks", "ben", `{"title":"x"}`},
+		{"contributor update own", "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`},
+		{"manager update", "PATCH", "/projects/web/tasks/t2", "ann", `{"status":"done"}`},
+		{"manager reassign", "PATCH", "/projects/web/tasks/t2", "ivy", `{"assignee":"ben"}`},
+		{"manager delete", "DELETE", "/projects/web/tasks/t1", "ann", ""},
+		{"org admin delete", "DELETE", "/projects/web/tasks/t1", "eve", ""},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, srv, c.method, c.path, c.user, c.body)
+			if code != 403 {
+				t.Fatalf("got %d want 403", code)
+			}
+		})
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks/t1", "dan", ""); code != 200 {
+		t.Fatalf("reads should still work, got %d", code)
+	}
+}
+
+func TestFreezeIsScoped(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatal("freeze failed")
+	}
+	// No manager is left in web, so a second freeze is refused.
+	if code, _ := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != 403 {
+		t.Fatalf("second freeze by now-viewer ann got %d want 403", code)
+	}
+	// ivy was demoted in web but remains manager of ops, which is not frozen.
+	if code, body := do(t, srv, "POST", "/projects/ops/tasks", "ivy", `{"title":"x"}`); code != 200 {
+		t.Fatalf("other project write got %d: %s", code, body)
+	}
+}
