+func TestSetMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager promotes", "ann", "/projects/web/members/ben", `{"role":"manager"}`, 200},
+		{"manager demotes manager", "ann", "/projects/web/members/ivy", `{"role":"viewer"}`, 200},
+		{"contributor cannot change roles", "ben", "/projects/web/members/cat", `{"role":"viewer"}`, 403},
+		{"viewer cannot change roles", "dan", "/projects/web/members/cat", `{"role":"viewer"}`, 403},
+		{"org admin cannot change roles", "eve", "/projects/web/members/cat", `{"role":"viewer"}`, 403},
+		{"non member", "hal", "/projects/web/members/cat", `{"role":"viewer"}`, 404},
+		{"other org", "gus", "/projects/web/members/cat", `{"role":"viewer"}`, 404},
+		{"anonymous", "", "/projects/web/members/cat", `{"role":"viewer"}`, 401},
+		{"unknown user", "zed", "/projects/web/members/cat", `{"role":"viewer"}`, 401},
+		{"project missing", "ann", "/projects/nope/members/cat", `{"role":"viewer"}`, 404},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"manager"}`, 409},
+		{"invalid role", "ann", "/projects/web/members/ben", `{"role":"owner"}`, 400},
+		{"empty role", "ann", "/projects/web/members/ben", `{"role":""}`, 400},
+		{"invalid body", "ann", "/projects/web/members/ben", `nope`, 400},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"target in other project", "ann", "/projects/web/members/gus", `{"role":"viewer"}`, 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestSetMemberRoleResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got memberRoleResponse
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.UserID != "ben" || got.Role != "viewer" {
+		t.Fatalf("got %+v", got)
+	}
+}
+
+func TestSetMemberRolePersists(t *testing.T) {
+	h := newServer()
+	// ivy is a manager of web: she may patch any task.
+	if code, body := do(t, h, "PATCH", "/projects/web/tasks/t2", "ivy", `{"status":"done"}`); code != 200 {
+		t.Fatalf("before demotion: got %d body=%s", code, body)
+	}
+	// ann demotes ivy to viewer.
+	if code, body := do(t, h, "PUT", "/projects/web/members/ivy", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote: got %d body=%s", code, body)
+	}
+	// ivy is no longer a manager: writes are forbidden now.
+	if code, body := do(t, h, "PATCH", "/projects/web/tasks/t2", "ivy", `{"status":"open"}`); code != 403 {
+		t.Fatalf("after demotion: got %d body=%s", code, body)
+	}
+	// ivy cannot change roles any more either.
+	if code, body := do(t, h, "PUT", "/projects/web/members/ben", "ivy", `{"role":"manager"}`); code != 403 {
+		t.Fatalf("demoted manager changing role: got %d body=%s", code, body)
+	}
+	// ben is promoted: he may now delete tasks.
+	if code, body := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"manager"}`); code != 200 {
+		t.Fatalf("promote: got %d body=%s", code, body)
+	}
+	if code, body := do(t, h, "DELETE", "/projects/web/tasks/t3", "ben", ""); code != 204 {
+		t.Fatalf("promoted manager delete: got %d body=%s", code, body)
+	}
+}
