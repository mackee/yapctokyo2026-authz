+
+// TaskTableMoveInput is the input of TaskTable.Move.
+type TaskTableMoveInput struct {
+	ToProjectID string
+}
+
+// Move moves the task to another project. The task keeps its ID, title,
+// status and assignee, so its assignee must already be a contributor or
+// manager of the target project (else ErrInvalid).
+//
+// The actor must be able to edit the task in its current project (CanEdit),
+// and must be able to write tasks in the target project (CanWrite there). A
+// target the actor cannot read is ErrNotFound.
+func (*TaskTable) Move(ctx context.Context, db DB, authz TaskAuthz, in TaskTableMoveInput) (*Task, error) {
+	if err := authz.CanEdit(); err != nil {
+		return nil, err
+	}
+	if in.ToProjectID == authz.Project().ProjectID() {
+		return nil, deny(ErrInvalid, "task is already in that project")
+	}
+	var t *Task
+	if err := inTx(ctx, db, func(tx DB) error {
+		target, err := NewProjectAuthz(ctx, tx, authz.Project().Actor(), in.ToProjectID)
+		if err != nil {
+			return err
+		}
+		if err := target.CanWrite(); err != nil {
+			return err
+		}
+		agg, err := loadMoveTask(ctx, tx, authz.TaskID(), in.ToProjectID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if t, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return t, nil
+}
