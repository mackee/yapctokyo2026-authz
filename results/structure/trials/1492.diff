diff --git a/move_test.go b/move_test.go
new file mode 100644
index 0000000..b5c7f9f
--- /dev/null
+++ b/move_test.go
@@ -0,0 +1,89 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager moves any task", "ivy", "/projects/ops/tasks/t4", `{"toProjectId":"web"}`, 200},
+		{"contributor own, writer in target", "cat", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 200},
+		{"unassigned task", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 200},
+		{"contributor others", "ben", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 403},
+		{"viewer", "dan", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"org admin", "eve", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"non member", "hal", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 404},
+		{"cross project id", "ivy", "/projects/ops/tasks/t1", `{"toProjectId":"web"}`, 404},
+		{"target viewer", "ann", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 403},
+		{"target archived", "ann", "/projects/web/tasks/t2", `{"toProjectId":"legacy"}`, 409},
+		{"source archived", "ann", "/projects/legacy/tasks/t5", `{"toProjectId":"ops"}`, 409},
+		{"target not readable by actor", "ben", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 404},
+		{"target in other org", "ann", "/projects/web/tasks/t1", `{"toProjectId":"gx"}`, 404},
+		{"target missing", "ann", "/projects/web/tasks/t1", `{"toProjectId":"nope"}`, 404},
+		{"assignee not in target", "ivy", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 400},
+		{"same project", "ann", "/projects/web/tasks/t2", `{"toProjectId":"web"}`, 400},
+		{"missing toProjectId", "ann", "/projects/web/tasks/t3", `{}`, 400},
+		{"malformed body", "ann", "/projects/web/tasks/t3", `{`, 400},
+		{"anonymous", "", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsTaskFields(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d: %s", code, body)
+	}
+	var got Task
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", AssigneeID: "cat"}
+	if got != want {
+		t.Fatalf("moved task = %+v, want %+v", got, want)
+	}
+
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t2", "ivy", ""); code != 404 {
+		t.Fatalf("old project still reaches the task: got %d", code)
+	}
+	code, body = do(t, h, "GET", "/projects/ops/tasks/t2", "ivy", "")
+	if code != 200 {
+		t.Fatalf("new project: got %d: %s", code, body)
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got != want {
+		t.Fatalf("task in new project = %+v, want %+v", got, want)
+	}
+}
+
+func TestFailedMoveChangesNothing(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/tasks/t1/move", "ivy", `{"toProjectId":"ops"}`); code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("task t1 left web: got %d", code)
+	}
+	var got Task
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.ProjectID != "web" || got.AssigneeID != "ben" {
+		t.Fatalf("task t1 changed: %+v", got)
+	}
+}
