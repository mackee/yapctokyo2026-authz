diff --git a/members.go b/members.go
new file mode 100644
index 0000000..1a6dea3
--- /dev/null
+++ b/members.go
@@ -0,0 +1,140 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"sort"
+)
+
+type member struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+var validRoles = map[string]bool{RoleManager: true, RoleContributor: true, RoleViewer: true}
+
+// updateMembers handles PUT /projects/{pid}/members with {"roles":{"<userId>":"<role>",...}}.
+// All the changes are applied in one transaction: if any of them is refused, none is
+// made. Only managers may change roles. The response is the project's member list
+// after the change.
+func (s *server) updateMembers(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role, err := findRole(ctx, s.db, project.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req struct {
+		Roles map[string]string `json:"roles"`
+	}
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || len(req.Roles) == 0 {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+
+	// Sorted so that the same request always reports the same first problem.
+	ids := make([]string, 0, len(req.Roles))
+	for id := range req.Roles {
+		ids = append(ids, id)
+	}
+	sort.Strings(ids)
+	for _, id := range ids {
+		newRole := req.Roles[id]
+		if !validRoles[newRole] {
+			writeError(w, 400, fmt.Sprintf("invalid role %q for %s", newRole, id))
+			return
+		}
+		current, err := findRole(ctx, tx, project.ID, id)
+		if err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+		if current == "" {
+			writeError(w, 400, fmt.Sprintf("%s is not a member of the project", id))
+			return
+		}
+		if newRole != RoleManager && newRole != RoleContributor {
+			// Assignees must stay contributors or managers, so a member who is
+			// still assigned tasks cannot be demoted to viewer.
+			var assigned int
+			if err := tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM tasks WHERE project_id = ? AND assignee = ?`, project.ID, id).Scan(&assigned); err != nil {
+				writeError(w, 500, "internal error")
+				return
+			}
+			if assigned > 0 {
+				writeError(w, 409, fmt.Sprintf("%s is assigned tasks and must stay a contributor or manager", id))
+				return
+			}
+		}
+		if _, err := tx.ExecContext(ctx, `UPDATE memberships SET role = ? WHERE project_id = ? AND user_id = ?`, newRole, project.ID, id); err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	members, err := listMembers(ctx, s.db, project.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, members)
+}
+
+func listMembers(ctx context.Context, q queryer, projectID string) ([]member, error) {
+	rows, err := q.QueryContext(ctx, `SELECT user_id, role FROM memberships WHERE project_id = ? ORDER BY user_id`, projectID)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	members := []member{}
+	for rows.Next() {
+		var m member
+		if err := rows.Scan(&m.UserID, &m.Role); err != nil {
+			return nil, err
+		}
+		members = append(members, m)
+	}
+	return members, rows.Err()
+}
