+package main
+
+import (
+	"encoding/json"
+	"reflect"
+	"testing"
+)
+
+func TestUpdateMembers(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager bulk change", "ann", "web", `{"roles":{"dan":"contributor","ivy":"viewer"}}`, 200},
+		{"manager demotes assignee", "ann", "web", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 409},
+		{"contributor caller", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer caller", "dan", "web", `{"roles":{"ivy":"viewer"}}`, 403},
+		{"org admin caller", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"unknown user", "zed", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"missing project", "ann", "nope", `{"roles":{"dan":"contributor"}}`, 404},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"invalid role", "ann", "web", `{"roles":{"dan":"admin"}}`, 400},
+		{"one bad role among good ones", "ann", "web", `{"roles":{"dan":"contributor","ivy":"superuser"}}`, 400},
+		{"target not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"target in other org", "ann", "web", `{"roles":{"gus":"viewer"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"invalid json", "ann", "web", `{"roles":`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMembersReturnsMemberList(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","ivy":"viewer"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	type entry struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	var got []entry
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("body %q is not a member list: %v", body, err)
+	}
+	want := []entry{
+		{"ann", "manager"},
+		{"ben", "contributor"},
+		{"cat", "contributor"},
+		{"dan", "contributor"},
+		{"ivy", "viewer"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+}
+
+func TestUpdateMembersIsAllOrNothing(t *testing.T) {
+	cases := []struct{ name, body string }{
+		{"bad role", `{"roles":{"dan":"contributor","ivy":"superuser"}}`},
+		{"non member", `{"roles":{"dan":"contributor","hal":"viewer"}}`},
+		{"assignee demoted", `{"roles":{"dan":"contributor","ben":"viewer"}}`},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			code, _ := do(t, h, "PUT", "/projects/web/members", "ann", c.body)
+			if code == 200 {
+				t.Fatal("want an error, got 200")
+			}
+			app := h.(*appHandler)
+			for user, want := range map[string]string{"dan": "viewer", "ben": "contributor", "ivy": "manager"} {
+				var got string
+				if err := app.db.QueryRow(`SELECT role FROM memberships WHERE project_id = 'web' AND user_id = ?`, user).Scan(&got); err != nil {
+					t.Fatal(err)
+				}
+				if got != want {
+					t.Errorf("%s: role %q after failed request, want %q", user, got, want)
+				}
+			}
+		})
+	}
+}
