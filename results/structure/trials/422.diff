+// ProjectTable is the projects table.
+//
+// Find reads a row. Freeze is an API operation: it takes the database, the
+// authorization object of the project and asks it whether the actor may
+// freeze, then runs its aggregate (aggregate.go) in a transaction.
 type ProjectTable struct{}
 
 // NewProjectTable returns the projects table.
 func NewProjectTable() *ProjectTable { return &ProjectTable{} }
 
+// Freeze freezes the project: every member becomes a viewer, so nobody can
+// change its tasks. It returns the members after the change, ordered by user ID.
+func (*ProjectTable) Freeze(ctx context.Context, db DB, authz ProjectAuthz) ([]*Membership, error) {
+	if err := authz.CanFreeze(); err != nil {
+		return nil, err
+	}
+	var out []*Membership
+	if err := db.update(ctx, func(x *Tx) error {
+		agg, err := loadFreezeProject(ctx, x, authz.ProjectID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		out, err = agg.apply(ctx, x)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
