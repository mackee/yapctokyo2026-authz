+// OrgExists reports whether the organization has any user or project.
+func (*UserTable) OrgExists(ctx context.Context, db DB, org string) (bool, error) {
+	var n int
+	if err := db.QueryRowContext(ctx,
+		`SELECT (SELECT COUNT(*) FROM users WHERE org_id = ?) + (SELECT COUNT(*) FROM projects WHERE org_id = ?)`,
+		org, org).Scan(&n); err != nil {
+		return false, err
+	}
+	return n > 0, nil
+}
+
+// Transfer moves the user to another organization (e.g. a move between group
+// companies). Only an admin of the user's organization may do it. Because
+// project members must belong to the project's organization, the user's
+// memberships in the old organization's projects end and the tasks assigned
+// to them become unassigned; the org admin flag is cleared. All or nothing.
+func (*UserTable) Transfer(ctx context.Context, db DB, authz OrgAuthz, userID, toOrg string) (*User, error) {
+	if err := authz.CanTransfer(); err != nil {
+		return nil, err
+	}
+	if toOrg == "" || toOrg == authz.OrgID() {
+		return nil, deny(ErrInvalid, "toOrgId must be a different organization")
+	}
+	var u *User
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadTransferUser(ctx, tx, authz.OrgID(), userID, toOrg)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		u, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return u, nil
+}
