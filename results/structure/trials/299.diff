+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes", "eve", "/orgs/acme/users/ben", 204},
+		{"user without memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"project manager is not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"org member without roles", "hal", "/orgs/acme/users/ben", 403},
+		{"admin of other org", "gus", "/orgs/acme/users/ben", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ben", 404},
+		{"user of other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed", 404},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d %s", code, body)
+	}
+
+	// ben is no longer a member of web or of the archived legacy project.
+	for _, path := range []string{"/projects/web/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, h, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("GET %s as removed user: got %d want 404", path, code)
+		}
+	}
+
+	// Tasks ben held are unassigned, including in the archived project.
+	for _, path := range []string{"/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		_, body := do(t, h, "GET", path, "ann", "")
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.Assignee != "" {
+			t.Fatalf("%s still assigned to %q", path, task.Assignee)
+		}
+	}
+
+	// Other members' assignments are left alone.
+	_, body := do(t, h, "GET", "/projects/web/tasks/t2", "ann", "")
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.Assignee != "cat" {
+		t.Fatalf("t2 assignee = %q, want cat", task.Assignee)
+	}
+
+	// The removed user's account still exists: removal only drops memberships,
+	// so the user can still authenticate (and gets 404, not 401, on projects).
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t1", "ben", ""); code != 404 {
+		t.Fatalf("GET task as removed user: got %d want 404", code)
+	}
+}
+
+func TestRemoveOrgUserAcrossProjects(t *testing.T) {
+	h := newServer()
+	// ivy manages both web and ops; removing ivy drops both memberships.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ivy", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d", code)
+	}
+	for _, path := range []string{"/projects/web/tasks", "/projects/ops/tasks"} {
+		if code, _ := do(t, h, "POST", path, "ivy", `{"title":"x"}`); code != 404 {
+			t.Fatalf("POST %s as removed user: got %d want 404", path, code)
+		}
+	}
+	// ivy's org-wide removal does not touch the other organization.
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatalf("globex project affected: got %d", code)
+	}
+}
