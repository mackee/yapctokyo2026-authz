 }
 
+func (s *actorScope) Org(orgID string) OrgScope {
+	return &orgScope{as: s, oid: orgID}
+}
+
+type orgScope struct {
+	as  *actorScope
+	oid string
+}
+
+func (s *orgScope) ID() string { return s.oid }
+
+// Admin applies the org-admin rule: another organization is 404, a member of
+// the organization who is not an org admin is 403.
+func (s *orgScope) Admin() (AdminOrg, error) {
+	if s.oid != s.as.actor.org {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if !s.as.actor.orgAdmin {
+		return nil, deny(ErrForbidden, "forbidden")
+	}
+	return &adminOrg{os: s}, nil
+}
+
+type adminOrg struct{ os *orgScope }
+
+func (o *adminOrg) RemoveUser(userID string) error {
+	return o.os.as.a.st.tx(func(s *state) error {
+		u, ok := s.users[userID]
+		if !ok || u.org != o.os.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		for _, m := range s.members {
+			delete(m, userID)
+		}
+		// Keep the assignee invariant: the user is no longer a writer anywhere.
+		for id, t := range s.tasks {
+			if t.assignee.user == userID {
+				t.assignee = Assignee{project: t.project}
+				s.tasks[id] = t
+			}
+		}
+		return nil
+	})
+}
