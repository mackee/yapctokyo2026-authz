+// transferUserAggregate moves one user from their organization to another.
+type transferUserAggregate struct {
+	user        *User
+	toOrgID     string
+	memberships []*Membership // the user's memberships in projects of the user's organization
+	archived    bool          // one of those projects is archived
+}
+
+func loadTransferUser(ctx context.Context, tx DB, fromOrgID, userID string, in UserTableTransferInput) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != fromOrgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if _, err := NewOrgTable().Find(ctx, tx, in.ToOrgID); errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "destination organization does not exist")
+	} else if err != nil {
+		return nil, err
+	}
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	a := &transferUserAggregate{user: u, toOrgID: in.ToOrgID}
+	for _, m := range ms {
+		p, err := m.Project(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		if p.Org != fromOrgID {
+			continue
+		}
+		a.memberships = append(a.memberships, m)
+		if p.Archived {
+			a.archived = true
+		}
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if a.toOrgID == a.user.Org {
+		return deny(ErrInvalid, "user already belongs to the organization")
+	}
+	if a.archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	for _, m := range a.memberships {
+		tasks, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		for _, t := range tasks {
+			if err := t.unassign(ctx, tx); err != nil {
+				return nil, err
+			}
+		}
+		if err := m.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	a.user.Org = a.toOrgID
+	a.user.OrgAdmin = false // admin rights are per organization
+	if err := a.user.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
