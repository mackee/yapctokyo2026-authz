+func TestTransfer(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/dan/transfer", `{"toOrgId":"globex"}`, 200},
+		{"non admin member", "dan", "/orgs/acme/users/cat/transfer", `{"toOrgId":"globex"}`, 403},
+		{"other org admin", "gus", "/orgs/acme/users/dan/transfer", `{"toOrgId":"globex"}`, 404},
+		{"anonymous", "", "/orgs/acme/users/dan/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown user", "zed", "/orgs/acme/users/dan/transfer", `{"toOrgId":"globex"}`, 401},
+		{"user in other org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"unknown user id", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"unknown destination", "eve", "/orgs/acme/users/dan/transfer", `{"toOrgId":"initech"}`, 400},
+		{"same organization", "eve", "/orgs/acme/users/dan/transfer", `{"toOrgId":"acme"}`, 400},
+		{"missing toOrgId", "eve", "/orgs/acme/users/dan/transfer", `{}`, 400},
+		{"archived membership", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/dan/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["id"] != "dan" || got["orgId"] != "globex" || len(got) != 2 {
+		t.Fatalf("got %s", body)
+	}
+}
+
+func TestTransferMovesUserOut(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/orgs/acme/users/cat/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer got %d: %s", code, body)
+	}
+
+	// The user can no longer see the old organization's projects.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "cat", ""); code != 404 {
+		t.Fatalf("old member reads web: got %d want 404", code)
+	}
+
+	// Their tasks in the old organization's projects are unassigned.
+	var tasks []Task
+	_, body := do(t, srv, "GET", "/projects/web/tasks", "ann", "")
+	if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+		t.Fatal(err)
+	}
+	for _, task := range tasks {
+		if task.ID == "t2" && task.AssigneeID != "" {
+			t.Fatalf("t2 still assigned to %q", task.AssigneeID)
+		}
+	}
+	_, body = do(t, srv, "GET", "/projects/ops/tasks/t4", "ann", "")
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "" {
+		t.Fatalf("t4 still assigned to %q", task.AssigneeID)
+	}
+}
+
+func TestTransferDropsOrgAdmin(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer got %d: %s", code, body)
+	}
+	// eve is now a globex user without admin rights there.
+	if code, _ := do(t, srv, "POST", "/orgs/globex/users/gus/transfer", "eve", `{"toOrgId":"acme"}`); code != 403 {
+		t.Fatalf("got %d want 403", code)
+	}
+}
+
+func TestTransferArchivedIsAllOrNothing(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 409 {
+		t.Fatalf("got %d want 409", code)
+	}
+	// ben keeps the web membership and the assigned task t1.
+	code, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ben", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "ben" {
+		t.Fatalf("t1 assignee %q, want ben", task.AssigneeID)
+	}
+}
