+// Transfer moves a user of the authorization object's organization to another
+// organization. The user leaves the old organization's projects (their
+// memberships there are removed and their tasks there are unassigned) and
+// loses org admin. A user who is a member of an archived project is rejected
+// with ErrArchived, since archived projects are read-only.
+func (*UserTable) Transfer(ctx context.Context, db DB, authz OrgAuthz, userID string, in UserTableTransferInput) (*User, error) {
+	if err := authz.CanTransferUsers(); err != nil {
+		return nil, err
