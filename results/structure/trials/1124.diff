+type moveMemberRequest struct {
+	ToProjectID string `json:"toProjectId" validate:"required"`
+}
+
+func moveMember(ctx tanukirpc.Context[*projectRegistry], req moveMemberRequest) (*model.Membership, error) {
+	reg := ctx.Registry()
+	// Decide on the source first so a caller who may not manage it gets 403
+	// regardless of the destination.
+	if err := reg.authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	// The destination must be readable by the actor too (404 otherwise).
+	to, err := model.NewProjectAuthz(ctx, reg.db, reg.authz.Actor(), req.ToProjectID)
+	if err != nil {
+		return nil, err
+	}
+	return model.NewMembershipTable().Move(ctx, reg.db, reg.authz, to, chi.URLParam(ctx.Request(), "uid"))
+}
+
