+func TestRemoveOrgUserStatus(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes self", "eve", "/orgs/acme/users/eve", 204},
+		{"non admin member", "ann", "/orgs/acme/users/ben", 403},
+		{"other org", "eve", "/orgs/globex/users/gus", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ben", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown user", "zed", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("got %d want 204", code)
+	}
+	// ben lost web and the archived legacy project: both are now unreadable.
+	for _, p := range []string{"/projects/web/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, h, "GET", p, "ben", ""); code != 404 {
+			t.Fatalf("ben %s: got %d want 404", p, code)
+		}
+	}
+	// His tasks are unassigned; other people's are untouched.
+	check := func(path, wantAssignee string) {
+		t.Helper()
+		code, body := do(t, h, "GET", path, "eve", "")
+		if code != 200 {
+			t.Fatalf("%s: got %d", path, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.AssigneeID != wantAssignee {
+			t.Fatalf("%s: assignee %q want %q", path, task.AssigneeID, wantAssignee)
+		}
+	}
+	check("/projects/web/tasks/t1", "")
+	check("/projects/legacy/tasks/t5", "")
+	check("/projects/web/tasks/t2", "cat")
+	// Other users keep their access.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat: got %d want 200", code)
+	}
+}
