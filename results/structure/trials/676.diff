+func TestUpdateMembers(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"viewer", "dan", "web", `{"roles":{"ben":"viewer"}}`, 403},
+		{"contributor", "ben", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"org admin without role", "eve", "web", `{"roles":{"ben":"viewer"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"ben":"viewer"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"ben":"viewer"}}`, 404},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"invalid role", "ann", "web", `{"roles":{"ben":"owner"}}`, 400},
+		{"target not a member", "ann", "web", `{"roles":{"ben":"viewer","hal":"viewer"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"bad body", "ann", "web", `not json`, 400},
+		{"manager bulk change", "ann", "web", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMembersResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var members []memberRole
+	if err := json.Unmarshal([]byte(body), &members); err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]string{"ann": "manager", "ben": "viewer", "cat": "contributor", "dan": "contributor", "ivy": "manager"}
+	if len(members) != len(want) {
+		t.Fatalf("want %d members, got %d: %s", len(want), len(members), body)
+	}
+	for _, m := range members {
+		if want[m.UserID] != m.Role {
+			t.Fatalf("%s: want %q got %q", m.UserID, want[m.UserID], m.Role)
+		}
+	}
+}
+
+func TestUpdateMembersAllOrNothing(t *testing.T) {
+	srv := newServer()
+	do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","hal":"viewer"}}`)
+	do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"cat":"viewer","dan":"owner"}}`)
+	// ben and cat must still have their original roles.
+	code, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ben", "")
+	if code != 200 {
+		t.Fatalf("ben lost read access: %d %s", code, body)
+	}
+	code, _ = do(t, srv, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`)
+	if code != 200 {
+		t.Fatalf("ben should still be a contributor, got %d", code)
+	}
+	code, _ = do(t, srv, "PATCH", "/projects/web/tasks/t2", "cat", `{"status":"done"}`)
+	if code != 200 {
+		t.Fatalf("cat should still be a contributor, got %d", code)
+	}
+}
+
+func TestUpdateMembersPromoteDemote(t *testing.T) {
+	srv := newServer()
+	// promote ben to manager: he can now delete any task
+	if code, body := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"manager"}}`); code != 200 {
+		t.Fatalf("promote: %d %s", code, body)
+	}
+	if code, _ := do(t, srv, "DELETE", "/projects/web/tasks/t2", "ben", ""); code != 204 {
+		t.Fatalf("promoted ben delete: got %d", code)
+	}
+	// demote ann to viewer: she can no longer write
+	if code, body := do(t, srv, "PUT", "/projects/web/members", "ben", `{"roles":{"ann":"viewer"}}`); code != 200 {
+		t.Fatalf("demote: %d %s", code, body)
+	}
+	if code, _ := do(t, srv, "PATCH", "/projects/web/tasks/t1", "ann", `{"status":"done"}`); code != 403 {
+		t.Fatalf("demoted ann patch: got %d want 403", code)
+	}
+}
