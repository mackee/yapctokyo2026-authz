+// updateMemberRolesAggregate changes the roles of several members of one
+// project at once.
+type updateMemberRolesAggregate struct {
+	members  []*Membership          // all members of the project, ordered by user ID
+	targets  map[string]*Membership // the members to change, by user ID
+	newRoles map[string]string      // user ID -> new role
+	assigned map[string][]*Task     // target user ID -> tasks assigned to them in the project
+}
+
+func loadUpdateMemberRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*updateMemberRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	members, err := p.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	a := &updateMemberRolesAggregate{
+		members:  members,
+		targets:  map[string]*Membership{},
+		newRoles: roles,
+		assigned: map[string][]*Task{},
+	}
+	for _, m := range members {
+		if _, ok := roles[m.UserID]; !ok {
+			continue
+		}
+		a.targets[m.UserID] = m
+		tasks, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.assigned[m.UserID] = tasks
+	}
+	return a, nil
+}
+
+func (a *updateMemberRolesAggregate) validate() error {
+	managers := 0
+	for _, m := range a.members {
+		role := m.Role
+		if nr, ok := a.newRoles[m.UserID]; ok {
+			role = nr
+		}
+		if role == RoleManager {
+			managers++
+		}
+	}
+	for id, role := range a.newRoles {
+		if !validRoles[role] {
+			return deny(ErrInvalid, "role must be manager, contributor or viewer")
+		}
+		if _, ok := a.targets[id]; !ok {
+			return deny(ErrInvalid, "user "+id+" is not a member of the project")
+		}
+		if !isWriterRole(role) && len(a.assigned[id]) > 0 {
+			return deny(ErrInvalid, "user "+id+" has assigned tasks and must stay a contributor or manager")
+		}
+	}
+	if managers == 0 {
+		return deny(ErrInvalid, "a project must keep at least one manager")
+	}
+	return nil
+}
+
+func (a *updateMemberRolesAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for _, m := range a.members {
+		role, ok := a.newRoles[m.UserID]
+		if !ok || role == m.Role {
+			continue
+		}
+		if err := m.changeRole(ctx, tx, role); err != nil {
+			return nil, err
+		}
+	}
+	return a.members, nil
+}
