+var validRoles = map[string]bool{RoleManager: true, RoleContributor: true, RoleViewer: true}
+
+// UpdateRoles changes the roles of several members of the project (user ID ->
+// role), all or nothing, and returns the project's members afterwards.
+func (*MembershipTable) UpdateRoles(ctx context.Context, db DB, authz ProjectAuthz, roles map[string]string) ([]*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if len(roles) == 0 {
+		return nil, deny(ErrInvalid, "roles must not be empty")
+	}
+	for _, role := range roles {
+		if !validRoles[role] {
+			return nil, deny(ErrInvalid, "role must be manager, contributor or viewer")
+		}
+	}
+	var out []*Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadUpdateMemberRoles(ctx, tx, authz.ProjectID(), roles)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		out, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
