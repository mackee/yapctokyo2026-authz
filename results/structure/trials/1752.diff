+		{"manager create", "POST", "ann", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"other manager create", "POST", "ivy", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"contributor create", "POST", "ben", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"manager update", "PATCH", "ann", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"contributor update own", "PATCH", "ben", "/projects/web/tasks/t1", `{"status":"done"}`, 403},
+		{"manager delete", "DELETE", "ann", "/projects/web/tasks/t1", "", 403},
+		{"manager freeze again", "POST", "ann", "/projects/web/freeze", "", 403},
+		{"still readable", "GET", "ann", "/projects/web/tasks", "", 200},
+		{"tasks unchanged", "GET", "ben", "/projects/web/tasks/t1", "", 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, h, c.method, c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
