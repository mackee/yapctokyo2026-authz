+// memberView is the JSON shape of a project member.
+type memberView struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func freezeProject(ctx tanukirpc.Context[*projectRegistry], _ struct{}) ([]memberView, error) {
+	reg := ctx.Registry()
+	members, err := model.NewProjectTable().Freeze(ctx, reg.db, reg.authz)
+	if err != nil {
+		return nil, err
+	}
+	out := make([]memberView, 0, len(members))
+	for _, m := range members {
+		out = append(out, memberView{UserID: m.UserID, Role: m.Role})
+	}
+	return out, nil
+}
