+func TestSetMemberRoles(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager promotes viewer", "ann", "web", `{"roles":{"dan":"contributor"}}`, 200},
+		{"manager demotes manager without tasks", "ann", "web", `{"roles":{"ivy":"contributor"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"unknown user", "zed", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"invalid role", "ann", "web", `{"roles":{"dan":"owner"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"target not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"target unknown", "ann", "web", `{"roles":{"zed":"viewer"}}`, 400},
+		{"demoting assignee", "ann", "web", `{"roles":{"ben":"viewer"}}`, 400},
+		{"malformed body", "ann", "web", `{"roles":`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMemberRolesResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann",
+		`{"roles":{"ivy":"contributor","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var members []struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &members); err != nil {
+		t.Fatal(err)
+	}
+	want := []struct{ id, role string }{
+		{"ann", "manager"}, {"ben", "contributor"}, {"cat", "contributor"},
+		{"dan", "contributor"}, {"ivy", "contributor"},
+	}
+	if len(members) != len(want) {
+		t.Fatalf("got %d members want %d: %s", len(members), len(want), body)
+	}
+	for i, m := range members {
+		if m.UserID != want[i].id || m.Role != want[i].role {
+			t.Fatalf("member %d: got %s/%s want %s/%s", i, m.UserID, m.Role, want[i].id, want[i].role)
+		}
+	}
+}
+
+func TestSetMemberRolesAllOrNothing(t *testing.T) {
+	srv := newServer()
+	// dan's promotion is valid, but ben's demotion breaks the assignee rule
+	// (ben owns t1), so the whole batch is refused.
+	if code, _ := do(t, srv, "PUT", "/projects/web/members", "ann",
+		`{"roles":{"dan":"contributor","ben":"viewer"}}`); code != 400 {
+		t.Fatalf("mixed batch: got %d want 400", code)
+	}
+	// Likewise a batch with an invalid role must not apply its valid part.
+	if code, _ := do(t, srv, "PUT", "/projects/web/members", "ann",
+		`{"roles":{"dan":"contributor","cat":"owner"}}`); code != 400 {
+		t.Fatalf("invalid role batch: got %d want 400", code)
+	}
+	// dan is still a viewer: writing is forbidden.
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 403 {
+		t.Fatalf("dan after refused batch: got %d want 403", code)
+	}
+	// ben is still a contributor: writing is allowed.
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 201 {
+		t.Fatalf("ben after refused batch: got %d want 201", code)
+	}
+}
+
+func TestSetMemberRolesTakesEffect(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "PUT", "/projects/web/members", "ann",
+		`{"roles":{"dan":"contributor"}}`); code != 200 {
+		t.Fatalf("promote: got %d want 200: %s", code, body)
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 201 {
+		t.Fatalf("dan as contributor: got %d want 201", code)
+	}
+	if code, body := do(t, srv, "PUT", "/projects/web/members", "ann",
+		`{"roles":{"dan":"viewer"}}`); code != 200 {
+		t.Fatalf("demote: got %d want 200: %s", code, body)
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 403 {
+		t.Fatalf("dan as viewer: got %d want 403", code)
+	}
+}
