+// setMemberRolesAggregate changes the roles of several members of one project.
+type setMemberRolesAggregate struct {
+	project projectRecord
+	changes []memberRoleChange // sorted by user ID
+}
+
+// memberRoleChange is one requested role change and the facts needed to judge it.
+type memberRoleChange struct {
+	membership    membershipRecord
+	role          string
+	assignedTasks []taskRecord // tasks of the project assigned to the member now
+}
+
+func loadSetMemberRoles(x *tx, projectID string, roles map[string]string) (*setMemberRolesAggregate, error) {
+	if len(roles) == 0 {
+		return nil, deny(ErrInvalid, "roles must not be empty")
+	}
+	p, ok := x.findProject(projectID)
+	if !ok {
+		return nil, deny(ErrInvalid, "project does not exist")
+	}
+	userIDs := make([]string, 0, len(roles))
+	for uid := range roles {
+		userIDs = append(userIDs, uid)
+	}
+	sort.Strings(userIDs)
+	a := &setMemberRolesAggregate{project: p}
+	for _, uid := range userIDs {
+		m, ok := p.Membership(x, uid)
+		if !ok {
+			return nil, deny(ErrInvalid, "user "+uid+" is not a member of the project")
+		}
+		a.changes = append(a.changes, memberRoleChange{
+			membership:    m,
+			role:          roles[uid],
+			assignedTasks: m.AssignedTasks(x),
+		})
+	}
+	return a, nil
+}
+
+func (a *setMemberRolesAggregate) validate() error {
+	for _, c := range a.changes {
+		if !validRoles[c.role] {
+			return deny(ErrInvalid, "invalid role: "+c.role)
+		}
+		// Assignees must be contributors or managers, so a member who stops
+		// being one may not still hold tasks in the project.
+		if !isWriterRole(c.role) && len(c.assignedTasks) > 0 {
+			return deny(ErrInvalid, c.membership.UserID+" has assigned tasks in the project and cannot become "+c.role)
+		}
+	}
+	return nil
+}
+
+func (a *setMemberRolesAggregate) apply(x *tx) []MemberView {
+	for _, c := range a.changes {
+		m := c.membership
+		m.SetRole(x, c.role)
+	}
+	out := []MemberView{}
+	for _, m := range a.project.Memberships(x) {
+		out = append(out, MemberView{UserID: m.UserID, Role: m.Role})
+	}
+	return out
+}
+
