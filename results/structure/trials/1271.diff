+// freezeProjectAggregate makes every member of one project a viewer. Because
+// an assignee must be a contributor or manager, the tasks assigned to the
+// demoted members are unassigned in the same transaction.
+type freezeProjectAggregate struct {
+	members  []*Membership
+	assigned map[string][]*Task // by user ID: tasks of the project assigned to the member
+}
+
+func loadFreezeProject(ctx context.Context, tx DB, projectID string) (*freezeProjectAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	ms, err := p.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	a := &freezeProjectAggregate{members: ms, assigned: map[string][]*Task{}}
+	for _, m := range ms {
+		ts, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.assigned[m.UserID] = ts
+	}
+	return a, nil
+}
+
+func (a *freezeProjectAggregate) validate() error { return nil }
+
+func (a *freezeProjectAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for _, m := range a.members {
+		for _, t := range a.assigned[m.UserID] {
+			if err := t.unassign(ctx, tx); err != nil {
+				return nil, err
+			}
+		}
+		if err := m.demote(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	return a.members, nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
