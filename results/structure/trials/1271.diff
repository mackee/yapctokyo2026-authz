+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager", "ann", "/projects/web/freeze", 200},
+		{"contributor", "ben", "/projects/web/freeze", 403},
+		{"viewer", "dan", "/projects/web/freeze", 403},
+		{"org admin", "eve", "/projects/web/freeze", 403},
+		{"non member", "hal", "/projects/web/freeze", 404},
+		{"other org", "gus", "/projects/web/freeze", 404},
+		{"anonymous", "", "/projects/web/freeze", 401},
+		{"archived", "ann", "/projects/legacy/freeze", 409},
+		{"missing project", "ann", "/projects/nope/freeze", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreeze(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got []map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []string{"ann", "ben", "cat", "dan", "ivy"}
+	if len(got) != len(want) {
+		t.Fatalf("got %v", got)
+	}
+	for i, m := range got {
+		if len(m) != 2 || m["userId"] != want[i] || m["role"] != "viewer" {
+			t.Fatalf("member %d: %v", i, m)
+		}
+	}
+
+	// Nobody can change tasks of the frozen project any more, managers included.
+	for _, user := range []string{"ann", "ivy", "ben", "cat", "dan"} {
+		for _, c := range []struct{ method, path, body string }{
+			{"POST", "/projects/web/tasks", `{"title":"x"}`},
+			{"PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+			{"PATCH", "/projects/web/tasks/t3", `{"title":"y"}`},
+			{"DELETE", "/projects/web/tasks/t1", ""},
+		} {
+			if code, _ := do(t, h, c.method, c.path, user, c.body); code != 403 {
+				t.Fatalf("%s %s %s: got %d want 403", user, c.method, c.path, code)
+			}
+		}
+		// Reads still work.
+		if code, _ := do(t, h, "GET", "/projects/web/tasks", user, ""); code != 200 {
+			t.Fatalf("%s read: got %d", user, code)
+		}
+	}
+	// Freezing again is refused: nobody is a manager any more.
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 403 {
+		t.Fatalf("second freeze: got %d want 403", code)
+	}
+
+	// Tasks assigned to the demoted members are unassigned, so no task has a
+	// viewer as assignee.
+	_, body = do(t, h, "GET", "/projects/web/tasks", "ann", "")
+	var tasks []Task
+	if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+		t.Fatal(err)
+	}
+	for _, task := range tasks {
+		if task.AssigneeID != "" {
+			t.Fatalf("task %s still assigned to %s", task.ID, task.AssigneeID)
+		}
+	}
+
+	// Other projects are untouched.
+	if code, _ := do(t, h, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ops task: got %d want 200", code)
+	}
+}
