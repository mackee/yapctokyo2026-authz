+// (else ErrForbidden) and not archived (else ErrArchived).
+func (a ProjectAuthz) CanFreeze() error {
+	if !a.CanRead() || a.role != RoleManager {
+		return deny(ErrForbidden, "only managers may freeze a project")
+	}
+	if a.archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	return nil
