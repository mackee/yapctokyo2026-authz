+func TestRemoveUserStatus(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin, user without projects", "eve", "/orgs/acme/users/hal", 204},
+		{"not admin", "ann", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"caller in other org", "eve", "/orgs/globex/users/gus", 404},
+		{"unknown org", "eve", "/orgs/void/users/ben", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveUserEffects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("got %d", code)
+	}
+	// ben is no longer a member of web or of the archived legacy project.
+	for _, p := range []string{"web", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ben", ""); code != 404 {
+			t.Fatalf("ben still reads %s: %d", p, code)
+		}
+	}
+	// His tasks are unassigned (archived project included); others are untouched.
+	assignee := func(project, id string) string {
+		_, body := do(t, h, "GET", "/projects/"+project+"/tasks/"+id, "eve", "")
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		return task.AssigneeID
+	}
+	if got := assignee("web", "t1"); got != "" {
+		t.Fatalf("t1 assignee %q", got)
+	}
+	if got := assignee("legacy", "t5"); got != "" {
+		t.Fatalf("t5 assignee %q", got)
+	}
+	if got := assignee("web", "t2"); got != "cat" {
+		t.Fatalf("t2 assignee %q", got)
+	}
+	// Other members keep their access; the removed user cannot be assigned.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat lost access: %d", code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t3", "ann", `{"assignee":"ben"}`); code != 400 {
+		t.Fatalf("assigning removed user: %d", code)
+	}
+	// Removing again still answers 204.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("second removal: %d", code)
+	}
+}
