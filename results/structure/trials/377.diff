+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes contributor", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes viewer", "eve", "/orgs/acme/users/dan", 204},
+		{"org admin removes user without projects", "eve", "/orgs/acme/users/hal", 204},
+		{"manager is not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"self is not org admin", "ben", "/orgs/acme/users/ben", 403},
+		{"other org admin", "gus", "/orgs/acme/users/ben", 404},
+		{"org not visible", "eve", "/orgs/globex/users/gus", 404},
+		{"unknown org", "eve", "/orgs/initech/users/ben", 404},
+		{"user in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed", 404},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+
+	// ben is out of every project of acme: no reads, no writes.
+	for _, path := range []string{"/projects/web/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, srv, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("GET %s as ben: got %d want 404", path, code)
+		}
+	}
+	if code, _ := do(t, srv, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 404 {
+		t.Fatalf("PATCH as ben: got %d want 404", code)
+	}
+
+	// The user record is not deleted: ben still authenticates.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code == 401 {
+		t.Fatal("ben should still authenticate")
+	}
+
+	// Tasks ben was assigned to in acme projects are unassigned, including in the
+	// archived project. Other tasks are untouched.
+	for _, c := range []struct{ user, path, assignee string }{
+		{"ann", "/projects/web/tasks/t1", `"assignee":""`},
+		{"eve", "/projects/legacy/tasks/t5", `"assignee":""`},
+		{"ann", "/projects/web/tasks/t2", `"assignee":"cat"`},
+		{"gus", "/projects/gx/tasks/t6", `"assignee":"gus"`},
+	} {
+		code, body := do(t, srv, "GET", c.path, c.user, "")
+		if code != 200 || !strings.Contains(body, c.assignee) {
+			t.Fatalf("GET %s: got %d %s, want %s", c.path, code, body, c.assignee)
+		}
+	}
+}
+
+func TestRemoveOrgUserIsIdempotent(t *testing.T) {
+	srv := newServer()
+	for i := 0; i < 2; i++ {
+		if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+			t.Fatalf("attempt %d: got %d want 204", i+1, code)
+		}
+	}
+}
