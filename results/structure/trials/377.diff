+// ---- org capabilities -----------------------------------------------------------
+
+// ManageOrg is the org-admin capability for one organization.
+type ManageOrg interface {
+	// RemoveUser takes the user out of every project of the organization
+	// (offboarding). Tasks the user was assigned to in those projects are
+	// unassigned, so the assignee rule keeps holding. It is idempotent: removing
+	// a user who is already out of all projects succeeds. A user who is not in
+	// the organization is 404.
+	RemoveUser(userID string) error
+}
+
+type manageOrg struct{ orgScope *orgScope }
+
+func (m *manageOrg) RemoveUser(userID string) error {
+	return m.orgScope.as.a.db.update(func(x *tx) error {
+		agg, err := loadRemoveOrgUser(x, m.orgScope.oid, userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		agg.apply(x)
+		return nil
+	})
+}
