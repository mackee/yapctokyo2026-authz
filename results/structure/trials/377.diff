 func (a *deleteTaskAggregate) apply(x *tx) { a.task.Destroy(x) }
+
+// removeOrgUserAggregate takes one user out of every project of one
+// organization: their memberships there are destroyed, and the tasks assigned to
+// them in those projects are unassigned.
+type removeOrgUserAggregate struct {
+	user        userRecord
+	memberships []membershipRecord // the user's memberships in the org's projects
+	tasks       []taskRecord       // tasks assigned to the user in the org's projects
+}
+
+func loadRemoveOrgUser(x *tx, orgID, userID string) (*removeOrgUserAggregate, error) {
+	u, ok := x.findUser(userID)
+	if !ok || u.Org != orgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	a := &removeOrgUserAggregate{user: u}
+	for _, m := range u.Memberships(x) {
+		if p, ok := m.Project(x); ok && p.Org == orgID {
+			a.memberships = append(a.memberships, m)
+		}
+	}
+	for _, t := range u.AssignedTasks(x) {
+		if p, ok := t.Project(x); ok && p.Org == orgID {
+			a.tasks = append(a.tasks, t)
+		}
+	}
+	return a, nil
+}
+
+func (a *removeOrgUserAggregate) validate() error { return nil }
+
+func (a *removeOrgUserAggregate) apply(x *tx) {
+	for _, t := range a.tasks {
+		t.Unassign(x)
+	}
+	for _, m := range a.memberships {
+		m.Destroy(x)
+	}
+}
