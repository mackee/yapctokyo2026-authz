+package model
+
+import "context"
+
+// OrgTable reads the orgs table.
+type OrgTable struct{}
+
+// NewOrgTable returns the orgs table.
+func NewOrgTable() *OrgTable { return &OrgTable{} }
+
+// Find returns the organization with the ID, or ErrNoRows.
+func (*OrgTable) Find(ctx context.Context, db DB, id string) (string, error) {
+	var got string
+	if err := db.QueryRowContext(ctx, `SELECT id FROM orgs WHERE id = ?`, id).Scan(&got); err != nil {
+		return "", err
+	}
+	return got, nil
+}
