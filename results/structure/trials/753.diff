+// transferUserAggregate moves one user from fromOrg to another organization.
+type transferUserAggregate struct {
+	user        *User
+	toOrg       string
+	memberships []*Membership // the user's memberships; all are in fromOrg's projects
+	projects    []*Project    // memberships[i].Project
+}
+
+func loadTransferUser(ctx context.Context, tx DB, fromOrg, userID string, in UserTableTransferInput) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != fromOrg {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if _, err := NewOrgTable().Find(ctx, tx, in.ToOrgID); errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "organization does not exist")
+	} else if err != nil {
+		return nil, err
+	}
+	if in.ToOrgID == u.Org {
+		return nil, deny(ErrInvalid, "user already belongs to that organization")
+	}
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	a := &transferUserAggregate{user: u, toOrg: in.ToOrgID, memberships: ms}
+	for _, m := range ms {
+		p, err := m.Project(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.projects = append(a.projects, p)
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	// Archived projects reject all writes. Dropping the user's membership and
+	// unassigning their tasks there would be a write, so the transfer is refused.
+	for _, p := range a.projects {
+		if p.Archived {
+			return deny(ErrArchived, "user is a member of an archived project")
+		}
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	for _, m := range a.memberships {
+		tasks, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		for _, t := range tasks {
+			if err := t.unassign(ctx, tx); err != nil {
+				return nil, err
+			}
+		}
+		if err := m.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	a.user.Org = a.toOrg
+	a.user.OrgAdmin = false
+	if err := a.user.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
+
