@@ -0,0 +1,102 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestTransferDenials(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"anonymous", "", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown user", "zed", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 401},
+		{"org member, not admin", "ann", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 403},
+		{"other org's user", "gus", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 404},
+		{"admin of other org", "eve", "/orgs/globex/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"user not in path org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"missing user", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"unknown target org", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"initech"}`, 400},
+		{"same org", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"acme"}`, 400},
+		{"missing toOrgId", "eve", "/orgs/acme/users/hal/transfer", `{}`, 400},
+		{"bad body", "eve", "/orgs/acme/users/hal/transfer", `{`, 400},
+		{"member of archived project", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/hal/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got struct {
+		ID    string `json:"id"`
+		OrgID string `json:"orgId"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.ID != "hal" || got.OrgID != "globex" {
+		t.Fatalf("got %s", body)
+	}
+}
+
+// A transferred user loses access to the old organization's projects, and the
+// tasks they held there are unassigned.
+func TestTransferRemovesAccessAndAssignments(t *testing.T) {
+	srv := newServer()
+	code, body := do(t, srv, "POST", "/projects/web/tasks", "ann", `{"title":"x","assignee":"ivy"}`)
+	if code != 200 {
+		t.Fatalf("create: %d %s", code, body)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+
+	if code, body := do(t, srv, "POST", "/orgs/acme/users/ivy/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: %d %s", code, body)
+	}
+
+	code, body = do(t, srv, "GET", "/projects/web/tasks/"+task.ID, "ann", "")
+	if code != 200 {
+		t.Fatalf("get task: %d %s", code, body)
+	}
+	var after Task
+	if err := json.Unmarshal([]byte(body), &after); err != nil {
+		t.Fatal(err)
+	}
+	if after.AssigneeID != "" {
+		t.Fatalf("task still assigned to %q", after.AssigneeID)
+	}
+
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ivy", ""); code != 404 {
+		t.Fatalf("ivy reads web after transfer: got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "ivy", ""); code != 404 {
+		t.Fatalf("ivy reads ops after transfer: got %d want 404", code)
+	}
+}
+
+// Org admin rights do not follow the user to the new organization.
+func TestTransferClearsOrgAdmin(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: %d %s", code, body)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "eve", ""); code != 404 {
+		t.Fatalf("eve reads acme after transfer: got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "POST", "/orgs/globex/users/gus/transfer", "eve", `{"toOrgId":"acme"}`); code != 403 {
+		t.Fatalf("eve transfers in globex: got %d want 403", code)
+	}
+}
