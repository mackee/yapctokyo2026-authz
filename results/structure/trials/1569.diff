+	ToProjectID string
+}
+
+// Move moves the task to another project, keeping its ID, title, status and
+// assignee. The actor must be able to manage the task and be a manager of the
+// destination project, which must be readable by the actor (else ErrNotFound).
+func (*TaskTable) Move(ctx context.Context, db DB, authz TaskAuthz, in TaskTableMoveInput) (*Task, error) {
+	if err := authz.CanManage(); err != nil {
+		return nil, err
+	}
+	var t *Task
+	if err := inTx(ctx, db, func(tx DB) error {
+		destAuthz, err := NewProjectAuthz(ctx, tx, authz.project.actor, in.ToProjectID)
+		if err != nil {
+			return err
+		}
+		if err := destAuthz.CanReceive(); err != nil {
+			return err
+		}
+		agg, err := loadMoveTask(ctx, tx, authz.TaskID(), in.ToProjectID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		t, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return t, nil
+}
