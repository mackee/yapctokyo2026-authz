+// Admin acquires the project-administration capability. Only managers of the
+// project may acquire it (readable, else 404; any other role, including org
+// admins, gets 403).
+func (s *projectScope) Admin() (AdminProject, error) {
+	err := s.as.a.st.read(func(st *state) error {
+		return managed(st, s.as.actor, s.pid)
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &adminProject{readProject: readProject{ps: s}}, nil
+}
+
+// managed applies the manager rule to project administration: readable, and
+// the actor is a manager of the project (else 403).
+func managed(s *state, act Actor, pid string) error {
+	_, r, err := readable(s, act, pid)
+	if err != nil {
+		return err
+	}
+	if r != RoleManager {
+		return deny(ErrForbidden, "forbidden")
+	}
+	return nil
+}
