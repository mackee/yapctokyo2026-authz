+// AdminProject may manage the membership state of one project. Acquired only
+// by managers of the project (see ProjectScope.Admin).
+type AdminProject interface {
+	ReadProject
+	// Freeze freezes the project: every member becomes a viewer, so nobody can
+	// change its tasks any more. Once frozen, no one is a manager any more, so
+	// a frozen project cannot be frozen again (403). It returns the membership
+	// after the change, sorted by user ID.
+	Freeze() ([]Member, error)
+}
+
+type adminProject struct{ readProject }
+
+func (p *adminProject) Freeze() ([]Member, error) {
+	pid := p.ps.pid
+	var out []Member
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		// Re-check the manager rule inside the transaction, against the state
+		// being committed, so the check and the change see the same data.
+		if err := managed(s, p.ps.as.actor, pid); err != nil {
+			return err
+		}
+		pr := s.projects[pid]
+		pr.frozen = true
+		s.projects[pid] = pr
+		for uid := range s.members[pid] {
+			s.members[pid][uid] = RoleViewer
+		}
+		out = s.membersIn(pid)
+		return nil
+	})
+	return out, err
+}
