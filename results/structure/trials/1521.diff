+// setRolesRequest maps user IDs to their new project roles. The roles are checked
+// here, before any access decision (400).
+type setRolesRequest struct {
+	Roles map[string]string `json:"roles" validate:"required,min=1,dive,oneof=manager contributor viewer"`
+}
+
+// memberJSON is the JSON shape of a membership in the members response.
+type memberJSON struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func setMemberRoles(ctx tanukirpc.Context[*projectRegistry], req setRolesRequest) ([]memberJSON, error) {
+	reg := ctx.Registry()
+	ms, err := model.NewMembershipTable().SetRoles(ctx, reg.db, reg.authz, model.MembershipTableSetRolesInput{Roles: req.Roles})
+	if err != nil {
+		return nil, err
+	}
+	out := make([]memberJSON, 0, len(ms))
+	for _, m := range ms {
+		out = append(out, memberJSON{UserID: m.UserID, Role: m.Role})
+	}
+	return out, nil
+}
