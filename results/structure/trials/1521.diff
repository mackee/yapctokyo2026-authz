-// MembershipTable reads the memberships table.
+// MembershipTable is the memberships table. Find and List* read rows; SetRoles
+// is the API operation that changes them.
 type MembershipTable struct{}
 
 // NewMembershipTable returns the memberships table.
 func NewMembershipTable() *MembershipTable { return &MembershipTable{} }
 
+// MembershipTableSetRolesInput is the input of MembershipTable.SetRoles: the new
+// role of each member, by user ID.
+type MembershipTableSetRolesInput struct {
+	Roles map[string]string
+}
+
+var validRoles = map[string]bool{RoleManager: true, RoleContributor: true, RoleViewer: true}
+
+// SetRoles changes the roles of several members of the project, all or nothing.
+// It returns the project's members after the change, ordered by user ID. Only
+// managers may do it; a user who is not a member, or a viewer who is assigned
+// tasks in the project, rejects the whole change.
+func (mt *MembershipTable) SetRoles(ctx context.Context, db DB, authz ProjectAuthz, in MembershipTableSetRolesInput) ([]*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if len(in.Roles) == 0 {
+		return nil, deny(ErrInvalid, "roles must not be empty")
+	}
+	for _, role := range in.Roles {
+		if !validRoles[role] {
+			return nil, deny(ErrInvalid, "invalid role "+role)
+		}
+	}
+	var out []*Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadSetRoles(ctx, tx, authz.ProjectID(), in)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		out, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
+
 // Find returns the membership of the user in the project, or ErrNoRows.
