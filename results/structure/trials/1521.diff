 }
 
+// setRolesAggregate changes the roles of several members of one project, all or
+// nothing. Every target is loaded and checked before any row is changed.
+type setRolesAggregate struct {
+	project *Project
+	changes []memberRoleChange
+}
+
+// memberRoleChange is one member's new role. assigned holds the member's tasks in
+// the project; it is loaded only when the new role is not a writer role.
+type memberRoleChange struct {
+	member   *Membership
+	role     string
+	assigned []*Task
+}
+
+func loadSetRoles(ctx context.Context, tx DB, projectID string, in MembershipTableSetRolesInput) (*setRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	userIDs := make([]string, 0, len(in.Roles))
+	for id := range in.Roles {
+		userIDs = append(userIDs, id)
+	}
+	sort.Strings(userIDs)
+	a := &setRolesAggregate{project: p}
+	for _, id := range userIDs {
+		m, err := p.Membership(ctx, tx, id)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, id+" is not a member of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		c := memberRoleChange{member: m, role: in.Roles[id]}
+		if !isWriterRole(c.role) {
+			c.assigned, err = m.AssignedTasks(ctx, tx)
+			if err != nil {
+				return nil, err
+			}
+		}
+		a.changes = append(a.changes, c)
+	}
+	return a, nil
+}
+
+func (a *setRolesAggregate) validate() error {
+	for _, c := range a.changes {
+		// An assignee must stay a contributor or manager of the task's project.
+		if !isWriterRole(c.role) && len(c.assigned) > 0 {
+			return deny(ErrInvalid, c.member.UserID+" has tasks assigned in the project; reassign them before making the member "+c.role)
+		}
+	}
+	return nil
+}
+
+// apply changes the roles and returns the project's members after the change.
+func (a *setRolesAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for _, c := range a.changes {
+		if err := c.member.setRole(ctx, tx, c.role); err != nil {
+			return nil, err
+		}
+	}
+	return NewMembershipTable().ListByProject(ctx, tx, a.project.ID)
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
