+// roleOf reads a member's role straight from the database behind h.
+func roleOf(t *testing.T, h http.Handler, projectID, userID string) string {
+	t.Helper()
+	app, ok := h.(*appHandler)
+	if !ok {
+		t.Fatalf("roleOf: %T is not the handler built by newServer", h)
+	}
+	var role string
+	if err := app.db.QueryRow(`SELECT role FROM memberships WHERE project_id = ? AND user_id = ?`, projectID, userID).Scan(&role); err != nil {
+		t.Fatalf("roleOf %s/%s: %v", projectID, userID, err)
+	}
+	return role
+}
+
+func TestSetMemberRoles(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager changes roles", "ann", "web", `{"roles":{"dan":"contributor","ivy":"viewer"}}`, 200},
+		{"manager, member assigned tasks to viewer", "ann", "web", `{"roles":{"ben":"viewer"}}`, 400},
+		{"manager, viewer for member with tasks", "ann", "web", `{"roles":{"cat":"viewer"}}`, 400},
+		{"manager, non member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"manager, unknown user", "ann", "web", `{"roles":{"zed":"contributor"}}`, 400},
+		{"manager, invalid role", "ann", "web", `{"roles":{"dan":"owner"}}`, 400},
+		{"manager, empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"manager, missing roles", "ann", "web", `{}`, 400},
+		{"manager, malformed body", "ann", "web", `{"roles":`, 400},
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"unknown project", "ann", "nope", `{"roles":{"dan":"contributor"}}`, 404},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"manager"}}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMemberRolesResponse(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","ivy":"viewer"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("decode %q: %v", body, err)
+	}
+	want := []struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}{
+		{"ann", "manager"}, {"ben", "contributor"}, {"cat", "contributor"}, {"dan", "contributor"}, {"ivy", "viewer"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %d members, want %d: %s", len(got), len(want), body)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("member %d: got %+v want %+v", i, got[i], want[i])
+		}
+	}
+	if role := roleOf(t, h, "web", "dan"); role != "contributor" {
+		t.Fatalf("dan's role is %s in the database", role)
+	}
+}
+
+func TestSetMemberRolesIsAllOrNothing(t *testing.T) {
+	cases := []struct {
+		name, body string
+	}{
+		// dan could change, but hal is not a member.
+		{"one non member", `{"roles":{"dan":"contributor","hal":"viewer"}}`},
+		// dan could change, but ben holds task t1 in web.
+		{"one assigned viewer", `{"roles":{"dan":"contributor","ben":"viewer"}}`},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			code, body := do(t, h, "PUT", "/projects/web/members", "ann", c.body)
+			if code != 400 {
+				t.Fatalf("got %d want 400: %s", code, body)
+			}
+			if role := roleOf(t, h, "web", "dan"); role != "viewer" {
+				t.Fatalf("dan's role changed to %s despite the error", role)
+			}
+			if role := roleOf(t, h, "web", "ben"); role != "contributor" {
+				t.Fatalf("ben's role changed to %s despite the error", role)
+			}
+		})
+	}
+}
