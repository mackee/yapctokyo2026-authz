+// CanMove returns nil if the actor may move the task to the project dest (the
+// actor's authorization object for the destination): contributor or manager in
+// both projects (else ErrForbidden); contributors in either project only tasks
+// assigned to themselves, managers in both any task (else ErrForbidden);
+// neither project archived (else ErrArchived).
+func (a TaskAuthz) CanMove(dest ProjectAuthz) error {
+	if !a.CanRead() || !dest.CanRead() || !isWriterRole(a.project.role) || !isWriterRole(dest.role) {
+		return deny(ErrForbidden, "forbidden")
+	}
+	bothManager := a.project.role == RoleManager && dest.role == RoleManager
+	if !bothManager && !a.isAssignee {
+		return deny(ErrForbidden, "only the assignee may move a task unless the actor manages both projects")
+	}
+	if a.project.archived || dest.archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	return nil
+}
