+// Freeze freezes the project: every member, managers included, becomes a
+// viewer, so nobody can change its tasks. It returns the members after the
+// change, ordered by user ID. Freezing an already frozen project is a no-op
+// that returns the same list, but a caller who was a manager is now a viewer
+// and gets ErrForbidden.
+func (*ProjectTable) Freeze(ctx context.Context, db DB, authz ProjectAuthz) ([]*Membership, error) {
+	if err := authz.CanFreeze(); err != nil {
+		return nil, err
+	}
+	var members []*Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadFreezeProject(ctx, tx, authz.ProjectID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if members, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return members, nil
+}
