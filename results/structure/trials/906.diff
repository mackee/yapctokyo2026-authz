+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"other project manager", "ivy", "ops", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"manager of other project only", "ann", "ops", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"missing project", "ann", "nope", 404},
+		{"archived", "ann", "legacy", 409},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	want := `[{"userId":"ann","role":"viewer"},{"userId":"ben","role":"viewer"},{"userId":"cat","role":"viewer"},{"userId":"dan","role":"viewer"},{"userId":"ivy","role":"viewer"}]`
+	if strings.TrimSpace(body) != want {
+		t.Fatalf("got %s\nwant %s", body, want)
+	}
+}
+
+func TestFreezeBlocksTaskWrites(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d: %s", code, body)
+	}
+	cases := []struct {
+		name, user, method, path, body string
+	}{
+		{"manager create", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"manager update", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"manager delete", "ann", "DELETE", "/projects/web/tasks/t1", ""},
+		{"contributor own update", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"contributor create", "cat", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"ivy update", "ivy", "PATCH", "/projects/web/tasks/t3", `{"status":"doing"}`},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, h, c.method, c.path, c.user, c.body)
+			if code != 403 {
+				t.Fatalf("got %d want 403", code)
+			}
+		})
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t1", "ben", ""); code != 200 {
+		t.Fatalf("frozen project should stay readable, got %d", code)
+	}
+}
+
+func TestFreezeIsOneProjectAndOneShot(t *testing.T) {
+	h := newServer()
