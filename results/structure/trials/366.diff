+// changeMemberRoleAggregate changes the role of one existing member of a project.
+type changeMemberRoleAggregate struct {
+	project projectRecord
+	member  membershipRecord
+	user    userRecord // the member's user, checked against the project's organization
+	role    string
+}
+
+func loadChangeMemberRole(x *tx, projectID, userID, role string) (*changeMemberRoleAggregate, error) {
+	p, ok := x.findProject(projectID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	m, ok := p.Membership(x, userID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	u, ok := m.User(x)
+	if !ok {
+		return nil, deny(ErrInvalid, "member must belong to the project's organization")
+	}
+	return &changeMemberRoleAggregate{project: p, member: m, user: u, role: role}, nil
+}
+
+func (a *changeMemberRoleAggregate) validate() error {
+	if !isProjectRole(a.role) {
+		return deny(ErrInvalid, "role must be manager, contributor or viewer")
+	}
+	if a.user.Org != a.project.Org {
+		return deny(ErrInvalid, "member must belong to the project's organization")
+	}
+	return nil
+}
+
+func (a *changeMemberRoleAggregate) apply(x *tx) Member {
+	m := a.member
+	m.ChangeRole(x, a.role)
+	return m.view()
+}
+
