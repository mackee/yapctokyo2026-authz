+// Manage applies the manager rule: readable, manager (else 403), not archived
+// (else 409). Only managers may change project membership roles.
+func (s *projectScope) Manage() (ManageProject, error) {
+	err := s.as.a.db.view(func(x *tx) error {
+		p, r, err := readable(x, s.as.actor, s.pid)
+		if err != nil {
+			return err
+		}
+		if r != RoleManager {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if p.Archived {
+			return deny(ErrArchived, "project is archived")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &manageProject{readProject: readProject{ps: s}}, nil
+}
+
 // ---- project capabilities ----------------------------------------------------
 
+// Member is the public representation of a project membership.
+type Member struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
 // ReadProject may list and read the tasks of one project.
 type ReadProject interface {
 	ID() string
 	Tasks() []TaskView
 }
 
+// ManageProject may change the roles of the members of one project.
+type ManageProject interface {
+	ReadProject
+	// ChangeRole sets the role of an existing member of the project. The user
+	// must be a member (else 404) and the role must be manager, contributor or
+	// viewer (else 400).
+	ChangeRole(userID, role string) (Member, error)
+}
+
+type manageProject struct{ readProject }
+
+func (p *manageProject) ChangeRole(userID, role string) (Member, error) {
+	var m Member
+	err := p.ps.as.a.db.update(func(x *tx) error {
+		agg, err := loadChangeMemberRole(x, p.ps.pid, userID, role)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		m = agg.apply(x)
+		return nil
+	})
+	return m, err
+}
+
 // WriteProject may create tasks in one project and admit assignees for it.
 type WriteProject interface {
 	ReadProject
