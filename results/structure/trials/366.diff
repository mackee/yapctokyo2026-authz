+func TestChangeRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager demotes contributor", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 200},
+		{"manager promotes viewer", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"manager changes manager", "ann", "/projects/web/members/ivy", `{"role":"viewer"}`, 200},
+		{"contributor", "ben", "/projects/web/members/cat", `{"role":"viewer"}`, 403},
+		{"viewer", "dan", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"org admin", "eve", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"manager of another project only", "ann", "/projects/ops/members/cat", `{"role":"viewer"}`, 403},
+		{"non member", "hal", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"other org", "gus", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"anonymous", "", "/projects/web/members/ben", `{"role":"viewer"}`, 401},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"target unknown", "ann", "/projects/web/members/zed", `{"role":"viewer"}`, 404},
+		{"target in other org", "ann", "/projects/web/members/gus", `{"role":"viewer"}`, 404},
+		{"unknown role", "ann", "/projects/web/members/ben", `{"role":"owner"}`, 400},
+		{"empty role", "ann", "/projects/web/members/ben", `{"role":""}`, 400},
+		{"bad body", "ann", "/projects/web/members/ben", `nope`, 400},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestChangeRoleResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.UserID != "ben" || got.Role != "viewer" {
+		t.Fatalf("got %+v", got)
+	}
+}
+
+func TestChangeRolePersists(t *testing.T) {
+	srv := newServer()
+
+	// ben (contributor) is demoted to viewer: writes are refused from now on.
+	if code, body := do(t, srv, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote: got %d: %s", code, body)
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Fatalf("demoted ben create: got %d want 403", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("demoted ben read: got %d want 200", code)
+	}
+
+	// dan (viewer) is promoted to contributor: writes are allowed from now on.
+	if code, body := do(t, srv, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`); code != 200 {
+		t.Fatalf("promote: got %d: %s", code, body)
+	}
+	if code, body := do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 201 {
+		t.Fatalf("promoted dan create: got %d want 201: %s", code, body)
+	}
+
+	// Other members are untouched.
+	if code, body := do(t, srv, "POST", "/projects/web/tasks", "cat", `{"title":"x"}`); code != 201 {
+		t.Fatalf("cat create: got %d want 201: %s", code, body)
+	}
+
+	// Role changes are per project: ben keeps contributor rights in legacy,
+	// which is archived, so use ops where cat is contributor and ann is viewer.
+	if code, _ := do(t, srv, "PUT", "/projects/ops/members/cat", "ivy", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("ivy demotes cat in ops: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "POST", "/projects/ops/tasks", "cat", `{"title":"x"}`); code != 403 {
+		t.Fatalf("cat create in ops after demotion: got %d want 403", code)
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "cat", `{"title":"x"}`); code != 201 {
+		t.Fatalf("cat create in web: got %d want 201", code)
+	}
+}
