@@ -0,0 +1,123 @@
+package main
+
+import (
+	"testing"
+)
+
+func countRows(t *testing.T, h *appHandler, query string, args ...any) int {
+	t.Helper()
+	var n int
+	if err := h.db.QueryRow(query, args...).Scan(&n); err != nil {
+		t.Fatal(err)
+	}
+	return n
+}
+
+func newApp(t *testing.T) *appHandler {
+	t.Helper()
+	app, ok := newServer().(*appHandler)
+	if !ok {
+		t.Fatal("newServer did not return *appHandler")
+	}
+	return app
+}
+
+func TestRemoveUserFromOrg(t *testing.T) {
+	app := newApp(t)
+	// ben: contributor in web and legacy (archived); assigned t1 (web) and t5 (legacy).
+	code, _ := do(t, app, "DELETE", "/orgs/acme/users/ben", "eve", "")
+	if code != 204 {
+		t.Fatalf("got %d want 204", code)
+	}
+	if n := countRows(t, app, `SELECT COUNT(*) FROM memberships WHERE user_id = 'ben'`); n != 0 {
+		t.Fatalf("ben still has %d memberships (archived projects included)", n)
+	}
+	// Tasks that were assigned to ben become unassigned (keeps the assignee model rule).
+	for _, id := range []string{"t1", "t5"} {
+		if n := countRows(t, app, `SELECT COUNT(*) FROM tasks WHERE id = ? AND assignee = ''`, id); n != 1 {
+			t.Fatalf("task %s should be unassigned", id)
+		}
+	}
+	// Nothing else is touched.
+	if n := countRows(t, app, `SELECT COUNT(*) FROM memberships`); n != 11-2 {
+		t.Fatalf("want 9 memberships left, got %d", n)
+	}
+	if n := countRows(t, app, `SELECT COUNT(*) FROM tasks`); n != 6 {
+		t.Fatalf("tasks must not be deleted, got %d", n)
+	}
+	if n := countRows(t, app, `SELECT COUNT(*) FROM tasks WHERE id = 't2' AND assignee = 'cat'`); n != 1 {
+		t.Fatal("other users' tasks must keep their assignee")
+	}
+}
+
+func TestRemoveUserLosesAccess(t *testing.T) {
+	app := newApp(t)
+	if code, _ := do(t, app, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("got %d want 204", code)
+	}
+	if code, _ := do(t, app, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("removed user should no longer read the project, got %d", code)
+	}
+}
+
+func TestRemoveManagerAndViewer(t *testing.T) {
+	app := newApp(t)
+	for _, u := range []string{"ann", "dan"} {
+		if code, _ := do(t, app, "DELETE", "/orgs/acme/users/"+u, "eve", ""); code != 204 {
+			t.Fatalf("remove %s: got %d want 204", u, code)
+		}
+		if n := countRows(t, app, `SELECT COUNT(*) FROM memberships WHERE user_id = ?`, u); n != 0 {
+			t.Fatalf("%s still has memberships", u)
+		}
+	}
+}
+
+func TestRemoveUserWithoutMemberships(t *testing.T) {
+	app := newApp(t)
+	// hal is in the org but in no project: nothing to remove, still 204.
+	if code, _ := do(t, app, "DELETE", "/orgs/acme/users/hal", "eve", ""); code != 204 {
+		t.Fatalf("got %d want 204", code)
+	}
+}
+
+func TestRemoveUserIsRepeatable(t *testing.T) {
+	app := newApp(t)
+	for i := 0; i < 2; i++ {
+		if code, _ := do(t, app, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+			t.Fatalf("call %d: got %d want 204", i+1, code)
+		}
+	}
+}
+
+func TestRemoveUserAccess(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"project manager is not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"plain member", "ben", "/orgs/acme/users/cat", 403},
+		{"other org caller", "gus", "/orgs/acme/users/ben", 404},
+		{"org admin of other org path", "eve", "/orgs/globex/users/gus", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ben", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			app := newApp(t)
+			before := countRows(t, app, `SELECT COUNT(*) FROM memberships`)
+			code, _ := do(t, app, "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+			if after := countRows(t, app, `SELECT COUNT(*) FROM memberships`); after != before {
+				t.Fatalf("rejected request changed memberships: %d -> %d", before, after)
+			}
+			if n := countRows(t, app, `SELECT COUNT(*) FROM tasks WHERE assignee = ''`); n != 1 {
+				t.Fatalf("rejected request unassigned tasks (%d unassigned)", n)
+			}
+		})
+	}
+}
