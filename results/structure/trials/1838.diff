diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..fcea130
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,124 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"reflect"
+	"testing"
+)
+
+// memberEntry is one entry of the PUT /projects/{pid}/members response. It is
+// declared here, not shared with main.go, so the test pins the JSON keys.
+type memberEntry struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// webSeedMembers is the membership of project web after the seed, ordered by user ID.
+var webSeedMembers = []memberEntry{
+	{"ann", "manager"},
+	{"ben", "contributor"},
+	{"cat", "contributor"},
+	{"dan", "viewer"},
+	{"ivy", "manager"},
+}
+
+func TestSetMemberRoles(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+		members                   []memberEntry // the 200 response
+	}{
+		{
+			name: "manager promotes viewer", user: "ann", project: "web",
+			body: `{"roles":{"dan":"contributor"}}`, want: 200,
+			members: []memberEntry{{"ann", "manager"}, {"ben", "contributor"}, {"cat", "contributor"}, {"dan", "contributor"}, {"ivy", "manager"}},
+		},
+		{
+			name: "manager demotes member without tasks", user: "ann", project: "web",
+			body: `{"roles":{"ivy":"contributor"}}`, want: 200,
+			members: []memberEntry{{"ann", "manager"}, {"ben", "contributor"}, {"cat", "contributor"}, {"dan", "viewer"}, {"ivy", "contributor"}},
+		},
+		{
+			name: "several at once", user: "ann", project: "web",
+			body: `{"roles":{"dan":"contributor","ivy":"viewer"}}`, want: 200,
+			members: []memberEntry{{"ann", "manager"}, {"ben", "contributor"}, {"cat", "contributor"}, {"dan", "contributor"}, {"ivy", "viewer"}},
+		},
+		{
+			name: "same role is a no-op", user: "ann", project: "web",
+			body: `{"roles":{"ben":"contributor"}}`, want: 200,
+			members: webSeedMembers,
+		},
+		{"contributor caller", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403, nil},
+		{"viewer caller", "dan", "web", `{"roles":{"dan":"contributor"}}`, 403, nil},
+		{"org admin without role", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403, nil},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404, nil},
+		{"other org", "gus", "web", `{"roles":{"dan":"contributor"}}`, 404, nil},
+		{"anonymous", "", "web", `{"roles":{"dan":"contributor"}}`, 401, nil},
+		{"unknown user", "zed", "web", `{"roles":{"dan":"contributor"}}`, 401, nil},
+		{"unknown project", "ann", "nope", `{"roles":{"dan":"contributor"}}`, 404, nil},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409, nil},
+		{"assignee demoted to viewer", "ann", "web", `{"roles":{"ben":"viewer"}}`, 400, nil},
+		{"one bad change in a batch", "ann", "web", `{"roles":{"dan":"contributor","ben":"viewer"}}`, 400, nil},
+		{"target is not a member", "ann", "web", `{"roles":{"hal":"contributor"}}`, 400, nil},
+		{"target is in another org", "ann", "web", `{"roles":{"gus":"viewer"}}`, 400, nil},
+		{"invalid role", "ann", "web", `{"roles":{"dan":"owner"}}`, 400, nil},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400, nil},
+		{"missing roles", "ann", "web", `{}`, 400, nil},
+		{"malformed body", "ann", "web", `{"roles":`, 400, nil},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d (body %s)", code, c.want, body)
+			}
+			if c.want != http.StatusOK {
+				return
+			}
+			var got []memberEntry
+			if err := json.Unmarshal([]byte(body), &got); err != nil {
+				t.Fatalf("response is not a member list: %v: %s", err, body)
+			}
+			if !reflect.DeepEqual(got, c.members) {
+				t.Fatalf("members after change:\n got  %+v\n want %+v", got, c.members)
+			}
+		})
+	}
+}
+
+// A batch that cannot be applied in full changes nothing. The next successful
+// request shows the members as they were before the failed one.
+func TestSetMemberRolesIsAllOrNothing(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","ben":"viewer"}}`); code != http.StatusBadRequest {
+		t.Fatalf("batch with a rule violation: got %d want 400 (body %s)", code, body)
+	}
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ivy":"viewer"}}`)
+	if code != http.StatusOK {
+		t.Fatalf("got %d want 200 (body %s)", code, body)
+	}
+	want := []memberEntry{{"ann", "manager"}, {"ben", "contributor"}, {"cat", "contributor"}, {"dan", "viewer"}, {"ivy", "viewer"}}
+	var got []memberEntry
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("failed batch was partly applied:\n got  %+v\n want %+v", got, want)
+	}
+}
+
+// After a role change the new role governs access: a promoted contributor can
+// create tasks, and a demoted member cannot.
+func TestSetMemberRolesTakesEffect(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","ivy":"viewer"}}`); code != http.StatusOK {
+		t.Fatalf("promote dan, demote ivy: got %d (body %s)", code, body)
+	}
+	if code, body := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != http.StatusOK {
+		t.Fatalf("promoted dan create: got %d (body %s)", code, body)
+	}
+	if code, body := do(t, h, "POST", "/projects/web/tasks", "ivy", `{"title":"x"}`); code != http.StatusForbidden {
+		t.Fatalf("demoted ivy create: got %d want 403 (body %s)", code, body)
+	}
+}
