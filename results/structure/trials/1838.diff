+
+// setMemberRolesAggregate changes the roles of several members of one project.
+type setMemberRolesAggregate struct {
+	changes []memberRoleChange // ordered by user ID
+}
+
+type memberRoleChange struct {
+	membership *Membership
+	role       string
+	// assigned holds the member's tasks in the project. It is loaded when the new
+	// role is not a writer role, because such a member may not be assigned tasks.
+	assigned []*Task
+}
+
+func loadSetMemberRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*setMemberRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	userIDs := make([]string, 0, len(roles))
+	for id := range roles {
+		userIDs = append(userIDs, id)
+	}
+	sort.Strings(userIDs)
+	a := &setMemberRolesAggregate{}
+	for _, id := range userIDs {
+		m, err := p.Membership(ctx, tx, id)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, fmt.Sprintf("%s is not a member of the project", id))
+		} else if err != nil {
+			return nil, err
+		}
+		c := memberRoleChange{membership: m, role: roles[id]}
+		if !isWriterRole(c.role) {
+			if c.assigned, err = m.AssignedTasks(ctx, tx); err != nil {
+				return nil, err
+			}
+		}
+		a.changes = append(a.changes, c)
+	}
+	return a, nil
+}
+
+func (a *setMemberRolesAggregate) validate() error {
+	for _, c := range a.changes {
+		if !isProjectRole(c.role) {
+			return deny(ErrInvalid, fmt.Sprintf("invalid role %q", c.role))
+		}
+		if len(c.assigned) > 0 {
+			return deny(ErrInvalid, fmt.Sprintf("%s has tasks in the project and must stay a contributor or manager", c.membership.UserID))
+		}
+	}
+	return nil
+}
+
+func (a *setMemberRolesAggregate) apply(ctx context.Context, tx DB) error {
+	for _, c := range a.changes {
+		if c.membership.Role == c.role {
+			continue
+		}
+		if err := c.membership.setRole(ctx, tx, c.role); err != nil {
+			return err
+		}
+	}
+	return nil
+}
