+// SetRole changes the role of a project member and returns the membership.
+func (*MembershipTable) SetRole(ctx context.Context, db DB, authz ProjectAuthz, userID, role string) (*Membership, error) {
+	if err := authz.CanChangeRoles(); err != nil {
+		return nil, err
+	}
+	if !validRole(role) {
+		return nil, deny(ErrInvalid, "invalid role")
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadSetRole(ctx, tx, authz.ProjectID(), userID, role)
+		if err != nil {
+			return err
+		}
+		if err := authz.CanWrite(); err != nil { // archived projects reject writes
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		m, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
