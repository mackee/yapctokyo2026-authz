+// setRoleAggregate changes the role of one project member.
+type setRoleAggregate struct {
+	member   *Membership
+	role     string
+	assigned []*Task // member.AssignedTasks; loaded only when demoting to viewer
+}
+
+func loadSetRole(ctx context.Context, tx DB, projectID, userID, role string) (*setRoleAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	m, err := p.Membership(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &setRoleAggregate{member: m, role: role}
+	if role == RoleViewer {
+		if a.assigned, err = m.AssignedTasks(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	return a, nil
+}
+
+func (a *setRoleAggregate) validate() error {
+	if !validRole(a.role) {
+		return deny(ErrInvalid, "invalid role")
+	}
+	if !isWriterRole(a.role) && len(a.assigned) > 0 {
+		return deny(ErrInvalid, "member still has assigned tasks; a viewer cannot be an assignee")
+	}
+	return nil
+}
+
+func (a *setRoleAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.member.changeRole(ctx, tx, a.role); err != nil {
+		return nil, err
+	}
+	return a.member, nil
+}
