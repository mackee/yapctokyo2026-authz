+func (t *manageTask) MoveTo(toPID string) (TaskView, error) {
+	if toPID == "" {
+		return TaskView{}, deny(ErrInvalid, "toProjectId is required")
+	}
+	var v TaskView
+	err := t.ts.ps.as.a.st.tx(func(s *state) error {
+		cur := s.tasks[t.ts.tid]
+		if toPID == cur.project {
+			return deny(ErrInvalid, "task is already in that project")
+		}
+		dest, role, err := readable(s, t.ts.ps.as.actor, toPID)
+		if err != nil {
+			return err
+		}
+		if !isWriterRole(role) {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if dest.archived {
+			return deny(ErrArchived, "project is archived")
+		}
+		// Re-admit the current assignee for the destination; the assignee
+		// must be a contributor or manager there, or the move is rejected.
+		a, err := admit(s, toPID, cur.assignee.user)
+		if err != nil {
+			return err
+		}
+		cur.project = toPID
+		cur.assignee = a
+		s.tasks[cur.id] = cur
+		v = cur.view()
+		return nil
+	})
+	return v, err
+}
