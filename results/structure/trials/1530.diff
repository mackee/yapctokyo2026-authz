+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		// t4 (cat) is in ops; cat is a contributor in web, so it can move there.
+		{"manager moves", "ivy", "/projects/ops/tasks/t4", `{"toProjectId":"web"}`, 200},
+		// t3 is unassigned.
+		{"unassigned task", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 200},
+		{"assignee not in destination", "ivy", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 400},
+		{"contributor", "ben", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"viewer in destination", "ann", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 403},
+		{"org admin", "eve", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 403},
+		{"non member source", "hal", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 404},
+		{"missing destination", "ann", "/projects/web/tasks/t3", `{"toProjectId":"nope"}`, 404},
+		{"other org destination", "ann", "/projects/web/tasks/t3", `{"toProjectId":"gx"}`, 404},
+		{"archived source", "ann", "/projects/legacy/tasks/t5", `{"toProjectId":"web"}`, 409},
+		{"archived destination", "ann", "/projects/web/tasks/t3", `{"toProjectId":"legacy"}`, 409},
+		{"same project", "ann", "/projects/web/tasks/t3", `{"toProjectId":"web"}`, 400},
+		{"cross project id", "ann", "/projects/web/tasks/t4", `{"toProjectId":"ops"}`, 404},
+		{"empty body", "ann", "/projects/web/tasks/t3", `{}`, 400},
+		{"anonymous", "", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsFields(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/ops/tasks/t4/move", "ivy", `{"toProjectId":"web"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got Task
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t4", ProjectID: "web", Title: "Rotate keys", Status: "open", Assignee: "cat"}
+	if got != want {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+	// It is now in web and gone from ops.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t4", "ann", ""); code != 200 {
+		t.Fatalf("task not in destination: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks/t4", "ivy", ""); code != 404 {
+		t.Fatalf("task still in source: %d", code)
+	}
+}
