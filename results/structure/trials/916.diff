+// updateMemberRolesAggregate changes the roles of several members of one project.
+type updateMemberRolesAggregate struct {
+	targets []*Membership // the named members, ordered by user ID
+	roles   map[string]string
+}
+
+func loadUpdateMemberRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*updateMemberRolesAggregate, error) {
+	a := &updateMemberRolesAggregate{roles: roles}
+	for _, userID := range slices.Sorted(maps.Keys(roles)) {
+		m, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "every user must be a member of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		a.targets = append(a.targets, m)
+	}
+	return a, nil
+}
+
+func (a *updateMemberRolesAggregate) validate() error {
+	for _, m := range a.targets {
+		if !isValidRole(a.roles[m.UserID]) {
+			return deny(ErrInvalid, "role must be manager, contributor or viewer")
+		}
+	}
+	return nil
+}
+
+func (a *updateMemberRolesAggregate) apply(ctx context.Context, tx DB) error {
+	for _, m := range a.targets {
+		if err := m.changeRole(ctx, tx, a.roles[m.UserID]); err != nil {
+			return err
+		}
+	}
+	return nil
+}
