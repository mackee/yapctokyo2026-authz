+func TestUpdateMembers(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager promotes and demotes", "ann", "web", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 200},
+		{"manager demotes manager", "ann", "web", `{"roles":{"ivy":"viewer"}}`, 200},
+		{"manager no-op", "ann", "web", `{"roles":{"cat":"contributor"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"ben":"viewer"}}`, 403},
+		{"viewer in ops", "ann", "ops", `{"roles":{"cat":"viewer"}}`, 403},
+		{"org admin without role", "eve", "web", `{"roles":{"ben":"viewer"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"ben":"viewer"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"ben":"viewer"}}`, 404},
+		{"unknown project", "ann", "nope", `{"roles":{"ben":"viewer"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"ben":"viewer"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"bad role", "ann", "web", `{"roles":{"ben":"admin"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"empty user id", "ann", "web", `{"roles":{"":"viewer"}}`, 400},
+		{"target not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"one bad target of several", "ann", "web", `{"roles":{"ben":"viewer","hal":"viewer"}}`, 400},
+		{"malformed body", "ann", "web", `{"roles":`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMembersResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann",
+		`{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []Member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []Member{
+		{UserID: "ann", Role: "manager"},
+		{UserID: "ben", Role: "viewer"},
+		{UserID: "cat", Role: "contributor"},
+		{UserID: "dan", Role: "contributor"},
+		{UserID: "ivy", Role: "manager"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %d members, want %d: %s", len(got), len(want), body)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("member %d: got %+v want %+v", i, got[i], want[i])
+		}
+	}
+}
+
+func TestUpdateMembersAllOrNothing(t *testing.T) {
+	h := newServer()
+	// ben is a valid target, hal is not a member: the whole request is refused.
+	if code, body := do(t, h, "PUT", "/projects/web/members", "ann",
+		`{"roles":{"ben":"viewer","hal":"viewer"}}`); code != 400 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	// A later successful request shows the state: ben must still be a contributor.
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"viewer"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []Member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	for _, m := range got {
+		if m.UserID == "ben" && m.Role != "contributor" {
+			t.Fatalf("ben changed to %q by a refused request", m.Role)
+		}
+	}
+}
