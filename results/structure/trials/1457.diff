+func TestSetMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, project, target, body string
+		want                              int
+	}{
+		{"manager promotes viewer", "ann", "web", "dan", `{"role":"contributor"}`, 200},
+		{"manager demotes member without tasks", "ann", "web", "ivy", `{"role":"viewer"}`, 200},
+		{"manager demotes member with assigned task", "ann", "web", "ben", `{"role":"viewer"}`, 409},
+		{"manager sets same role", "ann", "web", "ben", `{"role":"contributor"}`, 200},
+		{"contributor caller", "ben", "web", "cat", `{"role":"viewer"}`, 403},
+		{"viewer caller", "dan", "web", "ben", `{"role":"viewer"}`, 403},
+		{"org admin caller", "eve", "web", "dan", `{"role":"manager"}`, 403},
+		{"non member caller", "hal", "web", "dan", `{"role":"viewer"}`, 404},
+		{"other org caller", "gus", "web", "dan", `{"role":"viewer"}`, 404},
+		{"anonymous", "", "web", "dan", `{"role":"viewer"}`, 401},
+		{"unknown user caller", "zed", "web", "dan", `{"role":"viewer"}`, 401},
+		{"missing project", "ann", "nope", "dan", `{"role":"viewer"}`, 404},
+		{"target not a member", "ann", "web", "hal", `{"role":"viewer"}`, 404},
+		{"target in other org", "ann", "web", "gus", `{"role":"viewer"}`, 404},
+		{"archived", "ann", "legacy", "ben", `{"role":"viewer"}`, 409},
+		{"unknown role", "ann", "web", "dan", `{"role":"owner"}`, 400},
+		{"empty role", "ann", "web", "dan", `{"role":""}`, 400},
+		{"invalid body", "ann", "web", "dan", `nope`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members/"+c.target, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMemberRoleResponseAndEffect(t *testing.T) {
+	h := newServer()
+
+	code, body := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatalf("promote: got %d: %s", code, body)
+	}
+	var got struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.UserID != "dan" || got.Role != "contributor" {
+		t.Fatalf("body = %s", body)
+	}
+	// dan was a viewer, so creating a task was forbidden; now the new role allows it.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("dan after promotion: create got %d want 200", code)
+	}
+
+	code, body = do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"viewer"}`)
+	if code != 200 {
+		t.Fatalf("demote: got %d: %s", code, body)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"y"}`); code != 403 {
+		t.Fatalf("dan after demotion: create got %d want 403", code)
+	}
+}
+
+func TestRejectedDemotionKeepsRole(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 409 {
+		t.Fatalf("got %d want 409", code)
+	}
+	// ben still holds t1 and is still a contributor, so may update it.
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ben update after rejected demotion: got %d want 200", code)
+	}
+}
