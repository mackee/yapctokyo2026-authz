+type memberRoleRequest struct {
+	Role string `json:"role"`
+}
+
+type memberRoleResponse struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func (s *server) setMemberRole(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role, err := findRole(ctx, s.db, project.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req memberRoleRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	if req.Role != RoleManager && req.Role != RoleContributor && req.Role != RoleViewer {
+		writeError(w, 400, "role must be manager, contributor or viewer")
+		return
+	}
+	targetID := r.PathValue("uid")
+	targetRole, err := findRole(ctx, s.db, project.ID, targetID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if targetRole == "" {
+		writeError(w, 404, "not found")
+		return
+	}
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+	// Tasks may only be assigned to contributors and managers, so a member who
+	// still holds assigned tasks cannot become a viewer.
+	if req.Role == RoleViewer {
+		var assigned int
+		if err := tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM tasks WHERE project_id = ? AND assignee = ?`, project.ID, targetID).Scan(&assigned); err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+		if assigned > 0 {
+			writeError(w, 409, "member has tasks assigned in this project; reassign them first")
+			return
+		}
+	}
+	if _, err := tx.ExecContext(ctx, `UPDATE memberships SET role = ? WHERE project_id = ? AND user_id = ?`,
+		req.Role, project.ID, targetID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, memberRoleResponse{UserID: targetID, Role: req.Role})
+}
