@@ -0,0 +1,124 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+// TestTransferDenied lists transfers that must fail. Only org admins of the
+// user's current organization may transfer; other organizations see 404.
+func TestTransferDenied(t *testing.T) {
+	const ok = `{"toOrgId":"globex"}`
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"anonymous", "", "/orgs/acme/users/ben/transfer", ok, 401},
+		{"unknown user", "zed", "/orgs/acme/users/ben/transfer", ok, 401},
+		{"contributor in same org", "ben", "/orgs/acme/users/cat/transfer", ok, 403},
+		{"manager in same org", "ann", "/orgs/acme/users/ben/transfer", ok, 403},
+		{"viewer in same org", "dan", "/orgs/acme/users/ben/transfer", ok, 403},
+		{"member with no roles in same org", "hal", "/orgs/acme/users/ben/transfer", ok, 403},
+		{"admin of another org, path is other org", "gus", "/orgs/acme/users/ben/transfer", ok, 404},
+		{"org admin, path is other org", "eve", "/orgs/globex/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"org admin, user in other org", "eve", "/orgs/acme/users/gus/transfer", ok, 404},
+		{"org admin, unknown user", "eve", "/orgs/acme/users/zed/transfer", ok, 404},
+		{"transfer to same org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"acme"}`, 400},
+		{"empty toOrgId", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":""}`, 400},
+		{"missing toOrgId", "eve", "/orgs/acme/users/ben/transfer", `{}`, 400},
+		{"malformed body", "eve", "/orgs/acme/users/ben/transfer", `{`, 400},
+		{"malformed body from non-admin", "ben", "/orgs/acme/users/ben/transfer", `{}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["id"] != "ben" || got["orgId"] != "globex" || len(got) != 2 {
+		t.Fatalf("got %s", body)
+	}
+}
+
+// TestTransferEffects runs one server through a transfer and checks what the
+// user loses: memberships and assignments in the old organization, and the
+// org admin role.
+func TestTransferEffects(t *testing.T) {
+	h := newServer()
+	task := func(user, path string) map[string]any {
+		t.Helper()
+		code, body := do(t, h, "GET", path, user, "")
+		if code != 200 {
+			t.Fatalf("GET %s as %s: got %d body=%s", path, user, code, body)
+		}
+		var m map[string]any
+		if err := json.Unmarshal([]byte(body), &m); err != nil {
+			t.Fatal(err)
+		}
+		return m
+	}
+	expectCode := func(user, method, path, body string, want int) {
+		t.Helper()
+		if code, b := do(t, h, method, path, user, body); code != want {
+			t.Fatalf("%s %s as %s: got %d want %d body=%s", method, path, user, code, want, b)
+		}
+	}
+
+	if got := task("ann", "/projects/web/tasks/t1")["assignee"]; got != "ben" {
+		t.Fatalf("before: t1 assignee = %v, want ben", got)
+	}
+	if got := task("ann", "/projects/legacy/tasks/t5")["assignee"]; got != "ben" {
+		t.Fatalf("before: t5 assignee = %v, want ben", got)
+	}
+
+	expectCode("eve", "POST", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 200)
+
+	// Ben's assignments in acme projects are cleared; other assignments stay.
+	if got := task("ann", "/projects/web/tasks/t1")["assignee"]; got != "" {
+		t.Fatalf("after: t1 assignee = %v, want unassigned", got)
+	}
+	if got := task("ann", "/projects/legacy/tasks/t5")["assignee"]; got != "" {
+		t.Fatalf("after: t5 assignee = %v, want unassigned", got)
+	}
+	if got := task("ann", "/projects/web/tasks/t2")["assignee"]; got != "cat" {
+		t.Fatalf("after: t2 assignee = %v, want cat", got)
+	}
+
+	// Ben is now a globex user with no roles there: no acme project, no globex project.
+	expectCode("ben", "GET", "/projects/web/tasks", "", 404)
+	expectCode("ben", "GET", "/projects/legacy/tasks/t5", "", 404)
+	expectCode("ben", "GET", "/projects/gx/tasks", "", 404)
+
+	// The acme admin no longer sees Ben; globex users can't be moved from acme.
+	expectCode("eve", "POST", "/orgs/acme/users/ben/transfer", `{"toOrgId":"acme"}`, 404)
+}
+
+// TestTransferClearsOrgAdmin checks that an org admin who moves keeps no admin
+// rights in the new organization.
+func TestTransferClearsOrgAdmin(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer self: got %d body=%s", code, body)
+	}
+	// Eve is now a globex user without admin rights: she is not an admin of globex.
+	if code, body := do(t, h, "POST", "/orgs/globex/users/gus/transfer", "eve", `{"toOrgId":"acme"}`); code != 403 {
+		t.Fatalf("got %d want 403 body=%s", code, body)
+	}
+	// And she has lost her old organization.
+	if code, body := do(t, h, "GET", "/projects/ops/tasks", "eve", ""); code != 404 {
+		t.Fatalf("got %d want 404 body=%s", code, body)
+	}
+}
