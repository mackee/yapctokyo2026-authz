+// OrgAuthz is what the actor may do in one organization.
+type OrgAuthz struct {
+	actor Actor
+	org   string
+}
+
+// OrgID returns the organization the object is bound to.
+func (a OrgAuthz) OrgID() string { return a.org }
+
+// CanManageUsers returns nil if the actor may move users of the organization:
+// org admins only (else ErrForbidden).
+func (a OrgAuthz) CanManageUsers() error {
+	if a.org == "" || !a.actor.orgAdmin {
+		return deny(ErrForbidden, "only org admins may transfer users")
+	}
+	return nil
+}
+
+// UserAuthz is what the actor may do with one user of one organization.
+type UserAuthz struct {
+	org  OrgAuthz
+	user string
+}
+
+// UserID returns the user the object is bound to.
+func (a UserAuthz) UserID() string { return a.user }
+
+// Org returns the organization-level authorization the user object came from.
+func (a UserAuthz) Org() OrgAuthz { return a.org }
+
+// CanTransfer returns nil if the actor may move the user to another
+// organization: org admins of the user's current organization (else ErrForbidden).
+func (a UserAuthz) CanTransfer() error { return a.org.CanManageUsers() }
