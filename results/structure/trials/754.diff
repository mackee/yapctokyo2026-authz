+// UserTableTransferInput is the input of UserTable.Transfer.
+type UserTableTransferInput struct {
+	ToOrgID string
+}
+
+// Transfer moves the user to another organization, all or nothing. The
+// memberships and assignments the user has outside the new organization are
+// removed, and the org admin role is cleared. Only org admins of the user's
+// current organization may do this (authz.CanTransfer).
+func (*UserTable) Transfer(ctx context.Context, db DB, authz UserAuthz, in UserTableTransferInput) (*User, error) {
+	if err := authz.CanTransfer(); err != nil {
+		return nil, err
+	}
+	if in.ToOrgID == "" {
+		return nil, deny(ErrInvalid, "toOrgId must not be empty")
+	}
+	if in.ToOrgID == authz.Org().OrgID() {
+		return nil, deny(ErrInvalid, "user is already in that organization")
+	}
+	var u *User
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadTransferUser(ctx, tx, authz.UserID(), in.ToOrgID)
+		if err != nil {
+			return err
+		}
+		if agg.user.Org != authz.Org().OrgID() {
+			return deny(ErrNotFound, "not found")
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if u, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return u, nil
+}
