+type OrgScope interface {
+	Manage() (ManageOrg, error)
+}
+
+// ManageOrg is the org-admin capability for one organization.
+type ManageOrg interface {
+	// Transfer moves a user of this organization to toOrgID. A user who is not
+	// in this organization is 404; an unknown or identical destination is 400.
+	Transfer(userID, toOrgID string) (UserView, error)
+}
+
+// UserView is the public representation of a user's organization.
