+// moveUser moves a user to another organization. The user keeps no privileges
+// there: the org-admin flag is cleared, and all project roles are dropped
+// (project members must belong to the project's organization), so tasks the
+// user was assigned to become unassigned.
+func (s *state) moveUser(userID, toOrg string) {
+	u := s.users[userID]
+	u.org = toOrg
+	u.orgAdmin = false
+	s.users[userID] = u
+	for _, m := range s.members {
+		delete(m, userID)
+	}
+	for tid, t := range s.tasks {
+		if t.assignee.user == userID {
+			t.assignee = Assignee{project: t.project}
+			s.tasks[tid] = t
+		}
+	}
+}
