+func TestTransfer(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 200},
+		{"manager of member", "ann", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 403},
+		{"viewer", "dan", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 403},
+		{"other org admin", "gus", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 404},
+		{"unknown org", "eve", "/orgs/initech/users/ben/transfer", `{"toOrgId":"globex"}`, 404},
+		{"anonymous", "", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 401},
+		{"user not in org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"unknown destination", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"initech"}`, 400},
+		{"same organization", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"acme"}`, 400},
+		{"missing toOrgId", "eve", "/orgs/acme/users/ben/transfer", `{}`, 400},
+		{"empty body", "eve", "/orgs/acme/users/ben/transfer", ``, 400},
+		{"malformed body", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200 (%s)", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["id"] != "ben" || got["orgId"] != "globex" || len(got) != 2 {
+		t.Fatalf("unexpected body: %s", body)
+	}
+}
+
+func TestTransferEffects(t *testing.T) {
+	authz := newServer()
+
+	// ben leaves acme: loses access to acme projects and joins globex.
+	if code, body := do(t, authz, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: %d %s", code, body)
+	}
+	if code, _ := do(t, authz, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads acme project after transfer: got %d want 404", code)
+	}
+	if code, _ := do(t, authz, "GET", "/projects/legacy/tasks/t5", "ben", ""); code != 404 {
+		t.Fatalf("ben reads legacy after transfer: got %d want 404", code)
+	}
+	// Tasks ben held in acme are unassigned, not left pointing at a non-member.
+	code, body := do(t, authz, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("get t1: %d %s", code, body)
+	}
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" {
+		t.Fatalf("t1 still assigned to %q after transfer", task.Assignee)
+	}
+}
+
+func TestTransferDropsAdminRights(t *testing.T) {
+	authz := newServer()
+
+	// eve is acme's only org admin. Moving her out must not leave her with
+	// admin rights in globex.
+	if code, body := do(t, authz, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: %d %s", code, body)
+	}
+	if code, _ := do(t, authz, "GET", "/projects/gx/tasks", "eve", ""); code != 404 {
+		t.Fatalf("eve reads globex project: got %d want 404", code)
+	}
+	if code, _ := do(t, authz, "GET", "/projects/ops/tasks", "eve", ""); code != 404 {
+		t.Fatalf("eve reads acme project: got %d want 404", code)
+	}
+	if code, _ := do(t, authz, "POST", "/orgs/globex/users/hal/transfer", "eve", `{"toOrgId":"acme"}`); code != 403 {
+		t.Fatalf("former acme admin manages globex: got %d want 403", code)
+	}
+}
