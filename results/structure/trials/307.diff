@@ -139,6 +159,52 @@ func (s *actorScope) Actor() Actor { return s.actor }
 func (s *actorScope) Project(projectID string) ProjectScope {
 	return &projectScope{as: s, pid: projectID}
 }
+func (s *actorScope) Org(orgID string) OrgScope {
+	return &orgScope{as: s, orgID: orgID}
+}
+
+type orgScope struct {
+	as    *actorScope
+	orgID string
+}
+
+// Manage applies the org-admin rule: the organization must be the actor's own
+// (else 404, so other organizations are invisible), and the actor must be its
+// org admin (else 403).
+func (s *orgScope) Manage() (ManageOrg, error) {
+	if s.as.actor.org != s.orgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if !s.as.actor.orgAdmin {
+		return nil, deny(ErrForbidden, "forbidden")
+	}
+	return &manageOrg{os: s}, nil
+}
+
+type manageOrg struct{ os *orgScope }
+
+func (m *manageOrg) Transfer(userID, toOrgID string) (UserView, error) {
+	if toOrgID == "" {
+		return UserView{}, deny(ErrInvalid, "toOrgId is required")
+	}
+	var v UserView
+	err := m.os.as.a.st.tx(func(s *state) error {
+		u, ok := s.users[userID]
+		if !ok || u.org != m.os.orgID {
+			return deny(ErrNotFound, "not found")
+		}
+		if !s.orgs[toOrgID] {
+			return deny(ErrInvalid, "unknown organization")
+		}
+		if toOrgID == u.org {
+			return deny(ErrInvalid, "user is already in that organization")
+		}
+		s.moveUser(userID, toOrgID)
+		v = UserView{ID: userID, OrgID: toOrgID}
+		return nil
+	})
+	return v, err
+}
 
