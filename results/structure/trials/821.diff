+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes user with no memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"org admin removes again", "eve", "/orgs/acme/users/ben", 204},
+		{"project manager is not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"contributor is not org admin", "ben", "/orgs/acme/users/cat", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"admin of other org", "gus", "/orgs/acme/users/ben", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ben", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffect(t *testing.T) {
+	s := newServer()
+	if code, body := do(t, s, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d %s", code, body)
+	}
+	// ben is gone from every acme project, including the archived one.
+	for _, path := range []string{"/projects/web/tasks", "/projects/ops/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, s, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("ben GET %s: got %d want 404", path, code)
+		}
+	}
+	if code, _ := do(t, s, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 404 {
+		t.Fatalf("ben POST: got %d want 404", code)
+	}
+	// Other members and other orgs are unaffected.
+	if code, _ := do(t, s, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat GET web: got %d want 200", code)
+	}
+	if code, _ := do(t, s, "GET", "/projects/web/tasks", "eve", ""); code != 200 {
+		t.Fatalf("eve GET web: got %d want 200", code)
+	}
+	if code, _ := do(t, s, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatalf("gus GET gx: got %d want 200", code)
+	}
+}
