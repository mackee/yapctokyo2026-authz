@@ -0,0 +1,118 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func getMembersRoles(t *testing.T, body string) map[string]string {
+	t.Helper()
+	var ms []member
+	if err := json.Unmarshal([]byte(body), &ms); err != nil {
+		t.Fatalf("bad body %q: %v", body, err)
+	}
+	m := map[string]string{}
+	for _, x := range ms {
+		m[x.UserID] = x.Role
+	}
+	return m
+}
+
+func TestUpdateMembers(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	roles := getMembersRoles(t, body)
+	want := map[string]string{"ann": "manager", "ben": "viewer", "cat": "contributor", "dan": "contributor", "ivy": "manager"}
+	if len(roles) != len(want) {
+		t.Fatalf("got %v want %v", roles, want)
+	}
+	for k, v := range want {
+		if roles[k] != v {
+			t.Fatalf("got %v want %v", roles, want)
+		}
+	}
+	// ben became a viewer, so t1 must have been unassigned (model rules are
+	// checked by do()); dan can now work on tasks.
+	code, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 || getTaskAssignee(t, body) != "" {
+		t.Fatalf("t1: %d %s", code, body)
+	}
+}
+
+func getTaskAssignee(t *testing.T, body string) string {
+	t.Helper()
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	return task.Assignee
+}
+
+func TestUpdateMembersAllOrNothing(t *testing.T) {
+	bodies := map[string]string{
+		"invalid role":  `{"roles":{"ben":"viewer","dan":"admin"}}`,
+		"non member":    `{"roles":{"ben":"viewer","hal":"viewer"}}`,
+		"other org":     `{"roles":{"ben":"viewer","gus":"viewer"}}`,
+		"empty":         `{"roles":{}}`,
+		"missing roles": `{}`,
+		"bad json":      `nope`,
+	}
+	for name, b := range bodies {
+		t.Run(name, func(t *testing.T) {
+			h := newServer()
+			code, _ := do(t, h, "PUT", "/projects/web/members", "ann", b)
+			if code != 400 {
+				t.Fatalf("got %d want 400", code)
+			}
+			code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+			if code != 200 || getTaskAssignee(t, body) != "ben" {
+				t.Fatalf("t1 changed: %d %s", code, body)
+			}
+			// ben must still be a contributor: he can still modify his task.
+			code, _ = do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"doing"}`)
+			if code != 200 {
+				t.Fatalf("ben lost his role: %d", code)
+			}
+		})
+	}
+}
+
+func TestUpdateMembersAccess(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager", "ivy", "/projects/web/members", 200},
+		{"contributor", "ben", "/projects/web/members", 403},
+		{"viewer", "dan", "/projects/web/members", 403},
+		{"org admin", "eve", "/projects/web/members", 403},
+		{"non member", "hal", "/projects/web/members", 404},
+		{"other org", "gus", "/projects/web/members", 404},
+		{"missing project", "ann", "/projects/nope/members", 404},
+		{"anonymous", "", "/projects/web/members", 401},
+		{"archived", "ann", "/projects/legacy/members", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, `{"roles":{"dan":"contributor"}}`)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMembersForbiddenChangesNothing(t *testing.T) {
+	h := newServer()
+	code, _ := do(t, h, "PUT", "/projects/web/members", "ben", `{"roles":{"ben":"manager"}}`)
+	if code != 403 {
+		t.Fatalf("got %d want 403", code)
+	}
+	code, _ = do(t, h, "DELETE", "/projects/web/tasks/t1", "ben", "")
+	if code != 403 {
+		t.Fatalf("ben escalated: %d", code)
+	}
+}
