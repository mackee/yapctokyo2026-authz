+func TestUpdateMembers(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"contributor", "ben", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 403},
+		{"viewer", "dan", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin", "eve", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 403},
+		{"non member", "hal", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 404},
+		{"other org", "gus", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 404},
+		{"anonymous", "", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 401},
+		{"archived", "ann", "/projects/legacy/members", `{"roles":{"ben":"viewer"}}`, 409},
+		{"invalid role", "ann", "/projects/web/members", `{"roles":{"ben":"boss"}}`, 400},
+		{"non member target", "ann", "/projects/web/members", `{"roles":{"hal":"viewer"}}`, 400},
+		{"empty", "ann", "/projects/web/members", `{"roles":{}}`, 400},
+		{"bad body", "ann", "/projects/web/members", `nope`, 400},
+		{"no manager left", "ann", "/projects/web/members", `{"roles":{"ann":"viewer","ivy":"viewer"}}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMembersResult(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got []member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []member{{"ann", "manager"}, {"ben", "viewer"}, {"cat", "contributor"}, {"dan", "contributor"}, {"ivy", "manager"}}
+	if len(got) != len(want) {
+		t.Fatalf("got %v", got)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("got %v want %v", got, want)
+		}
+	}
+	// ben was demoted to viewer: his task is released.
+	_, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" {
+		t.Fatalf("task still assigned to %q", task.Assignee)
+	}
+}
+
+func TestUpdateMembersAtomic(t *testing.T) {
+	h := newServer()
+	// the second change is invalid (hal is not a member): nothing may change.
+	code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","hal":"viewer"}}`)
+	if code != 400 {
+		t.Fatal(code)
+	}
+	_, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "ben" {
+		t.Fatalf("task assignee changed to %q", task.Assignee)
+	}
+	// ben is still a contributor, so he can still modify his task.
+	code, _ = do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`)
+	if code != 200 {
+		t.Fatalf("ben lost his role: %d", code)
+	}
+}
