+// RemoveFromOrg removes the user from every project of the organization, all
+// or nothing: the user's memberships in those projects are deleted, and the
+// tasks the user was assigned there are unassigned. The user row itself is
+// kept. Only org admins of the organization may do this (else ErrForbidden);
+// a user outside the organization is ErrNotFound. A user with no memberships
+// left is a no-op.
+func (*UserTable) RemoveFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanManageMembers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveFromOrg(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
