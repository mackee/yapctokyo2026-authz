+
+func TestRemoveFromOrgEffects(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d: %s", code, body)
+	}
+
+	// ben's memberships are gone: no access to web or legacy (archived).
+	for _, path := range []string{"/projects/web/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, srv, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("ben GET %s: got %d want 404", path, code)
+		}
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 404 {
+		t.Fatalf("ben POST: got %d want 404", code)
+	}
+
+	// Tasks ben was assigned are unassigned (an assignee must be a member);
+	// other assignments are untouched.
+	code, body := do(t, srv, "GET", "/projects/web/tasks", "ann", "")
+	if code != 200 {
+		t.Fatalf("list web: got %d", code)
+	}
+	var tasks []Task
+	if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+		t.Fatal(err)
+	}
+	assignees := map[string]string{}
+	for _, task := range tasks {
+		assignees[task.ID] = task.AssigneeID
+	}
+	if assignees["t1"] != "" {
+		t.Fatalf("t1 still assigned to %q", assignees["t1"])
+	}
+	if assignees["t2"] != "cat" {
+		t.Fatalf("t2 assignee = %q, want cat", assignees["t2"])
+	}
+	code, body = do(t, srv, "GET", "/projects/legacy/tasks/t5", "ann", "")
+	if code != 200 {
+		t.Fatalf("get t5: got %d", code)
+	}
+	var t5 Task
+	if err := json.Unmarshal([]byte(body), &t5); err != nil {
+		t.Fatal(err)
+	}
+	if t5.AssigneeID != "" {
+		t.Fatalf("t5 still assigned to %q", t5.AssigneeID)
+	}
+
+	// Other members keep their access.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat lost access to web: got %d", code)
+	}
+
+	// Removing again is a no-op.
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("second remove: got %d want 204", code)
+	}
+}
