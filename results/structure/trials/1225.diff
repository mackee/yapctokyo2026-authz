+
+// removeFromOrgAggregate removes one user from every project of an
+// organization. It starts from the user (found through the users table, and
+// checked to belong to the organization) and loads the user's memberships in
+// the organization's projects. Applying it deletes those memberships and
+// unassigns the user's tasks in those projects, so no task is left assigned to
+// a non-member.
+type removeFromOrgAggregate struct {
+	user        *User
+	memberships []*Membership
+}
+
+func loadRemoveFromOrg(ctx context.Context, tx DB, orgID, userID string) (*removeFromOrgAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != orgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	ms, err := NewMembershipTable().ListByOrgUser(ctx, tx, orgID, u.ID)
+	if err != nil {
+		return nil, err
+	}
+	return &removeFromOrgAggregate{user: u, memberships: ms}, nil
+}
+
+func (a *removeFromOrgAggregate) validate() error { return nil }
+
+func (a *removeFromOrgAggregate) apply(ctx context.Context, tx DB) error {
+	for _, m := range a.memberships {
+		tasks, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return err
+		}
+		for _, t := range tasks {
+			if err := t.unassign(ctx, tx); err != nil {
+				return err
+			}
+		}
+		if err := m.destroy(ctx, tx); err != nil {
+			return err
+		}
+	}
+	return nil
+}
