+package main
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+// Freezing a project: POST /projects/{pid}/freeze demotes every member
+// (managers included) to viewer and returns the resulting member list.
+// While frozen, nobody can change the project's tasks.
+
+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager freezes", "ann", "web", 200},
+		{"manager of other project freezes", "ivy", "ops", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+		{"missing project", "ann", "nope", 404},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestFreezeResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("body is not a JSON array of objects: %v: %s", err, body)
+	}
+	// Members of web, sorted by userId; every one is now a viewer.
+	want := []struct{ userID, role string }{
+		{"ann", "viewer"}, {"ben", "viewer"}, {"cat", "viewer"}, {"dan", "viewer"}, {"ivy", "viewer"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %d members want %d: %s", len(got), len(want), body)
+	}
+	for i, m := range got {
+		if len(m) != 2 {
+			t.Fatalf("member %d has fields %v, want only userId and role", i, m)
+		}
+		if m["userId"] != want[i].userID || m["role"] != want[i].role {
+			t.Fatalf("member %d = %v, want userId=%s role=%s", i, m, want[i].userID, want[i].role)
+		}
+	}
+}
+
+func TestFreezeBlocksTaskWrites(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze got %d: %s", code, body)
+	}
+
+	writes := []struct{ name, user, method, path, body string }{
+		{"manager update", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"contributor own update", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"manager create", "ivy", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"contributor create", "cat", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"manager delete", "ann", "DELETE", "/projects/web/tasks/t1", ""},
+	}
+	for _, c := range writes {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, srv, c.method, c.path, c.user, c.body)
+			if code != 403 {
+				t.Fatalf("got %d want 403: %s", code, body)
+			}
+		})
+	}
+
+	// Reads still work, and the rejected update did not change t1.
+	code, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ben", "")
+	if code != 200 {
+		t.Fatalf("read after freeze got %d: %s", code, body)
+	}
+	if want := `"status":"open"`; !strings.Contains(body, want) {
+		t.Fatalf("t1 changed while frozen: %s", body)
+	}
+}
+
+func TestFreezeOnlyAffectsThatProject(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze got %d: %s", code, body)
+	}
+	// ivy is still a manager of ops, and cat still a contributor there.
+	if code, body := do(t, srv, "POST", "/projects/ops/tasks", "ivy", `{"title":"x"}`); code != 200 {
+		t.Fatalf("ops create after web freeze got %d: %s", code, body)
+	}
+	if code, body := do(t, srv, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ops update after web freeze got %d: %s", code, body)
+	}
+}
