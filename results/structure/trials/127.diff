+	"taskboard/internal/capability"
+)
+
+// webMembersAfterFreeze is the member list of "web" once it is frozen: every
+// member, including the former manager ann and ivy, is a viewer.
+var webMembersAfterFreeze = []capability.MemberView{
+	{UserID: "ann", Role: "viewer"},
+	{UserID: "ben", Role: "viewer"},
+	{UserID: "cat", Role: "viewer"},
+	{UserID: "dan", Role: "viewer"},
+	{UserID: "ivy", Role: "viewer"},
+}
+
+func decodeMembers(t *testing.T, body string) []capability.MemberView {
+	t.Helper()
+	var members []capability.MemberView
+	if err := json.Unmarshal([]byte(body), &members); err != nil {
+		t.Fatalf("decode %q: %v", body, err)
+	}
+	return members
+}
+
+func TestFreezeResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	if got := decodeMembers(t, body); !reflect.DeepEqual(got, webMembersAfterFreeze) {
+		t.Fatalf("members = %+v, want %+v", got, webMembersAfterFreeze)
+	}
+}
+
+func TestFreezeAuthorization(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ivy", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"archived", "ann", "legacy", 409},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeBlocksTaskChanges(t *testing.T) {
+	h := newServer()
+
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d want 200: %s", code, body)
+	}
+
+	cases := []struct {
+		name, user, method, path, body string
+		want                           int
+	}{
+		{"former manager edits", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"former contributor edits own", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`, 403},
+		{"former manager reassigns", "ivy", "PATCH", "/projects/web/tasks/t1", `{"assignee":"cat"}`, 403},
+		{"former manager creates", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"former contributor creates", "ben", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"former manager deletes", "ann", "DELETE", "/projects/web/tasks/t1", "", 403},
+		{"former manager cannot refreeze", "ivy", "POST", "/projects/web/freeze", "", 403},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, h, c.method, c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+
+	// Reads still work, and nothing changed.
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ben", "")
+	if code != 200 {
+		t.Fatalf("read after freeze: got %d want 200", code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.Status != "open" || task.Assignee != "ben" {
+		t.Fatalf("task changed by frozen project: %+v", task)
+	}
+}
+
+func TestFreezeKeepsOtherProjectsWritable(t *testing.T) {
+	h := newServer()
+
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d want 200: %s", code, body)
+	}
+
+	// cat is a contributor of ops, and t4 is assigned to cat. The store must still
+	// commit writes after the freeze, even though web tasks are assigned to users
+	// who are now viewers.
+	code, body := do(t, h, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`)
+	if code != 200 {
+		t.Fatalf("write to unfrozen project: got %d want 200: %s", code, body)
+	}
+}
