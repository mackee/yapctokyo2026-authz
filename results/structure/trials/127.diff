diff --git a/internal/capability/freeze_test.go b/internal/capability/freeze_test.go
new file mode 100644
index 0000000..ad1df6c
--- /dev/null
+++ b/internal/capability/freeze_test.go
@@ -0,0 +1,106 @@
+package capability
+
+import (
+	"errors"
+	"reflect"
+	"testing"
+)
+
+// freezeWithoutDemotion marks "web" frozen but leaves its managers in place, so
+// the frozen check is the only thing that can stop their writes. The HTTP
+// freeze never produces this state; this checks the rule itself.
+func freezeWithoutDemotion(t *testing.T, a *Authorizer, pid string) {
+	t.Helper()
+	if err := a.st.tx(func(s *state) error {
+		p := s.projects[pid]
+		p.frozen = true
+		s.projects[pid] = p
+		return nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func actorFor(t *testing.T, a *Authorizer, id string) ActorScope {
+	t.Helper()
+	act, err := a.Authenticate(id)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return act
+}
+
+func TestFrozenRejectsWritesEvenForManagers(t *testing.T) {
+	a := New()
+	freezeWithoutDemotion(t, a, "web")
+	ann := actorFor(t, a, "ann")
+
+	if _, err := ann.Project("web").Write(); !errors.Is(err, ErrFrozen) {
+		t.Fatalf("Write: got %v want ErrFrozen", err)
+	}
+	if _, err := ann.Project("web").Task("t2").Edit(); !errors.Is(err, ErrFrozen) {
+		t.Fatalf("Edit: got %v want ErrFrozen", err)
+	}
+	if _, err := ann.Project("web").Task("t2").Manage(); !errors.Is(err, ErrFrozen) {
+		t.Fatalf("Manage task: got %v want ErrFrozen", err)
+	}
+	// Reads are not affected.
+	if _, err := ann.Project("web").Read(); err != nil {
+		t.Fatalf("Read: %v", err)
+	}
+}
+
+func TestFreezeDemotesMembersAndIsIdempotent(t *testing.T) {
+	a := New()
+	ivy := actorFor(t, a, "ivy")
+
+	want := []MemberView{
+		{UserID: "ann", Role: RoleViewer},
+		{UserID: "ben", Role: RoleViewer},
+		{UserID: "cat", Role: RoleViewer},
+		{UserID: "dan", Role: RoleViewer},
+		{UserID: "ivy", Role: RoleViewer},
+	}
+
+	mp, err := ivy.Project("web").Manage()
+	if err != nil {
+		t.Fatal(err)
+	}
+	got, err := mp.Freeze()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("Freeze = %+v, want %+v", got, want)
+	}
+
+	// Freezing again through the capability is a no-op with the same result.
+	got, err = mp.Freeze()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("second Freeze = %+v, want %+v", got, want)
+	}
+}
+
+func TestFreezeKeepsAssignments(t *testing.T) {
+	a := New()
+	mp, err := actorFor(t, a, "ann").Project("web").Manage()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := mp.Freeze(); err != nil {
+		t.Fatal(err)
+	}
+	var assignee string
+	if err := a.st.read(func(s *state) error {
+		assignee = s.tasks["t1"].assignee.user
+		return nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if assignee != "ben" {
+		t.Fatalf("t1 assignee = %q, want ben", assignee)
+	}
+}
