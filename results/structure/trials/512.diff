+	if code, _ := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"manager"}}`); code != 200 {
+		t.Fatalf("promote dan: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "DELETE", "/projects/web/tasks/t1", "dan", ""); code != 204 {
+		t.Fatalf("promoted dan delete: got %d want 204", code)
+	}
+}
