+// removeFromOrgAggregate removes one user from every project of an
+// organization.
+type removeFromOrgAggregate struct {
+	memberships []*Membership // the user's memberships in the organization's projects
+	assigned    []*Task       // the user's tasks in those projects
+}
+
+func loadRemoveFromOrg(ctx context.Context, tx DB, org, userID string) (*removeFromOrgAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != org {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	all, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	a := &removeFromOrgAggregate{}
+	for _, m := range all {
+		p, err := m.Project(ctx, tx)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "membership must belong to an existing project")
+		} else if err != nil {
+			return nil, err
+		}
+		if p.Org != org {
+			continue
+		}
+		tasks, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.memberships = append(a.memberships, m)
+		a.assigned = append(a.assigned, tasks...)
+	}
+	return a, nil
+}
+
+// validate: removing memberships cannot break a model rule by itself. The rule
+// that an assignee is a member is kept by apply, which unassigns the tasks.
+func (a *removeFromOrgAggregate) validate() error { return nil }
+
+func (a *removeFromOrgAggregate) apply(ctx context.Context, tx DB) error {
+	for _, t := range a.assigned {
+		if err := t.unassign(ctx, tx); err != nil {
+			return err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
