+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, org, uid string
+		want                 int
+	}{
+		{"org admin", "eve", "acme", "ben", 204},
+		{"org admin, user already removed", "eve", "acme", "ben", 204},
+		{"org admin, user with no projects", "eve", "acme", "hal", 204},
+		{"manager of the org's projects", "ann", "acme", "ben", 403},
+		{"member, not admin", "ben", "acme", "cat", 403},
+		{"other org admin", "gus", "acme", "ben", 404},
+		{"other org's user", "eve", "globex", "gus", 404},
+		{"user not in org", "eve", "acme", "gus", 404},
+		{"unknown user", "eve", "acme", "zed", 404},
+		{"anonymous", "", "acme", "ben", 401},
+		{"unknown caller", "zed", "acme", "ben", 401},
+		{"unknown org", "eve", "nope", "ben", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "DELETE", "/orgs/"+c.org+"/users/"+c.uid, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffect(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d body=%s", code, body)
+	}
+
+	// ben is out of every project of the org, archived one included.
+	for _, p := range []string{"/projects/web/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, h, "GET", p, "ben", ""); code != 404 {
+			t.Fatalf("ben GET %s: got %d want 404", p, code)
+		}
+	}
+	// ben still authenticates: he is just not a member anywhere now.
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben GET ops: got %d want 404", code)
+	}
+
+	// His tasks in those projects are unassigned; the tasks themselves stay.
+	for _, path := range []string{"/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		code, body := do(t, h, "GET", path, "ann", "")
+		if code != 200 {
+			t.Fatalf("ann GET %s: got %d body=%s", path, code, body)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.AssigneeID != "" {
+			t.Fatalf("%s still assigned to %q", path, task.AssigneeID)
+		}
+	}
+
+	// Other members are untouched.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat lost access to web: got %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ann", ""); code != 200 {
+		t.Fatalf("ann lost access to web: got %d", code)
+	}
+}
