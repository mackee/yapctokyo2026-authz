+func TestRemoveOrgUserRemovesAllMemberships(t *testing.T) {
+	srv := newServer()
+	// cat is a contributor in web and ops (both acme).
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/cat", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d", code)
+	}
+	for _, path := range []string{"/projects/web/tasks", "/projects/ops/tasks"} {
+		if code, _ := do(t, srv, "GET", path, "cat", ""); code != 404 {
+			t.Fatalf("%s after removal: got %d want 404", path, code)
+		}
+		if code, _ := do(t, srv, "POST", path, "cat", `{"title":"x"}`); code != 404 {
+			t.Fatalf("POST %s after removal: got %d want 404", path, code)
+		}
+	}
+	// Other members are unaffected.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ann", ""); code != 200 {
+		t.Fatalf("manager lost access: got %d", code)
+	}
+	// Removing again is harmless.
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/cat", "eve", ""); code != 204 {
+		t.Fatalf("second remove: got %d", code)
+	}
+}
