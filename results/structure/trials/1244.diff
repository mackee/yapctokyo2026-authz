+// moveMembershipAggregate moves one member from a source project to a
+// destination project.
+type moveMembershipAggregate struct {
+	from   *Membership // the member's membership in the source project
+	dest   *Project
+	user   *User
+	inDest bool // the user is already a member of the destination project
+}
+
+func loadMoveMembership(ctx context.Context, tx DB, fromID, toID, userID string) (*moveMembershipAggregate, error) {
+	src, err := NewProjectTable().Find(ctx, tx, fromID)
+	if err != nil {
+		return nil, err
+	}
+	from, err := src.Membership(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	dest, err := NewProjectTable().Find(ctx, tx, toID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	user, err := NewUserTable().Find(ctx, tx, userID)
+	if err != nil {
+		return nil, err
+	}
+	_, err = dest.Membership(ctx, tx, userID)
+	inDest := err == nil
+	if err != nil && !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	return &moveMembershipAggregate{from: from, dest: dest, user: user, inDest: inDest}, nil
+}
+
+func (a *moveMembershipAggregate) validate() error {
+	if a.user.Org != a.dest.Org {
+		return deny(ErrInvalid, "project members must belong to the project's organization")
+	}
+	if a.inDest {
+		return deny(ErrInvalid, "member is already in the destination project")
+	}
+	return nil
+}
+
+func (a *moveMembershipAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	tasks, err := a.from.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, t := range tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.from.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	m := &Membership{ProjectID: a.dest.ID, UserID: a.user.ID, Role: a.from.Role}
+	if err := m.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
+
