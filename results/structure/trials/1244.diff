+package model
+
+import (
+	"context"
+	"errors"
+	"testing"
+)
+
+func TestMoveToArchivedProjectIsRejected(t *testing.T) {
+	ctx := context.Background()
+	db, err := Open()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := db.ExecContext(ctx, `UPDATE projects SET archived = 1 WHERE id = 'ops'`); err != nil {
+		t.Fatal(err)
+	}
+	actor, err := Authenticate(ctx, db, "ivy")
+	if err != nil {
+		t.Fatal(err)
+	}
+	from, err := NewProjectAuthz(ctx, db, actor, "web")
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	_, err = NewMembershipTable().Move(ctx, db, from, MembershipTableMoveInput{UserID: "ben", ToProjectID: "ops"})
+	if !errors.Is(err, ErrArchived) {
+		t.Fatalf("got %v, want ErrArchived", err)
+	}
+	// Nothing changed: ben is still a member of web.
+	if _, err := NewMembershipTable().Find(ctx, db, "web", "ben"); err != nil {
+		t.Fatalf("ben's web membership: %v", err)
+	}
+}
