+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"other project manager", "ivy", "ops", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown project", "ann", "nope", 404},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got []struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("bad body %q: %v", body, err)
+	}
+	want := []string{"ann", "ben", "cat", "dan", "ivy"}
+	if len(got) != len(want) {
+		t.Fatalf("want %d members, got %d: %s", len(want), len(got), body)
+	}
+	for i, m := range got {
+		if m.UserID != want[i] || m.Role != "viewer" {
+			t.Fatalf("member %d: got %+v, want {%s viewer}", i, m, want[i])
+		}
+	}
+}
+
+func TestFreezeOnlyAffectsItsProject(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze web: got %d: %s", code, body)
+	}
+	// ops is untouched: ivy is still its manager and can write.
+	if code, body := do(t, h, "POST", "/projects/ops/tasks", "ivy", `{"title":"x"}`); code != 200 {
+		t.Fatalf("write ops after freezing web: got %d: %s", code, body)
+	}
+	// The tasks of the frozen project keep their rows.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t1", "dan", ""); code != 200 {
+		t.Fatalf("read frozen task: got %d", code)
+	}
+}
+
+func TestFreezeBlocksWrites(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d: %s", code, body)
+	}
+
+	// Frozen: nobody can change the project's tasks, managers included.
+	writes := []struct {
+		name, method, path, user, body string
+	}{
+		{"manager patch", "PATCH", "/projects/web/tasks/t2", "ann", `{"status":"done"}`},
+		{"former contributor patch", "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`},
+		{"manager create", "POST", "/projects/web/tasks", "ann", `{"title":"x"}`},
+		{"manager delete", "DELETE", "/projects/web/tasks/t3", "ann", ""},
+		{"second freeze", "POST", "/projects/web/freeze", "ann", ""},
+	}
+	for _, c := range writes {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, h, c.method, c.path, c.user, c.body)
+			if code != http.StatusForbidden {
+				t.Fatalf("got %d want 403: %s", code, body)
+			}
+		})
+	}
+
+	// Reads still work, and the tasks have no assignee any more.
+	code, body := do(t, h, "GET", "/projects/web/tasks", "dan", "")
+	if code != 200 {
+		t.Fatalf("list: got %d", code)
+	}
+	var tasks []Task
+	if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+		t.Fatal(err)
+	}
+	if len(tasks) != 3 {
+		t.Fatalf("want 3 tasks, got %d", len(tasks))
+	}
+	for _, task := range tasks {
+		if task.AssigneeID != "" {
+			t.Fatalf("task %s still assigned to %s", task.ID, task.AssigneeID)
+		}
+	}
+}
