 // NewProjectTable returns the projects table.
 func NewProjectTable() *ProjectTable { return &ProjectTable{} }
 
+// Freeze makes every member of the project (managers included) a viewer and
+// returns the resulting memberships, ordered by user ID. With nobody left able
+// to write, the project's tasks can no longer be changed.
+func (*ProjectTable) Freeze(ctx context.Context, db DB, authz ProjectAuthz) ([]*Membership, error) {
+	if err := authz.CanFreeze(); err != nil {
+		return nil, err
+	}
+	var out []*Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadFreezeProject(ctx, tx, authz.ProjectID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		out, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
