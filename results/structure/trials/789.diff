+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager", "ann", "/projects/web/freeze", 200},
+		{"manager of ops", "ivy", "/projects/ops/freeze", 200},
+		{"contributor", "ben", "/projects/web/freeze", 403},
+		{"viewer", "dan", "/projects/web/freeze", 403},
+		{"viewer in project where manager elsewhere", "ann", "/projects/ops/freeze", 403},
+		{"org admin", "eve", "/projects/web/freeze", 403},
+		{"non member", "hal", "/projects/web/freeze", 404},
+		{"other org", "gus", "/projects/web/freeze", 404},
+		{"anonymous", "", "/projects/web/freeze", 401},
+		{"archived", "ann", "/projects/legacy/freeze", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResponseAndEffect(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("freeze: %d %s", code, body)
+	}
+	var got []map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	wantUsers := []string{"ann", "ben", "cat", "dan", "ivy"}
+	if len(got) != len(wantUsers) {
+		t.Fatalf("got %v", got)
+	}
+	for i, m := range got {
+		if len(m) != 2 || m["userId"] != wantUsers[i] || m["role"] != "viewer" {
+			t.Fatalf("member %d: %v", i, m)
+		}
+	}
+
+	writes := []struct{ name, method, path, user, body string }{
+		{"manager creates", "POST", "/projects/web/tasks", "ann", `{"title":"x"}`},
+		{"manager updates", "PATCH", "/projects/web/tasks/t1", "ann", `{"status":"done"}`},
+		{"manager deletes", "DELETE", "/projects/web/tasks/t1", "ann", ""},
+		{"contributor updates own", "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`},
+		{"second freeze", "POST", "/projects/web/freeze", "ann", ""},
+	}
+	for _, w := range writes {
+		if code, _ := do(t, h, w.method, w.path, w.user, w.body); code != 403 {
+			t.Errorf("%s: got %d want 403", w.name, code)
+		}
+	}
+	// Reads still work, and other projects are untouched.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ann", ""); code != 200 {
+		t.Errorf("read after freeze: %d", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/ops/tasks", "ivy", `{"title":"x"}`); code != 200 {
+		t.Errorf("other project write: %d", code)
+	}
+}
