+// CanFreeze returns nil if the actor may freeze the project: managers of the
+// project only (else ErrForbidden) and not archived (else ErrArchived).
+func (a ProjectAuthz) CanFreeze() error {
+	if !a.CanRead() || a.role != RoleManager {
+		return deny(ErrForbidden, "forbidden")
+	}
+	if a.archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	return nil
+}
