+// transferUserAggregate moves one user to another organization. The model
+// rules require project members to belong to the project's organization, so
+// the user's memberships in projects outside the new organization are removed,
+// and the tasks they hold in those projects are unassigned (an assignee must be
+// a member of the task's project).
+type transferUserAggregate struct {
+	user     *User
+	toOrg    string
+	leaving  []*Membership // memberships in projects outside toOrg
+	unassign []*Task       // tasks assigned to the user in those projects
+}
+
+func loadTransferUser(ctx context.Context, tx DB, fromOrg, userID, toOrg string) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != fromOrg {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if _, err := NewOrgTable().Find(ctx, tx, toOrg); errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "unknown organization")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &transferUserAggregate{user: u, toOrg: toOrg}
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, m := range ms {
+		p, err := m.Project(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		if p.Org == toOrg {
+			continue
+		}
+		tasks, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.leaving = append(a.leaving, m)
+		a.unassign = append(a.unassign, tasks...)
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if a.user.Org == a.toOrg {
+		return deny(ErrInvalid, "user already belongs to that organization")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	for _, t := range a.unassign {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	for _, m := range a.leaving {
+		if err := m.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.user.transfer(ctx, tx, a.toOrg); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
+
