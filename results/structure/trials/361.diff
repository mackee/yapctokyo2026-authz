+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager of both", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 200},
+		{"assignee is member of target", "ivy", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 200},
+		{"assignee not in target", "ivy", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 400},
+		{"contributor source", "ben", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"viewer source", "dan", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"org admin source", "eve", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"manager source, viewer target", "ann", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 403},
+		{"manager source, non-member target", "ann", "/projects/web/tasks/t3", `{"toProjectId":"gx"}`, 404},
+		{"unknown target", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"nope"}`, 404},
+		{"archived target", "ann", "/projects/web/tasks/t3", `{"toProjectId":"legacy"}`, 409},
+		{"archived source", "ann", "/projects/legacy/tasks/t5", `{"toProjectId":"web"}`, 409},
+		{"same project", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"web"}`, 400},
+		{"missing target", "ivy", "/projects/web/tasks/t3", `{}`, 400},
+		{"empty target", "ivy", "/projects/web/tasks/t3", `{"toProjectId":""}`, 400},
+		{"bad body", "ivy", "/projects/web/tasks/t3", `{`, 400},
+		{"task not in path project", "ivy", "/projects/ops/tasks/t1", `{"toProjectId":"web"}`, 404},
+		{"unknown task", "ivy", "/projects/web/tasks/t99", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsTaskAndChangesProject(t *testing.T) {
+	srv := newServer()
+	code, body := do(t, srv, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d: %s", code, body)
+	}
+	var moved Task
+	if err := json.Unmarshal([]byte(body), &moved); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", Assignee: "cat"}
+	if moved != want {
+		t.Fatalf("moved task = %+v, want %+v", moved, want)
+	}
+
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks/t2", "ann", ""); code != 404 {
+		t.Fatalf("old project still reads task: got %d", code)
+	}
+	code, body = do(t, srv, "GET", "/projects/ops/tasks/t2", "cat", "")
+	if code != 200 {
+		t.Fatalf("new project read: got %d", code)
+	}
+	var got Task
+	json.Unmarshal([]byte(body), &got)
+	if got != want {
+		t.Fatalf("read after move = %+v, want %+v", got, want)
+	}
+}
