+// checkMoveTarget applies the manage rule to the target project of a move:
+// readable (else 404), manager (else 403), not archived (else 409).
+func checkMoveTarget(x *tx, act Actor, pid string) error {
+	p, role, err := readable(x, act, pid)
+	if err != nil {
+		return err
+	}
+	if role != RoleManager {
+		return deny(ErrForbidden, "forbidden")
+	}
+	if p.Archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	return nil
+}
+
+func (t *manageTask) MoveTo(toProjectID string) (TaskView, error) {
+	if toProjectID == "" {
+		return TaskView{}, deny(ErrInvalid, "toProjectId is required")
+	}
+	if toProjectID == t.ts.ps.pid {
+		return TaskView{}, deny(ErrInvalid, "task is already in that project")
+	}
+	err := t.ts.ps.as.a.db.view(func(x *tx) error {
+		return checkMoveTarget(x, t.ts.ps.as.actor, toProjectID)
+	})
+	if err != nil {
+		return TaskView{}, err
+	}
+	var v TaskView
+	err = t.ts.ps.as.a.db.update(func(x *tx) error {
+		agg, err := loadMoveTask(x, t.ts.tid, toProjectID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		v = agg.apply(x)
+		return nil
+	})
+	return v, err
+}
