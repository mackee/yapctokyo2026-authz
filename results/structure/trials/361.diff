+// moveTaskAggregate moves one task into another project. The task keeps its
+// ID, title, status and assignee, so an assignee must already be a contributor
+// or manager of the target project.
+type moveTaskAggregate struct {
+	task         taskRecord
+	toProject    projectRecord
+	assigneeRole string // the assignee's role in the target project ("" if none)
+}
+
+func loadMoveTask(x *tx, taskID, toProjectID string) (*moveTaskAggregate, error) {
+	t, ok := x.findTask(taskID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	p, ok := x.findProject(toProjectID)
+	if !ok {
+		return nil, deny(ErrInvalid, "task must belong to an existing project")
+	}
+	a := &moveTaskAggregate{task: t, toProject: p}
+	if t.AssigneeID != "" {
+		m, _ := p.Membership(x, t.AssigneeID)
+		a.assigneeRole = m.Role
+	}
+	return a, nil
+}
+
+func (a *moveTaskAggregate) validate() error {
+	if a.task.AssigneeID != "" && !isWriterRole(a.assigneeRole) {
+		return deny(ErrInvalid, "assignee must be a contributor or manager of the project")
+	}
+	return nil
+}
+
+func (a *moveTaskAggregate) apply(x *tx) TaskView {
+	t := a.task
+	t.MoveTo(x, a.toProject.ID)
+	return t.view()
+}
