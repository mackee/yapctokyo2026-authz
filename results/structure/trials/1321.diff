+func TestUpdateMembers(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager", "ann", "web", `{"roles":{"dan":"contributor"}}`, 200},
+		{"manager promotes assignee", "ann", "web", `{"roles":{"ben":"manager"}}`, 200},
+		{"manager demotes unassigned member", "ann", "web", `{"roles":{"ivy":"viewer"}}`, 200},
+		{"manager demotes assignee", "ann", "web", `{"roles":{"ben":"viewer"}}`, 409},
+		{"demotion of assignee blocks batch", "ann", "web", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 409},
+		{"contributor", "cat", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"org admin", "eve", "ops", `{"roles":{"cat":"viewer"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"unknown user", "zed", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"invalid role", "ann", "web", `{"roles":{"dan":"owner"}}`, 400},
+		{"empty role", "ann", "web", `{"roles":{"dan":""}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"invalid json", "ann", "web", `{"roles":`, 400},
+		{"target not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"unknown target", "ann", "web", `{"roles":{"zed":"viewer"}}`, 400},
+		{"target in other org", "ann", "web", `{"roles":{"gus":"viewer"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMembersResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann",
+		`{"roles":{"dan":"contributor","ben":"manager"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var members []memberRole
+	if err := json.Unmarshal([]byte(body), &members); err != nil {
+		t.Fatal(err)
+	}
+	want := []memberRole{
+		{"ann", "manager"}, {"ben", "manager"}, {"cat", "contributor"},
+		{"dan", "contributor"}, {"ivy", "manager"},
+	}
+	if len(members) != len(want) {
+		t.Fatalf("got %v want %v", members, want)
+	}
+	for i := range want {
+		if members[i] != want[i] {
+			t.Fatalf("got %v want %v", members, want)
+		}
+	}
+}
+
+func TestUpdateMembersAllOrNothing(t *testing.T) {
+	server := newServer()
+	// dan is a valid change, hal is not a member: nothing may change.
+	code, _ := do(t, server, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","hal":"viewer"}}`)
+	if code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	// ben would become a viewer while assigned to t1: nothing may change.
+	code, _ = do(t, server, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","ben":"viewer"}}`)
+	if code != 409 {
+		t.Fatalf("got %d want 409", code)
+	}
+	// A successful request returns the list; dan must still be a viewer.
+	code, body := do(t, server, "PUT", "/projects/web/members", "ann", `{"roles":{"ann":"manager"}}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+	var members []memberRole
+	json.Unmarshal([]byte(body), &members)
+	for _, m := range members {
+		if m.UserID == "dan" && m.Role != "viewer" {
+			t.Fatalf("dan changed to %s by a failed request", m.Role)
+		}
+		if m.UserID == "ben" && m.Role != "contributor" {
+			t.Fatalf("ben changed to %s by a failed request", m.Role)
+		}
+	}
+}
