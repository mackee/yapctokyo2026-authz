+type memberRole struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+type membersRequest struct {
+	Roles map[string]string `json:"roles"`
+}
+
+// updateMembers changes the roles of existing project members in one request.
+// Either every change applies or none does. The response is the member list
+// after the change, sorted by user ID.
+func (s *server) updateMembers(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role, err := findRole(ctx, s.db, project.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "only managers may change member roles")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req membersRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || len(req.Roles) == 0 {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	ids := make([]string, 0, len(req.Roles))
+	for id, newRole := range req.Roles {
+		if newRole != RoleManager && newRole != RoleContributor && newRole != RoleViewer {
+			writeError(w, 400, "invalid role")
+			return
+		}
+		ids = append(ids, id)
+	}
+	sort.Strings(ids)
+
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+	for _, id := range ids {
+		var members int
+		if err := tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM memberships WHERE project_id = ? AND user_id = ?`, project.ID, id).Scan(&members); err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+		if members == 0 {
+			writeError(w, 400, "user is not a member of the project: "+id)
+			return
+		}
+		newRole := req.Roles[id]
+		if newRole == RoleViewer {
+			// Viewers cannot be assignees, so reassign their tasks first.
+			var assigned int
+			if err := tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM tasks WHERE project_id = ? AND assignee = ?`, project.ID, id).Scan(&assigned); err != nil {
+				writeError(w, 500, "internal error")
+				return
+			}
+			if assigned > 0 {
+				writeError(w, 409, "user is assigned to tasks in this project: "+id)
+				return
+			}
+		}
+		if _, err := tx.ExecContext(ctx, `UPDATE memberships SET role = ? WHERE project_id = ? AND user_id = ?`, newRole, project.ID, id); err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+	}
+	result, err := listMembers(ctx, tx, project.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, result)
+}
+
+// listMembers returns the members of a project sorted by user ID.
+func listMembers(ctx context.Context, tx *sql.Tx, projectID string) ([]memberRole, error) {
+	rows, err := tx.QueryContext(ctx, `SELECT user_id, role FROM memberships WHERE project_id = ? ORDER BY user_id`, projectID)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	members := []memberRole{}
+	for rows.Next() {
+		var m memberRole
+		if err := rows.Scan(&m.UserID, &m.Role); err != nil {
+			return nil, err
+		}
+		members = append(members, m)
+	}
+	return members, rows.Err()
+}
