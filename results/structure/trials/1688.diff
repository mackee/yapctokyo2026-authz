+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager moves", "ivy", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 200},
+		{"manager moves unassigned", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 200},
+		{"assignee not in destination", "ivy", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 400},
+		{"contributor in source", "cat", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 403},
+		{"viewer in source", "dan", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"org admin", "eve", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 403},
+		{"viewer in destination", "ann", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 403},
+		{"destination not readable", "ann", "/projects/web/tasks/t3", `{"toProjectId":"gx"}`, 404},
+		{"destination missing", "ann", "/projects/web/tasks/t3", `{"toProjectId":"nope"}`, 404},
+		{"archived source", "ann", "/projects/legacy/tasks/t5", `{"toProjectId":"web"}`, 409},
+		{"archived destination", "ann", "/projects/web/tasks/t3", `{"toProjectId":"legacy"}`, 409},
+		{"same project", "ann", "/projects/web/tasks/t3", `{"toProjectId":"web"}`, 400},
+		{"empty destination", "ann", "/projects/web/tasks/t3", `{"toProjectId":""}`, 400},
+		{"bad body", "ann", "/projects/web/tasks/t3", `nope`, 400},
+		{"cross project id", "ivy", "/projects/web/tasks/t4", `{"toProjectId":"ops"}`, 404},
+		{"source not readable", "hal", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 404},
+		{"cross org", "gus", "/projects/web/tasks/t1", `{"toProjectId":"gx"}`, 404},
+		{"anonymous", "", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveResult(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got Task
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", Assignee: "cat"}
+	if got != want {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+	// The task now lives in the destination only.
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks/t2", "ivy", ""); code != 200 {
+		t.Fatalf("destination get: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t2", "ivy", ""); code != 404 {
+		t.Fatalf("source get: %d", code)
+	}
+}
+
+func TestMoveRejectedLeavesTaskInPlace(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/tasks/t1/move", "ivy", `{"toProjectId":"ops"}`); code != 400 {
+		t.Fatalf("got %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t1", "ivy", ""); code != 200 {
+		t.Fatalf("task left source: %d", code)
+	}
+}
