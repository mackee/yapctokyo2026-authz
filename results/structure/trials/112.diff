+// Manage applies the manager rule: readable, manager (else 403), not archived
+// (else 409). Org admins who are not members get 403 here, not 404, because
+// they can read the project but may not administer it.
+func (s *projectScope) Manage() (ManageProject, error) {
+	err := s.as.a.st.read(func(st *state) error {
+		p, r, err := readable(st, s.as.actor, s.pid)
+		if err != nil {
+			return err
+		}
+		if r != RoleManager {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if p.archived {
+			return deny(ErrArchived, "project is archived")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &manageProject{readProject: readProject{ps: s}}, nil
+}
