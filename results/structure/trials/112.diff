+func TestSetMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager promotes viewer", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"manager promotes contributor", "ann", "/projects/web/members/cat", `{"role":"manager"}`, 200},
+		{"manager demotes manager without tasks", "ann", "/projects/web/members/ivy", `{"role":"viewer"}`, 200},
+		{"manager demotes contributor with tasks", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 400},
+		{"manager sets same role", "ann", "/projects/web/members/ben", `{"role":"contributor"}`, 200},
+		{"contributor", "ben", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"viewer", "dan", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"org admin", "eve", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"non member", "hal", "/projects/web/members/dan", `{"role":"contributor"}`, 404},
+		{"other org", "gus", "/projects/web/members/dan", `{"role":"contributor"}`, 404},
+		{"anonymous", "", "/projects/web/members/dan", `{"role":"contributor"}`, 401},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"contributor"}`, 404},
+		{"target member of another project", "ivy", "/projects/ops/members/ben", `{"role":"viewer"}`, 404},
+		{"manager of web is only viewer of ops", "ann", "/projects/ops/members/cat", `{"role":"viewer"}`, 403},
+		{"unknown target", "ann", "/projects/web/members/zed", `{"role":"viewer"}`, 404},
+		{"invalid role", "ann", "/projects/web/members/dan", `{"role":"owner"}`, 400},
+		{"empty role", "ann", "/projects/web/members/dan", `{}`, 400},
+		{"malformed body", "ann", "/projects/web/members/dan", `nope`, 400},
+		{"archived project", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"project missing", "ann", "/projects/nope/members/dan", `{"role":"viewer"}`, 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMemberRoleResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.UserID != "dan" || got.Role != "contributor" {
+		t.Fatalf("got %+v", got)
+	}
+}
+
+func TestSetMemberRoleTakesEffect(t *testing.T) {
+	h := newServer()
+
+	// A viewer cannot create tasks; after promotion they can.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 403 {
+		t.Fatalf("viewer create: got %d want 403", code)
+	}
+	if code, _ := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`); code != 200 {
+		t.Fatalf("promote: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x","assignee":"dan"}`); code != 201 {
+		t.Fatalf("contributor create: got %d want 201", code)
+	}
+
+	// Demotion is refused while ben holds a task in web, and allowed once it is reassigned.
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 400 {
+		t.Fatalf("demote with tasks: got %d want 400", code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ann", `{"assignee":"ann"}`); code != 200 {
+		t.Fatalf("reassign t1: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote after reassign: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t3", "ben", `{"status":"done"}`); code != 403 {
+		t.Fatalf("demoted user write: got %d want 403", code)
+	}
+}
