+// MemberView is the public representation of a project member.
+type MemberView struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// ManageProject may administer the members of one project. Only managers hold it.
+type ManageProject interface {
+	ReadProject
+	// SetRole changes the project role of an existing member. The role must be
+	// manager, contributor or viewer (else 400). A user who is not a member of
+	// the project is 404. Demoting a user to viewer while they are assigned a
+	// task in this project is 400; reassign those tasks first.
+	SetRole(userID, role string) (MemberView, error)
+}
+
+type manageProject struct{ readProject }
+
+func (p *manageProject) SetRole(userID, role string) (MemberView, error) {
+	if role != RoleManager && role != RoleContributor && role != RoleViewer {
+		return MemberView{}, deny(ErrInvalid, "invalid role")
+	}
+	var v MemberView
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		pid := p.ps.pid
+		if s.role(pid, userID) == "" {
+			return deny(ErrNotFound, "not found")
+		}
+		if role == RoleViewer {
+			for _, t := range s.tasks {
+				if t.project == pid && t.assignee.user == userID {
+					return deny(ErrInvalid, "member is still assigned to tasks in this project; reassign them first")
+				}
+			}
+		}
+		s.members[pid][userID] = role
+		v = MemberView{UserID: userID, Role: role}
+		return nil
+	})
+	return v, err
+}
