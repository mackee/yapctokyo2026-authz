+// doOnBehalf sends a request as user, with X-On-Behalf-Of set when behalf is non-empty.
+func doOnBehalf(t *testing.T, h http.Handler, method, path, user, behalf, body string) (int, string) {
 	t.Helper()
 	req := httptest.NewRequest(method, path, strings.NewReader(body))
 	if user != "" {
 		req.Header.Set("X-User", user)
 	}
+	if behalf != "" {
+		req.Header.Set("X-On-Behalf-Of", behalf)
+	}
 	w := httptest.NewRecorder()
 	h.ServeHTTP(w, req)
 	return w.Code, w.Body.String()
