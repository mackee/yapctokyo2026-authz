 // Taskboard: a tiny project task tracker.
 //
 // Identity: the X-User header names the caller (demo stand-in for real auth).
+// Delegation: an X-On-Behalf-Of header names a member the caller acts as.
 //
 // Access rules (see README.md):
 //   - unknown or missing user                                  -> 401
 //   - project missing, in another org, or not readable by user -> 404
 //   - a project is readable by its members (any role) and by org admins of its org
+//   - X-On-Behalf-Of: caller must be a manager of the project and the named
+//     user must be a member of it; otherwise                   -> 403
+//   - with X-On-Behalf-Of, every check below uses the named member, not the caller
 //   - writes need contributor or manager role in the project;
 //     readable-but-not-allowed                                 -> 403
 //   - contributors may only modify tasks assigned to themselves
@@ -55,6 +59,26 @@ func writeError(w http.ResponseWriter, code int, msg string) {
 	writeJSON(w, code, map[string]string{"error": msg})
 }
 
+// actAs returns the user a request acts as. Without X-On-Behalf-Of that is the
+// caller. With it, the caller must be a manager of the project and the named
+// user must be a member of the project; the request is then checked against
+// that member's own role and rules. Callers must already be able to see the
+// project, so this never reveals whether a project exists.
+func (s *server) actAs(r *http.Request, project *Project, caller *User) (*User, int, string) {
+	name := r.Header.Get("X-On-Behalf-Of")
+	if name == "" {
+		return caller, 0, ""
+	}
+	if s.store.Role(project.ID, caller.ID) != RoleManager {
+		return nil, 403, "only project managers may act on behalf of members"
+	}
+	member := s.store.User(name)
+	if member == nil || member.OrgID != project.OrgID || s.store.Role(project.ID, member.ID) == "" {
+		return nil, 403, "on-behalf-of user is not a member of this project"
+	}
+	return member, 0, ""
+}
