+func TestOnBehalfOf(t *testing.T) {
+	cases := []struct {
+		name, user, behalf, method, path, body string
+		want                                   int
+	}{
+		// Allowed: a web manager acting for a web member.
+		{"manager acts as self", "ann", "ann", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`, 200},
+		{"acting as contributor, own task", "ann", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`, 200},
+		{"acting as manager, any task", "ann", "ivy", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 200},
+		{"acting as manager, reassign", "ann", "ivy", "PATCH", "/projects/web/tasks/t2", `{"assignee":"ben"}`, 200},
+		{"acting as viewer, read", "ann", "dan", "GET", "/projects/web/tasks", "", 200},
+		{"acting as viewer, write", "ann", "dan", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`, 403},
+		{"acting as contributor, others", "ann", "ben", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"acting as contributor, reassign", "ann", "ben", "PATCH", "/projects/web/tasks/t1", `{"assignee":"cat"}`, 403},
+		{"acting as contributor, delete", "ann", "ben", "DELETE", "/projects/web/tasks/t1", "", 403},
+		{"acting as manager, delete", "ann", "ivy", "DELETE", "/projects/web/tasks/t1", "", 204},
+		{"acting as contributor, create self", "ann", "cat", "POST", "/projects/web/tasks", `{"title":"x","assignee":"cat"}`, 201},
+		{"acting as contributor, create other", "ann", "cat", "POST", "/projects/web/tasks", `{"title":"x","assignee":"ben"}`, 403},
+		{"acting as contributor, create unassigned", "ann", "cat", "POST", "/projects/web/tasks", `{"title":"x"}`, 201},
+		{"acting as contributor, cross project task", "ann", "ben", "GET", "/projects/web/tasks/t4", "", 404},
+		{"acting in archived project", "ann", "ben", "POST", "/projects/legacy/tasks", `{"title":"x"}`, 409},
+
+		// Denied: the caller is not a manager of this project.
+		{"contributor caller", "ben", "cat", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"org admin caller", "eve", "ben", "GET", "/projects/web/tasks", "", 403},
+		{"manager of another project", "ann", "cat", "GET", "/projects/ops/tasks", "", 403},
+		{"non member caller hidden", "hal", "ben", "GET", "/projects/web/tasks", "", 404},
+		{"anonymous caller", "", "ben", "GET", "/projects/web/tasks", "", 401},
+
+		// Denied: the named user is not a member of this project.
+		{"target non member", "ann", "hal", "GET", "/projects/web/tasks", "", 403},
+		{"target org admin without role", "ann", "eve", "GET", "/projects/web/tasks", "", 403},
+		{"target other org", "ann", "gus", "GET", "/projects/web/tasks", "", 403},
+		{"target unknown", "ann", "zed", "GET", "/projects/web/tasks", "", 403},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := doOnBehalf(t, newServer(), c.method, c.path, c.user, c.behalf, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d (body %s)", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestOnBehalfOfUpdatesTaskAsMember(t *testing.T) {
+	s := newServer()
+	code, body := doOnBehalf(t, s, "PATCH", "/projects/web/tasks/t1", "ann", "ben", `{"status":"done"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.Status != "done" || task.Assignee != "ben" {
+		t.Fatalf("unexpected task %+v", task)
+	}
+	// The change is visible to later requests made as the member directly.
+	code, body = do(t, s, "GET", "/projects/web/tasks/t1", "ben", "")
+	if code != 200 || !strings.Contains(body, `"status":"done"`) {
+		t.Fatalf("got %d: %s", code, body)
+	}
+}
