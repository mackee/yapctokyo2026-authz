+// dbValue reads one string from the database behind h (the query must return one row).
+func dbValue(t *testing.T, h http.Handler, query string, args ...any) string {
+	t.Helper()
+	app, ok := h.(*appHandler)
+	if !ok {
+		t.Fatalf("dbValue: %T is not the handler built by newServer", h)
+	}
+	var v string
+	if err := app.db.QueryRow(query, args...).Scan(&v); err != nil {
+		t.Fatalf("dbValue: %v", err)
+	}
+	return v
+}
+
+func memberRoleOf(t *testing.T, h http.Handler, project, user string) string {
+	t.Helper()
+	return dbValue(t, h, `SELECT COALESCE((SELECT role FROM memberships WHERE project_id = ? AND user_id = ?), '')`, project, user)
+}
+
+func TestUpdateMembers(t *testing.T) {
+	t.Run("manager changes several roles", func(t *testing.T) {
+		h := newServer()
+		code, body := do(t, h, "PUT", "/projects/web/members", "ann",
+			`{"roles":{"ben":"viewer","dan":"contributor"}}`)
+		if code != 200 {
+			t.Fatalf("got %d: %s", code, body)
+		}
+		var got []memberRole
+		if err := json.Unmarshal([]byte(body), &got); err != nil {
+			t.Fatal(err)
+		}
+		want := []memberRole{
+			{"ann", "manager"}, {"ben", "viewer"}, {"cat", "contributor"},
+			{"dan", "contributor"}, {"ivy", "manager"},
+		}
+		if len(got) != len(want) {
+			t.Fatalf("got %v want %v", got, want)
+		}
+		for i := range want {
+			if got[i] != want[i] {
+				t.Fatalf("row %d: got %v want %v", i, got[i], want[i])
+			}
+		}
+		if r := memberRoleOf(t, h, "web", "ben"); r != "viewer" {
+			t.Fatalf("ben stored as %q", r)
+		}
+	})
+
+	t.Run("demoting to viewer unassigns their tasks in the project", func(t *testing.T) {
+		h := newServer()
+		if code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer"}}`); code != 200 {
+			t.Fatalf("got %d: %s", code, body)
+		}
+		if a := dbValue(t, h, `SELECT assignee FROM tasks WHERE id = 't1'`); a != "" {
+			t.Fatalf("t1 still assigned to %q", a)
+		}
+	})
+
+	t.Run("other project's tasks keep their assignee", func(t *testing.T) {
+		h := newServer()
+		// ben is a contributor in legacy and holds t5 there; changing web must not touch it.
+		if code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer"}}`); code != 200 {
+			t.Fatalf("got %d: %s", code, body)
+		}
+		if a := dbValue(t, h, `SELECT assignee FROM tasks WHERE id = 't5'`); a != "ben" {
+			t.Fatalf("t5 assignee changed to %q", a)
+		}
+	})
+
+	t.Run("refused requests", func(t *testing.T) {
+		cases := []struct {
+			name, user, project, body string
+			want                      int
+		}{
+			{"contributor", "ben", "web", `{"roles":{"cat":"viewer"}}`, 403},
+			{"viewer", "dan", "web", `{"roles":{"cat":"viewer"}}`, 403},
+			{"org admin", "eve", "web", `{"roles":{"cat":"viewer"}}`, 403},
+			{"manager of other project only", "ann", "ops", `{"roles":{"cat":"viewer"}}`, 403},
+			{"non member", "hal", "web", `{"roles":{"cat":"viewer"}}`, 404},
+			{"other org", "gus", "web", `{"roles":{"cat":"viewer"}}`, 404},
+			{"anonymous", "", "web", `{"roles":{"cat":"viewer"}}`, 401},
+			{"unknown user", "zed", "web", `{"roles":{"cat":"viewer"}}`, 401},
+			{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+			{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+			{"missing roles", "ann", "web", `{}`, 400},
+			{"bad json", "ann", "web", `{"roles":`, 400},
+			{"invalid role", "ann", "web", `{"roles":{"ben":"owner"}}`, 400},
+			{"unknown member", "ann", "web", `{"roles":{"zed":"viewer"}}`, 400},
+			{"user outside project", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		}
+		for _, c := range cases {
+			t.Run(c.name, func(t *testing.T) {
+				h := newServer()
+				code, body := do(t, h, "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+				if code != c.want {
+					t.Fatalf("got %d want %d: %s", code, c.want, body)
+				}
+			})
+		}
+	})
+
+	t.Run("one refused change leaves everything unchanged", func(t *testing.T) {
+		h := newServer()
+		// ben and cat are valid, hal is not a member: nothing may be written.
+		code, body := do(t, h, "PUT", "/projects/web/members", "ann",
+			`{"roles":{"ben":"viewer","cat":"manager","hal":"viewer"}}`)
+		if code != 400 {
+			t.Fatalf("got %d: %s", code, body)
+		}
+		if r := memberRoleOf(t, h, "web", "ben"); r != "contributor" {
+			t.Fatalf("ben changed to %q", r)
+		}
+		if r := memberRoleOf(t, h, "web", "cat"); r != "contributor" {
+			t.Fatalf("cat changed to %q", r)
+		}
+		if a := dbValue(t, h, `SELECT assignee FROM tasks WHERE id = 't1'`); a != "ben" {
+			t.Fatalf("t1 assignee changed to %q", a)
+		}
+	})
+}
