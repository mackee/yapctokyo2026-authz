+
+// newMembership builds an unsaved membership of the user in the project; call
+// save to insert it.
+func (r *Project) newMembership(userID, role string) *Membership {
+	return &Membership{ProjectID: r.ID, UserID: userID, Role: role}
+}
+
+// destroy removes the membership.
+func (r *Membership) destroy(ctx context.Context, db DB) error {
+	if _, err := db.ExecContext(ctx,
+		`DELETE FROM memberships WHERE project_id = ? AND user_id = ?`, r.ProjectID, r.UserID); err != nil {
+		return err
+	}
+	return nil
+}
