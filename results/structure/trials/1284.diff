diff --git a/internal/model/membership_move.go b/internal/model/membership_move.go
new file mode 100644
index 0000000..49a4199
--- /dev/null
+++ b/internal/model/membership_move.go
@@ -0,0 +1,105 @@
+package model
+
+import (
+	"context"
+	"errors"
+)
+
+// moveMemberAggregate moves one member from one project to another, keeping
+// the role. Tasks the member was assigned in the source project are
+// unassigned, because an assignee must be a member of the task's project.
+type moveMemberAggregate struct {
+	from  *Membership // the member in the source project
+	user  *User
+	to    *Project
+	tasks []*Task // from.AssignedTasks
+}
+
+func loadMoveMember(ctx context.Context, tx DB, fromProjectID, userID, toProjectID string) (*moveMemberAggregate, error) {
+	from, err := NewMembershipTable().Find(ctx, tx, fromProjectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	to, err := NewProjectTable().Find(ctx, tx, toProjectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	u, err := from.User(ctx, tx)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "member must be an existing user")
+	} else if err != nil {
+		return nil, err
+	}
+	if _, err := to.Membership(ctx, tx, userID); err == nil {
+		return nil, deny(ErrInvalid, "user is already a member of the destination project")
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	tasks, err := from.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &moveMemberAggregate{from: from, user: u, to: to, tasks: tasks}, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.from.ProjectID == a.to.ID {
+		return deny(ErrInvalid, "destination must be a different project")
+	}
+	if a.user.Org != a.to.Org {
+		return deny(ErrInvalid, "project members must belong to the project's organization")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.from.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	m := a.to.newMembership(a.user.ID, a.from.Role)
+	if err := m.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
+
+// Move moves the user from the authz project to the destination project with
+// the same role. The actor must manage members of both projects, and must be
+// able to read the destination (else ErrNotFound). Tasks assigned to the user
+// in the source project become unassigned.
+func (*MembershipTable) Move(ctx context.Context, db DB, authz ProjectAuthz, userID, toProjectID string) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	toAuthz, err := NewProjectAuthz(ctx, db, authz.Actor(), toProjectID)
+	if err != nil {
+		return nil, err
+	}
+	if err := toAuthz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveMember(ctx, tx, authz.ProjectID(), userID, toAuthz.ProjectID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		m, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
