new file mode 100644
index 0000000..d543f87
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,83 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager removes contributor", "ann", "/projects/web/members/ben", 204},
+		{"manager removes manager", "ann", "/projects/web/members/ivy", 204},
+		{"contributor", "ben", "/projects/web/members/cat", 403},
+		{"viewer", "dan", "/projects/web/members/ben", 403},
+		{"org admin without role", "eve", "/projects/web/members/ben", 403},
+		{"non member", "hal", "/projects/web/members/ben", 404},
+		{"other org", "gus", "/projects/web/members/ben", 404},
+		{"anonymous", "", "/projects/web/members/ben", 401},
+		{"unknown user", "zed", "/projects/web/members/ben", 401},
+		{"archived", "ann", "/projects/legacy/members/ben", 409},
+		{"target not a member", "ann", "/projects/web/members/hal", 404},
+		{"target in another org", "ann", "/projects/web/members/gus", 404},
+		{"manager of ops removes contributor", "ivy", "/projects/ops/members/cat", 204},
+		{"viewer of ops cannot remove", "ann", "/projects/ops/members/cat", 403},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestRemoveMemberTwice(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "DELETE", "/projects/ops/members/cat", "ivy", ""); code != 204 {
+		t.Fatalf("first removal: got %d body=%s", code, body)
+	}
+	if code, _ := do(t, srv, "DELETE", "/projects/ops/members/cat", "ivy", ""); code != 404 {
+		t.Fatalf("second removal: got %d want 404", code)
+	}
+}
+
+// Removing a member unassigns their tasks in that project only, so no task
+// keeps a non-member assignee, and their tasks in other projects are untouched.
+func TestRemoveMemberUnassignsProjectTasks(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "DELETE", "/projects/web/members/ben", "ann", ""); code != 204 {
+		t.Fatalf("removal: got %d body=%s", code, body)
+	}
+
+	assignee := func(path string) string {
+		t.Helper()
+		code, body := do(t, srv, "GET", path, "ann", "")
+		if code != 200 {
+			t.Fatalf("GET %s: got %d body=%s", path, code, body)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		return task.AssigneeID
+	}
+
+	if got := assignee("/projects/web/tasks/t1"); got != "" {
+		t.Fatalf("web t1 assignee = %q, want unassigned", got)
+	}
+	if got := assignee("/projects/web/tasks/t2"); got != "cat" {
+		t.Fatalf("web t2 assignee = %q, want cat (untouched)", got)
+	}
+	if got := assignee("/projects/legacy/tasks/t5"); got != "ben" {
+		t.Fatalf("legacy t5 assignee = %q, want ben (other project untouched)", got)
+	}
+
+	// ben is no longer a member of web, so web's tasks are not readable by ben.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads web after removal: got %d want 404", code)
+	}
+}
