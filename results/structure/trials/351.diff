 }
 
+// setRolesAggregate changes the roles of several members of one project in one
+// operation. Either every change applies or none does.
+type setRolesAggregate struct {
+	project projectRecord
+	changes []membershipRecord // existing memberships, with the new role set
+}
+
+func loadSetRoles(x *tx, projectID string, roles map[string]string) (*setRolesAggregate, error) {
+	p, ok := x.findProject(projectID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if len(roles) == 0 {
+		return nil, deny(ErrInvalid, "roles must not be empty")
+	}
+	userIDs := make([]string, 0, len(roles))
+	for uid := range roles {
+		userIDs = append(userIDs, uid)
+	}
+	sort.Strings(userIDs)
+	a := &setRolesAggregate{project: p}
+	for _, uid := range userIDs {
+		m, ok := x.findMembership(projectID, uid)
+		if !ok {
+			return nil, deny(ErrInvalid, "user "+uid+" is not a member of the project")
+		}
+		m.Role = roles[uid]
+		a.changes = append(a.changes, m)
+	}
+	return a, nil
+}
+
+func (a *setRolesAggregate) validate() error {
+	for _, m := range a.changes {
+		if !isRole(m.Role) {
+			return deny(ErrInvalid, "invalid role for user "+m.UserID)
+		}
+	}
+	return nil
+}
+
+// save writes the changes and returns the project's members after them.
+func (a *setRolesAggregate) save(x *tx) []MemberView {
+	for _, m := range a.changes {
+		m.save(x)
+	}
+	members := x.membershipsOf(a.project.ID)
+	out := make([]MemberView, 0, len(members))
+	for _, m := range members {
+		out = append(out, m.view())
+	}
+	return out
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task taskRecord
