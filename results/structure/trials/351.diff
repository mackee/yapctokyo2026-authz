diff --git a/main_members_test.go b/main_members_test.go
new file mode 100644
index 0000000..2b74f32
--- /dev/null
+++ b/main_members_test.go
@@ -0,0 +1,115 @@
+package main
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func TestSetMemberRoles(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager changes roles", "ann", "web", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 200},
+		{"manager of other project", "ivy", "ops", `{"roles":{"cat":"viewer"}}`, 200},
+		{"manager may change own role", "ann", "web", `{"roles":{"ann":"contributor","ivy":"manager"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"manager role elsewhere is not enough", "ann", "ops", `{"roles":{"cat":"viewer"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"cat":"viewer"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"cat":"viewer"}}`, 404},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"unknown role", "ann", "web", `{"roles":{"ben":"owner"}}`, 400},
+		{"empty role", "ann", "web", `{"roles":{"ben":""}}`, 400},
+		{"target not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"target in other org", "ann", "web", `{"roles":{"gus":"viewer"}}`, 400},
+		{"one bad entry rejects all", "ann", "web", `{"roles":{"ben":"viewer","hal":"viewer"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"malformed body", "ann", "web", `{"roles":`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMemberRolesAnonymous(t *testing.T) {
+	code, _ := do(t, newServer(), "PUT", "/projects/web/members", "", `{"roles":{"ben":"viewer"}}`)
+	if code != 401 {
+		t.Fatalf("got %d want 401", code)
+	}
+}
+
+type memberJSON struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func TestSetMemberRolesResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got []memberJSON
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []memberJSON{
+		{"ann", "manager"},
+		{"ben", "viewer"},
+		{"cat", "contributor"},
+		{"dan", "contributor"},
+		{"ivy", "manager"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %d members, want %d: %s", len(got), len(want), body)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("member %d: got %+v want %+v", i, got[i], want[i])
+		}
+	}
+}
+
+func TestSetMemberRolesIsAllOrNothing(t *testing.T) {
+	srv := newServer()
+	// One valid and one invalid entry: the whole request fails.
+	if code, _ := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","hal":"viewer"}}`); code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	// A later successful request shows the full member list: ben is unchanged.
+	code, body := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"cat":"viewer"}}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	if !strings.Contains(body, `{"userId":"ben","role":"contributor"}`) {
+		t.Fatalf("ben's role changed by a rejected request: %s", body)
+	}
+	if !strings.Contains(body, `{"userId":"cat","role":"viewer"}`) {
+		t.Fatalf("cat's role not changed: %s", body)
+	}
+}
+
+func TestSetMemberRolesTakesEffect(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer"}}`); code != 200 {
+		t.Fatalf("demote: got %d want 200", code)
+	}
+	// ben was a contributor and could create tasks; as a viewer he cannot.
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Fatalf("demoted ben create: got %d want 403", code)
+	}
+	if code, _ := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"contributor"}}`); code != 200 {
+		t.Fatalf("promote: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 201 {
+		t.Fatalf("promoted ben create: got %d want 201", code)
+	}
+}
