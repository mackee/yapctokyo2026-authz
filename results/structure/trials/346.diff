+func TestTransfer(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/cat/transfer", `{"toOrgId":"globex"}`, 200},
+		{"member is not org admin", "ann", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 403},
+		{"viewer", "dan", "/orgs/acme/users/cat/transfer", `{"toOrgId":"globex"}`, 403},
+		{"anonymous", "", "/orgs/acme/users/cat/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown user", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"user of another org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"admin of another org", "gus", "/orgs/acme/users/cat/transfer", `{"toOrgId":"globex"}`, 404},
+		{"unknown target org", "eve", "/orgs/acme/users/cat/transfer", `{"toOrgId":"initech"}`, 400},
+		{"same org", "eve", "/orgs/acme/users/cat/transfer", `{"toOrgId":"acme"}`, 400},
+		{"missing target org", "eve", "/orgs/acme/users/cat/transfer", `{}`, 400},
+		{"invalid body", "eve", "/orgs/acme/users/cat/transfer", `nope`, 400},
+		{"archived project membership", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/cat/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var v map[string]string
+	if err := json.Unmarshal([]byte(body), &v); err != nil {
+		t.Fatal(err)
+	}
+	if v["id"] != "cat" || v["orgId"] != "globex" || len(v) != 2 {
+		t.Fatalf("got body %s", body)
+	}
+}
+
+func TestTransferDropsOldOrgAccess(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/orgs/acme/users/cat/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: got %d: %s", code, body)
+	}
+
+	// cat's acme memberships are gone: no access to acme projects.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "cat", ""); code != 404 {
+		t.Fatalf("cat reads web: got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`); code != 404 {
+		t.Fatalf("cat edits ops: got %d want 404", code)
+	}
+
+	// cat's tasks in acme projects are unassigned; other tasks are untouched.
+	code, body := do(t, srv, "GET", "/projects/web/tasks", "ann", "")
+	if code != 200 {
+		t.Fatal(code)
+	}
+	var web []Task
+	json.Unmarshal([]byte(body), &web)
+	for _, task := range web {
+		if task.ID == "t2" && task.Assignee != "" {
+			t.Fatalf("t2 still assigned to %q", task.Assignee)
+		}
+		if task.ID == "t1" && task.Assignee != "ben" {
+			t.Fatalf("t1 assignee changed to %q", task.Assignee)
+		}
+	}
+	code, body = do(t, srv, "GET", "/projects/ops/tasks", "eve", "")
+	if code != 200 {
+		t.Fatal(code)
+	}
+	var ops []Task
+	json.Unmarshal([]byte(body), &ops)
+	for _, task := range ops {
+		if task.ID == "t4" && task.Assignee != "" {
+			t.Fatalf("t4 still assigned to %q", task.Assignee)
+		}
+	}
+
+	// cat is no longer in acme, so acme admins cannot transfer cat again.
+	if code, _ := do(t, srv, "POST", "/orgs/acme/users/cat/transfer", "eve", `{"toOrgId":"globex"}`); code != 404 {
+		t.Fatalf("transfer from old org: got %d want 404", code)
+	}
+}
+
+func TestTransferClearsOrgAdmin(t *testing.T) {
