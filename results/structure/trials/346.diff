+// transferUserAggregate moves one user from fromOrg to toOrg. It drops the
+// user's memberships in fromOrg's projects and unassigns the user's tasks in
+// them, so the project-member and assignee rules keep holding.
+type transferUserAggregate struct {
+	user        userRecord
+	toOrg       string
+	memberships []membershipRecord // removed
+	unassigned  []taskRecord       // saved with AssigneeID cleared
+}
+
+func loadTransferUser(x *tx, userID, fromOrg, toOrg string) (*transferUserAggregate, error) {
+	u, ok := x.findUser(userID)
+	if !ok || u.Org != fromOrg {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if _, ok := x.findOrg(toOrg); !ok {
+		return nil, deny(ErrInvalid, "unknown organization")
+	}
+	a := &transferUserAggregate{user: u, toOrg: toOrg}
+	a.user.Org = toOrg
+	a.user.OrgAdmin = false // org admin rights belong to the organization they were granted in
+
+	for _, m := range x.membershipsOfUser(userID) {
+		p, _ := x.findProject(m.ProjectID)
+		if p.Org != fromOrg {
+			continue
+		}
+		if p.Archived {
+			return nil, deny(ErrArchived, "project is archived")
+		}
+		a.memberships = append(a.memberships, m)
+	}
+	for _, t := range x.tasksAssignedTo(userID) {
+		p, _ := x.findProject(t.ProjectID)
+		if p.Org != fromOrg {
+			continue
+		}
+		if p.Archived {
+			return nil, deny(ErrArchived, "project is archived")
+		}
+		t.AssigneeID = ""
+		a.unassigned = append(a.unassigned, t)
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if a.user.Org != a.toOrg || a.user.OrgAdmin {
+		return deny(ErrInvalid, "invalid transfer")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) save(x *tx) UserView {
+	a.user.save(x)
+	for _, m := range a.memberships {
+		m.destroy(x)
+	}
+	for _, t := range a.unassigned {
+		t.save(x)
+	}
+	return UserView{ID: a.user.ID, OrgID: a.user.Org}
+}
