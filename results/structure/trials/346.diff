+// ---- org and user capabilities -------------------------------------------------
+
+// ManageUser is the org-admin capability for one user of one organization.
+type ManageUser interface {
+	// Transfer moves the user to another organization. The user's memberships
+	// and task assignments in the old organization are dropped. It is 409 if
+	// any of them are in an archived project, and 400 if toOrgID is unknown or
+	// is the user's current organization.
+	Transfer(toOrgID string) (UserView, error)
+}
+
+type orgScope struct {
+	as  *actorScope
+	oid string
+}
+
+func (s *orgScope) ID() string { return s.oid }
+func (s *orgScope) User(userID string) UserScope {
+	return &userScope{os: s, uid: userID}
+}
+
+type userScope struct {
+	os  *orgScope
+	uid string
+}
+
+// Manage applies the org-admin rule: the actor must belong to the organization
+// in the path (else 404), must be an org admin of it (else 403), and the user
+// must belong to it (else 404).
+func (s *userScope) Manage() (ManageUser, error) {
+	err := s.os.as.a.db.view(func(x *tx) error {
+		if s.os.as.actor.org != s.os.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		if !s.os.as.actor.orgAdmin {
+			return deny(ErrForbidden, "forbidden")
+		}
+		u, ok := x.findUser(s.uid)
+		if !ok || u.Org != s.os.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &manageUser{us: s}, nil
+}
+
+type manageUser struct{ us *userScope }
+
+func (m *manageUser) Transfer(toOrgID string) (UserView, error) {
+	if toOrgID == m.us.os.oid {
+		return UserView{}, deny(ErrInvalid, "user already belongs to that organization")
+	}
+	var v UserView
+	err := m.us.os.as.a.db.update(func(x *tx) error {
+		agg, err := loadTransferUser(x, m.us.uid, m.us.os.oid, toOrgID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		v = agg.save(x)
+		return nil
+	})
+	return v, err
+}
