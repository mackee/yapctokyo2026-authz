--- /dev/null
+++ b/internal/model/project_roles.go
@@ -0,0 +1,40 @@
+package model
+
+import "context"
+
+// ChangeRoles changes the roles of several members of the project at once, all
+// or nothing, and returns the project's members afterwards, ordered by user ID.
+// roles maps user ID to the new role. It asks the authorization object whether
+// the actor may manage members, then runs the operation's aggregate in a
+// transaction.
+func (*MembershipTable) ChangeRoles(ctx context.Context, db DB, authz ProjectAuthz, roles map[string]string) ([]*Membership, error) {
+	if len(roles) == 0 {
+		return nil, deny(ErrInvalid, "roles must not be empty")
+	}
+	for _, role := range roles {
+		if !isValidRole(role) {
+			return nil, deny(ErrInvalid, "role must be manager, contributor or viewer")
+		}
+	}
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var out []*Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadChangeRoles(ctx, tx, authz.ProjectID(), roles)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if _, err := agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		out, err = agg.project.Memberships(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
