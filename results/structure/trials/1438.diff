 	return t, nil
 }
 
+// changeRolesAggregate changes the roles of several members of one project.
+type changeRolesAggregate struct {
+	project *Project
+	members []*Membership // the members to change, ordered by user ID
+	roles   map[string]string
+	// assigned reports, per user ID, whether the member is assigned tasks in the project.
+	assigned map[string]bool
+}
+
+func loadChangeRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*changeRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &changeRolesAggregate{project: p, roles: roles, assigned: map[string]bool{}}
+	all, err := p.Memberships(ctx, tx) // ordered by user ID
+	if err != nil {
+		return nil, err
+	}
+	found := map[string]bool{}
+	for _, m := range all {
+		if _, ok := roles[m.UserID]; !ok {
+			continue
+		}
+		found[m.UserID] = true
+		a.members = append(a.members, m)
+		tasks, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.assigned[m.UserID] = len(tasks) > 0
+	}
+	for id := range roles {
+		if !found[id] {
+			return nil, deny(ErrInvalid, "user "+id+" is not a member of the project")
+		}
+	}
+	return a, nil
+}
+
+func (a *changeRolesAggregate) validate() error {
+	for _, m := range a.members {
+		role := a.roles[m.UserID]
+		if !isValidRole(role) {
+			return deny(ErrInvalid, "role must be manager, contributor or viewer")
+		}
+		if !isWriterRole(role) && a.assigned[m.UserID] {
+			return deny(ErrInvalid, m.UserID+" is assigned tasks and must stay a contributor or manager")
+		}
+	}
+	return nil
+}
+
+func (a *changeRolesAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for _, m := range a.members {
+		if err := m.changeRole(ctx, tx, a.roles[m.UserID]); err != nil {
+			return nil, err
+		}
+	}
+	return a.members, nil
+}
+
