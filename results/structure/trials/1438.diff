+func TestChangeRoles(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager", "ann", "web", `{"roles":{"dan":"contributor"}}`, 200},
+		{"manager several", "ann", "web", `{"roles":{"dan":"manager","ben":"manager"}}`, 200},
+		{"demote assignee", "ann", "web", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 400},
+		{"demote without tasks", "ann", "web", `{"roles":{"ivy":"viewer"}}`, 200},
+		{"not a member", "ann", "web", `{"roles":{"dan":"contributor","hal":"viewer"}}`, 400},
+		{"unknown user", "ann", "web", `{"roles":{"zed":"viewer"}}`, 400},
+		{"bad role", "ann", "web", `{"roles":{"dan":"owner"}}`, 400},
+		{"bad role before access", "hal", "web", `{"roles":{"dan":"owner"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"no roles", "ann", "web", `{}`, 400},
+		{"contributor", "ben", "web", `{"roles":{"dan":"manager"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"dan":"manager"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"manager"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"dan":"manager"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"dan":"manager"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"manager"}}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestChangeRolesResult(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","ivy":"viewer"}}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got []map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]string{"ann": "manager", "ben": "contributor", "cat": "contributor", "dan": "contributor", "ivy": "viewer"}
+	if len(got) != len(want) {
+		t.Fatalf("got %v", got)
+	}
+	for _, m := range got {
+		if want[m["userId"]] != m["role"] {
+			t.Fatalf("got %v want %v", got, want)
+		}
+	}
+	// dan is a contributor now and can create tasks; ivy is a viewer and cannot.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("dan create: %d", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ivy", `{"title":"x"}`); code != 403 {
+		t.Fatalf("ivy create: %d", code)
+	}
+}
+
+func TestChangeRolesAllOrNothing(t *testing.T) {
+	h := newServer()
+	// ben is assigned t1, so the demotion fails and dan must stay a viewer.
+	if code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","ben":"viewer"}}`); code != 400 {
+		t.Fatal(code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 403 {
+		t.Fatalf("dan was changed: %d", code)
+	}
+}
