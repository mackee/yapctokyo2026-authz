+++ b/members_test.go
@@ -0,0 +1,60 @@
+package main
+
+import (
+	"testing"
+)
+
+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager removes contributor", "ann", "/projects/web/members/ben", 204},
+		{"manager removes viewer", "ann", "/projects/web/members/dan", 204},
+		{"contributor", "ben", "/projects/web/members/cat", 403},
+		{"viewer", "dan", "/projects/web/members/ben", 403},
+		{"org admin without role", "eve", "/projects/web/members/ben", 403},
+		{"non member", "hal", "/projects/web/members/ben", 404},
+		{"other org", "gus", "/projects/web/members/ben", 404},
+		{"anonymous", "", "/projects/web/members/ben", 401},
+		{"unknown user", "zed", "/projects/web/members/ben", 401},
+		{"target not a member", "ann", "/projects/web/members/hal", 404},
+		{"project missing", "ann", "/projects/nope/members/ben", 404},
+		{"archived", "ann", "/projects/legacy/members/ben", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemovedMemberLosesProjectAccessOnly(t *testing.T) {
+	h := newServer()
+
+	code, _ := do(t, h, "DELETE", "/projects/web/members/cat", "ann", "")
+	if code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+
+	// cat is no longer a member of web, so web is hidden from cat.
+	code, _ = do(t, h, "GET", "/projects/web/tasks", "cat", "")
+	if code != 404 {
+		t.Fatalf("removed member reads web: got %d want 404", code)
+	}
+
+	// Membership in other projects is untouched.
+	code, _ = do(t, h, "GET", "/projects/ops/tasks", "cat", "")
+	if code != 200 {
+		t.Fatalf("other project after removal: got %d want 200", code)
+	}
+
+	// Removing the same member again is a 404: there is no membership left.
+	code, _ = do(t, h, "DELETE", "/projects/web/members/cat", "ann", "")
+	if code != 404 {
+		t.Fatalf("second remove: got %d want 404", code)
+	}
+}
