+func (t *manageTask) MoveTo(dst WriteProject) (TaskView, error) {
+	if dst.Role() != RoleManager {
+		return TaskView{}, deny(ErrForbidden, "moving a task requires the manager role in the destination project")
+	}
+	if dst.ID() == t.ts.ps.pid {
+		return TaskView{}, deny(ErrInvalid, "task is already in this project")
+	}
+	var v TaskView
+	err := t.ts.ps.as.a.st.tx(func(s *state) error {
+		cur := s.tasks[t.ts.tid]
+		// Assignees are bound to their project, so re-admit the current
+		// assignee for the destination. This fails (400) if they are not a
+		// contributor or manager there.
+		a, err := admit(s, dst.ID(), cur.assignee.user)
+		if err != nil {
+			return err
+		}
+		cur.project = dst.ID()
+		cur.assignee = a
+		s.tasks[cur.id] = cur
+		v = cur.view()
+		return nil
+	})
+	return v, err
+}
