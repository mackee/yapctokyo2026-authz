+
+// updateMemberRolesAggregate changes the roles of several members of one project.
+type updateMemberRolesAggregate struct {
+	changes []roleChange // ordered by user ID
+}
+
+// roleChange is one member's role change.
+type roleChange struct {
+	member   *Membership
+	role     string
+	assigned []*Task // the member's tasks in the project; loaded for viewer changes only
+}
+
+func loadUpdateMemberRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*updateMemberRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if err != nil {
+		return nil, err
+	}
+	userIDs := make([]string, 0, len(roles))
+	for id := range roles {
+		userIDs = append(userIDs, id)
+	}
+	sort.Strings(userIDs)
+	a := &updateMemberRolesAggregate{}
+	for _, id := range userIDs {
+		m, err := p.Membership(ctx, tx, id)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "roles can only be changed for members of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		c := roleChange{member: m, role: roles[id]}
+		if c.role == RoleViewer {
+			if c.assigned, err = m.AssignedTasks(ctx, tx); err != nil {
+				return nil, err
+			}
+		}
+		a.changes = append(a.changes, c)
+	}
+	return a, nil
+}
+
+func (a *updateMemberRolesAggregate) validate() error {
+	for _, c := range a.changes {
+		if !validRoles[c.role] {
+			return deny(ErrInvalid, "invalid role")
+		}
+		// An assignee must be a contributor or manager of the task's project.
+		if c.role == RoleViewer && len(c.assigned) > 0 {
+			return deny(ErrInvalid, "a member assigned to tasks must remain a contributor or manager")
+		}
+	}
+	return nil
+}
+
+func (a *updateMemberRolesAggregate) apply(ctx context.Context, tx DB) error {
+	for _, c := range a.changes {
+		if err := c.member.setRole(ctx, tx, c.role); err != nil {
+			return err
+		}
+	}
+	return nil
+}
