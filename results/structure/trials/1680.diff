+type memberRole struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// assertMemberRoles decodes a member list response and compares it with want.
+func assertMemberRoles(t *testing.T, body string, want []memberRole) {
+	t.Helper()
+	var got []memberRole
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("decode %q: %v", body, err)
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("members = %v, want %v", got, want)
+	}
+}
+
+func TestUpdateMemberRoles(t *testing.T) {
+	t.Run("manager changes several roles at once", func(t *testing.T) {
+		code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann",
+			`{"roles":{"dan":"contributor","ivy":"contributor"}}`)
+		if code != 200 {
+			t.Fatalf("got %d: %s", code, body)
+		}
+		assertMemberRoles(t, body, []memberRole{
+			{"ann", "manager"}, {"ben", "contributor"}, {"cat", "contributor"},
+			{"dan", "contributor"}, {"ivy", "contributor"},
+		})
+	})
+
+	t.Run("a rejected batch changes nothing", func(t *testing.T) {
+		srv := newServer()
+		// ben is assigned t1 in web, so he cannot become a viewer; dan's change
+		// in the same request must not stick either.
+		code, body := do(t, srv, "PUT", "/projects/web/members", "ann",
+			`{"roles":{"dan":"contributor","ben":"viewer"}}`)
+		if code != 400 {
+			t.Fatalf("got %d: %s", code, body)
+		}
+		// A no-op batch reads back the current roles.
+		code, body = do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"ann":"manager"}}`)
+		if code != 200 {
+			t.Fatalf("got %d: %s", code, body)
+		}
+		assertMemberRoles(t, body, []memberRole{
+			{"ann", "manager"}, {"ben", "contributor"}, {"cat", "contributor"},
+			{"dan", "viewer"}, {"ivy", "manager"},
+		})
+	})
+
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"contributor", "ben", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "/projects/web/members", `{"roles":{"ann":"viewer"}}`, 403},
+		{"org admin", "eve", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 401},
+		{"archived", "ann", "/projects/legacy/members", `{"roles":{"ben":"contributor"}}`, 409},
+		{"invalid role", "ann", "/projects/web/members", `{"roles":{"dan":"owner"}}`, 400},
+		{"invalid role by viewer", "dan", "/projects/web/members", `{"roles":{"dan":"owner"}}`, 400},
+		{"empty roles", "ann", "/projects/web/members", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "/projects/web/members", `{}`, 400},
+		{"malformed body", "ann", "/projects/web/members", `{"roles":`, 400},
+		{"target not a member", "ann", "/projects/web/members", `{"roles":{"hal":"viewer"}}`, 400},
+		{"target in other org", "ann", "/projects/web/members", `{"roles":{"gus":"viewer"}}`, 400},
+		{"assignee demoted to viewer", "ann", "/projects/web/members", `{"roles":{"ben":"viewer"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
