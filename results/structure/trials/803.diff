+// moveMemberAggregate moves one member from one project to another, keeping
+// the role. Tasks the member was assigned in the source project are
+// unassigned, so that no assignee stops being a member of the task's project.
+type moveMemberAggregate struct {
+	membership *Membership // the member's membership in the source project
+	to         *Project
+	existing   *Membership // the member's membership in the destination, nil if none
+	assigned   []*Task     // membership.AssignedTasks
+}
+
+func loadMoveMember(ctx context.Context, tx DB, fromID, toID, userID string) (*moveMemberAggregate, error) {
+	from, err := NewProjectTable().Find(ctx, tx, fromID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	m, err := from.Membership(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	to, err := NewProjectTable().Find(ctx, tx, toID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveMemberAggregate{membership: m, to: to}
+	if a.existing, err = to.Membership(ctx, tx, userID); errors.Is(err, ErrNoRows) {
+		a.existing = nil
+	} else if err != nil {
+		return nil, err
+	}
+	if a.assigned, err = m.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.to.ID == a.membership.ProjectID {
+		return deny(ErrInvalid, "destination must be a different project")
+	}
+	if a.existing != nil {
+		return deny(ErrInvalid, "user is already a member of the destination project")
+	}
+	switch a.membership.Role {
+	case RoleManager, RoleContributor, RoleViewer:
+	default:
+		return deny(ErrInvalid, "invalid role")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	for _, t := range a.assigned {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.membership.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	moved := &Membership{ProjectID: a.to.ID, UserID: a.membership.UserID, Role: a.membership.Role}
+	if err := moved.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return moved, nil
+}
+
