+// updateRolesAggregate changes the roles of several members of one project.
+type updateRolesAggregate struct {
+	project *Project
+	members []*Membership // the members to change, in user ID order
+	roles   []string      // roles[i] is the new role of members[i]
+}
+
+func loadUpdateRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*updateRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	userIDs := make([]string, 0, len(roles))
+	for userID := range roles {
+		userIDs = append(userIDs, userID)
+	}
+	sort.Strings(userIDs)
+	a := &updateRolesAggregate{project: p}
+	for _, userID := range userIDs {
+		m, err := p.Membership(ctx, tx, userID)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, fmt.Sprintf("%s is not a member of the project", userID))
+		} else if err != nil {
+			return nil, err
+		}
+		a.members = append(a.members, m)
+		a.roles = append(a.roles, roles[userID])
+	}
+	return a, nil
+}
+
+func (a *updateRolesAggregate) validate() error {
+	for _, role := range a.roles {
+		if !validRoles[role] {
+			return deny(ErrInvalid, fmt.Sprintf("invalid role %q: must be manager, contributor or viewer", role))
+		}
+	}
+	return nil
+}
+
+// apply changes the roles and returns the project's members after the change.
+func (a *updateRolesAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for i, m := range a.members {
+		if err := m.setRole(ctx, tx, a.roles[i]); err != nil {
+			return nil, err
+		}
+	}
+	return NewMembershipTable().ListByProject(ctx, tx, a.project.ID)
+}
