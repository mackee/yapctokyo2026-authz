--- a/internal/model/membership_table.go
+++ b/internal/model/membership_table.go
@@ -51,3 +51,42 @@ func (*MembershipTable) list(ctx context.Context, db DB, query string, args ...a
 	}
 	return out, nil
 }
+
+// ---- operations -----------------------------------------------------------------------
+
+// validRoles are the project roles a member may be given.
+var validRoles = map[string]bool{RoleManager: true, RoleContributor: true, RoleViewer: true}
+
+// MembershipTableUpdateRolesInput is the input of MembershipTable.UpdateRoles.
+type MembershipTableUpdateRolesInput struct {
+	Roles map[string]string // user ID -> new role
+}
+
+// UpdateRoles changes the roles of several members of the project, all or
+// nothing, and returns the project's members after the change. Managers only.
+// A user ID that is not a member, or a role that is not valid, fails the whole
+// request (ErrInvalid) and changes nothing.
+func (mt *MembershipTable) UpdateRoles(ctx context.Context, db DB, authz ProjectAuthz, in MembershipTableUpdateRolesInput) ([]*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if len(in.Roles) == 0 {
+		return nil, deny(ErrInvalid, "roles must not be empty")
+	}
+	var out []*Membership
+	err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadUpdateRoles(ctx, tx, authz.ProjectID(), in.Roles)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		out, err = agg.apply(ctx, tx)
+		return err
+	})
+	if err != nil {
+		return nil, err
+	}
+	return out, nil
+}
