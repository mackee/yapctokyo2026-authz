@@ -0,0 +1,68 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"unknown user", "zed", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 401},
+		{"anonymous", "", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 401},
+		{"non member source", "hal", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 404},
+		{"other org source", "gus", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 404},
+		{"viewer source", "dan", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"org admin source", "eve", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"contributor others", "ben", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 403},
+		{"cross project task", "ann", "/projects/web/tasks/t4", `{"toProjectId":"legacy"}`, 404},
+		{"archived source", "ann", "/projects/legacy/tasks/t5", `{"toProjectId":"ops"}`, 409},
+		{"missing destination", "ann", "/projects/web/tasks/t1", `{}`, 400},
+		{"invalid body", "ann", "/projects/web/tasks/t1", `{"toProjectId":`, 400},
+		{"same project", "ann", "/projects/web/tasks/t1", `{"toProjectId":"web"}`, 400},
+		{"unknown destination", "ann", "/projects/web/tasks/t1", `{"toProjectId":"nope"}`, 404},
+		{"other org destination", "ann", "/projects/web/tasks/t1", `{"toProjectId":"gx"}`, 404},
+		{"non member destination", "cat", "/projects/web/tasks/t2", `{"toProjectId":"legacy"}`, 404},
+		{"viewer destination", "ann", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 403},
+		{"archived destination", "ann", "/projects/web/tasks/t3", `{"toProjectId":"legacy"}`, 409},
+		{"assignee not in destination", "ivy", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 409},
+		{"manager moves assigned task", "ivy", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 200},
+		{"manager moves unassigned task", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 200},
+		{"contributor moves own task", "cat", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsFieldsAndChangesProject(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d want 200: %s", code, body)
+	}
+	var moved Task
+	if err := json.Unmarshal([]byte(body), &moved); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", Assignee: "cat"}
+	if moved != want {
+		t.Fatalf("moved task = %+v, want %+v", moved, want)
+	}
+
+	code, body = do(t, h, "GET", "/projects/ops/tasks/t2", "ivy", "")
+	if code != 200 {
+		t.Fatalf("get in destination: got %d want 200: %s", code, body)
+	}
+	code, _ = do(t, h, "GET", "/projects/web/tasks/t2", "ivy", "")
+	if code != 404 {
+		t.Fatalf("get in source after move: got %d want 404", code)
+	}
+}
