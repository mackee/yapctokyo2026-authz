+// expectStatus runs one request on srv and fails the test unless it returns want.
+func expectStatus(t *testing.T, srv http.Handler, method, path, user string, want int) {
+	t.Helper()
+	if code, body := do(t, srv, method, path, user, ""); code != want {
+		t.Fatalf("%s %s as %q: got %d want %d (%s)", method, path, user, code, want, body)
+	}
+}
+
+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes self", "eve", "/orgs/acme/users/eve", 204},
+		{"org admin removes unknown user", "eve", "/orgs/acme/users/zed", 404},
+		{"org admin removes user of other org", "eve", "/orgs/acme/users/gus", 404},
+		{"org admin of other org", "eve", "/orgs/globex/users/gus", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ben", 404},
+		{"member of org, not admin", "ann", "/orgs/acme/users/ben", 403},
+		{"member removes self", "ben", "/orgs/acme/users/ben", 403},
+		{"caller of other org", "gus", "/orgs/acme/users/ben", 404},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserLeavesEveryProjectOfTheOrg(t *testing.T) {
+	srv := newServer()
+	expectStatus(t, srv, "GET", "/projects/web/tasks", "ann", 200)
+	expectStatus(t, srv, "GET", "/projects/ops/tasks", "ann", 200)
+	expectStatus(t, srv, "GET", "/projects/legacy/tasks", "ann", 200)
+
+	expectStatus(t, srv, "DELETE", "/orgs/acme/users/ann", "eve", 204)
+
+	// ann was a member of web, ops and the archived legacy project; all three go.
+	expectStatus(t, srv, "GET", "/projects/web/tasks", "ann", 404)
+	expectStatus(t, srv, "GET", "/projects/ops/tasks", "ann", 404)
+	expectStatus(t, srv, "GET", "/projects/legacy/tasks", "ann", 404)
+	expectStatus(t, srv, "PATCH", "/projects/web/tasks/t2", "ann", 404)
+
+	// Other members and other organizations are untouched.
+	expectStatus(t, srv, "GET", "/projects/web/tasks", "ben", 200)
+	expectStatus(t, srv, "GET", "/projects/ops/tasks", "cat", 200)
+	expectStatus(t, srv, "GET", "/projects/gx/tasks", "gus", 200)
+	expectStatus(t, srv, "DELETE", "/orgs/acme/users/gus", "eve", 404)
+	expectStatus(t, srv, "GET", "/projects/gx/tasks", "gus", 200)
+}
+
+func TestRemoveOrgUserUnassignsTheirTasks(t *testing.T) {
+	srv := newServer()
+	expectStatus(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", 204)
+
+	// ben was assigned t1 (web) and t5 (archived legacy); both become unassigned.
+	// t2 belongs to cat and stays assigned.
+	want := map[string]string{"/projects/web/tasks/t1": "", "/projects/legacy/tasks/t5": "", "/projects/web/tasks/t2": "cat"}
+	for path, assignee := range want {
+		code, body := do(t, srv, "GET", path, "eve", "")
+		if code != 200 {
+			t.Fatalf("GET %s: got %d want 200", path, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.AssigneeID != assignee {
+			t.Fatalf("%s: assignee %q want %q", path, task.AssigneeID, assignee)
+		}
+	}
+}
+
+func TestRemoveOrgUserRevokesOrgAdmin(t *testing.T) {
+	srv := newServer()
+	expectStatus(t, srv, "DELETE", "/orgs/acme/users/eve", "eve", 204)
+
+	// eve was an org admin with no project roles: she loses read access to
+	// every acme project, and with it the right to remove users.
+	expectStatus(t, srv, "GET", "/projects/ops/tasks", "eve", 404)
+	expectStatus(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", 403)
+}
+
+func TestRemoveOrgUserIdempotentAndDeniedCallsChangeNothing(t *testing.T) {
+	srv := newServer()
+	expectStatus(t, srv, "DELETE", "/orgs/acme/users/cat", "ben", 403)
+	expectStatus(t, srv, "GET", "/projects/web/tasks", "cat", 200)
+
+	expectStatus(t, srv, "DELETE", "/orgs/acme/users/cat", "eve", 204)
+	expectStatus(t, srv, "DELETE", "/orgs/acme/users/cat", "eve", 204)
+	expectStatus(t, srv, "GET", "/projects/web/tasks", "cat", 404)
+}
