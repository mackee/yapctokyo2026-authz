+// destroy removes the member from the project.
+func (r *Membership) destroy(ctx context.Context, db DB) error {
+	if _, err := db.ExecContext(ctx, `DELETE FROM memberships WHERE project_id = ? AND user_id = ?`, r.ProjectID, r.UserID); err != nil {
+		return err
+	}
+	return nil
+}
+
+// revokeOrgAdmin clears the user's org-admin flag.
+func (r *User) revokeOrgAdmin(ctx context.Context, db DB) error {
+	r.OrgAdmin = false
+	return r.save(ctx, db)
+}
