+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager moves unassigned", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 200},
+		{"manager moves to project where assignee contributes", "ivy", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 200},
+		{"assignee not in destination", "ivy", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 409},
+		{"contributor own task", "ben", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"contributor others", "cat", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 403},
+		{"viewer", "dan", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 403},
+		{"org admin without role", "eve", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 403},
+		{"non member", "hal", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 404},
+		{"other org", "gus", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 401},
+		{"cross project id", "ivy", "/projects/ops/tasks/t1", `{"toProjectId":"web"}`, 404},
+		{"archived source", "ann", "/projects/legacy/tasks/t5", `{"toProjectId":"web"}`, 409},
+		{"archived destination", "ann", "/projects/web/tasks/t3", `{"toProjectId":"legacy"}`, 409},
+		{"destination missing", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"nope"}`, 404},
+		{"destination in other org", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"gx"}`, 404},
+		{"destination viewer only", "ann", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 403},
+		{"same project", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"web"}`, 400},
+		{"missing destination field", "ivy", "/projects/web/tasks/t3", `{}`, 400},
+		{"invalid body", "ivy", "/projects/web/tasks/t3", `not json`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsTaskFields(t *testing.T) {
+	srv := newServer()
+	code, body := do(t, srv, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got Task
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", Assignee: "cat"}
+	if got != want {
+		t.Fatalf("moved task = %+v, want %+v", got, want)
+	}
+
+	code, _ = do(t, srv, "GET", "/projects/web/tasks/t2", "ivy", "")
+	if code != 404 {
+		t.Fatalf("task still readable in source project: %d", code)
+	}
+	code, body = do(t, srv, "GET", "/projects/ops/tasks/t2", "ivy", "")
+	if code != 200 {
+		t.Fatalf("task not readable in destination project: %d %s", code, body)
+	}
+}
