+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestMoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager of both moves", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 200},
+		{"manager of source only", "ann", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"unknown caller", "zed", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 401},
+		{"anonymous", "", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 401},
+		{"contributor", "ben", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer", "dan", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin", "eve", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"non member caller", "hal", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"source in other org", "gus", "/projects/web/members/ben/move", `{"toProjectId":"gx"}`, 404},
+		{"source missing", "ann", "/projects/nope/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"user not in source", "ann", "/projects/web/members/hal/move", `{"toProjectId":"ops"}`, 404},
+		{"destination missing", "ann", "/projects/web/members/ben/move", `{"toProjectId":"nope"}`, 404},
+		{"destination in other org", "ann", "/projects/web/members/ben/move", `{"toProjectId":"gx"}`, 404},
+		{"archived destination", "ann", "/projects/web/members/ben/move", `{"toProjectId":"legacy"}`, 409},
+		{"already in destination", "ivy", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 409},
+		{"same project", "ann", "/projects/web/members/ben/move", `{"toProjectId":"web"}`, 400},
+		{"empty destination", "ann", "/projects/web/members/ben/move", `{"toProjectId":""}`, 400},
+		{"bad body", "ann", "/projects/web/members/ben/move", `nope`, 400},
+		{"archived source", "ann", "/projects/legacy/members/ben/move", `{"toProjectId":"web"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d (%s)", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestMoveMemberResponseAndEffect(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]string{"userId": "ben", "projectId": "ops", "role": "contributor"}
+	if len(got) != len(want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	for k, v := range want {
+		if got[k] != v {
+			t.Fatalf("got %v want %v", got, want)
+		}
+	}
+	app := h.(*appHandler)
+	if role, _ := findRole(t.Context(), app.db, "web", "ben"); role != "" {
+		t.Fatalf("ben still in web as %q", role)
+	}
+	if role, _ := findRole(t.Context(), app.db, "ops", "ben"); role != RoleContributor {
+		t.Fatalf("ben in ops as %q", role)
+	}
+	// ben's web task t1 can no longer be assigned to him: it becomes unassigned.
+	task, _ := findTask(t.Context(), app.db, "t1")
+	if task.Assignee != "" {
+		t.Fatalf("t1 assignee %q, want unassigned", task.Assignee)
+	}
+	// tasks of other members are untouched.
+	task, _ = findTask(t.Context(), app.db, "t2")
+	if task.Assignee != "cat" {
+		t.Fatalf("t2 assignee %q, want cat", task.Assignee)
+	}
+}
+
+func TestMoveMemberNoChangeOnFailure(t *testing.T) {
+	h := newServer()
+	// ann is only a viewer in ops... moving from ops needs manager there.
+	code, _ := do(t, h, "POST", "/projects/ops/members/cat/move", "ann", `{"toProjectId":"web"}`)
+	if code != 403 {
+		t.Fatal(code)
+	}
+	app := h.(*appHandler)
+	if role, _ := findRole(t.Context(), app.db, "ops", "cat"); role != RoleContributor {
+		t.Fatalf("cat in ops as %q", role)
+	}
+}
