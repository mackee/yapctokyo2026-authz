+// RemoveFromOrg removes the user from every project of the organization (for
+// offboarding). It is an org admin operation. The user's memberships in the
+// organization's projects are deleted, and tasks assigned to the user in those
+// projects are unassigned, so no task keeps an assignee who is no longer a
+// member. The user is not deleted. Removing a user who has no memberships in
+// the organization succeeds and changes nothing.
+func (*UserTable) RemoveFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanAdmin(); err != nil {
+		return err
+	}
+	return db.update(ctx, func(x *Tx) error {
+		agg, err := loadRemoveOrgUser(ctx, x, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, x)
+	})
+}
