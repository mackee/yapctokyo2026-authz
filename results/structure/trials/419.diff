+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes user without memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"org admin removes again", "eve", "/orgs/acme/users/ivy", 204},
+		{"contributor", "ben", "/orgs/acme/users/cat", 403},
+		{"manager of the org's projects is not an org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"viewer", "dan", "/orgs/acme/users/ben", 403},
+		{"other org admin", "gus", "/orgs/acme/users/ben", 404},
+		{"org of another organization", "eve", "/orgs/globex/users/gus", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ben", 404},
+		{"user of another organization", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed", 404},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+
+	// Before: ben is a member of web (contributor) and legacy (archived), and
+	// assigned t1 in web and t5 in legacy.
+	if code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", ""); code != 200 || !strings.Contains(body, `"assignee":"ben"`) {
+		t.Fatalf("setup: got %d %s", code, body)
+	}
+
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+
+	// ben is no longer a member of any project of the org, archived ones included.
+	for _, path := range []string{"/projects/web/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, h, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("ben GET %s: got %d want 404", path, code)
+		}
+	}
+
+	// Tasks assigned to ben in those projects are unassigned; others are kept.
+	for _, c := range []struct{ path, want string }{
+		{"/projects/web/tasks/t1", `"assignee":""`},
+		{"/projects/legacy/tasks/t5", `"assignee":""`},
+		{"/projects/web/tasks/t2", `"assignee":"cat"`},
+	} {
+		if code, body := do(t, h, "GET", c.path, "ann", ""); code != 200 || !strings.Contains(body, c.want) {
+			t.Fatalf("GET %s: got %d %s, want %s", c.path, code, body, c.want)
+		}
+	}
+
+	// Other members of the project keep their access.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat GET web tasks: got %d want 200", code)
+	}
+
+	// Another organization's project is untouched.
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatalf("gus GET gx tasks: got %d want 200", code)
+	}
+
+	// Removing again changes nothing and still succeeds.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("second remove: got %d want 204", code)
+	}
+}
+
