+// OrgAuthz is what the actor may do in one organization.
+type OrgAuthz struct {
+	actor Actor
+	org   string
+}
+
+// OrgID returns the organization the object is bound to.
+func (a OrgAuthz) OrgID() string { return a.org }
+
+// CanAdmin returns nil if the actor may administer the organization's users:
+// org admins of that organization only (else ErrForbidden).
+func (a OrgAuthz) CanAdmin() error {
+	if a.org == "" || !a.actor.orgAdmin {
+		return deny(ErrForbidden, "forbidden")
+	}
+	return nil
+}
