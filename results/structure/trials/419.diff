+// removeOrgUserAggregate removes one user from all projects of one organization.
+type removeOrgUserAggregate struct {
+	memberships []*Membership // the user's memberships in the organization's projects
+	tasks       []*Task       // tasks assigned to the user in those projects
+}
+
+func loadRemoveOrgUser(ctx context.Context, x *Tx, orgID, userID string) (*removeOrgUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, x, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != orgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	ms, err := u.Memberships(ctx, x)
+	if err != nil {
+		return nil, err
+	}
+	a := &removeOrgUserAggregate{}
+	for _, m := range ms {
+		p, err := m.Project(ctx, x)
+		if errors.Is(err, ErrNoRows) {
+			continue // no such project, so it is not in the organization
+		} else if err != nil {
+			return nil, err
+		}
+		if p.Org != orgID {
+			continue
+		}
+		tasks, err := m.AssignedTasks(ctx, x)
+		if err != nil {
+			return nil, err
+		}
+		a.memberships = append(a.memberships, m)
+		a.tasks = append(a.tasks, tasks...)
+	}
+	return a, nil
+}
+
+func (a *removeOrgUserAggregate) validate() error { return nil }
+
+func (a *removeOrgUserAggregate) apply(ctx context.Context, x *Tx) error {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, x); err != nil {
+			return err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.remove(ctx, x); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
