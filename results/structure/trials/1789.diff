diff --git a/freeze_test.go b/freeze_test.go
new file mode 100644
index 0000000..b506541
--- /dev/null
+++ b/freeze_test.go
@@ -0,0 +1,135 @@
+package main
+
+import (
+	"encoding/json"
+	"reflect"
+	"testing"
+)
+
+type memberRole struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// POST /projects/{pid}/freeze sets every member of the project to viewer
+// (managers included) and returns the member list, sorted by userId.
+func TestFreezeSetsEveryMemberToViewer(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got []memberRole
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("response is not a member list: %v: %s", err, body)
+	}
+	want := []memberRole{
+		{"ann", "viewer"},
+		{"ben", "viewer"},
+		{"cat", "viewer"},
+		{"dan", "viewer"},
+		{"ivy", "viewer"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+}
+
+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ivy", "web", 200},
+		{"manager of this project only", "ann", "web", 200},
+		{"manager of other project only", "ann", "ops", 403},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"missing project", "ann", "nope", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+		})
+	}
+}
+
+// A freeze turns every manager into a viewer, so nobody can freeze the project
+// again: the second call is refused and the member list stays as it was.
+func TestFreezeTwiceIsRefused(t *testing.T) {
+	h := newServer()
+	code1, body1 := do(t, h, "POST", "/projects/web/freeze", "ivy", "")
+	if code1 != 200 {
+		t.Fatalf("first freeze: got %d want 200: %s", code1, body1)
+	}
+	code2, body2 := do(t, h, "POST", "/projects/web/freeze", "ivy", "")
+	if code2 != 403 {
+		t.Fatalf("second freeze: got %d want 403: %s", code2, body2)
+	}
+}
+
+// After a freeze nobody can change the project's tasks. Each write was allowed
+// before the freeze, so these cases show the freeze is what blocks them.
+func TestFrozenProjectRejectsTaskWrites(t *testing.T) {
+	cases := []struct {
+		name, user, method, path, body string
+	}{
+		{"contributor own task", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"manager any task", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"manager reassign", "ann", "PATCH", "/projects/web/tasks/t1", `{"assignee":"cat"}`},
+		{"contributor create", "ben", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"manager create", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"manager delete", "ann", "DELETE", "/projects/web/tasks/t1", ""},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+				t.Fatalf("freeze: got %d want 200: %s", code, body)
+			}
+			code, body := do(t, h, c.method, c.path, c.user, c.body)
+			if code != 403 {
+				t.Fatalf("got %d want 403: %s", code, body)
+			}
+		})
+	}
+}
+
+// Freezing keeps the tasks' assignees and the project's tasks readable.
+func TestFrozenProjectKeepsAssigneesAndReads(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d want 200: %s", code, body)
+	}
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "dan", "")
+	if code != 200 {
+		t.Fatalf("read after freeze: got %d want 200: %s", code, body)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.Assignee != "ben" {
+		t.Fatalf("assignee after freeze: got %q want %q", task.Assignee, "ben")
+	}
+}
+
+// Freezing one project does not change another project's roles.
+func TestFreezeLeavesOtherProjectsAlone(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d want 200: %s", code, body)
+	}
+	// cat is a contributor of ops and assigned to ops task t4.
+	code, body := do(t, h, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"doing"}`)
+	if code != 200 {
+		t.Fatalf("ops write after web freeze: got %d want 200: %s", code, body)
+	}
+}
