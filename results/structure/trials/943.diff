+func TestRemoveOrgUserAuth(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben", 204},
+		{"manager not admin", "ann", "/orgs/acme/users/ben", 403},
+		{"unauthenticated", "", "/orgs/acme/users/ben", 401},
+		{"other org admin target", "eve", "/orgs/globex/users/gus", 404},
+		{"user in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown user", "eve", "/orgs/acme/users/nobody", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("got %d", code)
+	}
+	// ben left web and legacy (archived): no longer readable by ben.
+	for _, p := range []string{"web", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ben", ""); code != 404 {
+			t.Fatalf("%s: got %d want 404", p, code)
+		}
+	}
+	// ben's tasks are unassigned; others untouched.
+	_, body := do(t, h, "GET", "/projects/web/tasks/t1", "eve", "")
+	if !strings.Contains(body, `"assignee":""`) {
+		t.Fatalf("t1 still assigned: %s", body)
+	}
+	_, body = do(t, h, "GET", "/projects/web/tasks/t2", "eve", "")
+	if !strings.Contains(body, `"assignee":"cat"`) {
+		t.Fatalf("t2 changed: %s", body)
+	}
+	// other members stay.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat lost access: %d", code)
+	}
+}
