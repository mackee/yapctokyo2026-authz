+// removeUserFromOrgAggregate removes one user from all projects of an
+// organization, unassigning their tasks there.
+type removeUserFromOrgAggregate struct {
+	user        *User
+	orgID       string
+	memberships []*Membership
+	tasks       []*Task // tasks assigned to the user in the org's projects
+}
+
+func loadRemoveUserFromOrg(ctx context.Context, tx DB, orgID, userID string) (*removeUserFromOrgAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != orgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	ms, err := u.OrgMemberships(ctx, tx, orgID)
+	if err != nil {
+		return nil, err
+	}
+	a := &removeUserFromOrgAggregate{user: u, orgID: orgID, memberships: ms}
+	for _, m := range ms {
+		ts, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.tasks = append(a.tasks, ts...)
+	}
+	return a, nil
+}
+
+func (a *removeUserFromOrgAggregate) validate() error { return nil }
+
+func (a *removeUserFromOrgAggregate) apply(ctx context.Context, tx DB) error {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return err
+		}
+	}
+	return nil
+}
