+// orgRegistry is the whole handler-visible surface under /orgs/{orgID}.
+type orgRegistry struct {
+	db    model.DB
+	authz model.OrgAuthz
+}
+
+// orgTransformer authenticates the caller and builds the actor's
+// authorization object for {orgID}. Other organizations stop here (404).
+func orgTransformer(conn *sql.DB) tanukirpc.Transformer[*rootRegistry, *orgRegistry] {
+	return tanukirpc.NewTransformer(func(ctx tanukirpc.Context[*rootRegistry]) (*orgRegistry, error) {
+		actor, err := model.Authenticate(ctx, conn, ctx.Request().Header.Get("X-User"))
+		if err != nil {
+			return nil, err
+		}
+		authz, err := model.NewOrgAuthz(ctx, conn, actor, chi.URLParam(ctx.Request(), "orgID"))
+		if err != nil {
+			return nil, err
+		}
+		return &orgRegistry{db: conn, authz: authz}, nil
+	})
+}
+
+func removeOrgUser(ctx tanukirpc.Context[*orgRegistry], _ struct{}) (*struct{}, error) {
+	reg := ctx.Registry()
+	if err := model.NewUserTable().RemoveFromOrg(ctx, reg.db, reg.authz, chi.URLParam(ctx.Request(), "uid")); err != nil {
+		return nil, err
+	}
+	ctx.Response().WriteHeader(http.StatusNoContent)
+	return nil, nil
+}
