 // UserTable reads the users table.
 type UserTable struct{}
 
 // NewUserTable returns the users table.
 func NewUserTable() *UserTable { return &UserTable{} }
 
+// RemoveFromOrg removes the user from the organization (offboarding): the user
+// leaves every project of the organization, and tasks assigned to the user in
+// those projects become unassigned (an assignee must be a project member).
+func (ut *UserTable) RemoveFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanRemoveUser(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveUserFromOrg(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
