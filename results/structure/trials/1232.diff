+// freezeMember is one entry of the freeze response.
+type freezeMember struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// freezeProject changes every member of the project to viewer and returns the
+// members after the change.
+func freezeProject(ctx tanukirpc.Context[*projectRegistry], _ struct{}) ([]freezeMember, error) {
+	reg := ctx.Registry()
+	members, err := model.NewProjectTable().Freeze(ctx, reg.db, reg.authz)
+	if err != nil {
+		return nil, err
+	}
+	out := make([]freezeMember, 0, len(members))
+	for _, m := range members {
+		out = append(out, freezeMember{UserID: m.UserID, Role: m.Role})
+	}
+	return out, nil
+}
