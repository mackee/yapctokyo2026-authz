+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"manager other project", "ivy", "ops", 200},
+		{"contributor", "ben", "web", 403},
+		{"contributor in other project", "cat", "ops", 403},
+		{"viewer", "dan", "web", 403},
+		{"manager of a different project only", "ann", "ops", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"archived", "ann", "legacy", 409},
+		{"anonymous", "", "web", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []map[string]string{
+		{"userId": "ann", "role": "viewer"},
+		{"userId": "ben", "role": "viewer"},
+		{"userId": "cat", "role": "viewer"},
+		{"userId": "dan", "role": "viewer"},
+		{"userId": "ivy", "role": "viewer"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %v\nwant %v", got, want)
+	}
+}
+
+func TestFreezeBlocksTaskWrites(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d: %s", code, body)
+	}
+
+	cases := []struct {
+		name, method, user, path, body string
+		want                           int
+	}{
+		{"former manager cannot edit", "PATCH", "ann", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"former manager cannot edit other", "PATCH", "ivy", "/projects/web/tasks/t1", `{"title":"x"}`, 403},
+		{"former contributor cannot edit own task", "PATCH", "ben", "/projects/web/tasks/t1", `{"status":"done"}`, 403},
+		{"former manager cannot delete", "DELETE", "ann", "/projects/web/tasks/t3", "", 403},
+		{"former contributor cannot create", "POST", "cat", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"former manager cannot create", "POST", "ann", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"former manager cannot freeze again", "POST", "ann", "/projects/web/freeze", "", 403},
+		{"reads still work", "GET", "dan", "/projects/web/tasks/t1", "", 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, srv, c.method, c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+		})
+	}
+
+	// Other projects are not affected.
+	if code, body := do(t, srv, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ops task after web freeze: got %d: %s", code, body)
+	}
+}
