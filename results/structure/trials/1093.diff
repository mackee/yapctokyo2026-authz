+// CanManageMembers returns nil if the actor may change member roles in the
+// project: managers only (else ErrForbidden) and not archived (else ErrArchived).
+func (a ProjectAuthz) CanManageMembers() error {
+	if !a.CanRead() || a.role != RoleManager {
+		return deny(ErrForbidden, "forbidden")
+	}
+	if a.archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	return nil
+}
