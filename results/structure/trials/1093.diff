+type MembershipTableSetRoleInput struct {
+	UserID string
+	Role   string
+}
+
+// SetRole changes the role of a project member. Members who become viewers are
+// unassigned from their tasks in the project, since an assignee must be a
+// contributor or manager.
+func (*MembershipTable) SetRole(ctx context.Context, db DB, authz ProjectAuthz, in MembershipTableSetRoleInput) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if !validRoles[in.Role] {
+		return nil, deny(ErrInvalid, "invalid role")
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadSetRole(ctx, tx, authz.ProjectID(), in)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if m, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
