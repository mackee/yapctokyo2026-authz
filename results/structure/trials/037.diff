+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes manager", "eve", "/orgs/acme/users/ivy", 204},
+		{"repeat is harmless", "eve", "/orgs/acme/users/hal", 204},
+		{"non admin member", "ann", "/orgs/acme/users/ben", 403},
+		{"other org admin", "gus", "/orgs/acme/users/ben", 404},
+		{"target in other org", "eve", "/orgs/globex/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserRevokesProjectAccess(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ivy", "eve", ""); code != 204 {
+		t.Fatalf("remove ivy: got %d", code)
+	}
+
+	// ivy was manager of web and ops: both memberships are gone.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ivy", ""); code != 404 {
+		t.Fatalf("ivy reads web: got %d want 404", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/ops/tasks", "ivy", `{"title":"x"}`); code != 404 {
+		t.Fatalf("ivy creates in ops: got %d want 404", code)
+	}
+
+	// Other members of the same projects are unaffected.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ann", `{"title":"x"}`); code != 201 {
+		t.Fatalf("ann creates in web: got %d want 201", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat reads ops: got %d want 200", code)
+	}
+}
+
+func TestRemoveOrgUserKeepsOtherOrgs(t *testing.T) {
+	h := newServer()
+	// Removing from acme must not touch globex memberships.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/gus", "eve", ""); code != 404 {
+		t.Fatalf("got %d want 404", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatalf("gus reads gx: got %d want 200", code)
+	}
+}
+
+func TestRemoveOrgUserIncludesArchivedProjects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove ben: got %d", code)
+	}
+	// ben was contributor of archived legacy as well as web.
+	if code, _ := do(t, h, "PATCH", "/projects/legacy/tasks/t5", "ben", `{"status":"done"}`); code != 404 {
+		t.Fatalf("ben updates legacy: got %d want 404", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t1", "ben", ""); code != 404 {
+		t.Fatalf("ben reads web: got %d want 404", code)
+	}
+}
