+// RemoveFromOrgProjects removes userID from the membership of every project
+// in orgID, including archived ones. Other organizations are untouched.
+func (s *Store) RemoveFromOrgProjects(orgID, userID string) {
+	for pid, p := range s.projects {
+		if p.OrgID == orgID {
+			delete(s.members[pid], userID)
+		}
+	}
+}
