+// ManageProject is the manager-only capability for one project: everything a
+// WriteProject may do, plus changing the roles of its members.
+type ManageProject interface {
+	WriteProject
+	// SetRole changes the role of an existing member of the project. The role
+	// must be manager, contributor or viewer (else 400); a user who is not a
+	// member of the project is 404.
+	SetRole(userID, role string) (MemberView, error)
+}
+
+type manageProject struct{ writeProject }
+
+func (p *manageProject) SetRole(userID, role string) (MemberView, error) {
+	var v MemberView
+	err := p.ps.as.a.db.update(func(x *tx) error {
+		agg, err := loadSetMemberRole(x, p.ps.pid, userID, role)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		v = agg.save(x)
+		return nil
+	})
+	return v, err
+}
+
