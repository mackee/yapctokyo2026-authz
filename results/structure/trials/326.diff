+// setMemberRoleAggregate changes the role of one existing project member.
+type setMemberRoleAggregate struct {
+	member membershipRecord // carries the new role
+}
+
+func loadSetMemberRole(x *tx, projectID, userID, role string) (*setMemberRoleAggregate, error) {
+	m, ok := x.findMembership(projectID, userID)
+	if !ok {
+		return nil, deny(ErrNotFound, "member not found")
+	}
+	m.Role = role
+	return &setMemberRoleAggregate{member: m}, nil
+}
+
+func (a *setMemberRoleAggregate) validate() error {
+	if !isValidRole(a.member.Role) {
+		return deny(ErrInvalid, "role must be manager, contributor or viewer")
+	}
+	return nil
+}
+
+func (a *setMemberRoleAggregate) save(x *tx) MemberView {
+	a.member.save(x)
+	return MemberView{UserID: a.member.UserID, Role: a.member.Role}
+}
