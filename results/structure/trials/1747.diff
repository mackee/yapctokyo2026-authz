+// removeUserAggregate takes one user out of every project of the
+// organization: the user's memberships are deleted and, since an assignee must
+// be a member of the task's project, the tasks assigned to the user are
+// unassigned. Archived projects are included: leaving the organization ends
+// all access.
+type removeUserAggregate struct {
+	user        *User
+	memberships []*Membership
+	tasks       []*Task
+}
+
+func loadRemoveUser(ctx context.Context, tx DB, orgID, userID string) (*removeUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != orgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	a := &removeUserAggregate{user: u}
+	if a.memberships, err = u.Memberships(ctx, tx); err != nil {
+		return nil, err
+	}
+	if a.tasks, err = u.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *removeUserAggregate) validate() error { return nil }
+
+func (a *removeUserAggregate) apply(ctx context.Context, tx DB) error {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return err
+		}
+	}
+	return nil
+}
