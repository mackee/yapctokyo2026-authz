+func TestRemoveUserFromOrg(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes", "eve", "/orgs/acme/users/ben", 204},
+		{"user without memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"org admin removes self", "eve", "/orgs/acme/users/eve", 204},
+		{"manager is not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"viewer is not org admin", "dan", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"other org's member", "gus", "/orgs/acme/users/ben", 404},
+		{"admin of another org", "eve", "/orgs/globex/users/gus", 404},
+		{"target in another org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ben", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveUserFromOrgEffects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d", code)
+	}
+	// ben lost access to every project he belonged to, archived ones included.
+	for _, p := range []string{"web", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ben", ""); code != 404 {
+			t.Fatalf("ben on %s: got %d want 404", p, code)
+		}
+	}
+	// Other members are untouched.
+	for _, c := range []struct{ user, project string }{{"ann", "web"}, {"cat", "web"}, {"dan", "web"}, {"ann", "legacy"}, {"cat", "ops"}} {
+		if code, _ := do(t, h, "GET", "/projects/"+c.project+"/tasks", c.user, ""); code != 200 {
+			t.Fatalf("%s on %s: got %d want 200", c.user, c.project, code)
+		}
+	}
+	// An assignee must be a project member, so ben's tasks become unassigned
+	// (t1 in web, t5 in the archived legacy project); other tasks keep theirs.
+	assignee := func(user, path string) string {
+		t.Helper()
+		code, body := do(t, h, "GET", path, user, "")
+		if code != 200 {
+			t.Fatalf("%s: got %d", path, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		return task.AssigneeID
+	}
+	for _, c := range []struct{ user, path, want string }{
+		{"ann", "/projects/web/tasks/t1", ""},
+		{"ann", "/projects/legacy/tasks/t5", ""},
+		{"ann", "/projects/web/tasks/t2", "cat"},
+		{"cat", "/projects/ops/tasks/t4", "cat"},
+	} {
+		if got := assignee(c.user, c.path); got != c.want {
+			t.Fatalf("%s assignee: got %q want %q", c.path, got, c.want)
+		}
+	}
+	// Removing again is harmless.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("second remove: got %d", code)
+	}
+}
