+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin, user in no project", "eve", "/orgs/acme/users/hal", 204},
+		{"manager of the projects", "ann", "/orgs/acme/users/ben", 403},
+		{"contributor", "ben", "/orgs/acme/users/cat", 403},
+		{"admin of another org", "gus", "/orgs/acme/users/ben", 404},
+		{"org admin, org of another", "eve", "/orgs/globex/users/gus", 404},
+		{"target in another org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown user", "zed", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	srv := newServer()
+
+	// A refused attempt changes nothing.
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "ann", ""); code != 403 {
+		t.Fatalf("manager removal: got %d want 403", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben lost access after a refused removal: %d", code)
+	}
+
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("org admin removal: got %d want 204", code)
+	}
+
+	// ben is out of every acme project, the archived one included.
+	for _, path := range []string{"/projects/web/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, srv, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("%s as ben: got %d want 404", path, code)
+		}
+	}
+
+	// Tasks ben held are unassigned; tasks of other people are kept.
+	for _, c := range []struct{ path, assignee string }{
+		{"/projects/web/tasks/t1", ""},
+		{"/projects/legacy/tasks/t5", ""},
+		{"/projects/web/tasks/t2", "cat"},
+	} {
+		code, body := do(t, srv, "GET", c.path, "ann", "")
+		if code != 200 {
+			t.Fatalf("%s: got %d want 200", c.path, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.AssigneeID != c.assignee {
+			t.Fatalf("%s: assignee %q want %q", c.path, task.AssigneeID, c.assignee)
+		}
+	}
+
+	// Other members and other organizations are untouched.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat lost access: %d", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatalf("gus lost access: %d", code)
+	}
+}
+
+func TestRemoveOrgUserIsIdempotent(t *testing.T) {
+	srv := newServer()
+	for i := 0; i < 2; i++ {
+		if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+			t.Fatalf("attempt %d: got %d want 204", i+1, code)
+		}
+	}
+}
