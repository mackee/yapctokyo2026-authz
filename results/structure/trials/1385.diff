+// RemoveFromOrg takes the user out of every project of the organization: its
+// memberships there are deleted and the tasks it held there are unassigned.
+// Only org admins may do it (else ErrForbidden). A user that is not in the
+// organization is ErrNotFound. A user in no project is removed trivially.
+func (*UserTable) RemoveFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanRemoveUser(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveOrgUser(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
