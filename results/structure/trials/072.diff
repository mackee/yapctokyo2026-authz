+func (s *Store) Org(id string) bool { return s.orgs[id] }
+
 func (s *Store) User(id string) *User { return s.users[id] }
 
+// TransferUser moves a user to another organization. Org-admin rights are
+// scoped to the organization they were granted in, so they are dropped.
+// Project memberships are kept as-is; access checks already require the
+// project to be in the user's current organization, so the old roles are
+// inert until the user is moved back.
+func (s *Store) TransferUser(id, orgID string) {
+	u := s.users[id]
+	u.OrgID = orgID
+	u.OrgAdmin = false
+}
