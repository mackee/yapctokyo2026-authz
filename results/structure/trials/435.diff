+// updateRolesAggregate changes the roles of several members of one project.
+// Every target must already be a member; the caller applies all of the changes
+// or none.
+type updateRolesAggregate struct {
+	roles       map[string]string // user ID -> new role
+	memberships []*Membership     // one per user ID in roles, in user ID order
+}
+
+func loadUpdateRoles(ctx context.Context, x *Tx, projectID string, roles map[string]string) (*updateRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, x, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	userIDs := make([]string, 0, len(roles))
+	for uid := range roles {
+		userIDs = append(userIDs, uid)
+	}
+	sort.Strings(userIDs)
+	a := &updateRolesAggregate{roles: roles}
+	for _, uid := range userIDs {
+		m, err := p.Membership(ctx, x, uid)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "every user must be a member of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		a.memberships = append(a.memberships, m)
+	}
+	return a, nil
+}
+
+func (a *updateRolesAggregate) validate() error {
+	for _, m := range a.memberships {
+		if !isValidRole(a.roles[m.UserID]) {
+			return deny(ErrInvalid, "role must be manager, contributor or viewer")
+		}
+	}
+	return nil
+}
+
+func (a *updateRolesAggregate) apply(ctx context.Context, x *Tx) error {
+	for _, m := range a.memberships {
+		if err := m.setRole(ctx, x, a.roles[m.UserID]); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
