+// MembershipTableUpdateRolesInput is the input of MembershipTable.UpdateRoles.
+type MembershipTableUpdateRolesInput struct {
+	Roles map[string]string // user ID -> new role
+}
+
+// UpdateRoles changes the roles of the given members of the project, all or
+// nothing. A target that is not a member, or a role that is not valid, rejects
+// the whole update with ErrInvalid. It returns the project's memberships after
+// the change, ordered by user ID.
+func (mt *MembershipTable) UpdateRoles(ctx context.Context, db DB, authz ProjectAuthz, in MembershipTableUpdateRolesInput) ([]*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if err := db.update(ctx, func(x *Tx) error {
+		agg, err := loadUpdateRoles(ctx, x, authz.ProjectID(), in.Roles)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, x)
+	}); err != nil {
+		return nil, err
+	}
+	return mt.ListByProject(ctx, db, authz.ProjectID())
+}
+
