+// Move removes the user from the project of authz and adds them, with the same
+// role, to the destination project. The actor must be a manager of both
+// projects (neither archived); a destination the actor cannot read is
+// ErrNotFound. The user's tasks in the source project are unassigned.
+func (*MembershipTable) Move(ctx context.Context, db DB, authz ProjectAuthz, userID, destID string) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if destID == "" || destID == authz.ProjectID() {
+		return nil, deny(ErrInvalid, "destination must be a different project")
+	}
+	var moved *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		destAuthz, err := NewProjectAuthz(ctx, tx, authz.Actor(), destID)
+		if err != nil {
+			return err
+		}
+		if err := destAuthz.CanManageMembers(); err != nil {
+			return err
+		}
+		agg, err := loadMoveMember(ctx, tx, authz.ProjectID(), userID, destID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		moved, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return moved, nil
+}
