+// moveMemberAggregate moves one member from a project to another, keeping the
+// role. Tasks the member held in the source project are unassigned, since an
+// assignee must be a member of the task's project.
+type moveMemberAggregate struct {
+	membership *Membership // the member's membership in the source project
+	user       *User
+	dest       *Project
+	destExists bool // the user is already a member of dest
+	tasks      []*Task
+}
+
+func loadMoveMember(ctx context.Context, tx DB, projectID, userID, destID string) (*moveMemberAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	u, err := m.User(ctx, tx)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "member must be an existing user")
+	} else if err != nil {
+		return nil, err
+	}
+	dest, err := NewProjectTable().Find(ctx, tx, destID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveMemberAggregate{membership: m, user: u, dest: dest}
+	if _, err := dest.Membership(ctx, tx, userID); err == nil {
+		a.destExists = true
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	if a.tasks, err = m.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.destExists {
+		return deny(ErrInvalid, "user is already a member of the destination project")
+	}
+	if a.user.Org != a.dest.Org {
+		return deny(ErrInvalid, "project members must belong to the project's organization")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.membership.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	moved := &Membership{ProjectID: a.dest.ID, UserID: a.membership.UserID, Role: a.membership.Role}
+	if err := moved.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return moved, nil
+}
