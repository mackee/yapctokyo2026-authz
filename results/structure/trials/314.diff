+
+func (p *manageProject) SetRoles(roles map[string]string) ([]Member, error) {
+	if len(roles) == 0 {
+		return nil, deny(ErrInvalid, "roles must not be empty")
+	}
+	for _, r := range roles {
+		if r != RoleManager && r != RoleContributor && r != RoleViewer {
+			return nil, deny(ErrInvalid, "invalid role")
+		}
+	}
+	// Sorted so that the error for a batch with several bad entries is stable.
+	uids := make([]string, 0, len(roles))
+	for uid := range roles {
+		uids = append(uids, uid)
+	}
+	sort.Strings(uids)
+
+	var out []Member
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		for _, uid := range uids {
+			if _, ok := s.members[p.ps.pid][uid]; !ok {
+				return deny(ErrInvalid, "user "+uid+" is not a member of the project")
+			}
+		}
+		for _, uid := range uids {
+			s.members[p.ps.pid][uid] = roles[uid]
+		}
+		out = s.membersIn(p.ps.pid)
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return out, nil
+}
