+func TestSetMemberRolesAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager changes roles", "ivy", "web", `{"roles":{"ann":"viewer","dan":"contributor"}}`, 200},
+		{"manager demotes assignee", "ann", "web", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 400},
+		{"contributor", "ben", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"cat":"viewer"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"cat":"viewer"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"cat":"viewer"}}`, 401},
+		{"unknown project", "ann", "nope", `{"roles":{"cat":"viewer"}}`, 404},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"target not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"target in other org", "ann", "web", `{"roles":{"gus":"viewer"}}`, 400},
+		{"invalid role", "ann", "web", `{"roles":{"cat":"owner"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"bad body", "ann", "web", `not json`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMemberRolesResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ivy",
+		`{"roles":{"ann":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []capability.Member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []capability.Member{
+		{UserID: "ann", Role: "viewer"},
+		{UserID: "ben", Role: "contributor"},
+		{UserID: "cat", Role: "contributor"},
+		{UserID: "dan", Role: "contributor"},
+		{UserID: "ivy", Role: "manager"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+}
+
+func TestSetMemberRolesIsAllOrNothing(t *testing.T) {
+	srv := newServer()
+
+	// One valid and one invalid target: nothing may change.
+	if code, _ := do(t, srv, "PUT", "/projects/web/members", "ivy",
+		`{"roles":{"ann":"viewer","hal":"viewer"}}`); code != 400 {
+		t.Fatalf("non-member target: got %d want 400", code)
+	}
+	// Valid targets, but one change breaks an invariant (ben holds task t1).
+	if code, _ := do(t, srv, "PUT", "/projects/web/members", "ivy",
+		`{"roles":{"dan":"contributor","ben":"viewer"}}`); code != 400 {
+		t.Fatalf("assignee demotion: got %d want 400", code)
+	}
+
+	// A later successful call reports the members as they are now: ann is still
+	// a manager and dan is still a viewer. (ivy holds no tasks, so she can be
+	// demoted without breaking an invariant.)
+	code, body := do(t, srv, "PUT", "/projects/web/members", "ivy", `{"roles":{"ivy":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []capability.Member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []capability.Member{
+		{UserID: "ann", Role: "manager"},
+		{UserID: "ben", Role: "contributor"},
+		{UserID: "cat", Role: "contributor"},
+		{UserID: "dan", Role: "viewer"},
+		{UserID: "ivy", Role: "contributor"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+}
