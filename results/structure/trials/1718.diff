diff --git a/members.go b/members.go
new file mode 100644
index 0000000..ab76fee
--- /dev/null
+++ b/members.go
@@ -0,0 +1,138 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"sort"
+)
+
+type bulkRolesRequest struct {
+	Roles map[string]string `json:"roles"`
+}
+
+type memberOut struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+var validRoles = map[string]bool{RoleManager: true, RoleContributor: true, RoleViewer: true}
+
+// updateMemberRoles changes the roles of several project members at once.
+// It is all-or-nothing: if any entry cannot be applied, nothing changes.
+// Only managers may do this. The project must keep at least one manager.
+func (s *server) updateMemberRoles(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role, err := findRole(ctx, s.db, project.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "only managers may change member roles")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req bulkRolesRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || len(req.Roles) == 0 {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	for _, newRole := range req.Roles {
+		if !validRoles[newRole] {
+			writeError(w, 400, "role must be manager, contributor or viewer")
+			return
+		}
+	}
+
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+
+	rows, err := tx.QueryContext(ctx, `SELECT user_id, role FROM memberships WHERE project_id = ?`, project.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	current := map[string]string{}
+	for rows.Next() {
+		var uid, rl string
+		if err := rows.Scan(&uid, &rl); err != nil {
+			rows.Close()
+			writeError(w, 500, "internal error")
+			return
+		}
+		current[uid] = rl
+	}
+	if err := rows.Err(); err != nil {
+		rows.Close()
+		writeError(w, 500, "internal error")
+		return
+	}
+	rows.Close()
+
+	for uid := range req.Roles {
+		if _, ok := current[uid]; !ok {
+			writeError(w, 400, "user "+uid+" is not a member of the project")
+			return
+		}
+	}
+	for uid, newRole := range req.Roles {
+		current[uid] = newRole
+	}
+	managers := 0
+	for _, rl := range current {
+		if rl == RoleManager {
+			managers++
+		}
+	}
+	if managers == 0 {
+		writeError(w, 400, "project must keep at least one manager")
+		return
+	}
+	for uid, newRole := range req.Roles {
+		if _, err := tx.ExecContext(ctx, `UPDATE memberships SET role = ? WHERE project_id = ? AND user_id = ?`,
+			newRole, project.ID, uid); err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+
+	out := make([]memberOut, 0, len(current))
+	for uid, rl := range current {
+		out = append(out, memberOut{UserID: uid, Role: rl})
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].UserID < out[j].UserID })
+	writeJSON(w, 200, out)
+}
diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..9ad4e38
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,125 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+type member struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func TestBulkRolesSuccess(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var members []member
+	if err := json.Unmarshal([]byte(body), &members); err != nil {
+		t.Fatal(err)
+	}
+	want := []member{
+		{"ann", "manager"}, {"ben", "viewer"}, {"cat", "contributor"},
+		{"dan", "contributor"}, {"ivy", "manager"},
+	}
+	if len(members) != len(want) {
+		t.Fatalf("got %v want %v", members, want)
+	}
+	for i := range want {
+		if members[i] != want[i] {
+			t.Fatalf("got %v want %v", members, want)
+		}
+	}
+	// The new roles take effect: ben (now viewer) cannot create, dan (now contributor) can.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Fatalf("ben create: got %d want 403", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("dan create: got %d want 200", code)
+	}
+}
+
+func TestBulkRolesPermissions(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"anonymous", "", "web", `{"roles":{"ben":"viewer"}}`, 401},
+		{"unknown user", "zed", "web", `{"roles":{"ben":"viewer"}}`, 401},
+		{"non member", "hal", "web", `{"roles":{"ben":"viewer"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"ben":"viewer"}}`, 404},
+		{"missing project", "ann", "nope", `{"roles":{"ben":"viewer"}}`, 404},
+		{"contributor", "ben", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"ben":"viewer"}}`, 403},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestBulkRolesInvalid(t *testing.T) {
+	cases := []struct {
+		name, body string
+		want       int
+	}{
+		{"bad json", `{`, 400},
+		{"no roles", `{}`, 400},
+		{"empty roles", `{"roles":{}}`, 400},
+		{"unknown role", `{"roles":{"ben":"admin"}}`, 400},
+		{"empty role", `{"roles":{"ben":""}}`, 400},
+		{"not a member", `{"roles":{"hal":"viewer"}}`, 400},
+		{"unknown user", `{"roles":{"zed":"viewer"}}`, 400},
+		{"member of other org", `{"roles":{"gus":"viewer"}}`, 400},
+		{"removes last manager", `{"roles":{"ann":"viewer","ivy":"contributor"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/web/members", "ann", c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestBulkRolesKeepsManager(t *testing.T) {
+	// Demoting one of two managers is fine, including oneself.
+	code, _ := do(t, newServer(), "PUT", "/projects/web/members", "ann", `{"roles":{"ann":"viewer"}}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+	// Promoting someone while demoting the only manager is fine.
+	code, _ = do(t, newServer(), "PUT", "/projects/ops/members", "ivy", `{"roles":{"ivy":"viewer","cat":"manager"}}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+}
+
+func TestBulkRolesAtomic(t *testing.T) {
+	h := newServer()
+	// ben is valid, hal is not a member: nothing may change.
+	code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","hal":"viewer"}}`)
+	if code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 200 {
+		t.Fatalf("ben was changed despite the failed request: create got %d want 200", code)
+	}
+	// Same with an invalid role value after a valid entry.
+	code, _ = do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","cat":"bogus"}}`)
+	if code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"y"}`); code != 200 {
+		t.Fatalf("ben was changed despite the failed request: create got %d want 200", code)
+	}
+}
