diff --git a/transfer_test.go b/transfer_test.go
new file mode 100644
index 0000000..d84b33a
--- /dev/null
+++ b/transfer_test.go
@@ -0,0 +1,84 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestTransferCases(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin moves unassigned user", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 200},
+		{"member, not admin", "ann", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 403},
+		{"contributor, not admin", "ben", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 403},
+		{"caller in other org", "gus", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 404},
+		{"path org the caller is not in", "eve", "/orgs/globex/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"anonymous", "", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown caller", "zed", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 401},
+		{"user in another org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"user already in target org", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"acme"}`, 400},
+		{"unknown target org", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globx"}`, 400},
+		{"user still in projects", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 400},
+		{"user still in projects (manager)", "eve", "/orgs/acme/users/ivy/transfer", `{"toOrgId":"globex"}`, 400},
+		{"missing toOrgId", "eve", "/orgs/acme/users/hal/transfer", `{}`, 400},
+		{"malformed body", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d (body %s)", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/hal/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200 (body %s)", code, body)
+	}
+	var got struct {
+		ID    string `json:"id"`
+		OrgID string `json:"orgId"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.ID != "hal" || got.OrgID != "globex" {
+		t.Fatalf("got %+v", got)
+	}
+}
+
+// TestTransferEffects runs several requests against one server, so each step
+// sees the changes of the previous ones.
+func TestTransferEffects(t *testing.T) {
+	srv := newServer()
+
+	// Moving hal out of acme works once.
+	if code, body := do(t, srv, "POST", "/orgs/acme/users/hal/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("first transfer: got %d (body %s)", code, body)
+	}
+	// hal is no longer in acme, so acme's admin cannot move hal again.
+	if code, _ := do(t, srv, "POST", "/orgs/acme/users/hal/transfer", "eve", `{"toOrgId":"acme"}`); code != 404 {
+		t.Fatalf("transfer of a user already moved away: got %d want 404", code)
+	}
+	// hal is now in globex and is not an org admin there.
+	if code, _ := do(t, srv, "POST", "/orgs/globex/users/gus/transfer", "hal", `{"toOrgId":"acme"}`); code != 403 {
+		t.Fatalf("transfer by moved user: got %d want 403", code)
+	}
+
+	// Org admin rights do not carry over: eve moves to globex and loses admin there.
+	if code, body := do(t, srv, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("self transfer: got %d (body %s)", code, body)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/gx/tasks", "eve", ""); code != 404 {
+		t.Fatalf("eve reads globex project without admin rights: got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "POST", "/orgs/globex/users/gus/transfer", "eve", `{"toOrgId":"acme"}`); code != 403 {
+		t.Fatalf("eve transfers without admin rights: got %d want 403", code)
+	}
+}
