@@ -0,0 +1,79 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestMoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, project, uid, body string
+		want                           int
+	}{
+		{"manager moves", "ivy", "web", "ben", `{"toProjectId":"ops"}`, 200},
+		{"contributor cannot", "ben", "web", "cat", `{"toProjectId":"ops"}`, 403},
+		{"viewer cannot", "dan", "web", "ben", `{"toProjectId":"ops"}`, 403},
+		{"org admin cannot", "eve", "web", "ben", `{"toProjectId":"ops"}`, 403},
+		{"not a manager of target", "ann", "web", "ben", `{"toProjectId":"ops"}`, 403},
+		{"target archived", "ann", "web", "ben", `{"toProjectId":"legacy"}`, 409},
+		{"source archived", "ann", "legacy", "ben", `{"toProjectId":"web"}`, 409},
+		{"already a member", "ivy", "web", "cat", `{"toProjectId":"ops"}`, 400},
+		{"same project", "ivy", "web", "ben", `{"toProjectId":"web"}`, 400},
+		{"user not a member", "ivy", "web", "hal", `{"toProjectId":"ops"}`, 404},
+		{"target missing", "ivy", "web", "ben", `{"toProjectId":"nope"}`, 404},
+		{"target in other org", "ivy", "web", "ben", `{"toProjectId":"gx"}`, 404},
+		{"non member caller", "hal", "web", "ben", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "web", "ben", `{"toProjectId":"ops"}`, 401},
+		{"missing toProjectId", "ivy", "web", "ben", `{}`, 400},
+		{"bad json", "ivy", "web", "ben", `{`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", "/projects/"+c.project+"/members/"+c.uid+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestMoveMemberEffects(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["userId"] != "ben" || got["projectId"] != "ops" || got["role"] != "contributor" {
+		t.Fatalf("unexpected response %v", got)
+	}
+
+	// ben is no longer a member of web, and is one of ops.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben should have left web, got %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben should be in ops, got %d", code)
+	}
+
+	// his web task was unassigned (model rules are checked by do()).
+	code, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "" {
+		t.Fatalf("t1 should be unassigned, got %q", task.AssigneeID)
+	}
+
+	// moving him again from web is a 404 now.
+	if code, _ := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`); code != 404 {
+		t.Fatalf("got %d want 404", code)
+	}
+}
