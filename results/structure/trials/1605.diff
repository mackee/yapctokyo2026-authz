+// moveMemberAggregate moves one member from a project to another, keeping the
+// role. The tasks assigned to the member in the old project are unassigned,
+// since the member can no longer be their assignee.
+type moveMemberAggregate struct {
+	from  *Membership
+	to    *Project
+	user  *User
+	tasks []*Task // from.AssignedTasks
+}
+
+func loadMoveMember(ctx context.Context, tx DB, fromProjectID, userID, toProjectID string) (*moveMemberAggregate, error) {
+	from, err := NewMembershipTable().Find(ctx, tx, fromProjectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	to, err := NewProjectTable().Find(ctx, tx, toProjectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	u, err := from.User(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	if _, err := to.Membership(ctx, tx, userID); err == nil {
+		return nil, deny(ErrInvalid, "user is already a member of the target project")
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	tasks, err := from.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &moveMemberAggregate{from: from, to: to, user: u, tasks: tasks}, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.to.ID == a.from.ProjectID {
+		return deny(ErrInvalid, "target project must differ from the current project")
+	}
+	if a.user.Org != a.to.Org {
+		return deny(ErrInvalid, "member must belong to the project's organization")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.from.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	m := &Membership{ProjectID: a.to.ID, UserID: a.from.UserID, Role: a.from.Role}
+	if err := m.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
+
