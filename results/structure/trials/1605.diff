+// Move moves the user from the authorized project to another one, keeping the
+// role. The actor must be a manager of both projects (the target must be
+// readable by the actor, else ErrNotFound) and neither may be archived.
+func (*MembershipTable) Move(ctx context.Context, db DB, authz ProjectAuthz, userID, toProjectID string) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if toProjectID == "" {
+		return nil, deny(ErrInvalid, "toProjectId must not be empty")
+	}
+	if toProjectID == authz.ProjectID() {
+		return nil, deny(ErrInvalid, "target project must differ from the current project")
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		target, err := NewProjectAuthz(ctx, tx, authz.Actor(), toProjectID)
+		if err != nil {
+			return err
+		}
+		if err := target.CanManageMembers(); err != nil {
+			return err
+		}
+		agg, err := loadMoveMember(ctx, tx, authz.ProjectID(), userID, toProjectID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		m, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
