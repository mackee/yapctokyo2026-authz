@@ -45,6 +45,39 @@ func (s *state) role(projectID, userID string) string { return s.members[project
 
 func isWriterRole(role string) bool { return role == RoleManager || role == RoleContributor }
 
+func isRole(role string) bool {
+	return role == RoleManager || role == RoleContributor || role == RoleViewer
+}
+
+// setRoles changes the roles of existing members of one project. Every entry
+// is validated before it is applied; the caller's tx discards the copy on error.
+func (s *state) setRoles(projectID string, roles map[string]string) error {
+	uids := make([]string, 0, len(roles))
+	for uid := range roles {
+		uids = append(uids, uid)
+	}
+	sort.Strings(uids)
+	for _, uid := range uids {
+		if s.role(projectID, uid) == "" {
+			return deny(ErrInvalid, fmt.Sprintf("%s is not a member of the project", uid))
+		}
+		if !isRole(roles[uid]) {
+			return deny(ErrInvalid, fmt.Sprintf("invalid role for %s", uid))
+		}
+		s.members[projectID][uid] = roles[uid]
+	}
+	return nil
+}
+
+func (s *state) membersIn(projectID string) []MemberView {
+	out := []MemberView{}
+	for uid, role := range s.members[projectID] {
+		out = append(out, MemberView{UserID: uid, Role: role})
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].UserID < out[j].UserID })
+	return out
+}
