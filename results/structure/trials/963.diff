+// moveMemberAggregate moves one member from one project to another, keeping
+// the role. The member's tasks in the source project are unassigned, since the
+// member is no longer one of its contributors or managers.
+type moveMemberAggregate struct {
+	from     *Membership
+	user     *User
+	dst      *Project
+	existing *Membership // the user's membership in dst, if any
+	tasks    []*Task     // from.AssignedTasks
+}
+
+func loadMoveMember(ctx context.Context, tx DB, srcID, userID, dstID string) (*moveMemberAggregate, error) {
+	src, err := NewProjectTable().Find(ctx, tx, srcID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	from, err := src.Membership(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	dst, err := NewProjectTable().Find(ctx, tx, dstID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveMemberAggregate{from: from, dst: dst}
+	if a.user, err = from.User(ctx, tx); err != nil {
+		return nil, err
+	}
+	if a.existing, err = dst.Membership(ctx, tx, userID); errors.Is(err, ErrNoRows) {
+		a.existing = nil
+	} else if err != nil {
+		return nil, err
+	}
+	if a.tasks, err = from.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.from.ProjectID == a.dst.ID {
+		return deny(ErrInvalid, "destination must be a different project")
+	}
+	if a.user.Org != a.dst.Org {
+		return deny(ErrInvalid, "member must belong to the project's organization")
+	}
+	if a.existing != nil {
+		return deny(ErrInvalid, "user is already a member of the destination project")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.from.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	m := a.from.moveTo(a.dst)
+	if err := m.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
+
