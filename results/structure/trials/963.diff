+// CanMoveMember returns nil if the actor may move a member from this project
+// to dst: manager in both projects (else ErrForbidden), neither archived (else
+// ErrArchived).
+func (a ProjectAuthz) CanMoveMember(dst ProjectAuthz) error {
+	if !a.CanRead() || !dst.CanRead() || a.role != RoleManager || dst.role != RoleManager {
+		return deny(ErrForbidden, "only managers of both projects may move members")
+	}
+	if a.archived || dst.archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	return nil
+}
