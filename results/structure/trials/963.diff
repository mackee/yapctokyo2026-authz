+// Move moves the user from the authz project to the destination project,
+// keeping the role, and returns the new membership. The actor must be a
+// manager of both projects.
+func (*MembershipTable) Move(ctx context.Context, db DB, authz, dst ProjectAuthz, userID string) (*Membership, error) {
+	if err := authz.CanMoveMember(dst); err != nil {
+		return nil, err
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveMember(ctx, tx, authz.ProjectID(), userID, dst.ProjectID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		m, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
