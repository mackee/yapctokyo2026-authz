+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager removes contributor", "ann", "/projects/web/members/ben", 204},
+		{"manager removes other manager", "ann", "/projects/web/members/ivy", 204},
+		{"manager removes self", "ann", "/projects/web/members/ann", 204},
+		{"contributor", "ben", "/projects/web/members/cat", 403},
+		{"viewer", "dan", "/projects/web/members/ben", 403},
+		{"org admin", "eve", "/projects/web/members/ben", 403},
+		{"non member caller", "hal", "/projects/web/members/ben", 404},
+		{"other org caller", "gus", "/projects/web/members/ben", 404},
+		{"target not member", "ann", "/projects/web/members/hal", 404},
+		{"target member of other project only", "ann", "/projects/web/members/gus", 404},
+		{"archived", "ann", "/projects/legacy/members/ben", 409},
+		{"anonymous", "", "/projects/web/members/ben", 401},
+		{"missing project", "ann", "/projects/nope/members/ben", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveMemberEffects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 204 {
+		t.Fatal(code)
+	}
+	// ben lost access to web, but keeps legacy.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("removed member still has access: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/legacy/tasks", "ben", ""); code != 200 {
+		t.Fatalf("other membership affected: %d", code)
+	}
+	// ben's task in web is now unassigned; removing again is 404.
+	_, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" {
+		t.Fatalf("assignee not cleared: %q", task.Assignee)
+	}
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 404 {
+		t.Fatalf("second removal: %d", code)
+	}
+	// legacy tasks assigned to ben are untouched.
+	_, body = do(t, h, "GET", "/projects/legacy/tasks/t5", "ann", "")
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "ben" {
+		t.Fatalf("other project's task changed: %q", task.Assignee)
+	}
+}
