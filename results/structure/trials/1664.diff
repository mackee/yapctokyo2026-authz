diff --git a/org_test.go b/org_test.go
new file mode 100644
index 0000000..5a1b177
--- /dev/null
+++ b/org_test.go
@@ -0,0 +1,111 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+// DELETE /orgs/{orgID}/users/{uid} removes the user from every project of the
+// organization (archived ones included) and clears the user's task assignments
+// in those projects. Only org admins of that organization may do it.
+
+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes manager", "eve", "/orgs/acme/users/ivy", 204},
+		{"org admin removes user with no projects", "eve", "/orgs/acme/users/hal", 204},
+		{"project manager is not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"contributor is not org admin", "ben", "/orgs/acme/users/cat", 403},
+		{"user removing self is not org admin", "ben", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"caller in other org", "gus", "/orgs/acme/users/ben", 404},
+		{"organization does not exist", "eve", "/orgs/nope/users/ben", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserRemovesAllProjectMemberships(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ann", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+	// ann was manager of web and legacy (archived), viewer of ops: no access left.
+	for _, path := range []string{"/projects/web/tasks", "/projects/ops/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, srv, "GET", path, "ann", ""); code != 404 {
+			t.Fatalf("GET %s as removed user: got %d want 404", path, code)
+		}
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "ann", `{"title":"x"}`); code != 404 {
+		t.Fatalf("POST as removed user: got %d want 404", code)
+	}
+	// Other members keep their access.
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "ivy", `{"title":"x"}`); code != 200 {
+		t.Fatalf("ivy POST after removing ann: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat GET ops after removing ann: got %d want 200", code)
+	}
+	// Another organization is untouched.
+	if code, _ := do(t, srv, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatalf("gus GET gx: got %d want 200", code)
+	}
+}
+
+func TestRemoveOrgUserIsIdempotent(t *testing.T) {
+	srv := newServer()
+	for i := 0; i < 2; i++ {
+		if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+			t.Fatalf("attempt %d: got %d want 204", i+1, code)
+		}
+	}
+}
+
+func TestRemoveOrgUserClearsAssignments(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+	// ben was assigned t1 (web) and t5 (legacy, archived); both become unassigned.
+	for _, path := range []string{"/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		code, body := do(t, srv, "GET", path, "eve", "")
+		if code != 200 {
+			t.Fatalf("GET %s: got %d want 200", path, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.AssigneeID != "" {
+			t.Fatalf("%s still assigned to %q", path, task.AssigneeID)
+		}
+	}
+	// cat's assignment in web is untouched.
+	code, body := do(t, srv, "GET", "/projects/web/tasks/t2", "eve", "")
+	if code != 200 {
+		t.Fatalf("GET t2: got %d want 200", code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "cat" {
+		t.Fatalf("t2 assignee = %q, want cat", task.AssigneeID)
+	}
+	// ben can no longer see the projects.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks/t1", "ben", ""); code != 404 {
+		t.Fatalf("ben GET t1 after removal: got %d want 404", code)
+	}
+}
