+// RemoveFromOrg removes the user from every project of the organization,
+// including archived ones, and unassigns the user's tasks in those projects,
+// all or nothing. A user who is already removed is not an error. The user must
+// belong to the organization (else ErrNotFound); only org admins may do this.
+func (*UserTable) RemoveFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanRemoveUsers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveOrgUser(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
