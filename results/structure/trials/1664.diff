 func (a *deleteTaskAggregate) apply(ctx context.Context, tx DB) error { return a.task.destroy(ctx, tx) }
+
+// removeOrgUserAggregate removes one user from every project of one
+// organization. Tasks assigned to the user in those projects are unassigned, so
+// that no task is left assigned to a non-member.
+type removeOrgUserAggregate struct {
+	memberships []*Membership // the user's memberships in the organization's projects
+	tasks       []*Task       // tasks assigned to the user in those projects
+}
+
+func loadRemoveOrgUser(ctx context.Context, tx DB, orgID, userID string) (*removeOrgUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != orgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	ms, err := NewMembershipTable().ListByUserInOrg(ctx, tx, u.ID, orgID)
+	if err != nil {
+		return nil, err
+	}
+	a := &removeOrgUserAggregate{memberships: ms}
+	for _, m := range ms {
+		ts, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.tasks = append(a.tasks, ts...)
+	}
+	return a, nil
+}
+
+func (a *removeOrgUserAggregate) validate() error { return nil }
+
+func (a *removeOrgUserAggregate) apply(ctx context.Context, tx DB) error {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return err
+		}
+	}
+	return nil
+}
