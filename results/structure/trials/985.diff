+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"caller in other org", "gus", "/orgs/acme/users/ben", 404},
+		{"org path is other org", "eve", "/orgs/globex/users/gus", 404},
+		{"non-admin member", "ann", "/orgs/acme/users/ben", 403},
+		{"non-admin org user without roles", "hal", "/orgs/acme/users/ben", 403},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffect(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d body=%s", code, body)
+	}
+	// ben was a contributor in web (acme) and legacy (acme): both memberships gone.
+	for _, p := range []string{"/projects/web/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, srv, "GET", p, "ben", ""); code != 404 {
+			t.Fatalf("GET %s as removed user: got %d want 404", p, code)
+		}
+	}
+	// Other members of the same projects are untouched.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ann", ""); code != 200 {
+		t.Fatalf("manager lost access: got %d", code)
+	}
+	// Removing again is still 204 (nothing left to remove).
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("repeat remove: got %d want 204", code)
+	}
+}
+
+func TestRemoveOrgUserLeavesOtherOrgs(t *testing.T) {
+	srv := newServer()
+	// gus is in globex: an acme org admin must not be able to remove him, and his gx access must survive.
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/gus", "eve", ""); code != 404 {
+		t.Fatalf("cross-org remove: got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatalf("globex member lost access: got %d", code)
+	}
+}
