+// Move moves the task into another project of the actor's organization. The
+// actor must be allowed to remove the task from its project (CanManage) and to
+// create tasks in the target project (CanWrite, CanAssign for the task's
+// assignee). The target must be readable by the actor (else ErrNotFound).
+func (*TaskTable) Move(ctx context.Context, db DB, authz TaskAuthz, toProjectID string) (*Task, error) {
+	if err := authz.CanManage(); err != nil {
+		return nil, err
+	}
+	target, err := NewProjectAuthz(ctx, db, authz.Project().Actor(), toProjectID)
+	if err != nil {
+		return nil, err
+	}
+	if err := target.CanWrite(); err != nil {
+		return nil, err
+	}
+	var t *Task
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveTask(ctx, tx, authz.TaskID(), target.ProjectID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if err := target.CanAssign(agg.task.AssigneeID); err != nil {
+			return err
+		}
+		if t, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return t, nil
+}
