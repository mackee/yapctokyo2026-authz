 func (a *deleteTaskAggregate) apply(ctx context.Context, tx DB) error { return a.task.destroy(ctx, tx) }
+
+// moveMemberAggregate moves one member from the source project to the target
+// project, keeping the role. The member's tasks in the source project are
+// unassigned, so no assignee is left without a membership there.
+type moveMemberAggregate struct {
+	// the member's membership in the source project
+	from *Membership
+	user *User
+	to   *Project
+	// the member's membership in the target project, if any
+	toMembership *Membership
+	// the member's tasks in the source project
+	released []*Task
+}
+
+func loadMoveMember(ctx context.Context, tx DB, fromProjectID, userID, toProjectID string) (*moveMemberAggregate, error) {
+	from, err := NewMembershipTable().Find(ctx, tx, fromProjectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	to, err := NewProjectTable().Find(ctx, tx, toProjectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	toMembership, err := NewMembershipTable().Find(ctx, tx, toProjectID, userID)
+	if err != nil && !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	released, err := from.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &moveMemberAggregate{from: from, user: u, to: to, toMembership: toMembership, released: released}, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.toMembership != nil {
+		return deny(ErrInvalid, "user is already a member of the target project")
+	}
+	if a.user.Org != a.to.Org {
+		return deny(ErrInvalid, "member must belong to the target project's organization")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	for _, t := range a.released {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.from.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	moved := &Membership{ProjectID: a.to.ID, UserID: a.from.UserID, Role: a.from.Role}
+	if err := moved.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return moved, nil
+}
