+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager removes contributor", "ann", "/projects/web/members/ben", 204},
+		{"manager removes viewer", "ann", "/projects/web/members/dan", 204},
+		{"contributor", "ben", "/projects/web/members/cat", 403},
+		{"viewer", "dan", "/projects/web/members/ben", 403},
+		{"org admin", "eve", "/projects/web/members/ben", 403},
+		{"non member caller", "hal", "/projects/web/members/ben", 404},
+		{"other org caller", "gus", "/projects/web/members/ben", 404},
+		{"anonymous", "", "/projects/web/members/ben", 401},
+		{"unknown user", "zed", "/projects/web/members/ben", 401},
+		{"target not a member", "ann", "/projects/web/members/hal", 404},
+		{"target member of another project only", "ivy", "/projects/ops/members/ben", 404},
+		{"archived", "ann", "/projects/legacy/members/ben", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveMemberUnassignsTasks(t *testing.T) {
+	srv := newServer()
+
+	// ben is assigned t1 in web. Removing ben must unassign it.
+	if code, _ := do(t, srv, "DELETE", "/projects/web/members/ben", "ann", ""); code != 204 {
+		t.Fatalf("remove ben: got %d want 204", code)
+	}
+	code, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("get t1: got %d want 200", code)
+	}
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" {
+		t.Fatalf("t1 still assigned to %q after its assignee was removed", task.Assignee)
+	}
+
+	// ben is no longer a member, so web is no longer readable by ben.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben list web after removal: got %d want 404", code)
+	}
+
+	// Other projects are unaffected: cat's assignment in ops (t4) stays.
+	if code, _ := do(t, srv, "DELETE", "/projects/web/members/cat", "ivy", ""); code != 204 {
+		t.Fatalf("remove cat from web: got %d want 204", code)
+	}
+	code, body = do(t, srv, "GET", "/projects/ops/tasks/t4", "ann", "")
+	if code != 200 {
+		t.Fatalf("get t4: got %d want 200", code)
+	}
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "cat" {
+		t.Fatalf("t4 in ops assignee = %q, want cat", task.Assignee)
+	}
+}
