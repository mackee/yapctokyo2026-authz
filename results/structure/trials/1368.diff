+// moveTaskAggregate moves one task to another project.
+type moveTaskAggregate struct {
+	task           *Task
+	destProjectID  string
+	assigneeInDest *Membership // the assignee's membership in the destination project; nil if none
+}
+
+func loadMoveTask(ctx context.Context, tx DB, taskID, destProjectID string) (*moveTaskAggregate, error) {
+	t, err := NewTaskTable().Find(ctx, tx, taskID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveTaskAggregate{task: t, destProjectID: destProjectID}
+	if t.AssigneeID != "" {
+		m, err := NewMembershipTable().Find(ctx, tx, destProjectID, t.AssigneeID)
+		if errors.Is(err, ErrNoRows) {
+			return a, nil
+		} else if err != nil {
+			return nil, err
+		}
+		a.assigneeInDest = m
+	}
+	return a, nil
+}
+
+func (a *moveTaskAggregate) validate() error {
+	if a.task.AssigneeID != "" && (a.assigneeInDest == nil || !isWriterRole(a.assigneeInDest.Role)) {
+		return deny(ErrInvalid, "assignee must be a contributor or manager of the destination project")
+	}
+	return nil
+}
+
+func (a *moveTaskAggregate) apply(ctx context.Context, tx DB) (*Task, error) {
+	if err := a.task.moveTo(ctx, tx, a.destProjectID); err != nil {
+		return nil, err
+	}
+	return a.task, nil
+}
+
 // deleteTaskAggregate removes one task.
