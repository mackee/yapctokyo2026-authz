+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager moves unassigned", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 200},
+		{"manager moves to same project", "ann", "/projects/web/tasks/t3", `{"toProjectId":"web"}`, 200},
+		{"contributor own task", "cat", "/projects/ops/tasks/t4", `{"toProjectId":"web"}`, 200},
+		{"contributor others", "ben", "/projects/web/tasks/t2", `{"toProjectId":"legacy"}`, 403},
+		{"org admin cannot write", "eve", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"viewer source", "ann", "/projects/ops/tasks/t4", `{"toProjectId":"web"}`, 403},
+		{"viewer target", "ann", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"non member source", "hal", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 404},
+		{"other org target", "ann", "/projects/web/tasks/t1", `{"toProjectId":"gx"}`, 404},
+		{"missing target", "ann", "/projects/web/tasks/t1", `{"toProjectId":"missing"}`, 404},
+		{"cross project id", "ann", "/projects/web/tasks/t4", `{"toProjectId":"legacy"}`, 404},
+		{"archived source", "ann", "/projects/legacy/tasks/t5", `{"toProjectId":"web"}`, 409},
+		{"archived target", "ben", "/projects/web/tasks/t1", `{"toProjectId":"legacy"}`, 409},
+		{"assignee not a writer in target", "ivy", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 400},
+		{"missing target field", "ann", "/projects/web/tasks/t1", `{}`, 400},
+		{"empty target", "ann", "/projects/web/tasks/t1", `{"toProjectId":""}`, 400},
+		{"anonymous", "", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsFields(t *testing.T) {
+	srv := newServer()
+	code, body := do(t, srv, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d body %s", code, body)
+	}
+	var moved Task
+	if err := json.Unmarshal([]byte(body), &moved); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", AssigneeID: "cat"}
+	if moved != want {
+		t.Fatalf("moved task = %+v, want %+v", moved, want)
+	}
+
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks/t2", "ivy", ""); code != 200 {
+		t.Fatalf("GET in destination: got %d", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks/t2", "ivy", ""); code != 404 {
+		t.Fatalf("GET in source: got %d want 404", code)
+	}
+	code, body = do(t, srv, "GET", "/projects/web/tasks", "ann", "")
+	if code != 200 {
+		t.Fatal(code)
+	}
+	var tasks []Task
+	json.Unmarshal([]byte(body), &tasks)
+	if len(tasks) != 2 {
+		t.Fatalf("web should have 2 tasks after the move, got %d", len(tasks))
+	}
+}
