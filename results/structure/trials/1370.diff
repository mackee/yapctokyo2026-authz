+// CanMove returns nil if the actor may move the task out of its project into
+// dest (the destination's ProjectAuthz, built by NewProjectAuthz): managers of
+// the source only (else ErrForbidden), the source not archived (ErrArchived),
+// the destination writable by the actor (ErrForbidden) and not archived
+// (ErrArchived). The caller checks that dest is a different project.
+func (a TaskAuthz) CanMove(dest ProjectAuthz) error {
+	if !a.CanRead() || a.project.role != RoleManager {
+		return deny(ErrForbidden, "only managers may move tasks")
+	}
+	if a.project.archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	return dest.CanWrite()
+}
