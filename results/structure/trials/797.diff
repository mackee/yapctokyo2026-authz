+// setRolesAggregate changes the roles of several members of one project.
+type setRolesAggregate struct {
+	project  *Project
+	members  []*Membership     // the members named in roles, in user ID order
+	roles    map[string]string // user ID -> new role
+	assigned map[string]int    // user ID -> number of tasks assigned in the project
+}
+
+func loadSetRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*setRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &setRolesAggregate{project: p, roles: roles, assigned: map[string]int{}}
+	all, err := p.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	byUser := map[string]*Membership{}
+	for _, m := range all {
+		byUser[m.UserID] = m
+	}
+	for _, m := range all { // ordered by user ID
+		if _, ok := roles[m.UserID]; !ok {
+			continue
+		}
+		a.members = append(a.members, m)
+		tasks, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.assigned[m.UserID] = len(tasks)
+	}
+	for id := range roles {
+		if byUser[id] == nil {
+			return nil, deny(ErrInvalid, "not a member of the project: "+id)
+		}
+	}
+	return a, nil
+}
+
+func (a *setRolesAggregate) validate() error {
+	for _, m := range a.members {
+		role := a.roles[m.UserID]
+		if !validRoles[role] {
+			return deny(ErrInvalid, "invalid role")
+		}
+		if !isWriterRole(role) && a.assigned[m.UserID] > 0 {
+			return deny(ErrInvalid, "assignee must be a contributor or manager of the project: "+m.UserID+" still has assigned tasks")
+		}
+	}
+	return nil
+}
+
+func (a *setRolesAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for _, m := range a.members {
+		if err := m.changeRole(ctx, tx, a.roles[m.UserID]); err != nil {
+			return nil, err
+		}
+	}
+	return a.project.Memberships(ctx, tx)
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
