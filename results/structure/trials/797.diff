@@ -0,0 +1,54 @@
+package main
+
+import "testing"
+
+func TestSetMemberRoles(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager promotes and demotes", "ann", "web", `{"roles":{"dan":"contributor","ivy":"viewer"}}`, 200},
+		{"manager demotes self", "ann", "web", `{"roles":{"ann":"viewer"}}`, 200},
+		{"contributor forbidden", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer forbidden", "dan", "web", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin forbidden", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member not found", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"manager"}}`, 409},
+		{"unknown role", "ann", "web", `{"roles":{"dan":"boss"}}`, 400},
+		{"non member target", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"demote assignee to viewer", "ann", "web", `{"roles":{"ben":"viewer"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestSetMemberRolesResult(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","ivy":"viewer"}}`)
+	want := `[{"userId":"ann","role":"manager"},{"userId":"ben","role":"contributor"},{"userId":"cat","role":"contributor"},{"userId":"dan","role":"contributor"},{"userId":"ivy","role":"viewer"}]` + "\n"
+	if code != 200 || body != want {
+		t.Fatalf("got %d %s", code, body)
+	}
+}
+
+func TestSetMemberRolesAllOrNothing(t *testing.T) {
+	h := newServer()
+	// dan's promotion is valid, ben's demotion is not (ben has assigned tasks).
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"manager","ben":"viewer"}}`)
+	if code != 400 {
+		t.Fatalf("got %d %s", code, body)
+	}
+	// dan must still be a viewer: dan cannot create tasks.
+	if code, body := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 403 {
+		t.Fatalf("dan was changed: %d %s", code, body)
+	}
+}
