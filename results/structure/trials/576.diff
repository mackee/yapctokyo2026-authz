+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager removes", "ann", "/projects/web/members/dan", 204},
+		{"manager removes self", "ann", "/projects/web/members/ann", 204},
+		{"contributor", "ben", "/projects/web/members/dan", 403},
+		{"viewer", "dan", "/projects/web/members/dan", 403},
+		{"org admin", "eve", "/projects/web/members/dan", 403},
+		{"non member caller", "hal", "/projects/web/members/dan", 404},
+		{"other org caller", "gus", "/projects/web/members/dan", 404},
+		{"anonymous", "", "/projects/web/members/dan", 401},
+		{"target not a member", "ann", "/projects/web/members/hal", 404},
+		{"target unknown", "ann", "/projects/web/members/zed", 404},
+		{"archived", "ann", "/projects/legacy/members/ben", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveMemberEffects(t *testing.T) {
+	h := newServer()
+	// ben is assigned t1 in web.
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 204 {
+		t.Fatal(code)
+	}
+	// ben lost access to web.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("removed member still reads: %d", code)
+	}
+	// ben's membership elsewhere is untouched.
+	if code, _ := do(t, h, "GET", "/projects/legacy/tasks", "ben", ""); code != 200 {
+		t.Fatalf("other project affected: %d", code)
+	}
+	// ben's tasks in web are unassigned, not left dangling.
+	_, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "" {
+		t.Fatalf("task still assigned to %q", task.AssigneeID)
+	}
+	// removing again is 404.
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 404 {
+		t.Fatalf("second removal: %d", code)
+	}
+}
