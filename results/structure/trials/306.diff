+// ---- organization and user capabilities ----------------------------------------
+
+// UserView is the public representation of a user's organization membership.
+type UserView struct {
+	ID    string `json:"id"`
+	OrgID string `json:"orgId"`
+}
+
+// OrgScope is bound to one actor and one organization ID.
+type OrgScope interface {
+	ID() string
+	User(userID string) UserScope
+}
+
+// UserScope is bound to one actor, one organization ID and one user ID.
+type UserScope interface {
+	Manage() (ManageUser, error)
+}
+
+// ManageUser is the organization-admin capability for one user.
+type ManageUser interface {
+	// Transfer moves the user to another organization. The user must hold no
+	// project roles (they must be removed first), and the user loses org admin
+	// rights, which are per organization. See the README for the access rule.
+	Transfer(toOrgID string) (UserView, error)
+}
+
+type orgScope struct {
+	as  *actorScope
+	oid string
+}
+
+func (s *orgScope) ID() string { return s.oid }
+func (s *orgScope) User(userID string) UserScope {
+	return &userScope{os: s, uid: userID}
+}
+
+type userScope struct {
+	os  *orgScope
+	uid string
+}
+
+// Manage applies the admin rule. The path organization must be the actor's own
+// (else 404), the user must belong to it (else 404), and the actor must be an
+// org admin (else 403).
+func (s *userScope) Manage() (ManageUser, error) {
+	err := s.os.as.a.st.read(func(st *state) error {
+		act := s.os.as.actor
+		if s.os.oid != act.org {
+			return deny(ErrNotFound, "not found")
+		}
+		if u, ok := st.users[s.uid]; !ok || u.org != s.os.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		if !act.orgAdmin {
+			return deny(ErrForbidden, "forbidden")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &manageUser{us: s}, nil
+}
+
+type manageUser struct{ us *userScope }
+
+func (m *manageUser) Transfer(toOrgID string) (UserView, error) {
+	var v UserView
+	err := m.us.os.as.a.st.tx(func(s *state) error {
+		u, ok := s.users[m.us.uid]
+		if !ok || u.org != m.us.os.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		if toOrgID == u.org {
+			return deny(ErrInvalid, "user is already in that organization")
+		}
+		if !s.orgs[toOrgID] {
+			return deny(ErrInvalid, "unknown organization")
+		}
+		for pid, members := range s.members {
+			if _, ok := members[u.id]; ok {
+				return deny(ErrInvalid, "user still holds a role in project "+pid+"; remove it before transferring")
+			}
+		}
+		u.org = toOrgID
+		u.orgAdmin = false
+		s.users[u.id] = u
+		v = UserView{ID: u.id, OrgID: u.org}
+		return nil
+	})
+	return v, err
+}
