+func TestTransfer(t *testing.T) {
+	const path = "/orgs/acme/users/hal/transfer"
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin", "eve", path, `{"toOrgId":"globex"}`, 200},
+		{"user with project roles", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 400},
+		{"manager is not org admin", "ann", path, `{"toOrgId":"globex"}`, 403},
+		{"contributor is not org admin", "ben", path, `{"toOrgId":"globex"}`, 403},
+		{"actor in other org", "gus", path, `{"toOrgId":"globex"}`, 404},
+		{"user in other org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"unknown target org", "eve", path, `{"toOrgId":"initech"}`, 400},
+		{"same org", "eve", path, `{"toOrgId":"acme"}`, 400},
+		{"missing toOrgId", "eve", path, `{}`, 400},
+		{"malformed body", "eve", path, `{"toOrgId":`, 400},
+		{"anonymous", "", path, `{"toOrgId":"globex"}`, 401},
+		{"unknown actor", "zed", path, `{"toOrgId":"globex"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferEffects(t *testing.T) {
+	h := newServer()
+
+	// Before: eve is an acme org admin and can read acme's ops project.
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "eve", ""); code != 200 {
+		t.Fatalf("before transfer: got %d want 200", code)
+	}
+
+	code, body := do(t, h, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("transfer: got %d want 200: %s", code, body)
+	}
+	var got capability.UserView
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got != (capability.UserView{ID: "eve", OrgID: "globex"}) {
+		t.Fatalf("response: got %+v", got)
+	}
+
+	// After: eve has left acme, so acme's projects are invisible to her.
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "eve", ""); code != 404 {
+		t.Fatalf("after transfer, old org project: got %d want 404", code)
+	}
+	// Org admin rights do not carry over to the new organization.
+	if code, _ := do(t, h, "POST", "/orgs/globex/users/eve/transfer", "eve", `{"toOrgId":"acme"}`); code != 403 {
+		t.Fatalf("admin right after transfer: got %d want 403", code)
+	}
+	// The user is no longer in acme, so acme admins cannot reach them there.
+	if code, _ := do(t, h, "POST", "/orgs/acme/users/eve/transfer", "ann", `{"toOrgId":"globex"}`); code != 404 {
+		t.Fatalf("old org path: got %d want 404", code)
+	}
+}
+
+func TestTransferRejectedLeavesStateUnchanged(t *testing.T) {
+	h := newServer()
+
+	if code, body := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 400 {
+		t.Fatalf("got %d want 400: %s", code, body)
+	}
+	// ben is still an acme contributor with access to web.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben after rejected transfer: got %d want 200", code)
+	}
+}
