+// CanMove returns nil if the actor may move the task to the project dest:
+// contributor or manager in both projects (else ErrForbidden); contributors
+// (in either project) only tasks assigned to themselves, managers in both
+// projects any task (else ErrForbidden); neither project archived (else
+// ErrArchived).
+func (a TaskAuthz) CanMove(dest ProjectAuthz) error {
+	if !a.CanRead() || !dest.CanRead() || !isWriterRole(a.project.role) || !isWriterRole(dest.role) {
+		return deny(ErrForbidden, "forbidden")
+	}
+	if !(a.project.role == RoleManager && dest.role == RoleManager) && !a.isAssignee {
+		return deny(ErrForbidden, "only managers of both projects may move tasks assigned to others")
+	}
+	if a.project.archived || dest.archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	return nil
+}
