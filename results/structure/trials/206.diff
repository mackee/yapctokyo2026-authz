+type memberRoleRequest struct {
+	Role string `json:"role"`
+}
+
+var validRoles = map[string]bool{RoleManager: true, RoleContributor: true, RoleViewer: true}
+
+func (s *server) updateMemberRole(w http.ResponseWriter, r *http.Request) {
+	s.store.mu.Lock()
+	defer s.store.mu.Unlock()
+
+	user := s.store.User(r.Header.Get("X-User"))
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project := s.store.Project(r.PathValue("pid"))
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role := s.store.Role(project.ID, user.ID)
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "only managers may change member roles")
+		return
+	}
+	uid := r.PathValue("uid")
+	targetRole := s.store.Role(project.ID, uid)
+	if targetRole == "" {
+		writeError(w, 404, "not found")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req memberRoleRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || !validRoles[req.Role] {
+		writeError(w, 400, "invalid role")
+		return
+	}
+	if targetRole == RoleManager && req.Role != RoleManager && s.store.CountManagers(project.ID) <= 1 {
+		writeError(w, 409, "project must keep at least one manager")
+		return
+	}
+	s.store.SetRole(project.ID, uid, req.Role)
+	writeJSON(w, 200, map[string]string{"userId": uid, "role": req.Role})
+}
+
 func writeJSON(w http.ResponseWriter, code int, v any) {
 	w.Header().Set("Content-Type", "application/json")
 	w.WriteHeader(code)
