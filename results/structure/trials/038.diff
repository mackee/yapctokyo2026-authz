+// RemoveUserFromOrg drops userID's membership in every project of orgID,
+// archived projects included. The user record itself is kept.
+func (s *Store) RemoveUserFromOrg(orgID, userID string) {
+	for pid, p := range s.projects {
+		if p.OrgID == orgID {
+			delete(s.members[pid], userID)
+		}
+	}
+}
