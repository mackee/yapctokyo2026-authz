+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes non member", "eve", "/orgs/acme/users/hal", 204},
+		{"manager is not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"viewer", "dan", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"caller in other org", "gus", "/orgs/acme/users/ben", 404},
+		{"org in path is not caller's", "eve", "/orgs/globex/users/gus", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ben", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserRevokesAccess(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ann", "eve", ""); code != 204 {
+		t.Fatalf("remove ann: got %d want 204", code)
+	}
+
+	// ann was manager of web and legacy (archived), viewer of ops: all gone.
+	for _, path := range []string{"/projects/web/tasks", "/projects/legacy/tasks", "/projects/ops/tasks"} {
+		if code, _ := do(t, h, "GET", path, "ann", ""); code != 404 {
+			t.Fatalf("ann GET %s: got %d want 404", path, code)
+		}
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ann", `{"status":"done"}`); code != 404 {
+		t.Fatalf("ann PATCH: got %d want 404", code)
+	}
+
+	// Other members and other projects are untouched.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ivy", ""); code != 200 {
+		t.Fatalf("ivy GET web: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t2", "ivy", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ivy PATCH web: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatalf("gus GET gx: got %d want 200", code)
+	}
+
+	// Removing ann again is a no-op 204.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ann", "eve", ""); code != 204 {
+		t.Fatalf("second remove: got %d want 204", code)
+	}
+}
