+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func memberRoles(t *testing.T, body string) map[string]string {
+	t.Helper()
+	var ms []memberResponse
+	if err := json.Unmarshal([]byte(body), &ms); err != nil {
+		t.Fatal(err, body)
+	}
+	m := map[string]string{}
+	for _, x := range ms {
+		m[x.UserID] = x.Role
+	}
+	return m
+}
+
+func TestUpdateMembers(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager ok", "ann", "/projects/web/members", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 200},
+		{"promote", "ann", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 200},
+		{"contributor forbidden", "ben", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 403},
+		{"viewer forbidden", "dan", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin forbidden", "eve", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 403},
+		{"manager of other project", "ann", "/projects/ops/members", `{"roles":{"cat":"viewer"}}`, 403},
+		{"non member", "hal", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 404},
+		{"other org", "gus", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 404},
+		{"anonymous", "", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 401},
+		{"archived", "ann", "/projects/legacy/members", `{"roles":{"ben":"viewer"}}`, 409},
+		{"invalid role", "ann", "/projects/web/members", `{"roles":{"ben":"admin"}}`, 400},
+		{"non member target", "ann", "/projects/web/members", `{"roles":{"hal":"viewer"}}`, 400},
+		{"empty", "ann", "/projects/web/members", `{"roles":{}}`, 400},
+		{"bad json", "ann", "/projects/web/members", `nope`, 400},
+		{"last manager demoted", "ann", "/projects/ops/members", `{"roles":{"ivy":"viewer"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			user := c.user
+			if c.name == "last manager demoted" {
+				user = "ivy"
+			}
+			if c.name == "manager of other project" {
+				user = "ann" // viewer in ops
+			}
+			code, _ := do(t, newServer(), "PUT", c.path, user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMembersResult(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	got := memberRoles(t, body)
+	want := map[string]string{"ann": "manager", "ben": "viewer", "cat": "contributor", "dan": "contributor", "ivy": "manager"}
+	if len(got) != len(want) {
+		t.Fatalf("got %v", got)
+	}
+	for k, v := range want {
+		if got[k] != v {
+			t.Fatalf("got %v want %v", got, want)
+		}
+	}
+	// New roles take effect.
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 403 {
+		t.Fatalf("demoted ben should be read-only, got %d", code)
+	}
+}
+
+func TestUpdateMembersAtomic(t *testing.T) {
+	h := newServer()
+	code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","hal":"viewer"}}`)
+	if code != 400 {
+		t.Fatal(code)
+	}
+	code, _ = do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`)
+	if code != 200 {
+		t.Fatalf("ben must be unchanged, got %d", code)
+	}
+}
