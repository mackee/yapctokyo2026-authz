+// ManageProject may remove members from one project. Managers only.
+type ManageProject interface {
+	// RemoveMember removes the user from the project. Tasks the user held in
+	// the project are unassigned in the same change. A user who is not a member
+	// of the project is 404.
+	RemoveMember(userID string) error
+}
+
+type manageProject struct{ ps *projectScope }
+
+func (p *manageProject) RemoveMember(userID string) error {
+	return p.ps.as.a.db.update(func(x *tx) error {
+		agg, err := loadRemoveMember(x, p.ps.pid, userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		agg.apply(x)
+		return nil
+	})
+}
