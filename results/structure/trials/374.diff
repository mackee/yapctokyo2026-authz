+// removeMemberAggregate removes one member from one project. The member's tasks
+// in that project are unassigned in the same change, so no task is left assigned
+// to a non-member.
+type removeMemberAggregate struct {
+	member membershipRecord
+	tasks  []taskRecord // the member's tasks in the project
+}
+
+func loadRemoveMember(x *tx, projectID, userID string) (*removeMemberAggregate, error) {
+	m, ok := x.findMembership(projectID, userID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	return &removeMemberAggregate{member: m, tasks: m.AssignedTasks(x)}, nil
+}
+
+func (a *removeMemberAggregate) validate() error { return nil }
+
+func (a *removeMemberAggregate) apply(x *tx) {
+	for _, t := range a.tasks {
+		t.Unassign(x)
+	}
+	a.member.Destroy(x)
+}
