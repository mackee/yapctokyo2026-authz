+// updateMemberRoleAggregate changes the role of one project member.
+type updateMemberRoleAggregate struct {
+	member *Membership
+	role   string
+}
+
+func loadUpdateMemberRole(ctx context.Context, tx DB, projectID string, in MembershipTableUpdateRoleInput) (*updateMemberRoleAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, projectID, in.UserID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	return &updateMemberRoleAggregate{member: m, role: in.Role}, nil
+}
+
+func (a *updateMemberRoleAggregate) validate() error {
+	if !isProjectRole(a.role) {
+		return deny(ErrInvalid, "role must be manager, contributor or viewer")
+	}
+	return nil
+}
+
+func (a *updateMemberRoleAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.member.setRole(ctx, tx, a.role); err != nil {
+		return nil, err
+	}
+	return a.member, nil
+}
+
