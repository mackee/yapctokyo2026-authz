+func TestRemoveOrgUserAuth(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben", 204},
+		{"member without roles", "eve", "/orgs/acme/users/hal", 204},
+		{"manager not admin", "ann", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"other org admin path", "eve", "/orgs/globex/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: %d", code)
+	}
+	// ben lost access to every project, including the archived one.
+	for _, p := range []string{"web", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ben", ""); code != 404 {
+			t.Fatalf("ben still reads %s: %d", p, code)
+		}
+	}
+	// His tasks are unassigned; other tasks are untouched.
+	for tid, want := range map[string]string{"t1": "", "t2": "cat"} {
+		code, body := do(t, h, "GET", "/projects/web/tasks/"+tid, "ann", "")
+		if code != 200 {
+			t.Fatal(code)
+		}
+		var task Task
+		json.Unmarshal([]byte(body), &task)
+		if task.Assignee != want {
+			t.Fatalf("%s assignee %q want %q", tid, task.Assignee, want)
+		}
+	}
+	// Other members keep their access.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat lost access: %d", code)
+	}
+	// ben can no longer be assigned.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ann", `{"title":"x","assignee":"ben"}`); code != 400 {
+		t.Fatalf("assign removed user: %d", code)
+	}
+}
