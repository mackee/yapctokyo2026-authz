@@ -111,6 +111,64 @@ func (a *Authorizer) Authenticate(userID string) (ActorScope, error) {
 type ActorScope interface {
 	Actor() Actor
 	Project(projectID string) ProjectScope
+	Org(orgID string) OrgScope
+}
+
+// OrgScope is bound to one actor and one organization ID. It grants nothing by
+// itself; call Manage to acquire a capability.
+type OrgScope interface {
+	Manage() (ManageOrg, error)
+}
+
+// ManageOrg is the org-admin capability for one organization.
+type ManageOrg interface {
+	// RemoveUser removes a user from every project of the organization (the
+	// offboarding operation). Tasks assigned to the user in those projects
+	// become unassigned. The user must belong to the organization (else 404).
+	// Archived projects are included: membership is not task data.
+	RemoveUser(userID string) error
+}
+
+type orgScope struct {
+	as  *actorScope
+	oid string
+}
+
+// Manage applies the org rule: the organization is the actor's own (else 404)
+// and the actor is an org admin (else 403).
+func (s *orgScope) Manage() (ManageOrg, error) {
+	act := s.as.actor
+	if s.oid != act.org {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if !act.orgAdmin {
+		return nil, deny(ErrForbidden, "forbidden")
+	}
+	return &manageOrg{os: s}, nil
+}
+
+type manageOrg struct{ os *orgScope }
+
+func (o *manageOrg) RemoveUser(userID string) error {
+	return o.os.as.a.st.tx(func(s *state) error {
+		u, ok := s.users[userID]
+		if !ok || u.org != o.os.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		for pid, m := range s.members {
+			if s.projects[pid].org != o.os.oid {
+				continue
+			}
+			delete(m, userID)
+		}
+		for id, t := range s.tasks {
+			if t.assignee.user == userID && s.projects[t.project].org == o.os.oid {
+				t.assignee = Assignee{project: t.project}
+				s.tasks[id] = t
+			}
+		}
+		return nil
+	})
 }
 
