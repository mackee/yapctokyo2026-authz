+// updateRolesAggregate changes the roles of several members of one project.
+// Every target must be a member of the project before any role changes.
+type updateRolesAggregate struct {
+	project *Project
+	roles   map[string]string // user ID -> new role
+	members []*Membership     // one per entry of roles, in user ID order
+}
+
+func loadUpdateRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*updateRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if err != nil {
+		return nil, err
+	}
+	a := &updateRolesAggregate{project: p, roles: roles}
+	for _, userID := range slices.Sorted(maps.Keys(roles)) {
+		m, err := p.Membership(ctx, tx, userID)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "roles can only be changed for members of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		u, err := m.User(ctx, tx)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "roles can only be changed for members of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		if u.Org != p.Org {
+			return nil, deny(ErrInvalid, "project members belong to the project's organization")
+		}
+		a.members = append(a.members, m)
+	}
+	return a, nil
+}
+
+func (a *updateRolesAggregate) validate() error {
+	for _, role := range a.roles {
+		if !isProjectRole(role) {
+			return deny(ErrInvalid, "role must be manager, contributor or viewer")
+		}
+	}
+	return nil
+}
+
+func (a *updateRolesAggregate) apply(ctx context.Context, tx DB) error {
+	for _, m := range a.members {
+		if err := m.setRole(ctx, tx, a.roles[m.UserID]); err != nil {
+			return err
+		}
+	}
+	return nil
+}
