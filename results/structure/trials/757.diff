+
+func TestUpdateMembersResultAndAtomicity(t *testing.T) {
+	h := newServer()
+
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got []Member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []Member{
+		{UserID: "ann", Role: "manager"},
+		{UserID: "ben", Role: "viewer"},
+		{UserID: "cat", Role: "contributor"},
+		{UserID: "dan", Role: "contributor"},
+		{UserID: "ivy", Role: "manager"},
+	}
+	if !slices.Equal(got, want) {
+		t.Fatalf("members after change:\n got %+v\nwant %+v", got, want)
+	}
+
+	// The change is in effect: dan (now a contributor) may write, ben (now a viewer) may not.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("promoted dan create: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Fatalf("demoted ben create: got %d want 403", code)
+	}
+
+	// One target that is not a member fails the whole batch and changes nothing.
+	if code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"cat":"viewer","hal":"viewer"}}`); code != 400 {
+		t.Fatalf("batch with non-member: got %d want 400", code)
+	}
+	code, body = do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ivy":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want[4].Role = "contributor" // ivy, the only change in this call
+	if !slices.Equal(got, want) {
+		t.Fatalf("after failed batch:\n got %+v\nwant %+v", got, want)
+	}
+}
