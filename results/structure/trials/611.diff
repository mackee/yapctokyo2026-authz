+type memberRolesRequest struct {
+	Roles map[string]string `json:"roles"`
+}
+
+type member struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// updateMemberRoles changes the roles of several project members in one
+// transaction and returns the project's member list after the change.
+// Either every change applies or none does.
+func (s *server) updateMemberRoles(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role, err := findRole(ctx, s.db, project.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "only managers may change member roles")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req memberRolesRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || len(req.Roles) == 0 {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	userIDs := make([]string, 0, len(req.Roles))
+	for uid := range req.Roles {
+		userIDs = append(userIDs, uid)
+	}
+	sort.Strings(userIDs)
+	for _, uid := range userIDs {
+		if !validRoles[req.Roles[uid]] {
+			writeError(w, 400, fmt.Sprintf("invalid role %q for %s", req.Roles[uid], uid))
+			return
+		}
+	}
+
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+	for _, uid := range userIDs {
+		var current string
+		err := tx.QueryRowContext(ctx, `SELECT role FROM memberships WHERE project_id = ? AND user_id = ?`, project.ID, uid).Scan(&current)
+		if errors.Is(err, sql.ErrNoRows) {
+			writeError(w, 400, fmt.Sprintf("%s is not a member of the project", uid))
+			return
+		}
+		if err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+		if _, err := tx.ExecContext(ctx, `UPDATE memberships SET role = ? WHERE project_id = ? AND user_id = ?`,
+			req.Roles[uid], project.ID, uid); err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+	}
+	// An assignee must remain a contributor or manager of the project.
+	var taskID, assignee string
+	err = tx.QueryRowContext(ctx, `SELECT t.id, t.assignee FROM tasks t
+		WHERE t.project_id = ? AND t.assignee <> ''
+		AND NOT EXISTS (SELECT 1 FROM memberships m
+			WHERE m.project_id = t.project_id AND m.user_id = t.assignee AND m.role IN (?, ?))
+		ORDER BY t.id LIMIT 1`, project.ID, RoleManager, RoleContributor).Scan(&taskID, &assignee)
+	if err == nil {
+		writeError(w, 400, fmt.Sprintf("%s is assigned to task %s and must remain a contributor or manager", assignee, taskID))
+		return
+	}
+	if !errors.Is(err, sql.ErrNoRows) {
+		writeError(w, 500, "internal error")
+		return
+	}
+
+	rows, err := tx.QueryContext(ctx, `SELECT user_id, role FROM memberships WHERE project_id = ? ORDER BY user_id`, project.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	members := []member{}
+	for rows.Next() {
+		var m member
+		if err := rows.Scan(&m.UserID, &m.Role); err != nil {
+			rows.Close()
+			writeError(w, 500, "internal error")
+			return
+		}
+		members = append(members, m)
+	}
+	rows.Close()
+	if err := rows.Err(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, members)
+}
