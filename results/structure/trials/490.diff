+func TestUpdateMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager changes contributor", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"manager demotes manager without tasks", "ann", "/projects/web/members/ivy", `{"role":"viewer"}`, 200},
+		{"manager promotes", "ann", "/projects/web/members/dan", `{"role":"manager"}`, 200},
+		{"manager demotes member with tasks", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 400},
+		{"contributor", "ben", "/projects/web/members/cat", `{"role":"manager"}`, 403},
+		{"viewer", "dan", "/projects/web/members/ben", `{"role":"manager"}`, 403},
+		{"org admin", "eve", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"non member", "hal", "/projects/web/members/dan", `{"role":"contributor"}`, 404},
+		{"other org", "gus", "/projects/web/members/dan", `{"role":"contributor"}`, 404},
+		{"anonymous", "", "/projects/web/members/dan", `{"role":"contributor"}`, 401},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"contributor"}`, 404},
+		{"unknown target", "ann", "/projects/web/members/zed", `{"role":"contributor"}`, 404},
+		{"target member of other project", "ivy", "/projects/ops/members/ben", `{"role":"contributor"}`, 404},
+		{"viewer of project", "ann", "/projects/ops/members/cat", `{"role":"viewer"}`, 403},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"invalid role", "ann", "/projects/web/members/dan", `{"role":"owner"}`, 400},
+		{"missing role", "ann", "/projects/web/members/dan", `{}`, 400},
+		{"malformed body", "ann", "/projects/web/members/dan", `{"role":`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRoleResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members/ivy", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+	var got struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.UserID != "ivy" || got.Role != "contributor" {
+		t.Fatalf("got %+v", got)
+	}
+}
+
+func TestUpdateMemberRoleTakesEffect(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`); code != 200 {
+		t.Fatalf("promote: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("contributor create: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "PUT", "/projects/web/members/dan", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 403 {
+		t.Fatalf("viewer create: got %d want 403", code)
+	}
+}
+
+func TestUpdateMemberRoleRejectedChangesNothing(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 400 {
+		t.Fatalf("demote with tasks: got %d want 400", code)
+	}
+	// ben is still a contributor, and still assigned t1.
+	if code, _ := do(t, srv, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 200 {
+		t.Fatalf("contributor patch after rejected demotion: got %d want 200", code)
+	}
+}
