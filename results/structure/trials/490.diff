+// updateMemberRoleAggregate changes one member's role in one project.
+type updateMemberRoleAggregate struct {
+	membership *Membership
+	role       string
+	assigned   []*Task // the member's tasks in the project
+}
+
+func loadUpdateMemberRole(ctx context.Context, tx DB, projectID, userID, role string) (*updateMemberRoleAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	assigned, err := m.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &updateMemberRoleAggregate{membership: m, role: role, assigned: assigned}, nil
+}
+
+func (a *updateMemberRoleAggregate) validate() error {
+	// An assignee must be a contributor or manager, so a member with tasks in
+	// the project cannot become a viewer until those tasks are reassigned.
+	if !isWriterRole(a.role) && len(a.assigned) > 0 {
+		return deny(ErrInvalid, "member has tasks assigned in the project; reassign them before making them a viewer")
+	}
+	return nil
+}
+
+func (a *updateMemberRoleAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.membership.setRole(ctx, tx, a.role); err != nil {
+		return nil, err
+	}
+	return a.membership, nil
+}
+
