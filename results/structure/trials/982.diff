+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin, user with no memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"manager is not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"viewer is not org admin", "dan", "/orgs/acme/users/ben", 403},
+		{"caller from other org", "gus", "/orgs/acme/users/ben", 404},
+		{"org path not the caller's org", "eve", "/orgs/globex/users/gus", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	// ben was a contributor of web and legacy (both acme): no longer a member.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("web: got %d want 404", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/legacy/tasks", "ben", ""); code != 404 {
+		t.Fatalf("legacy: got %d want 404", code)
+	}
+	// Other members are untouched.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat web: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat ops: got %d want 200", code)
+	}
+	// Repeating the call is still 204.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("repeat: got %d want 204", code)
+	}
+}
