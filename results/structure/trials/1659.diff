+
+// deleteMembershipAggregate removes one user from one project. The user's
+// tasks in the project are unassigned, so the assignee rule still holds.
+type deleteMembershipAggregate struct {
+	membership *Membership
+	tasks      []*Task // the project's tasks assigned to the member
+}
+
+func loadDeleteMembership(ctx context.Context, tx DB, projectID, userID string) (*deleteMembershipAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	tasks, err := m.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &deleteMembershipAggregate{membership: m, tasks: tasks}, nil
+}
+
+func (a *deleteMembershipAggregate) validate() error { return nil }
+
+func (a *deleteMembershipAggregate) apply(ctx context.Context, tx DB) error {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return err
+		}
+	}
+	return a.membership.destroy(ctx, tx)
+}
