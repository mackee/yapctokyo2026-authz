@@ -0,0 +1,98 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestTransferUser(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin moves user", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 200},
+		{"org member", "ann", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 403},
+		{"anonymous", "", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 401},
+		{"caller in other org", "gus", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 404},
+		{"org is not the caller's", "eve", "/orgs/globex/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"user of another org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"unknown target org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"initech"}`, 400},
+		{"same org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"acme"}`, 400},
+		{"missing target org", "eve", "/orgs/acme/users/ben/transfer", `{}`, 400},
+		{"empty target org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":""}`, 400},
+		{"malformed body", "eve", "/orgs/acme/users/ben/transfer", `{`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got struct {
+		ID    string `json:"id"`
+		OrgID string `json:"orgId"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.ID != "ben" || got.OrgID != "globex" {
+		t.Fatalf("got %+v", got)
+	}
+}
+
+// A transferred user keeps no access to the old organization: its memberships
+// there are gone and its tasks there are unassigned.
+func TestTransferLeavesOldOrg(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: got %d: %s", code, body)
+	}
+
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads old org project: got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/legacy/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads old org project: got %d want 404", code)
+	}
+
+	for _, path := range []string{"/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		code, body := do(t, srv, "GET", path, "ann", "")
+		if code != 200 {
+			t.Fatalf("%s: got %d", path, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.AssigneeID != "" {
+			t.Fatalf("%s still assigned to %q", path, task.AssigneeID)
+		}
+	}
+}
+
+// The transferred user keeps its tasks and memberships in its new organization.
+func TestTransferKeepsUserInNewOrg(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: got %d: %s", code, body)
+	}
+	// ben is now in globex; a globex project it is not a member of stays unreadable.
+	if code, _ := do(t, srv, "GET", "/projects/gx/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads gx without membership: got %d want 404", code)
+	}
+	// ben is no longer in acme, so acme is not an organization it can manage.
+	if code, _ := do(t, srv, "POST", "/orgs/acme/users/cat/transfer", "ben", `{"toOrgId":"globex"}`); code != 404 {
+		t.Fatalf("ben transfers from acme: got %d want 404", code)
+	}
+}
