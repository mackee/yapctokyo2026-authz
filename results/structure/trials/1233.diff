+// transferUserAggregate moves one user from its organization to another. The
+// memberships and assignments in the old organization's projects go with it,
+// so the rules above keep holding for the projects the user leaves.
+type transferUserAggregate struct {
+	user        *User
+	toOrg       string
+	memberships []*Membership // the user's memberships in projects of the old organization
+	tasks       []*Task       // the user's tasks in projects of the old organization
+}
+
+func loadTransferUser(ctx context.Context, tx DB, fromOrg string, in UserTableTransferInput) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, in.UserID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != fromOrg {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if in.ToOrgID == fromOrg {
+		return nil, deny(ErrInvalid, "user is already in that organization")
+	}
+	exists, err := NewUserTable().OrgExists(ctx, tx, in.ToOrgID)
+	if err != nil {
+		return nil, err
+	}
+	if !exists {
+		return nil, deny(ErrInvalid, "unknown organization")
+	}
+	a := &transferUserAggregate{user: u, toOrg: in.ToOrgID}
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, m := range ms {
+		p, err := m.Project(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		if p.Org == fromOrg {
+			a.memberships = append(a.memberships, m)
+		}
+	}
+	ts, err := u.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, t := range ts {
+		p, err := t.Project(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		if p.Org == fromOrg {
+			a.tasks = append(a.tasks, t)
+		}
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error { return nil }
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.remove(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	// An org admin of the old organization is not one of the new organization.
+	a.user.Org = a.toOrg
+	a.user.OrgAdmin = false
+	if err := a.user.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
+
