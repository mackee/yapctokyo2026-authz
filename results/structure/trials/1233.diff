@@ -0,0 +1,93 @@
+package model
+
+import (
+	"context"
+	"errors"
+	"testing"
+)
+
+func actorOf(t *testing.T, db DB, userID string) Actor {
+	t.Helper()
+	act, err := Authenticate(context.Background(), db, userID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return act
+}
+
+// The transferred org admin loses the admin flag: it is an admin of its old
+// organization only.
+func TestTransferClearsOrgAdmin(t *testing.T) {
+	ctx := context.Background()
+	db, err := Open()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+
+	authz, err := NewOrgAuthz(actorOf(t, db, "eve"), "acme")
+	if err != nil {
+		t.Fatal(err)
+	}
+	u, err := NewUserTable().Transfer(ctx, db, authz, UserTableTransferInput{UserID: "eve", ToOrgID: "globex"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if u.Org != "globex" || u.OrgAdmin {
+		t.Fatalf("got org %q admin %v, want globex false", u.Org, u.OrgAdmin)
+	}
+	stored, err := NewUserTable().Find(ctx, db, "eve")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if stored.Org != "globex" || stored.OrgAdmin {
+		t.Fatalf("stored org %q admin %v, want globex false", stored.Org, stored.OrgAdmin)
+	}
+}
+
+// The zero authorization object grants nothing.
+func TestTransferZeroAuthzForbidden(t *testing.T) {
+	db, err := Open()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+
+	_, err = NewUserTable().Transfer(context.Background(), db, OrgAuthz{}, UserTableTransferInput{UserID: "ben", ToOrgID: "globex"})
+	if !errors.Is(err, ErrForbidden) {
+		t.Fatalf("got %v, want ErrForbidden", err)
+	}
+}
+
+// A failed transfer changes nothing: the user keeps its org and memberships.
+func TestTransferFailureRollsBack(t *testing.T) {
+	ctx := context.Background()
+	db, err := Open()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+
+	authz, err := NewOrgAuthz(actorOf(t, db, "eve"), "acme")
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, err = NewUserTable().Transfer(ctx, db, authz, UserTableTransferInput{UserID: "ben", ToOrgID: "initech"})
+	if !errors.Is(err, ErrInvalid) {
+		t.Fatalf("got %v, want ErrInvalid", err)
+	}
+	u, err := NewUserTable().Find(ctx, db, "ben")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if u.Org != "acme" {
+		t.Fatalf("org changed to %q", u.Org)
+	}
+	ms, err := NewMembershipTable().ListByUser(ctx, db, "ben")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(ms) != 2 {
+		t.Fatalf("ben has %d memberships, want 2", len(ms))
+	}
+}
