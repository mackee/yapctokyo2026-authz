+// OrgExists reports whether the organization exists, that is, whether some
+// user or project belongs to it.
+func (*UserTable) OrgExists(ctx context.Context, db DB, orgID string) (bool, error) {
+	var ok bool
+	if err := db.QueryRowContext(ctx,
+		`SELECT EXISTS (SELECT 1 FROM users WHERE org_id = ?) OR EXISTS (SELECT 1 FROM projects WHERE org_id = ?)`,
+		orgID, orgID).Scan(&ok); err != nil {
+		return false, err
+	}
+	return ok, nil
+}
+
+// UserTableTransferInput is the input of UserTable.Transfer.
+type UserTableTransferInput struct {
+	UserID  string
+	ToOrgID string
+}
+
+// Transfer moves the user to another organization, all or nothing. The user
+// keeps no access to the old organization: its memberships in the old
+// organization's projects are removed, its tasks there are unassigned, and its
+// org admin flag is cleared. Only org admins of the user's current organization
+// may do it. The user is looked up within the authorized organization; a user
+// of another organization is ErrNotFound.
+func (*UserTable) Transfer(ctx context.Context, db DB, authz OrgAuthz, in UserTableTransferInput) (*User, error) {
+	if err := authz.CanManageUsers(); err != nil {
+		return nil, err
+	}
+	var u *User
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadTransferUser(ctx, tx, authz.OrgID(), in)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if u, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return u, nil
+}
