+// Member is the JSON shape of a project member in the members API.
+type Member struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+type setMembersRequest struct {
+	Roles map[string]string `json:"roles" validate:"required,min=1,dive,oneof=manager contributor viewer"`
+}
+
+// setMembers changes several members' roles at once and answers the project's
+// members after the change. Any rejected entry rejects the whole request.
+func setMembers(ctx tanukirpc.Context[*projectRegistry], req setMembersRequest) ([]Member, error) {
+	reg := ctx.Registry()
+	ms, err := model.NewMembershipTable().SetRoles(ctx, reg.db, reg.authz, req.Roles)
+	if err != nil {
+		return nil, err
+	}
+	out := make([]Member, 0, len(ms))
+	for _, m := range ms {
+		out = append(out, Member{UserID: m.UserID, Role: m.Role})
+	}
+	return out, nil
+}
