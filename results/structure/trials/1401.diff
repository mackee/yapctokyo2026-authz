+// ---- operations -----------------------------------------------------------------------
+
+// SetRoles changes the roles of several members of the project and returns the
+// project's members after the change. roles maps user IDs to roles. The change
+// is all or nothing: if any entry is rejected, no role changes.
+func (mt *MembershipTable) SetRoles(ctx context.Context, db DB, authz ProjectAuthz, roles map[string]string) ([]*Membership, error) {
+	if len(roles) == 0 {
+		return nil, deny(ErrInvalid, "roles must not be empty")
+	}
+	for _, role := range roles {
+		if !isValidRole(role) {
+			return nil, deny(ErrInvalid, "role must be manager, contributor or viewer")
+		}
+	}
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var out []*Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		p, err := NewProjectTable().Find(ctx, tx, authz.ProjectID())
+		if err != nil {
+			return err
+		}
+		agg, err := loadSetRoles(ctx, tx, p, roles)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(ctx, tx); err != nil {
+			return err
+		}
+		if err := agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		out, err = mt.ListByProject(ctx, tx, p.ID)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
