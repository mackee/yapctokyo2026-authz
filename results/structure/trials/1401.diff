+		{"manager demotes manager to contributor", "ann", "web", `{"roles":{"ivy":"contributor"}}`, 200},
+		{"manager demotes assignee-less member to viewer", "ann", "web", `{"roles":{"ivy":"viewer"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"unknown user", "zed", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"invalid role", "ann", "web", `{"roles":{"dan":"owner"}}`, 400},
+		{"empty role", "ann", "web", `{"roles":{"dan":""}}`, 400},
+		{"malformed body", "ann", "web", `{"roles":`, 400},
+		{"target not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"target in another org", "ann", "web", `{"roles":{"gus":"viewer"}}`, 400},
+		{"demote assignee", "ann", "web", `{"roles":{"ben":"viewer"}}`, 400},
+		{"demote assignee to contributor is fine", "ann", "web", `{"roles":{"ben":"contributor"}}`, 200},
+		{"one bad entry rejects the batch", "ann", "web", `{"roles":{"dan":"contributor","hal":"viewer"}}`, 400},
+		{"one assignee demotion rejects the batch", "ann", "web", `{"roles":{"dan":"contributor","cat":"viewer"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMembersResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann",
+		`{"roles":{"ivy":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []Member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []Member{
+		{UserID: "ann", Role: "manager"},
+		{UserID: "ben", Role: "contributor"},
+		{UserID: "cat", Role: "contributor"},
+		{UserID: "dan", Role: "contributor"},
+		{UserID: "ivy", Role: "viewer"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %d members, want %d: %s", len(got), len(want), body)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("member %d: got %+v want %+v", i, got[i], want[i])
+		}
+	}
+}
+
+func TestSetMembersIsAllOrNothing(t *testing.T) {
+	h := newServer()
+	// ben holds t1 in web, so demoting him is rejected; dan's change in the same
+	// request must not apply either.
+	code, _ := do(t, h, "PUT", "/projects/web/members", "ann",
+		`{"roles":{"dan":"contributor","ben":"viewer"}}`)
+	if code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	// A later accepted request answers the whole member list: dan is unchanged.
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ivy":"viewer"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []Member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	for _, m := range got {
+		if m.UserID == "dan" && m.Role != "viewer" {
+			t.Fatalf("dan changed to %s by a rejected request", m.Role)
+		}
+		if m.UserID == "ben" && m.Role != "contributor" {
+			t.Fatalf("ben changed to %s by a rejected request", m.Role)
+		}
+	}
+}
