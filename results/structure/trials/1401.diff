+// setRolesAggregate changes the roles of several members of one project. It
+// is all or nothing: validate runs on every member before apply changes any.
+type setRolesAggregate struct {
+	roles   map[string]string // user ID -> requested role
+	members []*Membership     // the members named in roles, ordered by user ID
+}
+
+func loadSetRoles(ctx context.Context, tx DB, p *Project, roles map[string]string) (*setRolesAggregate, error) {
+	a := &setRolesAggregate{roles: roles}
+	userIDs := make([]string, 0, len(roles))
+	for userID := range roles {
+		userIDs = append(userIDs, userID)
+	}
+	sort.Strings(userIDs)
+	for _, userID := range userIDs {
+		m, err := p.Membership(ctx, tx, userID)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "user is not a member of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		a.members = append(a.members, m)
+	}
+	return a, nil
+}
+
+// validate checks the model rule after the change: an assignee is a
+// contributor or manager of the task's project. A member who would become a
+// viewer must have no assigned tasks in the project.
+func (a *setRolesAggregate) validate(ctx context.Context, tx DB) error {
+	for _, m := range a.members {
+		if isWriterRole(a.roles[m.UserID]) {
+			continue
+		}
+		tasks, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return err
+		}
+		if len(tasks) > 0 {
+			return deny(ErrInvalid, "member has assigned tasks and would no longer be a contributor or manager")
+		}
+	}
+	return nil
+}
+
+func (a *setRolesAggregate) apply(ctx context.Context, tx DB) error {
+	for _, m := range a.members {
+		m.Role = a.roles[m.UserID]
+		if err := m.save(ctx, tx); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
