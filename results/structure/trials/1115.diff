+// transferUserAggregate moves one user to another organization. Because project
+// members must belong to the project's organization, it also removes the
+// user's memberships and unassigns their tasks.
+type transferUserAggregate struct {
+	user        *User
+	fromOrg     string
+	toOrg       string
+	memberships []*Membership
+	tasks       []*Task
+	toOrgExists bool
+}
+
+func loadTransferUser(ctx context.Context, tx DB, fromOrg, userID string, in UserTableTransferInput) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &transferUserAggregate{user: u, fromOrg: fromOrg, toOrg: in.ToOrg}
+	if u.Org != fromOrg {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if a.memberships, err = u.Memberships(ctx, tx); err != nil {
+		return nil, err
+	}
+	if a.tasks, err = u.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	if a.toOrgExists, err = NewUserTable().ExistsInOrg(ctx, tx, in.ToOrg); err != nil {
+		return nil, err
+	}
+	if !a.toOrgExists {
+		if a.toOrgExists, err = NewProjectTable().ExistsInOrg(ctx, tx, in.ToOrg); err != nil {
+			return nil, err
+		}
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if a.toOrg == "" || a.toOrg == a.fromOrg {
+		return deny(ErrInvalid, "toOrgId must be a different organization")
+	}
+	if !a.toOrgExists {
+		return deny(ErrInvalid, "unknown organization")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.user.moveToOrg(ctx, tx, a.toOrg); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
