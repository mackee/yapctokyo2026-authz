+// UserTableTransferInput is the input of UserTable.Transfer.
+type UserTableTransferInput struct {
+	ToOrg string
+}
+
+// Transfer moves the user from the authorized organization to another one.
+// Only an org admin of the user's current organization may do it. The user
+// leaves all projects of the old organization (memberships removed, assigned
+// tasks unassigned) and loses org admin rights.
+func (*UserTable) Transfer(ctx context.Context, db DB, authz OrgAuthz, userID string, in UserTableTransferInput) (*User, error) {
+	if err := authz.CanManageUsers(); err != nil {
+		return nil, err
+	}
+	var u *User
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadTransferUser(ctx, tx, authz.OrgID(), userID, in)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		u, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return u, nil
+}
