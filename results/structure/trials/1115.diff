 	return nil
 }
 
+// OrgAuthz is what the actor may do in one organization (their own).
+type OrgAuthz struct {
+	actor Actor
+	org   string
+}
+
+// OrgID returns the organization the object is bound to.
+func (a OrgAuthz) OrgID() string { return a.org }
+
+// CanManageUsers returns nil if the actor may manage the organization's users
+// (transfer them): org admins only (else ErrForbidden).
+func (a OrgAuthz) CanManageUsers() error {
+	if a.org == "" || a.actor.org != a.org || !a.actor.orgAdmin {
+		return deny(ErrForbidden, "only org admins may manage users")
+	}
+	return nil
+}
+
+// NewOrgAuthz builds the actor's authorization object for an organization.
+// The actor must belong to it; otherwise ErrNotFound.
+func NewOrgAuthz(act Actor, orgID string) (OrgAuthz, error) {
+	if act.org != orgID {
+		return OrgAuthz{}, deny(ErrNotFound, "not found")
+	}
+	return OrgAuthz{actor: act, org: orgID}, nil
+}
+
 // ---- building authorization objects -------------------------------------------------
 
 // Authenticate resolves the X-User value. Unknown or missing users are 401.
