+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"reflect"
+	"testing"
+)
+
+// POST /projects/{pid}/freeze turns every member of the project into a viewer
+// (managers included) and returns the member list. After that nobody can change
+// the project's tasks.
+
+func TestFreezeResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != http.StatusOK {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got []map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("body %q is not a member list: %v", body, err)
+	}
+	want := []map[string]string{
+		{"userId": "ann", "role": "viewer"},
+		{"userId": "ben", "role": "viewer"},
+		{"userId": "cat", "role": "viewer"},
+		{"userId": "dan", "role": "viewer"},
+		{"userId": "ivy", "role": "viewer"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+}
+
+func TestFreezeAuthz(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown project", "ann", "nope", 404},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRefusedFreezeChangesNothing(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ben", ""); code != http.StatusForbidden {
+		t.Fatalf("contributor freeze: got %d want 403", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ann", `{"title":"x"}`); code != http.StatusOK {
+		t.Fatalf("manager create after refused freeze: got %d want 200", code)
+	}
+}
+
+func TestFreezeBlocksTaskChanges(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != http.StatusOK {
+		t.Fatalf("freeze: got %d want 200: %s", code, body)
+	}
+	cases := []struct {
+		name, user, method, path, body string
+		want                           int
+	}{
+		{"reads still work", "ann", "GET", "/projects/web/tasks", "", 200},
+		{"former manager creates", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"former manager edits", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"former contributor edits own", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`, 403},
+		{"former manager (other) edits", "ivy", "PATCH", "/projects/web/tasks/t3", `{"title":"y"}`, 403},
+		{"former manager deletes", "ann", "DELETE", "/projects/web/tasks/t3", "", 403},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, h, c.method, c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeClearsAssignees(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != http.StatusOK {
+		t.Fatalf("freeze: got %d want 200", code)
+	}
+	for _, path := range []string{"/projects/web/tasks/t1", "/projects/web/tasks/t2"} {
+		code, body := do(t, h, "GET", path, "ann", "")
+		if code != http.StatusOK {
+			t.Fatalf("%s: got %d want 200", path, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.AssigneeID != "" {
+			t.Fatalf("%s: still assigned to %q after freeze", path, task.AssigneeID)
+		}
+	}
+}
+
+func TestFreezeLeavesOtherProjectsAlone(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != http.StatusOK {
+		t.Fatalf("freeze: got %d want 200", code)
+	}
+	// ivy is a manager of ops too; only web was frozen.
+	if code, body := do(t, h, "POST", "/projects/ops/tasks", "ivy", `{"title":"x","assignee":"cat"}`); code != http.StatusOK {
+		t.Fatalf("create in ops after freezing web: got %d want 200: %s", code, body)
+	}
+	code, body := do(t, h, "GET", "/projects/ops/tasks/t4", "ivy", "")
+	if code != http.StatusOK {
+		t.Fatalf("got %d want 200", code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "cat" {
+		t.Fatalf("ops task t4 assignee changed to %q, want cat", task.AssigneeID)
+	}
+}
