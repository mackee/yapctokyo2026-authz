+// moveMemberAggregate moves one member from one project to another, keeping the
+// role. The tasks assigned to the member in the old project stay there,
+// unassigned, so that "an assignee is a contributor or manager of the task's
+// project" keeps holding.
+type moveMemberAggregate struct {
+	from     *Project
+	to       *Project
+	member   *Membership // from.Membership(user)
+	user     *User       // member.User()
+	existing *Membership // to.Membership(user); nil when not yet a member
+	tasks    []*Task     // member.AssignedTasks()
+}
+
+func loadMoveMember(ctx context.Context, tx DB, fromID, toID, userID string) (*moveMemberAggregate, error) {
+	pt := NewProjectTable()
+	from, err := pt.Find(ctx, tx, fromID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	to, err := pt.Find(ctx, tx, toID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveMemberAggregate{from: from, to: to}
+	if a.member, err = from.Membership(ctx, tx, userID); errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if a.user, err = a.member.User(ctx, tx); errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if m, err := to.Membership(ctx, tx, userID); err == nil {
+		a.existing = m
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	if a.tasks, err = a.member.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.from.ID == a.to.ID {
+		return deny(ErrInvalid, "destination must be a different project")
+	}
+	if a.user.Org != a.to.Org {
+		return deny(ErrInvalid, "member must belong to the destination project's organization")
+	}
+	if a.existing != nil {
+		return deny(ErrInvalid, "user is already a member of the destination project")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.member.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	moved := a.to.newMembership(a.member.UserID, a.member.Role)
+	if err := moved.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return moved, nil
+}
+
