+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/dan", 204},
+		{"not org admin", "ann", "/orgs/acme/users/dan", 403},
+		{"anonymous", "", "/orgs/acme/users/dan", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/dan", 401},
+		{"other org caller", "gus", "/orgs/acme/users/dan", 404},
+		{"org in path is not caller's", "eve", "/orgs/globex/users/gus", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
