+// removeOrgUser takes a user out of every project membership in the org.
+// Used when someone leaves the organization. Tasks assigned to the user are
+// left as they are, and the user's org and org-admin flag are not changed.
+func (s *server) removeOrgUser(w http.ResponseWriter, r *http.Request) {
+	s.store.mu.Lock()
+	defer s.store.mu.Unlock()
+
+	caller := s.store.User(r.Header.Get("X-User"))
+	if caller == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	orgID := r.PathValue("orgID")
+	if caller.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	if !caller.OrgAdmin {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	target := s.store.User(r.PathValue("uid"))
+	if target == nil || target.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	s.store.RemoveOrgUserMemberships(orgID, target.ID)
+	w.WriteHeader(204)
+}
