+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"unauthenticated", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"caller in other org", "gus", "/orgs/acme/users/ben", 404},
+		{"caller is member not admin", "ann", "/orgs/acme/users/ben", 403},
+		{"caller has no roles", "hal", "/orgs/acme/users/ben", 403},
+		{"target unknown", "eve", "/orgs/acme/users/zed", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"org admin removes user", "eve", "/orgs/acme/users/ben", 204},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserRemovesAllOrgMemberships(t *testing.T) {
+	srv := newServer()
+
+	// ben is a contributor in web and legacy (both acme) before removal.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks/t1", "ben", ""); code != 200 {
+		t.Fatalf("precondition: ben reads web got %d", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/legacy/tasks/t5", "ben", ""); code != 200 {
+		t.Fatalf("precondition: ben reads legacy got %d", code)
+	}
+
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+
+	// ben no longer has any role in acme projects: reads and writes both fail.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks/t1", "ben", ""); code != 404 {
+		t.Fatalf("web read after removal: got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/legacy/tasks/t5", "ben", ""); code != 404 {
+		t.Fatalf("legacy read after removal: got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 404 {
+		t.Fatalf("web write after removal: got %d want 404", code)
+	}
+
+	// Other members of the same projects are unaffected.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ann", ""); code != 200 {
+		t.Fatalf("ann web list after removal: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks/t4", "cat", ""); code != 200 {
+		t.Fatalf("cat ops read after removal: got %d want 200", code)
+	}
+}
+
+func TestRemoveOrgUserLeavesOtherOrgsAlone(t *testing.T) {
+	srv := newServer()
+
+	// gus is a manager of the globex project gx. An acme org admin cannot
+	// remove gus, and removing an acme user must not touch gus's globex role.
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/gus", "eve", ""); code != 404 {
+		t.Fatalf("cross-org target: got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatalf("gus globex read after rejected removal: got %d want 200", code)
+	}
+
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove ben: got %d want 204", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatalf("gus globex read after removing ben: got %d want 200", code)
+	}
+}
