+// RemoveOrgUserMemberships removes userID from every project that belongs to orgID.
+func (s *Store) RemoveOrgUserMemberships(orgID, userID string) {
+	for pid, p := range s.projects {
+		if p.OrgID == orgID {
+			delete(s.members[pid], userID)
