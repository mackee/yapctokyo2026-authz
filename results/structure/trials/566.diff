+// TaskTableMoveInput is the input of TaskTable.Move.
+type TaskTableMoveInput struct {
+	ToProjectID string
+}
+
+// Move moves the task to another project of the actor's organization. It is a
+// removal from the source project (managers only, not archived) and a creation
+// in the destination (CanWrite, CanAssign for the task's assignee). A
+// destination the actor cannot read is ErrNotFound. The task's assignee must be
+// a contributor or manager of the destination, else ErrInvalid.
+func (*TaskTable) Move(ctx context.Context, db DB, authz TaskAuthz, in TaskTableMoveInput) (*Task, error) {
+	if err := authz.CanManage(); err != nil {
+		return nil, err
+	}
+	if in.ToProjectID == "" {
+		return nil, deny(ErrInvalid, "toProjectId must not be empty")
+	}
+	if in.ToProjectID == authz.project.project {
+		return nil, deny(ErrInvalid, "task is already in the project")
+	}
+	dest, err := NewProjectAuthz(ctx, db, authz.project.actor, in.ToProjectID)
+	if err != nil {
+		return nil, err
+	}
+	if err := dest.CanWrite(); err != nil {
+		return nil, err
+	}
+	var t *Task
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveTask(ctx, tx, authz.TaskID(), dest.ProjectID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if err := dest.CanAssign(agg.task.AssigneeID); err != nil {
+			return err
+		}
+		if t, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return t, nil
+}
