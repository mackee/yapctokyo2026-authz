+
+type moveRequest struct {
+	ToProjectID string `json:"toProjectId"`
+}
+
+// moveTask moves a task to another project, keeping its ID, title, status and
+// assignee. The caller must be a manager of both projects, the destination must
+// be readable by the caller, and the assignee (if any) must be a contributor or
+// manager of the destination.
+func (s *server) moveTask(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role, err := findRole(ctx, s.db, project.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	task, err := findTask(ctx, s.db, r.PathValue("tid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if task == nil || task.ProjectID != project.ID {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req moveRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || req.ToProjectID == "" {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	dest, err := findProject(ctx, s.db, req.ToProjectID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if dest == nil || dest.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	destRole, err := findRole(ctx, s.db, dest.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if destRole == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if destRole != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if dest.ID == project.ID {
+		writeError(w, 400, "task is already in that project")
+		return
+	}
+	if dest.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	if task.Assignee != "" {
+		assigneeRole, err := findRole(ctx, s.db, dest.ID, task.Assignee)
+		if err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+		if assigneeRole != RoleManager && assigneeRole != RoleContributor {
+			writeError(w, 400, "assignee must be a contributor or manager of the destination project")
+			return
+		}
+	}
+	if _, err := s.db.ExecContext(ctx, `UPDATE tasks SET project_id = ? WHERE id = ?`, dest.ID, task.ID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	task.ProjectID = dest.ID
+	writeJSON(w, 200, task)
+}
