 func (a *deleteTaskAggregate) validate() error { return nil }
 
 func (a *deleteTaskAggregate) apply(x *tx) { a.task.Destroy(x) }
+
+// removeMemberAggregate removes one user from one project. The tasks of that
+// project assigned to the user are unassigned in the same change, so the rule
+// "an assignee is a member of the task's project" keeps holding.
+type removeMemberAggregate struct {
+	membership membershipRecord
+	tasks      []taskRecord // the membership's assigned tasks in the project
+}
+
+func loadRemoveMember(x *tx, p projectRecord, userID string) (*removeMemberAggregate, error) {
+	m, ok := p.Membership(x, userID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	return &removeMemberAggregate{membership: m, tasks: m.AssignedTasks(x)}, nil
+}
+
+func (a *removeMemberAggregate) validate() error { return nil }
+
+func (a *removeMemberAggregate) apply(x *tx) {
+	for _, t := range a.tasks {
+		t.Unassign(x)
+	}
+	a.membership.Destroy(x)
+}
