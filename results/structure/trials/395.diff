+// MemberView is the public representation of a project member.
+type MemberView struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// ManageProject may change the project roles of its members.
+type ManageProject interface {
+	ReadProject
+	// ChangeRoles applies roles (user ID -> role) to the project's members as
+	// one all-or-nothing write. It returns the members after the change, sorted
+	// by user ID. An empty map, an unknown role, or a user who is not a member
+	// of the project is 400 and nothing changes.
+	ChangeRoles(roles map[string]string) ([]MemberView, error)
+}
+
+type manageProject struct{ readProject }
+
+func (p *manageProject) ChangeRoles(roles map[string]string) ([]MemberView, error) {
+	var out []MemberView
+	err := p.ps.as.a.db.update(func(x *tx) error {
+		agg, err := loadChangeRoles(x, p.ps.pid, roles)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		out = agg.apply(x)
+		return nil
+	})
+	return out, err
+}
+
