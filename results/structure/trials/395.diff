+// changeRolesAggregate changes the roles of several members of one project.
+type changeRolesAggregate struct {
+	project projectRecord
+	changes []roleChange // sorted by user ID
+}
+
+type roleChange struct {
+	member membershipRecord // the existing membership being changed
+	role   string
+}
+
+func loadChangeRoles(x *tx, projectID string, roles map[string]string) (*changeRolesAggregate, error) {
+	p, ok := x.findProject(projectID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if len(roles) == 0 {
+		return nil, deny(ErrInvalid, "roles must not be empty")
+	}
+	userIDs := make([]string, 0, len(roles))
+	for uid := range roles {
+		userIDs = append(userIDs, uid)
+	}
+	sort.Strings(userIDs)
+	a := &changeRolesAggregate{project: p}
+	for _, uid := range userIDs {
+		m, ok := p.Membership(x, uid)
+		if !ok {
+			return nil, deny(ErrInvalid, "user is not a member of the project: "+uid)
+		}
+		a.changes = append(a.changes, roleChange{member: m, role: roles[uid]})
+	}
+	return a, nil
+}
+
+func (a *changeRolesAggregate) validate() error {
+	for _, c := range a.changes {
+		if !validRoles[c.role] {
+			return deny(ErrInvalid, "invalid role: "+c.role)
+		}
+	}
+	return nil
+}
+
+func (a *changeRolesAggregate) apply(x *tx) []MemberView {
+	for _, c := range a.changes {
+		c.member.SetRole(x, c.role)
+	}
+	members := a.project.Memberships(x)
+	out := make([]MemberView, 0, len(members))
+	for _, m := range members {
+		out = append(out, m.view())
+	}
+	return out
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task taskRecord
