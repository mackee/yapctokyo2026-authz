+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager moves", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 200},
+		{"assignee is dest member", "ivy", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 200},
+		{"assignee not in dest", "ivy", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 400},
+		{"dest viewer", "ann", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 403},
+		{"dest contributor, other assignee", "cat", "/projects/ops/tasks/t4", `{"toProjectId":"web"}`, 403},
+		{"source contributor", "cat", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 403},
+		{"source archived", "ann", "/projects/legacy/tasks/t5", `{"toProjectId":"web"}`, 409},
+		{"dest archived", "ann", "/projects/web/tasks/t3", `{"toProjectId":"legacy"}`, 409},
+		{"dest other org", "ann", "/projects/web/tasks/t3", `{"toProjectId":"gx"}`, 404},
+		{"dest missing", "ann", "/projects/web/tasks/t3", `{"toProjectId":"nope"}`, 404},
+		{"dest not readable", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"legacy"}`, 404},
+		{"cross project id", "ann", "/projects/web/tasks/t4", `{"toProjectId":"ops"}`, 404},
+		{"missing body field", "ann", "/projects/web/tasks/t3", `{}`, 400},
+		{"anonymous", "", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 401},
+		{"non member", "hal", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsFields(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", Assignee: "cat"}
+	if task != want {
+		t.Fatalf("got %+v want %+v", task, want)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t2", "ann", ""); code != 404 {
+		t.Fatalf("still in source: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks/t2", "ann", ""); code != 200 {
+		t.Fatalf("not in dest: %d", code)
+	}
+}
