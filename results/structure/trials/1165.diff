index 0000000..852aab8
--- /dev/null
+++ b/move_test.go
@@ -0,0 +1,94 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestMoveRejects(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"anonymous", "", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 401},
+		{"unknown user", "zed", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 401},
+		{"non member caller", "hal", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 404},
+		{"other org caller", "gus", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 404},
+		{"source missing", "ivy", "/projects/nope/members/dan/move", `{"toProjectId":"ops"}`, 404},
+		{"user not in source", "ivy", "/projects/web/members/hal/move", `{"toProjectId":"ops"}`, 404},
+		{"contributor caller", "ben", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer caller", "dan", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin caller", "eve", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 403},
+		{"manager of source only", "ann", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 403},
+		{"destination missing", "ivy", "/projects/web/members/dan/move", `{"toProjectId":"nope"}`, 404},
+		{"destination other org", "ivy", "/projects/web/members/dan/move", `{"toProjectId":"gx"}`, 404},
+		{"destination not readable", "ivy", "/projects/web/members/dan/move", `{"toProjectId":"legacy"}`, 404},
+		{"destination archived", "ann", "/projects/web/members/dan/move", `{"toProjectId":"legacy"}`, 409},
+		{"source archived", "ann", "/projects/legacy/members/ben/move", `{"toProjectId":"web"}`, 409},
+		{"already in destination", "ivy", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 409},
+		{"owns tasks in source", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 409},
+		{"same project", "ivy", "/projects/web/members/dan/move", `{"toProjectId":"web"}`, 400},
+		{"missing destination", "ivy", "/projects/web/members/dan/move", `{}`, 400},
+		{"bad body", "ivy", "/projects/web/members/dan/move", `{`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMove(t *testing.T) {
+	h := newServer()
+
+	code, body := do(t, h, "POST", "/projects/web/members/dan/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d: %s", code, body)
+	}
+	var got moveResponse
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if want := (moveResponse{UserID: "dan", ProjectID: "ops", Role: "viewer"}); got != want {
+		t.Fatalf("response %+v want %+v", got, want)
+	}
+
+	// dan is no longer in web, and is now a viewer of ops.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "dan", ""); code != 404 {
+		t.Fatalf("dan reads web after move: got %d want 404", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "dan", ""); code != 200 {
+		t.Fatalf("dan reads ops after move: got %d want 200", code)
+	}
+	// Moving again from web fails: dan is no longer a member there.
+	if code, _ := do(t, h, "POST", "/projects/web/members/dan/move", "ivy", `{"toProjectId":"ops"}`); code != 404 {
+		t.Fatalf("second move: got %d want 404", code)
+	}
+}
+
+func TestMoveKeepsContributorRole(t *testing.T) {
+	h := newServer()
+
+	// ben owns t1 in web; reassign it so the move is allowed.
+	if code, body := do(t, h, "PATCH", "/projects/web/tasks/t1", "ivy", `{"assignee":""}`); code != 200 {
+		t.Fatalf("reassign: got %d: %s", code, body)
+	}
+	code, body := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d: %s", code, body)
+	}
+	var got moveResponse
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.Role != RoleContributor {
+		t.Fatalf("role %q want %q", got.Role, RoleContributor)
+	}
+	// As a contributor in ops, ben can create a task assigned to himself.
+	if code, body := do(t, h, "POST", "/projects/ops/tasks", "ben", `{"title":"x","assignee":"ben"}`); code != 200 {
+		t.Fatalf("create in ops: got %d: %s", code, body)
+	}
+}
