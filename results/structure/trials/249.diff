 // ---- project capabilities ----------------------------------------------------
 
+// MemberView is the public representation of a project member.
+type MemberView struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// ManageProject is the manager-only capability for one project's membership.
+type ManageProject interface {
+	// SetMemberRole changes the role of an existing member. An unknown role is
+	// 400, a user who is not a member is 404, and a change that would break a
+	// model invariant (e.g. demoting an assignee to viewer) is 400.
+	SetMemberRole(userID, role string) (MemberView, error)
+}
+
+type manageProject struct{ ps *projectScope }
+
+func (p *manageProject) SetMemberRole(userID, role string) (MemberView, error) {
+	if role != RoleManager && role != RoleContributor && role != RoleViewer {
+		return MemberView{}, deny(ErrInvalid, "role must be manager, contributor or viewer")
+	}
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		if s.role(p.ps.pid, userID) == "" {
+			return deny(ErrNotFound, "not found")
+		}
+		s.members[p.ps.pid][userID] = role
+		return nil
+	})
+	if err != nil {
+		return MemberView{}, err
+	}
+	return MemberView{UserID: userID, Role: role}, nil
+}
