+// CanMoveTo returns nil if the actor may move the task to the project whose
+// authorization object is dest. The actor must be a contributor or manager in
+// both projects, and either a manager in both or the task's assignee (else
+// ErrForbidden). Neither project may be archived (else ErrArchived).
+func (a TaskAuthz) CanMoveTo(dest ProjectAuthz) error {
+	if !a.CanRead() || !dest.CanRead() || !isWriterRole(a.project.role) || !isWriterRole(dest.role) {
+		return deny(ErrForbidden, "forbidden")
+	}
+	bothManagers := a.project.role == RoleManager && dest.role == RoleManager
+	if !bothManagers && !a.isAssignee {
+		return deny(ErrForbidden, "only managers in both projects may move tasks assigned to others")
+	}
+	if a.project.archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	if dest.archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	return nil
+}
