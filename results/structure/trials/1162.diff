+
+// ---- member roles ----------------------------------------------------------------
+
+type memberRole struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+type membersRequest struct {
+	Roles map[string]string `json:"roles"`
+}
+
+// querier is satisfied by *sql.DB and *sql.Tx.
+type querier interface {
+	QueryContext(ctx context.Context, query string, args ...any) (*sql.Rows, error)
+}
+
+// listMembers returns every member of the project, ordered by user ID.
+func listMembers(ctx context.Context, q querier, projectID string) ([]memberRole, error) {
+	rows, err := q.QueryContext(ctx, `SELECT user_id, role FROM memberships WHERE project_id = ? ORDER BY user_id`, projectID)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	members := []memberRole{}
+	for rows.Next() {
+		var m memberRole
+		if err := rows.Scan(&m.UserID, &m.Role); err != nil {
+			return nil, err
+		}
+		members = append(members, m)
+	}
+	return members, rows.Err()
+}
+
+// assigneesOf returns the set of users assigned to at least one task in the project.
+func assigneesOf(ctx context.Context, q querier, projectID string) (map[string]bool, error) {
+	rows, err := q.QueryContext(ctx, `SELECT DISTINCT assignee FROM tasks WHERE project_id = ? AND assignee <> ''`, projectID)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	set := map[string]bool{}
+	for rows.Next() {
+		var a string
+		if err := rows.Scan(&a); err != nil {
+			return nil, err
+		}
+		set[a] = true
+	}
+	return set, rows.Err()
+}
+
+// setMemberRoles changes the roles of several members at once. Either every
+// change applies or none does.
+func (s *server) setMemberRoles(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role, err := findRole(ctx, s.db, project.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "only managers may change member roles")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req membersRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || len(req.Roles) == 0 {
+		writeError(w, 400, "roles must be a non-empty object of userId to role")
+		return
+	}
+
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+
+	members, err := listMembers(ctx, tx, project.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	memberSet := map[string]bool{}
+	for _, m := range members {
+		memberSet[m.UserID] = true
+	}
+	assignees, err := assigneesOf(ctx, tx, project.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+
+	// Validate every change before applying any of them.
+	userIDs := make([]string, 0, len(req.Roles))
+	for uid := range req.Roles {
+		userIDs = append(userIDs, uid)
+	}
+	sort.Strings(userIDs)
+	for _, uid := range userIDs {
+		newRole := req.Roles[uid]
+		if newRole != RoleManager && newRole != RoleContributor && newRole != RoleViewer {
+			writeError(w, 400, "invalid role for "+uid)
+			return
+		}
+		if !memberSet[uid] {
+			writeError(w, 400, uid+" is not a member of the project")
+			return
+		}
+		// Assignees must stay contributors or managers (see the model invariant).
+		if newRole == RoleViewer && assignees[uid] {
+			writeError(w, 409, uid+" is assigned to tasks and cannot become a viewer")
+			return
+		}
+	}
+
+	for _, uid := range userIDs {
+		if _, err := tx.ExecContext(ctx, `UPDATE memberships SET role = ? WHERE project_id = ? AND user_id = ?`,
+			req.Roles[uid], project.ID, uid); err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+	}
+	updated, err := listMembers(ctx, tx, project.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, updated)
+}
