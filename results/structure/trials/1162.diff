+func TestSetMemberRoles(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager changes roles", "ann", "web", `{"roles":{"dan":"contributor","ivy":"contributor"}}`, 200},
+		{"manager promotes to manager", "ann", "web", `{"roles":{"dan":"manager"}}`, 200},
+		{"contributor caller", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer caller", "dan", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"org admin without role", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"unknown user", "zed", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"missing project", "ann", "nope", `{"roles":{"dan":"contributor"}}`, 404},
+		{"archived", "ann", "legacy", `{"roles":{"ann":"contributor"}}`, 409},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"no roles field", "ann", "web", `{}`, 400},
+		{"invalid body", "ann", "web", `not json`, 400},
+		{"invalid role", "ann", "web", `{"roles":{"dan":"admin"}}`, 400},
+		{"target not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"target in other org", "ann", "web", `{"roles":{"gus":"viewer"}}`, 400},
+		{"demote assignee to viewer", "ann", "web", `{"roles":{"ben":"viewer"}}`, 409},
+		{"demote assignee within batch", "ann", "web", `{"roles":{"dan":"contributor","cat":"viewer"}}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMemberRolesResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","ivy":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []memberRole
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []memberRole{
+		{"ann", "manager"}, {"ben", "contributor"}, {"cat", "contributor"},
+		{"dan", "contributor"}, {"ivy", "contributor"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("entry %d: got %v want %v", i, got[i], want[i])
+		}
+	}
+}
+
+func TestSetMemberRolesIsAllOrNothing(t *testing.T) {
+	h := newServer()
+	// hal is not a member, so the whole request is refused, dan's change included.
+	if code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","hal":"viewer"}}`); code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	// ben is assigned t1, so demoting him is refused, and dan's change with it.
+	if code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","ben":"viewer"}}`); code != 409 {
+		t.Fatalf("got %d want 409", code)
+	}
+	// Neither failed request was applied: dan is still a viewer.
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ivy":"viewer"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	if !strings.Contains(body, `{"userId":"dan","role":"viewer"}`) || !strings.Contains(body, `{"userId":"ben","role":"contributor"}`) {
+		t.Fatalf("failed requests changed state: %s", body)
+	}
+}
