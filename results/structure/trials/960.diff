+func TestUpdateMemberRoles(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager promotes and demotes", "ann", "/projects/web/members", `{"roles":{"dan":"contributor","ivy":"viewer"}}`, 200},
+		{"contributor", "ben", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 403},
+		{"org admin", "eve", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non-readable", "hal", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 404},
+		{"archived", "ann", "/projects/legacy/members", `{"roles":{"ben":"viewer"}}`, 409},
+		{"bad role", "ann", "/projects/web/members", `{"roles":{"dan":"boss"}}`, 400},
+		{"empty", "ann", "/projects/web/members", `{"roles":{}}`, 400},
+		{"not a member", "ann", "/projects/web/members", `{"roles":{"hal":"viewer"}}`, 400},
+		{"assignee demoted", "ann", "/projects/web/members", `{"roles":{"ben":"viewer"}}`, 400},
+		{"no manager left", "ann", "/projects/web/members", `{"roles":{"ann":"viewer","ivy":"viewer"}}`, 400},
+		{"unauthenticated", "", "/projects/web/members", `{"roles":{"dan":"viewer"}}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+		})
+	}
+
+	t.Run("response", func(t *testing.T) {
+		_, body := do(t, newServer(), "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","ivy":"viewer"}}`)
+		var got []map[string]string
+		if err := json.Unmarshal([]byte(body), &got); err != nil {
+			t.Fatal(err)
+		}
+		want := map[string]string{"ann": "manager", "ben": "contributor", "cat": "contributor", "dan": "contributor", "ivy": "viewer"}
+		if len(got) != len(want) {
+			t.Fatalf("got %v", got)
+		}
+		for _, m := range got {
+			if want[m["userId"]] != m["role"] {
+				t.Fatalf("got %v", got)
+			}
+		}
+	})
+
+	t.Run("all or nothing", func(t *testing.T) {
+		h := newServer()
+		if code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","ben":"viewer"}}`); code != 400 {
+			t.Fatalf("got %d", code)
+		}
+		// dan is still a viewer: cannot create tasks.
+		if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 403 {
+			t.Fatalf("dan was changed: %d", code)
+		}
+	})
+}
