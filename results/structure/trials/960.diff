+// updateRolesAggregate changes the roles of several members of one project.
+type updateRolesAggregate struct {
+	members  map[string]*Membership // the project's members by user ID
+	roles    map[string]string      // requested new roles by user ID
+	assigned map[string]bool        // user IDs that have tasks assigned in the project
+}
+
+func loadUpdateRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*updateRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	ms, err := p.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	ts, err := p.Tasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	a := &updateRolesAggregate{members: map[string]*Membership{}, roles: roles, assigned: map[string]bool{}}
+	for _, m := range ms {
+		a.members[m.UserID] = m
+	}
+	for _, t := range ts {
+		if t.AssigneeID != "" {
+			a.assigned[t.AssigneeID] = true
+		}
+	}
+	return a, nil
+}
+
+func (a *updateRolesAggregate) validate() error {
+	if len(a.roles) == 0 {
+		return deny(ErrInvalid, "no roles given")
+	}
+	managers := 0
+	for id, m := range a.members {
+		role := m.Role
+		if r, ok := a.roles[id]; ok {
+			role = r
+		}
+		if role == RoleManager {
+			managers++
+		}
+	}
+	for id, role := range a.roles {
+		if role != RoleManager && role != RoleContributor && role != RoleViewer {
+			return deny(ErrInvalid, "invalid role")
+		}
+		if _, ok := a.members[id]; !ok {
+			return deny(ErrInvalid, "not a member of the project: "+id)
+		}
+		if !isWriterRole(role) && a.assigned[id] {
+			return deny(ErrInvalid, "member has assigned tasks and must stay a contributor or manager: "+id)
+		}
+	}
+	if managers == 0 {
+		return deny(ErrInvalid, "the project must keep at least one manager")
+	}
+	return nil
+}
+
+func (a *updateRolesAggregate) apply(ctx context.Context, tx DB) error {
+	for id, role := range a.roles {
+		if err := a.members[id].setRole(ctx, tx, role); err != nil {
+			return err
+		}
+	}
+	return nil
+}
