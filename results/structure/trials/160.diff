+func TestMoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager moves member", "ivy", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 200},
+		{"contributor actor", "ben", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer actor", "dan", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin actor", "eve", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 403},
+		{"non member actor", "hal", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 404},
+		{"other org actor", "gus", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 401},
+		{"unknown source project", "ivy", "/projects/nope/members/cat/move", `{"toProjectId":"ops"}`, 404},
+		{"user not a member of source", "ivy", "/projects/web/members/hal/move", `{"toProjectId":"ops"}`, 404},
+		{"actor not manager of destination", "ann", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"destination missing", "ivy", "/projects/web/members/cat/move", `{"toProjectId":"nope"}`, 404},
+		{"destination in other org", "ivy", "/projects/web/members/cat/move", `{"toProjectId":"gx"}`, 404},
+		{"destination archived", "ann", "/projects/web/members/cat/move", `{"toProjectId":"legacy"}`, 409},
+		{"source archived", "ann", "/projects/legacy/members/ben/move", `{"toProjectId":"web"}`, 409},
+		{"already member of destination", "ivy", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 409},
+		{"same project", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"web"}`, 400},
+		{"missing destination", "ivy", "/projects/web/members/ben/move", `{}`, 400},
+		{"malformed body", "ivy", "/projects/web/members/ben/move", `not json`, 400},
+		{"authz before body", "ben", "/projects/web/members/cat/move", `not json`, 403},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveMemberEffects(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d %s", code, body)
+	}
+	var mv struct {
+		UserID    string `json:"userId"`
+		ProjectID string `json:"projectId"`
+		Role      string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &mv); err != nil {
+		t.Fatal(err)
+	}
+	if mv.UserID != "ben" || mv.ProjectID != "ops" || mv.Role != "contributor" {
+		t.Fatalf("response %+v", mv)
+	}
+
+	// Left the source project.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads web after move: got %d want 404", code)
+	}
+	// Joined the destination with the same role: can read and write there.
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben reads ops after move: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/ops/tasks", "ben", `{"title":"x"}`); code != 201 {
+		t.Fatalf("ben creates in ops after move: got %d want 201", code)
+	}
+	// Tasks assigned to ben in web are released; the task stays in web.
+	code, body = do(t, h, "GET", "/projects/web/tasks/t1", "ivy", "")
+	if code != 200 || !strings.Contains(body, `"assignee":""`) || !strings.Contains(body, `"projectId":"web"`) {
+		t.Fatalf("t1 after move: got %d %s", code, body)
+	}
+	// Other members of web are unaffected.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat reads web after move: got %d want 200", code)
+	}
+}
+
+func TestMoveMemberKeepsViewerRole(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/members/dan/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 || !strings.Contains(body, `"role":"viewer"`) {
+		t.Fatalf("got %d %s", code, body)
+	}
+	if code, _ := do(t, h, "POST", "/projects/ops/tasks", "dan", `{"title":"x"}`); code != 403 {
+		t.Fatalf("viewer creates in ops: got %d want 403", code)
+	}
+}
+
+func TestMoveMemberConflictIsAtomic(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/members/cat/move", "ivy", `{"toProjectId":"ops"}`); code != 409 {
+		t.Fatalf("got %d want 409", code)
+	}
+	// Nothing changed: cat still edits her task in web.
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t2", "cat", `{"status":"done"}`); code != 200 {
+		t.Fatalf("cat edits t2 after failed move: got %d want 200", code)
+	}
+	code, body := do(t, h, "GET", "/projects/web/tasks/t2", "ivy", "")
+	if code != 200 || !strings.Contains(body, `"assignee":"cat"`) {
+		t.Fatalf("t2 after failed move: got %d %s", code, body)
+	}
+}
