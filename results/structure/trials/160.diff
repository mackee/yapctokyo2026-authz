+// MemberView is the public representation of a project membership.
+type MemberView struct {
+	UserID    string `json:"userId"`
+	ProjectID string `json:"projectId"`
+	Role      string `json:"role"`
+}
+
+// ManageProject may change the membership of one project. Only managers of the
+// project may acquire it.
+type ManageProject interface {
+	// MoveMember moves a member from this project to toProjectID, keeping the
+	// role. The actor must also be a manager of the destination (403, or 404 if
+	// the destination is not readable). The user must be a member of this project
+	// (404) and must not already be a member of the destination (409). Tasks in
+	// this project assigned to the user become unassigned. The whole move is one
+	// atomic write.
+	MoveMember(userID, toProjectID string) (MemberView, error)
+}
+
+type manageProject struct{ ps *projectScope }
+
+func (p *manageProject) MoveMember(userID, toProjectID string) (MemberView, error) {
+	if toProjectID == "" {
+		return MemberView{}, deny(ErrInvalid, "toProjectId is required")
+	}
+	src := p.ps.pid
+	if toProjectID == src {
+		return MemberView{}, deny(ErrInvalid, "destination must be a different project")
+	}
+	act := p.ps.as.actor
+	var mv MemberView
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		role, ok := s.members[src][userID]
+		if !ok {
+			return deny(ErrNotFound, "not found")
+		}
+		dest, destRole, err := readable(s, act, toProjectID)
+		if err != nil {
+			return err
+		}
+		if destRole != RoleManager {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if dest.archived {
+			return deny(ErrArchived, "project is archived")
+		}
+		if _, ok := s.members[toProjectID][userID]; ok {
+			return deny(ErrConflict, "user is already a member of the destination project")
+		}
+
+		// The task invariant requires assignees to be members of the task's own
+		// project, so release this user's assignments here before removing them.
+		for id, t := range s.tasks {
+			if t.project == src && t.assignee.user == userID {
+				t.assignee = Assignee{project: src}
+				s.tasks[id] = t
+			}
+		}
+		delete(s.members[src], userID)
+		if s.members[toProjectID] == nil {
+			s.members[toProjectID] = map[string]string{}
+		}
+		s.members[toProjectID][userID] = role
+		mv = MemberView{UserID: userID, ProjectID: toProjectID, Role: role}
+		return nil
+	})
+	return mv, err
+}
+
 type readProject struct{ ps *projectScope }
 
 func (p *readProject) ID() string { return p.ps.pid }
