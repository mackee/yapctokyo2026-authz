+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"other manager", "ivy", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+		{"missing project", "ann", "nope", 404},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeDemotesEveryoneToViewer(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var members []map[string]string
+	if err := json.Unmarshal([]byte(body), &members); err != nil {
+		t.Fatalf("bad body %q: %v", body, err)
+	}
+	want := []string{"ann", "ben", "cat", "dan", "ivy"}
+	if len(members) != len(want) {
+		t.Fatalf("want %d members, got %v", len(want), members)
+	}
+	for i, m := range members {
+		if m["userId"] != want[i] || m["role"] != "viewer" || len(m) != 2 {
+			t.Fatalf("member %d = %v, want {userId:%s role:viewer}", i, m, want[i])
+		}
+	}
+}
+
+func TestFreezeBlocksTaskChanges(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: %d", code)
+	}
+	for _, user := range []string{"ann", "ivy", "ben", "cat", "dan", "eve"} {
+		if code, _ := do(t, h, "POST", "/projects/web/tasks", user, `{"title":"x"}`); code != 403 {
+			t.Errorf("%s create: got %d want 403", user, code)
+		}
+		if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", user, `{"status":"done"}`); code != 403 {
+			t.Errorf("%s update: got %d want 403", user, code)
+		}
+		if code, _ := do(t, h, "DELETE", "/projects/web/tasks/t3", user, ""); code != 403 {
+			t.Errorf("%s delete: got %d want 403", user, code)
+		}
+	}
+	// Reads still work, and the tasks are all still there.
+	code, body := do(t, h, "GET", "/projects/web/tasks", "ann", "")
+	var tasks []Task
+	json.Unmarshal([]byte(body), &tasks)
+	if code != 200 || len(tasks) != 3 {
+		t.Fatalf("list after freeze: %d, %d tasks", code, len(tasks))
+	}
+	// Frozen members are viewers, so nobody can be assigned any more and
+	// existing assignments are cleared (an assignee must be a writer).
+	for _, task := range tasks {
+		if task.AssigneeID != "" {
+			t.Errorf("task %s still assigned to %s", task.ID, task.AssigneeID)
+		}
+	}
+}
+
