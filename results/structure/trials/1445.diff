 }
 
+// moveMemberAggregate moves one member from one project to another, keeping
+// the role. Tasks of the source project assigned to the member are unassigned,
+// so an assignee stays a member of the task's project.
+type moveMemberAggregate struct {
+	from  *Membership
+	user  *User
+	tasks []*Task // from.AssignedTasks
+	dest  *Project
+}
+
+func loadMoveMember(ctx context.Context, tx DB, projectID, userID string) (*moveMemberAggregate, error) {
+	from, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	u, err := from.User(ctx, tx)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "project members must be existing users")
+	} else if err != nil {
+		return nil, err
+	}
+	tasks, err := from.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &moveMemberAggregate{from: from, user: u, tasks: tasks}, nil
+}
+
+// toward loads the destination project and checks the member is not in it yet.
+func (a *moveMemberAggregate) toward(ctx context.Context, tx DB, destID string) error {
+	p, err := NewProjectTable().Find(ctx, tx, destID)
+	if errors.Is(err, ErrNoRows) {
+		return deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return err
+	}
+	a.dest = p
+	if _, err := p.Membership(ctx, tx, a.user.ID); err == nil {
+		return deny(ErrConflict, "user is already a member of the target project")
+	} else if !errors.Is(err, ErrNoRows) {
+		return err
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.user.Org != a.dest.Org {
+		return deny(ErrInvalid, "project members must belong to the project's organization")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.from.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	m := a.dest.newMembership(a.user.ID, a.from.Role)
+	if err := m.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
