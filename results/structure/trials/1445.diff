@@ -8,6 +8,54 @@ type MembershipTable struct{}
 // NewMembershipTable returns the memberships table.
 func NewMembershipTable() *MembershipTable { return &MembershipTable{} }
 
+// MembershipTableMoveInput is the input of MembershipTable.Move.
+type MembershipTableMoveInput struct {
+	ToProjectID string
+}
+
+// Move moves the user from the authorized project to another one, keeping the
+// role. The actor must be a manager of both projects, neither may be archived,
+// and the user must not already be a member of the target. All or nothing.
+func (*MembershipTable) Move(ctx context.Context, db DB, authz ProjectAuthz, userID string, in MembershipTableMoveInput) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveMember(ctx, tx, authz.ProjectID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := authz.NotArchived(); err != nil {
+			return err
+		}
+		destAuthz, err := NewProjectAuthz(ctx, tx, authz.Actor(), in.ToProjectID)
+		if err != nil {
+			return err
+		}
+		if err := destAuthz.CanManageMembers(); err != nil {
+			return err
+		}
+		if destAuthz.ProjectID() == authz.ProjectID() {
+			return deny(ErrInvalid, "target project must differ from the current project")
+		}
+		if err := destAuthz.NotArchived(); err != nil {
+			return err
+		}
+		if err := agg.toward(ctx, tx, destAuthz.ProjectID()); err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		m, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
+
