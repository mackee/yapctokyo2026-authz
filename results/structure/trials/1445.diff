+// CanManageMembers returns nil if the actor may add or remove members of the
+// project: managers only (else ErrForbidden). Archived is checked separately by
+// NotArchived, so callers can order the checks.
+func (a ProjectAuthz) CanManageMembers() error {
+	if !a.CanRead() || a.role != RoleManager {
+		return deny(ErrForbidden, "only managers may manage members")
+	}
+	return nil
+}
+
+// NotArchived returns nil if the project accepts writes (else ErrArchived).
+func (a ProjectAuthz) NotArchived() error {
+	if a.archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	return nil
+}
