+// setMemberRoleAggregate changes the role of one project member.
+type setMemberRoleAggregate struct {
+	membership *Membership
+	role       string
+	assigned   []*Task // the member's tasks in the project
+}
+
+func loadSetMemberRole(ctx context.Context, tx DB, projectID, userID, role string) (*setMemberRoleAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	assigned, err := m.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &setMemberRoleAggregate{membership: m, role: role, assigned: assigned}, nil
+}
+
+func (a *setMemberRoleAggregate) validate() error {
+	if !isRole(a.role) {
+		return deny(ErrInvalid, "invalid role")
+	}
+	if !isWriterRole(a.role) && len(a.assigned) > 0 {
+		return deny(ErrInvalid, "member still has assigned tasks; reassign them before making the member a viewer")
+	}
+	return nil
+}
+
+func (a *setMemberRoleAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.membership.setRole(ctx, tx, a.role); err != nil {
+		return nil, err
+	}
+	return a.membership, nil
+}
+
