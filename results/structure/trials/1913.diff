 // NewUserTable returns the users table.
 func NewUserTable() *UserTable { return &UserTable{} }
 
+// OrgExists reports whether the organization has any user or project.
+func (*UserTable) OrgExists(ctx context.Context, db DB, org string) (bool, error) {
+	var n int
+	if err := db.QueryRowContext(ctx,
+		`SELECT (SELECT COUNT(*) FROM users WHERE org_id = ?) + (SELECT COUNT(*) FROM projects WHERE org_id = ?)`,
+		org, org).Scan(&n); err != nil {
+		return false, err
+	}
+	return n > 0, nil
+}
+
+// UserTableTransferInput is the input of UserTable.Transfer.
+type UserTableTransferInput struct {
+	UserID  string
+	ToOrgID string
+}
+
+// Transfer moves a user of the authorization object's organization to another
+// organization. The user leaves every project of the old organization (their
+// memberships are removed and their tasks unassigned) and loses org admin
+// rights. It is all or nothing.
+func (*UserTable) Transfer(ctx context.Context, db DB, authz OrgAuthz, in UserTableTransferInput) (*User, error) {
+	if err := authz.CanTransfer(); err != nil {
+		return nil, err
+	}
+	if in.ToOrgID == "" {
+		return nil, deny(ErrInvalid, "destination organization must not be empty")
+	}
+	var u *User
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadTransferUser(ctx, tx, authz.OrgID(), in)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		u, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return u, nil
+}
