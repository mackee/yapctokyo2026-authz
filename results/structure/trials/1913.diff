+// moveTo makes the user a plain member of another organization. Org admin
+// rights belong to the old organization and are not carried over.
+func (r *User) moveTo(ctx context.Context, db DB, org string) error {
+	r.Org = org
+	r.OrgAdmin = false
+	return r.save(ctx, db)
+}
