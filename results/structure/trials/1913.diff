diff --git a/transfer_test.go b/transfer_test.go
new file mode 100644
index 0000000..553ecb7
--- /dev/null
+++ b/transfer_test.go
@@ -0,0 +1,110 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+const transferGlobex = `{"toOrgId":"globex"}`
+
+func TestTransfer(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin transfers", "eve", "/orgs/acme/users/hal/transfer", transferGlobex, 200},
+		{"user with memberships and tasks", "eve", "/orgs/acme/users/ben/transfer", transferGlobex, 200},
+		{"project manager is not org admin", "ann", "/orgs/acme/users/hal/transfer", transferGlobex, 403},
+		{"plain user", "ben", "/orgs/acme/users/hal/transfer", transferGlobex, 403},
+		{"anonymous", "", "/orgs/acme/users/hal/transfer", transferGlobex, 401},
+		{"unknown caller", "zed", "/orgs/acme/users/hal/transfer", transferGlobex, 401},
+		{"caller from another org", "gus", "/orgs/acme/users/hal/transfer", transferGlobex, 404},
+		{"user not in the org", "eve", "/orgs/acme/users/gus/transfer", transferGlobex, 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed/transfer", transferGlobex, 404},
+		{"unknown org in path", "eve", "/orgs/nope/users/hal/transfer", transferGlobex, 404},
+		{"unknown destination org", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"nope"}`, 400},
+		{"same org", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"acme"}`, 400},
+		{"missing toOrgId", "eve", "/orgs/acme/users/hal/transfer", `{}`, 400},
+		{"malformed body wins over auth", "ben", "/orgs/acme/users/hal/transfer", `{`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/hal/transfer", "eve", transferGlobex)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 2 || got["id"] != "hal" || got["orgId"] != "globex" {
+		t.Fatalf("unexpected body %s", body)
+	}
+}
+
+// The user really changes organization: the old org no longer sees them, and
+// they can now be authenticated into globex's scope.
+func TestTransferChangesOrg(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/orgs/acme/users/hal/transfer", "eve", transferGlobex); code != 200 {
+		t.Fatal(code)
+	}
+	if code, _ := do(t, h, "POST", "/orgs/acme/users/hal/transfer", "eve", transferGlobex); code != 404 {
+		t.Fatalf("hal should no longer be in acme, got %d", code)
+	}
+}
+
+// Moving a user must not leave project memberships or task assignments behind
+// in the old organization (the model rules are checked by do() as well).
+func TestTransferDropsOldOrgAccess(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", transferGlobex); code != 200 {
+		t.Fatal(code)
+	}
+	// ben lost access to acme projects.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben still reads web: %d", code)
+	}
+	// ben's tasks (t1 in web, t5 in legacy) are unassigned, not deleted.
+	for _, id := range []string{"/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		code, body := do(t, h, "GET", id, "ann", "")
+		if code != 200 {
+			t.Fatalf("%s: %d", id, code)
+		}
+		var task Task
+		json.Unmarshal([]byte(body), &task)
+		if task.AssigneeID != "" {
+			t.Fatalf("%s still assigned to %q", id, task.AssigneeID)
+		}
+	}
+	// others' assignments are untouched.
+	_, body := do(t, h, "GET", "/projects/web/tasks/t2", "ann", "")
+	var t2 Task
+	json.Unmarshal([]byte(body), &t2)
+	if t2.AssigneeID != "cat" {
+		t.Fatalf("t2 assignee changed to %q", t2.AssigneeID)
+	}
+}
+
+// Org admin rights belong to the old organization and do not carry over.
+func TestTransferResetsOrgAdmin(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/orgs/acme/users/eve/transfer", "eve", transferGlobex); code != 200 {
+		t.Fatal(code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "eve", ""); code != 404 {
+		t.Fatalf("eve became a globex org admin: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "eve", ""); code != 404 {
+		t.Fatalf("eve still reads acme: %d", code)
+	}
+}
