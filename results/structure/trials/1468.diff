index 0000000..d1650bb
--- /dev/null
+++ b/freeze_test.go
@@ -0,0 +1,136 @@
+package main
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"manager ivy", "ivy", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"unknown project", "ann", "nope", 404},
+		{"archived", "ann", "legacy", 409},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	want := `[{"userId":"ann","role":"viewer"},{"userId":"ben","role":"viewer"},` +
+		`{"userId":"cat","role":"viewer"},{"userId":"dan","role":"viewer"},{"userId":"ivy","role":"viewer"}]`
+	if got := strings.TrimSpace(body); got != want {
+		t.Fatalf("got\n%s\nwant\n%s", got, want)
+	}
+}
+
+func TestFreezeOnlyAffectsThatProject(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d: %s", code, body)
+	}
+	// cat is a contributor in ops, which is not frozen, so she can still write there.
+	if code, body := do(t, h, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ops write: got %d: %s", code, body)
+	}
+	// ann is still a viewer in ops, so she still cannot write there.
+	if code, _ := do(t, h, "PATCH", "/projects/ops/tasks/t4", "ann", `{"status":"open"}`); code != 403 {
+		t.Fatalf("ops viewer write: got %d want 403", code)
+	}
+}
+
+func TestFreezeAgainIsRefusedAndReadsStillWork(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d: %s", code, body)
+	}
+	// Every manager was demoted by the first freeze, so no one can freeze again.
+	for _, user := range []string{"ann", "ivy"} {
+		if code, _ := do(t, h, "POST", "/projects/web/freeze", user, ""); code != 403 {
+			t.Fatalf("second freeze by %s: got %d want 403", user, code)
+		}
+	}
+	code, body := do(t, h, "GET", "/projects/web/tasks", "dan", "")
+	if code != 200 || !strings.Contains(body, `"id":"t1"`) {
+		t.Fatalf("read after freeze: got %d: %s", code, body)
+	}
+}
+
+func TestFrozenProjectRejectsWrites(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d: %s", code, body)
+	}
+	cases := []struct {
+		name, method, user, path, body string
+		want                           int
+	}{
+		{"create by former manager", "POST", "ann", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"create by former contributor", "POST", "ben", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"update own by former contributor", "PATCH", "ben", "/projects/web/tasks/t1", `{"status":"done"}`, 403},
+		{"update by former manager", "PATCH", "ann", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"delete by former manager", "DELETE", "ann", "/projects/web/tasks/t1", "", 403},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, h, c.method, c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+	// Tasks keep their data and assignments.
+	_, body := do(t, h, "GET", "/projects/web/tasks/t1", "dan", "")
+	if !strings.Contains(body, `"status":"open"`) || !strings.Contains(body, `"assignee":"ben"`) {
+		t.Fatalf("t1 changed by a frozen project's write: %s", body)
+	}
+}
+
+// Freezing is what demotes members, so the frozen check must hold even if a
+// member's role were restored some other way. Restore ann's manager role directly
+// in the database and check that writes are still refused with 409.
+func TestFrozenCheckHoldsIfRoleIsRestored(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d: %s", code, body)
+	}
+	app := h.(*appHandler)
+	if _, err := app.db.Exec(`UPDATE memberships SET role = 'manager' WHERE project_id = 'web' AND user_id = 'ann'`); err != nil {
+		t.Fatal(err)
+	}
+	for _, c := range []struct{ method, path, body string }{
+		{"POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"DELETE", "/projects/web/tasks/t1", ""},
+	} {
+		req := httptest.NewRequest(c.method, c.path, strings.NewReader(c.body))
+		req.Header.Set("X-User", "ann")
+		w := httptest.NewRecorder()
+		h.ServeHTTP(w, req)
+		if w.Code != http.StatusConflict || !strings.Contains(w.Body.String(), "project is frozen") {
+			t.Fatalf("%s %s: got %d %s, want 409 project is frozen", c.method, c.path, w.Code, w.Body.String())
+		}
+	}
+}
