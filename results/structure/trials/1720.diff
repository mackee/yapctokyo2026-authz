+func TestSetRoles(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager changes", "ann", "web", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 200},
+		{"same role is fine", "ann", "web", `{"roles":{"ben":"contributor"}}`, 200},
+		{"one demotion of two managers", "ann", "web", `{"roles":{"ivy":"viewer"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"missing project", "ann", "nope", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"invalid role", "ann", "web", `{"roles":{"ben":"owner"}}`, 400},
+		{"empty role", "ann", "web", `{"roles":{"ben":""}}`, 400},
+		{"non member target", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"other org target", "ann", "web", `{"roles":{"gus":"viewer"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"bad json", "ann", "web", `nope`, 400},
+		{"demote every manager", "ann", "web", `{"roles":{"ann":"viewer","ivy":"contributor"}}`, 409},
+		{"demote sole manager", "ivy", "ops", `{"roles":{"ivy":"viewer"}}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetRolesResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var members []struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &members); err != nil {
+		t.Fatal(err)
+	}
+	got := map[string]string{}
+	for _, m := range members {
+		got[m.UserID] = m.Role
+	}
+	want := map[string]string{"ann": "manager", "ben": "viewer", "cat": "contributor", "dan": "contributor", "ivy": "manager"}
+	if len(members) != len(want) || len(got) != len(want) {
+		t.Fatalf("want %d members, got %s", len(want), body)
+	}
+	for u, r := range want {
+		if got[u] != r {
+			t.Fatalf("%s: got %q want %q (%s)", u, got[u], r, body)
+		}
+	}
+}
+
+func TestSetRolesTakesEffect(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`); code != 200 {
+		t.Fatal(code, body)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Fatalf("demoted ben: got %d want 403", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("promoted dan: got %d want 200", code)
+	}
+}
+
+func TestSetRolesIsAtomic(t *testing.T) {
+	// Each body mixes a valid change (ben) with one that must fail:
+	// a non-member, an invalid role, and demoting every manager.
+	bodies := []string{
+		`{"roles":{"ben":"viewer","hal":"viewer"}}`,
+		`{"roles":{"ben":"viewer","dan":"owner"}}`,
+		`{"roles":{"ben":"viewer","ann":"viewer","ivy":"viewer"}}`,
+	}
+	for _, b := range bodies {
+		h := newServer()
+		if code, _ := do(t, h, "PUT", "/projects/web/members", "ann", b); code < 400 {
+			t.Fatalf("%s: got %d, want an error", b, code)
+		}
+		// ben must still be a contributor, ann still a manager.
+		if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 200 {
+			t.Fatalf("%s: ben changed despite failure (got %d)", b, code)
+		}
+		if code, _ := do(t, h, "DELETE", "/projects/web/tasks/t1", "ann", ""); code != 204 {
+			t.Fatalf("%s: ann changed despite failure (got %d)", b, code)
+		}
+	}
+}
