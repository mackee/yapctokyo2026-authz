+func TestMoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, project, uid, body string
+		want                           int
+	}{
+		{"manager of both", "ivy", "web", "dan", `{"toProjectId":"ops"}`, 200},
+		{"manager of source only", "ann", "web", "dan", `{"toProjectId":"ops"}`, 403},
+		{"contributor of both", "cat", "web", "dan", `{"toProjectId":"ops"}`, 403},
+		{"contributor, destination unreadable", "ben", "web", "dan", `{"toProjectId":"ops"}`, 404},
+		{"org admin", "eve", "web", "dan", `{"toProjectId":"ops"}`, 403},
+		{"non member actor", "hal", "web", "dan", `{"toProjectId":"ops"}`, 404},
+		{"user not in source", "ivy", "web", "hal", `{"toProjectId":"ops"}`, 404},
+		{"already in destination", "ivy", "web", "cat", `{"toProjectId":"ops"}`, 400},
+		{"same project", "ivy", "web", "dan", `{"toProjectId":"web"}`, 400},
+		{"unknown destination", "ivy", "web", "dan", `{"toProjectId":"nope"}`, 404},
+		{"other org destination", "ivy", "web", "dan", `{"toProjectId":"gx"}`, 404},
+		{"archived source", "ann", "legacy", "ben", `{"toProjectId":"web"}`, 409},
+		{"archived destination", "ann", "web", "ben", `{"toProjectId":"legacy"}`, 409},
+		{"missing destination", "ivy", "web", "dan", `{}`, 400},
+		{"anonymous", "", "web", "dan", `{"toProjectId":"ops"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/members/"+c.uid+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveMemberEffects(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]string{"userId": "ben", "projectId": "ops", "role": "contributor"}
+	if len(got) != len(want) || got["userId"] != want["userId"] || got["projectId"] != want["projectId"] || got["role"] != want["role"] {
+		t.Fatalf("got %v want %v", got, want)
+	}
+
+	// ben is no longer a member of web (404), but is one of ops.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben still reads web: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben cannot read ops: %d", code)
+	}
+	// ben's task in web was unassigned, since he left the project.
+	_, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "" {
+		t.Fatalf("t1 still assigned to %q", task.AssigneeID)
+	}
+	// Moving again fails: ben is no longer in web.
+	if code, _ := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`); code != 404 {
+		t.Fatalf("second move: %d", code)
+	}
+}
+
+func TestMoveMemberFailureChangesNothing(t *testing.T) {
+	h := newServer()
+	// cat is already in ops: rejected, and cat stays in web with t2.
+	if code, _ := do(t, h, "POST", "/projects/web/members/cat/move", "ivy", `{"toProjectId":"ops"}`); code != 400 {
+		t.Fatal(code)
+	}
+	_, body := do(t, h, "GET", "/projects/web/tasks/t2", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.AssigneeID != "cat" {
+		t.Fatalf("t2 assignee changed to %q", task.AssigneeID)
+	}
+}
