+// moveMemberAggregate moves one member from one project to another with the
+// same role. Tasks assigned to the member in the source project are unassigned,
+// since an assignee must be a member of the task's project.
+type moveMemberAggregate struct {
+	from  *Membership
+	user  *User
+	to    *Project
+	tasks []*Task // tasks of the source project assigned to the member
+}
+
+func loadMoveMember(ctx context.Context, tx DB, fromProjectID, userID, toProjectID string) (*moveMemberAggregate, error) {
+	from, err := NewMembershipTable().Find(ctx, tx, fromProjectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	u, err := from.User(ctx, tx)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	to, err := NewProjectTable().Find(ctx, tx, toProjectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveMemberAggregate{from: from, user: u, to: to}
+	if _, err := to.Membership(ctx, tx, userID); err == nil {
+		return nil, deny(ErrInvalid, "user is already a member of the destination project")
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	if a.tasks, err = from.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.from.ProjectID == a.to.ID {
+		return deny(ErrInvalid, "destination must be a different project")
+	}
+	if a.user.Org != a.to.Org {
+		return deny(ErrInvalid, "project members must belong to the project's organization")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.from.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	m := a.from.moveTo(a.to)
+	if err := m.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
