+// RemoveFromOrg takes the user out of every project of the organization
+// (offboarding). The user's memberships there are deleted, and the tasks they
+// were assigned in those projects are unassigned. The user row stays. Only org
+// admins may do it (else ErrForbidden); a user outside the organization is
+// ErrNotFound.
+func (*UserTable) RemoveFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanManageMembers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveOrgUser(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
