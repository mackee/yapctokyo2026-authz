diff --git a/org_users_test.go b/org_users_test.go
new file mode 100644
index 0000000..ddcf259
--- /dev/null
+++ b/org_users_test.go
@@ -0,0 +1,110 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+// DELETE /orgs/{orgID}/users/{uid} takes a user out of every project of the
+// organization (offboarding) and returns 204. Only org admins of that
+// organization may do it.
+
+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes manager", "eve", "/orgs/acme/users/ivy", 204},
+		{"user with no memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"member is not an org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"viewer is not an org admin", "dan", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"caller of another org", "gus", "/orgs/acme/users/ben", 404},
+		{"org admin, other org", "eve", "/orgs/globex/users/ben", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ben", 404},
+		{"user of another org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserRemovesFromEveryProject(t *testing.T) {
+	h := newServer()
+	code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", "")
+	if code != 204 {
+		t.Fatalf("got %d want 204", code)
+	}
+
+	// ben is out of every project of acme, the archived one included. The
+	// user still authenticates, so the answer is 404 (not readable), not 401.
+	for _, p := range []string{"web", "ops", "legacy"} {
+		code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ben", "")
+		if code != 404 {
+			t.Fatalf("ben in %s: got %d want 404", p, code)
+		}
+	}
+
+	// Tasks ben was assigned to are unassigned, not left pointing at a non-member.
+	for _, path := range []string{"/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		code, body := do(t, h, "GET", path, "eve", "")
+		if code != 200 {
+			t.Fatalf("%s: got %d want 200", path, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.AssigneeID != "" {
+			t.Fatalf("%s: still assigned to %q", path, task.AssigneeID)
+		}
+	}
+
+	// Other members keep their memberships and their assigned tasks.
+	code, body := do(t, h, "GET", "/projects/web/tasks/t2", "cat", "")
+	if code != 200 {
+		t.Fatalf("cat t2: got %d want 200", code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "cat" {
+		t.Fatalf("cat t2: assignee %q want cat", task.AssigneeID)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat in ops: got %d want 200", code)
+	}
+}
+
+func TestRemoveOrgUserAgainIsNoOp(t *testing.T) {
+	h := newServer()
+	for i := 0; i < 2; i++ {
+		code, _ := do(t, h, "DELETE", "/orgs/acme/users/ivy", "eve", "")
+		if code != 204 {
+			t.Fatalf("call %d: got %d want 204", i+1, code)
+		}
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ivy", ""); code != 404 {
+		t.Fatalf("ivy in web: got %d want 404", code)
+	}
+}
+
+func TestRemoveOrgUserLeavesOtherOrgAlone(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("got %d want 204", code)
+	}
+	// gus is in globex and keeps access to globex's project.
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatalf("gus in gx: got %d want 200", code)
+	}
+}
