+func putMember(t *testing.T, h http.Handler, user, project, uid, body string) (int, string) {
+	t.Helper()
+	return do(t, h, "PUT", "/projects/"+project+"/members/"+uid, user, body)
+}
+
+func TestUpdateMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, project, uid, body string
+		want                           int
+	}{
+		{"manager promotes", "ann", "web", "dan", `{"role":"contributor"}`, 200},
+		{"manager demotes", "ann", "web", "ivy", `{"role":"viewer"}`, 200},
+		{"manager same role", "ann", "web", "ben", `{"role":"contributor"}`, 200},
+		{"contributor", "ben", "web", "cat", `{"role":"viewer"}`, 403},
+		{"viewer", "dan", "web", "cat", `{"role":"viewer"}`, 403},
+		{"org admin non member", "eve", "web", "cat", `{"role":"viewer"}`, 403},
+		{"non member", "hal", "web", "cat", `{"role":"viewer"}`, 404},
+		{"other org", "gus", "web", "cat", `{"role":"viewer"}`, 404},
+		{"anonymous", "", "web", "cat", `{"role":"viewer"}`, 401},
+		{"unknown user", "zed", "web", "cat", `{"role":"viewer"}`, 401},
+		{"archived", "ann", "legacy", "ben", `{"role":"viewer"}`, 409},
+		{"invalid role", "ann", "web", "ben", `{"role":"owner"}`, 400},
+		{"empty role", "ann", "web", "ben", `{"role":""}`, 400},
+		{"bad body", "ann", "web", "ben", `nope`, 400},
+		{"target not a member", "ann", "web", "hal", `{"role":"viewer"}`, 404},
+		{"target in other project only", "ivy", "ops", "ben", `{"role":"viewer"}`, 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := putMember(t, newServer(), c.user, c.project, c.uid, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRoleResponse(t *testing.T) {
+	h := newServer()
+	code, body := putMember(t, h, "ann", "web", "dan", `{"role":"viewer"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+	if body != "{\"userId\":\"dan\",\"role\":\"viewer\"}\n" {
+		t.Fatalf("unexpected body %q", body)
+	}
+}
+
+func TestUpdateMemberRolePersists(t *testing.T) {
+	h := newServer()
+
+	// Demote ben (contributor -> viewer): his own task edit must now be refused.
+	if code, _ := putMember(t, h, "ann", "web", "ben", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 403 {
+		t.Fatalf("demoted user patch: got %d want 403", code)
+	}
+
+	// Promote dan (viewer -> contributor): he can now create tasks.
+	if code, _ := putMember(t, h, "ann", "web", "dan", `{"role":"contributor"}`); code != 200 {
+		t.Fatalf("promote: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("promoted user create: got %d want 200", code)
+	}
+
+	// A demoted manager loses the ability to change roles.
+	if code, _ := putMember(t, h, "ivy", "web", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("manager demotes manager: got %d want 200", code)
+	}
+	if code, _ := putMember(t, h, "ann", "web", "ben", `{"role":"contributor"}`); code != 403 {
+		t.Fatalf("demoted manager: got %d want 403", code)
+	}
+}
