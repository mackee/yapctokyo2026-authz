 // NewMembershipTable returns the memberships table.
 func NewMembershipTable() *MembershipTable { return &MembershipTable{} }
 
+// ---- operations -----------------------------------------------------------------------
+
+// MembershipTableUpdateInput is the input of MembershipTable.Update.
+type MembershipTableUpdateInput struct {
+	Role string
+}
+
+var validRoles = map[string]bool{RoleManager: true, RoleContributor: true, RoleViewer: true}
+
+// Update changes the role of one member of the project, all or nothing. A
+// member who is not in the project is 404; only managers may change roles.
+func (*MembershipTable) Update(ctx context.Context, db DB, authz ProjectAuthz, userID string, in MembershipTableUpdateInput) (*Membership, error) {
+	if !validRoles[in.Role] {
+		return nil, deny(ErrInvalid, "role must be manager, contributor or viewer")
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadUpdateMembership(ctx, tx, authz.ProjectID(), userID, in.Role)
+		if err != nil {
+			return err
+		}
+		if err := authz.CanChangeRoles(); err != nil {
+			return err
+		}
+		if err := agg.validate(ctx, tx); err != nil {
+			return err
+		}
+		m, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
+
