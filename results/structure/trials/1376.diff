+// CanChangeRoles returns nil if the actor may change the roles of the project's
+// members: managers only (else ErrForbidden) and not archived (else ErrArchived).
+func (a ProjectAuthz) CanChangeRoles() error {
+	if !a.CanRead() || a.role != RoleManager {
+		return deny(ErrForbidden, "only managers may change member roles")
+	}
+	if a.archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	return nil
+}
