+
+// updateMembershipAggregate changes the role of one member of one project.
+type updateMembershipAggregate struct {
+	member *Membership
+	role   string
+}
+
+func loadUpdateMembership(ctx context.Context, tx DB, projectID, userID, role string) (*updateMembershipAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	return &updateMembershipAggregate{member: m, role: role}, nil
+}
+
+// validate rejects a role that is not a writer role while the member is the
+// assignee of a task in the project: an assignee is a contributor or manager.
+func (a *updateMembershipAggregate) validate(ctx context.Context, tx DB) error {
+	if isWriterRole(a.role) {
+		return nil
+	}
+	tasks, err := a.member.AssignedTasks(ctx, tx)
+	if err != nil {
+		return err
+	}
+	if len(tasks) > 0 {
+		return deny(ErrInvalid, "a task assignee must remain a contributor or manager of the project")
+	}
+	return nil
+}
+
+func (a *updateMembershipAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.member.setRole(ctx, tx, a.role); err != nil {
+		return nil, err
+	}
+	return a.member, nil
+}
