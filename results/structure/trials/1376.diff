+func TestUpdateMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, project, target, body string
+		want                              int
+	}{
+		{"manager promotes viewer", "ann", "web", "dan", `{"role":"contributor"}`, 200},
+		{"manager demotes unassigned member", "ann", "web", "ivy", `{"role":"viewer"}`, 200},
+		{"manager sets same role", "ann", "web", "ben", `{"role":"contributor"}`, 200},
+		{"manager demotes assignee", "ann", "web", "ben", `{"role":"viewer"}`, 400},
+		{"manager demotes assignee in archived", "ann", "legacy", "ben", `{"role":"viewer"}`, 409},
+		{"contributor", "ben", "web", "dan", `{"role":"contributor"}`, 403},
+		{"viewer", "dan", "web", "ben", `{"role":"viewer"}`, 403},
+		{"org admin", "eve", "web", "dan", `{"role":"contributor"}`, 403},
+		{"non member actor", "hal", "web", "dan", `{"role":"contributor"}`, 404},
+		{"other org actor", "gus", "web", "dan", `{"role":"contributor"}`, 404},
+		{"target not a member", "ann", "web", "hal", `{"role":"viewer"}`, 404},
+		{"target member of another project", "ann", "ops", "ben", `{"role":"viewer"}`, 404},
+		{"unknown role", "ann", "web", "dan", `{"role":"owner"}`, 400},
+		{"missing role", "ann", "web", "dan", `{}`, 400},
+		{"unknown actor", "zed", "web", "dan", `{"role":"contributor"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members/"+c.target, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRoleBody(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+	var got MemberRole
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got != (MemberRole{UserID: "dan", Role: "contributor"}) {
+		t.Fatalf("got %+v", got)
+	}
+}
+
+func TestUpdateMemberRoleTakesEffect(t *testing.T) {
+	h := newServer()
+
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 403 {
+		t.Fatalf("viewer create: got %d want 403", code)
+	}
+	if code, _ := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`); code != 200 {
+		t.Fatalf("promote: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("promoted create: got %d want 200", code)
+	}
+
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ivy", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ivy", `{"title":"x"}`); code != 403 {
+		t.Fatalf("demoted create: got %d want 403", code)
+	}
+
+	// ben is assigned t1; the rejected demotion leaves the role and the task alone.
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 400 {
+		t.Fatalf("demote assignee: got %d want 400", code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 200 {
+		t.Fatalf("assignee still writes: got %d want 200", code)
+	}
+}
