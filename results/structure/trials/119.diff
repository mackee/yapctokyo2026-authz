+// ManageProject is the manager-only capability for one project's membership.
+type ManageProject interface {
+	ReadProject
+	// RemoveMember removes userID from the project. Tasks assigned to that user
+	// become unassigned in the same commit. A user who is not a member of this
+	// project is 404.
+	RemoveMember(userID string) error
+}
+
+// Manage applies the manager rule: readable, manager (else 403), not archived
+// (else 409).
+func (s *projectScope) Manage() (ManageProject, error) {
+	err := s.as.a.st.read(func(st *state) error {
+		p, r, err := readable(st, s.as.actor, s.pid)
+		if err != nil {
+			return err
+		}
+		if r != RoleManager {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if p.archived {
+			return deny(ErrArchived, "project is archived")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &manageProject{readProject: readProject{ps: s}}, nil
+}
+
+type manageProject struct {
+	readProject
+}
+
+func (p *manageProject) RemoveMember(userID string) error {
+	return p.ps.as.a.st.tx(func(s *state) error {
+		members := s.members[p.ps.pid]
+		if _, ok := members[userID]; !ok {
+			return deny(ErrNotFound, "not found")
+		}
+		delete(members, userID)
+		// Tasks may only hold assignees who are members of the project, so the
+		// removed user's tasks are unassigned in the same commit.
+		for tid, t := range s.tasks {
+			if t.project == p.ps.pid && t.assignee.user == userID {
+				t.assignee = Assignee{project: p.ps.pid}
+				s.tasks[tid] = t
+			}
+		}
+		return nil
+	})
+}
