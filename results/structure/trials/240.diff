+// MoveMember removes userID from fromProject and adds them to toProject with
+// the given role. Tasks in fromProject assigned to the user are unassigned so
+// no task keeps a non-member assignee.
+func (s *Store) MoveMember(fromProject, toProject, userID, role string) {
+	delete(s.members[fromProject], userID)
+	if s.members[toProject] == nil {
+		s.members[toProject] = map[string]string{}
+	}
+	s.members[toProject][userID] = role
+	for _, t := range s.tasks {
+		if t.ProjectID == fromProject && t.Assignee == userID {
+			t.Assignee = ""
+		}
+	}
+}
