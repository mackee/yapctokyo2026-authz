@@ -121,6 +121,29 @@ func (a TaskAuthz) CanManage() error {
 	return nil
 }
 
+// CanMove returns nil if the actor may move the task to the dest project.
+// The actor must be a contributor or manager in both projects (else
+// ErrForbidden). A manager in both may move any task; anyone else only a task
+// assigned to them (else ErrForbidden). Archived source or destination is
+// ErrArchived. Moving a task to its own project is ErrInvalid. Call it after
+// the destination's ProjectAuthz has been built.
+func (a TaskAuthz) CanMove(dest ProjectAuthz) error {
+	if !a.CanRead() || !dest.CanRead() || !isWriterRole(a.project.role) || !isWriterRole(dest.role) {
+		return deny(ErrForbidden, "forbidden")
+	}
+	bothManagers := a.project.role == RoleManager && dest.role == RoleManager
+	if !bothManagers && !a.isAssignee {
+		return deny(ErrForbidden, "only managers in both projects may move tasks not assigned to them")
+	}
+	if a.project.archived || dest.archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	if dest.project == a.project.project {
+		return deny(ErrInvalid, "task is already in that project")
+	}
+	return nil
+}
