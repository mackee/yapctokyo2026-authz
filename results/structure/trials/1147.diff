+++ b/org_users_test.go
@@ -0,0 +1,110 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestRemoveOrgUserAccess(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes user without memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"manager is not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"viewer is not org admin", "dan", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"caller in other org", "gus", "/orgs/acme/users/ben", 404},
+		{"path org is not caller org", "eve", "/orgs/globex/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserRemovesAllOrgMemberships(t *testing.T) {
+	h := newServer()
+
+	// ivy is a manager of web and ops (both acme), so she can see both before.
+	for _, p := range []string{"web", "ops"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ivy", ""); code != 200 {
+			t.Fatalf("before: ivy read %s got %d", p, code)
+		}
+	}
+
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ivy", "eve", ""); code != 204 {
+		t.Fatalf("remove ivy got %d want 204", code)
+	}
+
+	// Membership is gone in every acme project: reads and writes are 404 (not admin).
+	for _, p := range []string{"web", "ops"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ivy", ""); code != 404 {
+			t.Fatalf("after: ivy read %s got %d want 404", p, code)
+		}
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ivy", `{"title":"x"}`); code != 404 {
+		t.Fatalf("after: ivy create in web got %d want 404", code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t2", "ivy", `{"status":"done"}`); code != 404 {
+		t.Fatalf("after: ivy patch t2 got %d want 404", code)
+	}
+
+	// Other members and the task data are untouched.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ann", ""); code != 200 {
+		t.Fatalf("ann read web got %d want 200", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t2", "eve", ""); code != 200 {
+		t.Fatalf("eve read t2 got %d want 200", code)
+	}
+
+	// Removing again is still 204.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ivy", "eve", ""); code != 204 {
+		t.Fatalf("second remove got %d want 204", code)
+	}
+}
+
+func TestRemoveOrgUserLeavesOtherOrgAndProjectsAlone(t *testing.T) {
+	h := newServer()
+
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove ben got %d want 204", code)
+	}
+
+	// ben was a contributor of web and legacy; both are now closed to him.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben read web got %d want 404", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/legacy/tasks/t5", "ben", ""); code != 404 {
+		t.Fatalf("ben read legacy t5 got %d want 404", code)
+	}
+
+	// ben's assigned task is still there (only memberships are removed).
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t1", "eve", ""); code != 200 {
+		t.Fatalf("eve read t1 got %d want 200", code)
+	}
+
+	// ops is a project ben was never in; cat's membership there is unchanged.
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat read ops got %d want 200", code)
+	}
+
+	// The globex user is not touched by an acme removal.
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatalf("gus read gx got %d want 200", code)
+	}
+	var tasks []Task
+	_, body := do(t, h, "GET", "/projects/gx/tasks", "gus", "")
+	json.Unmarshal([]byte(body), &tasks)
+	if len(tasks) != 1 {
+		t.Fatalf("gx: want 1 task, got %d", len(tasks))
+	}
+}
