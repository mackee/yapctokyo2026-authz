+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestMoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager of both", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 200},
+		{"manager of source only", "ann", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"contributor", "cat", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer", "dan", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin", "eve", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"non member caller", "hal", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 401},
+		{"other org caller", "gus", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"missing source", "ivy", "/projects/nope/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"target not a member", "ivy", "/projects/web/members/hal/move", `{"toProjectId":"ops"}`, 404},
+		{"unknown user", "ivy", "/projects/web/members/zed/move", `{"toProjectId":"ops"}`, 404},
+		{"already in destination", "ivy", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 409},
+		{"missing destination", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"nope"}`, 404},
+		{"destination in other org", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"gx"}`, 404},
+		{"destination archived", "ann", "/projects/web/members/ben/move", `{"toProjectId":"legacy"}`, 409},
+		{"source archived", "ann", "/projects/legacy/members/ben/move", `{"toProjectId":"web"}`, 409},
+		{"same project", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"web"}`, 400},
+		{"empty destination", "ivy", "/projects/web/members/ben/move", `{"toProjectId":""}`, 400},
+		{"bad body", "ivy", "/projects/web/members/ben/move", `nope`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d (%s)", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestMoveMemberResult(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d (%s)", code, body)
+	}
+	var got struct {
+		UserID    string `json:"userId"`
+		ProjectID string `json:"projectId"`
+		Role      string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.UserID != "ben" || got.ProjectID != "ops" || got.Role != RoleContributor {
+		t.Fatalf("unexpected response %+v", got)
+	}
+
+	db := h.(*appHandler).db
+	role := func(pid string) string {
+		r, err := findRole(t.Context(), db, pid, "ben")
+		if err != nil {
+			t.Fatal(err)
+		}
+		return r
+	}
+	if r := role("web"); r != "" {
+		t.Fatalf("ben still in web as %q", r)
+	}
+	if r := role("ops"); r != RoleContributor {
+		t.Fatalf("ben in ops as %q", r)
+	}
+	// ben's task in web stays in web but is unassigned, since ben left.
+	task, err := findTask(t.Context(), db, "t1")
+	if err != nil || task == nil {
+		t.Fatalf("t1: %v %v", task, err)
+	}
+	if task.ProjectID != "web" || task.Assignee != "" {
+		t.Fatalf("t1 should stay in web unassigned, got %+v", task)
+	}
+}
+
+func TestMoveMemberKeepsRole(t *testing.T) {
+	// ann is a manager in web; ops makes her a viewer, so ivy moves a manager instead.
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/ops/members/ivy/move", "ivy", `{"toProjectId":"web"}`)
+	if code != 409 {
+		t.Fatalf("ivy is already in web: got %d (%s)", code, body)
+	}
+	// dan (viewer in web) moves to ops keeping the viewer role.
+	code, body = do(t, h, "POST", "/projects/web/members/dan/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d (%s)", code, body)
+	}
+	var got struct{ Role string }
+	json.Unmarshal([]byte(body), &got)
+	if got.Role != RoleViewer {
+		t.Fatalf("role %q want viewer", got.Role)
+	}
+}
