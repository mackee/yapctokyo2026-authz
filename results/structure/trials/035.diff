+// removeUserFromOrg is the offboarding step: it removes a user from every
+// project of the org. The user record itself and any tasks assigned to them
+// are kept.
+func (s *server) removeUserFromOrg(w http.ResponseWriter, r *http.Request) {
+	s.store.mu.Lock()
+	defer s.store.mu.Unlock()
+
+	caller := s.store.User(r.Header.Get("X-User"))
+	if caller == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	orgID := r.PathValue("orgID")
+	if caller.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	if !caller.OrgAdmin {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	target := s.store.User(r.PathValue("uid"))
+	if target == nil || target.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	s.store.RemoveOrgMemberships(orgID, target.ID)
+	w.WriteHeader(204)
+}
