+// RemoveOrgMemberships removes userID from every project belonging to orgID.
+// Memberships in other organizations are left untouched.
+func (s *Store) RemoveOrgMemberships(orgID, userID string) {
+	for projectID, members := range s.members {
+		if p := s.projects[projectID]; p != nil && p.OrgID == orgID {
+			delete(members, userID)
+		}
+	}
+}
