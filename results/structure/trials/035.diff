+func TestRemoveUserFromOrg(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes viewer", "eve", "/orgs/acme/users/dan", 204},
+		{"org admin removes user with no roles", "eve", "/orgs/acme/users/hal", 204},
+		{"repeat removal is idempotent", "eve", "/orgs/acme/users/ivy", 204},
+		{"non-admin member of org", "ann", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"caller from other org", "gus", "/orgs/acme/users/ben", 404},
+		{"org admin, path org is other org", "eve", "/orgs/globex/users/gus", 404},
+		{"unknown org", "eve", "/orgs/initech/users/ben", 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed", 404},
+		{"user from other org", "eve", "/orgs/acme/users/gus", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveUserFromOrgDropsAllOrgMemberships(t *testing.T) {
+	h := newServer()
+
+	// Before: ben can read web and legacy (archived), and cat can read ops.
+	for _, p := range []string{"/projects/web/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, h, "GET", p, "ben", ""); code != 200 {
+			t.Fatalf("before: ben GET %s got %d want 200", p, code)
+		}
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "cat", ""); code != 200 {
+		t.Fatalf("before: cat GET ops got %d want 200", code)
+	}
+
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("delete got %d want 204", code)
+	}
+
+	// After: ben is a non-member of every acme project, including archived legacy.
+	for _, p := range []string{"/projects/web/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, h, "GET", p, "ben", ""); code != 404 {
+			t.Fatalf("after: ben GET %s got %d want 404", p, code)
+		}
+	}
+	// Writes by ben are also refused now that the role is gone.
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 404 {
+		t.Fatalf("after: ben PATCH got %d want 404", code)
+	}
+	// Other members are unaffected.
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "cat", ""); code != 200 {
+		t.Fatalf("after: cat GET ops got %d want 200", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ann", ""); code != 200 {
+		t.Fatalf("after: ann GET web got %d want 200", code)
+	}
+	// The user's tasks are kept; only membership is removed.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t1", "ann", ""); code != 200 {
+		t.Fatalf("after: t1 GET got %d want 200", code)
+	}
+}
+
+func TestRemoveUserFromOrgLeavesOtherOrgsAlone(t *testing.T) {
+	h := newServer()
+	// gus belongs to globex; removing him via acme's path must not touch gx.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/gus", "eve", ""); code != 404 {
+		t.Fatalf("got %d want 404", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatalf("gus lost gx membership: got %d want 200", code)
+	}
+}
