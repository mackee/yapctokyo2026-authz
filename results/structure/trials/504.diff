+// Freeze makes every member of the project a viewer, so nobody can change its
+// tasks any more. Only managers may freeze (else ErrForbidden), and archived
+// projects reject it (ErrArchived). It returns the members after the change,
+// ordered by user ID. All changes happen in one transaction.
+func (*ProjectTable) Freeze(ctx context.Context, db DB, authz ProjectAuthz) ([]*Membership, error) {
+	if err := authz.CanFreeze(); err != nil {
+		return nil, err
+	}
+	var members []*Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadFreezeProject(ctx, tx, authz.ProjectID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		members, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return members, nil
+}
