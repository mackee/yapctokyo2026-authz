+// Transfer moves the user from the authz's organization to the organization
+// toOrgID. The user must be in that organization (else ErrNotFound); the
+// target must exist and differ from it (else ErrInvalid). The user keeps no
+// org admin rights in the target organization. The transfer runs in a
+// transaction (see transferUserAggregate).
+func (*UserTable) Transfer(ctx context.Context, db DB, authz OrgAuthz, userID, toOrgID string) (*User, error) {
+	if err := authz.CanManageUsers(); err != nil {
+		return nil, err
+	}
+	var u *User
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadTransferUser(ctx, tx, authz.OrgID(), userID, toOrgID)
+		if err != nil {
+			return err
+		}
+		if u, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return u, nil
+}
