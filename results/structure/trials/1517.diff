+// transferUserAggregate moves one user to another organization. Project
+// memberships outside the target organization are removed, and the tasks the
+// user holds in those projects are unassigned, so the model rules still hold
+// after the move.
+type transferUserAggregate struct {
+	user    *User
+	toOrg   string
+	leaving []*Membership // the user's memberships in projects outside toOrg
+}
+
+func loadTransferUser(ctx context.Context, tx DB, fromOrg, userID, toOrg string) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != fromOrg {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if toOrg == fromOrg {
+		return nil, deny(ErrInvalid, "user is already in that organization")
+	}
+	if _, err := NewOrgTable().Find(ctx, tx, toOrg); errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "target organization does not exist")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &transferUserAggregate{user: u, toOrg: toOrg}
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, m := range ms {
+		p, err := m.Project(ctx, tx)
+		if err != nil && !errors.Is(err, ErrNoRows) {
+			return nil, err
+		}
+		// A membership whose project is missing is dropped too.
+		if err != nil || p.Org != toOrg {
+			a.leaving = append(a.leaving, m)
+		}
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	for _, m := range a.leaving {
+		held, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		for _, t := range held {
+			if err := t.unassign(ctx, tx); err != nil {
+				return nil, err
+			}
+		}
+		if err := m.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	a.user.Org = a.toOrg
+	a.user.OrgAdmin = false // org admin rights belong to the organization they were granted in
+	if err := a.user.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
+
