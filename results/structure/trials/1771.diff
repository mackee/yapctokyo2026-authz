+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager moves any task", "ivy", "/projects/web/tasks/t2/move", `{"toProjectId":"ops"}`, 200},
+		{"contributor moves own task", "cat", "/projects/web/tasks/t2/move", `{"toProjectId":"ops"}`, 200},
+		{"contributor moves others", "ben", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer", "dan", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin without role", "eve", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 403},
+		{"non member", "hal", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 404},
+		{"other org", "gus", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 401},
+		{"task in other project", "ann", "/projects/web/tasks/t4/move", `{"toProjectId":"ops"}`, 404},
+		{"archived source", "ann", "/projects/legacy/tasks/t5/move", `{"toProjectId":"ops"}`, 409},
+		{"archived destination", "ann", "/projects/web/tasks/t3/move", `{"toProjectId":"legacy"}`, 409},
+		{"destination missing", "ann", "/projects/web/tasks/t3/move", `{"toProjectId":"nope"}`, 404},
+		{"destination other org", "ann", "/projects/web/tasks/t3/move", `{"toProjectId":"gx"}`, 404},
+		{"destination read only", "ann", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 403},
+		{"assignee not writer in destination", "ivy", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 409},
+		{"same project", "ann", "/projects/web/tasks/t3/move", `{"toProjectId":"web"}`, 400},
+		{"missing destination", "ann", "/projects/web/tasks/t3/move", `{}`, 400},
+		{"invalid body", "ann", "/projects/web/tasks/t3/move", `not json`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveReturnsAndKeepsTask(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d: %s", code, body)
+	}
+	var got Task
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", Assignee: "cat"}
+	if got != want {
+		t.Fatalf("moved task = %+v, want %+v", got, want)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks/t2", "ann", ""); code != 200 {
+		t.Fatalf("GET in ops after move: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t2", "ann", ""); code != 404 {
+		t.Fatalf("GET in web after move: got %d want 404", code)
+	}
+}
