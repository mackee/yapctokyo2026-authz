 )
 
 // Aggregates: one per operation. An aggregate is built inside the transaction
@@ -126,6 +127,74 @@ func (a *updateTaskAggregate) apply(ctx context.Context, tx DB) (*Task, error) {
 	return t, nil
 }
 
+// changeRolesAggregate changes the roles of several members of one project.
+type changeRolesAggregate struct {
+	changes []roleChange // ordered by user ID
+}
+
+type roleChange struct {
+	member *Membership
+	role   string
+	tasks  []*Task // tasks of the project assigned to the member
+}
+
+func loadChangeRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*changeRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "project must exist")
+	} else if err != nil {
+		return nil, err
+	}
+	ids := make([]string, 0, len(roles))
+	for id := range roles {
+		ids = append(ids, id)
+	}
+	sort.Strings(ids)
+	a := &changeRolesAggregate{}
+	for _, id := range ids {
+		m, err := p.Membership(ctx, tx, id)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, id+" is not a member of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		tasks, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.changes = append(a.changes, roleChange{member: m, role: roles[id], tasks: tasks})
+	}
+	return a, nil
+}
+
+func (a *changeRolesAggregate) validate() error {
+	for _, c := range a.changes {
+		if !isValidRole(c.role) {
+			return deny(ErrInvalid, "invalid role for "+c.member.UserID)
+		}
+	}
+	return nil
+}
+
+// apply changes the roles. A member who is no longer a contributor or manager
+// loses the tasks assigned to them in the project (assignee rule).
+func (a *changeRolesAggregate) apply(ctx context.Context, tx DB) error {
+	for _, c := range a.changes {
+		if err := c.member.changeRole(ctx, tx, c.role); err != nil {
+			return err
+		}
+		if isWriterRole(c.role) {
+			continue
+		}
+		for _, t := range c.tasks {
+			if err := t.unassign(ctx, tx); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
