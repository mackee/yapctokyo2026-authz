diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..1e5a421
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,91 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+type member struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func TestChangeRoles(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got []member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []member{{"ann", "manager"}, {"ben", "viewer"}, {"cat", "contributor"}, {"dan", "contributor"}, {"ivy", "manager"}}
+	if len(got) != len(want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("got %v want %v", got, want)
+		}
+	}
+	// ben is no longer a writer, so t1 is unassigned.
+	_, task := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var tk Task
+	if err := json.Unmarshal([]byte(task), &tk); err != nil {
+		t.Fatal(err)
+	}
+	if tk.AssigneeID != "" {
+		t.Fatalf("t1 still assigned to %q", tk.AssigneeID)
+	}
+}
+
+func TestChangeRolesAllOrNothing(t *testing.T) {
+	h := newServer()
+	for name, body := range map[string]string{
+		"unknown member": `{"roles":{"dan":"contributor","hal":"viewer"}}`,
+		"non-member":     `{"roles":{"dan":"contributor","gus":"viewer"}}`,
+	} {
+		code, resp := do(t, h, "PUT", "/projects/web/members", "ann", body)
+		if code != 400 {
+			t.Fatalf("%s: got %d body=%s", name, code, resp)
+		}
+	}
+	// a no-op change lists the members
+	_, resp := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ann":"manager"}}`)
+	var got []member
+	if err := json.Unmarshal([]byte(resp), &got); err != nil {
+		t.Fatal(err)
+	}
+	for _, m := range got {
+		if m.UserID == "dan" && m.Role != "viewer" {
+			t.Fatalf("dan changed by a failed request: %v", got)
+		}
+	}
+}
+
+func TestChangeRolesDenied(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"contributor", "ben", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 403},
+		{"viewer", "dan", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin", "eve", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 403},
+		{"archived", "ann", "/projects/legacy/members", `{"roles":{"ben":"viewer"}}`, 409},
+		{"non-member", "hal", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 404},
+		{"other org", "gus", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 404},
+		{"unauthenticated", "", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 401},
+		{"invalid role", "ann", "/projects/web/members", `{"roles":{"dan":"boss"}}`, 400},
+		{"empty roles", "ann", "/projects/web/members", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "/projects/web/members", `{}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
