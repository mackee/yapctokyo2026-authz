+package model
+
+import "context"
+
+// OrgTable answers questions about organizations. There is no organizations
+// table: an organization exists when some user or project belongs to it.
+type OrgTable struct{}
+
+// NewOrgTable returns the organizations table.
+func NewOrgTable() *OrgTable { return &OrgTable{} }
+
+// Exists reports whether the organization has any user or project.
+func (*OrgTable) Exists(ctx context.Context, db DB, orgID string) (bool, error) {
+	var exists bool
+	if err := db.QueryRowContext(ctx,
+		`SELECT EXISTS (SELECT 1 FROM users WHERE org_id = ?) OR EXISTS (SELECT 1 FROM projects WHERE org_id = ?)`,
+		orgID, orgID).Scan(&exists); err != nil {
+		return false, err
+	}
+	return exists, nil
+}
