+// MembershipTableMoveInput is the input of MembershipTable.Move.
+type MembershipTableMoveInput struct {
+	UserID      string
+	ToProjectID string
+}
+
+// Move moves the member from the authorized project to another project, keeping
+// the role. The actor must manage both projects. The member's tasks in the
+// source project are unassigned, all or nothing.
+func (*MembershipTable) Move(ctx context.Context, db DB, authz ProjectAuthz, in MembershipTableMoveInput) (*Membership, error) {
+	if in.ToProjectID == authz.ProjectID() {
+		return nil, deny(ErrInvalid, "destination must be a different project")
+	}
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var m *Membership
+	if err := db.update(ctx, func(x *Tx) error {
+		dest, err := NewProjectAuthz(ctx, x, authz.Actor(), in.ToProjectID)
+		if err != nil {
+			return err
+		}
+		if err := dest.CanManageMembers(); err != nil {
+			return err
+		}
+		agg, err := loadMoveMember(ctx, x, authz.ProjectID(), in.UserID, in.ToProjectID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if m, err = agg.apply(ctx, x); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
