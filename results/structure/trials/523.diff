new file mode 100644
index 0000000..164f7c8
--- /dev/null
+++ b/move_member_test.go
@@ -0,0 +1,134 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestMoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager of both projects", "ivy", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 200},
+		{"manager of source only", "ann", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 403},
+		{"contributor", "ben", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer", "dan", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin without role", "eve", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"non member of source", "hal", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"other org", "gus", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"destination in other org", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"gx"}`, 404},
+		{"viewer of destination", "ann", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"destination missing", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"nope"}`, 404},
+		{"destination archived", "ann", "/projects/web/members/cat/move", `{"toProjectId":"legacy"}`, 409},
+		{"source archived", "ann", "/projects/legacy/members/ben/move", `{"toProjectId":"web"}`, 409},
+		{"user not in source", "ivy", "/projects/ops/members/ben/move", `{"toProjectId":"web"}`, 404},
+		{"unknown user", "ivy", "/projects/web/members/zed/move", `{"toProjectId":"ops"}`, 404},
+		{"already in destination", "ivy", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 409},
+		{"same project", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"web"}`, 400},
+		{"missing destination", "ivy", "/projects/web/members/ben/move", `{}`, 400},
+		{"anonymous", "", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveMemberResponseKeepsRole(t *testing.T) {
+	// dan is a viewer in web; the move keeps the viewer role.
+	code, body := do(t, newServer(), "POST", "/projects/web/members/dan/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]string{"userId": "dan", "projectId": "ops", "role": "viewer"}
+	for k, v := range want {
+		if got[k] != v {
+			t.Fatalf("%s: got %q want %q (body %s)", k, got[k], v, body)
+		}
+	}
+}
+
+func TestMoveMemberChangesMembershipAndUnassignsTasks(t *testing.T) {
+	h := newServer()
+
+	// ben is a contributor in web (assigned t1) and in legacy (assigned t5).
+	code, body := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["userId"] != "ben" || got["projectId"] != "ops" || got["role"] != "contributor" {
+		t.Fatalf("unexpected response: %s", body)
+	}
+
+	// ben is now in ops and no longer in web.
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben reading ops: got %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reading web: got %d want 404", code)
+	}
+
+	// t1 was assigned to ben in web, so it is unassigned now.
+	code, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("get t1: got %d", code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "" {
+		t.Fatalf("t1 still assigned to %q", task.AssigneeID)
+	}
+
+	// ben's membership in legacy is untouched.
+	if code, _ := do(t, h, "GET", "/projects/legacy/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben reading legacy: got %d", code)
+	}
+	code, body = do(t, h, "GET", "/projects/legacy/tasks/t5", "ben", "")
+	if code != 200 {
+		t.Fatalf("get t5: got %d", code)
+	}
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "ben" {
+		t.Fatalf("t5 assignee changed to %q", task.AssigneeID)
+	}
+}
+
+func TestMoveMemberFailureChangesNothing(t *testing.T) {
+	h := newServer()
+
+	// cat is already in ops, so the move is a conflict and must not touch web.
+	if code, _ := do(t, h, "POST", "/projects/web/members/cat/move", "ivy", `{"toProjectId":"ops"}`); code != 409 {
+		t.Fatalf("got %d want 409", code)
+	}
+	code, body := do(t, h, "GET", "/projects/web/tasks/t2", "ann", "")
+	if code != 200 {
+		t.Fatalf("get t2: got %d", code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "cat" {
+		t.Fatalf("t2 assignee changed to %q after a failed move", task.AssigneeID)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat lost web membership after a failed move: got %d", code)
+	}
+}
