+// moveMemberAggregate moves one member from one project to another, keeping the
+// role. Tasks the member had in the source project are unassigned, since an
+// assignee must be a member of the task's project.
+type moveMemberAggregate struct {
+	from   *Project
+	to     *Project
+	member *Membership // the membership in the source project
+	user   *User
+	tasks  []*Task // the source project's tasks assigned to the member
+}
+
+func loadMoveMember(ctx context.Context, x *Tx, fromID, userID, toID string) (*moveMemberAggregate, error) {
+	from, err := NewProjectTable().Find(ctx, x, fromID)
+	if err != nil {
+		return nil, err
+	}
+	to, err := NewProjectTable().Find(ctx, x, toID)
+	if err != nil {
+		return nil, err
+	}
+	m, err := from.Membership(ctx, x, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if _, err := to.Membership(ctx, x, userID); err == nil {
+		return nil, deny(ErrConflict, "user is already a member of the destination project")
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	u, err := m.User(ctx, x)
+	if err != nil {
+		return nil, err
+	}
+	tasks, err := m.AssignedTasks(ctx, x)
+	if err != nil {
+		return nil, err
+	}
+	return &moveMemberAggregate{from: from, to: to, member: m, user: u, tasks: tasks}, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.user.Org != a.to.Org {
+		return deny(ErrInvalid, "project members must belong to the project's organization")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, x *Tx) (*Membership, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, x); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.member.destroy(ctx, x); err != nil {
+		return nil, err
+	}
+	moved := &Membership{ProjectID: a.to.ID, UserID: a.member.UserID, Role: a.member.Role}
+	if err := moved.save(ctx, x); err != nil {
+		return nil, err
+	}
+	return moved, nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
