+// RemoveMember removes the user from the project and unassigns any of the
+// project's tasks that were assigned to them.
+func (s *Store) RemoveMember(projectID, userID string) {
+	delete(s.members[projectID], userID)
+	for _, t := range s.tasks {
+		if t.ProjectID == projectID && t.Assignee == userID {
+			t.Assignee = ""
+		}
+	}
+}
