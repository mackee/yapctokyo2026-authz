diff --git a/main_org_test.go b/main_org_test.go
new file mode 100644
index 0000000..432e8f1
--- /dev/null
+++ b/main_org_test.go
@@ -0,0 +1,111 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestRemoveOrgUserAccess(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin, user in no project", "eve", "/orgs/acme/users/hal", 204},
+		{"manager is not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"viewer", "dan", "/orgs/acme/users/ben", 403},
+		{"contributor removing self", "ben", "/orgs/acme/users/ben", 403},
+		{"other org admin", "gus", "/orgs/acme/users/ben", 404},
+		{"org in path is another org", "eve", "/orgs/globex/users/gus", 404},
+		{"user in another org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed", 404},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserDetachesFromAllProjects(t *testing.T) {
+	h := newServer()
+
+	// ann is a member of web (manager), ops (viewer) and legacy (archived, manager).
+	for _, p := range []string{"/projects/web/tasks", "/projects/ops/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, h, "GET", p, "ann", ""); code != 200 {
+			t.Fatalf("before: GET %s got %d want 200", p, code)
+		}
+	}
+
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ann", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+
+	// Removed from every project, archived ones included.
+	for _, p := range []string{"/projects/web/tasks", "/projects/ops/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, h, "GET", p, "ann", ""); code != 404 {
+			t.Fatalf("after: GET %s got %d want 404", p, code)
+		}
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ann", `{"title":"x"}`); code != 404 {
+		t.Fatalf("after: POST got %d want 404", code)
+	}
+
+	// Removing again is a no-op.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ann", "eve", ""); code != 204 {
+		t.Fatalf("second remove: got %d want 204", code)
+	}
+
+	// Other members are untouched.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ivy", ""); code != 200 {
+		t.Fatalf("ivy after: got %d want 200", code)
+	}
+}
+
+func TestRemoveOrgUserUnassignsTasks(t *testing.T) {
+	h := newServer()
+
+	assignee := func(taskPath string) string {
+		t.Helper()
+		code, body := do(t, h, "GET", taskPath, "ann", "")
+		if code != 200 {
+			t.Fatalf("GET %s got %d want 200", taskPath, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		return task.Assignee
+	}
+
+	if got := assignee("/projects/web/tasks/t1"); got != "ben" {
+		t.Fatalf("before: t1 assignee %q want ben", got)
+	}
+	if got := assignee("/projects/legacy/tasks/t5"); got != "ben" {
+		t.Fatalf("before: t5 assignee %q want ben", got)
+	}
+
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+
+	if got := assignee("/projects/web/tasks/t1"); got != "" {
+		t.Fatalf("after: t1 assignee %q want unassigned", got)
+	}
+	if got := assignee("/projects/legacy/tasks/t5"); got != "" {
+		t.Fatalf("after: t5 assignee %q want unassigned", got)
+	}
+	// Tasks assigned to others are unchanged.
+	if got := assignee("/projects/web/tasks/t2"); got != "cat" {
+		t.Fatalf("after: t2 assignee %q want cat", got)
+	}
+	// The removed user loses access to the tasks they used to hold.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t1", "ben", ""); code != 404 {
+		t.Fatalf("ben GET t1 got %d want 404", code)
+	}
+}
