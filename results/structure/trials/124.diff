+func removeOrgUser(ctx tanukirpc.Context[*userRegistry], _ struct{}) (*struct{}, error) {
+	m, err := ctx.Registry().scope.Manage()
+	if err != nil {
+		return nil, err
+	}
+	if err := m.Remove(); err != nil {
+		return nil, err
+	}
+	ctx.Response().WriteHeader(http.StatusNoContent)
+	return nil, nil
+}
