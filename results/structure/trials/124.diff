+// orgTransformer authenticates the caller and binds the scope to {orgID}.
+func orgTransformer(authz *capability.Authorizer) tanukirpc.Transformer[*rootRegistry, *orgRegistry] {
+	return tanukirpc.NewTransformer(func(ctx tanukirpc.Context[*rootRegistry]) (*orgRegistry, error) {
+		actor, err := authz.Authenticate(ctx.Request().Header.Get("X-User"))
+		if err != nil {
+			return nil, err
+		}
+		return &orgRegistry{scope: actor.Org(chi.URLParam(ctx.Request(), "orgID"))}, nil
+	})
+}
+
+func userTransformer() tanukirpc.Transformer[*orgRegistry, *userRegistry] {
+	return tanukirpc.NewTransformer(func(ctx tanukirpc.Context[*orgRegistry]) (*userRegistry, error) {
+		return &userRegistry{scope: ctx.Registry().scope.User(chi.URLParam(ctx.Request(), "uid"))}, nil
+	})
+}
+
 // projectTransformer authenticates the caller and binds the scope to {pid}.
 // The Authorizer stays in this closure; it is never put in a registry.
 func projectTransformer(authz *capability.Authorizer) tanukirpc.Transformer[*rootRegistry, *projectRegistry] {
@@ -177,6 +210,18 @@ func deleteTask(ctx tanukirpc.Context[*taskRegistry], _ struct{}) (*struct{}, er
