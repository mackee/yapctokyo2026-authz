diff --git a/internal/capability/org.go b/internal/capability/org.go
new file mode 100644
index 0000000..003815b
--- /dev/null
+++ b/internal/capability/org.go
@@ -0,0 +1,83 @@
+package capability
+
+// OrgScope is bound to one actor and one organization ID.
+type OrgScope interface {
+	ID() string
+	User(userID string) UserScope
+}
+
+// UserScope is bound to one actor, one organization and one user ID.
+type UserScope interface {
+	// Manage acquires the org-admin capability over this user.
+	Manage() (ManageUser, error)
+}
+
+// ManageUser may take one user out of the organization (e.g. on offboarding).
+type ManageUser interface {
+	ID() string
+	// Remove takes the user out of every project of the organization, archived
+	// projects included, and unassigns the user's tasks. Removing a user who is
+	// in no project is a no-op.
+	Remove() error
+}
+
+type orgScope struct {
+	as  *actorScope
+	oid string
+}
+
+func (s *actorScope) Org(orgID string) OrgScope { return &orgScope{as: s, oid: orgID} }
+
+func (s *orgScope) ID() string                   { return s.oid }
+func (s *orgScope) User(userID string) UserScope { return &userScope{os: s, uid: userID} }
+
+type userScope struct {
+	os  *orgScope
+	uid string
+}
+
+// Manage applies the org-admin rule: the organization is the actor's own (else
+// 404), the actor is an org admin (else 403), and the user belongs to that
+// organization (else 404).
+func (s *userScope) Manage() (ManageUser, error) {
+	err := s.os.as.a.st.read(func(st *state) error {
+		if s.os.oid != s.os.as.actor.org {
+			return deny(ErrNotFound, "not found")
+		}
+		if !s.os.as.actor.orgAdmin {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if u, ok := st.users[s.uid]; !ok || u.org != s.os.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &manageUser{us: s}, nil
+}
+
+type manageUser struct{ us *userScope }
+
+func (m *manageUser) ID() string { return m.us.uid }
+
+func (m *manageUser) Remove() error {
+	return m.us.os.as.a.st.tx(func(s *state) error {
+		for pid, members := range s.members {
+			if s.projects[pid].org != m.us.os.oid {
+				continue
+			}
+			delete(members, m.us.uid)
+		}
+		// An assignee must be a member of the task's project, so tasks held by
+		// the removed user become unassigned in the same commit.
+		for id, t := range s.tasks {
+			if t.assignee.user == m.us.uid {
+				t.assignee = Assignee{project: t.project}
+				s.tasks[id] = t
+			}
+		}
+		return nil
+	})
+}
