+// OrgAuthz is what the actor may do in one organization.
+type OrgAuthz struct {
+	actor Actor
+	org   string
+}
+
+// Org returns the organization the object is bound to.
+func (a OrgAuthz) Org() string { return a.org }
+
+// CanAdminister returns nil if the actor may administer the organization's
+// users: org admins of that organization only (else ErrForbidden).
+func (a OrgAuthz) CanAdminister() error {
+	if a.org == "" || !a.actor.orgAdmin {
+		return deny(ErrForbidden, "only organization admins may do this")
+	}
+	return nil
+}
