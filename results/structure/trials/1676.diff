+// ---- user transfer: POST /orgs/{orgID}/users/{uid}/transfer ----------------------
+
+func TestTransfer(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin transfers", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 200},
+		{"member cannot transfer", "ben", "/orgs/acme/users/cat/transfer", `{"toOrgId":"globex"}`, 403},
+		{"viewer cannot transfer", "dan", "/orgs/acme/users/cat/transfer", `{"toOrgId":"globex"}`, 403},
+		{"anonymous", "", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown caller", "zed", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 401},
+		{"caller in other org", "gus", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 404},
+		{"org admin of other org", "eve", "/orgs/globex/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"unknown org in path", "eve", "/orgs/initech/users/hal/transfer", `{"toOrgId":"globex"}`, 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"user in another org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"unknown target org", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"initech"}`, 400},
+		{"same org", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"acme"}`, 400},
+		{"missing toOrgId", "eve", "/orgs/acme/users/hal/transfer", `{}`, 400},
+		{"bad json", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/hal/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+	var got map[string]any
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 2 || got["id"] != "hal" || got["orgId"] != "globex" {
+		t.Fatalf("body = %s, want {\"id\":\"hal\",\"orgId\":\"globex\"}", body)
+	}
+}
+
+func TestTransferEffects(t *testing.T) {
+	t.Run("moved user loses access to the old org", func(t *testing.T) {
+		srv := newServer()
+		do(t, srv, "POST", "/orgs/acme/users/hal/transfer", "eve", `{"toOrgId":"globex"}`)
+		// hal is no longer in acme, so acme projects are not readable by hal
+		if code, _ := do(t, srv, "GET", "/projects/web/tasks", "hal", ""); code != 404 {
+			t.Fatalf("hal reads acme project: got %d want 404", code)
+		}
+		// the moved user is no longer in acme, so the acme admin cannot move hal again
+		if code, _ := do(t, srv, "POST", "/orgs/acme/users/hal/transfer", "eve", `{"toOrgId":"acme"}`); code != 404 {
+			t.Fatalf("transfer of a user already moved: got %d want 404", code)
+		}
+	})
+
+	t.Run("memberships in the old org are removed", func(t *testing.T) {
+		srv := newServer()
+		do(t, srv, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`)
+		if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+			t.Fatalf("ben reads web after transfer: got %d want 404", code)
+		}
+		if code, _ := do(t, srv, "GET", "/projects/legacy/tasks", "ben", ""); code != 404 {
+			t.Fatalf("ben reads legacy after transfer: got %d want 404", code)
+		}
+	})
+
+	t.Run("tasks assigned in the old org are unassigned", func(t *testing.T) {
+		srv := newServer()
+		do(t, srv, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`)
+		for _, path := range []string{"/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+			code, body := do(t, srv, "GET", path, "eve", "")
+			if code != 200 {
+				t.Fatalf("%s: got %d want 200", path, code)
+			}
+			var task Task
+			if err := json.Unmarshal([]byte(body), &task); err != nil {
+				t.Fatal(err)
+			}
+			if task.AssigneeID != "" {
+				t.Fatalf("%s still assigned to %q", path, task.AssigneeID)
+			}
+		}
+	})
+
+	t.Run("other members keep their memberships", func(t *testing.T) {
+		srv := newServer()
+		do(t, srv, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`)
+		if code, _ := do(t, srv, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+			t.Fatalf("cat reads web after ben moved: got %d want 200", code)
+		}
+	})
+
+	t.Run("org admin flag does not carry over", func(t *testing.T) {
+		srv := newServer()
+		if code, _ := do(t, srv, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+			t.Fatalf("transfer eve: got %d want 200", code)
+		}
+		// eve is now a globex user without the admin flag: she cannot read the globex project
+		if code, _ := do(t, srv, "GET", "/projects/gx/tasks", "eve", ""); code != 404 {
+			t.Fatalf("eve reads gx as non-admin: got %d want 404", code)
+		}
+	})
+}
