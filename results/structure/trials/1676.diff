+// transferUserAggregate moves one user to another organization.
+type transferUserAggregate struct {
+	user    *User
+	to      *Org
+	leaving []*Membership // the user's memberships in projects of the organization being left
+}
+
+func loadTransferUser(ctx context.Context, tx DB, authz OrgAuthz, userID, toOrgID string) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != authz.Org() {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	to, err := NewOrgTable().Find(ctx, tx, toOrgID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "target organization does not exist")
+	} else if err != nil {
+		return nil, err
+	}
+	if to.ID == u.Org {
+		return nil, deny(ErrInvalid, "user is already in that organization")
+	}
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	a := &transferUserAggregate{user: u, to: to}
+	for _, m := range ms {
+		p, err := m.Project(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		if p.Org == u.Org {
+			a.leaving = append(a.leaving, m)
+		}
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error { return nil }
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	for _, m := range a.leaving {
+		tasks, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		for _, t := range tasks {
+			if err := t.unassign(ctx, tx); err != nil {
+				return nil, err
+			}
+		}
+		if err := m.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	u := a.user
+	u.Org = a.to.ID
+	u.OrgAdmin = false
+	if err := u.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return u, nil
+}
+
