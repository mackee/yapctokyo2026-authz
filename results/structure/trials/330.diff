+// ManageProject may change the membership roles of one project.
+type ManageProject interface {
+	ReadProject
+	// SetMemberRole changes a member's role to manager, contributor or viewer.
+	// An invalid role is 400; a user who is not a member of this project is 404.
+	SetMemberRole(userID, role string) (MemberView, error)
+}
+
+type manageProject struct{ readProject }
+
+func (p *manageProject) SetMemberRole(userID, role string) (MemberView, error) {
+	if !validRoles[role] {
+		return MemberView{}, deny(ErrInvalid, "role must be manager, contributor or viewer")
+	}
+	var v MemberView
+	err := p.ps.as.a.db.update(func(x *tx) error {
+		agg, err := loadSetMemberRole(x, p.ps.pid, userID, role)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		v = agg.save(x)
+		return nil
+	})
+	return v, err
+}
