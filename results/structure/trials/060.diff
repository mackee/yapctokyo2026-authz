+func TestSearch(t *testing.T) {
+	cases := []struct {
+		name, user, q string
+		want          int
+		wantCount     int // -1 to skip the count check
+	}{
+		{"member finds", "ann", "header", 200, 1},
+		{"viewer member finds", "dan", "header", 200, 1},
+		{"org admin sees own org", "eve", "header", 200, 1},
+		{"non member gets empty", "hal", "header", 200, 0},
+		{"other org gets empty", "gus", "header", 200, 0},
+		{"other org task hidden from acme", "ann", "secret", 200, 0},
+		{"org admin cannot see other org", "eve", "secret", 200, 0},
+		{"other org member finds own", "gus", "secret", 200, 1},
+		{"archived readable", "ben", "Old bug", 200, 1},
+		{"no match", "ann", "nomatch", 200, 0},
+		{"case sensitive", "ann", "HEADER", 200, 0},
+		{"anonymous", "", "header", 401, -1},
+		{"unknown user", "zed", "header", 401, -1},
+		{"empty q", "ann", "", 400, -1},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			path := "/search/tasks?q=" + url.QueryEscape(c.q)
+			code, body := do(t, newServer(), "GET", path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d (body %s)", code, c.want, body)
+			}
+			if c.wantCount < 0 {
+				return
+			}
+			var tasks []Task
+			if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+				t.Fatalf("body is not a task array: %v (%s)", err, body)
+			}
+			if len(tasks) != c.wantCount {
+				t.Fatalf("got %d tasks want %d (%s)", len(tasks), c.wantCount, body)
+			}
+		})
+	}
+}
+
+func TestSearchEmptyIsArray(t *testing.T) {
+	code, body := do(t, newServer(), "GET", "/search/tasks?q=nomatch", "ann", "")
+	if code != 200 {
+		t.Fatal(code)
+	}
+	if strings.TrimSpace(body) != "[]" {
+		t.Fatalf("want [] got %s", body)
+	}
+}
+
+func TestSearchAcrossProjectsIncludesProjectID(t *testing.T) {
+	h := newServer()
+	// ivy is a manager of both web and ops, so she can create a matching task in ops.
+	if code, body := do(t, h, "POST", "/projects/ops/tasks", "ivy", `{"title":"Fix header in ops"}`); code != 201 {
+		t.Fatalf("setup: got %d (%s)", code, body)
+	}
+	code, body := do(t, h, "GET", "/search/tasks?q=header", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d (%s)", code, body)
+	}
+	var tasks []Task
+	if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+		t.Fatal(err)
+	}
+	seen := map[string]bool{}
+	for _, task := range tasks {
+		if task.ProjectID == "" {
+			t.Fatalf("task %s has no projectId", task.ID)
+		}
+		seen[task.ProjectID] = true
+	}
+	if len(tasks) != 2 || !seen["web"] || !seen["ops"] {
+		t.Fatalf("want header tasks from web and ops, got %s", body)
+	}
+}
