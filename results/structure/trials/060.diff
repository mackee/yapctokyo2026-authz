+// TasksWithTitleContaining returns tasks from all projects whose title contains
+// q (case-sensitive), sorted by ID. Access checks are the caller's job.
+func (s *Store) TasksWithTitleContaining(q string) []*Task {
+	var out []*Task
+	for _, t := range s.tasks {
+		if strings.Contains(t.Title, q) {
+			out = append(out, t)
+		}
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].ID < out[j].ID })
+	return out
+}
