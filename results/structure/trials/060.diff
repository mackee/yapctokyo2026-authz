+// searchTasks returns tasks whose title contains q, across every project the
+// caller can read. Projects the caller cannot read are skipped silently, so
+// their tasks never appear and the result reveals nothing about them.
+func (s *server) searchTasks(w http.ResponseWriter, r *http.Request) {
+	s.store.mu.Lock()
+	defer s.store.mu.Unlock()
+
+	user := s.store.User(r.Header.Get("X-User"))
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	q := r.URL.Query().Get("q")
+	if q == "" {
+		writeError(w, 400, "q is required")
+		return
+	}
+	tasks := []*Task{}
+	for _, t := range s.store.TasksWithTitleContaining(q) {
+		project := s.store.Project(t.ProjectID)
+		if project == nil || project.OrgID != user.OrgID {
+			continue
+		}
+		if s.store.Role(project.ID, user.ID) == "" && !user.OrgAdmin {
+			continue
+		}
+		tasks = append(tasks, t)
+	}
+	writeJSON(w, 200, tasks)
+}
