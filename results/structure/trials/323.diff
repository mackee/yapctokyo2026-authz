+func (t *manageTask) MoveTo(dst WriteProject) (TaskView, error) {
+	wp, ok := dst.(*writeProject)
+	if !ok || wp.ps.as.actor.id != t.ts.ps.as.actor.id {
+		return TaskView{}, deny(ErrForbidden, "forbidden")
+	}
+	toPID := wp.ps.pid
+	if toPID == t.ts.ps.pid {
+		return TaskView{}, deny(ErrInvalid, "task is already in that project")
+	}
+	if wp.role != RoleManager {
+		return TaskView{}, deny(ErrForbidden, "only managers may move tasks into a project")
+	}
+	var v TaskView
+	err := t.ts.ps.as.a.db.update(func(x *tx) error {
+		agg, err := loadMoveTask(x, t.ts.tid, t.ts.ps.pid, toPID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		v = agg.save(x)
+		return nil
+	})
+	return v, err
+}
