 func (a *deleteTaskAggregate) save(x *tx) { a.task.destroy(x) }
+
+// moveTaskAggregate moves one task from one project to another, keeping its
+// ID, title, status and assignee.
+type moveTaskAggregate struct {
+	task      taskRecord
+	toProject projectRecord
+	assignee  *membershipRecord // nil means unassigned
+}
+
+func loadMoveTask(x *tx, taskID, fromProjectID, toProjectID string) (*moveTaskAggregate, error) {
+	t, ok := x.findTask(taskID)
+	if !ok || t.ProjectID != fromProjectID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	p, ok := x.findProject(toProjectID)
+	if !ok {
+		return nil, deny(ErrInvalid, "task must belong to an existing project")
+	}
+	a := &moveTaskAggregate{toProject: p, task: t}
+	a.task.ProjectID = p.ID
+	if t.AssigneeID != "" {
+		m, ok := x.findMembership(p.ID, t.AssigneeID)
+		if !ok {
+			return nil, deny(ErrInvalid, "assignee must be a contributor or manager of the project")
+		}
+		a.assignee = &m
+	}
+	return a, nil
+}
+
+func (a *moveTaskAggregate) validate() error {
+	if a.toProject.Archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	if a.assignee != nil && !isWriterRole(a.assignee.Role) {
+		return deny(ErrInvalid, "assignee must be a contributor or manager of the project")
+	}
+	return nil
+}
+
+func (a *moveTaskAggregate) save(x *tx) TaskView {
+	a.task.save(x)
+	return a.task.view()
+}
