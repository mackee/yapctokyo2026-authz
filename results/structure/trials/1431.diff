+func TestFreeze(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("freeze: got %d body %s", code, body)
+	}
+	var got []map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []string{"ann", "ben", "cat", "dan", "ivy"}
+	if len(got) != len(want) {
+		t.Fatalf("members: %s", body)
+	}
+	for i, m := range got {
+		if m["userId"] != want[i] || m["role"] != "viewer" || len(m) != 2 {
+			t.Fatalf("member %d: %v", i, m)
+		}
+	}
+
+	// Nobody can change tasks of the frozen project any more.
+	writes := []struct{ user, method, path, body string }{
+		{"ann", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"ivy", "PATCH", "/projects/web/tasks/t3", `{"status":"done"}`},
+		{"ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"ann", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"ann", "DELETE", "/projects/web/tasks/t1", ""},
+		{"ann", "POST", "/projects/web/freeze", ""},
+	}
+	for _, w := range writes {
+		if code, _ := do(t, h, w.method, w.path, w.user, w.body); code != 403 {
+			t.Errorf("%s %s by %s: got %d want 403", w.method, w.path, w.user, code)
+		}
+	}
+
+	// Reads still work, and tasks are unassigned (assignees must be writers).
+	code, body = do(t, h, "GET", "/projects/web/tasks", "dan", "")
+	if code != 200 || strings.Contains(body, `"assignee":"ben"`) || strings.Contains(body, `"assignee":"cat"`) {
+		t.Fatalf("list after freeze: %d %s", code, body)
+	}
+
+	// Other projects are untouched.
+	if code, _ := do(t, h, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ops task after freezing web: got %d", code)
+	}
+}
