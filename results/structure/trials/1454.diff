+func TestUpdateMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, project, target, body string
+		want                              int
+	}{
+		{"manager demotes idle manager", "ann", "web", "ivy", `{"role":"viewer"}`, 200},
+		{"manager promotes contributor", "ann", "web", "cat", `{"role":"manager"}`, 200},
+		{"same role", "ann", "web", "ben", `{"role":"contributor"}`, 200},
+		{"demote with assigned tasks", "ann", "web", "ben", `{"role":"viewer"}`, 409},
+		{"contributor caller", "ben", "web", "cat", `{"role":"viewer"}`, 403},
+		{"viewer caller", "dan", "web", "ben", `{"role":"viewer"}`, 403},
+		{"org admin caller", "eve", "web", "ben", `{"role":"viewer"}`, 403},
+		{"non member caller", "hal", "web", "ben", `{"role":"viewer"}`, 404},
+		{"other org caller", "gus", "web", "ben", `{"role":"viewer"}`, 404},
+		{"anonymous", "", "web", "ben", `{"role":"viewer"}`, 401},
+		{"unknown user", "zed", "web", "ben", `{"role":"viewer"}`, 401},
+		{"missing project", "ann", "nope", "ben", `{"role":"viewer"}`, 404},
+		{"target not a member", "ann", "web", "hal", `{"role":"viewer"}`, 404},
+		{"target in other project", "ivy", "ops", "ben", `{"role":"viewer"}`, 404},
+		{"archived", "ann", "legacy", "ben", `{"role":"manager"}`, 409},
+		{"invalid role", "ann", "web", "cat", `{"role":"admin"}`, 400},
+		{"empty role", "ann", "web", "cat", `{"role":""}`, 400},
+		{"bad body", "ann", "web", "cat", `nope`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			path := "/projects/" + c.project + "/members/" + c.target
+			code, _ := do(t, newServer(), "PUT", path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRoleResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members/ivy", "ann", `{"role":"viewer"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["userId"] != "ivy" || got["role"] != "viewer" || len(got) != 2 {
+		t.Fatalf("got %s", body)
+	}
+}
+
+// A role change must affect later requests, not just the response.
+func TestUpdateMemberRoleTakesEffect(t *testing.T) {
+	h := newServer()
+
+	// dan is a viewer: cannot touch tasks.
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t3", "dan", `{"status":"done"}`); code != 403 {
+		t.Fatalf("viewer patch: got %d want 403", code)
+	}
+	if code, _ := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`); code != 200 {
+		t.Fatalf("promote dan: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t3", "ann", `{"assignee":"dan"}`); code != 200 {
+		t.Fatalf("assign t3 to dan: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t3", "dan", `{"status":"done"}`); code != 200 {
+		t.Fatalf("promoted patch: got %d want 200", code)
+	}
+
+	// ben is a contributor with t1: demoting him needs t1 reassigned first.
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 409 {
+		t.Fatalf("demote ben with tasks: got %d want 409", code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ann", `{"assignee":""}`); code != 200 {
+		t.Fatalf("unassign t1: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote ben: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 403 {
+		t.Fatalf("demoted patch: got %d want 403", code)
+	}
+
+	// Only managers may change roles: ben is now a viewer.
+	if code, _ := do(t, h, "PUT", "/projects/web/members/cat", "ben", `{"role":"viewer"}`); code != 403 {
+		t.Fatalf("demoted caller change role: got %d want 403", code)
+	}
+}
