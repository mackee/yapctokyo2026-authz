+type moveRequest struct {
+	ToProjectID string `json:"toProjectId" validate:"required"`
+}
+
+// moveTask builds the actor's authorization object for the destination project
+// (an unreadable or missing one is 404), then moves the task.
+func moveTask(ctx tanukirpc.Context[*taskRegistry], req moveRequest) (*Task, error) {
+	reg := ctx.Registry()
+	// The actor's right to move the task out comes before anything about the
+	// destination, so a caller who may not move it learns nothing about it.
+	if err := reg.authz.CanManage(); err != nil {
+		return nil, err
+	}
+	dest, err := model.NewProjectAuthz(ctx, reg.db, reg.authz.Project().Actor(), req.ToProjectID)
+	if err != nil {
+		return nil, err
+	}
+	return model.NewTaskTable().Move(ctx, reg.db, reg.authz, dest)
+}
