+// Move moves the task to the project dest, all or nothing. The task keeps its
+// ID, title, status and assignee; the assignee must be a contributor or
+// manager of dest.
+func (*TaskTable) Move(ctx context.Context, db DB, authz TaskAuthz, dest ProjectAuthz) (*Task, error) {
+	if !dest.CanRead() {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if err := authz.CanMove(dest); err != nil {
+		return nil, err
+	}
+	var t *Task
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveTask(ctx, tx, authz.TaskID(), dest.ProjectID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if t, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return t, nil
+}
