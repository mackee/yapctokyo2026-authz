+// CanMove returns nil if the actor may move the task to the project dest:
+// the actor may manage the task (it leaves its project, like a delete) and
+// may create tasks in dest (contributor or manager, not archived).
+func (a TaskAuthz) CanMove(dest ProjectAuthz) error {
+	if err := a.CanManage(); err != nil {
+		return err
+	}
+	return dest.CanWrite()
