+// transferUserAggregate moves one user to another organization.
+type transferUserAggregate struct {
+	user        *User
+	toOrg       *Org
+	memberships []*Membership // the user's memberships in projects of the old organization
+	in          UserTableTransferInput
+}
+
+func loadTransferUser(ctx context.Context, tx DB, fromOrgID, userID string, in UserTableTransferInput) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != fromOrgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	o, err := NewOrgTable().Find(ctx, tx, in.ToOrgID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "target organization does not exist")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &transferUserAggregate{user: u, toOrg: o, in: in}
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, m := range ms {
+		p, err := m.Project(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		if p.Org == fromOrgID {
+			a.memberships = append(a.memberships, m)
+		}
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error { return nil }
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	// Assignments in projects the user leaves must go: an assignee has to be a
+	// writer of the task's project.
+	for _, m := range a.memberships {
+		tasks, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		for _, t := range tasks {
+			if err := t.unassign(ctx, tx); err != nil {
+				return nil, err
+			}
+		}
+		if err := m.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	u := a.user
+	u.Org = a.toOrg.ID
+	u.OrgAdmin = false
+	if err := u.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return u, nil
+}
+
