+func TestTransfer(t *testing.T) {
+	cases := []struct {
+		name, user, org, uid, body string
+		want                       int
+	}{
+		{"org admin moves member", "eve", "acme", "ben", `{"toOrgId":"globex"}`, 200},
+		{"org admin moves manager", "eve", "acme", "ann", `{"toOrgId":"globex"}`, 200},
+		{"manager is not org admin", "ann", "acme", "ben", `{"toOrgId":"globex"}`, 403},
+		{"contributor is not org admin", "ben", "acme", "cat", `{"toOrgId":"globex"}`, 403},
+		{"anonymous", "", "acme", "ben", `{"toOrgId":"globex"}`, 401},
+		{"unknown caller", "zed", "acme", "ben", `{"toOrgId":"globex"}`, 401},
+		{"caller in other org", "gus", "acme", "ben", `{"toOrgId":"globex"}`, 404},
+		{"org the caller is not in", "eve", "globex", "gus", `{"toOrgId":"acme"}`, 404},
+		{"user not in the org", "eve", "acme", "gus", `{"toOrgId":"globex"}`, 404},
+		{"unknown user", "eve", "acme", "nobody", `{"toOrgId":"globex"}`, 404},
+		{"same org", "eve", "acme", "ben", `{"toOrgId":"acme"}`, 400},
+		{"unknown target org", "eve", "acme", "ben", `{"toOrgId":"initech"}`, 400},
+		{"empty target org", "eve", "acme", "ben", `{"toOrgId":""}`, 400},
+		{"missing target org", "eve", "acme", "ben", `{}`, 400},
+		{"malformed body", "eve", "acme", "ben", `{`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/orgs/"+c.org+"/users/"+c.uid+"/transfer", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got struct {
+		ID    string `json:"id"`
+		OrgID string `json:"orgId"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
