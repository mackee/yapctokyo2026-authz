+	}
+	if got.ID != "ben" || got.OrgID != "globex" {
+		t.Fatalf("got %+v", got)
+	}
+}
+
+func TestTransferEffects(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: %d %s", code, body)
+	}
+
+	// ben can no longer read the acme projects.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads web: got %d want 404", code)
+	}
+	// ben's assignments in those projects are cleared; other assignments stay.
+	for path, want := range map[string]string{
+		"/projects/web/tasks/t1":    "",    // was ben
+		"/projects/legacy/tasks/t5": "",    // was ben
+		"/projects/web/tasks/t2":    "cat", // was cat, untouched
+	} {
+		code, body := do(t, srv, "GET", path, "eve", "")
+		if code != 200 {
+			t.Fatalf("GET %s: %d %s", path, code, body)
+		}
+		var task Task
+		json.Unmarshal([]byte(body), &task)
+		if task.AssigneeID != want {
+			t.Fatalf("GET %s: assignee %q want %q", path, task.AssigneeID, want)
+		}
+	}
+	// ben is in globex now, so a second transfer from acme does not find them.
+	if code, _ := do(t, srv, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 404 {
+		t.Fatalf("second transfer: got %d want 404", code)
+	}
+}
+
+func TestTransferClearsOrgAdmin(t *testing.T) {
