@@ -0,0 +1,43 @@
+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestTransfer(t *testing.T) {
+	h := newServer()
+	const path = "/orgs/acme/users/ben/transfer"
+	body := `{"toOrgId":"globex"}`
+
+	if c, _ := do(t, h, "POST", path, "", body); c != 401 {
+		t.Fatalf("anon: %d", c)
+	}
+	if c, _ := do(t, h, "POST", path, "ann", body); c != 403 {
+		t.Fatalf("non-admin: %d", c)
+	}
+	if c, _ := do(t, h, "POST", path, "gus", body); c != 404 {
+		t.Fatalf("other org: %d", c)
+	}
+	if c, _ := do(t, h, "POST", path, "eve", `{}`); c != 400 {
+		t.Fatalf("bad body: %d", c)
+	}
+	if c, _ := do(t, h, "POST", path, "eve", `{"toOrgId":"nowhere"}`); c != 400 {
+		t.Fatalf("unknown org: %d", c)
+	}
+	if c, _ := do(t, h, "POST", "/orgs/acme/users/gus/transfer", "eve", body); c != 404 {
+		t.Fatalf("user of another org: %d", c)
+	}
+
+	c, b := do(t, h, "POST", path, "eve", body)
+	if c != 200 || !strings.Contains(b, `"id":"ben"`) || !strings.Contains(b, `"orgId":"globex"`) {
+		t.Fatalf("transfer: %d %s", c, b)
+	}
+	// ben lost access to acme projects and his assignments.
+	if c, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); c != 404 {
+		t.Fatalf("old project access: %d", c)
+	}
+	if _, b := do(t, h, "GET", "/projects/web/tasks/t1", "ann", ""); !strings.Contains(b, `"assignee":""`) {
+		t.Fatalf("assignment kept: %s", b)
+	}
+}
