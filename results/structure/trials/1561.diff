@@ -0,0 +1,118 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"testing"
+)
+
+func memberRoles(t *testing.T, h http.Handler, pid string) map[string]string {
+	t.Helper()
+	app := h.(*appHandler)
+	rows, err := app.db.Query(`SELECT user_id, role FROM memberships WHERE project_id = ?`, pid)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer rows.Close()
+	out := map[string]string{}
+	for rows.Next() {
+		var u, r string
+		rows.Scan(&u, &r)
+		out[u] = r
+	}
+	return out
+}
+
+func TestUpdateMembers(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got []member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []member{{"ann", "manager"}, {"ben", "viewer"}, {"cat", "contributor"}, {"dan", "contributor"}, {"ivy", "manager"}}
+	if len(got) != len(want) {
+		t.Fatalf("got %v", got)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("got %v want %v", got, want)
+		}
+	}
+	// ben was assigned t1; demotion to viewer unassigns it (model rules checked by do()).
+	_, task := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var tk Task
+	json.Unmarshal([]byte(task), &tk)
+	if tk.Assignee != "" {
+		t.Fatalf("t1 still assigned to %q", tk.Assignee)
+	}
+}
+
+func TestUpdateMembersAllOrNothing(t *testing.T) {
+	cases := []struct {
+		name, body string
+		want       int
+	}{
+		{"unknown role", `{"roles":{"ben":"viewer","dan":"boss"}}`, 400},
+		{"non member", `{"roles":{"ben":"viewer","hal":"viewer"}}`, 400},
+		{"other org user", `{"roles":{"ben":"viewer","gus":"viewer"}}`, 400},
+		{"no manager left", `{"roles":{"ben":"viewer","ann":"viewer","ivy":"contributor"}}`, 409},
+		{"empty", `{"roles":{}}`, 400},
+		{"bad json", `nope`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			before := memberRoles(t, h, "web")
+			code, _ := do(t, h, "PUT", "/projects/web/members", "ann", c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+			after := memberRoles(t, h, "web")
+			for u, r := range before {
+				if after[u] != r {
+					t.Fatalf("%s changed from %s to %s", u, r, after[u])
+				}
+			}
+			_, task := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+			var tk Task
+			json.Unmarshal([]byte(task), &tk)
+			if tk.Assignee != "ben" {
+				t.Fatalf("t1 assignee changed to %q", tk.Assignee)
+			}
+		})
+	}
+}
+
+func TestUpdateMembersAccess(t *testing.T) {
+	body := `{"roles":{"dan":"contributor"}}`
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"anonymous", "", "/projects/web/members", 401},
+		{"contributor", "ben", "/projects/web/members", 403},
+		{"viewer", "dan", "/projects/web/members", 403},
+		{"org admin", "eve", "/projects/web/members", 403},
+		{"non member", "hal", "/projects/web/members", 404},
+		{"other org", "gus", "/projects/web/members", 404},
+		{"missing project", "ann", "/projects/nope/members", 404},
+		{"archived", "ann", "/projects/legacy/members", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			before := memberRoles(t, h, "web")
+			code, _ := do(t, h, "PUT", c.path, c.user, body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+			if after := memberRoles(t, h, "web"); after["dan"] != before["dan"] {
+				t.Fatal("dan changed")
+			}
+		})
+	}
+}
