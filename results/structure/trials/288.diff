+// ManageProject may change the roles of the members of one project.
+type ManageProject interface {
+	// SetMemberRole sets the role of an existing member of this project.
+	// A user who is not a member is 404. An unknown role is 400. Demoting a
+	// member to viewer while they hold tasks in this project is 400, because
+	// assignees must be contributors or managers; reassign those tasks first.
+	SetMemberRole(userID, role string) (MemberView, error)
+}
+
+type manageProject struct{ ps *projectScope }
+
+func validRole(role string) bool {
+	return role == RoleManager || role == RoleContributor || role == RoleViewer
+}
+
+func (p *manageProject) SetMemberRole(userID, role string) (MemberView, error) {
+	if !validRole(role) {
+		return MemberView{}, deny(ErrInvalid, "invalid role")
+	}
+	var v MemberView
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		if _, ok := s.members[p.ps.pid][userID]; !ok {
+			return deny(ErrNotFound, "not found")
+		}
+		if !isWriterRole(role) {
+			for _, t := range s.tasks {
+				if t.project == p.ps.pid && t.assignee.user == userID {
+					return deny(ErrInvalid, "member has tasks assigned in this project; reassign them before changing the role to viewer")
+				}
+			}
+		}
+		s.members[p.ps.pid][userID] = role
+		v = MemberView{UserID: userID, Role: role}
+		return nil
+	})
+	return v, err
+}
+
 type readProject struct{ ps *projectScope }
 
