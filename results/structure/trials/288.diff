+func TestSetMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager promotes viewer", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"manager demotes manager without tasks", "ann", "/projects/web/members/ivy", `{"role":"viewer"}`, 200},
+		{"demote contributor with tasks", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 400},
+		{"contributor cannot", "ben", "/projects/web/members/cat", `{"role":"manager"}`, 403},
+		{"viewer cannot", "dan", "/projects/web/members/ben", `{"role":"manager"}`, 403},
+		{"org admin cannot", "eve", "/projects/web/members/ben", `{"role":"manager"}`, 403},
+		{"non member", "hal", "/projects/web/members/ben", `{"role":"manager"}`, 404},
+		{"other org", "gus", "/projects/web/members/ben", `{"role":"manager"}`, 404},
+		{"anonymous", "", "/projects/web/members/ben", `{"role":"manager"}`, 401},
+		{"unknown user", "zed", "/projects/web/members/ben", `{"role":"manager"}`, 401},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"contributor"}`, 404},
+		{"target in other org", "ann", "/projects/web/members/gus", `{"role":"contributor"}`, 404},
+		{"unknown project", "ann", "/projects/nope/members/ben", `{"role":"viewer"}`, 404},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"invalid role", "ann", "/projects/web/members/dan", `{"role":"owner"}`, 400},
+		{"missing role", "ann", "/projects/web/members/dan", `{}`, 400},
+		{"malformed body", "ann", "/projects/web/members/dan", `{`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMemberRoleResponseAndPersistence(t *testing.T) {
+	h := newServer()
+
+	code, body := do(t, h, "PUT", "/projects/web/members/ivy", "ann", `{"role":"viewer"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 2 || got["userId"] != "ivy" || got["role"] != "viewer" {
+		t.Fatalf("unexpected body: %s", body)
+	}
+
+	// ivy is now a viewer: can still read, can no longer write.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ivy", ""); code != 200 {
+		t.Fatalf("read after demotion: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ivy", `{"title":"x"}`); code != 403 {
+		t.Fatalf("write after demotion: got %d want 403", code)
+	}
+
+	// A rejected change leaves the role untouched: ben keeps the task he holds.
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 400 {
+		t.Fatalf("demote with tasks: got %d want 400", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 201 {
+		t.Fatalf("ben write after rejected demotion: got %d want 201", code)
+	}
+}
