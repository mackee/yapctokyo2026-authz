+// UserAuthz is what the actor may do with one user of one organization.
+type UserAuthz struct {
+	actor Actor
+	org   string
+	user  string
+}
+
+// UserID returns the user the object is bound to.
+func (a UserAuthz) UserID() string { return a.user }
+
+// Org returns the organization the user belonged to when the object was built.
+func (a UserAuthz) Org() string { return a.org }
+
+// CanTransfer returns nil if the actor may move the user to another
+// organization: only an org admin of the user's current organization.
+func (a UserAuthz) CanTransfer() error {
+	if a.user == "" || !a.actor.orgAdmin || a.actor.org != a.org {
+		return deny(ErrForbidden, "forbidden")
+	}
+	return nil
+}
+
 // ---- building authorization objects -------------------------------------------------
 
+// NewUserAuthz builds the actor's authorization object for one user of the
+// organization. The actor must be in that organization (else ErrNotFound) and
+// the user must exist in it (else ErrNotFound). Whether the actor may act on
+// the user is decided by the object's methods.
+func NewUserAuthz(ctx context.Context, db DB, act Actor, orgID, userID string) (UserAuthz, error) {
+	if act.org != orgID {
+		return UserAuthz{}, deny(ErrNotFound, "not found")
+	}
+	u, err := NewUserTable().Find(ctx, db, userID)
+	if errors.Is(err, ErrNoRows) {
+		return UserAuthz{}, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return UserAuthz{}, err
+	}
+	if u.Org != orgID {
+		return UserAuthz{}, deny(ErrNotFound, "not found")
+	}
+	return UserAuthz{actor: act, org: u.Org, user: u.ID}, nil
+}
+
