+// userRegistry is the whole handler-visible surface under /orgs/{orgID}/users/{uid}.
+type userRegistry struct {
+	db    model.DB
+	authz model.UserAuthz
+}
+
+// userTransformer authenticates the caller and builds the actor's
+// authorization object for {uid} of {orgID}.
+func userTransformer(conn *sql.DB) tanukirpc.Transformer[*rootRegistry, *userRegistry] {
+	return tanukirpc.NewTransformer(func(ctx tanukirpc.Context[*rootRegistry]) (*userRegistry, error) {
+		actor, err := model.Authenticate(ctx, conn, ctx.Request().Header.Get("X-User"))
+		if err != nil {
+			return nil, err
+		}
+		authz, err := model.NewUserAuthz(ctx, conn, actor, chi.URLParam(ctx.Request(), "orgID"), chi.URLParam(ctx.Request(), "uid"))
+		if err != nil {
+			return nil, err
+		}
+		return &userRegistry{db: conn, authz: authz}, nil
+	})
+}
+
+type transferRequest struct {
+	ToOrgID string `json:"toOrgId" validate:"required"`
+}
+
+type transferResponse struct {
+	ID    string `json:"id"`
+	OrgID string `json:"orgId"`
+}
+
+func transferUser(ctx tanukirpc.Context[*userRegistry], req transferRequest) (*transferResponse, error) {
+	reg := ctx.Registry()
+	u, err := model.NewUserTable().Transfer(ctx, reg.db, reg.authz, model.UserTableTransferInput{ToOrg: req.ToOrgID})
+	if err != nil {
+		return nil, err
+	}
+	return &transferResponse{ID: u.ID, OrgID: u.Org}, nil
+}
