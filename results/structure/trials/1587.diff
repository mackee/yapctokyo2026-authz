+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes", "eve", "/orgs/acme/users/ben", 204},
+		{"user without projects", "eve", "/orgs/acme/users/hal", 204},
+		{"manager is not admin", "ann", "/orgs/acme/users/ben", 403},
+		{"self non admin", "ben", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown actor", "zed", "/orgs/acme/users/ben", 401},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"other org", "eve", "/orgs/globex/users/gus", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ben", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatal(code)
+	}
+	db := h.(*appHandler).db
+	count := func(q string, args ...any) int {
+		t.Helper()
+		var n int
+		if err := db.QueryRow(q, args...).Scan(&n); err != nil {
+			t.Fatal(err)
+		}
+		return n
+	}
+	if n := count(`SELECT COUNT(*) FROM memberships WHERE user_id = 'ben'`); n != 0 {
+		t.Fatalf("ben still has %d memberships (web and archived legacy must both go)", n)
+	}
+	if n := count(`SELECT COUNT(*) FROM tasks WHERE assignee = 'ben'`); n != 0 {
+		t.Fatalf("ben is still assigned %d tasks", n)
+	}
+	// the tasks themselves stay, unassigned
+	if n := count(`SELECT COUNT(*) FROM tasks WHERE id IN ('t1', 't5') AND assignee = ''`); n != 2 {
+		t.Fatalf("t1 and t5 should remain unassigned, got %d", n)
+	}
+	// other users and orgs are untouched
+	if n := count(`SELECT COUNT(*) FROM memberships`); n != 9 {
+		t.Fatalf("want 9 memberships left, got %d", n)
+	}
+	if n := count(`SELECT COUNT(*) FROM tasks WHERE assignee = 'cat'`); n != 2 {
+		t.Fatalf("cat's tasks changed: %d", n)
+	}
+	// the removed user can no longer read the project
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("removed user still reads web: %d", code)
+	}
+}
