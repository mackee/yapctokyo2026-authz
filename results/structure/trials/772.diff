+func TestChangeRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"promote viewer", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"promote to manager", "ivy", "/projects/web/members/dan", `{"role":"manager"}`, 200},
+		{"demote manager", "ann", "/projects/web/members/ivy", `{"role":"contributor"}`, 200},
+		{"demote assigned member to viewer", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 400},
+		{"contributor", "ben", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"viewer", "dan", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"org admin", "eve", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"manager of other project", "ann", "/projects/ops/members/cat", `{"role":"viewer"}`, 403},
+		{"non-member target", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"cross org", "gus", "/projects/web/members/dan", `{"role":"manager"}`, 404},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"manager"}`, 409},
+		{"bad role", "ann", "/projects/web/members/dan", `{"role":"boss"}`, 400},
+		{"missing role", "ann", "/projects/web/members/dan", `{}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+
+	code, body := do(t, newServer(), "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 || strings.TrimSpace(body) != `{"userId":"dan","role":"contributor"}` {
+		t.Fatalf("got %d %s", code, body)
+	}
+}
