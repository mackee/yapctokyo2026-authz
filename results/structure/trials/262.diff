+func TestFreezeAuthorization(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"archived", "ann", "legacy", 409},
+		{"missing project", "ann", "nope", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreeze(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var members []struct{ UserID, Role string }
+	if err := json.Unmarshal([]byte(body), &members); err != nil {
+		t.Fatal(err)
+	}
+	if len(members) != 5 {
+		t.Fatalf("want 5 members, got %v", members)
+	}
+	for _, m := range members {
+		if m.Role != "viewer" {
+			t.Fatalf("%s is %s, want viewer", m.UserID, m.Role)
+		}
+	}
+	if !strings.Contains(body, `"userId":"ann"`) || !strings.Contains(body, `"role":"viewer"`) {
+		t.Fatalf("unexpected JSON shape: %s", body)
+	}
+
+	// Nobody can change tasks any more, including the former manager.
+	writes := []struct{ user, method, path, body string }{
+		{"ann", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"ann", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"ann", "DELETE", "/projects/web/tasks/t1", ""},
+		{"ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"ivy", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"eve", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+	}
+	for _, w := range writes {
+		if code, _ := do(t, h, w.method, w.path, w.user, w.body); code != 403 {
+			t.Fatalf("%s %s %s: got %d want 403", w.user, w.method, w.path, code)
+		}
+	}
+	// Reads still work, and tasks are unchanged (assignees preserved).
+	code, body = do(t, h, "GET", "/projects/web/tasks/t1", "ben", "")
+	if code != 200 || !strings.Contains(body, `"status":"open"`) || !strings.Contains(body, `"assignee":"ben"`) {
+		t.Fatalf("got %d %s", code, body)
+	}
+	// Freezing again is no longer allowed: nobody is a manager.
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 403 {
+		t.Fatalf("refreeze: got %d want 403", code)
+	}
+}
