+// Manage applies the project-management rule: readable, manager (else 403),
+// not archived (else 409).
+func (s *projectScope) Manage() (ManageProject, error) {
+	err := s.as.a.st.read(func(st *state) error {
+		p, r, err := readable(st, s.as.actor, s.pid)
+		if err != nil {
+			return err
+		}
+		if r != RoleManager {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if p.archived {
+			return deny(ErrArchived, "project is archived")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &manageProject{ps: s}, nil
+}
+
 // ---- project capabilities ----------------------------------------------------
 
+// MemberView is the public representation of a project member.
+type MemberView struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// ManageProject is the manager-only capability for project-wide operations.
+type ManageProject interface {
+	ID() string
+	// Freeze demotes every member (managers included) to viewer, atomically,
+	// and returns the resulting members sorted by user ID.
+	Freeze() ([]MemberView, error)
+}
+
+type manageProject struct{ ps *projectScope }
+
+func (p *manageProject) ID() string { return p.ps.pid }
+
+func (p *manageProject) Freeze() ([]MemberView, error) {
+	out := []MemberView{}
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		pr := s.projects[p.ps.pid]
+		if pr.archived {
+			return deny(ErrArchived, "project is archived")
+		}
+		pr.frozen = true
+		s.projects[pr.id] = pr
+		for uid := range s.members[pr.id] {
+			s.members[pr.id][uid] = RoleViewer
+		}
+		out = s.membersOf(pr.id)
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return out, nil
+}
+
 // ReadProject may list and read the tasks of one project.
 type ReadProject interface {
 	ID() string
