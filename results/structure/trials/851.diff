+func TestMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager demotes", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 200},
+		{"manager promotes", "ann", "/projects/web/members/dan", `{"role":"manager"}`, 200},
+		{"manager demotes manager", "ann", "/projects/web/members/ivy", `{"role":"contributor"}`, 200},
+		{"contributor", "ben", "/projects/web/members/cat", `{"role":"viewer"}`, 403},
+		{"viewer", "dan", "/projects/web/members/cat", `{"role":"viewer"}`, 403},
+		{"org admin non-member", "eve", "/projects/web/members/cat", `{"role":"viewer"}`, 403},
+		{"non member", "hal", "/projects/web/members/cat", `{"role":"viewer"}`, 404},
+		{"other org", "gus", "/projects/web/members/cat", `{"role":"viewer"}`, 404},
+		{"manager of other project", "ivy", "/projects/legacy/members/ben", `{"role":"viewer"}`, 404},
+		{"anonymous", "", "/projects/web/members/cat", `{"role":"viewer"}`, 401},
+		{"target not member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"invalid role", "ann", "/projects/web/members/ben", `{"role":"owner"}`, 400},
+		{"bad body", "ann", "/projects/web/members/ben", `nope`, 400},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"last manager", "ann", "/projects/legacy/members/ann", `{"role":"viewer"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+
+	t.Run("response and effect", func(t *testing.T) {
+		h := newServer()
+		code, body := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`)
+		if code != 200 {
+			t.Fatalf("got %d", code)
+		}
+		var got map[string]string
+		if err := json.Unmarshal([]byte(body), &got); err != nil || got["userId"] != "ben" || got["role"] != "viewer" {
+			t.Fatalf("body %q", body)
+		}
+		// ben is now a viewer: cannot write, and his task was unassigned.
+		if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 403 {
+			t.Fatalf("viewer patch got %d", code)
+		}
+		_, task := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+		if !strings.Contains(task, `"assignee":""`) {
+			t.Fatalf("task still assigned: %s", task)
+		}
+	})
+}
