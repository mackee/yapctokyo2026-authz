+func TestBulkRolesStatus(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager", "ann", "/projects/web/members", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 200},
+		{"manager changes self when another manager exists", "ann", "/projects/web/members", `{"roles":{"ann":"viewer"}}`, 200},
+		{"no-op change", "ann", "/projects/web/members", `{"roles":{"ben":"contributor"}}`, 200},
+		{"contributor", "ben", "/projects/web/members", `{"roles":{"cat":"viewer"}}`, 403},
+		{"viewer", "dan", "/projects/web/members", `{"roles":{"cat":"viewer"}}`, 403},
+		{"org admin", "eve", "/projects/web/members", `{"roles":{"cat":"viewer"}}`, 403},
+		{"non member", "hal", "/projects/web/members", `{"roles":{"cat":"viewer"}}`, 404},
+		{"other org", "gus", "/projects/web/members", `{"roles":{"cat":"viewer"}}`, 404},
+		{"anonymous", "", "/projects/web/members", `{"roles":{"cat":"viewer"}}`, 401},
+		{"missing project", "ann", "/projects/nope/members", `{"roles":{"cat":"viewer"}}`, 404},
+		{"archived", "ann", "/projects/legacy/members", `{"roles":{"ben":"viewer"}}`, 409},
+		{"invalid role", "ann", "/projects/web/members", `{"roles":{"ben":"admin"}}`, 400},
+		{"empty role", "ann", "/projects/web/members", `{"roles":{"ben":""}}`, 400},
+		{"target not a member", "ann", "/projects/web/members", `{"roles":{"hal":"viewer"}}`, 400},
+		{"target in other project only", "ivy", "/projects/ops/members", `{"roles":{"ben":"viewer"}}`, 400},
+		{"unknown user", "ann", "/projects/web/members", `{"roles":{"zed":"viewer"}}`, 400},
+		{"empty roles", "ann", "/projects/web/members", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "/projects/web/members", `{}`, 400},
+		{"malformed body", "ann", "/projects/web/members", `nope`, 400},
+		{"demote last manager", "ivy", "/projects/ops/members", `{"roles":{"ivy":"viewer"}}`, 409},
+		{"demote every manager", "ann", "/projects/web/members", `{"roles":{"ann":"viewer","ivy":"contributor"}}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestBulkRolesResponseAndEffect(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var members []struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &members); err != nil {
+		t.Fatal(err, body)
+	}
+	got := map[string]string{}
+	for _, m := range members {
+		got[m.UserID] = m.Role
+	}
+	want := map[string]string{"ann": "manager", "ben": "viewer", "cat": "contributor", "dan": "contributor", "ivy": "manager"}
+	if len(got) != len(want) || len(members) != len(want) {
+		t.Fatalf("got %v want %v", members, want)
+	}
+	for u, r := range want {
+		if got[u] != r {
+			t.Fatalf("%s: got %q want %q", u, got[u], r)
+		}
+	}
+	// The new roles are enforced.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Fatalf("ben is now a viewer, create got %d", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("dan is now a contributor, create got %d", code)
+	}
+	// Other projects are untouched.
+	if code, _ := do(t, h, "PATCH", "/projects/legacy/tasks/t5", "ben", `{"status":"done"}`); code != 409 {
+		t.Fatalf("legacy membership changed? got %d", code)
+	}
+}
+
+func TestBulkRolesAllOrNothing(t *testing.T) {
+	h := newServer()
+	// ben is valid, hal is not a member: nothing may change.
+	if code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","hal":"viewer"}}`); code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	// ben is valid, the role for dan is invalid.
+	if code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"root"}}`); code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	// Would leave the project without a manager.
+	if code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","ann":"viewer","ivy":"viewer"}}`); code != 409 {
+		t.Fatalf("got %d want 409", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 200 {
+		t.Fatalf("ben must still be a contributor, create got %d", code)
+	}
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{}}`)
+	_ = body
+	if code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+}
