+
+// removeMemberAggregate removes one member from one project. The member's
+// tasks in that project are unassigned in the same change, so that no task is
+// left with an assignee who is not a member.
+type removeMemberAggregate struct {
+	membership membershipRecord
+	tasks      []taskRecord // the member's tasks in the project
+}
+
+func loadRemoveMember(x *tx, projectID, userID string) (*removeMemberAggregate, error) {
+	m, ok := x.findMembership(projectID, userID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	return &removeMemberAggregate{membership: m, tasks: m.AssignedTasks(x)}, nil
+}
+
+func (a *removeMemberAggregate) validate() error { return nil }
+
+func (a *removeMemberAggregate) apply(x *tx) {
+	for i := range a.tasks {
+		a.tasks[i].Unassign(x)
+	}
+	a.membership.Destroy(x)
+}
