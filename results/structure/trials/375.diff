+
+// ---- member capabilities -------------------------------------------------------
+
+// ManageMember is the manager-only capability for one project member.
+type ManageMember interface {
+	// Remove takes the user out of the project. Tasks the user was assigned to
+	// in this project are unassigned in the same change.
+	Remove() error
+}
+
+type memberScope struct {
+	ps  *projectScope
+	uid string
+}
+
+// Manage applies the read rule, then requires that the target is a member of
+// the project (else 404), the actor is a manager (else 403), and the project is
+// not archived (else 409).
+func (s *memberScope) Manage() (ManageMember, error) {
+	err := s.ps.as.a.db.view(func(x *tx) error {
+		p, r, err := readable(x, s.ps.as.actor, s.ps.pid)
+		if err != nil {
+			return err
+		}
+		if _, ok := x.findMembership(s.ps.pid, s.uid); !ok {
+			return deny(ErrNotFound, "not found")
+		}
+		if r != RoleManager {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if p.Archived {
+			return deny(ErrArchived, "project is archived")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &manageMember{ms: s}, nil
+}
+
+type manageMember struct{ ms *memberScope }
+
+func (m *manageMember) Remove() error {
+	return m.ms.ps.as.a.db.update(func(x *tx) error {
+		agg, err := loadRemoveMember(x, m.ms.ps.pid, m.ms.uid)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		agg.apply(x)
+		return nil
+	})
+}
