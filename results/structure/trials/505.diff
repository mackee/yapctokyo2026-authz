+		{"create by former manager", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"create by former contributor", "cat", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"edit own task", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`, 403},
+		{"edit as former manager", "ivy", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"delete as former manager", "ann", "DELETE", "/projects/web/tasks/t1", "", 403},
+		{"second freeze", "ann", "POST", "/projects/web/freeze", "", 403},
+		{"read still works", "dan", "GET", "/projects/web/tasks/t1", "", 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
