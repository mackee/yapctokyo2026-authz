+func TestUpdateMemberRolesAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager changes roles", "ann", "web", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 200},
+		{"manager promotes", "ann", "web", `{"roles":{"cat":"manager"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"ben":"viewer"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"ben":"viewer"}}`, 403},
+		{"manager of ops", "ivy", "ops", `{"roles":{"cat":"viewer"}}`, 200},
+		{"viewer of ops", "ann", "ops", `{"roles":{"cat":"viewer"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"ben":"viewer"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"ben":"viewer"}}`, 404},
+		{"unknown project", "ann", "nope", `{"roles":{"ben":"viewer"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"ben":"viewer"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"invalid role", "ann", "web", `{"roles":{"ben":"owner"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"malformed body", "ann", "web", `{"roles":`, 400},
+		{"target not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"target in another org", "ann", "web", `{"roles":{"ann":"viewer","gus":"viewer"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRoles(t *testing.T) {
+	srv := newServer()
+	code, body := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []Member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []Member{
+		{UserID: "ann", Role: "manager"},
+		{UserID: "ben", Role: "viewer"},
+		{UserID: "cat", Role: "contributor"},
+		{UserID: "dan", Role: "contributor"},
+		{UserID: "ivy", Role: "manager"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("member %d: got %v want %v", i, got[i], want[i])
+		}
+	}
+
+	// dan is a contributor now: may create tasks.
+	if code, body := do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("promoted dan create: got %d: %s", code, body)
+	}
+	// ben is a viewer now: may not.
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Fatalf("demoted ben create: got %d want 403", code)
+	}
+	// Demoting ben unassigns his task t1 (viewers cannot be assignees).
+	if code, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ann", ""); code != 200 || !strings.Contains(body, `"assignee":""`) {
+		t.Fatalf("t1 after demotion: got %d: %s", code, body)
+	}
+}
+
+func TestUpdateMemberRolesAllOrNothing(t *testing.T) {
+	srv := newServer()
+	// hal is not a member: the whole request fails, cat's change included.
+	if code, _ := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"cat":"viewer","hal":"manager"}}`); code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	// cat is still a contributor (can create) and still holds t2.
+	if code, body := do(t, srv, "POST", "/projects/web/tasks", "cat", `{"title":"x"}`); code != 200 {
+		t.Fatalf("cat create: got %d: %s", code, body)
+	}
+	if code, body := do(t, srv, "GET", "/projects/web/tasks/t2", "ann", ""); code != 200 || !strings.Contains(body, `"assignee":"cat"`) {
+		t.Fatalf("t2 after failed request: got %d: %s", code, body)
+	}
+}
