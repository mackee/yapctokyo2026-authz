+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes self", "eve", "/orgs/acme/users/eve", 204},
+		{"org member, not admin", "ann", "/orgs/acme/users/ben", 403},
+		{"viewer of org, not admin", "dan", "/orgs/acme/users/ben", 403},
+		{"other org admin", "eve", "/orgs/globex/users/gus", 404},
+		{"other org member", "gus", "/orgs/acme/users/ben", 404},
+		{"user of other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	srv := newServer()
+
+	// ben: member of web and legacy, assigned t1 (web) and t5 (legacy).
+	if code, body := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 || body != "" {
+		t.Fatalf("remove ben: got %d %q", code, body)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben still reads web: got %d", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/legacy/tasks/t5", "ben", ""); code != 404 {
+		t.Fatalf("ben still reads legacy: got %d", code)
+	}
+	if _, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ann", ""); !strings.Contains(body, `"assignee":""`) {
+		t.Fatalf("t1 should be unassigned, got %s", body)
+	}
+	if _, body := do(t, srv, "GET", "/projects/legacy/tasks/t5", "ann", ""); !strings.Contains(body, `"assignee":""`) {
+		t.Fatalf("t5 should be unassigned, got %s", body)
+	}
+
+	// Repeating the removal is fine.
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("repeat remove ben: got %d", code)
+	}
+
+	// cat: member of web (t2 assigned) and ops (t4 assigned). Others are untouched.
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/cat", "eve", ""); code != 204 {
+		t.Fatalf("remove cat: got %d", code)
+	}
+	if _, body := do(t, srv, "GET", "/projects/ops/tasks/t4", "ann", ""); !strings.Contains(body, `"assignee":""`) {
+		t.Fatalf("t4 should be unassigned, got %s", body)
+	}
+	if _, body := do(t, srv, "GET", "/projects/web/tasks/t2", "ann", ""); !strings.Contains(body, `"assignee":""`) {
+		t.Fatalf("t2 should be unassigned, got %s", body)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ann", ""); code != 200 {
+		t.Fatalf("ann lost web: got %d", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "ivy", ""); code != 200 {
+		t.Fatalf("ivy lost ops: got %d", code)
+	}
+	if _, body := do(t, srv, "GET", "/projects/web/tasks/t3", "ann", ""); !strings.Contains(body, `"assignee":""`) {
+		t.Fatalf("t3 should stay unassigned, got %s", body)
+	}
+}
