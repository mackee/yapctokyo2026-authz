+
+// removeOrgUserAggregate removes one user from every project of one
+// organization.
+type removeOrgUserAggregate struct {
+	user        *User
+	memberships []*Membership // the user's memberships in the organization's projects
+	assigned    []*Task       // the user's tasks in the organization's projects; unassigned on removal
+}
+
+func loadRemoveOrgUser(ctx context.Context, tx DB, orgID, userID string) (*removeOrgUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != orgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	a := &removeOrgUserAggregate{user: u}
+
+	memberships, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, m := range memberships {
+		p, err := m.Project(ctx, tx)
+		if errors.Is(err, ErrNoRows) {
+			continue
+		} else if err != nil {
+			return nil, err
+		}
+		if p.Org == orgID {
+			a.memberships = append(a.memberships, m)
+		}
+	}
+
+	tasks, err := u.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, t := range tasks {
+		p, err := t.Project(ctx, tx)
+		if errors.Is(err, ErrNoRows) {
+			continue
+		} else if err != nil {
+			return nil, err
+		}
+		if p.Org == orgID {
+			a.assigned = append(a.assigned, t)
+		}
+	}
+	return a, nil
+}
+
+func (a *removeOrgUserAggregate) validate() error { return nil }
+
+func (a *removeOrgUserAggregate) apply(ctx context.Context, tx DB) error {
+	for _, t := range a.assigned {
+		if err := t.unassign(ctx, tx); err != nil {
+			return err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return err
+		}
+	}
+	return nil
+}
