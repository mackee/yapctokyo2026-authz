+// ---- operations -----------------------------------------------------------------------
+
+// RemoveFromOrg removes the user from every project of the organization (for
+// offboarding), all or nothing. The tasks the user is assigned to in those
+// projects are unassigned, so no task keeps an assignee who is no longer a
+// member. The user itself stays in the organization. Removing a user who is
+// already out of every project succeeds. Org admins only.
+func (*UserTable) RemoveFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanManageUsers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveOrgUser(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
