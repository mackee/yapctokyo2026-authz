+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"other project manager", "ivy", "ops", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"unknown project", "ann", "nope", 404},
+		{"archived", "ann", "legacy", 409},
+		{"anonymous", "", "web", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+	want := `[{"userId":"ann","role":"viewer"},{"userId":"ben","role":"viewer"},{"userId":"cat","role":"viewer"},{"userId":"dan","role":"viewer"},{"userId":"ivy","role":"viewer"}]`
+	if got := strings.TrimSpace(body); got != want {
+		t.Fatalf("got %s\nwant %s", got, want)
+	}
+}
+
+func TestFreezeBlocksTaskWrites(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "POST", "/projects/web/freeze", "ivy", ""); code != 200 {
+		t.Fatalf("freeze got %d want 200", code)
+	}
+	cases := []struct {
+		name, user, method, path, body string
+	}{
+		{"manager create", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"contributor create", "ben", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"manager update", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"contributor own update", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"manager delete", "ann", "DELETE", "/projects/web/tasks/t1", ""},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, srv, c.method, c.path, c.user, c.body)
+			if code != 403 {
+				t.Fatalf("got %d want 403", code)
+			}
+		})
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ann", ""); code != 200 {
+		t.Fatalf("read got %d want 200", code)
+	}
+	// Other projects are not affected by the freeze.
+	if code, _ := do(t, srv, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ops update got %d want 200", code)
+	}
+}
+
+func TestFreezeOnlyOnce(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("first freeze got %d want 200", code)
+	}
+	// Every manager was demoted by the first freeze, so nobody can freeze again.
+	if code, _ := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != 403 {
+		t.Fatalf("second freeze got %d want 403", code)
+	}
+}
