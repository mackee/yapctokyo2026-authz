+// MembershipTableMoveInput is the input of MembershipTable.Move.
+type MembershipTableMoveInput struct {
+	UserID      string
+	ToProjectID string
+}
+
+// Move moves a member of the authorized project to another project with the
+// same role. The actor must be able to manage the members of both projects;
+// a destination the actor cannot read is ErrNotFound. Tasks assigned to the
+// member in the source project become unassigned.
+func (*MembershipTable) Move(ctx context.Context, db DB, authz ProjectAuthz, in MembershipTableMoveInput) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if in.ToProjectID == "" {
+		return nil, deny(ErrInvalid, "toProjectId must not be empty")
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		toAuthz, err := NewProjectAuthz(ctx, tx, authz.Actor(), in.ToProjectID)
+		if err != nil {
+			return err
+		}
+		if err := toAuthz.CanManageMembers(); err != nil {
+			return err
+		}
+		agg, err := loadMoveMember(ctx, tx, authz.ProjectID(), in.ToProjectID, in.UserID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(ctx, tx); err != nil {
+			return err
+		}
+		m, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
