+// moveMemberAggregate moves one member from one project to another with the
+// same role.
+type moveMemberAggregate struct {
+	from   *Project
+	to     *Project
+	member *Membership // from.Membership(user)
+	tasks  []*Task     // member.AssignedTasks: unassigned, as the member leaves
+}
+
+func loadMoveMember(ctx context.Context, tx DB, fromID, toID, userID string) (*moveMemberAggregate, error) {
+	pt := NewProjectTable()
+	from, err := pt.Find(ctx, tx, fromID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	to, err := pt.Find(ctx, tx, toID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	m, err := from.Membership(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveMemberAggregate{from: from, to: to, member: m}
+	if a.tasks, err = m.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate(ctx context.Context, tx DB) error {
+	if a.from.ID == a.to.ID {
+		return deny(ErrInvalid, "destination must be a different project")
+	}
+	if a.from.Org != a.to.Org {
+		return deny(ErrInvalid, "project members must belong to the project's organization")
+	}
+	if !isValidRole(a.member.Role) {
+		return deny(ErrInvalid, "invalid role")
+	}
+	if _, err := a.to.Membership(ctx, tx, a.member.UserID); err == nil {
+		return deny(ErrInvalid, "user is already a member of the destination project")
+	} else if !errors.Is(err, ErrNoRows) {
+		return err
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	// The member leaves the project, so tasks assigned to them become unassigned
+	// (an assignee must be a member of the task's project).
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.member.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	moved := &Membership{ProjectID: a.to.ID, UserID: a.member.UserID, Role: a.member.Role}
+	if err := moved.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return moved, nil
+}
