+func (t *manageTask) MoveTo(toProjectID string) (TaskView, error) {
+	if toProjectID == t.ts.ps.pid {
+		return TaskView{}, deny(ErrInvalid, "task is already in that project")
+	}
+	// Acquiring Write on the target applies the full write rule there:
+	// readable (else 404), contributor or manager (else 403), not archived (else 409).
+	if _, err := t.ts.ps.as.Project(toProjectID).Write(); err != nil {
+		return TaskView{}, err
+	}
+	var v TaskView
+	err := t.ts.ps.as.a.st.tx(func(s *state) error {
+		cur := s.tasks[t.ts.tid]
+		// Re-admit the existing assignee for the target project. Rejects with
+		// 400 if that user is not a contributor or manager there.
+		a, err := admit(s, toProjectID, cur.assignee.user)
+		if err != nil {
+			return err
+		}
+		cur.project = toProjectID
+		cur.assignee = a
+		s.tasks[cur.id] = cur
+		v = cur.view()
+		return nil
+	})
+	return v, err
+}
