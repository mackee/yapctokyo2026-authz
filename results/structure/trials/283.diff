+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager of source and target", "ivy", "/projects/ops/tasks/t4", `{"toProjectId":"web"}`, 200},
+		{"unassigned task", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 200},
+		{"contributor cannot move", "ben", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"viewer source cannot move", "ann", "/projects/ops/tasks/t4", `{"toProjectId":"web"}`, 403},
+		{"org admin cannot move", "eve", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"non member source", "hal", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 404},
+		{"other org source", "gus", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 404},
+		{"target viewer", "ann", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"target non member", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"gx"}`, 404},
+		{"target missing", "ann", "/projects/web/tasks/t3", `{"toProjectId":"nope"}`, 404},
+		{"target archived", "ann", "/projects/web/tasks/t1", `{"toProjectId":"legacy"}`, 409},
+		{"assignee not in target", "ivy", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 400},
+		{"same project", "ivy", "/projects/web/tasks/t2", `{"toProjectId":"web"}`, 400},
+		{"task in other project", "ivy", "/projects/ops/tasks/t1", `{"toProjectId":"web"}`, 404},
+		{"empty target", "ivy", "/projects/web/tasks/t3", `{}`, 400},
+		{"anonymous", "", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsFieldsAndRelocates(t *testing.T) {
+	h := newServer()
+
+	code, body := do(t, h, "POST", "/projects/ops/tasks/t4/move", "ivy", `{"toProjectId":"web"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d body %s", code, body)
+	}
+	var moved Task
+	if err := json.Unmarshal([]byte(body), &moved); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t4", ProjectID: "web", Title: "Rotate keys", Status: "open", Assignee: "cat"}
+	if moved != want {
+		t.Fatalf("moved task = %+v, want %+v", moved, want)
+	}
+
+	// Visible under the new project, gone from the old one.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t4", "ann", ""); code != 200 {
+		t.Fatalf("new project get: got %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks/t4", "ivy", ""); code != 404 {
+		t.Fatalf("old project get: got %d want 404", code)
+	}
+
+	// The move is not repeatable from the old project.
+	if code, _ := do(t, h, "POST", "/projects/ops/tasks/t4/move", "ivy", `{"toProjectId":"web"}`); code != 404 {
+		t.Fatalf("second move: got %d want 404", code)
+	}
+}
