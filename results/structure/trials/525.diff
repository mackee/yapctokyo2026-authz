index 0000000..0ee3728
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,123 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestMoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager moves contributor", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 200},
+		{"manager moves viewer", "ivy", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 200},
+		{"contributor caller", "ben", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer caller", "dan", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 403},
+		{"manager of source only", "ann", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"non member caller", "hal", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"org admin caller", "eve", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"other org caller", "gus", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 401},
+		{"unknown user", "zed", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 401},
+		{"source missing", "ivy", "/projects/nope/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"source other org", "ivy", "/projects/gx/members/gus/move", `{"toProjectId":"ops"}`, 404},
+		{"source archived", "ann", "/projects/legacy/members/ben/move", `{"toProjectId":"web"}`, 409},
+		{"target missing", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"nope"}`, 404},
+		{"target other org", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"gx"}`, 404},
+		{"target archived", "ann", "/projects/web/members/ben/move", `{"toProjectId":"legacy"}`, 409},
+		{"target not manageable", "ben", "/projects/web/members/cat/move", `{"toProjectId":"legacy"}`, 403},
+		{"same project", "ivy", "/projects/ops/members/cat/move", `{"toProjectId":"ops"}`, 400},
+		{"missing target", "ivy", "/projects/web/members/ben/move", `{}`, 400},
+		{"invalid json", "ivy", "/projects/web/members/ben/move", `{`, 400},
+		{"member not in source", "ivy", "/projects/web/members/hal/move", `{"toProjectId":"ops"}`, 404},
+		{"unknown member", "ivy", "/projects/web/members/zed/move", `{"toProjectId":"ops"}`, 404},
+		{"already in target", "ivy", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveMemberResponse(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		wantUser, wantProject  string
+		wantRole               string
+	}{
+		{"contributor keeps role", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, "ben", "ops", "contributor"},
+		{"viewer keeps role", "ivy", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, "dan", "ops", "viewer"},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != 200 {
+				t.Fatalf("got %d: %s", code, body)
+			}
+			var got struct {
+				UserID    string `json:"userId"`
+				ProjectID string `json:"projectId"`
+				Role      string `json:"role"`
+			}
+			if err := json.Unmarshal([]byte(body), &got); err != nil {
+				t.Fatal(err)
+			}
+			if got.UserID != c.wantUser || got.ProjectID != c.wantProject || got.Role != c.wantRole {
+				t.Fatalf("got %+v, want user=%s project=%s role=%s", got, c.wantUser, c.wantProject, c.wantRole)
+			}
+		})
+	}
+}
+
+func TestMoveMemberEffects(t *testing.T) {
+	t.Run("membership moves", func(t *testing.T) {
+		s := newServer()
+		if code, body := do(t, s, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`); code != 200 {
+			t.Fatalf("move: got %d: %s", code, body)
+		}
+		if code, _ := do(t, s, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+			t.Fatalf("source still readable by moved user: got %d", code)
+		}
+		if code, _ := do(t, s, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+			t.Fatalf("target not readable by moved user: got %d", code)
+		}
+	})
+
+	t.Run("moved member keeps write rights", func(t *testing.T) {
+		s := newServer()
+		if code, body := do(t, s, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`); code != 200 {
+			t.Fatalf("move: got %d: %s", code, body)
+		}
+		if code, body := do(t, s, "POST", "/projects/ops/tasks", "ben", `{"title":"x","assignee":"ben"}`); code != 200 {
+			t.Fatalf("contributor create in target: got %d: %s", code, body)
+		}
+		if code, body := do(t, s, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 404 {
+			t.Fatalf("contributor create in source: got %d: %s", code, body)
+		}
+	})
+
+	t.Run("conflict leaves source membership intact", func(t *testing.T) {
+		s := newServer()
+		if code, _ := do(t, s, "POST", "/projects/web/members/cat/move", "ivy", `{"toProjectId":"ops"}`); code != 409 {
+			t.Fatalf("got %d want 409", code)
+		}
+		if code, _ := do(t, s, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+			t.Fatalf("source membership lost after failed move: got %d", code)
+		}
+	})
+
+	t.Run("caller keeps access to source", func(t *testing.T) {
+		s := newServer()
+		if code, _ := do(t, s, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`); code != 200 {
+			t.Fatalf("move: got %d", code)
+		}
+		if code, _ := do(t, s, "GET", "/projects/web/tasks", "ivy", ""); code != 200 {
+			t.Fatalf("manager lost source access: got %d", code)
+		}
+	})
+}
