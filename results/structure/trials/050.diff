+// OrgExists reports whether any user or project belongs to the organization.
+func (s *Store) OrgExists(orgID string) bool {
+	for _, u := range s.users {
+		if u.OrgID == orgID {
+			return true
+		}
+	}
+	for _, p := range s.projects {
+		if p.OrgID == orgID {
+			return true
+		}
+	}
+	return false
+}
+
+// Transfer moves a user to another organization. Project roles the user held
+// in the old organization's projects are dropped, and org-admin rights do not
+// carry over.
+func (s *Store) Transfer(userID, toOrgID string) {
+	u := s.users[userID]
+	for pid, p := range s.projects {
+		if p.OrgID == u.OrgID {
+			delete(s.members[pid], userID)
+		}
+	}
+	u.OrgID = toOrgID
+	u.OrgAdmin = false
+}
