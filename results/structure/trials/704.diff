+package main
+
+import "testing"
+
+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"non admin", "ann", "/orgs/acme/users/ben", 403},
+		{"other org admin", "gus", "/orgs/acme/users/ben", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"admin removes", "eve", "/orgs/acme/users/ben", 204},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/cat", "eve", ""); code != 204 {
+		t.Fatal(code)
+	}
+	// cat lost access to every project, and her tasks are unassigned.
+	for _, p := range []string{"web", "ops"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "cat", ""); code != 404 {
+			t.Fatalf("%s: cat got %d want 404", p, code)
+		}
+	}
+	for _, tid := range []string{"t2"} {
+		_, body := do(t, h, "GET", "/projects/web/tasks/"+tid, "ann", "")
+		if want := `"assignee":""`; !contains(body, want) {
+			t.Fatalf("%s: %s", tid, body)
+		}
+	}
+	// Others are untouched; globex is unaffected.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatal(code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatal(code)
+	}
+}
+
+func TestRemoveOrgUserArchived(t *testing.T) {
+	h := newServer()
+	do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", "")
+	if code, _ := do(t, h, "GET", "/projects/legacy/tasks", "ben", ""); code != 404 {
+		t.Fatalf("got %d want 404", code)
+	}
+}
+
+func contains(s, sub string) bool {
+	for i := 0; i+len(sub) <= len(s); i++ {
+		if s[i:i+len(sub)] == sub {
+			return true
+		}
+	}
+	return false
+}
