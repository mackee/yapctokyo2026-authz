+// OrgAuthz is what the actor may do in one organization.
+type OrgAuthz struct {
+	actor Actor
+	org   string
+}
+
+// OrgID returns the organization the object is bound to ("" for the zero value).
+func (a OrgAuthz) OrgID() string { return a.org }
+
+// CanTransferUsers returns nil if the actor may move users out of the
+// organization: org admins of that organization only (else ErrForbidden).
+func (a OrgAuthz) CanTransferUsers() error {
+	if a.org == "" || a.actor.org != a.org || !a.actor.orgAdmin {
+		return deny(ErrForbidden, "forbidden")
+	}
+	return nil
+}
+
 // ---- building authorization objects -------------------------------------------------
 
+// NewOrgAuthz builds the actor's authorization object for one organization.
+// Organizations other than the actor's own are ErrNotFound.
+func NewOrgAuthz(_ context.Context, _ DB, act Actor, orgID string) (OrgAuthz, error) {
+	if orgID == "" || orgID != act.org {
+		return OrgAuthz{}, deny(ErrNotFound, "not found")
+	}
+	return OrgAuthz{actor: act, org: orgID}, nil
+}
