+// UserTable is the users table.
 type UserTable struct{}
 
+// OrgExists reports whether any user or project belongs to the organization.
+func (*UserTable) OrgExists(ctx context.Context, db DB, orgID string) (bool, error) {
+	var n int
+	if err := db.QueryRowContext(ctx,
+		`SELECT (SELECT COUNT(*) FROM users WHERE org_id = ?) + (SELECT COUNT(*) FROM projects WHERE org_id = ?)`,
+		orgID, orgID).Scan(&n); err != nil {
+		return false, err
+	}
+	return n > 0, nil
+}
+
+// TransferUserInput is the input of UserTable.Transfer.
+type TransferUserInput struct {
+	ToOrgID string
+}
+
+// Transfer moves the user, who must belong to the authorized organization, to
+// another organization. The user's project memberships and task assignments
+// (all in the old organization) are removed and the org admin flag is cleared,
+// all or nothing.
+func (ut *UserTable) Transfer(ctx context.Context, db DB, authz OrgAuthz, userID string, in TransferUserInput) (*User, error) {
+	if err := authz.CanTransferUsers(); err != nil {
+		return nil, err
+	}
+	if in.ToOrgID == "" {
+		return nil, deny(ErrInvalid, "toOrgId must not be empty")
+	}
+	var u *User
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadTransferUser(ctx, tx, authz.OrgID(), userID, in)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		u, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return u, nil
+}
+
 // NewUserTable returns the users table.
