+// MemberView is one member of a project and their role in it.
+type MemberView struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// ManageProject may change the roles of existing members of one project.
+// Only managers hold it.
+type ManageProject interface {
+	ReadProject
+	// SetRoles changes the roles of existing members, all or nothing: an empty
+	// map, an unknown role, or a user who is not a member of the project is
+	// ErrInvalid (400) and nothing changes. Members who end up without write
+	// access are unassigned from their tasks in the same commit. It returns the
+	// project's members after the change, sorted by user ID.
+	SetRoles(roles map[string]string) ([]MemberView, error)
+}
+
+type manageProject struct{ readProject }
+
+func (p *manageProject) SetRoles(roles map[string]string) ([]MemberView, error) {
+	if len(roles) == 0 {
+		return nil, deny(ErrInvalid, "roles must not be empty")
+	}
+	for _, r := range roles {
+		if !validRole(r) {
+			return nil, deny(ErrInvalid, "invalid role")
+		}
+	}
+	pid := p.ps.pid
+	var out []MemberView
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		for uid, role := range roles {
+			if _, ok := s.members[pid][uid]; !ok {
+				return deny(ErrInvalid, fmt.Sprintf("%s is not a member of the project", uid))
+			}
+			s.members[pid][uid] = role
+		}
+		// A task's assignee must stay a contributor or manager, so tasks of
+		// members who lost write access are unassigned in this same commit.
+		for id, t := range s.tasks {
+			if t.project == pid && t.assignee.user != "" && !isWriterRole(s.role(pid, t.assignee.user)) {
+				t.assignee = Assignee{project: pid}
+				s.tasks[id] = t
+			}
+		}
+		out = s.membersIn(pid)
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return out, nil
+}
