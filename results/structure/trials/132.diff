+func TestUpdateMembers(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager", "ann", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 200},
+		{"contributor", "ben", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 403},
+		{"org admin", "eve", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 401},
+		{"archived", "ann", "/projects/legacy/members", `{"roles":{"ben":"viewer"}}`, 409},
+		{"unknown member", "ann", "/projects/web/members", `{"roles":{"hal":"viewer"}}`, 400},
+		{"invalid role", "ann", "/projects/web/members", `{"roles":{"dan":"owner"}}`, 400},
+		{"empty roles", "ann", "/projects/web/members", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "/projects/web/members", `{}`, 400},
+		{"malformed body", "ann", "/projects/web/members", `{"roles":`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMembersResult(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []Member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []Member{
+		{UserID: "ann", Role: "manager"},
+		{UserID: "ben", Role: "viewer"},
+		{UserID: "cat", Role: "contributor"},
+		{UserID: "dan", Role: "contributor"},
+		{UserID: "ivy", Role: "manager"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+
+	// ben lost write access, so t1 (assigned to ben) is unassigned.
+	code, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("get task: %d", code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.Assignee != "" {
+		t.Fatalf("t1 still assigned to %q", task.Assignee)
+	}
+
+	// dan is now a contributor and can write.
+	code, _ = do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`)
+	if code != 201 {
+		t.Fatalf("dan create after promotion: got %d", code)
+	}
+}
+
+func TestUpdateMembersAllOrNothing(t *testing.T) {
+	h := newServer()
+	// cat is valid, but hal is not a member: the whole batch is rejected.
+	code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"cat":"viewer","hal":"viewer"}}`)
+	if code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	// An invalid role in the batch also rejects everything.
+	code, _ = do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"cat":"viewer","dan":"owner"}}`)
+	if code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+
+	// Nothing changed: cat is still a contributor and t1 is still assigned to ben.
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"viewer"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []Member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	for _, m := range got {
+		if m.UserID == "cat" && m.Role != "contributor" {
+			t.Fatalf("cat changed to %s by rejected batch", m.Role)
+		}
+	}
+	code, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 || !strings.Contains(body, `"assignee":"ben"`) {
+		t.Fatalf("t1 changed by rejected batch: %d %s", code, body)
+	}
+}
