--- /dev/null
+++ b/org_test.go
@@ -0,0 +1,83 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes user without roles", "eve", "/orgs/acme/users/hal", 204},
+		{"org admin removes self", "eve", "/orgs/acme/users/eve", 204},
+		{"project manager is not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"org admin of other org", "gus", "/orgs/acme/users/ben", 404},
+		{"org in path is not yours", "eve", "/orgs/globex/users/gus", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+
+	// ben is out of every acme project, archived included.
+	for _, path := range []string{"/projects/web/tasks", "/projects/legacy/tasks", "/projects/web/tasks/t1"} {
+		if code, _ := do(t, h, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("GET %s as removed user: got %d want 404", path, code)
+		}
+	}
+
+	// ben's tasks are unassigned; other people's tasks are untouched.
+	assignee := func(path string) string {
+		t.Helper()
+		code, body := do(t, h, "GET", path, "ann", "")
+		if code != 200 {
+			t.Fatalf("GET %s: got %d", path, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		return task.Assignee
+	}
+	if got := assignee("/projects/web/tasks/t1"); got != "" {
+		t.Fatalf("t1 assignee: got %q want unassigned", got)
+	}
+	if got := assignee("/projects/legacy/tasks/t5"); got != "" {
+		t.Fatalf("t5 assignee: got %q want unassigned", got)
+	}
+	if got := assignee("/projects/web/tasks/t2"); got != "cat" {
+		t.Fatalf("t2 assignee: got %q want cat", got)
+	}
+
+	// ben is no longer a member, so cannot be assigned in web.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ann", `{"title":"x","assignee":"ben"}`); code != 400 {
+		t.Fatalf("assign removed user: got %d want 400", code)
+	}
+
+	// Remaining members keep their access.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat list web: got %d want 200", code)
+	}
+
+	// Removing again is a no-op.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("second remove: got %d want 204", code)
+	}
+}
