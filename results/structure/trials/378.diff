+
+// AdminOrg is the org-admin capability for one organization.
+type AdminOrg interface {
+	// RemoveUser takes the user out of every project of the organization: the
+	// memberships are removed and the user's tasks in those projects are
+	// unassigned. Projects that are archived are included, so offboarding is
+	// not blocked by archiving. A user who is not in the organization is 404;
+	// removing a user who has no memberships is a no-op.
+	RemoveUser(userID string) error
 }
 
