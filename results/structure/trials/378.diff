@@ -136,6 +153,48 @@ func (s *actorScope) Actor() Actor { return s.actor }
 func (s *actorScope) Project(projectID string) ProjectScope {
 	return &projectScope{as: s, pid: projectID}
 }
+func (s *actorScope) Org(orgID string) OrgScope {
+	return &orgScope{as: s, oid: orgID}
+}
+
+type orgScope struct {
+	as  *actorScope
+	oid string
+}
+
+// Admin applies the org-admin rule: the organization is the actor's own (else
+// 404), and the actor is an org admin of it (else 403).
+func (s *orgScope) Admin() (AdminOrg, error) {
+	err := s.as.a.db.view(func(x *tx) error {
+		if s.as.actor.org != s.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		if !s.as.actor.orgAdmin {
+			return deny(ErrForbidden, "forbidden")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &adminOrg{os: s}, nil
+}
+
+type adminOrg struct{ os *orgScope }
+
+func (o *adminOrg) RemoveUser(userID string) error {
+	return o.os.as.a.db.update(func(x *tx) error {
+		agg, err := loadRemoveOrgUser(x, o.os.oid, userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		agg.apply(x)
+		return nil
+	})
+}
 
