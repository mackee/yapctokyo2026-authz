+// removeOrgUserAggregate takes one user out of every project of one
+// organization: it removes the user's memberships there and unassigns the
+// user's tasks in those projects, so the assignee rule keeps holding.
+type removeOrgUserAggregate struct {
+	memberships []membershipRecord // the user's memberships in projects of the org
+}
+
+func loadRemoveOrgUser(x *tx, org, userID string) (*removeOrgUserAggregate, error) {
+	u, ok := x.findUser(userID)
+	if !ok || u.Org != org {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	a := &removeOrgUserAggregate{}
+	for _, m := range u.Memberships(x) {
+		p, ok := m.Project(x)
+		if !ok || p.Org != org {
+			continue
+		}
+		a.memberships = append(a.memberships, m)
+	}
+	return a, nil
+}
+
+func (a *removeOrgUserAggregate) validate() error { return nil }
+
+func (a *removeOrgUserAggregate) apply(x *tx) {
+	for _, m := range a.memberships {
+		for _, t := range m.AssignedTasks(x) {
+			t.Unassign(x)
+		}
+		m.Destroy(x)
+	}
+}
+
