+// changeRoleAggregate changes the role of one member of one project. A member
+// who is no longer a contributor or manager cannot be an assignee, so their
+// tasks in the project are unassigned.
+type changeRoleAggregate struct {
+	member *Membership
+	role   string
+	tasks  []*Task // member.AssignedTasks
+}
+
+func loadChangeRole(ctx context.Context, tx DB, projectID, userID, role string) (*changeRoleAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	tasks, err := m.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &changeRoleAggregate{member: m, role: role, tasks: tasks}, nil
+}
+
+func (a *changeRoleAggregate) validate() error {
+	if !validRoles[a.role] {
+		return deny(ErrInvalid, "invalid role")
+	}
+	return nil
+}
+
+func (a *changeRoleAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if !isWriterRole(a.role) {
+		for _, t := range a.tasks {
+			if err := t.unassign(ctx, tx); err != nil {
+				return nil, err
+			}
+		}
+	}
+	if err := a.member.changeRole(ctx, tx, a.role); err != nil {
+		return nil, err
+	}
+	return a.member, nil
+}
