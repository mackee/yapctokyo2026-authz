+func TestChangeRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager changes", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"manager self", "ann", "/projects/web/members/ann", `{"role":"viewer"}`, 200},
+		{"contributor", "ben", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"viewer", "dan", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"org admin", "eve", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"non member", "hal", "/projects/web/members/dan", `{"role":"viewer"}`, 404},
+		{"other org", "gus", "/projects/web/members/dan", `{"role":"viewer"}`, 404},
+		{"anonymous", "", "/projects/web/members/dan", `{"role":"viewer"}`, 401},
+		{"target not member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"invalid role", "ann", "/projects/web/members/dan", `{"role":"boss"}`, 400},
+		{"missing role", "ann", "/projects/web/members/dan", `{}`, 400},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestChangeRoleEffects(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got struct{ UserID, Role string }
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.UserID != "ben" || got.Role != "viewer" {
+		t.Fatalf("unexpected response %s", body)
+	}
+	// The new role takes effect: ben can no longer write.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Fatalf("demoted member create: got %d want 403", code)
+	}
+	// A viewer cannot be an assignee, so ben's task in web was unassigned...
+	_, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.AssigneeID != "" {
+		t.Fatalf("t1 still assigned to %q", task.AssigneeID)
+	}
+	// ...but other members' tasks are untouched.
+	_, body = do(t, h, "GET", "/projects/web/tasks/t2", "ann", "")
+	json.Unmarshal([]byte(body), &task)
+	if task.AssigneeID != "cat" {
+		t.Fatalf("t2 assignee changed to %q", task.AssigneeID)
+	}
+}
