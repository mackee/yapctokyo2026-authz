+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"org member, not admin", "ann", "/orgs/acme/users/ben", 403},
+		{"viewer, not admin", "dan", "/orgs/acme/users/ben", 403},
+		{"admin of other org", "gus", "/orgs/acme/users/ben", 404},
+		{"admin, org does not exist", "eve", "/orgs/nope/users/ben", 404},
+		{"admin, target unknown", "eve", "/orgs/acme/users/zed", 404},
+		{"admin, target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"admin, target in other org (globex)", "eve", "/orgs/globex/users/ann", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("got %d want 204 body=%s", code, body)
+	}
+	// ben was a member of web and legacy (both acme) and loses access to both.
+	for _, p := range []string{"/projects/web/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, h, "GET", p, "ben", ""); code != 404 {
+			t.Fatalf("ben GET %s: got %d want 404", p, code)
+		}
+	}
+	// Other members are untouched.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ann", ""); code != 200 {
+		t.Fatalf("ann GET web: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat GET ops: got %d want 200", code)
+	}
+	// Removing again is fine: nothing left to remove, still 204.
+	if code, body := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("repeat: got %d want 204 body=%s", code, body)
+	}
+}
