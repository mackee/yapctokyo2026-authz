+func TestFreeze(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeEffects(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got []map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []string{"ann", "ben", "cat", "dan", "ivy"}
+	if len(got) != len(want) {
+		t.Fatalf("got %v", got)
+	}
+	for i, m := range got {
+		if m["userId"] != want[i] || m["role"] != "viewer" {
+			t.Fatalf("member %d: %v", i, m)
+		}
+	}
+
+	// Nobody can change the project's tasks any more, managers included.
+	for _, user := range []string{"ann", "ben", "ivy"} {
+		for _, r := range []struct{ method, path, body string }{
+			{"POST", "/projects/web/tasks", `{"title":"x"}`},
+			{"PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+			{"DELETE", "/projects/web/tasks/t1", ""},
+			{"POST", "/projects/web/freeze", ""},
+		} {
+			if code, _ := do(t, h, r.method, r.path, user, r.body); code != 403 {
+				t.Fatalf("%s %s %s: got %d want 403", user, r.method, r.path, code)
+			}
+		}
+	}
+	// Reads still work, and no assignee is left who is not a writer.
+	code, body = do(t, h, "GET", "/projects/web/tasks", "dan", "")
+	if code != 200 {
+		t.Fatal(code)
+	}
+	var tasks []Task
+	json.Unmarshal([]byte(body), &tasks)
+	for _, task := range tasks {
+		if task.AssigneeID != "" {
+			t.Fatalf("task %s still assigned to %s", task.ID, task.AssigneeID)
+		}
+	}
+	// Other projects are untouched.
+	if code, _ := do(t, h, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ops task: got %d", code)
+	}
+}
