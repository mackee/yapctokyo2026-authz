+func TestUpdateMembers(t *testing.T) {
+	const body = `{"roles":{"ben":"viewer","dan":"contributor"}}`
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager bulk", "ann", "web", body, 200},
+		{"manager single", "ivy", "web", `{"roles":{"cat":"manager"}}`, 200},
+		{"manager self", "ann", "web", `{"roles":{"ann":"contributor"}}`, 200},
+		{"contributor", "ben", "web", body, 403},
+		{"viewer", "dan", "web", body, 403},
+		{"org admin", "eve", "web", body, 403},
+		{"non member", "hal", "web", body, 404},
+		{"other org", "gus", "web", body, 404},
+		{"anonymous", "", "web", body, 401},
+		{"unknown user", "zed", "web", body, 401},
+		{"unknown project", "ann", "nope", body, 404},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"invalid role", "ann", "web", `{"roles":{"ben":"owner"}}`, 400},
+		{"target not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"invalid json", "ann", "web", `{`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMembersResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann",
+		`{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []member{
+		{"ann", "manager"},
+		{"ben", "viewer"},
+		{"cat", "contributor"},
+		{"dan", "contributor"},
+		{"ivy", "manager"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("got %v want %v", got, want)
+		}
+	}
+}
+
+func TestUpdateMembersTakesEffect(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer"}}`); code != 200 {
+		t.Fatalf("update: got %d", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Fatalf("demoted ben create: got %d want 403", code)
+	}
+}
+
+// A bulk update that fails on any entry must leave every role unchanged.
+// "ben" sorts before "hal", so ben's change is applied first and must be rolled back.
+func TestUpdateMembersAllOrNothing(t *testing.T) {
+	bodies := []string{
+		`{"roles":{"ben":"viewer","hal":"viewer"}}`, // hal is not a member
+		`{"roles":{"ben":"viewer","cat":"owner"}}`,  // invalid role
+	}
+	for _, b := range bodies {
+		h := newServer()
+		if code, _ := do(t, h, "PUT", "/projects/web/members", "ann", b); code != 400 {
+			t.Fatalf("%s: got %d want 400", b, code)
+		}
+		// ben is still a contributor, so he can still create tasks.
+		if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 200 {
+			t.Fatalf("%s: ben create after failed update: got %d want 200", b, code)
+		}
+	}
+}
