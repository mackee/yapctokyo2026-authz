+func TestSetRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager promotes viewer", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"manager demotes unassigned", "ivy", "/projects/ops/members/ivy", `{"role":"viewer"}`, 200},
+		{"manager demotes assignee in ops", "ivy", "/projects/ops/members/cat", `{"role":"viewer"}`, 400},
+		{"manager demotes assignee", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 400},
+		{"manager promotes assignee", "ann", "/projects/web/members/ben", `{"role":"manager"}`, 200},
+		{"target not member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"target unknown", "ann", "/projects/web/members/zed", `{"role":"viewer"}`, 404},
+		{"contributor", "ben", "/projects/web/members/dan", `{"role":"viewer"}`, 403},
+		{"viewer", "dan", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"org admin", "eve", "/projects/web/members/dan", `{"role":"viewer"}`, 403},
+		{"non member", "hal", "/projects/web/members/dan", `{"role":"viewer"}`, 404},
+		{"other org", "gus", "/projects/web/members/dan", `{"role":"viewer"}`, 404},
+		{"anonymous", "", "/projects/web/members/dan", `{"role":"viewer"}`, 401},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"manager"}`, 409},
+		{"invalid role", "ann", "/projects/web/members/dan", `{"role":"boss"}`, 400},
+		{"missing role", "ann", "/projects/web/members/dan", `{}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetRoleResponseAndEffect(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 2 || got["userId"] != "dan" || got["role"] != "contributor" {
+		t.Fatalf("unexpected response %s", body)
+	}
+	// dan is now a writer: may create a task assigned to themselves.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x","assignee":"dan"}`); code != 200 {
+		t.Fatalf("promoted member cannot write: %d", code)
+	}
+	// A demoted member can no longer write.
+	if code, _ := do(t, h, "PUT", "/projects/web/members/cat", "ann", `{"role":"viewer"}`); code != 400 {
+		t.Fatalf("cat has an assigned task, want 400 got %d", code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t2", "ann", `{"assignee":""}`); code != 200 {
+		t.Fatal(code)
+	}
+	if code, _ := do(t, h, "PUT", "/projects/web/members/cat", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("want 200 got %d", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "cat", `{"title":"x"}`); code != 403 {
+		t.Fatalf("demoted member can still write: %d", code)
+	}
+}
