+func TestFreeze(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"missing project", "ann", "nope", 404},
+		{"anonymous", "", "web", 401},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResponseAndEffect(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var members []map[string]string
+	if err := json.Unmarshal([]byte(body), &members); err != nil {
+		t.Fatal(err)
+	}
+	got := map[string]string{}
+	for _, m := range members {
+		if len(m) != 2 {
+			t.Fatalf("unexpected fields: %v", m)
+		}
+		got[m["userId"]] = m["role"]
+	}
+	if len(members) != 5 || len(got) != 5 {
+		t.Fatalf("want 5 members, got %s", body)
+	}
+	for _, u := range []string{"ann", "ben", "cat", "dan", "ivy"} {
+		if got[u] != "viewer" {
+			t.Fatalf("%s role = %q, want viewer", u, got[u])
+		}
+	}
+
+	// Nobody can change tasks in the frozen project any more, managers included.
+	writes := []struct{ user, method, path, body string }{
+		{"ann", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"ivy", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"ann", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"ben", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"ann", "DELETE", "/projects/web/tasks/t1", ""},
+	}
+	for _, w := range writes {
+		if code, _ := do(t, h, w.method, w.path, w.user, w.body); code != 403 {
+			t.Fatalf("%s %s %s after freeze: got %d want 403", w.user, w.method, w.path, code)
+		}
+	}
+	// Reads still work, and other projects are untouched.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("read after freeze: %d", code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`); code != 200 {
+		t.Fatalf("other project affected: %d", code)
+	}
+	// A second freeze is refused: nobody is a manager any more.
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 403 {
+		t.Fatalf("second freeze: %d", code)
+	}
+}
