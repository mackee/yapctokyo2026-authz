+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager", "ann", "/projects/web/freeze", 200},
+		{"other manager", "ivy", "/projects/web/freeze", 200},
+		{"contributor", "ben", "/projects/web/freeze", 403},
+		{"viewer", "dan", "/projects/web/freeze", 403},
+		{"org admin", "eve", "/projects/web/freeze", 403},
+		{"non member", "hal", "/projects/web/freeze", 404},
+		{"other org", "gus", "/projects/web/freeze", 404},
+		{"anonymous", "", "/projects/web/freeze", 401},
+		{"unknown user", "zed", "/projects/web/freeze", 401},
+		{"archived", "ann", "/projects/legacy/freeze", 409},
+		{"unknown project", "ann", "/projects/nope/freeze", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := `[{"userId":"ann","role":"viewer"},{"userId":"ben","role":"viewer"},{"userId":"cat","role":"viewer"},{"userId":"dan","role":"viewer"},{"userId":"ivy","role":"viewer"}]`
+	var wantList []struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(want), &wantList); err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != len(wantList) {
+		t.Fatalf("got %s want %s", body, want)
+	}
+	for i := range got {
+		if got[i] != wantList[i] {
+			t.Fatalf("got %s want %s", body, want)
+		}
+	}
+}
+
+func TestFreezeBlocksTaskChanges(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d: %s", code, body)
+	}
+
+	writes := []struct {
+		name, user, method, path, body string
+	}{
+		{"contributor own task", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"contributor other task", "cat", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"former manager", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"former manager reassign", "ivy", "PATCH", "/projects/web/tasks/t3", `{"assignee":"cat"}`},
+		{"former manager create", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"former manager delete", "ann", "DELETE", "/projects/web/tasks/t1", ""},
+		{"second freeze", "ann", "POST", "/projects/web/freeze", ""},
+	}
+	for _, c := range writes {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, h, c.method, c.path, c.user, c.body)
+			if code != 403 {
+				t.Fatalf("got %d want 403", code)
+			}
+		})
+	}
+
+	// Reads still work, and the tasks are unchanged, assignees included.
+	code, body := do(t, h, "GET", "/projects/web/tasks", "ann", "")
+	if code != 200 {
+		t.Fatalf("list: got %d", code)
+	}
+	var tasks []Task
+	if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+		t.Fatal(err)
+	}
+	if len(tasks) != 3 {
+		t.Fatalf("want 3 tasks, got %d", len(tasks))
+	}
+	if tasks[0].ID != "t1" || tasks[0].Status != "open" || tasks[0].Assignee != "ben" {
+		t.Fatalf("t1 changed: %+v", tasks[0])
+	}
+	if tasks[1].ID != "t2" || tasks[1].Status != "doing" || tasks[1].Assignee != "cat" {
+		t.Fatalf("t2 changed: %+v", tasks[1])
+	}
+
+	// Other projects are not affected.
+	if code, body := do(t, h, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ops write: got %d: %s", code, body)
+	}
+}
+
+func TestFreezeKeepsAssignees(t *testing.T) {
+	// ops has a contributor assignee (cat). Freezing must not be rejected by the
+	// assignee invariant, and the assignment stays in place.
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/ops/freeze", "ivy", ""); code != 200 {
+		t.Fatalf("freeze: got %d: %s", code, body)
+	}
+	code, body := do(t, h, "GET", "/projects/ops/tasks/t4", "ann", "")
+	if code != 200 {
+		t.Fatalf("get: got %d", code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.Assignee != "cat" {
+		t.Fatalf("assignee changed: %+v", task)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`); code != 403 {
+		t.Fatalf("got %d want 403", code)
+	}
+}
