+// ManageProject may change the membership of one project.
+type ManageProject interface {
+	ID() string
+	// Freeze moves every member of the project to the viewer role, managers
+	// included, and marks the project frozen. Afterwards nobody holds a writer
+	// role there, so no task can be changed; reads still work. Tasks keep their
+	// assignees. It returns the members after the change, sorted by user ID.
+	Freeze() ([]Member, error)
+}
+
+// Member is one project member and the role they hold in it.
+type Member struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+type manageProject struct{ ps *projectScope }
+
+func (p *manageProject) ID() string { return p.ps.pid }
+
+func (p *manageProject) Freeze() ([]Member, error) {
+	var out []Member
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		proj := s.projects[p.ps.pid]
+		proj.frozen = true
+		s.projects[p.ps.pid] = proj
+		for uid := range s.members[p.ps.pid] {
+			s.members[p.ps.pid][uid] = RoleViewer
+		}
+		out = s.membersOf(p.ps.pid)
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return out, nil
+}
+
 type readProject struct{ ps *projectScope }
 
 func (p *readProject) ID() string { return p.ps.pid }
