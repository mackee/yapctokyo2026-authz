+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"contributor own task", "cat", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 200},
+		{"manager any task", "ivy", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 200},
+		{"manager unassigned", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 200},
+		{"contributor not assignee", "cat", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"manager in source only", "ann", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 403},
+		{"viewer in source", "ann", "/projects/ops/tasks/t4", `{"toProjectId":"web"}`, 403},
+		{"assignee not in destination", "ivy", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 400},
+		{"not member of destination", "ben", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 404},
+		{"other org destination", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"gx"}`, 404},
+		{"missing destination", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"nope"}`, 404},
+		{"archived destination", "ann", "/projects/web/tasks/t3", `{"toProjectId":"legacy"}`, 409},
+		{"archived source", "ann", "/projects/legacy/tasks/t5", `{"toProjectId":"web"}`, 409},
+		{"same project", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"web"}`, 400},
+		{"missing field", "ivy", "/projects/web/tasks/t3", `{}`, 400},
+		{"cross project task", "ivy", "/projects/web/tasks/t4", `{"toProjectId":"ops"}`, 404},
+		{"unauthenticated", "", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsFields(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/tasks/t2/move", "cat", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got Task
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", AssigneeID: "cat"}
+	if got != want {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t2", "ivy", ""); code != 404 {
+		t.Fatalf("old location: got %d want 404", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks/t2", "ivy", ""); code != 200 {
+		t.Fatalf("new location: got %d want 200", code)
+	}
+}
