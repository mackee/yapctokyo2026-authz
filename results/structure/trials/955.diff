+// OrgExists reports whether the organization has any user or project.
+func (*UserTable) OrgExists(ctx context.Context, db DB, orgID string) (bool, error) {
+	var n int
+	if err := db.QueryRowContext(ctx,
+		`SELECT (SELECT COUNT(*) FROM users WHERE org_id = ?) + (SELECT COUNT(*) FROM projects WHERE org_id = ?)`,
+		orgID, orgID).Scan(&n); err != nil {
+		return false, err
+	}
+	return n > 0, nil
+}
+
+// Transfer moves the user of the authorized organization to another
+// organization. The user leaves every project of the old organization
+// (memberships are removed and their assigned tasks become unassigned) and
+// loses org admin rights.
+func (ut *UserTable) Transfer(ctx context.Context, db DB, authz OrgAuthz, userID, toOrgID string) (*User, error) {
+	if err := authz.CanTransferUsers(); err != nil {
+		return nil, err
+	}
+	if toOrgID == "" || toOrgID == authz.OrgID() {
+		return nil, deny(ErrInvalid, "toOrgId must be a different organization")
+	}
+	var u *User
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadTransferUser(ctx, tx, authz.OrgID(), userID, toOrgID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		u, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return u, nil
+}
