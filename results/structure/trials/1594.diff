diff --git a/transfer_test.go b/transfer_test.go
new file mode 100644
index 0000000..85b3eda
--- /dev/null
+++ b/transfer_test.go
@@ -0,0 +1,80 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestTransfer(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 200},
+		{"user with no memberships", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 200},
+		{"manager is not admin", "ann", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 403},
+		{"anonymous", "", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 401},
+		{"other org's path", "eve", "/orgs/globex/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"user in another org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"missing toOrgId", "eve", "/orgs/acme/users/ben/transfer", `{}`, 400},
+		{"bad json", "eve", "/orgs/acme/users/ben/transfer", `{`, 400},
+		{"unknown target org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"nowhere"}`, 400},
+		{"same org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"acme"}`, 400},
+		{"bad body beats forbidden", "ann", "/orgs/acme/users/ben/transfer", `{}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferResult(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 2 || got["id"] != "ben" || got["orgId"] != "globex" {
+		t.Fatalf("unexpected body %s", body)
+	}
+
+	// ben left acme's projects: no access, and his tasks are unassigned.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben still reads web: %d", code)
+	}
+	_, list := do(t, h, "GET", "/projects/web/tasks", "ann", "")
+	var tasks []Task
+	json.Unmarshal([]byte(list), &tasks)
+	for _, task := range tasks {
+		if task.AssigneeID == "ben" {
+			t.Fatalf("task %s still assigned to ben", task.ID)
+		}
+	}
+	// The transferred user is gone from acme, so acme admins can't transfer again.
+	if code, _ := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"acme"}`); code != 404 {
+		t.Fatalf("second transfer: %d", code)
+	}
+}
+
+func TestTransferDropsOrgAdmin(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatal(code, body)
+	}
+	// eve is now a plain globex user: she can neither read gx nor transfer.
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "eve", ""); code != 404 {
+		t.Fatalf("eve reads gx: %d", code)
+	}
+	if code, _ := do(t, h, "POST", "/orgs/globex/users/gus/transfer", "eve", `{"toOrgId":"acme"}`); code != 403 {
+		t.Fatalf("eve transfers: %d", code)
+	}
+}
