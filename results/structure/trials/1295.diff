+// countAssignedTasks returns how many tasks in the project are assigned to the user.
+func countAssignedTasks(ctx context.Context, db *sql.DB, projectID, userID string) (int, error) {
+	var n int
+	err := db.QueryRowContext(ctx, `SELECT COUNT(*) FROM tasks WHERE project_id = ? AND assignee = ?`, projectID, userID).Scan(&n)
+	return n, err
+}
