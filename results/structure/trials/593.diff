+// transferUserAggregate moves one user to another organization. Project
+// members must belong to the project's organization, so the user leaves every
+// project of the old organization: memberships are removed and tasks assigned
+// to the user become unassigned.
+type transferUserAggregate struct {
+	user        *User
+	toOrg       string
+	memberships []*Membership
+	tasks       []*Task
+}
+
+func loadTransferUser(ctx context.Context, tx DB, orgID, userID, toOrg string) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) || (err == nil && u.Org != orgID) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &transferUserAggregate{user: u, toOrg: toOrg}
+	if a.memberships, err = u.Memberships(ctx, tx); err != nil {
+		return nil, err
+	}
+	if a.tasks, err = u.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if a.toOrg == "" || a.toOrg == a.user.Org {
+		return deny(ErrInvalid, "toOrgId must be a different organization")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.user.moveToOrg(ctx, tx, a.toOrg); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
