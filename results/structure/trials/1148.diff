@@ -0,0 +1,145 @@
+package main
+
+import (
+	"encoding/json"
+	"reflect"
+	"testing"
+)
+
+func TestFreezeAuth(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"manager of other project", "ivy", "ops", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"manager-less member", "ann", "ops", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"archived", "ann", "legacy", 409},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+		{"missing project", "ann", "nope", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []memberRole
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	// Every member of web, managers included, is now a viewer; sorted by user ID.
+	want := []memberRole{
+		{UserID: "ann", Role: RoleViewer},
+		{UserID: "ben", Role: RoleViewer},
+		{UserID: "cat", Role: RoleViewer},
+		{UserID: "dan", Role: RoleViewer},
+		{UserID: "ivy", Role: RoleViewer},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+	// The wire format is exactly [{"userId":...,"role":...}].
+	var raw []map[string]string
+	if err := json.Unmarshal([]byte(body), &raw); err != nil {
+		t.Fatal(err)
+	}
+	for _, m := range raw {
+		if len(m) != 2 || m["role"] != "viewer" || m["userId"] == "" {
+			t.Fatalf("unexpected member shape: %v", m)
+		}
+	}
+}
+
+func TestFreezeOnlyAffectsProject(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d", code)
+	}
+	// ops is untouched: cat is still a contributor there and ivy still manages it.
+	if code, _ := do(t, h, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ops contributor write: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/ops/freeze", "ivy", ""); code != 200 {
+		t.Fatalf("ops freeze by its manager: got %d want 200", code)
+	}
+}
+
+func TestFreezeBlocksTaskWrites(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d", code)
+	}
+	cases := []struct {
+		name, user, method, path, body string
+		want                           int
+	}{
+		{"former contributor own task", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`, 403},
+		{"former manager any task", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"former manager create", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"former manager delete", "ann", "DELETE", "/projects/web/tasks/t3", "", 403},
+		{"former manager freeze again", "ann", "POST", "/projects/web/freeze", "", 403},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, h, c.method, c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+	// Reads still work, and nothing changed.
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "dan", "")
+	if code != 200 {
+		t.Fatalf("read: got %d", code)
+	}
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Status != "open" {
+		t.Fatalf("task changed while frozen: %+v", task)
+	}
+}
+
+// The frozen flag is enforced on its own, not only through the viewer role.
+func TestFrozenFlagRejectsWritesEvenForManagers(t *testing.T) {
+	db, err := openSeededDB()
+	if err != nil {
+		t.Fatal(err)
+	}
+	h := newHandler(db)
+	if _, err := db.Exec(`UPDATE projects SET frozen = 1 WHERE id = 'web'`); err != nil {
+		t.Fatal(err)
+	}
+	// ann is still a manager here; the frozen flag alone must block her.
+	cases := []struct {
+		name, method, path, body string
+		want                     int
+	}{
+		{"create", "POST", "/projects/web/tasks", `{"title":"x"}`, 409},
+		{"update", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 409},
+		{"delete", "DELETE", "/projects/web/tasks/t3", "", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, h, c.method, c.path, "ann", c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
