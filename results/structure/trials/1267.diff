+// removeOrgUser offboards a user: removes them from every project of the org.
+func removeOrgUser(ctx tanukirpc.Context[*orgRegistry], _ struct{}) (*struct{}, error) {
+	reg := ctx.Registry()
+	uid := chi.URLParam(ctx.Request(), "uid")
+	if err := model.NewUserTable().RemoveFromOrg(ctx, reg.db, reg.authz, uid); err != nil {
+		return nil, err
+	}
+	ctx.Response().WriteHeader(http.StatusNoContent)
+	return nil, nil
+}
