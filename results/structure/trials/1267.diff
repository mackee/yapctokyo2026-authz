@@ -0,0 +1,109 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestRemoveOrgUserAuthz(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes", "eve", "/orgs/acme/users/ben", 204},
+		{"manager is not admin", "ann", "/orgs/acme/users/ben", 403},
+		{"member is not admin", "ben", "/orgs/acme/users/cat", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"other org", "gus", "/orgs/acme/users/ben", 404},
+		{"admin of other org's path", "eve", "/orgs/globex/users/gus", 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed", 404},
+		{"user of another org", "eve", "/orgs/acme/users/gus", 404},
+		{"user without memberships", "eve", "/orgs/acme/users/hal", 204},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+	// ann manages web and legacy and views ops; cat contributes to web and ops.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/cat", "eve", ""); code != 204 {
+		t.Fatalf("remove: %d", code)
+	}
+
+	// cat is no longer a member of any project (404 = not readable).
+	for _, p := range []string{"web", "ops"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "cat", ""); code != 404 {
+			t.Fatalf("cat still reads %s: %d", p, code)
+		}
+	}
+	// Other members are untouched.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben lost access: %d", code)
+	}
+
+	// Tasks assigned to cat (t2 in web, t4 in ops) are unassigned, the rest kept.
+	want := map[string]string{"t1": "ben", "t2": "", "t3": ""}
+	_, body := do(t, h, "GET", "/projects/web/tasks", "ann", "")
+	var tasks []Task
+	if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+		t.Fatal(err)
+	}
+	if len(tasks) != len(want) {
+		t.Fatalf("got %d tasks", len(tasks))
+	}
+	for _, task := range tasks {
+		if task.AssigneeID != want[task.ID] {
+			t.Fatalf("task %s assignee %q, want %q", task.ID, task.AssigneeID, want[task.ID])
+		}
+	}
+	_, body = do(t, h, "GET", "/projects/ops/tasks/t4", "ivy", "")
+	var t4 Task
+	if err := json.Unmarshal([]byte(body), &t4); err != nil {
+		t.Fatal(err)
+	}
+	if t4.AssigneeID != "" {
+		t.Fatalf("t4 still assigned to %q", t4.AssigneeID)
+	}
+
+	// Removing again is fine (the user is still in the org).
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/cat", "eve", ""); code != 204 {
+		t.Fatalf("second remove: %d", code)
+	}
+}
+
+func TestRemoveOrgUserArchivedProject(t *testing.T) {
+	h := newServer()
+	// ben is assigned t5 in the archived legacy project; offboarding still applies.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: %d", code)
+	}
+	_, body := do(t, h, "GET", "/projects/legacy/tasks/t5", "ann", "")
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "" {
+		t.Fatalf("t5 still assigned to %q", task.AssigneeID)
+	}
+	if code, _ := do(t, h, "GET", "/projects/legacy/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben still reads legacy: %d", code)
+	}
+}
+
+func TestRemoveOrgUserDeniedChangesNothing(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/cat", "ann", ""); code != 403 {
+		t.Fatalf("got %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t2", "cat", ""); code != 200 {
+		t.Fatalf("cat lost access: %d", code)
+	}
+}
