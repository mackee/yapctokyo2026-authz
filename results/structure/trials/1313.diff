diff --git a/transfer_test.go b/transfer_test.go
new file mode 100644
index 0000000..09178e2
--- /dev/null
+++ b/transfer_test.go
@@ -0,0 +1,102 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestTransfer(t *testing.T) {
+	cases := []struct {
+		name, user, org, uid, body string
+		want                       int
+	}{
+		{"org admin transfers", "eve", "acme", "ben", `{"toOrgId":"globex"}`, 200},
+		{"manager is not org admin", "ann", "acme", "ben", `{"toOrgId":"globex"}`, 403},
+		{"contributor is not org admin", "ben", "acme", "cat", `{"toOrgId":"globex"}`, 403},
+		{"caller in other org", "gus", "acme", "ben", `{"toOrgId":"globex"}`, 404},
+		{"org path is not the caller's", "eve", "globex", "gus", `{"toOrgId":"acme"}`, 404},
+		{"target in other org", "eve", "acme", "gus", `{"toOrgId":"acme"}`, 404},
+		{"unknown target", "eve", "acme", "zed", `{"toOrgId":"globex"}`, 404},
+		{"unknown target org", "eve", "acme", "ben", `{"toOrgId":"initech"}`, 400},
+		{"missing target org", "eve", "acme", "ben", `{}`, 400},
+		{"same org", "eve", "acme", "ben", `{"toOrgId":"acme"}`, 400},
+		{"bad body", "eve", "acme", "ben", `{`, 400},
+		{"anonymous", "", "acme", "ben", `{"toOrgId":"globex"}`, 401},
+		{"unknown caller", "zed", "acme", "ben", `{"toOrgId":"globex"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/orgs/"+c.org+"/users/"+c.uid+"/transfer", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+	var got transferResponse
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.ID != "ben" || got.OrgID != "globex" {
+		t.Fatalf("got %+v", got)
+	}
+}
+
+func TestTransferSideEffects(t *testing.T) {
+	s := newServer()
+
+	if code, _ := do(t, s, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: got %d want 200", code)
+	}
+	// Ben is no longer in acme, so acme's admin cannot touch him again.
+	if code, _ := do(t, s, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"acme"}`); code != 404 {
+		t.Fatalf("second transfer: got %d want 404", code)
+	}
+	// Ben lost his acme project memberships.
+	if code, _ := do(t, s, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads web: got %d want 404", code)
+	}
+	// Being in globex does not grant access to globex projects without membership.
+	if code, _ := do(t, s, "GET", "/projects/gx/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads gx: got %d want 404", code)
+	}
+	// His assigned tasks are unassigned; other tasks keep their assignee.
+	code, body := do(t, s, "GET", "/projects/web/tasks", "ann", "")
+	if code != 200 {
+		t.Fatalf("list web: got %d", code)
+	}
+	var tasks []Task
+	if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+		t.Fatal(err)
+	}
+	for _, task := range tasks {
+		switch task.ID {
+		case "t1":
+			if task.Assignee != "" {
+				t.Fatalf("t1 still assigned to %q", task.Assignee)
+			}
+		case "t2":
+			if task.Assignee != "cat" {
+				t.Fatalf("t2 assignee changed to %q", task.Assignee)
+			}
+		}
+	}
+}
+
+func TestTransferDropsOrgAdmin(t *testing.T) {
+	s := newServer()
+
+	// Eve moves herself to globex. She must not keep acme's admin rights there.
+	if code, _ := do(t, s, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: got %d want 200", code)
+	}
+	if code, _ := do(t, s, "GET", "/projects/gx/tasks", "eve", ""); code != 404 {
+		t.Fatalf("eve reads gx: got %d want 404", code)
+	}
+}
