+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager removes viewer", "ann", "/projects/web/members/dan", 204},
+		{"manager removes manager", "ann", "/projects/web/members/ivy", 204},
+		{"contributor", "ben", "/projects/web/members/dan", 403},
+		{"viewer", "dan", "/projects/web/members/ivy", 403},
+		{"org admin", "eve", "/projects/web/members/dan", 403},
+		{"non member", "hal", "/projects/web/members/dan", 404},
+		{"other org", "gus", "/projects/web/members/dan", 404},
+		{"anonymous", "", "/projects/web/members/dan", 401},
+		{"not a member of the project", "ann", "/projects/web/members/hal", 404},
+		{"member of another project", "ivy", "/projects/ops/members/ben", 404},
+		{"member with assigned tasks", "ann", "/projects/web/members/ben", 400},
+		{"archived", "ann", "/projects/legacy/members/ben", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemovedMemberLosesAccess(t *testing.T) {
+	h := newServer()
+	code, _ := do(t, h, "DELETE", "/projects/web/members/dan", "ann", "")
+	if code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+	// dan is a viewer, not an org admin: once removed, the project is not readable.
+	code, _ = do(t, h, "GET", "/projects/web/tasks", "dan", "")
+	if code != 404 {
+		t.Fatalf("removed member read: got %d want 404", code)
+	}
+}
