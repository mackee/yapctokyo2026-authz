+
+func (s *server) setMemberRole(w http.ResponseWriter, r *http.Request) {
+	s.store.mu.Lock()
+	defer s.store.mu.Unlock()
+
+	user := s.store.User(r.Header.Get("X-User"))
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project := s.store.Project(r.PathValue("pid"))
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role := s.store.Role(project.ID, user.ID)
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req roleRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	if req.Role != RoleManager && req.Role != RoleContributor && req.Role != RoleViewer {
+		writeError(w, 400, "invalid role")
+		return
+	}
+	target := r.PathValue("uid")
+	if s.store.Role(project.ID, target) == "" {
+		writeError(w, 404, "not found")
+		return
+	}
+	s.store.SetRole(project.ID, target, req.Role)
+	writeJSON(w, 200, map[string]string{"userId": target, "role": req.Role})
+}
