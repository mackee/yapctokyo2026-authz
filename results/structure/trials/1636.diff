+// orgExists reports whether any user or project belongs to the org.
+// There is no organizations table, so an org exists once it has members or projects.
+func orgExists(ctx context.Context, db *sql.DB, orgID string) (bool, error) {
+	var exists bool
+	err := db.QueryRowContext(ctx, `SELECT EXISTS(SELECT 1 FROM users WHERE org_id = ?) OR EXISTS(SELECT 1 FROM projects WHERE org_id = ?)`, orgID, orgID).Scan(&exists)
+	return exists, err
+}
