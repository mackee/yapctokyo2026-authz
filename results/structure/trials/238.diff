+// MemberIDs returns the project's member IDs in sorted order.
+func (s *Store) MemberIDs(projectID string) []string {
+	var ids []string
+	for id := range s.members[projectID] {
+		ids = append(ids, id)
+	}
+	sort.Strings(ids)
+	return ids
+}
+
+// SetRoles applies all role changes or none. Every user must already be a
+// member, every role must be valid, and the project must keep a manager.
+// Tasks assigned to a member who is no longer a contributor/manager are
+// unassigned, preserving the "assignee can work on tasks" invariant.
+func (s *Store) SetRoles(projectID string, roles map[string]string) error {
+	current := s.members[projectID]
+	next := make(map[string]string, len(current))
+	for uid, r := range current {
+		next[uid] = r
+	}
+	for uid, r := range roles {
+		if _, ok := current[uid]; !ok {
+			return fmt.Errorf("%q is not a member of the project", uid)
+		}
+		if r != RoleManager && r != RoleContributor && r != RoleViewer {
+			return fmt.Errorf("invalid role %q for %q", r, uid)
+		}
+		next[uid] = r
+	}
+	managers := 0
+	for _, r := range next {
+		if r == RoleManager {
+			managers++
+		}
+	}
+	if managers == 0 {
+		return fmt.Errorf("project must keep at least one manager")
+	}
+	s.members[projectID] = next
+	for _, t := range s.tasks {
+		if t.ProjectID == projectID && t.Assignee != "" && next[t.Assignee] == RoleViewer {
+			t.Assignee = ""
+		}
+	}
+	return nil
+}
