+		})
+	}
+}
+
+func TestUpdateMembersResponseAndAtomicity(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got []map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]string{"ann": "manager", "ben": "viewer", "cat": "contributor", "dan": "contributor", "ivy": "manager"}
+	if len(got) != len(want) {
+		t.Fatalf("got %v", got)
+	}
+	for _, m := range got {
+		if want[m["userId"]] != m["role"] {
+			t.Fatalf("member %s: got %s want %s", m["userId"], m["role"], want[m["userId"]])
+		}
+	}
+	// ben is now a viewer: can no longer modify tasks, and lost the t1 assignment.
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 403 {
+		t.Fatalf("demoted member still writes: %d", code)
+	}
+	if _, b := do(t, h, "GET", "/projects/web/tasks/t1", "ann", ""); !strings.Contains(b, `"assignee":""`) {
+		t.Fatalf("t1 should be unassigned: %s", b)
+	}
+
+	// One bad entry must change nothing.
+	h = newServer()
+	if code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"bogus"}}`); code != 400 {
+		t.Fatalf("got %d", code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ben's role changed despite failed request: %d", code)
+	}
+}
