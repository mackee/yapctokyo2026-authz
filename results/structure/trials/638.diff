+// changeRoleAggregate changes the role of one member of one project.
+type changeRoleAggregate struct {
+	member        *Membership
+	role          string
+	managers      int     // managers in the project before the change
+	assignedTasks []*Task // tasks of the project assigned to the member
+}
+
+func loadChangeRole(ctx context.Context, tx DB, projectID, userID, role string) (*changeRoleAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &changeRoleAggregate{member: m, role: role}
+	proj, err := m.Project(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	members, err := proj.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, o := range members {
+		if o.Role == RoleManager {
+			a.managers++
+		}
+	}
+	if a.assignedTasks, err = m.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *changeRoleAggregate) validate() error {
+	if a.member.Role == RoleManager && a.role != RoleManager && a.managers <= 1 {
+		return deny(ErrInvalid, "a project must keep at least one manager")
+	}
+	if !isWriterRole(a.role) && len(a.assignedTasks) > 0 {
+		return deny(ErrInvalid, "member has assigned tasks; reassign them before making the member a viewer")
+	}
+	return nil
+}
+
+func (a *changeRoleAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.member.changeRole(ctx, tx, a.role); err != nil {
+		return nil, err
+	}
+	return a.member, nil
+}
