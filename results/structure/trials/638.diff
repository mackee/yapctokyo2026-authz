+// ChangeRole sets the role of a member of the project, all or nothing. The
+// target must already be a member (else ErrNotFound), the role must be valid
+// (else ErrInvalid), and the change must keep the project's invariants.
+func (*MembershipTable) ChangeRole(ctx context.Context, db DB, authz ProjectAuthz, userID, role string) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if role != RoleManager && role != RoleContributor && role != RoleViewer {
+		return nil, deny(ErrInvalid, "invalid role")
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadChangeRole(ctx, tx, authz.ProjectID(), userID, role)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		m, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
