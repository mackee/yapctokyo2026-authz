+// removeOrgUserAggregate removes one user from every project of an
+// organization and unassigns their tasks there (offboarding). The user row
+// itself stays.
+type removeOrgUserAggregate struct {
+	org         string
+	memberships []*Membership // the user's memberships in the organization's projects
+	tasks       []*Task       // the user's tasks in the organization's projects
+}
+
+func loadRemoveOrgUser(ctx context.Context, tx DB, orgID, userID string) (*removeOrgUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) || (err == nil && u.Org != orgID) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &removeOrgUserAggregate{org: orgID}
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, m := range ms {
+		if ok, err := inOrg(ctx, tx, m.Project, orgID); err != nil {
+			return nil, err
+		} else if ok {
+			a.memberships = append(a.memberships, m)
+		}
+	}
+	ts, err := u.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, t := range ts {
+		if ok, err := inOrg(ctx, tx, t.Project, orgID); err != nil {
+			return nil, err
+		} else if ok {
+			a.tasks = append(a.tasks, t)
+		}
+	}
+	return a, nil
+}
+
+// inOrg reports whether the project that find returns belongs to the organization.
+func inOrg(ctx context.Context, tx DB, find func(context.Context, DB) (*Project, error), orgID string) (bool, error) {
+	p, err := find(ctx, tx)
+	if errors.Is(err, ErrNoRows) {
+		return false, nil
+	} else if err != nil {
+		return false, err
+	}
+	return p.Org == orgID, nil
+}
+
+func (a *removeOrgUserAggregate) validate() error { return nil }
+
+// apply unassigns the tasks first, so an assignee is never left without a
+// membership, then removes the memberships.
+func (a *removeOrgUserAggregate) apply(ctx context.Context, tx DB) error {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
