@@ -0,0 +1,87 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestRemoveOrgUserStatus(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben", 204},
+		{"user without memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"org admin removes self", "eve", "/orgs/acme/users/eve", 204},
+		{"manager is not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown actor", "zed", "/orgs/acme/users/ben", 401},
+		{"other org", "gus", "/orgs/acme/users/ben", 404},
+		{"admin of other org", "eve", "/orgs/globex/users/gus", 404},
+		{"missing org", "eve", "/orgs/nope/users/ben", 404},
+		{"user in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+// Offboarding ben removes every membership (the archived project too) and
+// unassigns his tasks, and leaves everyone else alone.
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("got %d want 204", code)
+	}
+	// ben can no longer read the projects he was a member of.
+	for _, p := range []string{"web", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ben", ""); code != 404 {
+			t.Fatalf("ben reads %s: got %d want 404", p, code)
+		}
+	}
+	// his tasks are unassigned, the others keep their assignee.
+	want := map[string]string{"t1": "", "t2": "cat", "t3": ""}
+	_, body := do(t, h, "GET", "/projects/web/tasks", "ann", "")
+	var tasks []Task
+	if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+		t.Fatal(err)
+	}
+	for _, task := range tasks {
+		if task.AssigneeID != want[task.ID] {
+			t.Fatalf("%s assignee %q want %q", task.ID, task.AssigneeID, want[task.ID])
+		}
+	}
+	_, body = do(t, h, "GET", "/projects/legacy/tasks/t5", "ann", "")
+	var legacy Task
+	if err := json.Unmarshal([]byte(body), &legacy); err != nil {
+		t.Fatal(err)
+	}
+	if legacy.AssigneeID != "" {
+		t.Fatalf("t5 assignee %q want unassigned", legacy.AssigneeID)
+	}
+	// other members are untouched.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat reads web: got %d", code)
+	}
+	// the user row stays: ben still authenticates, he just sees no project.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code == 401 {
+		t.Fatal("ben was deleted")
+	}
+}
+
+// A refused removal changes nothing.
+func TestRemoveOrgUserDenied(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "ann", ""); code != 403 {
+		t.Fatalf("got %d want 403", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t1", "ben", ""); code != 200 {
+		t.Fatalf("ben lost access: got %d", code)
+	}
+}
