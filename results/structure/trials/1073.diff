+// transferUserAggregate moves one user to another organization. The user's
+// memberships in projects outside the target organization are removed, and the
+// tasks assigned to the user in those projects are unassigned, so no rule breaks.
+type transferUserAggregate struct {
+	user    *User
+	toOrg   *Org
+	leaving []*Membership // memberships in projects outside the target organization
+}
+
+func loadTransferUser(ctx context.Context, tx DB, fromOrgID, userID, toOrgID string) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != fromOrgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	o, err := NewOrgTable().Find(ctx, tx, toOrgID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "unknown organization")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &transferUserAggregate{user: u, toOrg: o}
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, m := range ms {
+		p, err := m.Project(ctx, tx)
+		if err != nil && !errors.Is(err, ErrNoRows) {
+			return nil, err
+		}
+		if p == nil || p.Org != o.ID {
+			a.leaving = append(a.leaving, m)
+		}
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if a.user.Org == a.toOrg.ID {
+		return deny(ErrInvalid, "user is already in that organization")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	for _, m := range a.leaving {
+		tasks, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		for _, t := range tasks {
+			if err := t.unassign(ctx, tx); err != nil {
+				return nil, err
+			}
+		}
+		if err := m.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.user.transferTo(ctx, tx, a.toOrg.ID); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
+
