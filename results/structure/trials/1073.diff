+// Transfer moves a user of the organization to another organization, all or
+// nothing. Only org admins may do it. A user outside the organization is 404.
+func (*UserTable) Transfer(ctx context.Context, db DB, authz OrgAuthz, userID string, in UserTableTransferInput) (*User, error) {
+	if err := authz.CanManageUsers(); err != nil {
+		return nil, err
