+func TestTransfer(t *testing.T) {
+	cases := []struct {
+		name, user, org, uid, body string
+		want                       int
+	}{
+		{"org admin", "eve", "acme", "cat", `{"toOrgId":"globex"}`, 200},
+		{"member of the org", "ann", "acme", "ben", `{"toOrgId":"globex"}`, 403},
+		{"viewer of the org", "dan", "acme", "ben", `{"toOrgId":"globex"}`, 403},
+		{"other org admin", "gus", "acme", "ben", `{"toOrgId":"globex"}`, 404},
+		{"path org is not caller's", "eve", "globex", "gus", `{"toOrgId":"acme"}`, 404},
+		{"anonymous", "", "acme", "ben", `{"toOrgId":"globex"}`, 401},
+		{"unknown user", "zed", "acme", "ben", `{"toOrgId":"globex"}`, 401},
+		{"user not in org", "eve", "acme", "gus", `{"toOrgId":"acme"}`, 404},
+		{"unknown user id", "eve", "acme", "nobody", `{"toOrgId":"globex"}`, 404},
+		{"unknown target org", "eve", "acme", "ben", `{"toOrgId":"initech"}`, 400},
+		{"same org", "eve", "acme", "ben", `{"toOrgId":"acme"}`, 400},
+		{"missing target", "eve", "acme", "ben", `{}`, 400},
+		{"malformed body", "eve", "acme", "ben", `{"toOrgId":`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", "/orgs/"+c.org+"/users/"+c.uid+"/transfer", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestTransferResponse(t *testing.T) {
