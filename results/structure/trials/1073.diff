+// A transfer removes the user's memberships outside the target org, unassigns
+// the tasks they held there, and clears the org-admin flag.
+func TestTransferEffects(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer got %d body=%s", code, body)
+	}
+
+	// ben's task in web was assigned to him; it is now unassigned.
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("get task got %d body=%s", code, body)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "" {
+		t.Fatalf("task still assigned to %q", task.AssigneeID)
+	}
+
+	// ben is now in globex: acme projects are no longer readable by him.
+	for _, path := range []string{"/projects/web/tasks", "/projects/legacy/tasks/t5"} {
+		if code, _ := do(t, h, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("GET %s as ben: got %d want 404", path, code)
+		}
+	}
+
+	// ben is a plain member of globex now: he may not move anyone.
+	if code, _ := do(t, h, "POST", "/orgs/globex/users/gus/transfer", "ben", `{"toOrgId":"acme"}`); code != 403 {
+		t.Fatalf("ben transfers in globex: got %d want 403", code)
+	}
+	// And he is no longer an acme org admin, so acme users are out of reach.
+	if code, _ := do(t, h, "POST", "/orgs/acme/users/cat/transfer", "ben", `{"toOrgId":"globex"}`); code != 404 {
+		t.Fatalf("ben transfers in acme: got %d want 404", code)
+	}
+}
