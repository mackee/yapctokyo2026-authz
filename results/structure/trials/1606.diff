+// MembershipTableMoveInput is the input of MembershipTable.Move.
+type MembershipTableMoveInput struct {
+	UserID      string
+	ToProjectID string
+}
+
+// Move moves a member of the authorized project to another project, keeping the
+// role. The actor must be a manager of both projects (the destination must also
+// be readable by the actor, else ErrNotFound). Tasks the member was assigned in
+// the source project become unassigned.
+func (*MembershipTable) Move(ctx context.Context, db DB, authz ProjectAuthz, in MembershipTableMoveInput) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if in.ToProjectID == authz.ProjectID() {
+		return nil, deny(ErrInvalid, "destination must be a different project")
+	}
+	var moved *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		toAuthz, err := NewProjectAuthz(ctx, tx, authz.Actor(), in.ToProjectID)
+		if err != nil {
+			return err
+		}
+		if err := toAuthz.CanManageMembers(); err != nil {
+			return err
+		}
+		agg, err := loadMoveMember(ctx, tx, authz.ProjectID(), in.UserID, in.ToProjectID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		moved, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return moved, nil
+}
