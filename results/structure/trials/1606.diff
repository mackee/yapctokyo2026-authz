+// moveMemberAggregate moves one member from a project to another project of the
+// same organization, keeping the role. The member's tasks in the source project
+// are unassigned, since they would otherwise be assigned to a non-member.
+type moveMemberAggregate struct {
+	from  *Membership
+	user  *User
+	to    *Project
+	tasks []*Task // tasks of the source project assigned to the member
+	dup   bool    // the user is already a member of the destination
+}
+
+func loadMoveMember(ctx context.Context, tx DB, projectID, userID, toProjectID string) (*moveMemberAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	to, err := NewProjectTable().Find(ctx, tx, toProjectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	u, err := m.User(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	tasks, err := m.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	a := &moveMemberAggregate{from: m, user: u, to: to, tasks: tasks}
+	if _, err := to.Membership(ctx, tx, userID); err == nil {
+		a.dup = true
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.from.ProjectID == a.to.ID {
+		return deny(ErrInvalid, "destination must be a different project")
+	}
+	if a.user.Org != a.to.Org {
+		return deny(ErrInvalid, "member must belong to the project's organization")
+	}
+	if a.dup {
+		return deny(ErrInvalid, "user is already a member of the destination project")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.from.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	moved := &Membership{ProjectID: a.to.ID, UserID: a.from.UserID, Role: a.from.Role}
+	if err := moved.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return moved, nil
+}
+
