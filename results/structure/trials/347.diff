+// ---- organization capabilities ---------------------------------------------------
+
+type orgScope struct {
+	as  *actorScope
+	oid string
+}
+
+func (s *orgScope) ID() string { return s.oid }
+
+// Admin applies the org-admin rule: the org must be the actor's own (else 404),
+// and the actor must be an org admin of it (else 403).
+func (s *orgScope) Admin() (AdminOrg, error) {
+	if s.oid != s.as.actor.org {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if !s.as.actor.orgAdmin {
+		return nil, deny(ErrForbidden, "forbidden")
+	}
+	return &adminOrg{os: s}, nil
+}
+
+// AdminOrg may move users out of the organization it was acquired for.
+type AdminOrg interface {
+	ID() string
+	// TransferUser moves a user of this organization to toOrgID. The user loses
+	// org-admin status and every project membership in the old organization;
+	// tasks they were assigned in those projects become unassigned.
+	TransferUser(userID, toOrgID string) (UserView, error)
+}
+
+type adminOrg struct{ os *orgScope }
+
+func (o *adminOrg) ID() string { return o.os.oid }
+
+func (o *adminOrg) TransferUser(userID, toOrgID string) (UserView, error) {
+	if toOrgID == "" {
+		return UserView{}, deny(ErrInvalid, "toOrgId is required")
+	}
+	var v UserView
+	err := o.os.as.a.db.update(func(x *tx) error {
+		agg, err := loadTransferUser(x, o.os.oid, userID, toOrgID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		v = agg.save(x)
+		return nil
+	})
+	return v, err
+}
