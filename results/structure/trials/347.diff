index af9c3c6..f2fbc14 100644
--- a/internal/capability/aggregate.go
+++ b/internal/capability/aggregate.go
@@ -108,3 +108,66 @@ func loadDeleteTask(x *tx, taskID string) (*deleteTaskAggregate, error) {
 func (a *deleteTaskAggregate) validate() error { return nil }
 
 func (a *deleteTaskAggregate) save(x *tx) { a.task.destroy(x) }
+
+// transferUserAggregate moves one user from fromOrg to toOrg. Its memberships
+// in projects outside toOrg are dropped, and the tasks they were assigned in
+// those projects are unassigned, so the assignee rule keeps holding.
+type transferUserAggregate struct {
+	user     userRecord
+	toOrg    string
+	kept     []projectRecord    // projects of toOrg the user stays a member of
+	dropped  []membershipRecord // memberships in projects outside toOrg
+	unassign []taskRecord       // tasks of dropped projects assigned to the user
+}
+
+func loadTransferUser(x *tx, fromOrgID, userID, toOrgID string) (*transferUserAggregate, error) {
+	u, ok := x.findUser(userID)
+	if !ok || u.Org != fromOrgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if _, ok := x.findOrg(toOrgID); !ok {
+		return nil, deny(ErrInvalid, "organization does not exist")
+	}
+	if toOrgID == fromOrgID {
+		return nil, deny(ErrInvalid, "user already belongs to that organization")
+	}
+	a := &transferUserAggregate{user: u, toOrg: toOrgID}
+	for _, m := range x.membershipsOfUser(userID) {
+		p, ok := x.findProject(m.ProjectID)
+		if ok && p.Org == toOrgID {
+			a.kept = append(a.kept, p)
+			continue
+		}
+		a.dropped = append(a.dropped, m)
+		for _, t := range x.tasksIn(m.ProjectID) {
+			if t.AssigneeID == userID {
+				t.AssigneeID = ""
+				a.unassign = append(a.unassign, t)
+			}
+		}
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	// Model rule: project members belong to the project's organization.
+	for _, p := range a.kept {
+		if p.Org != a.toOrg {
+			return deny(ErrInvalid, "project members must belong to the project's organization")
+		}
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) save(x *tx) UserView {
+	for _, m := range a.dropped {
+		m.destroy(x)
+	}
+	for _, t := range a.unassign {
+		t.save(x)
+	}
+	a.user.Org = a.toOrg
+	a.user.OrgAdmin = false
+	a.user.save(x)
+	return UserView{ID: a.user.ID, OrgID: a.user.Org}
+}
