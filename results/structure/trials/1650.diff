+// TaskTableMoveInput is the input of TaskTable.Move.
+type TaskTableMoveInput struct {
+	ToProjectID string
+}
+
+// Move moves the task from its project to the destination project. The ID,
+// title, status and assignee are kept. The actor must be able to move the task
+// out of its project (CanMove) and to write in the destination (CanWrite). The
+// assignee must be a contributor or manager of the destination. A move to the
+// project the task is already in is rejected.
+func (*TaskTable) Move(ctx context.Context, db DB, authz TaskAuthz, in TaskTableMoveInput) (*Task, error) {
+	if err := authz.CanMove(); err != nil {
+		return nil, err
+	}
+	if in.ToProjectID == "" {
+		return nil, deny(ErrInvalid, "toProjectId must not be empty")
+	}
+	if in.ToProjectID == authz.Project().ProjectID() {
+		return nil, deny(ErrInvalid, "task is already in that project")
+	}
+	dest, err := NewProjectAuthz(ctx, db, authz.Project().Actor(), in.ToProjectID)
+	if err != nil {
+		return nil, err
+	}
+	if err := dest.CanWrite(); err != nil {
+		return nil, err
+	}
+	var t *Task
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveTask(ctx, tx, authz.TaskID(), dest.ProjectID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if t, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return t, nil
+}
