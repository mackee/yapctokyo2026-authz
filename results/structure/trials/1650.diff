+// moveTaskAggregate moves one task to another project, keeping its ID, title,
+// status and assignee.
+type moveTaskAggregate struct {
+	task     *Task
+	to       *Project
+	assignee *Membership // the assignee's membership in the destination; nil when unassigned or not a member
+}
+
+func loadMoveTask(ctx context.Context, tx DB, taskID, toProjectID string) (*moveTaskAggregate, error) {
+	t, err := NewTaskTable().Find(ctx, tx, taskID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	to, err := NewProjectTable().Find(ctx, tx, toProjectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveTaskAggregate{task: t, to: to}
+	if t.AssigneeID != "" {
+		m, err := to.Membership(ctx, tx, t.AssigneeID)
+		if errors.Is(err, ErrNoRows) {
+			// Not a member of the destination: validate reports it.
+		} else if err != nil {
+			return nil, err
+		} else {
+			a.assignee = m
+		}
+	}
+	return a, nil
+}
+
+func (a *moveTaskAggregate) validate() error {
+	if a.task.AssigneeID != "" && (a.assignee == nil || !isWriterRole(a.assignee.Role)) {
+		return deny(ErrInvalid, "assignee must be a contributor or manager of the destination project")
+	}
+	return nil
+}
+
+func (a *moveTaskAggregate) apply(ctx context.Context, tx DB) (*Task, error) {
+	if err := a.task.moveTo(ctx, tx, a.to.ID); err != nil {
+		return nil, err
+	}
+	return a.task, nil
+}
+
