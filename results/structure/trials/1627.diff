+package main
+
+import "testing"
+
+func TestRemoveOrgUserStatusCodes(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes user with no memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"project manager is not org admin", "ann", "/orgs/acme/users/cat", 403},
+		{"plain org member", "hal", "/orgs/acme/users/cat", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"caller from other org", "gus", "/orgs/acme/users/ben", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ben", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+// After removal the user is no longer a member of any project in the org,
+// and other members are unaffected.
+func TestRemoveOrgUserRemovesMemberships(t *testing.T) {
+	h := newServer()
+
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("delete: got %d want 204", code)
+	}
+
+	// ben was a contributor in web and legacy (archived); both must be gone.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben in web: got %d want 404", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/legacy/tasks/t5", "ben", ""); code != 404 {
+		t.Fatalf("ben in legacy: got %d want 404", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 404 {
+		t.Fatalf("ben create in web: got %d want 404", code)
+	}
+
+	// Other members keep their roles.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat in web: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ann", `{"title":"x"}`); code != 200 {
+		t.Fatalf("ann create in web: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "ann", ""); code != 200 {
+		t.Fatalf("ann in ops: got %d want 200", code)
+	}
+}
+
+// Removing a user only affects projects of that org; the other org is untouched.
+func TestRemoveOrgUserLeavesOtherOrgsAlone(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/gus", "eve", ""); code != 404 {
+		t.Fatalf("delete: got %d want 404", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatalf("gus in gx: got %d want 200", code)
+	}
+}
