+type Member struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func (s *Store) Members(projectID string) []Member {
+	out := []Member{}
+	for uid, role := range s.members[projectID] {
+		out = append(out, Member{UserID: uid, Role: role})
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].UserID < out[j].UserID })
+	return out
+}
+
+func (s *Store) SetRole(projectID, userID, role string) { s.members[projectID][userID] = role }
+
+// UnassignTasks clears the assignee of every task in the project assigned to userID.
+func (s *Store) UnassignTasks(projectID, userID string) {
+	for _, t := range s.tasks {
+		if t.ProjectID == projectID && t.Assignee == userID {
+			t.Assignee = ""
+		}
+	}
+}
