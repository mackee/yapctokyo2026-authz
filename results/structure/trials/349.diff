+// transferUserAggregate moves one user to another organization.
+type transferUserAggregate struct {
+	user        userRecord
+	toOrg       string
+	memberships []membershipRecord // every project the user belongs to
+}
+
+func loadTransferUser(x *tx, userID, fromOrg, toOrg string) (*transferUserAggregate, error) {
+	u, ok := x.findUser(userID)
+	if !ok || u.Org != fromOrg {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if !x.hasOrg(toOrg) {
+		return nil, deny(ErrInvalid, "unknown organization")
+	}
+	if toOrg == fromOrg {
+		return nil, deny(ErrInvalid, "user is already in that organization")
+	}
+	return &transferUserAggregate{user: u, toOrg: toOrg, memberships: x.membershipsOfUser(userID)}, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	// Project members must belong to the project's organization, so a user
+	// with any project membership cannot leave it until those are removed.
+	if len(a.memberships) > 0 {
+		return deny(ErrInvalid, "user is a member of projects; remove those memberships before transferring")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) save(x *tx) UserView {
+	a.user.Org = a.toOrg
+	// Org admin rights belong to the organization they were granted in.
+	a.user.OrgAdmin = false
+	a.user.save(x)
+	return UserView{ID: a.user.ID, OrgID: a.user.Org}
+}
+
