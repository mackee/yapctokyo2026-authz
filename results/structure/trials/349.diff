+func TestTransfer(t *testing.T) {
+	const ok = `{"toOrgId":"globex"}`
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin transfers", "eve", "/orgs/acme/users/hal/transfer", ok, 200},
+		{"org admin transfers self", "eve", "/orgs/acme/users/eve/transfer", ok, 200},
+		{"contributor in org", "ben", "/orgs/acme/users/hal/transfer", ok, 403},
+		{"viewer in org", "dan", "/orgs/acme/users/hal/transfer", ok, 403},
+		{"manager in org", "ann", "/orgs/acme/users/hal/transfer", ok, 403},
+		{"admin of other org", "gus", "/orgs/acme/users/hal/transfer", ok, 404},
+		{"anonymous", "", "/orgs/acme/users/hal/transfer", ok, 401},
+		{"unknown caller", "zed", "/orgs/acme/users/hal/transfer", ok, 401},
+		{"org not the caller's", "eve", "/orgs/globex/users/gus/transfer", ok, 404},
+		{"unknown org", "eve", "/orgs/nope/users/hal/transfer", ok, 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed/transfer", ok, 404},
+		{"user of other org", "eve", "/orgs/acme/users/gus/transfer", ok, 404},
+		{"user has project memberships", "eve", "/orgs/acme/users/ann/transfer", ok, 400},
+		{"unknown target org", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"nope"}`, 400},
+		{"empty target org", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":""}`, 400},
+		{"same org", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"acme"}`, 400},
+		{"malformed body", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":`, 400},
+		{"missing body", "eve", "/orgs/acme/users/hal/transfer", "", 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferEffects(t *testing.T) {
+	srv := newServer()
+
+	code, body := do(t, srv, "POST", "/orgs/acme/users/hal/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("transfer: got %d %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["id"] != "hal" || got["orgId"] != "globex" || len(got) != 2 {
+		t.Fatalf("response: %s", body)
+	}
+
+	// hal now belongs to globex: acme's projects are out of reach.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "hal", ""); code != 404 {
+		t.Fatalf("hal reads acme project after transfer: got %d", code)
+	}
+
+	// Org admin rights do not move with the user.
+	code, body = do(t, srv, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("self transfer: got %d %s", code, body)
+	}
+	if code, _ := do(t, srv, "POST", "/orgs/globex/users/hal/transfer", "eve", `{"toOrgId":"acme"}`); code != 403 {
+		t.Fatalf("former admin still admin in new org: got %d", code)
+	}
+}
