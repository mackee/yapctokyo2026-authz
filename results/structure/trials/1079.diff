+// the new role of each member, keyed by user ID.
+type MembershipTableUpdateRolesInput struct {
+	Roles map[string]string
+}
+
+// UpdateRoles changes the roles of several members of the project, all or
+// nothing: if any user is not a member, or any role is invalid, nothing
+// changes and the error is ErrInvalid. It returns the project's members after
+// the change, ordered by user ID.
+func (*MembershipTable) UpdateRoles(ctx context.Context, db DB, authz ProjectAuthz, in MembershipTableUpdateRolesInput) ([]*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var out []*Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadUpdateRoles(ctx, tx, authz.ProjectID(), in)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if out, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
