+func TestFreeze(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	want := `[{"userId":"ann","role":"viewer"},{"userId":"ben","role":"viewer"},{"userId":"cat","role":"viewer"},{"userId":"dan","role":"viewer"},{"userId":"ivy","role":"viewer"}]`
+	if strings.TrimSpace(body) != want {
+		t.Fatalf("got %s want %s", body, want)
+	}
+	// Nobody can modify tasks any more, managers included.
+	writes := []struct{ user, method, path, body string }{
+		{"ann", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"ivy", "PATCH", "/projects/web/tasks/t3", `{"status":"done"}`},
+		{"ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"ann", "DELETE", "/projects/web/tasks/t1", ""},
+	}
+	for _, w := range writes {
+		if code, _ := do(t, h, w.method, w.path, w.user, w.body); code != 403 {
+			t.Fatalf("%s %s by %s: got %d want 403", w.method, w.path, w.user, code)
+		}
+	}
+	// Still readable; other projects unaffected.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ann", ""); code != 200 {
+		t.Fatalf("read after freeze: %d", code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ops affected: %d", code)
+	}
+	// Assignees were cleared (assignees must be writers).
+	_, tb := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if !strings.Contains(tb, `"assignee":""`) {
+		t.Fatalf("assignee not cleared: %s", tb)
+	}
+}
+
+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"missing project", "ann", "nope", 404},
+		{"archived", "ann", "legacy", 409},
+		{"manager", "ivy", "ops", 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+	// A frozen project cannot be frozen again (no managers left).
+	h := newServer()
+	do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 403 {
+		t.Fatalf("refreeze: got %d want 403", code)
+	}
+}
