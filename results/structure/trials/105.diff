diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..00dd2e4
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,134 @@
+package main
+
+import (
+	"encoding/json"
+	"reflect"
+	"strings"
+	"testing"
+
+	"taskboard/internal/capability"
+)
+
+func TestImportMembers(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager imports", "ivy", "ops", `{"fromProjectId":"web"}`, 200},
+		{"manager imports into own project from itself", "ivy", "web", `{"fromProjectId":"web"}`, 200},
+		{"contributor", "ben", "legacy", `{"fromProjectId":"web"}`, 403},
+		{"viewer", "dan", "web", `{"fromProjectId":"ops"}`, 403},
+		{"manager of source only", "ann", "ops", `{"fromProjectId":"web"}`, 403},
+		{"org admin", "eve", "ops", `{"fromProjectId":"web"}`, 403},
+		{"non member of target", "hal", "web", `{"fromProjectId":"ops"}`, 404},
+		{"anonymous", "", "web", `{"fromProjectId":"ops"}`, 401},
+		{"unknown target", "ivy", "nope", `{"fromProjectId":"web"}`, 404},
+		{"archived target", "ann", "legacy", `{"fromProjectId":"web"}`, 409},
+		{"source not readable (not a member)", "ivy", "ops", `{"fromProjectId":"legacy"}`, 404},
+		{"source in other org", "ivy", "web", `{"fromProjectId":"gx"}`, 404},
+		{"source missing", "ivy", "web", `{"fromProjectId":"nope"}`, 404},
+		{"missing fromProjectId", "ivy", "web", `{}`, 400},
+		{"malformed body", "ivy", "web", `not json`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/members/import", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestImportMembersResult(t *testing.T) {
+	// web: ann manager, ben contributor, cat contributor, dan viewer, ivy manager
+	// ops (before): ann viewer, cat contributor, ivy manager
+	// ann keeps her viewer role in ops; the others are added with their web roles.
+	code, body := do(t, newServer(), "POST", "/projects/ops/members/import", "ivy", `{"fromProjectId":"web"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got []capability.MemberView
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []capability.MemberView{
+		{UserID: "ann", Role: "viewer"},
+		{UserID: "ben", Role: "contributor"},
+		{UserID: "cat", Role: "contributor"},
+		{UserID: "dan", Role: "viewer"},
+		{UserID: "ivy", Role: "manager"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+	if want := `{"userId":"ann","role":"viewer"}`; !strings.Contains(body, want) {
+		t.Fatalf("response %s does not use the userId/role JSON shape (want %s)", body, want)
+	}
+}
+
+func TestImportMembersKeepsExistingRole(t *testing.T) {
+	// ann is a viewer in ops but a manager in web; importing ops into web must
+	// not demote her.
+	code, body := do(t, newServer(), "POST", "/projects/web/members/import", "ivy", `{"fromProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got []capability.MemberView
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []capability.MemberView{
+		{UserID: "ann", Role: "manager"},
+		{UserID: "ben", Role: "contributor"},
+		{UserID: "cat", Role: "contributor"},
+		{UserID: "dan", Role: "viewer"},
+		{UserID: "ivy", Role: "manager"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+}
+
+func TestImportMembersPersistsAndIsIdempotent(t *testing.T) {
+	srv := newServer()
+
+	// ben is not a member of ops yet, so cannot read it.
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "ben", ""); code != 404 {
+		t.Fatalf("before import: got %d want 404", code)
+	}
+
+	code, first := do(t, srv, "POST", "/projects/ops/members/import", "ivy", `{"fromProjectId":"web"}`)
+	if code != 200 {
+		t.Fatalf("first import: got %d want 200: %s", code, first)
+	}
+
+	// The import is committed: ben can now read ops.
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+		t.Fatalf("after import: got %d want 200", code)
+	}
+
+	// Importing the same source again changes nothing.
+	code, second := do(t, srv, "POST", "/projects/ops/members/import", "ivy", `{"fromProjectId":"web"}`)
+	if code != 200 {
+		t.Fatalf("second import: got %d want 200: %s", code, second)
+	}
+	if first != second {
+		t.Fatalf("second import changed the members:\nfirst  %s\nsecond %s", first, second)
+	}
+}
+
+func TestImportMembersSourceUnchanged(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/projects/ops/members/import", "ivy", `{"fromProjectId":"web"}`); code != 200 {
+		t.Fatalf("import: got %d want 200: %s", code, body)
+	}
+	// web keeps its own members: dan is still a viewer there and can still read it.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "dan", ""); code != 200 {
+		t.Fatalf("web read after import: got %d want 200", code)
+	}
+	// ops' manager status for ivy is unaffected and ops members are readable.
+	if code, _ := do(t, srv, "POST", "/projects/ops/tasks", "ivy", `{"title":"x"}`); code != 201 {
+		t.Fatalf("ivy write to ops after import: got %d want 201", code)
+	}
+}
