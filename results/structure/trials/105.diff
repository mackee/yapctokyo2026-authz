+type manageProject struct{ readProject }
+
+func (p *manageProject) ImportMembers(from ReadProject) ([]MemberView, error) {
+	src, ok := from.(*readProject)
+	if !ok {
+		return nil, deny(ErrInvalid, "unknown source project")
+	}
+	var out []MemberView
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		dst := p.ps.pid
+		if s.members[dst] == nil {
+			s.members[dst] = map[string]string{}
+		}
+		for uid, role := range s.members[src.ps.pid] {
+			if _, exists := s.members[dst][uid]; !exists {
+				s.members[dst][uid] = role
+			}
+		}
+		out = s.membersIn(dst)
+		return nil
+	})
+	return out, err
+}
