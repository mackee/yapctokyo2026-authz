+// ---- project management ------------------------------------------------------
+
+// MemberView is one project member as returned by the API.
+type MemberView struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// ManageProject may change the membership of one project. Manager only.
+type ManageProject interface {
+	// Freeze makes the project read-only for everyone. Every member's role
+	// becomes viewer (managers included) and the project is marked frozen, so
+	// no task can be changed afterwards. Existing task assignments are kept.
+	// It returns the members after the change, sorted by user ID. Once frozen
+	// the project has no manager left, so a second Freeze is 403.
+	Freeze() ([]MemberView, error)
+}
+
+type manageProject struct{ ps *projectScope }
+
+func (p *manageProject) Freeze() ([]MemberView, error) {
+	var out []MemberView
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		// Re-check inside the transaction so the decision and the write are atomic.
+		if err := manageable(s, p.ps.as.actor, p.ps.pid); err != nil {
+			return err
+		}
+		for uid := range s.members[p.ps.pid] {
+			s.members[p.ps.pid][uid] = RoleViewer
+		}
+		pr := s.projects[p.ps.pid]
+		pr.frozen = true
+		s.projects[p.ps.pid] = pr
+		out = s.membersOf(p.ps.pid)
+		return nil
+	})
+	return out, err
+}
+
