new file mode 100644
index 0000000..4faad90
--- /dev/null
+++ b/freeze_test.go
@@ -0,0 +1,107 @@
+package main
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"other manager", "ivy", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	want := `[{"userId":"ann","role":"viewer"},{"userId":"ben","role":"viewer"},{"userId":"cat","role":"viewer"},{"userId":"dan","role":"viewer"},{"userId":"ivy","role":"viewer"}]`
+	if got := strings.TrimSpace(body); got != want {
+		t.Fatalf("body\n got: %s\nwant: %s", got, want)
+	}
+}
+
+func TestFreezeBlocksTaskChanges(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/projects/web/freeze", "ivy", ""); code != 200 {
+		t.Fatalf("freeze: got %d: %s", code, body)
+	}
+
+	cases := []struct {
+		name, method, user, path, body string
+		want                           int
+	}{
+		{"manager create", "POST", "ann", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"contributor create", "POST", "ben", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"manager patch", "PATCH", "ann", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"contributor patch own", "PATCH", "ben", "/projects/web/tasks/t1", `{"status":"done"}`, 403},
+		{"manager reassign", "PATCH", "ann", "/projects/web/tasks/t1", `{"assignee":"cat"}`, 403},
+		{"former manager patch", "PATCH", "ivy", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"manager delete", "DELETE", "ann", "/projects/web/tasks/t1", "", 403},
+		{"second freeze", "POST", "ivy", "/projects/web/freeze", "", 403},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, srv, c.method, c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+		})
+	}
+
+	// Reads still work, and nothing changed: t1 keeps its status and its assignee.
+	code, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ben", "")
+	if code != 200 {
+		t.Fatalf("get t1: got %d", code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.Status != "open" || task.Assignee != "ben" || task.Title != "Fix header" {
+		t.Fatalf("task changed by frozen project: %+v", task)
+	}
+	code, body = do(t, srv, "GET", "/projects/web/tasks", "dan", "")
+	if code != 200 {
+		t.Fatalf("list: got %d", code)
+	}
+	var tasks []Task
+	if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+		t.Fatal(err)
+	}
+	if len(tasks) != 3 {
+		t.Fatalf("want 3 tasks, got %d", len(tasks))
+	}
+}
+
+func TestFreezeKeepsOtherProjectsWritable(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/projects/web/freeze", "ivy", ""); code != 200 {
+		t.Fatalf("freeze: got %d: %s", code, body)
+	}
+	if code, body := do(t, srv, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ops patch after web freeze: got %d: %s", code, body)
+	}
+}
