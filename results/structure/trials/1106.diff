+func TestFreeze(t *testing.T) {
+	t.Run("manager freezes and nobody can write", func(t *testing.T) {
+		h := newServer()
+		code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+		if code != 200 {
+			t.Fatalf("got %d body=%s", code, body)
+		}
+		var got []map[string]string
+		if err := json.Unmarshal([]byte(body), &got); err != nil {
+			t.Fatal(err)
+		}
+		if len(got) != 5 {
+			t.Fatalf("members = %v", got)
+		}
+		for _, m := range got {
+			if m["role"] != "viewer" || m["userId"] == "" {
+				t.Fatalf("member = %v", m)
+			}
+		}
+		writes := []struct{ user, method, path, body string }{
+			{"ann", "POST", "/projects/web/tasks", `{"title":"x"}`},
+			{"ivy", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+			{"ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+			{"ann", "DELETE", "/projects/web/tasks/t1", ""},
+		}
+		for _, w := range writes {
+			if code, _ := do(t, h, w.method, w.path, w.user, w.body); code != 403 {
+				t.Fatalf("%s %s by %s: got %d want 403", w.method, w.path, w.user, code)
+			}
+		}
+		if code, _ := do(t, h, "GET", "/projects/web/tasks", "dan", ""); code != 200 {
+			t.Fatalf("read after freeze: got %d", code)
+		}
+		if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 403 {
+			t.Fatalf("second freeze: got %d want 403", code)
+		}
+	})
+	t.Run("other project is unaffected", func(t *testing.T) {
+		h := newServer()
+		do(t, h, "POST", "/projects/web/freeze", "ann", "")
+		if code, _ := do(t, h, "POST", "/projects/ops/tasks", "cat", `{"title":"x"}`); code != 200 {
+			t.Fatalf("got %d", code)
+		}
+	})
+	denied := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"contributor", "ben", "/projects/web/freeze", 403},
+		{"viewer", "dan", "/projects/web/freeze", 403},
+		{"org admin", "eve", "/projects/web/freeze", 403},
+		{"non member", "hal", "/projects/web/freeze", 404},
+		{"other org", "gus", "/projects/web/freeze", 404},
+		{"anonymous", "", "/projects/web/freeze", 401},
+		{"archived", "ann", "/projects/legacy/freeze", 409},
+	}
+	for _, c := range denied {
+		t.Run(c.name, func(t *testing.T) {
+			if code, _ := do(t, newServer(), "POST", c.path, c.user, ""); code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
