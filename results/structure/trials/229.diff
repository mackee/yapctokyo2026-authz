+// RemoveMember removes the user from the project and unassigns their tasks
+// there, since an assignee must be a contributor or manager of the project.
+func (s *Store) RemoveMember(projectID, userID string) {
+	delete(s.members[projectID], userID)
+	for _, t := range s.tasks {
+		if t.ProjectID == projectID && t.Assignee == userID {
+			t.Assignee = ""
+		}
+	}
+}
