+func TestMoveMember(t *testing.T) {
+	const move = `{"toProjectId":"ops"}`
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager of both", "ivy", "/projects/web/members/ben/move", move, 200},
+		{"viewer keeps role", "ivy", "/projects/web/members/dan/move", move, 200},
+		{"manager of source only", "ann", "/projects/web/members/ben/move", move, 403},
+		{"contributor caller", "ben", "/projects/web/members/cat/move", move, 403},
+		{"viewer caller", "dan", "/projects/web/members/ben/move", move, 403},
+		{"org admin caller", "eve", "/projects/web/members/ben/move", move, 403},
+		{"non member caller", "hal", "/projects/web/members/ben/move", move, 404},
+		{"other org caller", "gus", "/projects/web/members/ben/move", move, 404},
+		{"anonymous", "", "/projects/web/members/ben/move", move, 401},
+		{"unknown user", "zed", "/projects/web/members/ben/move", move, 401},
+		{"source missing", "ivy", "/projects/nope/members/ben/move", move, 404},
+		{"target not in source", "ivy", "/projects/web/members/hal/move", move, 404},
+		{"already in destination", "ivy", "/projects/web/members/cat/move", move, 409},
+		{"archived source", "ann", "/projects/legacy/members/ben/move", `{"toProjectId":"web"}`, 409},
+		{"archived destination", "ann", "/projects/web/members/dan/move", `{"toProjectId":"legacy"}`, 409},
+		{"same project", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"web"}`, 400},
+		{"missing destination", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"nope"}`, 404},
+		{"destination other org", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"gx"}`, 404},
+		{"missing toProjectId", "ivy", "/projects/web/members/ben/move", `{}`, 400},
+		{"bad body", "ivy", "/projects/web/members/ben/move", `not json`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveMemberResponseAndEffects(t *testing.T) {
+	s := newServer()
+
+	code, body := do(t, s, "POST", "/projects/web/members/dan/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move viewer: got %d: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]string{"userId": "dan", "projectId": "ops", "role": "viewer"}
+	if len(got) != len(want) {
+		t.Fatalf("response %s: want exactly keys userId, projectId, role", body)
+	}
+	for k, v := range want {
+		if got[k] != v {
+			t.Fatalf("response %s: %s = %q, want %q", body, k, got[k], v)
+		}
+	}
+
+	// dan is no longer a member of web, and is now a viewer of ops.
+	if code, _ := do(t, s, "GET", "/projects/web/tasks", "dan", ""); code != 404 {
+		t.Fatalf("dan reads web after move: got %d want 404", code)
+	}
+	if code, _ := do(t, s, "GET", "/projects/ops/tasks", "dan", ""); code != 200 {
+		t.Fatalf("dan reads ops after move: got %d want 200", code)
+	}
+	if code, _ := do(t, s, "POST", "/projects/ops/tasks", "dan", `{"title":"x"}`); code != 403 {
+		t.Fatalf("dan (viewer) writes ops after move: got %d want 403", code)
+	}
+
+	// ben keeps the contributor role in ops.
+	if code, _ := do(t, s, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`); code != 200 {
+		t.Fatalf("move contributor: got %d", code)
+	}
+	if code, _ := do(t, s, "POST", "/projects/ops/tasks", "ben", `{"title":"x","assignee":"ben"}`); code != 200 {
+		t.Fatalf("ben (contributor) creates in ops after move: got %d want 200", code)
+	}
+	if code, _ := do(t, s, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads web after move: got %d want 404", code)
+	}
+}
