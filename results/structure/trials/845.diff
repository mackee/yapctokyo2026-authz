+func TestMoveRejections(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"viewer caller", "dan", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"source manager, target viewer", "ann", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 403},
+		{"source contributor", "cat", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin caller", "eve", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 403},
+		{"non member caller", "hal", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 404},
+		{"other org caller", "gus", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 401},
+		{"unknown source", "ivy", "/projects/nope/members/dan/move", `{"toProjectId":"ops"}`, 404},
+		{"archived source", "ann", "/projects/legacy/members/ben/move", `{"toProjectId":"ops"}`, 409},
+		{"archived target", "ann", "/projects/web/members/dan/move", `{"toProjectId":"legacy"}`, 409},
+		{"target in other org", "ivy", "/projects/web/members/dan/move", `{"toProjectId":"gx"}`, 404},
+		{"target missing", "ivy", "/projects/web/members/dan/move", `{"toProjectId":"nope"}`, 404},
+		{"target not readable", "ivy", "/projects/web/members/dan/move", `{"toProjectId":"legacy"}`, 404},
+		{"user not in source", "ivy", "/projects/web/members/hal/move", `{"toProjectId":"ops"}`, 404},
+		{"already in target", "ivy", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 409},
+		{"same project", "ivy", "/projects/web/members/dan/move", `{"toProjectId":"web"}`, 400},
+		{"missing target", "ivy", "/projects/web/members/dan/move", `{}`, 400},
+		{"bad body", "ivy", "/projects/web/members/dan/move", `not json`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveMember(t *testing.T) {
+	srv := newServer()
+	code, body := do(t, srv, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d want 200: %s", code, body)
+	}
+	var got moveResponse
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.UserID != "ben" || got.ProjectID != "ops" || got.Role != RoleContributor {
+		t.Fatalf("unexpected response: %+v", got)
+	}
+	// ben is no longer a member of web...
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("source after move: got %d want 404", code)
+	}
+	// ...and is now a member of ops with the same role.
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+		t.Fatalf("target after move: got %d want 200", code)
+	}
+	// A second move from web is refused because ben is no longer there.
+	if code, _ := do(t, srv, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`); code != 404 {
+		t.Fatalf("repeat move: got %d want 404", code)
+	}
+}
