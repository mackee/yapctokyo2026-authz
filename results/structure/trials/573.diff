+func TestChangeMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager promotes viewer", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"manager demotes member without tasks", "ivy", "/projects/ops/members/ivy", `{"role":"viewer"}`, 200},
+		{"viewer in ops cannot change roles", "ann", "/projects/ops/members/ann", `{"role":"manager"}`, 403},
+		{"demote member with tasks", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 400},
+		{"contributor", "ben", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"viewer", "dan", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"org admin", "eve", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"manager"}`, 409},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"non member caller", "hal", "/projects/web/members/dan", `{"role":"viewer"}`, 404},
+		{"other org", "gus", "/projects/web/members/dan", `{"role":"viewer"}`, 404},
+		{"anonymous", "", "/projects/web/members/dan", `{"role":"viewer"}`, 401},
+		{"invalid role", "ann", "/projects/web/members/dan", `{"role":"owner"}`, 400},
+		{"missing role", "ann", "/projects/web/members/dan", `{}`, 400},
+		{"bad json", "ann", "/projects/web/members/dan", `{`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestChangeMemberRoleResult(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got struct{ UserID, Role string }
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.UserID != "dan" || got.Role != "contributor" {
+		t.Fatalf("unexpected response %s", body)
+	}
+	// The change is persisted: dan can now create tasks.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 201 && code != 200 {
+		t.Fatalf("dan could not write after promotion: %d", code)
+	}
+	// A demoted manager loses write access.
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ivy", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatal(code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ivy", `{"title":"x"}`); code != 403 {
+		t.Fatalf("demoted ivy got %d want 403", code)
+	}
+}
