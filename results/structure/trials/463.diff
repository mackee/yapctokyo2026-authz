+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"second manager", "ivy", "ops", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin without role", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+		{"unknown project", "ann", "nope", 404},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResponseAndScope(t *testing.T) {
+	srv := newServer()
+	code, body := do(t, srv, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []memberRole
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []memberRole{
+		{"ann", "viewer"}, {"ben", "viewer"}, {"cat", "viewer"},
+		{"dan", "viewer"}, {"ivy", "viewer"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+	if !strings.Contains(body, `{"userId":"ann","role":"viewer"}`) {
+		t.Fatalf("unexpected JSON shape: %s", body)
+	}
+
+	// Other projects keep their roles.
+	code, body = do(t, srv, "GET", "/projects/ops/tasks", "ivy", "")
+	if code != 200 {
+		t.Fatalf("ops read after freezing web: got %d: %s", code, body)
+	}
+	code, _ = do(t, srv, "PATCH", "/projects/ops/tasks/t4", "ivy", `{"status":"done"}`)
+	if code != 200 {
+		t.Fatalf("ops write after freezing web: got %d", code)
+	}
+}
+
+func TestFreezeBlocksTaskWrites(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d", code)
+	}
+	cases := []struct {
+		name, user, method, path, body string
+	}{
+		{"manager create", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"former manager update", "ivy", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"former contributor update own", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"former manager delete", "ann", "DELETE", "/projects/web/tasks/t1", ""},
+		{"former contributor create", "cat", "POST", "/projects/web/tasks", `{"title":"x"}`},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, srv, c.method, c.path, c.user, c.body)
+			if code != 403 {
+				t.Fatalf("got %d want 403", code)
+			}
+		})
+	}
+	// Reads still work, and the tasks are unchanged.
+	code, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ben", "")
+	if code != 200 || !strings.Contains(body, `"status":"open"`) {
+		t.Fatalf("read after freeze: %d %s", code, body)
+	}
+	// Nobody can freeze again: there is no manager left.
+	if code, _ := do(t, srv, "POST", "/projects/web/freeze", "ivy", ""); code != 403 {
+		t.Fatalf("second freeze: got %d want 403", code)
+	}
+}
