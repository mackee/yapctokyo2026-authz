+// moveMemberAggregate moves one member from one project to another, keeping the
+// role. The tasks assigned to the member in the source project are unassigned,
+// because an assignee must be a member of the task's project.
+type moveMemberAggregate struct {
+	from, to *Project
+	user     *User
+	member   *Membership // the member's membership in from
+	tasks    []*Task     // member.AssignedTasks: tasks of from assigned to the member
+}
+
+func loadMoveMember(ctx context.Context, tx DB, fromID, toID, userID string) (*moveMemberAggregate, error) {
+	pt := NewProjectTable()
+	from, err := pt.Find(ctx, tx, fromID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	to, err := pt.Find(ctx, tx, toID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	m, err := from.Membership(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	u, err := m.User(ctx, tx)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "member must be an existing user")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveMemberAggregate{from: from, to: to, user: u, member: m}
+	if _, err := to.Membership(ctx, tx, userID); err == nil {
+		return nil, deny(ErrInvalid, "user is already a member of the destination project")
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	if a.tasks, err = m.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.from.ID == a.to.ID {
+		return deny(ErrInvalid, "destination must be a different project")
+	}
+	if a.user.Org != a.to.Org {
+		return deny(ErrInvalid, "member must belong to the project's organization")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.member.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	moved := a.to.newMembership(a.member.UserID, a.member.Role)
+	if err := moved.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return moved, nil
+}
+
