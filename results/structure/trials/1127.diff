+//
+// Find and List* read rows. Move is the API operation: it moves a member from
+// the authorized project to another project.
 type MembershipTable struct{}
 
 // NewMembershipTable returns the memberships table.
 func NewMembershipTable() *MembershipTable { return &MembershipTable{} }
 
+// MembershipTableMoveInput is the input of MembershipTable.Move.
+type MembershipTableMoveInput struct {
+	ToProjectID string
+}
+
+// Move moves the user from the authorized project to the target project, with
+// the same role. The actor must be a manager of both projects (CanMoveMembers).
+// The user's tasks in the source project are unassigned, since the user is no
+// longer a member there. All or nothing.
+func (*MembershipTable) Move(ctx context.Context, db DB, authz ProjectAuthz, userID string, in MembershipTableMoveInput) (*Membership, error) {
+	if err := authz.CanMoveMembers(); err != nil {
+		return nil, err
+	}
+	if in.ToProjectID == authz.ProjectID() {
+		return nil, deny(ErrInvalid, "target project must differ from the source project")
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		target, err := NewProjectAuthz(ctx, tx, authz.Actor(), in.ToProjectID)
+		if err != nil {
+			return err
+		}
+		if err := target.CanMoveMembers(); err != nil {
+			return err
+		}
+		agg, err := loadMoveMember(ctx, tx, authz.ProjectID(), target.ProjectID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		m, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
