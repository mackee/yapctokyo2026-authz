+
+func moveTask(ctx tanukirpc.Context[*taskRegistry], _ struct{}) (*Task, error) {
+	reg := ctx.Registry()
+	t, err := reg.scope.Manage()
+	if err != nil {
+		return nil, err
+	}
+	var req moveRequest
+	if err := decodeBody(ctx.Request(), &req); err != nil || req.ToProjectID == "" {
+		return nil, errInvalidBody
+	}
+	dest, err := reg.project.Actor().Project(req.ToProjectID).Write()
+	if err != nil {
+		return nil, err
+	}
+	v, err := t.Move(dest)
+	if err != nil {
+		return nil, err
+	}
+	return &v, nil
+}
