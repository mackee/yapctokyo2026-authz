+func (t *manageTask) Move(dest WriteProject) (TaskView, error) {
+	if dest.ID() == t.ts.ps.pid {
+		return TaskView{}, deny(ErrInvalid, "task is already in that project")
+	}
+	var v TaskView
+	err := t.ts.ps.as.a.st.tx(func(s *state) error {
+		cur := s.tasks[t.ts.tid]
+		a, err := admit(s, dest.ID(), cur.assignee.user)
+		if err != nil {
+			return err
+		}
+		if dest.Role() == RoleContributor && a.user != "" && a.user != t.ts.ps.as.actor.id {
+			return deny(ErrForbidden, "contributors may only assign tasks to themselves")
+		}
+		cur.project = dest.ID()
+		cur.assignee = a
+		s.tasks[cur.id] = cur
+		v = cur.view()
+		return nil
+	})
+	return v, err
+}
