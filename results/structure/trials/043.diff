+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"other manager", "ivy", "ops", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+		{"missing project", "ann", "nope", 404},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	want := `[{"userId":"ann","role":"viewer"},{"userId":"ben","role":"viewer"},{"userId":"cat","role":"viewer"},{"userId":"dan","role":"viewer"},{"userId":"ivy","role":"viewer"}]`
+	if strings.TrimSpace(body) != want {
+		t.Fatalf("got body %s\nwant %s", body, want)
+	}
+}
+
+func TestFreezeBlocksTaskWrites(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze got %d: %s", code, body)
+	}
+
+	writes := []struct {
+		name, user, method, path, body string
+	}{
+		{"former manager create", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"former manager update", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"former manager delete", "ann", "DELETE", "/projects/web/tasks/t1", ""},
+		{"former contributor create", "ben", "POST", "/projects/web/tasks", `{"title":"x","assignee":"ben"}`},
+		{"former contributor update own", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"former contributor delete", "ben", "DELETE", "/projects/web/tasks/t1", ""},
+		{"org admin update", "eve", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+	}
+	for _, w := range writes {
+		t.Run(w.name, func(t *testing.T) {
+			code, _ := do(t, srv, w.method, w.path, w.user, w.body)
+			if code != 403 {
+				t.Fatalf("got %d want 403", code)
+			}
+		})
+	}
+
+	// Reads still work, and the tasks are unchanged.
+	code, body := do(t, srv, "GET", "/projects/web/tasks/t1", "dan", "")
+	if code != 200 {
+		t.Fatalf("read got %d", code)
+	}
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Status != "open" || task.Title != "Fix header" {
+		t.Fatalf("task changed despite freeze: %+v", task)
+	}
+}
+
+func TestFreezeLeavesOtherProjectsWritable(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze got %d: %s", code, body)
+	}
+	// ivy is a manager of both web and ops; only web is frozen.
+	if code, body := do(t, srv, "POST", "/projects/ops/tasks", "ivy", `{"title":"x"}`); code != 201 {
+		t.Fatalf("ops create got %d: %s", code, body)
+	}
+	if code, body := do(t, srv, "POST", "/projects/web/tasks", "ivy", `{"title":"x"}`); code != 403 {
+		t.Fatalf("web create got %d want 403: %s", code, body)
+	}
+}
+
+func TestFreezeTwiceIsRejected(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("first freeze got %d", code)
+	}
+	// ann is now a viewer, so a second freeze by her is forbidden.
+	if code, _ := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != 403 {
+		t.Fatalf("second freeze got %d want 403", code)
+	}
+}
