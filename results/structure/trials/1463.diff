+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes user with no memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"org admin removes self", "eve", "/orgs/acme/users/eve", 204},
+		{"manager is not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"caller in other org", "gus", "/orgs/acme/users/ben", 404},
+		{"unknown org", "eve", "/orgs/initech/users/ben", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+	app := h.(*appHandler)
+	count := func(t *testing.T, query string, args ...any) int {
+		t.Helper()
+		var n int
+		if err := app.db.QueryRow(query, args...).Scan(&n); err != nil {
+			t.Fatal(err)
+		}
+		return n
+	}
+	assignee := func(t *testing.T, id string) string {
+		t.Helper()
+		var a string
+		if err := app.db.QueryRow(`SELECT assignee FROM tasks WHERE id = ?`, id).Scan(&a); err != nil {
+			t.Fatal(err)
+		}
+		return a
+	}
+
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+
+	// ben leaves every acme project, including the archived one.
+	if n := count(t, `SELECT COUNT(*) FROM memberships WHERE user_id = 'ben'`); n != 0 {
+		t.Fatalf("ben still has %d memberships", n)
+	}
+	// ben's tasks in acme projects are unassigned; other assignments stay.
+	if a := assignee(t, "t1"); a != "" {
+		t.Fatalf("t1 assignee = %q, want unassigned", a)
+	}
+	if a := assignee(t, "t5"); a != "" {
+		t.Fatalf("t5 assignee = %q, want unassigned", a)
+	}
+	if a := assignee(t, "t2"); a != "cat" {
+		t.Fatalf("t2 assignee = %q, want cat", a)
+	}
+	// Other memberships and other orgs are untouched.
+	if n := count(t, `SELECT COUNT(*) FROM memberships WHERE user_id = 'cat'`); n != 2 {
+		t.Fatalf("cat has %d memberships, want 2", n)
+	}
+	if n := count(t, `SELECT COUNT(*) FROM memberships WHERE user_id = 'gus'`); n != 1 {
+		t.Fatalf("gus has %d memberships, want 1", n)
+	}
+	// ben can no longer see the project.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads web: got %d want 404", code)
+	}
+}
