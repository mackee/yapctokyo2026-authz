+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben", 204},
+		{"manager is not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"contributor is not org admin", "ben", "/orgs/acme/users/cat", 403},
+		{"org admin of another org", "gus", "/orgs/acme/users/ben", 404},
+		{"org admin of acme, path globex", "eve", "/orgs/globex/users/gus", 404},
+		{"target in another org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserRemovesAllMemberships(t *testing.T) {
+	h := newServer()
+	code, _ := do(t, h, "DELETE", "/orgs/acme/users/ann", "eve", "")
+	if code != 204 {
+		t.Fatalf("got %d want 204", code)
+	}
+	app := h.(*appHandler)
+
+	var n int
+	if err := app.db.QueryRow(`SELECT COUNT(*) FROM memberships WHERE user_id = 'ann'`).Scan(&n); err != nil {
+		t.Fatal(err)
+	}
+	if n != 0 {
+		t.Fatalf("ann still has %d memberships", n)
+	}
+	// Memberships in other orgs and other users are untouched.
+	if err := app.db.QueryRow(`SELECT COUNT(*) FROM memberships WHERE user_id = 'gus' AND project_id = 'gx'`).Scan(&n); err != nil {
+		t.Fatal(err)
+	}
+	if n != 1 {
+		t.Fatalf("gus's membership in gx changed")
+	}
+	if err := app.db.QueryRow(`SELECT COUNT(*) FROM memberships WHERE user_id = 'ben'`).Scan(&n); err != nil {
+		t.Fatal(err)
+	}
+	if n != 2 {
+		t.Fatalf("ben's memberships changed: %d", n)
+	}
+	// The user row stays.
+	if err := app.db.QueryRow(`SELECT COUNT(*) FROM users WHERE id = 'ann'`).Scan(&n); err != nil {
+		t.Fatal(err)
+	}
+	if n != 1 {
+		t.Fatalf("ann's user row was removed")
+	}
+
+	// A second call is still 204: the user is still in the org.
+	code, _ = do(t, h, "DELETE", "/orgs/acme/users/ann", "eve", "")
+	if code != 204 {
+		t.Fatalf("second call got %d want 204", code)
+	}
+}
+
+func TestRemoveOrgUserUnassignsTasks(t *testing.T) {
+	h := newServer()
+	code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", "")
+	if code != 204 {
+		t.Fatalf("got %d want 204", code)
+	}
+	app := h.(*appHandler)
+	for _, id := range []string{"t1", "t5"} {
+		var assignee string
+		if err := app.db.QueryRow(`SELECT assignee FROM tasks WHERE id = ?`, id).Scan(&assignee); err != nil {
+			t.Fatal(err)
+		}
+		if assignee != "" {
+			t.Fatalf("task %s still assigned to %q", id, assignee)
+		}
+	}
+	// Tasks assigned to others are untouched.
+	var assignee string
+	if err := app.db.QueryRow(`SELECT assignee FROM tasks WHERE id = 't2'`).Scan(&assignee); err != nil {
+		t.Fatal(err)
+	}
+	if assignee != "cat" {
+		t.Fatalf("t2 assignee changed to %q", assignee)
+	}
+}
