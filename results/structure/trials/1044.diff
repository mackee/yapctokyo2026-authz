@@ -0,0 +1,63 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestMoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, project, target, body string
+		want                              int
+	}{
+		{"manager of both", "ivy", "web", "ben", `{"toProjectId":"ops"}`, 200},
+		{"manager of source only", "ann", "web", "ben", `{"toProjectId":"ops"}`, 403},
+		{"contributor", "ben", "web", "cat", `{"toProjectId":"ops"}`, 403},
+		{"org admin", "eve", "web", "ben", `{"toProjectId":"ops"}`, 403},
+		{"anonymous", "", "web", "ben", `{"toProjectId":"ops"}`, 401},
+		{"non member caller", "hal", "web", "ben", `{"toProjectId":"ops"}`, 404},
+		{"target not member", "ivy", "web", "hal", `{"toProjectId":"ops"}`, 404},
+		{"already in destination", "ivy", "web", "cat", `{"toProjectId":"ops"}`, 409},
+		{"same project", "ivy", "web", "ben", `{"toProjectId":"web"}`, 400},
+		{"missing destination", "ivy", "web", "ben", `{"toProjectId":"nope"}`, 404},
+		{"other org destination", "ann", "web", "ben", `{"toProjectId":"gx"}`, 404},
+		{"archived destination", "ann", "web", "ben", `{"toProjectId":"legacy"}`, 409},
+		{"archived source", "ann", "legacy", "ben", `{"toProjectId":"web"}`, 409},
+		{"bad body", "ivy", "web", "ben", `{}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/members/"+c.target+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveMemberEffects(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var resp moveResponse
+	json.Unmarshal([]byte(body), &resp)
+	if resp != (moveResponse{UserID: "ben", ProjectID: "ops", Role: RoleContributor}) {
+		t.Fatalf("bad response %+v", resp)
+	}
+	// ben left web (no longer sees it) and joined ops.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben should not read web, got %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben should read ops, got %d", code)
+	}
+	// ben's task in web is unassigned.
+	_, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" {
+		t.Fatalf("t1 still assigned to %q", task.Assignee)
+	}
+}
