+func TestFreeze(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var members []struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &members); err != nil {
+		t.Fatal(err)
+	}
+	want := []string{"ann", "ben", "cat", "dan", "ivy"}
+	if len(members) != len(want) {
+		t.Fatalf("want %d members, got %s", len(want), body)
+	}
+	for i, m := range members {
+		if m.UserID != want[i] || m.Role != "viewer" {
+			t.Fatalf("member %d: got %+v, want {%s viewer}", i, m, want[i])
+		}
+	}
+}
+
+func TestFreezeBlocksTaskWrites(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d: %s", code, body)
+	}
+
+	// Former managers and contributors can no longer write.
+	cases := []struct {
+		name, user, method, path, body string
+		want                           int
+	}{
+		{"create by former manager", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"create by former manager ivy", "ivy", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"create by former contributor", "ben", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"update own former task", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`, 403},
+		{"update by former manager", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"delete by former manager", "ann", "DELETE", "/projects/web/tasks/t1", "", 403},
+		{"create by former viewer", "dan", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, h, c.method, c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+
+	// Reads still work.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "dan", ""); code != 200 {
+		t.Fatalf("list after freeze: got %d want 200", code)
+	}
+
+	// Tasks lost their assignees, so no assignee is left outside the writer roles.
+	code, body := do(t, h, "GET", "/projects/web/tasks", "dan", "")
+	if code != 200 {
+		t.Fatalf("list after freeze: got %d", code)
+	}
+	var tasks []Task
+	if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+		t.Fatal(err)
+	}
+	for _, task := range tasks {
+		if task.AssigneeID != "" {
+			t.Fatalf("task %s still assigned to %q after freeze", task.ID, task.AssigneeID)
+		}
+	}
+
+	// Other projects are not affected.
+	if code, body := do(t, h, "POST", "/projects/ops/tasks", "cat", `{"title":"x"}`); code != 200 {
+		t.Fatalf("ops create by cat after web freeze: got %d: %s", code, body)
+	}
+}
+
