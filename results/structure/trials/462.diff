+// Even if a frozen project still had writers (role data changed outside the
+// freeze endpoint), the frozen flag alone must block every task write.
+func TestFrozenFlagBlocksWrites(t *testing.T) {
+	db, h := newServerWithDB()
+	if _, err := db.Exec(`UPDATE projects SET frozen = 1 WHERE id = 'web'`); err != nil {
+		t.Fatal(err)
+	}
+	cases := []struct {
+		name, user, method, path, body string
+	}{
+		{"manager patch", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"manager delete", "ann", "DELETE", "/projects/web/tasks/t1", ""},
+		{"manager create", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"contributor patch own", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"contributor create", "ben", "POST", "/projects/web/tasks", `{"title":"x"}`},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, h, c.method, c.path, c.user, c.body)
+			if code != 409 {
+				t.Fatalf("got %d want 409: %s", code, body)
+			}
+		})
+	}
+}
