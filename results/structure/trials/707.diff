--- /dev/null
+++ b/freeze_test.go
@@ -0,0 +1,70 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestFreeze(t *testing.T) {
+	s := newServer()
+	code, body := do(t, s, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got []memberView
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 5 {
+		t.Fatalf("want 5 members, got %v", got)
+	}
+	for _, m := range got {
+		if m.Role != "viewer" {
+			t.Fatalf("member %s not viewer", m.UserID)
+		}
+	}
+	// nobody can modify tasks any more, managers included
+	for _, c := range []struct{ user, method, path, body string }{
+		{"ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"ann", "DELETE", "/projects/web/tasks/t2", ""},
+		{"ann", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"ann", "POST", "/projects/web/freeze", ""},
+	} {
+		if code, b := do(t, s, c.method, c.path, c.user, c.body); code != 403 {
+			t.Fatalf("%s %s by %s: got %d want 403 body=%s", c.method, c.path, c.user, code, b)
+		}
+	}
+	// other projects unaffected
+	if code, b := do(t, s, "PATCH", "/projects/ops/tasks/t4", "ivy", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ops affected: %d %s", code, b)
+	}
+}
+
+func TestFreezeDenied(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"contributor", "ben", "/projects/web/freeze", 403},
+		{"viewer", "dan", "/projects/web/freeze", 403},
+		{"org admin non-member", "eve", "/projects/web/freeze", 403},
+		{"non-member", "ben", "/projects/ops/freeze", 404},
+		{"other org", "gus", "/projects/web/freeze", 404},
+		{"missing project", "ann", "/projects/nope/freeze", 404},
+		{"unauthenticated", "", "/projects/web/freeze", 401},
+		{"archived", "ann", "/projects/legacy/freeze", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			s := newServer()
+			if code, b := do(t, s, "POST", c.path, c.user, ""); code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, b)
+			}
+			// membership unchanged
+			if code, _ := do(t, s, "PATCH", "/projects/web/tasks/t2", "ann", `{"status":"done"}`); code != 200 {
+				t.Fatalf("project was frozen: %d", code)
+			}
+		})
+	}
+}
