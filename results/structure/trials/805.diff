+// CanMoveMember returns nil if the actor may move a member from this project
+// to dest: manager of both (else ErrForbidden), neither archived (else
+// ErrArchived). Call it on the source project's object.
+func (a ProjectAuthz) CanMoveMember(dest ProjectAuthz) error {
+	if !a.CanRead() || !dest.CanRead() || a.role != RoleManager || dest.role != RoleManager {
+		return deny(ErrForbidden, "forbidden")
+	}
+	if a.archived || dest.archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	return nil
+}
