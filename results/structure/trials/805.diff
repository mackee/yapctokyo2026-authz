+// Move moves the member from the project of authz to the project of dest,
+// keeping the role, and returns the new membership. The actor must be a
+// manager of both projects.
+func (*MembershipTable) Move(ctx context.Context, db DB, authz, dest ProjectAuthz, userID string) (*Membership, error) {
+	if err := authz.CanMoveMember(dest); err != nil {
+		return nil, err
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveMember(ctx, tx, authz.ProjectID(), dest.ProjectID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(ctx, tx); err != nil {
+			return err
+		}
+		m, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
