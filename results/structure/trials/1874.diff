diff --git a/transfer.go b/transfer.go
new file mode 100644
index 0000000..00aa71f
--- /dev/null
+++ b/transfer.go
@@ -0,0 +1,93 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+)
+
+type transferRequest struct {
+	ToOrgID string `json:"toOrgId"`
+}
+
+// transferUser moves a user to another organization (e.g. a move between group
+// companies). Only an org admin of the user's current organization may do it.
+//
+// To keep the model rules, the user's ties to the old organization are cut in
+// the same transaction: project memberships are removed, tasks assigned to the
+// user in those projects become unassigned, and the org admin flag is cleared.
+func (s *server) transferUser(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	caller, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if caller == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	orgID := r.PathValue("orgID")
+	if caller.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	if !caller.OrgAdmin {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	target, err := findUser(ctx, s.db, r.PathValue("uid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if target == nil || target.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	var req transferRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || req.ToOrgID == "" {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	if req.ToOrgID == orgID {
+		writeError(w, 400, "user is already in that organization")
+		return
+	}
+
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+
+	var exists bool
+	if err := tx.QueryRowContext(ctx,
+		`SELECT EXISTS (SELECT 1 FROM users WHERE org_id = ?) OR EXISTS (SELECT 1 FROM projects WHERE org_id = ?)`,
+		req.ToOrgID, req.ToOrgID).Scan(&exists); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if !exists {
+		writeError(w, 400, "unknown organization")
+		return
+	}
+	for _, q := range []string{
+		`UPDATE tasks SET assignee = '' WHERE assignee = ?1`,
+		`DELETE FROM memberships WHERE user_id = ?1`,
+	} {
+		if _, err := tx.ExecContext(ctx, q, target.ID); err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+	}
+	if _, err := tx.ExecContext(ctx, `UPDATE users SET org_id = ?, org_admin = 0 WHERE id = ?`, req.ToOrgID, target.ID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, map[string]string{"id": target.ID, "orgId": req.ToOrgID})
+}
diff --git a/transfer_test.go b/transfer_test.go
new file mode 100644
index 0000000..9976c76
--- /dev/null
+++ b/transfer_test.go
@@ -0,0 +1,101 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got struct{ ID, OrgID string }
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.ID != "ben" || got.OrgID != "globex" {
+		t.Fatalf("unexpected body %s", body)
+	}
+}
+
+func TestTransferErrors(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"anonymous", "", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 401},
+		{"not org admin", "ann", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 403},
+		{"admin of other org", "gus", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 404},
+		{"user not in path org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"unknown target org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"nowhere"}`, 400},
+		{"empty target", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":""}`, 400},
+		{"bad body", "eve", "/orgs/acme/users/ben/transfer", `nope`, 400},
+		{"same org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"acme"}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+// After a transfer the user belongs to the new org, loses access to the old
+// org's projects, and is no longer an assignee there (model rules are checked
+// by do()).
+func TestTransferCleansUpOldOrg(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	// no access to old org projects any more
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("old project: got %d want 404", code)
+	}
+	// old tasks are unassigned, including in archived projects
+	for _, path := range []string{"/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		code, body := do(t, h, "GET", path, "ann", "")
+		if code != 200 {
+			t.Fatalf("%s: %d", path, code)
+		}
+		var task Task
+		json.Unmarshal([]byte(body), &task)
+		if task.Assignee != "" {
+			t.Fatalf("%s still assigned to %q", path, task.Assignee)
+		}
+	}
+	// other users' assignments are untouched
+	code, body := do(t, h, "GET", "/projects/web/tasks/t2", "ann", "")
+	var t2 Task
+	json.Unmarshal([]byte(body), &t2)
+	if code != 200 || t2.Assignee != "cat" {
+		t.Fatalf("t2 changed: %d %s", code, body)
+	}
+}
+
+// An org admin who moves to another org must not keep admin rights there.
+func TestTransferDropsOrgAdmin(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "eve", ""); code != 404 {
+		t.Fatalf("transferred admin can read globex project: got %d want 404", code)
+	}
+}
+
+// The old org can no longer manage the transferred user.
+func TestTransferTwice(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatal(code)
+	}
+	if code, _ := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 404 {
+		t.Fatalf("got %d want 404", code)
+	}
+}
