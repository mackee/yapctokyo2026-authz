+// MemberView is the public representation of a project membership.
+type MemberView struct {
+	UserID    string `json:"userId"`
+	ProjectID string `json:"projectId"`
+	Role      string `json:"role"`
+}
+
+// ManageProject may manage the membership of one project.
+type ManageProject interface {
+	ReadProject
+	// MoveMember removes userID from this project and adds them to the project
+	// to with the same role. Tasks in this project assigned to them are
+	// unassigned. The destination must be acquired by the same actor with
+	// Manage, so the actor is a manager of both projects.
+	MoveMember(userID string, to ManageProject) (MemberView, error)
+}
