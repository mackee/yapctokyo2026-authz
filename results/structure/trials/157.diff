 }
 
+type manageProject struct {
+	readProject
+}
+
+func (p *manageProject) MoveMember(userID string, to ManageProject) (MemberView, error) {
+	toID := to.ID()
+	if toID == p.ps.pid {
+		return MemberView{}, deny(ErrInvalid, "destination must be a different project")
+	}
+	var v MemberView
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		role, ok := s.members[p.ps.pid][userID]
+		if !ok {
+			return deny(ErrNotFound, "not a member of this project")
+		}
+		if _, ok := s.members[toID][userID]; ok {
+			return deny(ErrConflict, "user is already a member of the destination project")
+		}
+		delete(s.members[p.ps.pid], userID)
+		if s.members[toID] == nil {
+			s.members[toID] = map[string]string{}
+		}
+		s.members[toID][userID] = role
+		// The user no longer works on this project, so their tasks here are
+		// unassigned; otherwise the assignee invariant would reject the move.
+		for tid, t := range s.tasks {
+			if t.project == p.ps.pid && t.assignee.user == userID {
+				t.assignee = Assignee{project: p.ps.pid}
+				s.tasks[tid] = t
+			}
+		}
+		v = MemberView{UserID: userID, ProjectID: toID, Role: role}
+		return nil
+	})
+	return v, err
+}
