index 0000000..d2103d8
--- /dev/null
+++ b/move_test.go
@@ -0,0 +1,90 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager moves", "ivy", "/projects/web/tasks/t2/move", `{"toProjectId":"ops"}`, 200},
+		{"manager moves unassigned", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 200},
+		{"contributor source", "ben", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer source", "dan", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin source", "eve", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"non member source", "hal", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 404},
+		{"other org source", "gus", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 401},
+		{"unknown user", "zed", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 401},
+		{"unknown source project", "ivy", "/projects/nope/tasks/t1/move", `{"toProjectId":"ops"}`, 404},
+		{"task in other project", "ivy", "/projects/web/tasks/t4/move", `{"toProjectId":"ops"}`, 404},
+		{"archived source", "ann", "/projects/legacy/tasks/t5/move", `{"toProjectId":"ops"}`, 409},
+		{"target viewer only", "ann", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"target not member", "ivy", "/projects/web/tasks/t1/move", `{"toProjectId":"legacy"}`, 404},
+		{"target other org", "ivy", "/projects/web/tasks/t1/move", `{"toProjectId":"gx"}`, 404},
+		{"target missing", "ivy", "/projects/web/tasks/t1/move", `{"toProjectId":"nope"}`, 404},
+		{"target archived", "ann", "/projects/web/tasks/t1/move", `{"toProjectId":"legacy"}`, 409},
+		{"target same as source", "ivy", "/projects/web/tasks/t2/move", `{"toProjectId":"web"}`, 400},
+		{"target missing field", "ivy", "/projects/web/tasks/t2/move", `{}`, 400},
+		{"target empty", "ivy", "/projects/web/tasks/t2/move", `{"toProjectId":""}`, 400},
+		{"invalid body", "ivy", "/projects/web/tasks/t2/move", `nope`, 400},
+		{"assignee not in target", "ivy", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveTransfersTask(t *testing.T) {
+	srv := newServer()
+	code, body := do(t, srv, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d want 200: %s", code, body)
+	}
+	var got Task
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", Assignee: "cat"}
+	if got != want {
+		t.Fatalf("moved task: got %+v want %+v", got, want)
+	}
+
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks/t2", "ann", ""); code != 404 {
+		t.Fatalf("old project still has task: got %d want 404", code)
+	}
+	code, body = do(t, srv, "GET", "/projects/ops/tasks/t2", "ivy", "")
+	if code != 200 {
+		t.Fatalf("new project lookup: got %d want 200", code)
+	}
+	var fetched Task
+	json.Unmarshal([]byte(body), &fetched)
+	if fetched != want {
+		t.Fatalf("task in new project: got %+v want %+v", fetched, want)
+	}
+}
+
+func TestMoveRejectedLeavesTaskInPlace(t *testing.T) {
+	srv := newServer()
+	// t1 is assigned to ben, who is not a member of ops.
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks/t1/move", "ivy", `{"toProjectId":"ops"}`); code != 400 {
+		t.Fatalf("move: got %d want 400", code)
+	}
+	code, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("task moved despite rejection: got %d", code)
+	}
+	var got Task
+	json.Unmarshal([]byte(body), &got)
+	if got.ProjectID != "web" {
+		t.Fatalf("projectId: got %q want web", got.ProjectID)
+	}
+}
