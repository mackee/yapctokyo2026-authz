+func TestImportMembers(t *testing.T) {
+	// ops: ann viewer, cat contributor, ivy manager
+	// web: ann manager, ben contributor, cat contributor, dan viewer, ivy manager
+	code, body := do(t, newServer(), "POST", "/projects/ops/members/import", "ivy", `{"fromProjectId":"web"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var members []Member
+	if err := json.Unmarshal([]byte(body), &members); err != nil {
+		t.Fatal(err)
+	}
+	want := []Member{
+		{UserID: "ann", Role: RoleViewer},      // existing role kept
+		{UserID: "ben", Role: RoleContributor}, // imported
+		{UserID: "cat", Role: RoleContributor}, // existing
+		{UserID: "dan", Role: RoleViewer},      // imported
+		{UserID: "ivy", Role: RoleManager},     // existing
+	}
+	if len(members) != len(want) {
+		t.Fatalf("got %v want %v", members, want)
+	}
+	for i := range want {
+		if members[i] != want[i] {
+			t.Fatalf("got %v want %v", members, want)
+		}
+	}
+}
+
+func TestImportMembersAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"anonymous", "", "ops", `{"fromProjectId":"web"}`, 401},
+		{"unknown user", "zed", "ops", `{"fromProjectId":"web"}`, 401},
+		{"non member target", "hal", "ops", `{"fromProjectId":"web"}`, 404},
+		{"other org target", "gus", "ops", `{"fromProjectId":"web"}`, 404},
+		{"missing target", "ann", "nope", `{"fromProjectId":"web"}`, 404},
+		{"viewer target", "ann", "ops", `{"fromProjectId":"web"}`, 403},
+		{"contributor target", "cat", "ops", `{"fromProjectId":"web"}`, 403},
+		{"org admin target", "eve", "ops", `{"fromProjectId":"web"}`, 403},
+		{"archived target", "ann", "legacy", `{"fromProjectId":"web"}`, 409},
+		{"same project", "ann", "web", `{"fromProjectId":"web"}`, 400},
+		{"missing source field", "ivy", "ops", `{}`, 400},
+		{"bad body", "ivy", "ops", `not json`, 400},
+		{"missing source", "ivy", "ops", `{"fromProjectId":"nope"}`, 404},
+		{"source other org", "ivy", "ops", `{"fromProjectId":"gx"}`, 404},
+		{"source not readable", "ivy", "web", `{"fromProjectId":"legacy"}`, 404},
+		{"archived source ok", "ann", "web", `{"fromProjectId":"legacy"}`, 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/members/import", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
