+// Member is a user's role in a project.
+type Member struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// Members lists the members of a project, sorted by user ID.
+func (s *Store) Members(projectID string) []Member {
+	out := []Member{}
+	for uid, role := range s.members[projectID] {
+		out = append(out, Member{UserID: uid, Role: role})
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].UserID < out[j].UserID })
+	return out
+}
+
+// ImportMembers copies every member of fromID into toID with the same role.
+// Users who are already members of toID keep their existing role.
+func (s *Store) ImportMembers(toID, fromID string) {
+	if s.members[toID] == nil {
+		s.members[toID] = map[string]string{}
+	}
+	for uid, role := range s.members[fromID] {
+		if _, ok := s.members[toID][uid]; !ok {
+			s.members[toID][uid] = role
+		}
+	}
+}
+
