+type importMembersRequest struct {
+	FromProjectID string `json:"fromProjectId"`
+}
+
+func (s *server) importMembers(w http.ResponseWriter, r *http.Request) {
+	s.store.mu.Lock()
+	defer s.store.mu.Unlock()
+
+	user := s.store.User(r.Header.Get("X-User"))
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project := s.store.Project(r.PathValue("pid"))
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role := s.store.Role(project.ID, user.ID)
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req importMembersRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || req.FromProjectID == "" {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	if req.FromProjectID == project.ID {
+		writeError(w, 400, "cannot import members from the same project")
+		return
+	}
+	// The caller must be able to read the source, otherwise importing would
+	// reveal its membership.
+	source := s.store.Project(req.FromProjectID)
+	if source == nil || source.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	if s.store.Role(source.ID, user.ID) == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	s.store.ImportMembers(project.ID, source.ID)
+	writeJSON(w, 200, s.store.Members(project.ID))
+}
