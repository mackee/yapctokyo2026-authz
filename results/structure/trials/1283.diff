+// destroy removes the membership.
+func (r *Membership) destroy(ctx context.Context, db DB) error {
+	if _, err := db.ExecContext(ctx,
+		`DELETE FROM memberships WHERE project_id = ? AND user_id = ?`, r.ProjectID, r.UserID); err != nil {
+		return err
+	}
+	return nil
+}
+
+// moveTo re-points the membership at another project, keeping the role. The
+// destination must not already have a row for the user.
+func (r *Membership) moveTo(ctx context.Context, db DB, p *Project) error {
+	if err := r.destroy(ctx, db); err != nil {
+		return err
+	}
+	r.ProjectID = p.ID
+	return r.save(ctx, db)
+}
