+// moveMemberAggregate moves one member from one project to another, keeping
+// the role. Tasks assigned to the member in the source project are unassigned
+// (an assignee must be a member of the task's project).
+type moveMemberAggregate struct {
+	from   *Membership
+	to     *Project
+	member *User
+	tasks  []*Task // from.AssignedTasks
+}
+
+func loadMoveMember(ctx context.Context, tx DB, fromProjectID, userID, toProjectID string) (*moveMemberAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, fromProjectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	to, err := NewProjectTable().Find(ctx, tx, toProjectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if _, err := to.Membership(ctx, tx, userID); err == nil {
+		return nil, deny(ErrInvalid, "user is already a member of the destination project")
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	u, err := m.User(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	tasks, err := m.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &moveMemberAggregate{from: m, to: to, member: u, tasks: tasks}, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.member.Org != a.to.Org {
+		return deny(ErrInvalid, "member must belong to the project's organization")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.from.moveTo(ctx, tx, a.to); err != nil {
+		return nil, err
+	}
+	return a.from, nil
+}
+
