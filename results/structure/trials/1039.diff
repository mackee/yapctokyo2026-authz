diff --git a/members.go b/members.go
new file mode 100644
index 0000000..f9ad7d1
--- /dev/null
+++ b/members.go
@@ -0,0 +1,129 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+)
+
+type member struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+type updateMembersRequest struct {
+	Roles map[string]string `json:"roles"`
+}
+
+var validRoles = map[string]bool{RoleManager: true, RoleContributor: true, RoleViewer: true}
+
+// updateMembers changes several members' roles at once. Only managers of the
+// project may do this. It is all-or-nothing: if any entry cannot be applied
+// (invalid role, not a member of the project, or the change would leave the
+// project without a manager), nothing is changed.
+func (s *server) updateMembers(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role, err := findRole(ctx, s.db, project.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "only managers may change member roles")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req updateMembersRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || len(req.Roles) == 0 {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	for _, newRole := range req.Roles {
+		if !validRoles[newRole] {
+			writeError(w, 400, "role must be manager, contributor or viewer")
+			return
+		}
+	}
+
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+
+	for userID, newRole := range req.Roles {
+		res, err := tx.ExecContext(ctx, `UPDATE memberships SET role = ? WHERE project_id = ? AND user_id = ?`, newRole, project.ID, userID)
+		if err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+		if n, err := res.RowsAffected(); err != nil {
+			writeError(w, 500, "internal error")
+			return
+		} else if n == 0 {
+			writeError(w, 400, "not a member of the project: "+userID)
+			return
+		}
+	}
+
+	var managers int
+	if err := tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM memberships WHERE project_id = ? AND role = ?`, project.ID, RoleManager).Scan(&managers); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if managers == 0 {
+		writeError(w, 409, "project must keep at least one manager")
+		return
+	}
+
+	rows, err := tx.QueryContext(ctx, `SELECT user_id, role FROM memberships WHERE project_id = ? ORDER BY user_id`, project.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	members := []member{}
+	for rows.Next() {
+		var m member
+		if err := rows.Scan(&m.UserID, &m.Role); err != nil {
+			rows.Close()
+			writeError(w, 500, "internal error")
+			return
+		}
+		members = append(members, m)
+	}
+	rows.Close()
+	if err := rows.Err(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, members)
+}
diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..541ed61
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,72 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestUpdateMembers(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager bulk change", "ann", "web", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 200},
+		{"promote to manager", "ann", "web", `{"roles":{"ben":"manager"}}`, 200},
+		{"manager demotes self when another remains", "ann", "web", `{"roles":{"ann":"viewer"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"invalid role", "ann", "web", `{"roles":{"ben":"viewer","dan":"boss"}}`, 400},
+		{"not a member", "ann", "web", `{"roles":{"ben":"viewer","hal":"viewer"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"bad json", "ann", "web", `nope`, 400},
+		{"removes all managers", "ann", "web", `{"roles":{"ann":"viewer","ivy":"viewer"}}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestUpdateMembersResultAndAtomic(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got []member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []member{{"ann", "manager"}, {"ben", "viewer"}, {"cat", "contributor"}, {"dan", "contributor"}, {"ivy", "manager"}}
+	if len(got) != len(want) {
+		t.Fatalf("got %v", got)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("got %v want %v", got, want)
+		}
+	}
+
+	// ben is now a viewer: cannot create tasks.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Fatalf("ben should be viewer, got %d", code)
+	}
+
+	// A failing request must change nothing.
+	h = newServer()
+	if code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","hal":"viewer"}}`); code != 400 {
+		t.Fatal(code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 200 {
+		t.Fatalf("ben must still be contributor, got %d", code)
+	}
+}
