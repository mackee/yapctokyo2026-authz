+type member struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func roleMap(t *testing.T, body string) map[string]string {
+	t.Helper()
+	var ms []member
+	if err := json.Unmarshal([]byte(body), &ms); err != nil {
+		t.Fatalf("bad members json %q: %v", body, err)
+	}
+	m := map[string]string{}
+	for _, x := range ms {
+		m[x.UserID] = x.Role
+	}
+	return m
+}
+
+func TestSetMemberRoles(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager bulk change", "ann", "web", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 200},
+		{"promote to manager", "ann", "web", `{"roles":{"ben":"manager"}}`, 200},
+		{"same role is fine", "ann", "web", `{"roles":{"ben":"contributor"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"ben":"viewer"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"ben":"viewer"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"ben":"viewer"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"ben":"viewer"}}`, 401},
+		{"missing project", "ann", "nope", `{"roles":{"ben":"viewer"}}`, 404},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"invalid role", "ann", "web", `{"roles":{"ben":"boss"}}`, 400},
+		{"non member target", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"unknown target", "ann", "web", `{"roles":{"zed":"viewer"}}`, 400},
+		{"member of other project", "ann", "web", `{"roles":{"gus":"viewer"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"bad json", "ann", "web", `nope`, 400},
+		{"removes all managers", "ann", "web", `{"roles":{"ann":"viewer","ivy":"contributor"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMemberRolesResult(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	want := map[string]string{"ann": "manager", "ben": "viewer", "cat": "contributor", "dan": "contributor", "ivy": "manager"}
+	got := roleMap(t, body)
+	if len(got) != len(want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	for u, r := range want {
+		if got[u] != r {
+			t.Fatalf("got %v want %v", got, want)
+		}
+	}
+	// The change is persisted: ben is now a viewer and may no longer create tasks;
+	// dan is now a contributor and may.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Fatalf("ben create got %d want 403", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("dan create got %d want 200", code)
+	}
+}
+
+func TestSetMemberRolesAtomic(t *testing.T) {
+	h := newServer()
+	// ben is valid, hal is not a member: nothing may change.
+	code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","hal":"viewer"}}`)
+	if code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	// ben valid, cat has an invalid role: nothing may change.
+	code, _ = do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","cat":"boss"}}`)
+	if code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 200 {
+		t.Fatalf("ben should still be a contributor, create got %d", code)
+	}
+	// A rejected request leaves the whole member list untouched.
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{}}`)
+	if code != 400 {
+		t.Fatalf("got %d want 400 (%s)", code, body)
+	}
+	code, body = do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"contributor"}}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	got := roleMap(t, body)
+	if got["ben"] != "contributor" || got["cat"] != "contributor" || got["dan"] != "viewer" {
+		t.Fatalf("unexpected members %v", got)
+	}
+}
