+// freezeProjectAggregate demotes every member of one project to viewer.
+type freezeProjectAggregate struct {
+	project projectRecord
+	members []membershipRecord
+}
+
+func loadFreezeProject(x *tx, projectID string) (*freezeProjectAggregate, error) {
+	p, ok := x.findProject(projectID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	return &freezeProjectAggregate{project: p, members: x.membershipsOf(projectID)}, nil
+}
+
+func (a *freezeProjectAggregate) validate() error { return nil }
+
+func (a *freezeProjectAggregate) save(x *tx) []MemberView {
+	out := []MemberView{}
+	for _, m := range a.members {
+		m.Role = RoleViewer
+		m.save(x)
+		out = append(out, MemberView{UserID: m.UserID, Role: m.Role})
+	}
+	return out
+}
