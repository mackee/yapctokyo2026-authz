+func TestMoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, project, member, body string
+		want                              int
+	}{
+		{"manager of both moves", "ivy", "web", "ben", `{"toProjectId":"ops"}`, 200},
+		{"anonymous", "", "web", "ben", `{"toProjectId":"ops"}`, 401},
+		{"unknown user", "zed", "web", "ben", `{"toProjectId":"ops"}`, 401},
+		{"non member source", "hal", "web", "ben", `{"toProjectId":"ops"}`, 404},
+		{"other org", "gus", "web", "ben", `{"toProjectId":"ops"}`, 404},
+		{"org admin cannot move", "eve", "web", "ben", `{"toProjectId":"ops"}`, 403},
+		{"contributor cannot move", "ben", "web", "cat", `{"toProjectId":"ops"}`, 403},
+		{"viewer cannot move", "dan", "web", "cat", `{"toProjectId":"ops"}`, 403},
+		{"destination not manager", "ann", "web", "ben", `{"toProjectId":"ops"}`, 403},
+		{"destination missing", "ivy", "web", "ben", `{"toProjectId":"nope"}`, 404},
+		{"destination other org", "ivy", "web", "ben", `{"toProjectId":"gx"}`, 404},
+		{"missing destination field", "ivy", "web", "ben", `{}`, 400},
+		{"bad json", "ivy", "web", "ben", `{`, 400},
+		{"same project", "ivy", "web", "ben", `{"toProjectId":"web"}`, 400},
+		{"archived source", "ann", "legacy", "ben", `{"toProjectId":"web"}`, 409},
+		{"archived destination", "ann", "web", "cat", `{"toProjectId":"legacy"}`, 409},
+		{"member not in source", "ivy", "web", "hal", `{"toProjectId":"ops"}`, 404},
+		{"already in destination", "ivy", "web", "cat", `{"toProjectId":"ops"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			path := "/projects/" + c.project + "/members/" + c.member + "/move"
+			code, _ := do(t, newServer(), "POST", path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveMemberEffects(t *testing.T) {
+	s := newServer()
+
+	code, body := do(t, s, "POST", "/projects/web/members/dan/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d: %s", code, body)
+	}
+	var got moveResponse
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if want := (moveResponse{UserID: "dan", ProjectID: "ops", Role: "viewer"}); got != want {
+		t.Fatalf("response %+v, want %+v", got, want)
+	}
+
+	// dan is no longer in web, and now reads ops with the same role.
+	if code, _ := do(t, s, "GET", "/projects/web/tasks", "dan", ""); code != 404 {
+		t.Fatalf("dan reads web after move: got %d want 404", code)
+	}
+	if code, _ := do(t, s, "GET", "/projects/ops/tasks", "dan", ""); code != 200 {
+		t.Fatalf("dan reads ops after move: got %d want 200", code)
+	}
+	if code, _ := do(t, s, "POST", "/projects/ops/tasks", "dan", `{"title":"x"}`); code != 403 {
+		t.Fatalf("dan writes ops after move: got %d want 403 (viewer)", code)
+	}
+}
+
+func TestMoveMemberUnassignsTasks(t *testing.T) {
+	s := newServer()
+
+	// ben is assigned t1 in web. Moving ben out of web must not leave t1
+	// assigned to a non-member; other tasks keep their assignees.
+	if code, body := do(t, s, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`); code != 200 {
+		t.Fatalf("move: got %d: %s", code, body)
+	}
+	code, body := do(t, s, "GET", "/projects/web/tasks", "ann", "")
+	if code != 200 {
+		t.Fatal(code)
+	}
+	var tasks []Task
+	if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+		t.Fatal(err)
+	}
+	assignees := map[string]string{}
+	for _, task := range tasks {
+		assignees[task.ID] = task.Assignee
+	}
+	if assignees["t1"] != "" {
+		t.Fatalf("t1 assignee = %q, want unassigned", assignees["t1"])
+	}
+	if assignees["t2"] != "cat" {
+		t.Fatalf("t2 assignee = %q, want cat", assignees["t2"])
+	}
+
+	// ben keeps the contributor role in ops: may create a task for self, but
+	// that check only passes for a writer (a viewer would get 403).
+	if code, _ := do(t, s, "POST", "/projects/ops/tasks", "ben", `{"title":"x","assignee":"ben"}`); code != 200 {
+		t.Fatalf("ben creates in ops: got %d want 200", code)
+	}
+}
