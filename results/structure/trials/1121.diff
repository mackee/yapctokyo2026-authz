+// destroy removes the membership.
+func (r *Membership) destroy(ctx context.Context, db DB) error {
+	if _, err := db.ExecContext(ctx,
+		`DELETE FROM memberships WHERE project_id = ? AND user_id = ?`, r.ProjectID, r.UserID); err != nil {
+		return err
+	}
+	return nil
+}
+
+// moveTo returns an unsaved membership of the same user and role in the
+// project; call save to insert it.
+func (r *Membership) moveTo(p *Project) *Membership {
+	return &Membership{ProjectID: p.ID, UserID: r.UserID, Role: r.Role}
+}
