+// moveMemberAggregate moves one member from one project to another, keeping
+// the role. Tasks assigned to the member in the source project are unassigned,
+// because an assignee must be a member of the task's project.
+type moveMemberAggregate struct {
+	member *Membership // source project's membership of the user
+	user   *User       // member.User()
+	dest   *Project
+	tasks  []*Task // member.AssignedTasks()
+	exists bool    // the user is already a member of dest
+}
+
+func loadMoveMember(ctx context.Context, tx DB, projectID, userID, destID string) (*moveMemberAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	dest, err := NewProjectTable().Find(ctx, tx, destID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	u, err := m.User(ctx, tx)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "member must be an existing user")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveMemberAggregate{member: m, user: u, dest: dest}
+	if a.tasks, err = m.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	if _, err := dest.Membership(ctx, tx, userID); err == nil {
+		a.exists = true
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.dest.ID == a.member.ProjectID {
+		return deny(ErrInvalid, "destination must be a different project")
+	}
+	if a.user.Org != a.dest.Org {
+		return deny(ErrInvalid, "project members must belong to the project's organization")
+	}
+	if a.exists {
+		return deny(ErrInvalid, "user is already a member of the destination project")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.member.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	moved := a.member.moveTo(a.dest)
+	if err := moved.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return moved, nil
+}
+
