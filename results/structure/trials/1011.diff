+var validRoles = map[string]bool{RoleManager: true, RoleContributor: true, RoleViewer: true}
+
+type roleRequest struct {
+	Role string `json:"role"`
+}
+
+type memberResponse struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// setMemberRole changes an existing member's role. Only managers may do so; a
+// project must always keep at least one manager.
+func (s *server) setMemberRole(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role, err := findRole(ctx, s.db, project.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	targetID := r.PathValue("uid")
+	targetRole, err := findRole(ctx, s.db, project.ID, targetID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if targetRole == "" {
+		writeError(w, 404, "not found")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req roleRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || !validRoles[req.Role] {
+		writeError(w, 400, "role must be manager, contributor or viewer")
+		return
+	}
+	// The manager-count guard is part of the UPDATE so concurrent demotions
+	// cannot leave the project without a manager.
+	res, err := s.db.ExecContext(ctx, `UPDATE memberships SET role = ?
+		WHERE project_id = ? AND user_id = ?
+		AND (role != 'manager' OR ? = 'manager'
+			OR (SELECT COUNT(*) FROM memberships WHERE project_id = ? AND role = 'manager') > 1)`,
+		req.Role, project.ID, targetID, req.Role, project.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if n, err := res.RowsAffected(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	} else if n == 0 {
+		writeError(w, 409, "project must keep at least one manager")
+		return
+	}
+	writeJSON(w, 200, memberResponse{UserID: targetID, Role: req.Role})
+}
