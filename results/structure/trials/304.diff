+// manageable applies the manager rule for changes to the project as a whole:
+// readable, manager (else 403), not archived (else 409).
+func manageable(s *state, act Actor, pid string) error {
+	p, r, err := readable(s, act, pid)
+	if err != nil {
+		return err
+	}
+	if r != RoleManager {
+		return deny(ErrForbidden, "forbidden")
+	}
+	if p.archived {
