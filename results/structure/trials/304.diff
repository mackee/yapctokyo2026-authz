new file mode 100644
index 0000000..618b866
--- /dev/null
+++ b/freeze_test.go
@@ -0,0 +1,99 @@
+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown project", "ann", "nope", 404},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+	want := `[{"userId":"ann","role":"viewer"},{"userId":"ben","role":"viewer"},{"userId":"cat","role":"viewer"},{"userId":"dan","role":"viewer"},{"userId":"ivy","role":"viewer"}]`
+	if got := strings.TrimSpace(body); got != want {
+		t.Fatalf("body:\n got %s\nwant %s", got, want)
+	}
+}
+
+func TestFreezeLocksTasks(t *testing.T) {
+	s := newServer()
+	if code, _ := do(t, s, "POST", "/projects/web/freeze", "ivy", ""); code != 200 {
+		t.Fatalf("freeze: got %d want 200", code)
+	}
+
+	cases := []struct {
+		name, user, method, path, body string
+		want                           int
+	}{
+		{"former manager edits", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"former contributor edits own", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`, 403},
+		{"former manager creates", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"former manager deletes", "ann", "DELETE", "/projects/web/tasks/t1", "", 403},
+		{"former manager freezes again", "ann", "POST", "/projects/web/freeze", "", 403},
+		{"viewer reads", "dan", "GET", "/projects/web/tasks/t1", "", 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, s, c.method, c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+
+	// Nothing was changed by the rejected writes, and the assignments are kept
+	// even though their assignees are now viewers.
+	code, body := do(t, s, "GET", "/projects/web/tasks/t1", "dan", "")
+	if code != 200 {
+		t.Fatalf("get t1: got %d want 200", code)
+	}
+	for _, frag := range []string{`"status":"open"`, `"assignee":"ben"`} {
+		if !strings.Contains(body, frag) {
+			t.Fatalf("t1 after freeze: want %s in %s", frag, body)
+		}
+	}
+	_, body = do(t, s, "GET", "/projects/web/tasks/t2", "dan", "")
+	if !strings.Contains(body, `"status":"doing"`) || !strings.Contains(body, `"assignee":"cat"`) {
+		t.Fatalf("t2 after freeze changed: %s", body)
+	}
+}
+
+func TestFreezeIsPerProject(t *testing.T) {
+	s := newServer()
+	if code, _ := do(t, s, "POST", "/projects/web/freeze", "ivy", ""); code != 200 {
+		t.Fatalf("freeze web: got %d want 200", code)
+	}
+	// ivy is a viewer on web now, but still a manager on ops, which is not frozen.
+	if code, _ := do(t, s, "PATCH", "/projects/ops/tasks/t4", "ivy", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ops edit after web freeze: got %d want 200", code)
+	}
+	if code, _ := do(t, s, "PATCH", "/projects/web/tasks/t1", "ivy", `{"status":"done"}`); code != 403 {
+		t.Fatalf("web edit by former manager: got %d want 403", code)
+	}
+}
