+func TestMoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, project, uid, body string
+		want                           int
+	}{
+		{"manager of both", "ivy", "web", "ben", `{"toProjectId":"ops"}`, 200},
+		{"manager of source only", "ann", "web", "ben", `{"toProjectId":"ops"}`, 403},
+		{"contributor", "ben", "web", "ben", `{"toProjectId":"ops"}`, 403},
+		{"viewer", "dan", "web", "dan", `{"toProjectId":"ops"}`, 403},
+		{"org admin", "eve", "web", "ben", `{"toProjectId":"ops"}`, 403},
+		{"non member", "hal", "web", "ben", `{"toProjectId":"ops"}`, 404},
+		{"other org", "gus", "web", "ben", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "web", "ben", `{"toProjectId":"ops"}`, 401},
+		{"source archived", "ann", "legacy", "ben", `{"toProjectId":"web"}`, 409},
+		{"target archived", "ann", "web", "dan", `{"toProjectId":"legacy"}`, 409},
+		{"target not found", "ivy", "web", "ben", `{"toProjectId":"nope"}`, 404},
+		{"target other org", "ivy", "web", "ben", `{"toProjectId":"gx"}`, 404},
+		{"user not in source", "ivy", "web", "hal", `{"toProjectId":"ops"}`, 404},
+		{"already in target", "ivy", "web", "cat", `{"toProjectId":"ops"}`, 409},
+		{"same project", "ivy", "web", "ben", `{"toProjectId":"web"}`, 400},
+		{"missing target", "ivy", "web", "ben", `{}`, 400},
+		{"invalid body", "ivy", "web", "ben", `nope`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			path := "/projects/" + c.project + "/members/" + c.uid + "/move"
+			code, _ := do(t, newServer(), "POST", path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveMemberEffects(t *testing.T) {
+	h := newServer()
+
+	code, body := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move ben: got %d %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["userId"] != "ben" || got["projectId"] != "ops" || got["role"] != "contributor" {
+		t.Fatalf("response: %v", got)
+	}
+
+	// ben now belongs to ops, not web.
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben reads ops: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads web: got %d want 404", code)
+	}
+
+	// ben's open task in web is unassigned, and the task stays in web.
+	code, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("get t1: got %d", code)
+	}
+	var task map[string]string
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task["assignee"] != "" || task["projectId"] != "web" {
+		t.Fatalf("t1 after move: %v", task)
+	}
+
+	// The role is kept: dan is a viewer in web and stays one in ops.
+	code, body = do(t, h, "POST", "/projects/web/members/dan/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move dan: got %d %s", code, body)
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["role"] != "viewer" {
+		t.Fatalf("dan role: %v", got)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "dan", ""); code != 200 {
+		t.Fatalf("dan reads ops: got %d want 200", code)
+	}
+}
