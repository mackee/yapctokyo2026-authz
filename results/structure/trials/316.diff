 // ---- project capabilities ----------------------------------------------------
 
+// MemberView is the public representation of a project membership.
+type MemberView struct {
+	UserID    string `json:"userId"`
+	ProjectID string `json:"projectId"`
+	Role      string `json:"role"`
+}
+
+// ManageMembers may change who belongs to one project. Manager-only.
+type ManageMembers interface {
+	// Move takes userID out of this project and adds them to toProjectID with
+	// the same role, in one commit. Tasks in this project assigned to them are
+	// left unassigned. The actor must be a manager of both projects, and the
+	// target must be readable and not archived.
+	Move(userID, toProjectID string) (MemberView, error)
+}
+
+type manageMembers struct{ ps *projectScope }
+
+func (m *manageMembers) Move(userID, toProjectID string) (MemberView, error) {
+	src := m.ps.pid
+	act := m.ps.as.actor
+	var out MemberView
+	err := m.ps.as.a.st.tx(func(s *state) error {
+		// The checks run inside the same commit as the change, so they cannot
+		// go stale between the check and the write.
+		sp, sr, err := readable(s, act, src)
+		if err != nil {
+			return err
+		}
+		if sr != RoleManager {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if sp.archived {
+			return deny(ErrArchived, "project is archived")
+		}
+		if toProjectID == "" {
+			return deny(ErrInvalid, "toProjectId is required")
+		}
+		if toProjectID == src {
+			return deny(ErrInvalid, "target project must differ from the source project")
+		}
+		tp, tr, err := readable(s, act, toProjectID)
+		if err != nil {
+			return err
+		}
+		if tr != RoleManager {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if tp.archived {
+			return deny(ErrArchived, "project is archived")
+		}
+		role := s.role(src, userID)
+		if role == "" {
+			return deny(ErrNotFound, "not found")
+		}
+		if s.role(toProjectID, userID) != "" {
+			return deny(ErrConflict, "user is already a member of the target project")
+		}
+
+		delete(s.members[src], userID)
+		if s.members[toProjectID] == nil {
+			s.members[toProjectID] = map[string]string{}
+		}
+		s.members[toProjectID][userID] = role
+		for id, t := range s.tasks {
+			if t.project == src && t.assignee.user == userID {
+				t.assignee = Assignee{project: src}
+				s.tasks[id] = t
+			}
+		}
+		out = MemberView{UserID: userID, ProjectID: toProjectID, Role: role}
+		return nil
+	})
+	if err != nil {
+		return MemberView{}, err
+	}
+	return out, nil
+}
