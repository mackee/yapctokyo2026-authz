+// Move moves the user from the authorized project to the destination project,
+// keeping the user's role there. The actor must manage both projects (see
+// ProjectAuthz.CanManageMembers); the destination must be readable by the actor.
+// The move is all or nothing.
+func (*MembershipTable) Move(ctx context.Context, db DB, authz ProjectAuthz, userID, toProjectID string) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if toProjectID == authz.ProjectID() {
+		return nil, deny(ErrInvalid, "member must move to a different project")
+	}
+	toAuthz, err := NewProjectAuthz(ctx, db, authz.Actor(), toProjectID)
+	if err != nil {
+		return nil, err
+	}
+	if err := toAuthz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveMember(ctx, tx, authz.ProjectID(), userID, toProjectID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		m, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
