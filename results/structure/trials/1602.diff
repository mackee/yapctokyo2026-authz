+// updateRolesAggregate changes the roles of several members of one project.
+type updateRolesAggregate struct {
+	members map[string]*Membership // project.Membership(user), by user ID
+	roles   map[string]string
+}
+
+func loadUpdateRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*updateRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &updateRolesAggregate{members: map[string]*Membership{}, roles: roles}
+	for userID := range roles {
+		m, err := p.Membership(ctx, tx, userID)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "user "+userID+" is not a member of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		a.members[userID] = m
+	}
+	return a, nil
+}
+
+func (a *updateRolesAggregate) validate(ctx context.Context, tx DB) error {
+	for userID, role := range a.roles {
+		switch role {
+		case RoleManager, RoleContributor, RoleViewer:
+		default:
+			return deny(ErrInvalid, "invalid role for "+userID)
+		}
+		if isWriterRole(role) {
+			continue
+		}
+		// An assignee must stay a contributor or manager.
+		tasks, err := a.members[userID].AssignedTasks(ctx, tx)
+		if err != nil {
+			return err
+		}
+		if len(tasks) > 0 {
+			return deny(ErrInvalid, userID+" has assigned tasks and must remain a contributor or manager")
+		}
+	}
+	return nil
+}
+
+func (a *updateRolesAggregate) apply(ctx context.Context, tx DB) error {
+	for userID, role := range a.roles {
+		if err := a.members[userID].changeRole(ctx, tx, role); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
