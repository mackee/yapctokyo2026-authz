diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..974a755
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,101 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"reflect"
+	"testing"
+)
+
+func rolesOf(t *testing.T, h http.Handler, pid string) map[string]string {
+	t.Helper()
+	// ann is a manager of web and a viewer of ops; use ivy (manager of both).
+	_ = pid
+	rows, err := h.(*appHandler).db.Query(`SELECT user_id, role FROM memberships WHERE project_id = ?`, pid)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer rows.Close()
+	out := map[string]string{}
+	for rows.Next() {
+		var u, r string
+		if err := rows.Scan(&u, &r); err != nil {
+			t.Fatal(err)
+		}
+		out[u] = r
+	}
+	return out
+}
+
+func TestUpdateMemberRoles(t *testing.T) {
+	h := newServer()
+	// ben is assigned t1; free him first so the demotion is allowed.
+	if code, body := do(t, h, "PATCH", "/projects/web/tasks/t1", "ann", `{"assignee":"ann"}`); code != 200 {
+		t.Fatalf("setup: %d %s", code, body)
+	}
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d %s", code, body)
+	}
+	var got []map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []map[string]string{
+		{"userId": "ann", "role": "manager"},
+		{"userId": "ben", "role": "viewer"},
+		{"userId": "cat", "role": "contributor"},
+		{"userId": "dan", "role": "contributor"},
+		{"userId": "ivy", "role": "manager"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+}
+
+func TestUpdateMemberRolesErrors(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"contributor", "ben", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin", "eve", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 403},
+		{"archived", "ann", "/projects/legacy/members", `{"roles":{"ben":"manager"}}`, 409},
+		{"other org", "gus", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 404},
+		{"unauthenticated", "", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 401},
+		{"invalid role", "ann", "/projects/web/members", `{"roles":{"dan":"boss"}}`, 400},
+		{"not a member", "ann", "/projects/web/members", `{"roles":{"hal":"viewer"}}`, 400},
+		{"empty roles", "ann", "/projects/web/members", `{"roles":{}}`, 400},
+		{"malformed", "ann", "/projects/web/members", `{"roles":`, 400},
+		{"assignee demoted", "ann", "/projects/web/members", `{"roles":{"ben":"viewer"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			before := rolesOf(t, h, "web")
+			beforeLegacy := rolesOf(t, h, "legacy")
+			code, body := do(t, h, "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+			if !reflect.DeepEqual(before, rolesOf(t, h, "web")) || !reflect.DeepEqual(beforeLegacy, rolesOf(t, h, "legacy")) {
+				t.Fatal("roles changed despite error")
+			}
+		})
+	}
+}
+
+// One bad entry rejects the whole request: nothing is changed.
+func TestUpdateMemberRolesAllOrNothing(t *testing.T) {
+	h := newServer()
+	before := rolesOf(t, h, "web")
+	// dan -> contributor is fine; ben -> viewer breaks the assignee rule (t1).
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","ben":"viewer"}}`)
+	if code != 400 {
+		t.Fatalf("got %d %s", code, body)
+	}
+	if !reflect.DeepEqual(before, rolesOf(t, h, "web")) {
+		t.Fatalf("roles changed: %v", rolesOf(t, h, "web"))
+	}
+}
