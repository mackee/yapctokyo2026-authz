+// Move moves the user's membership from the project of from to the project of
+// to, keeping the role. It asks from whether the actor may move members to to
+// (managers of both projects), then runs the move in a transaction.
+func (*MembershipTable) Move(ctx context.Context, db DB, from ProjectAuthz, userID string, to ProjectAuthz) (*Membership, error) {
+	if err := from.CanMoveMemberTo(to); err != nil {
+		return nil, err
+	}
+	if from.ProjectID() == to.ProjectID() {
+		return nil, deny(ErrInvalid, "member is already in the target project")
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveMember(ctx, tx, from.ProjectID(), userID, to.ProjectID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		m, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
