+// CanMoveMemberTo returns nil if the actor may move a member from this project
+// to target: managers of both projects (else ErrForbidden), and neither project
+// archived (else ErrArchived).
+func (a ProjectAuthz) CanMoveMemberTo(target ProjectAuthz) error {
+	if a.role != RoleManager || target.role != RoleManager {
+		return deny(ErrForbidden, "only managers of both projects may move members")
+	}
+	if a.archived || target.archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	return nil
+}
