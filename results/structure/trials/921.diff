+// moveMember moves the member {uid} from this project to toProjectId. The
+// target project is read-checked here (404 when not readable by the actor);
+// the model checks that the actor manages both projects.
+func moveMember(ctx tanukirpc.Context[*projectRegistry], req moveMemberRequest) (*model.Membership, error) {
+	reg := ctx.Registry()
+	to, err := model.NewProjectAuthz(ctx, reg.db, reg.authz.Actor(), req.ToProjectID)
+	if err != nil {
+		return nil, err
+	}
