+func TestUpdateMemberRoles(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager", "ann", "web", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"org admin without role", "eve", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"cat":"viewer"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"cat":"viewer"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"cat":"viewer"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"invalid role", "ann", "web", `{"roles":{"ben":"owner"}}`, 400},
+		{"target not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"one bad target of several", "ann", "web", `{"roles":{"ben":"viewer","hal":"viewer"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"bad body", "ann", "web", `not json`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRolesResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got []member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []member{
+		{"ann", "manager"}, {"ben", "viewer"}, {"cat", "contributor"},
+		{"dan", "contributor"}, {"ivy", "manager"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("got %v want %v", got, want)
+		}
+	}
+}
+
+func TestUpdateMemberRolesAllOrNothing(t *testing.T) {
+	srv := newServer()
+	code, _ := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","hal":"viewer"}}`)
+	if code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	// ben must still be a contributor: the valid entry must not have applied.
+	code, body := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got []member
+	json.Unmarshal([]byte(body), &got)
+	for _, m := range got {
+		if m.UserID == "ben" && m.Role != "contributor" {
+			t.Fatalf("ben role %s, want contributor", m.Role)
+		}
+	}
+	// And the failed request did not add hal to the project.
+	code, _ = do(t, srv, "GET", "/projects/web/tasks", "hal", "")
+	if code != 404 {
+		t.Fatalf("hal got %d want 404", code)
+	}
+}
