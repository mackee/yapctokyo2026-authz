+// changeRolesAggregate changes the roles of several members of one project.
+type changeRolesAggregate struct {
+	members []*Membership // the targeted memberships, ordered by user ID
+	roles   map[string]string
+	all     []*Membership // project.Memberships(), for the last-manager check
+}
+
+func loadChangeRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*changeRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	all, err := p.Memberships(ctx, tx) // ordered by user ID
+	if err != nil {
+		return nil, err
+	}
+	a := &changeRolesAggregate{roles: roles, all: all}
+	found := 0
+	for _, m := range all {
+		if _, ok := roles[m.UserID]; ok {
+			a.members = append(a.members, m)
+			found++
+		}
+	}
+	if found != len(roles) {
+		return nil, deny(ErrInvalid, "every user must be a member of the project")
+	}
+	return a, nil
+}
+
+func (a *changeRolesAggregate) validate() error {
+	managers := 0
+	for _, m := range a.all {
+		role := m.Role
+		if r, ok := a.roles[m.UserID]; ok {
+			role = r
+		}
+		if role == RoleManager {
+			managers++
+		}
+	}
+	if managers == 0 {
+		return deny(ErrInvalid, "a project must keep at least one manager")
+	}
+	return nil
+}
+
+// apply changes the roles and returns the project's members afterwards. A
+// member who is no longer a contributor or manager is unassigned from their
+// tasks, since only contributors and managers can be assignees.
+func (a *changeRolesAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for _, m := range a.members {
+		role := a.roles[m.UserID]
+		if m.Role == role {
+			continue
+		}
+		if err := m.changeRole(ctx, tx, role); err != nil {
+			return nil, err
+		}
+		if !isWriterRole(role) {
+			tasks, err := m.AssignedTasks(ctx, tx)
+			if err != nil {
+				return nil, err
+			}
+			for _, t := range tasks {
+				if err := t.unassign(ctx, tx); err != nil {
+					return nil, err
+				}
+			}
+		}
+	}
+	return a.all, nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
