diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..24236e3
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,128 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"testing"
+)
+
+func TestChangeRolesStatus(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager", "ann", "web", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"invalid role", "ann", "web", `{"roles":{"ben":"owner"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"bad json", "ann", "web", `{`, 400},
+		{"non member target", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"unknown target", "ann", "web", `{"roles":{"zed":"viewer"}}`, 400},
+		{"other project member", "ann", "web", `{"roles":{"gus":"viewer"}}`, 400},
+		{"last manager", "ann", "web", `{"roles":{"ann":"viewer","ivy":"contributor"}}`, 400},
+		{"swap managers", "ann", "web", `{"roles":{"ann":"viewer","dan":"manager"}}`, 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func members(t *testing.T, h http.Handler, project string) map[string]string {
+	t.Helper()
+	code, body := do(t, h, "PUT", "/projects/"+project+"/members", "ann", `{"roles":{"ann":"manager"}}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var list []memberResponse
+	if err := json.Unmarshal([]byte(body), &list); err != nil {
+		t.Fatal(err)
+	}
+	out := map[string]string{}
+	for _, m := range list {
+		out[m.UserID] = m.Role
+	}
+	return out
+}
+
+func TestChangeRolesResult(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var list []memberResponse
+	if err := json.Unmarshal([]byte(body), &list); err != nil {
+		t.Fatal(err)
+	}
+	want := []memberResponse{
+		{"ann", "manager"}, {"ben", "viewer"}, {"cat", "contributor"}, {"dan", "contributor"}, {"ivy", "manager"},
+	}
+	if len(list) != len(want) {
+		t.Fatalf("got %v want %v", list, want)
+	}
+	for i := range want {
+		if list[i] != want[i] {
+			t.Fatalf("got %v want %v", list, want)
+		}
+	}
+	// The change is persisted and takes effect: dan can now create tasks, ben cannot.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("dan create: %d", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Fatalf("ben create: %d", code)
+	}
+}
+
+func TestChangeRolesAllOrNothing(t *testing.T) {
+	h := newServer()
+	// ben is valid, hal is not a member: nothing may change.
+	if code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","hal":"viewer"}}`); code != 400 {
+		t.Fatalf("got %d", code)
+	}
+	if got := members(t, h, "web")["ben"]; got != "contributor" {
+		t.Fatalf("ben changed to %s", got)
+	}
+	// Removing every manager is rejected as a whole.
+	if code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"viewer","ann":"viewer","ivy":"viewer"}}`); code != 400 {
+		t.Fatalf("got %d", code)
+	}
+	if got := members(t, h, "web"); got["ann"] != "manager" || got["ivy"] != "manager" {
+		t.Fatalf("managers changed: %v", got)
+	}
+}
+
+func TestChangeRolesUnassignsDemoted(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer"}}`); code != 200 {
+		t.Fatal(code, body)
+	}
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatal(code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "" {
+		t.Fatalf("t1 still assigned to %s", task.AssigneeID)
+	}
+	// cat's task is untouched.
+	_, body = do(t, h, "GET", "/projects/web/tasks/t2", "ann", "")
+	if err := json.Unmarshal([]byte(body), &task); err != nil || task.AssigneeID != "cat" {
+		t.Fatalf("t2: %s", body)
+	}
+}
