+// changeRolesAggregate changes the roles of several members of one project.
+type changeRolesAggregate struct {
+	members []*Membership // the members to change, with their current roles
+	roles   []string      // new role of members[i]
+	all     []*Membership // every member of the project before the change
+}
+
+func loadChangeRoles(ctx context.Context, tx DB, projectID string, in map[string]string) (*changeRolesAggregate, error) {
+	if len(in) == 0 {
+		return nil, deny(ErrInvalid, "roles must not be empty")
+	}
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	all, err := p.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	a := &changeRolesAggregate{all: all}
+	for _, m := range all {
+		role, ok := in[m.UserID]
+		if !ok {
+			continue
+		}
+		a.members = append(a.members, m)
+		a.roles = append(a.roles, role)
+	}
+	if len(a.members) != len(in) {
+		return nil, deny(ErrInvalid, "every user must be a member of the project")
+	}
+	return a, nil
+}
+
+func (a *changeRolesAggregate) validate() error {
+	newRole := map[string]string{}
+	for i, m := range a.members {
+		role := a.roles[i]
+		if role != RoleManager && role != RoleContributor && role != RoleViewer {
+			return deny(ErrInvalid, "role must be manager, contributor or viewer")
+		}
+		newRole[m.UserID] = role
+	}
+	for _, m := range a.all {
+		role, ok := newRole[m.UserID]
+		if !ok {
+			role = m.Role
+		}
+		if role == RoleManager {
+			return nil
+		}
+	}
+	return deny(ErrInvalid, "the project must keep at least one manager")
+}
+
+func (a *changeRolesAggregate) apply(ctx context.Context, tx DB) error {
+	for i, m := range a.members {
+		if err := m.setRole(ctx, tx, a.roles[i]); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
