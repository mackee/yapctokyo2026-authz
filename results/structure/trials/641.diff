diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..5681bcb
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,86 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"reflect"
+	"testing"
+)
+
+func decodeMembers(t *testing.T, body string) map[string]string {
+	t.Helper()
+	var ms []struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &ms); err != nil {
+		t.Fatalf("bad body %q: %v", body, err)
+	}
+	out := map[string]string{}
+	for _, m := range ms {
+		out[m.UserID] = m.Role
+	}
+	return out
+}
+
+func TestChangeRoles(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != http.StatusOK {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	want := map[string]string{"ann": "manager", "ben": "viewer", "cat": "contributor", "dan": "contributor", "ivy": "manager"}
+	if got := decodeMembers(t, body); !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+}
+
+func TestChangeRolesErrors(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"invalid role", "ann", "web", `{"roles":{"dan":"boss"}}`, 400},
+		{"not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"other project member", "ann", "web", `{"roles":{"gus":"viewer"}}`, 400},
+		{"empty", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"malformed", "ann", "web", `{"roles":`, 400},
+		{"no manager left", "ann", "web", `{"roles":{"ann":"viewer","ivy":"contributor"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestChangeRolesAllOrNothing(t *testing.T) {
+	h := newServer()
+	// dan is valid, hal is not a member: nothing may change.
+	code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"manager","hal":"viewer"}}`)
+	if code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	code, _ = do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"cat":"boss","dan":"manager"}}`)
+	if code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	// A no-op change returns the current members.
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ann":"manager"}}`)
+	if code != 200 {
+		t.Fatal(code)
+	}
+	if got := decodeMembers(t, body); got["dan"] != "viewer" || got["cat"] != "contributor" {
+		t.Fatalf("partial change applied: %v", got)
+	}
+}
