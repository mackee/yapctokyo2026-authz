new file mode 100644
index 0000000..ad6f3d6
--- /dev/null
+++ b/freeze_test.go
@@ -0,0 +1,107 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"strings"
+	"testing"
+)
+
+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"missing project", "ann", "nope", 404},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	want := `[{"userId":"ann","role":"viewer"},{"userId":"ben","role":"viewer"},` +
+		`{"userId":"cat","role":"viewer"},{"userId":"dan","role":"viewer"},{"userId":"ivy","role":"viewer"}]`
+	if got := strings.TrimSpace(body); got != want {
+		t.Fatalf("body\n got: %s\nwant: %s", got, want)
+	}
+}
+
+func TestFreezeBlocksTaskChanges(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d want 200", code)
+	}
+
+	cases := []struct {
+		name, user, method, path, body string
+		want                           int
+	}{
+		{"manager cannot update", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"former contributor cannot update own task", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`, 403},
+		{"manager cannot reassign", "ivy", "PATCH", "/projects/web/tasks/t1", `{"assignee":"cat"}`, 403},
+		{"manager cannot create", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"manager cannot delete", "ann", "DELETE", "/projects/web/tasks/t3", "", 403},
+		{"second freeze by a viewer", "ben", "POST", "/projects/web/freeze", "", 403},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			if code, _ := do(t, h, c.method, c.path, c.user, c.body); code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+
+	// Reads still work, and the assignments are kept.
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "dan", "")
+	if code != 200 {
+		t.Fatalf("read: got %d want 200", code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.Status != "open" || task.AssigneeID != "ben" {
+		t.Fatalf("task t1 after freeze: %+v", task)
+	}
+}
+
+func TestFreezeOnlyAffectsItsProject(t *testing.T) {
+	h := newServer()
+	mustFreeze(t, h, "ann", "web")
+
+	// ivy is a manager of ops, which is not frozen.
+	if code, _ := do(t, h, "PATCH", "/projects/ops/tasks/t4", "ivy", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ops update by ivy: got %d want 200", code)
+	}
+	// ann keeps her viewer role in ops and still cannot change it.
+	if code, _ := do(t, h, "PATCH", "/projects/ops/tasks/t4", "ann", `{"status":"doing"}`); code != 403 {
+		t.Fatalf("ops update by ann: got %d want 403", code)
+	}
+}
+
+func mustFreeze(t *testing.T, h http.Handler, user, project string) string {
+	t.Helper()
+	code, body := do(t, h, "POST", "/projects/"+project+"/freeze", user, "")
+	if code != 200 {
+		t.Fatalf("freeze %s by %s: got %d want 200: %s", project, user, code, body)
+	}
+	return body
+}
