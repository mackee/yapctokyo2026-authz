+// changeRolesAggregate changes the roles of several members of one project.
+type changeRolesAggregate struct {
+	members []*Membership     // project.Memberships
+	roles   map[string]string // user ID -> new role
+}
+
+func loadChangeRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*changeRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	members, err := p.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	found := map[string]bool{}
+	for _, m := range members {
+		found[m.UserID] = true
+	}
+	for user := range roles {
+		if !found[user] {
+			return nil, deny(ErrInvalid, "not a member of the project: "+user)
+		}
+	}
+	return &changeRolesAggregate{members: members, roles: roles}, nil
+}
+
+func (a *changeRolesAggregate) validate() error {
+	managers := 0
+	for _, m := range a.members {
+		role := m.Role
+		if r, ok := a.roles[m.UserID]; ok {
+			role = r
+		}
+		if role == RoleManager {
+			managers++
+		}
+	}
+	if managers == 0 {
+		return deny(ErrInvalid, "a project needs at least one manager")
+	}
+	return nil
+}
+
+// apply changes the roles. A member who is no longer a contributor or manager
+// cannot be an assignee, so their tasks in the project are unassigned.
+func (a *changeRolesAggregate) apply(ctx context.Context, tx DB) error {
+	for _, m := range a.members {
+		role, ok := a.roles[m.UserID]
+		if !ok || role == m.Role {
+			continue
+		}
+		if err := m.setRole(ctx, tx, role); err != nil {
+			return err
+		}
+		if isWriterRole(role) {
+			continue
+		}
+		tasks, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return err
+		}
+		for _, t := range tasks {
+			if err := t.unassign(ctx, tx); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
