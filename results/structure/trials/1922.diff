diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..cb25abf
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,161 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"testing"
+)
+
+type memberJSON struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func memberRole(t *testing.T, h http.Handler, project, user string) string {
+	t.Helper()
+	var role string
+	err := h.(*appHandler).db.QueryRow(
+		`SELECT role FROM memberships WHERE project_id = ? AND user_id = ?`, project, user).Scan(&role)
+	if err != nil {
+		return ""
+	}
+	return role
+}
+
+func taskAssignee(t *testing.T, h http.Handler, id string) string {
+	t.Helper()
+	var a string
+	if err := h.(*appHandler).db.QueryRow(`SELECT assignee FROM tasks WHERE id = ?`, id).Scan(&a); err != nil {
+		t.Fatal(err)
+	}
+	return a
+}
+
+func TestChangeRolesReturnsMembers(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []memberJSON
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []memberJSON{
+		{"ann", "manager"}, {"ben", "viewer"}, {"cat", "contributor"}, {"dan", "contributor"}, {"ivy", "manager"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("got %v want %v", got, want)
+		}
+	}
+	if r := memberRole(t, h, "web", "ben"); r != "viewer" {
+		t.Fatalf("ben is %q", r)
+	}
+	if r := memberRole(t, h, "web", "dan"); r != "contributor" {
+		t.Fatalf("dan is %q", r)
+	}
+}
+
+// A member who becomes a viewer can no longer be an assignee (model rule), so
+// the tasks assigned to them are unassigned.
+func TestChangeRolesUnassignsDemotedMember(t *testing.T) {
+	h := newServer()
+	if a := taskAssignee(t, h, "t1"); a != "ben" {
+		t.Fatalf("seed: t1 assignee %q", a)
+	}
+	if code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer"}}`); code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	if a := taskAssignee(t, h, "t1"); a != "" {
+		t.Fatalf("t1 should be unassigned, got %q", a)
+	}
+	if a := taskAssignee(t, h, "t2"); a != "cat" {
+		t.Fatalf("t2 must be untouched, got %q", a)
+	}
+}
+
+func TestChangeRolesSameRoleIsAccepted(t *testing.T) {
+	code, _ := do(t, newServer(), "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d", code)
+	}
+}
+
+func TestChangeRolesStatus(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager", "ivy", "web", `{"roles":{"dan":"manager"}}`, 200},
+		{"manager of ops", "ivy", "ops", `{"roles":{"ann":"contributor"}}`, 200},
+		{"demote one of two managers", "ann", "web", `{"roles":{"ann":"viewer"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"unknown role", "ann", "web", `{"roles":{"dan":"admin"}}`, 400},
+		{"empty role", "ann", "web", `{"roles":{"dan":""}}`, 400},
+		{"not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"member of other project only", "ivy", "ops",`{"roles":{"ben":"viewer"}}`, 400},
+		{"user from other org", "ann", "web", `{"roles":{"gus":"viewer"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"malformed", "ann", "web", `{"roles":`, 400},
+		{"no manager left", "ann", "web", `{"roles":{"ann":"viewer","ivy":"contributor"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+// One entry that cannot be changed rejects the whole request and changes nothing.
+func TestChangeRolesIsAllOrNothing(t *testing.T) {
+	bodies := []string{
+		`{"roles":{"dan":"contributor","ben":"admin"}}`,
+		`{"roles":{"dan":"contributor","hal":"viewer"}}`,
+		`{"roles":{"dan":"contributor","ann":"viewer","ivy":"viewer"}}`,
+	}
+	for _, body := range bodies {
+		h := newServer()
+		code, _ := do(t, h, "PUT", "/projects/web/members", "ann", body)
+		if code != 400 {
+			t.Fatalf("%s: got %d want 400", body, code)
+		}
+		for user, want := range map[string]string{"ann": "manager", "ben": "contributor", "dan": "viewer", "ivy": "manager"} {
+			if r := memberRole(t, h, "web", user); r != want {
+				t.Fatalf("%s: %s is %q want %q", body, user, r, want)
+			}
+		}
+		if a := taskAssignee(t, h, "t1"); a != "ben" {
+			t.Fatalf("%s: t1 assignee %q", body, a)
+		}
+	}
+}
+
+func TestChangeRolesDeniedChangesNothing(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "PUT", "/projects/legacy/members", "ann", `{"roles":{"ben":"viewer"}}`); code != 409 {
+		t.Fatal(code)
+	}
+	if r := memberRole(t, h, "legacy", "ben"); r != "contributor" {
+		t.Fatalf("ben is %q", r)
+	}
+	if code, _ := do(t, h, "PUT", "/projects/web/members", "ben", `{"roles":{"dan":"manager"}}`); code != 403 {
+		t.Fatal(code)
+	}
+	if r := memberRole(t, h, "web", "dan"); r != "viewer" {
+		t.Fatalf("dan is %q", r)
+	}
+}
