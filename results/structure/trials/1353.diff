+func TestTransferStatus(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin transfers", "eve", "/orgs/acme/users/ann/transfer", `{"toOrgId":"globex"}`, 200},
+		{"non admin", "ann", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 403},
+		{"caller in other org", "gus", "/orgs/acme/users/ann/transfer", `{"toOrgId":"globex"}`, 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"globex"}`, 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"same org", "eve", "/orgs/acme/users/ann/transfer", `{"toOrgId":"acme"}`, 400},
+		{"unknown destination", "eve", "/orgs/acme/users/ann/transfer", `{"toOrgId":"initech"}`, 400},
+		{"bad body", "eve", "/orgs/acme/users/ann/transfer", `{}`, 400},
+		{"anonymous", "", "/orgs/acme/users/ann/transfer", `{"toOrgId":"globex"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferEffects(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got map[string]string
+	json.Unmarshal([]byte(body), &got)
+	if got["id"] != "ben" || got["orgId"] != "globex" {
+		t.Fatalf("unexpected response %v", got)
+	}
+	// ben lost access to acme projects, so he can no longer read them...
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("moved user still reads old org project: %d", code)
+	}
+	// ...and his tasks are unassigned.
+	_, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" {
+		t.Fatalf("task still assigned to %q", task.Assignee)
+	}
+}
+
+func TestTransferDropsOrgAdmin(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatal(code)
+	}
+	// eve must not become an admin of globex.
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "eve", ""); code != 404 {
+		t.Fatalf("moved admin kept org admin: %d", code)
+	}
+}
