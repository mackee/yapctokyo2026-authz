+  def moveOutcome(u: UserId, p: ProjectId, t: TaskId, dest: ProjectId): int =
+    if (not(userExists(u))) 401
+    else if (not(canRead(u, p))) 404
+    else if (not(taskExists(t)) or tasks.get(t).project != p) 404
+    else if (not(isWriter(p, u))) 403
+    else if (roleOf(p, u) == "contributor" and tasks.get(t).assignee != u) 403
+    else if (projects.get(p).archived) 409
+    else if (not(canRead(u, dest))) 404
+    else if (not(isWriter(dest, u))) 403
+    else if (projects.get(dest).archived) 409
+    else if (dest == p) 400
+    else if (tasks.get(t).assignee != "" and not(isWriter(dest, tasks.get(t).assignee))) 400
+    else 200
