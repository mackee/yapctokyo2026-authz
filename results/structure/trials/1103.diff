diff --git a/offboard_test.go b/offboard_test.go
new file mode 100644
index 0000000..56436cf
--- /dev/null
+++ b/offboard_test.go
@@ -0,0 +1,65 @@
+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestRemoveOrgUser(t *testing.T) {
+	h := newServer()
+
+	// ben: web contributor (t1), legacy contributor (t5, archived project).
+	if code, body := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("got %d want 204 body=%s", code, body)
+	}
+
+	// ben lost access to every project (404: not readable any more).
+	for _, p := range []string{"web", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ben", ""); code != 404 {
+			t.Errorf("ben on %s: got %d want 404", p, code)
+		}
+	}
+	// his tasks are unassigned, including the one in the archived project.
+	for _, path := range []string{"/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		code, body := do(t, h, "GET", path, "ann", "")
+		if code != 200 || !strings.Contains(body, `"assignee":""`) {
+			t.Errorf("%s: got %d %s, want 200 with empty assignee", path, code, body)
+		}
+	}
+	// other members are untouched.
+	if code, body := do(t, h, "GET", "/projects/web/tasks/t2", "ann", ""); code != 200 || !strings.Contains(body, `"assignee":"cat"`) {
+		t.Errorf("cat's task changed: %d %s", code, body)
+	}
+	// removing again: the user is still in the org, so it is a no-op success.
+	if code, body := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Errorf("second removal: got %d want 204 body=%s", code, body)
+	}
+}
+
+func TestRemoveOrgUserDenied(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"no user", "", "/orgs/acme/users/ben", 401},
+		{"unknown user", "zed", "/orgs/acme/users/ben", 401},
+		{"manager is not an org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"member is not an org admin", "ben", "/orgs/acme/users/cat", 403},
+		{"other org", "gus", "/orgs/acme/users/ben", 404},
+		{"admin of another org's path", "eve", "/orgs/globex/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/nobody", 404},
+		{"target in another org", "eve", "/orgs/acme/users/gus", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			if code, body := do(t, h, "DELETE", c.path, c.user, ""); code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+			// nothing changed
+			if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+				t.Fatalf("ben lost access: %d", code)
+			}
+		})
+	}
+}
