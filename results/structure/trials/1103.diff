+// removeUserFromOrgAggregate removes one user from all projects of an
+// organization. Tasks assigned to the user are unassigned first, so the rule
+// "an assignee is a contributor or manager of the task's project" keeps holding.
+type removeUserFromOrgAggregate struct {
+	user        *User
+	memberships []*Membership
+	assigned    []*Task // tasks of those projects assigned to the user
+}
+
+func loadRemoveUserFromOrg(ctx context.Context, tx DB, orgID, userID string) (*removeUserFromOrgAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != orgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	a := &removeUserFromOrgAggregate{user: u, memberships: ms}
+	for _, m := range ms {
+		ts, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.assigned = append(a.assigned, ts...)
+	}
+	return a, nil
+}
+
+func (a *removeUserFromOrgAggregate) validate() error { return nil }
+
+func (a *removeUserFromOrgAggregate) apply(ctx context.Context, tx DB) error {
+	for _, t := range a.assigned {
+		if err := t.unassign(ctx, tx); err != nil {
+			return err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
