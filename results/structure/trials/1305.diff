+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes self", "eve", "/orgs/acme/users/eve", 204},
+		{"manager is not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"contributor", "ben", "/orgs/acme/users/cat", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"caller in other org", "gus", "/orgs/acme/users/ben", 404},
+		{"org admin, other org path", "eve", "/orgs/globex/users/gus", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("got %d want 204: %s", code, body)
+	}
+
+	// ben is no longer a member of web or of the archived legacy project.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("web: got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/legacy/tasks", "ben", ""); code != 404 {
+		t.Fatalf("legacy: got %d want 404", code)
+	}
+
+	// Tasks ben was assigned to in acme projects are unassigned, legacy included.
+	for _, path := range []string{"/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		_, body := do(t, srv, "GET", path, "ann", "")
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.Assignee != "" {
+			t.Fatalf("%s: assignee %q, want unassigned", path, task.Assignee)
+		}
+	}
+
+	// Other assignments, other members and other orgs are untouched.
+	_, body := do(t, srv, "GET", "/projects/web/tasks/t2", "ann", "")
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.Assignee != "cat" {
+		t.Fatalf("t2 assignee %q, want cat", task.Assignee)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat lost access to web: %d", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/gx/tasks/t6", "gus", ""); code != 200 {
+		t.Fatalf("gus lost access to gx: %d", code)
+	}
+}
