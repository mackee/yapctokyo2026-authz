diff --git a/internal/capability/move_test.go b/internal/capability/move_test.go
new file mode 100644
index 0000000..f3d7e68
--- /dev/null
+++ b/internal/capability/move_test.go
@@ -0,0 +1,75 @@
+package capability
+
+import (
+	"errors"
+	"testing"
+)
+
+// A manager of the source project who is only a contributor in the destination
+// may move only unassigned tasks or tasks assigned to themselves, as CreateTask
+// allows.
+func TestMoveContributorDestination(t *testing.T) {
+	a := New()
+	// ann: manager of web, contributor of ops.
+	if err := a.db.update(func(x *tx) error {
+		x.t.members["ops"]["ann"] = RoleContributor
+		return nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+	ann, err := a.Authenticate("ann")
+	if err != nil {
+		t.Fatal(err)
+	}
+	dst, err := ann.Project("ops").Write()
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	// t2 is assigned to cat, a contributor of ops, not to ann: forbidden.
+	m, err := ann.Project("web").Task("t2").Manage()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := m.Move(dst); !errors.Is(err, ErrForbidden) {
+		t.Fatalf("move other's task: got %v, want ErrForbidden", err)
+	}
+
+	// t3 is unassigned: allowed.
+	m, err = ann.Project("web").Task("t3").Manage()
+	if err != nil {
+		t.Fatal(err)
+	}
+	v, err := m.Move(dst)
+	if err != nil {
+		t.Fatalf("move unassigned task: %v", err)
+	}
+	if v.ID != "t3" || v.ProjectID != "ops" {
+		t.Fatalf("moved view = %+v", v)
+	}
+}
+
+// A destination capability acquired by another actor is rejected, even though
+// it is a valid Write capability for that project.
+func TestMoveRejectsForeignDestination(t *testing.T) {
+	a := New()
+	ivy, err := a.Authenticate("ivy")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ann, err := a.Authenticate("ann")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ivyOps, err := ivy.Project("ops").Write()
+	if err != nil {
+		t.Fatal(err)
+	}
+	m, err := ann.Project("web").Task("t3").Manage()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := m.Move(ivyOps); !errors.Is(err, ErrForbidden) {
+		t.Fatalf("foreign destination: got %v, want ErrForbidden", err)
+	}
+}
