+// moveTaskAggregate moves one task into another project. The task keeps its ID,
+// title, status and assignee, so the assignee must already be a contributor or
+// manager of the destination project. The mover must be allowed to create a
+// task there with that assignee, the same rule as CreateTask.
+type moveTaskAggregate struct {
+	task      taskRecord
+	dst       projectRecord
+	assignee  *membershipRecord // dst.Membership(task assignee); nil when unassigned
+	moverID   string
+	moverRole string // the mover's role in the destination project
+}
+
+func loadMoveTask(x *tx, taskID, fromPID, toPID, moverID, moverRole string) (*moveTaskAggregate, error) {
+	t, ok := x.findTask(taskID)
+	if !ok || t.ProjectID != fromPID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	dst, ok := x.findProject(toPID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	a := &moveTaskAggregate{task: t, dst: dst, moverID: moverID, moverRole: moverRole}
+	if t.AssigneeID != "" {
+		m, ok := dst.Membership(x, t.AssigneeID)
+		if !ok {
+			return nil, deny(ErrInvalid, "assignee must be a contributor or manager of the destination project")
+		}
+		a.assignee = &m
+	}
+	return a, nil
+}
+
+func (a *moveTaskAggregate) validate() error {
+	if a.assignee != nil && !isWriterRole(a.assignee.Role) {
+		return deny(ErrInvalid, "assignee must be a contributor or manager of the destination project")
+	}
+	if a.moverRole == RoleContributor && a.task.AssigneeID != "" && a.task.AssigneeID != a.moverID {
+		return deny(ErrForbidden, "contributors may only move tasks assigned to themselves")
+	}
+	return nil
+}
+
+func (a *moveTaskAggregate) apply(x *tx) TaskView {
+	t := a.task
+	t.MoveTo(x, a.dst.ID)
+	return t.view()
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task taskRecord
