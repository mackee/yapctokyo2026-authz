+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat lost membership: got %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/legacy/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben lost membership: got %d", code)
+	}
+	code, body := do(t, h, "GET", "/projects/legacy/tasks/t5", "ann", "")
