@@ -0,0 +1,112 @@
+package main
+
+import (
+	"encoding/json"
+	"reflect"
+	"testing"
+)
+
+// frozenMember is one entry of the POST /projects/{pid}/freeze response.
+type frozenMember struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager freezes", "ann", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+		{"unknown project", "ann", "nope", 404},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeReturnsViewerMembers(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got []frozenMember
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("response is not a member list: %v: %s", err, body)
+	}
+	// Every member of web, manager included, is now a viewer; ordered by user ID.
+	want := []frozenMember{
+		{UserID: "ann", Role: "viewer"},
+		{UserID: "ben", Role: "viewer"},
+		{UserID: "cat", Role: "viewer"},
+		{UserID: "dan", Role: "viewer"},
+		{UserID: "ivy", Role: "viewer"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+}
+
+func TestFreezeBlocksTaskWrites(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d want 200: %s", code, body)
+	}
+
+	cases := []struct {
+		name, user, method, path, body string
+		want                           int
+	}{
+		{"manager update", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"manager delete", "ann", "DELETE", "/projects/web/tasks/t1", "", 403},
+		{"manager create", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"former contributor update own", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`, 403},
+		{"former manager update", "ivy", "PATCH", "/projects/web/tasks/t3", `{"title":"y"}`, 403},
+		{"former manager create", "ivy", "POST", "/projects/web/tasks", `{"title":"y"}`, 403},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, srv, c.method, c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+		})
+	}
+
+	// Reads still work, and the tasks are unchanged.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks/t2", "ann", ""); code != 200 {
+		t.Fatalf("read after freeze: got %d want 200", code)
+	}
+	_, body := do(t, srv, "GET", "/projects/web/tasks/t2", "ann", "")
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.Status != "doing" {
+		t.Fatalf("task t2 changed by a frozen project: status %q", task.Status)
+	}
+}
+
+func TestFreezeLeavesOtherProjectsWritable(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/projects/web/freeze", "ivy", ""); code != 200 {
+		t.Fatalf("freeze: got %d want 200: %s", code, body)
+	}
+	// ivy is a manager of ops, which was not frozen.
+	if code, body := do(t, srv, "PATCH", "/projects/ops/tasks/t4", "ivy", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ops update after web freeze: got %d want 200: %s", code, body)
+	}
+}
