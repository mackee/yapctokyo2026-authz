+type moveRequest struct {
+	ToProjectID string `json:"toProjectId"`
+}
+
+type moveResponse struct {
+	UserID    string `json:"userId"`
+	ProjectID string `json:"projectId"`
+	Role      string `json:"role"`
+}
+
+// moveMember removes a member from the path project and adds them to toProjectId
+// with the same role. Tasks they held in the path project are unassigned.
+func (s *server) moveMember(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role, err := findRole(ctx, s.db, project.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req moveRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || req.ToProjectID == "" {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	if req.ToProjectID == project.ID {
+		writeError(w, 400, "target must be a different project")
+		return
+	}
+	target, err := findProject(ctx, s.db, req.ToProjectID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if target == nil || target.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	targetRole, err := findRole(ctx, s.db, target.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if targetRole == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if targetRole != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if target.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	subject := r.PathValue("uid")
+	subjectRole, err := findRole(ctx, s.db, project.ID, subject)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if subjectRole == "" {
+		writeError(w, 404, "user is not a member of the project")
+		return
+	}
+	existing, err := findRole(ctx, s.db, target.ID, subject)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if existing != "" {
+		writeError(w, 409, "user is already a member of the target project")
+		return
+	}
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+	if _, err := tx.ExecContext(ctx, `DELETE FROM memberships WHERE project_id = ? AND user_id = ?`, project.ID, subject); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if _, err := tx.ExecContext(ctx, `INSERT INTO memberships (project_id, user_id, role) VALUES (?, ?, ?)`, target.ID, subject, subjectRole); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	// The user no longer belongs to the path project, so their tasks there become unassigned.
+	if _, err := tx.ExecContext(ctx, `UPDATE tasks SET assignee = '' WHERE project_id = ? AND assignee = ?`, project.ID, subject); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, moveResponse{UserID: subject, ProjectID: target.ID, Role: subjectRole})
+}
diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..7b50ce8
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,138 @@
+package main
+
+import (
+	"database/sql"
+	"encoding/json"
+	"net/http"
+	"testing"
+)
+
+// membershipRole returns the user's role in the project ("" if not a member),
+// read straight from the database behind h.
+func membershipRole(t *testing.T, h http.Handler, projectID, userID string) string {
+	t.Helper()
+	var role string
+	err := h.(*appHandler).db.QueryRow(`SELECT role FROM memberships WHERE project_id = ? AND user_id = ?`, projectID, userID).Scan(&role)
+	if err == sql.ErrNoRows {
+		return ""
+	}
+	if err != nil {
+		t.Fatal(err)
+	}
+	return role
+}
+
+// taskAssignee returns the assignee of a task, read straight from the database behind h.
+func taskAssignee(t *testing.T, h http.Handler, taskID string) string {
+	t.Helper()
+	var assignee string
+	if err := h.(*appHandler).db.QueryRow(`SELECT assignee FROM tasks WHERE id = ?`, taskID).Scan(&assignee); err != nil {
+		t.Fatal(err)
+	}
+	return assignee
+}
+
+func TestMoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager of both moves contributor", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 200},
+		{"manager of both moves viewer", "ivy", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 200},
+		{"contributor may not move", "ben", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer may not move", "dan", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin may not move", "eve", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"non member", "hal", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"other org", "gus", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 401},
+		{"unknown user", "zed", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 401},
+		{"source project missing", "ivy", "/projects/nope/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"subject not a member of source", "ivy", "/projects/web/members/hal/move", `{"toProjectId":"ops"}`, 404},
+		{"target project missing", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"nope"}`, 404},
+		{"target in other org", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"gx"}`, 404},
+		{"target not readable by caller", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"legacy"}`, 404},
+		{"target readable but not managed by caller", "ann", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 403},
+		{"target archived", "ann", "/projects/web/members/dan/move", `{"toProjectId":"legacy"}`, 409},
+		{"source archived", "ann", "/projects/legacy/members/ben/move", `{"toProjectId":"web"}`, 409},
+		{"subject already in target", "ivy", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 409},
+		{"same project", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"web"}`, 400},
+		{"missing target id", "ivy", "/projects/web/members/ben/move", `{}`, 400},
+		{"invalid body", "ivy", "/projects/web/members/ben/move", `not json`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveMemberMovesMembership(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("response is not JSON: %v: %s", err, body)
+	}
+	want := map[string]string{"userId": "ben", "projectId": "ops", "role": "contributor"}
+	for k, v := range want {
+		if got[k] != v {
+			t.Fatalf("response %q: got %q want %q (full body %s)", k, got[k], v, body)
+		}
+	}
+	if len(got) != len(want) {
+		t.Fatalf("response has extra fields: %s", body)
+	}
+
+	if role := membershipRole(t, h, "web", "ben"); role != "" {
+		t.Fatalf("ben still a member of web as %q", role)
+	}
+	if role := membershipRole(t, h, "ops", "ben"); role != "contributor" {
+		t.Fatalf("ben in ops: got role %q want contributor", role)
+	}
+	// Tasks ben held in web are unassigned, since ben no longer belongs there.
+	if a := taskAssignee(t, h, "t1"); a != "" {
+		t.Fatalf("t1 still assigned to %q after the move", a)
+	}
+	// Ben's membership in other projects is untouched.
+	if role := membershipRole(t, h, "legacy", "ben"); role != "contributor" {
+		t.Fatalf("ben in legacy: got role %q want contributor", role)
+	}
+	if a := taskAssignee(t, h, "t5"); a != "ben" {
+		t.Fatalf("t5 in legacy: assignee %q want ben", a)
+	}
+}
+
+func TestMoveMemberKeepsViewerRole(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/members/dan/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	if role := membershipRole(t, h, "ops", "dan"); role != "viewer" {
+		t.Fatalf("dan in ops: got role %q want viewer", role)
+	}
+	if role := membershipRole(t, h, "web", "dan"); role != "" {
+		t.Fatalf("dan still a member of web as %q", role)
+	}
+}
+
+func TestMoveMemberRejectedLeavesDataUnchanged(t *testing.T) {
+	h := newServer()
+	// cat is already in ops, so the move is refused and nothing may change.
+	code, _ := do(t, h, "POST", "/projects/web/members/cat/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 409 {
+		t.Fatalf("got %d want 409", code)
+	}
+	if role := membershipRole(t, h, "web", "cat"); role != "contributor" {
+		t.Fatalf("cat in web: got role %q want contributor", role)
+	}
+	if a := taskAssignee(t, h, "t2"); a != "cat" {
+		t.Fatalf("t2 assignee %q want cat", a)
+	}
+}
