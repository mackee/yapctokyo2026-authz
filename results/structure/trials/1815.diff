+// updateMembershipAggregate changes the role of one member of one project.
+type updateMembershipAggregate struct {
+	membership *Membership
+	role       string
+	assigned   []*Task // the project's tasks assigned to the member
+}
+
+func loadUpdateMembership(ctx context.Context, tx DB, projectID, userID string, in MembershipTableUpdateInput) (*updateMembershipAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	assigned, err := m.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &updateMembershipAggregate{membership: m, role: in.Role, assigned: assigned}, nil
+}
+
+func (a *updateMembershipAggregate) validate() error {
+	if !isWriterRole(a.role) && len(a.assigned) > 0 {
+		return deny(ErrInvalid, "member is assigned tasks in the project and must stay a contributor or manager")
+	}
+	return nil
+}
+
+func (a *updateMembershipAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.membership.setRole(ctx, tx, a.role); err != nil {
+		return nil, err
+	}
+	return a.membership, nil
+}
