+type MembershipTableUpdateInput struct {
+	Role string // manager, contributor or viewer
+}
+
+// Update changes the role of the user's membership in the project and returns
+// it. Only managers may do so (CanManageMembers). A member who is assigned
+// tasks in the project must stay a contributor or manager, so demoting such a
+// member to viewer is rejected (ErrInvalid) and nothing changes.
+func (*MembershipTable) Update(ctx context.Context, db DB, authz ProjectAuthz, userID string, in MembershipTableUpdateInput) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if !isKnownRole(in.Role) {
+		return nil, deny(ErrInvalid, "role must be manager, contributor or viewer")
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadUpdateMembership(ctx, tx, authz.ProjectID(), userID, in)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if m, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
