diff --git a/transfer.go b/transfer.go
new file mode 100644
index 0000000..b27cad3
--- /dev/null
+++ b/transfer.go
@@ -0,0 +1,97 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+)
+
+type transferRequest struct {
+	ToOrgID string `json:"toOrgId"`
+}
+
+// transferUser moves a user to another organization (group-company transfer).
+//
+// Only an org admin of {orgID} may do it; the user must belong to {orgID}.
+// To keep the model rules intact the user leaves everything tied to the old org:
+// their project memberships are removed, tasks assigned to them are unassigned,
+// and the org admin flag is cleared (admin rights do not carry over).
+func (s *server) transferUser(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	caller, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if caller == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	orgID := r.PathValue("orgID")
+	if caller.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	if !caller.OrgAdmin {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	target, err := findUser(ctx, s.db, r.PathValue("uid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if target == nil || target.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	var req transferRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || req.ToOrgID == "" {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	if req.ToOrgID == orgID {
+		writeError(w, 400, "user already belongs to that organization")
+		return
+	}
+	// Organizations have no table of their own: one exists if it has users or projects.
+	var exists bool
+	if err := s.db.QueryRowContext(ctx,
+		`SELECT EXISTS(SELECT 1 FROM users WHERE org_id = ?) OR EXISTS(SELECT 1 FROM projects WHERE org_id = ?)`,
+		req.ToOrgID, req.ToOrgID).Scan(&exists); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if !exists {
+		writeError(w, 400, "unknown destination organization")
+		return
+	}
+
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+	stmts := []string{
+		`UPDATE tasks SET assignee = '' WHERE assignee = ?`,
+		`DELETE FROM memberships WHERE user_id = ?`,
+		`UPDATE users SET org_id = ?2, org_admin = 0 WHERE id = ?1`,
+	}
+	for i, q := range stmts {
+		var args []any
+		if i == 2 {
+			args = []any{target.ID, req.ToOrgID}
+		} else {
+			args = []any{target.ID}
+		}
+		if _, err := tx.ExecContext(ctx, q, args...); err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, map[string]string{"id": target.ID, "orgId": req.ToOrgID})
+}
diff --git a/transfer_test.go b/transfer_test.go
new file mode 100644
index 0000000..516f25c
--- /dev/null
+++ b/transfer_test.go
@@ -0,0 +1,68 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestTransfer(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 200},
+		{"admin transfers self", "eve", "/orgs/acme/users/eve/transfer", `{"toOrgId":"globex"}`, 200},
+		{"anonymous", "", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 401},
+		{"non admin", "ann", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 403},
+		{"admin of other org path", "eve", "/orgs/globex/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"other org admin", "gus", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 404},
+		{"user not in org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"same org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"acme"}`, 400},
+		{"unknown dest org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"nowhere"}`, 400},
+		{"empty dest", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":""}`, 400},
+		{"bad body", "eve", "/orgs/acme/users/ben/transfer", `nope`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferCleansUp(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got map[string]string
+	json.Unmarshal([]byte(body), &got)
+	if got["id"] != "ben" || got["orgId"] != "globex" {
+		t.Fatalf("bad response %v", got)
+	}
+	// ben lost access to the old org's projects and tasks assigned to him are unassigned.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben still sees web: %d", code)
+	}
+	_, b := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(b), &task)
+	if task.Assignee != "" {
+		t.Fatalf("t1 still assigned to %q", task.Assignee)
+	}
+}
+
+func TestTransferClearsOrgAdmin(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatal(code)
+	}
+	// eve is no longer an admin anywhere: she cannot transfer gus.
+	if code, _ := do(t, h, "POST", "/orgs/globex/users/gus/transfer", "eve", `{"toOrgId":"acme"}`); code != 403 {
+		t.Fatalf("got %d want 403", code)
+	}
+}
