+func TestFreeze(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatal(code)
+	}
+	want := `[{"userId":"ann","role":"viewer"},{"userId":"ben","role":"viewer"},{"userId":"cat","role":"viewer"},{"userId":"dan","role":"viewer"},{"userId":"ivy","role":"viewer"}]`
+	if got := strings.TrimSpace(body); got != want {
+		t.Fatalf("got %s\nwant %s", got, want)
+	}
+}
+
+func TestFreezeStopsWrites(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatal(code)
+	}
+	cases := []struct {
+		name, user, method, path, body string
+		want                           int
+	}{
+		{"contributor own task", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`, 403},
+		{"contributor other task", "cat", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"former manager edits", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"former manager creates", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"former manager deletes", "ann", "DELETE", "/projects/web/tasks/t1", "", 403},
+		{"ivy still manages ops", "ivy", "POST", "/projects/ops/tasks", `{"title":"x"}`, 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, srv, c.method, c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+
+	// Tasks of the frozen project are unassigned; other projects are untouched.
+	_, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.AssigneeID != "" {
+		t.Fatalf("frozen task still assigned to %q", task.AssigneeID)
+	}
+	_, body = do(t, srv, "GET", "/projects/ops/tasks/t4", "ann", "")
+	json.Unmarshal([]byte(body), &task)
+	if task.AssigneeID != "cat" {
+		t.Fatalf("task in other project changed: assignee %q", task.AssigneeID)
+	}
+}
