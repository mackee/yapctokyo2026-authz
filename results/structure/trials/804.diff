+// MembershipTableMoveInput is the input of MembershipTable.Move.
+type MembershipTableMoveInput struct {
+	ToProjectID string
+}
+
+// Move removes the user from the project of authz and adds them to the
+// destination project with the same role. The actor must be a manager of both
+// projects; the destination must be readable by the actor (else ErrNotFound).
+func (*MembershipTable) Move(ctx context.Context, db DB, authz ProjectAuthz, userID string, in MembershipTableMoveInput) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		to, err := NewProjectAuthz(ctx, tx, authz.Actor(), in.ToProjectID)
+		if err != nil {
+			return err
+		}
+		if err := to.CanManageMembers(); err != nil {
+			return err
+		}
+		agg, err := loadMoveMember(ctx, tx, authz.ProjectID(), userID, in.ToProjectID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		m, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
