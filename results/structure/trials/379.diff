index 1c6ebfe..f657743 100644
--- a/internal/capability/aggregate.go
+++ b/internal/capability/aggregate.go
@@ -118,3 +118,37 @@ func loadDeleteTask(x *tx, taskID string) (*deleteTaskAggregate, error) {
 func (a *deleteTaskAggregate) validate() error { return nil }
 
 func (a *deleteTaskAggregate) apply(x *tx) { a.task.Destroy(x) }
+
+// removeOrgUserAggregate takes one user out of every project of one
+// organization.
+type removeOrgUserAggregate struct {
+	memberships []membershipRecord // the user's memberships in the organization's projects
+}
+
+func loadRemoveOrgUser(x *tx, orgID, userID string) (*removeOrgUserAggregate, error) {
+	u, ok := x.findUser(userID)
+	if !ok || u.Org != orgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	a := &removeOrgUserAggregate{}
+	for _, m := range u.Memberships(x) {
+		if p, ok := m.Project(x); ok && p.Org == orgID {
+			a.memberships = append(a.memberships, m)
+		}
+	}
+	return a, nil
+}
+
+// validate has nothing to check: removing a member cannot break the model
+// rules. Tasks that the member was assigned are unassigned in apply, which
+// keeps "an assignee is a member of the task's project" true.
+func (a *removeOrgUserAggregate) validate() error { return nil }
+
+func (a *removeOrgUserAggregate) apply(x *tx) {
+	for _, m := range a.memberships {
+		for _, t := range m.AssignedTasks(x) {
+			t.Unassign(x)
+		}
+		m.Destroy(x)
+	}
+}
