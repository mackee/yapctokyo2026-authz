diff --git a/org_test.go b/org_test.go
new file mode 100644
index 0000000..d3baa70
--- /dev/null
+++ b/org_test.go
@@ -0,0 +1,99 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin, user in no project", "eve", "/orgs/acme/users/hal", 204},
+		{"org admin, unknown user", "eve", "/orgs/acme/users/zed", 404},
+		{"org admin, user of other org", "eve", "/orgs/acme/users/gus", 404},
+		{"org admin, other org", "eve", "/orgs/globex/users/gus", 404},
+		{"same org, not admin", "ann", "/orgs/acme/users/ben", 403},
+		{"admin of other org", "gus", "/orgs/acme/users/ben", 404},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+
+	// assigneeOf reads a task as ann, a manager of web, ops and legacy.
+	assigneeOf := func(t *testing.T, path string) string {
+		t.Helper()
+		code, body := do(t, h, "GET", path, "ann", "")
+		if code != 200 {
+			t.Fatalf("GET %s: got %d", path, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		return task.Assignee
+	}
+
+	// Precondition: ben is a contributor in web and in legacy (archived),
+	// and is assigned t1 and t5.
+	if code, _ := do(t, h, "GET", "/projects/legacy/tasks", "ben", ""); code != 200 {
+		t.Fatalf("precondition: ben reads legacy: got %d", code)
+	}
+	if got := assigneeOf(t, "/projects/web/tasks/t1"); got != "ben" {
+		t.Fatalf("precondition: t1 assignee = %q, want ben", got)
+	}
+
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove ben: got %d want 204", code)
+	}
+
+	// ben is out of every project of the org, archived ones included.
+	for _, p := range []string{"web", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ben", ""); code != 404 {
+			t.Fatalf("ben reads %s after removal: got %d want 404", p, code)
+		}
+		if code, _ := do(t, h, "POST", "/projects/"+p+"/tasks", "ben", `{"title":"x"}`); code != 404 {
+			t.Fatalf("ben writes %s after removal: got %d want 404", p, code)
+		}
+	}
+
+	// Tasks ben was assigned in those projects are unassigned.
+	if got := assigneeOf(t, "/projects/web/tasks/t1"); got != "" {
+		t.Fatalf("t1 assignee = %q, want unassigned", got)
+	}
+	if got := assigneeOf(t, "/projects/legacy/tasks/t5"); got != "" {
+		t.Fatalf("t5 assignee = %q, want unassigned", got)
+	}
+
+	// Everything else is untouched: other members, their tasks, other orgs.
+	if got := assigneeOf(t, "/projects/web/tasks/t2"); got != "cat" {
+		t.Fatalf("t2 assignee = %q, want cat", got)
+	}
+	if got := assigneeOf(t, "/projects/ops/tasks/t4"); got != "cat" {
+		t.Fatalf("t4 assignee = %q, want cat", got)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat reads web after ben removal: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatalf("gus reads gx after ben removal: got %d want 200", code)
+	}
+
+	// Removing again is harmless.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("second removal: got %d want 204", code)
+	}
+}
