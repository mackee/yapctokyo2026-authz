+// ---- operations -----------------------------------------------------------------------
+
+// MembershipTableMoveInput is the input of MembershipTable.Move.
+type MembershipTableMoveInput struct {
+	UserID      string // the member to move, out of the authorized project
+	ToProjectID string
+}
+
+// Move moves the user's membership from the authorized project to the target
+// project, keeping the role. The actor must be a manager of both projects (the
+// target is looked up through the actor, so it must be readable and in the
+// same organization). The user's tasks in the authorized project are
+// unassigned.
+func (*MembershipTable) Move(ctx context.Context, db DB, authz ProjectAuthz, in MembershipTableMoveInput) (*Membership, error) {
+	if in.ToProjectID == authz.ProjectID() {
+		return nil, deny(ErrInvalid, "target must be a different project")
+	}
+	if err := authz.CanMoveMembers(); err != nil {
+		return nil, err
+	}
+	target, err := NewProjectAuthz(ctx, db, authz.Actor(), in.ToProjectID)
+	if err != nil {
+		return nil, err
+	}
+	if err := target.CanMoveMembers(); err != nil {
+		return nil, err
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveMember(ctx, tx, authz.ProjectID(), in.ToProjectID, in.UserID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if m, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
