+// CanMoveMembers returns nil if the actor may move a member out of or into the
+// project: managers only (else ErrForbidden) and not archived (else ErrArchived).
+func (a ProjectAuthz) CanMoveMembers() error {
+	if !a.CanRead() || a.role != RoleManager {
+		return deny(ErrForbidden, "only managers may move members")
+	}
+	if a.archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	return nil
+}
