+// OrgAuthz is what the actor may do for one organization. NewOrgAuthz only
+// builds it for org admins of that organization.
+type OrgAuthz struct {
+	actor Actor
+	org   string
+}
+
+// OrgID returns the organization the object is bound to.
+func (a OrgAuthz) OrgID() string { return a.org }
+
+// CanTransferUsers returns nil if the actor may move users out of the
+// organization: org admins of that organization only (else ErrForbidden).
+func (a OrgAuthz) CanTransferUsers() error {
+	if a.org == "" || a.actor.org != a.org || !a.actor.orgAdmin {
+		return deny(ErrForbidden, "only org admins may transfer users")
+	}
+	return nil
+}
+
+// UserAuthz is the scope of one user of one organization.
+type UserAuthz struct {
+	org  OrgAuthz
+	user string
+}
+
+// Org returns the organization-level authorization the user object came from.
+func (a UserAuthz) Org() OrgAuthz { return a.org }
+
+// UserID returns the user the object is bound to.
+func (a UserAuthz) UserID() string { return a.user }
