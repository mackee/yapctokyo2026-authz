+// transferUserAggregate moves one user to another organization. Projects of
+// the old organization are no longer the user's: the memberships in projects
+// outside the target organization are removed, and the tasks the user holds in
+// those projects are unassigned, so the membership rules keep holding. The
+// user's org admin status is not carried over to the target organization.
+type transferUserAggregate struct {
+	user        *User
+	toOrg       string
+	memberships []*Membership // the user's memberships in projects outside toOrg
+	tasks       []*Task       // the tasks assigned to the user in projects outside toOrg
+}
+
+func loadTransferUser(ctx context.Context, tx DB, authz UserAuthz, in UserTableTransferInput) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, authz.UserID())
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != authz.Org().OrgID() {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if in.ToOrgID == u.Org {
+		return nil, deny(ErrInvalid, "user is already in that organization")
+	}
+	exists, err := NewOrgTable().Exists(ctx, tx, in.ToOrgID)
+	if err != nil {
+		return nil, err
+	}
+	if !exists {
+		return nil, deny(ErrInvalid, "unknown organization")
+	}
+	a := &transferUserAggregate{user: u, toOrg: in.ToOrgID}
+
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, m := range ms {
+		outside, err := projectOutsideOrg(ctx, tx, m.ProjectID, in.ToOrgID)
+		if err != nil {
+			return nil, err
+		}
+		if outside {
+			a.memberships = append(a.memberships, m)
+		}
+	}
+
+	ts, err := u.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, t := range ts {
+		outside, err := projectOutsideOrg(ctx, tx, t.ProjectID, in.ToOrgID)
+		if err != nil {
+			return nil, err
+		}
+		if outside {
+			a.tasks = append(a.tasks, t)
+		}
+	}
+	return a, nil
+}
+
+// projectOutsideOrg reports whether the project is not in the organization. A
+// project that does not exist is outside it.
+func projectOutsideOrg(ctx context.Context, tx DB, projectID, orgID string) (bool, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return true, nil
+	} else if err != nil {
+		return false, err
+	}
+	return p.Org != orgID, nil
+}
+
+func (a *transferUserAggregate) validate() error { return nil }
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	a.user.Org = a.toOrg
+	a.user.OrgAdmin = false
+	if err := a.user.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
