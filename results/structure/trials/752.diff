+// UserTableTransferInput is the input of UserTable.Transfer.
+type UserTableTransferInput struct {
+	ToOrgID string
+}
+
+// Transfer moves the user to another organization, all or nothing. Only org
+// admins of the user's organization may do it (see OrgAuthz).
+func (*UserTable) Transfer(ctx context.Context, db DB, authz UserAuthz, in UserTableTransferInput) (*User, error) {
+	if err := authz.Org().CanTransferUsers(); err != nil {
+		return nil, err
+	}
+	if in.ToOrgID == "" {
+		return nil, deny(ErrInvalid, "toOrgId must not be empty")
+	}
+	var u *User
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadTransferUser(ctx, tx, authz, in)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		u, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return u, nil
+}
