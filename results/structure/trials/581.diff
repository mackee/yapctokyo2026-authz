 // NewUserTable returns the users table.
 func NewUserTable() *UserTable { return &UserTable{} }
 
+// RemoveFromProjects removes the user from every project of the organization
+// (offboarding) and unassigns their tasks, all or nothing. Only org admins may.
+// A user who does not exist or is in another organization is ErrNotFound.
+func (*UserTable) RemoveFromProjects(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanManageUsers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveUser(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
