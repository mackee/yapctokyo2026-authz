+// CanManageMembers returns nil if the actor may remove members from the
+// project: managers only (else ErrForbidden) and not archived (else
+// ErrArchived).
+func (a ProjectAuthz) CanManageMembers() error {
+	if !a.CanRead() || a.role != RoleManager {
+		return deny(ErrForbidden, "only managers may remove project members")
+	}
+	if a.archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	return nil
+}
