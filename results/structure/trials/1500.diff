+//
+// Find and List* read rows. Remove is the API operation: it takes the database,
+// the project's authorization object and the user to remove, asks the
+// authorization object whether the actor may do it, then runs its aggregate
+// (aggregate.go) in a transaction.
 type MembershipTable struct{}
 
 // NewMembershipTable returns the memberships table.
 func NewMembershipTable() *MembershipTable { return &MembershipTable{} }
 
+// Remove removes the user from the project. The user's tasks in the project
+// are unassigned in the same transaction. A user who is not a member → ErrNotFound.
+func (*MembershipTable) Remove(ctx context.Context, db DB, authz ProjectAuthz, userID string) error {
+	if err := authz.CanManageMembers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveMember(ctx, tx, authz.ProjectID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
