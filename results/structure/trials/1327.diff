+  // POST /projects/{pid}/members/{uid}/move {"toProjectId": q}
+  // Moves member m from project p to project q, keeping the role. The caller
+  // must manage both projects. q == "" stands for a missing toProjectId.
+  def moveOutcome(u: UserId, p: ProjectId, m: UserId, q: ProjectId): int =
+    if (not(userExists(u))) 401
+    else if (not(canRead(u, p))) 404
+    else if (roleOf(p, m) == "") 404
+    else if (roleOf(p, u) != "manager") 403
+    else if (projects.get(p).archived) 409
+    else if (q == "" or q == p) 400
+    else if (not(canRead(u, q))) 404
+    else if (roleOf(q, u) != "manager") 403
+    else if (projects.get(q).archived) 409
+    else if (roleOf(q, m) != "") 409
+    else 200
+
   // ---- actions -------------------------------------------------------------
 
   action unchanged = all {
@@ -164,6 +180,17 @@ module taskboard {
       members' = members,
     } else unchanged
 
+  // Moving a member out of p also unassigns their tasks in p, so that every
+  // assignee stays a writer of the task's project (inv_assigneeIsWriter).
+  action moveMember(u: UserId, p: ProjectId, m: UserId, q: ProjectId): bool =
+    if (moveOutcome(u, p, m, q) == 200) all {
+      members' = members.keys().exclude(Set((p, m))).mapBy(k => members.get(k)).put((q, m), roleOf(p, m)),
+      tasks' = tasks.keys().mapBy(k => if (tasks.get(k).project == p and tasks.get(k).assignee == m) { ...tasks.get(k), assignee: "" } else tasks.get(k)),
+      nextTask' = nextTask,
+      users' = users,
+      projects' = projects,
+    } else unchanged
+
   // ---- seed data and steps -------------------------------------------------
 
   action init = all {
@@ -202,10 +229,13 @@ module taskboard {
     nondet t = 1.to(nextTask).oneOf()
     nondet s = STATUSES.oneOf()
     nondet changeAssignee = Set(true, false).oneOf()
+    nondet m = USERS.oneOf()
+    nondet q = PROJECTS.union(Set("")).oneOf()
     any {
       createTask(u, p, a),
       updateTask(u, p, t, s, changeAssignee, a),
       deleteTask(u, p, t),
+      moveMember(u, p, m, q),
     }
   }
 
