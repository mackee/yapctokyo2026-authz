       assert(deleteOutcome("ann", "web", 1) == 204),
       assert(deleteOutcome("ben", "web", 1) == 403),
       assert(deleteOutcome("ann", "web", 4) == 404),
+      assert(moveOutcome("ivy", "web", "ben", "ops") == 200),
