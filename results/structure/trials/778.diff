+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager", "ann", "/projects/web/members/ben", 204},
+		{"contributor", "ben", "/projects/web/members/cat", 403},
+		{"viewer", "dan", "/projects/web/members/ben", 403},
+		{"org admin", "eve", "/projects/web/members/ben", 403},
+		{"archived", "ann", "/projects/legacy/members/ben", 409},
+		{"not a member", "ann", "/projects/web/members/hal", 404},
+		{"unreadable project", "hal", "/projects/web/members/ben", 404},
+		{"other org", "gus", "/projects/web/members/ben", 404},
+		{"unauthenticated", "", "/projects/web/members/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveMemberUnassignsTasks(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 204 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 404 {
+		t.Fatalf("second removal: got %d want 404", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("removed member still reads project: got %d want 404", code)
+	}
+	_, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if strings.Contains(body, `"assignee":"ben"`) {
+		t.Fatalf("task still assigned to removed member: %s", body)
+	}
+}
