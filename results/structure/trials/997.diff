+func TestSetMemberRoles(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"viewer caller", "dan", "web", `{"roles":{"ben":"viewer"}}`, 403},
+		{"contributor caller", "ben", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"org admin caller", "eve", "web", `{"roles":{"ben":"viewer"}}`, 403},
+		{"non member caller", "hal", "web", `{"roles":{"ben":"viewer"}}`, 404},
+		{"other org caller", "gus", "web", `{"roles":{"ben":"viewer"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"ben":"viewer"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"bad json", "ann", "web", `{"roles":`, 400},
+		{"invalid role", "ann", "web", `{"roles":{"ben":"owner"}}`, 400},
+		{"non member target", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"unknown target", "ann", "web", `{"roles":{"zed":"viewer"}}`, 400},
+		{"one of several targets not member", "ann", "web", `{"roles":{"ivy":"viewer","gus":"viewer"}}`, 400},
+		{"bulk change", "ann", "web", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestSetMemberRolesResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got []Member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []Member{
+		{"ann", "manager"}, {"ben", "viewer"}, {"cat", "contributor"},
+		{"dan", "contributor"}, {"ivy", "manager"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("row %d: got %v want %v", i, got[i], want[i])
+		}
+	}
+}
+
+// A rejected bulk change must not apply any of its entries.
+func TestSetMemberRolesAllOrNothing(t *testing.T) {
+	h := newServer()
+	// ben is valid, hal is not a member: whole request rejected.
+	code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","hal":"viewer"}}`)
+	if code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	// Invalid role on dan: whole request rejected.
+	code, _ = do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"owner"}}`)
+	if code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	// ben must still be a contributor, so he can still create a task for himself.
+	code, body := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x","assignee":"ben"}`)
+	if code != 200 {
+		t.Fatalf("ben lost contributor rights: %d %s", code, body)
+	}
+}
diff --git a/members.go b/members.go
new file mode 100644
index 0000000..df29321
--- /dev/null
+++ b/members.go
@@ -0,0 +1,137 @@
+package main
+
+import (
+	"database/sql"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"sort"
+)
+
+// Member is one project membership as returned by GET/PUT /projects/{pid}/members.
+type Member struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+type setRolesRequest struct {
+	Roles map[string]string `json:"roles"`
+}
+
+// validRoles are the project roles that may be assigned.
+var validRoles = map[string]bool{RoleManager: true, RoleContributor: true, RoleViewer: true}
+
+// setMemberRoles changes the roles of several existing project members at once.
+// All-or-nothing: if any target is not a member of the project or any role is
+// invalid, nothing is changed and an error is returned.
+func (s *server) setMemberRoles(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role, err := findRole(ctx, s.db, project.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "only managers may change member roles")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req setRolesRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || len(req.Roles) == 0 {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+
+	// Validate every change before writing anything. Sorted so that the
+	// reported error is deterministic when several entries are bad.
+	userIDs := make([]string, 0, len(req.Roles))
+	for uid := range req.Roles {
+		userIDs = append(userIDs, uid)
+	}
+	sort.Strings(userIDs)
+
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+
+	for _, uid := range userIDs {
+		newRole := req.Roles[uid]
+		if !validRoles[newRole] {
+			writeError(w, 400, fmt.Sprintf("invalid role for %s", uid))
+			return
+		}
+		var current string
+		err := tx.QueryRowContext(ctx, `SELECT role FROM memberships WHERE project_id = ? AND user_id = ?`, project.ID, uid).Scan(&current)
+		if err == sql.ErrNoRows {
+			writeError(w, 400, fmt.Sprintf("%s is not a member of the project", uid))
+			return
+		}
+		if err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+	}
+
+	for _, uid := range userIDs {
+		if _, err := tx.ExecContext(ctx, `UPDATE memberships SET role = ? WHERE project_id = ? AND user_id = ?`,
+			req.Roles[uid], project.ID, uid); err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+	}
+
+	rows, err := tx.QueryContext(ctx, `SELECT user_id, role FROM memberships WHERE project_id = ? ORDER BY user_id`, project.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer rows.Close()
+	members := []Member{}
+	for rows.Next() {
+		var m Member
+		if err := rows.Scan(&m.UserID, &m.Role); err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+		members = append(members, m)
+	}
+	if err := rows.Err(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	rows.Close()
+
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, members)
+}
