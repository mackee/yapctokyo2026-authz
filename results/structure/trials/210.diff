+// RemoveUserFromOrg offboards a user: removes them from every project of the
+// org (archived ones included), unassigns their tasks, and deletes the user so
+// they can no longer authenticate (otherwise a departed org admin would keep
+// org-wide read access).
+func (s *Store) RemoveUserFromOrg(orgID, userID string) {
+	for _, p := range s.projects {
+		if p.OrgID == orgID {
+			delete(s.members[p.ID], userID)
+		}
+	}
+	for _, t := range s.tasks {
+		if t.Assignee == userID && s.projects[t.ProjectID].OrgID == orgID {
+			t.Assignee = ""
+		}
+	}
+	delete(s.users, userID)
+}
