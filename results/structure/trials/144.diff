+// statsIn counts the tasks of one project by status and by assignee.
+func (s *state) statsIn(projectID string) ProjectStats {
+	out := ProjectStats{ByStatus: map[string]int{}, ByAssignee: map[string]int{}}
+	for st := range validStatuses {
+		out.ByStatus[st] = 0
+	}
+	for _, t := range s.tasks {
+		if t.project != projectID {
+			continue
+		}
+		out.ByStatus[t.status]++
+		if u := t.assignee.user; u != "" {
+			out.ByAssignee[u]++
+		}
+	}
+	return out
+}
