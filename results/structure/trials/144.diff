+type stats struct {
+	ByStatus   map[string]int `json:"byStatus"`
+	ByAssignee map[string]int `json:"byAssignee"`
+}
+
+func TestStatsAccess(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager", "ann", "/projects/web/stats", 200},
+		{"viewer member", "dan", "/projects/web/stats", 200},
+		{"org admin", "eve", "/projects/ops/stats", 200},
+		{"archived readable", "ann", "/projects/legacy/stats", 200},
+		{"non member", "hal", "/projects/web/stats", 404},
+		{"other org", "gus", "/projects/web/stats", 404},
+		{"unknown project", "ann", "/projects/nope/stats", 404},
+		{"anonymous", "", "/projects/web/stats", 401},
+		{"unknown user", "zed", "/projects/web/stats", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "GET", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func fetchStats(t *testing.T, h http.Handler, project, user string) stats {
+	t.Helper()
+	code, body := do(t, h, "GET", "/projects/"+project+"/stats", user, "")
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var s stats
+	if err := json.Unmarshal([]byte(body), &s); err != nil {
+		t.Fatal(err)
+	}
+	return s
+}
+
+func assertCount(t *testing.T, m map[string]int, key string, want int) {
+	t.Helper()
+	if got := m[key]; got != want {
+		t.Fatalf("%s: got %d want %d (map %v)", key, got, want, m)
+	}
+}
+
+func TestStatsCounts(t *testing.T) {
+	h := newServer()
+	// web seed: t1 open/ben, t2 doing/cat, t3 open/unassigned
+	s := fetchStats(t, h, "web", "ann")
+	if len(s.ByStatus) != 3 {
+		t.Fatalf("byStatus should list all statuses, got %v", s.ByStatus)
+	}
+	assertCount(t, s.ByStatus, "open", 2)
+	assertCount(t, s.ByStatus, "doing", 1)
+	assertCount(t, s.ByStatus, "done", 0)
+	if len(s.ByAssignee) != 2 {
+		t.Fatalf("unassigned tasks must not appear in byAssignee, got %v", s.ByAssignee)
+	}
+	assertCount(t, s.ByAssignee, "ben", 1)
+	assertCount(t, s.ByAssignee, "cat", 1)
+}
+
+func TestStatsReflectsWrites(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/tasks", "ann", `{"title":"x","assignee":"ben"}`); code != 201 {
+		t.Fatalf("create: %d %s", code, body)
+	}
+	if code, body := do(t, h, "PATCH", "/projects/web/tasks/t2", "ann", `{"status":"done"}`); code != 200 {
+		t.Fatalf("patch: %d %s", code, body)
+	}
+	s := fetchStats(t, h, "web", "dan")
+	assertCount(t, s.ByStatus, "open", 3)
+	assertCount(t, s.ByStatus, "doing", 0)
+	assertCount(t, s.ByStatus, "done", 1)
+	assertCount(t, s.ByAssignee, "ben", 2)
+	assertCount(t, s.ByAssignee, "cat", 1) // status change does not reassign
+}
+
+func TestStatsOnlyProjectTasks(t *testing.T) {
+	// ops has one task (t4, open, cat); web's tasks must not leak into it.
+	s := fetchStats(t, newServer(), "ops", "ann")
+	assertCount(t, s.ByStatus, "open", 1)
+	assertCount(t, s.ByStatus, "doing", 0)
+	assertCount(t, s.ByStatus, "done", 0)
+	if len(s.ByAssignee) != 1 {
+		t.Fatalf("got %v", s.ByAssignee)
+	}
+	assertCount(t, s.ByAssignee, "cat", 1)
+}
+
