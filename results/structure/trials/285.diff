+func (t *manageTask) MoveTo(dst WriteProject) (TaskView, error) {
+	src := t.ts.ps.pid
+	if dst.ID() == src {
+		return TaskView{}, deny(ErrInvalid, "task is already in that project")
+	}
+	var v TaskView
+	err := t.ts.ps.as.a.st.tx(func(s *state) error {
+		cur, ok := s.tasks[t.ts.tid]
+		if !ok || cur.project != src {
+			return deny(ErrNotFound, "not found")
+		}
+		// Re-admit the current assignee for the destination; a user who is not
+		// a contributor or manager there makes the move invalid (400).
+		a, err := admit(s, dst.ID(), cur.assignee.user)
+		if err != nil {
+			return err
+		}
+		cur.project = dst.ID()
+		cur.assignee = a
+		s.tasks[cur.id] = cur
+		v = cur.view()
+		return nil
+	})
+	return v, err
+}
