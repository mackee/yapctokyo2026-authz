+
+func TestFreeze(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager", "ann", "/projects/web/freeze", 200},
+		{"contributor", "ben", "/projects/web/freeze", 403},
+		{"viewer", "dan", "/projects/web/freeze", 403},
+		{"org admin without role", "eve", "/projects/web/freeze", 403},
+		{"non member", "hal", "/projects/web/freeze", 404},
+		{"other org", "gus", "/projects/web/freeze", 404},
+		{"missing project", "ann", "/projects/missing/freeze", 404},
+		{"anonymous", "", "/projects/web/freeze", 401},
+		{"unknown user", "zed", "/projects/web/freeze", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResponseListsMembersAsViewers(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+	var got []memberRole
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []memberRole{
+		{"ann", "viewer"}, {"ben", "viewer"}, {"cat", "viewer"}, {"dan", "viewer"}, {"ivy", "viewer"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("got %v want %v", got, want)
+		}
+	}
+}
+
+func TestFreezeBlocksTaskWrites(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d want 200", code)
+	}
+	cases := []struct {
+		name, user, method, path, body string
+		want                           int
+	}{
+		{"former manager patch", "ivy", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"former manager delete", "ann", "DELETE", "/projects/web/tasks/t1", "", 403},
+		{"former contributor patch own", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`, 403},
+		{"former contributor create", "ben", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"former manager create", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"freeze again", "ann", "POST", "/projects/web/freeze", "", 403},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, srv, c.method, c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+	// Reads still work, and the assignees were cleared.
+	code, body := do(t, srv, "GET", "/projects/web/tasks/t1", "dan", "")
+	if code != 200 {
+		t.Fatalf("read: got %d want 200", code)
+	}
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" {
+		t.Fatalf("assignee after freeze: got %q want empty", task.Assignee)
+	}
+}
+
+func TestFreezeLeavesOtherProjectsAlone(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "PATCH", "/projects/ops/tasks/t4", "ivy", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ops manager patch: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "POST", "/projects/ops/tasks", "cat", `{"title":"x"}`); code != 200 {
+		t.Fatalf("ops contributor create: got %d want 200", code)
+	}
+	_, body := do(t, srv, "GET", "/projects/ops/tasks/t4", "ivy", "")
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "cat" {
+		t.Fatalf("ops assignee changed to %q", task.Assignee)
+	}
+}
