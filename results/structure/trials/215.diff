+type Member struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// FreezeProject demotes every member of the project to viewer and returns
+// the resulting member list sorted by user ID.
+func (s *Store) FreezeProject(projectID string) []Member {
+	out := []Member{}
+	for uid := range s.members[projectID] {
+		s.members[projectID][uid] = RoleViewer
+		out = append(out, Member{UserID: uid, Role: RoleViewer})
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].UserID < out[j].UserID })
+	return out
+}
