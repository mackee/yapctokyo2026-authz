@@ -0,0 +1,97 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestTransfer(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 200},
+		{"manager, not org admin", "ann", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 403},
+		{"contributor", "ben", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 403},
+		{"admin of another org", "gus", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 404},
+		{"unknown org", "eve", "/orgs/zzz/users/hal/transfer", `{"toOrgId":"globex"}`, 404},
+		{"anonymous", "", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown caller", "zed", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 401},
+		{"target in another org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"missing toOrgId", "eve", "/orgs/acme/users/hal/transfer", `{}`, 400},
+		{"empty toOrgId", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":""}`, 400},
+		{"malformed body", "eve", "/orgs/acme/users/hal/transfer", `{`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/hal/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got struct {
+		ID    string `json:"id"`
+		OrgID string `json:"orgId"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.ID != "hal" || got.OrgID != "globex" {
+		t.Fatalf("got %+v body=%s", got, body)
+	}
+}
+
+// A transfer removes the user's memberships in the old organization's projects
+// and unassigns the tasks the user held there, archived projects included.
+func TestTransferCleansUpMemberships(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: got %d body=%s", code, body)
+	}
+
+	// ben's tasks lose their assignee; other assignments are untouched.
+	for _, c := range []struct{ path, wantAssignee string }{
+		{"/projects/web/tasks/t1", ""},
+		{"/projects/legacy/tasks/t5", ""},
+		{"/projects/web/tasks/t2", "cat"},
+	} {
+		code, body := do(t, srv, "GET", c.path, "ann", "")
+		if code != 200 {
+			t.Fatalf("%s: got %d body=%s", c.path, code, body)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.AssigneeID != c.wantAssignee {
+			t.Fatalf("%s: assignee %q want %q", c.path, task.AssigneeID, c.wantAssignee)
+		}
+	}
+
+	// ben is now in globex, so the acme projects are not readable.
+	for _, path := range []string{"/projects/web/tasks", "/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		if code, body := do(t, srv, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("%s: got %d want 404 body=%s", path, code, body)
+		}
+	}
+}
+
+// An org admin does not stay an admin after moving to another organization.
+func TestTransferClearsOrgAdmin(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: got %d body=%s", code, body)
+	}
+	if code, body := do(t, srv, "POST", "/orgs/globex/users/gus/transfer", "eve", `{"toOrgId":"acme"}`); code != 403 {
+		t.Fatalf("former admin: got %d want 403 body=%s", code, body)
+	}
+}
