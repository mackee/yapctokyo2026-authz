+// transferUserAggregate moves one user to another organization. Project
+// membership is per organization, so the user's memberships in projects of
+// other organizations are removed, and the tasks assigned to the user in those
+// projects are unassigned (an assignee must be a member of the task's
+// project). Archived projects do not block this: it is an organization-level
+// change, not an edit of the project's work.
+type transferUserAggregate struct {
+	user     *User
+	toOrg    string
+	unassign []*Task       // tasks assigned to the user in projects outside toOrg
+	removed  []*Membership // the user's memberships in projects outside toOrg
+}
+
+func loadTransferUser(ctx context.Context, tx DB, orgID, userID, toOrg string) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != orgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	a := &transferUserAggregate{user: u, toOrg: toOrg}
+
+	tasks, err := u.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, t := range tasks {
+		p, err := t.Project(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		if p.Org != toOrg {
+			a.unassign = append(a.unassign, t)
+		}
+	}
+
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, m := range ms {
+		p, err := m.Project(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		if p.Org != toOrg {
+			a.removed = append(a.removed, m)
+		}
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if a.toOrg == "" {
+		return deny(ErrInvalid, "toOrgId must not be empty")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	for _, t := range a.unassign {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	for _, m := range a.removed {
+		if err := m.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	a.user.Org = a.toOrg
+	a.user.OrgAdmin = false // an admin of the old organization is not one of the new
+	if err := a.user.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
