+// Transfer moves the user, who must belong to the authorized organization, to
+// toOrgID. Only org admins of that organization may do it. Memberships and
+// task assignments that would be left in another organization are removed
+// (see transferUserAggregate). The user's org admin flag is cleared.
+func (*UserTable) Transfer(ctx context.Context, db DB, authz OrgAuthz, userID, toOrgID string) (*User, error) {
+	if err := authz.CanTransferUsers(); err != nil {
+		return nil, err
+	}
+	var u *User
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadTransferUser(ctx, tx, authz.OrgID(), userID, toOrgID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		u, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return u, nil
+}
