+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes", "eve", "/orgs/acme/users/ben", 204},
+		{"org member, not admin", "ann", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"caller in other org", "gus", "/orgs/acme/users/ben", 404},
+		{"admin, path org is another org", "eve", "/orgs/globex/users/gus", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"target with no memberships", "eve", "/orgs/acme/users/hal", 204},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserRevokesAccess(t *testing.T) {
+	s := newServer()
+	if code, body := do(t, s, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d: %s", code, body)
+	}
+	// ben's memberships are gone from every acme project, including archived legacy.
+	for _, path := range []string{"/projects/web/tasks", "/projects/legacy/tasks", "/projects/web/tasks/t1"} {
+		if code, _ := do(t, s, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("GET %s as removed user: got %d want 404", path, code)
+		}
+	}
+	if code, _ := do(t, s, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 404 {
+		t.Fatalf("PATCH as removed user: got %d want 404", code)
+	}
+	// Other users' memberships are untouched.
+	if code, _ := do(t, s, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat lost web access: got %d", code)
+	}
+	if code, _ := do(t, s, "GET", "/projects/ops/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat lost ops access: got %d", code)
+	}
+}
