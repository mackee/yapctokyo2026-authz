+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestFreeze(t *testing.T) {
+	h := newServer()
+
+	for _, c := range []struct {
+		name, user, path string
+		want             int
+	}{
+		{"anonymous", "", "/projects/web/freeze", 401},
+		{"non member", "hal", "/projects/web/freeze", 404},
+		{"other org", "gus", "/projects/web/freeze", 404},
+		{"missing project", "ann", "/projects/nope/freeze", 404},
+		{"contributor", "ben", "/projects/web/freeze", 403},
+		{"viewer", "dan", "/projects/web/freeze", 403},
+		{"org admin", "eve", "/projects/web/freeze", 403},
+		{"archived", "ann", "/projects/legacy/freeze", 409},
+	} {
+		if code, body := do(t, h, "POST", c.path, c.user, ""); code != c.want {
+			t.Errorf("%s: got %d want %d (%s)", c.name, code, c.want, body)
+		}
+	}
+
+	// Rejected attempts must not have changed anything.
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"doing"}`); code != 200 {
+		t.Fatalf("contributor write before freeze: got %d", code)
+	}
+
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("freeze: got %d (%s)", code, body)
+	}
+	var got []member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []string{"ann", "ben", "cat", "dan", "ivy"}
+	if len(got) != len(want) {
+		t.Fatalf("members: %v", got)
+	}
+	for i, m := range got {
+		if m.UserID != want[i] || m.Role != "viewer" {
+			t.Errorf("member %d: %+v", i, m)
+		}
+	}
+
+	// Nobody can modify tasks any more, managers included.
+	for _, user := range []string{"ann", "ivy", "ben", "cat"} {
+		if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", user, `{"status":"done"}`); code != 403 {
+			t.Errorf("%s patch after freeze: got %d", user, code)
+		}
+		if code, _ := do(t, h, "POST", "/projects/web/tasks", user, `{"title":"x"}`); code != 403 {
+			t.Errorf("%s create after freeze: got %d", user, code)
+		}
+		if code, _ := do(t, h, "DELETE", "/projects/web/tasks/t1", user, ""); code != 403 {
+			t.Errorf("%s delete after freeze: got %d", user, code)
+		}
+	}
+
+	// Other projects are untouched.
+	if code, _ := do(t, h, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"doing"}`); code != 200 {
+		t.Errorf("other project affected: got %d", code)
+	}
+}
