--- /dev/null
+++ b/freeze.go
@@ -0,0 +1,94 @@
+package main
+
+import (
+	"net/http"
+)
+
+// MemberRole is one entry of a project's member list.
+type MemberRole struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// freezeProject demotes every member of the project to viewer (managers
+// included) and clears the assignee of every task in it, since an assignee must
+// be a contributor or manager. A frozen project accepts no task writes, because
+// nobody in it can write any more. Only a manager of the project may freeze it.
+func (s *server) freezeProject(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role, err := findRole(ctx, s.db, project.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+	if _, err := tx.ExecContext(ctx, `UPDATE memberships SET role = ? WHERE project_id = ?`, RoleViewer, project.ID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if _, err := tx.ExecContext(ctx, `UPDATE tasks SET assignee = '' WHERE project_id = ?`, project.ID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	rows, err := tx.QueryContext(ctx, `SELECT user_id, role FROM memberships WHERE project_id = ? ORDER BY user_id`, project.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer rows.Close()
+	members := []MemberRole{}
+	for rows.Next() {
+		var m MemberRole
+		if err := rows.Scan(&m.UserID, &m.Role); err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+		members = append(members, m)
+	}
+	if err := rows.Err(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	rows.Close()
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, members)
+}
diff --git a/freeze_test.go b/freeze_test.go
new file mode 100644
index 0000000..78d52c7
--- /dev/null
+++ b/freeze_test.go
@@ -0,0 +1,126 @@
+package main
+
+import (
+	"encoding/json"
+	"reflect"
+	"testing"
+)
+
+type member struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func TestFreezeReturnsMembersAsViewers(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got []member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("bad body %q: %v", body, err)
+	}
+	want := []member{
+		{"ann", "viewer"}, {"ben", "viewer"}, {"cat", "viewer"}, {"dan", "viewer"}, {"ivy", "viewer"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+}
+
+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin without role", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+		{"missing project", "ann", "nope", 404},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFrozenProjectRejectsTaskWrites(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d want 200: %s", code, body)
+	}
+	cases := []struct {
+		name, user, method, path, body string
+	}{
+		{"contributor create", "ben", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"contributor own update", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"contributor other update", "cat", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"former manager update", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"former manager create", "ivy", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"former manager delete", "ann", "DELETE", "/projects/web/tasks/t1", ""},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, h, c.method, c.path, c.user, c.body)
+			if code != 403 {
+				t.Fatalf("got %d want 403", code)
+			}
+		})
+	}
+	// The rejected writes must not have changed anything.
+	_, body := do(t, h, "GET", "/projects/web/tasks", "dan", "")
+	var tasks []Task
+	if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+		t.Fatalf("bad body %q: %v", body, err)
+	}
+	want := []Task{
+		{ID: "t1", ProjectID: "web", Title: "Fix header", Status: "open", Assignee: ""},
+		{ID: "t2", ProjectID: "web", Title: "Update footer", Status: "doing", Assignee: ""},
+		{ID: "t3", ProjectID: "web", Title: "Write copy", Status: "open", Assignee: ""},
+	}
+	if !reflect.DeepEqual(tasks, want) {
+		t.Fatalf("tasks changed after rejected writes:\ngot  %+v\nwant %+v", tasks, want)
+	}
+}
+
+func TestFreezeClearsAssigneesWhoLoseTheirRole(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d want 200: %s", code, body)
+	}
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "dan", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatalf("bad body %q: %v", body, err)
+	}
+	if task.Assignee != "" {
+		t.Fatalf("task t1 still assigned to %q after freeze", task.Assignee)
+	}
+}
+
+func TestFreezeLeavesOtherProjectsAlone(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d want 200: %s", code, body)
+	}
+	// ivy is still a manager of ops, and cat is still a contributor there.
+	if code, body := do(t, h, "POST", "/projects/ops/tasks", "ivy", `{"title":"x"}`); code != 200 {
+		t.Fatalf("ops create: got %d want 200: %s", code, body)
+	}
+	if code, body := do(t, h, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ops update: got %d want 200: %s", code, body)
+	}
+}
