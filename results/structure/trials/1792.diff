diff --git a/freeze_test.go b/freeze_test.go
new file mode 100644
index 0000000..82ce8f8
--- /dev/null
+++ b/freeze_test.go
@@ -0,0 +1,95 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+type memberRole struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// Freezing needs a project manager. Everyone else gets the same answers as for
+// the other project writes: 401, 404 (not readable), 403 (readable but not allowed),
+// 409 (archived).
+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+		{"missing project", "ann", "nope", 404},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+// A successful freeze returns every member, sorted by userId, with the role viewer.
+func TestFreezeResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got []memberRole
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("bad body %q: %v", body, err)
+	}
+	want := []memberRole{
+		{"ann", "viewer"},
+		{"ben", "viewer"},
+		{"cat", "viewer"},
+		{"dan", "viewer"},
+		{"ivy", "viewer"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("entry %d: got %v want %v (all: %v)", i, got[i], want[i], got)
+		}
+	}
+}
+
+// Once frozen, nobody can change the project's tasks, including the manager who
+// froze it. Reads keep working, and other projects are not affected.
+func TestFreezeBlocksTaskWrites(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d: %s", code, body)
+	}
+	cases := []struct {
+		name, user, method, path, body string
+		want                           int
+	}{
+		{"manager patch", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"former contributor own task", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`, 403},
+		{"former manager create", "ivy", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"manager delete", "ann", "DELETE", "/projects/web/tasks/t1", "", 403},
+		{"read still works", "dan", "GET", "/projects/web/tasks/t1", "", 200},
+		{"other project unaffected", "cat", "PATCH", "/projects/ops/tasks/t4", `{"status":"doing"}`, 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, h, c.method, c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+		})
+	}
+}
