@@ -0,0 +1,51 @@
+package model
+
+import (
+	"context"
+	"errors"
+	"testing"
+)
+
+// A frozen project refuses task writes even for a manager, so the guard does
+// not depend on the member roles.
+func TestFrozenProjectRefusesTaskWrites(t *testing.T) {
+	ctx := context.Background()
+	db, err := Open()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := db.ExecContext(ctx, `UPDATE projects SET frozen = 1 WHERE id = 'web'`); err != nil {
+		t.Fatal(err)
+	}
+	act, err := Authenticate(ctx, db, "ann")
+	if err != nil {
+		t.Fatal(err)
+	}
+	pa, err := NewProjectAuthz(ctx, db, act, "web")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ta, err := NewTaskAuthz(ctx, db, pa, "t1")
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	status := "done"
+	title := "x"
+	checks := map[string]error{
+		"create": func() error {
+			_, err := NewTaskTable().Create(ctx, db, pa, TaskTableCreateInput{Title: title})
+			return err
+		}(),
+		"update": func() error {
+			_, err := NewTaskTable().Update(ctx, db, ta, TaskTableUpdateInput{Status: &status})
+			return err
+		}(),
+		"delete": NewTaskTable().Delete(ctx, db, ta),
+	}
+	for op, err := range checks {
+		if !errors.Is(err, ErrFrozen) {
+			t.Errorf("%s: got %v want ErrFrozen", op, err)
+		}
+	}
+}
