diff --git a/main_freeze_test.go b/main_freeze_test.go
new file mode 100644
index 0000000..de79e77
--- /dev/null
+++ b/main_freeze_test.go
@@ -0,0 +1,115 @@
+package main
+
+import (
+	"encoding/json"
+	"reflect"
+	"testing"
+)
+
+type memberJSON struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager", "ann", "/projects/web/freeze", 200},
+		{"other project manager", "ivy", "/projects/ops/freeze", 200},
+		{"contributor", "ben", "/projects/web/freeze", 403},
+		{"viewer", "dan", "/projects/web/freeze", 403},
+		{"org admin", "eve", "/projects/web/freeze", 403},
+		{"non member", "hal", "/projects/web/freeze", 404},
+		{"other org", "gus", "/projects/web/freeze", 404},
+		{"anonymous", "", "/projects/web/freeze", 401},
+		{"unknown user", "zed", "/projects/web/freeze", 401},
+		{"missing project", "ann", "/projects/nope/freeze", 404},
+		{"archived", "ann", "/projects/legacy/freeze", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResponseListsMembersAsViewers(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []memberJSON
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("bad body %q: %v", body, err)
+	}
+	want := []memberJSON{
+		{"ann", "viewer"},
+		{"ben", "viewer"},
+		{"cat", "viewer"},
+		{"dan", "viewer"},
+		{"ivy", "viewer"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+}
+
+func TestFreezeLocksTasksOfThatProjectOnly(t *testing.T) {
+	srv := newServer()
+
+	// Before the freeze, ben (contributor) can edit his own task t1.
+	if code, _ := do(t, srv, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"doing"}`); code != 200 {
+		t.Fatalf("before freeze: got %d want 200", code)
+	}
+
+	if code, body := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d: %s", code, body)
+	}
+
+	// Nobody can change tasks of the frozen project any more.
+	denied := []struct {
+		name, user, method, path, body string
+	}{
+		{"manager create", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"manager update", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"manager delete", "ann", "DELETE", "/projects/web/tasks/t1", ""},
+		{"former contributor update own", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"former contributor create", "cat", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"ivy update", "ivy", "PATCH", "/projects/web/tasks/t3", `{"status":"done"}`},
+	}
+	for _, c := range denied {
+		t.Run(c.name, func(t *testing.T) {
+			if code, _ := do(t, srv, c.method, c.path, c.user, c.body); code != 403 {
+				t.Fatalf("got %d want 403", code)
+			}
+		})
+	}
+
+	// Reads still work, and the rejected changes left the data alone.
+	code, body := do(t, srv, "GET", "/projects/web/tasks/t1", "dan", "")
+	if code != 200 {
+		t.Fatalf("get: got %d", code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.Status != "doing" || task.AssigneeID != "ben" {
+		t.Fatalf("task changed after freeze: %+v", task)
+	}
+
+	// Nobody is a manager of the frozen project any more, so a second freeze is refused.
+	if code, _ := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != 403 {
+		t.Fatalf("second freeze: got %d want 403", code)
+	}
+
+	// Other projects are not affected: cat is still a contributor of ops.
+	if code, _ := do(t, srv, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ops after web freeze: got %d want 200", code)
+	}
+}
