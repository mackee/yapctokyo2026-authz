+func TestTransferOutcomes(t *testing.T) {
+	cases := []struct {
+		name, user, orgID, uid, body string
+		want                         int
+	}{
+		{"org admin moves user", "eve", "acme", "ben", `{"toOrgId":"globex"}`, 200},
+		{"member of org is not admin", "ann", "acme", "ben", `{"toOrgId":"globex"}`, 403},
+		{"org member without roles is not admin", "hal", "acme", "ben", `{"toOrgId":"globex"}`, 403},
+		{"admin of other org", "gus", "acme", "ben", `{"toOrgId":"globex"}`, 404},
+		{"admin of other org, own org path", "eve", "globex", "gus", `{"toOrgId":"acme"}`, 404},
+		{"anonymous", "", "acme", "ben", `{"toOrgId":"globex"}`, 401},
+		{"unknown caller", "zed", "acme", "ben", `{"toOrgId":"globex"}`, 401},
+		{"target in other org", "eve", "acme", "gus", `{"toOrgId":"acme"}`, 404},
+		{"unknown target", "eve", "acme", "nobody", `{"toOrgId":"globex"}`, 404},
+		{"missing toOrgId", "eve", "acme", "ben", `{}`, 400},
+		{"empty body", "eve", "acme", "ben", ``, 400},
+		{"invalid json", "eve", "acme", "ben", `{"toOrgId":`, 400},
+		{"same organization", "eve", "acme", "ben", `{"toOrgId":"acme"}`, 400},
+		{"unknown organization", "eve", "acme", "ben", `{"toOrgId":"initech"}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/orgs/"+c.orgID+"/users/"+c.uid+"/transfer", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got transferResponse
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.ID != "ben" || got.OrgID != "globex" {
+		t.Fatalf("got %+v", got)
+	}
+}
+
+func TestTransferEffects(t *testing.T) {
+	db, err := openSeededDB()
+	if err != nil {
+		t.Fatal(err)
+	}
+	h := newHandler(db)
+
+	// Before: ben reads acme's web project.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("before transfer: got %d want 200", code)
+	}
+
+	if code, body := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: got %d want 200: %s", code, body)
+	}
+
+	// After: ben is in globex, so acme projects are gone for them.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("after transfer, acme project: got %d want 404", code)
+	}
+	var orgID string
+	if err := db.QueryRow(`SELECT org_id FROM users WHERE id = 'ben'`).Scan(&orgID); err != nil {
+		t.Fatal(err)
+	}
+	if orgID != "globex" {
+		t.Fatalf("users.org_id = %q want globex", orgID)
+	}
+	var n int
+	if err := db.QueryRow(`SELECT COUNT(*) FROM memberships WHERE user_id = 'ben'`).Scan(&n); err != nil {
+		t.Fatal(err)
+	}
+	if n != 0 {
+		t.Fatalf("ben still has %d acme memberships", n)
+	}
+	// Tasks are not moved; the assignee stays as it was.
+	var assignee string
+	if err := db.QueryRow(`SELECT assignee FROM tasks WHERE id = 't1'`).Scan(&assignee); err != nil {
+		t.Fatal(err)
+	}
+	if assignee != "ben" {
+		t.Fatalf("t1 assignee = %q want ben", assignee)
+	}
+}
+
+func TestTransferClearsOrgAdmin(t *testing.T) {
+	db, err := openSeededDB()
+	if err != nil {
+		t.Fatal(err)
+	}
+	h := newHandler(db)
+	if code, body := do(t, h, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: got %d want 200: %s", code, body)
+	}
+	var admin int
+	if err := db.QueryRow(`SELECT org_admin FROM users WHERE id = 'eve'`).Scan(&admin); err != nil {
+		t.Fatal(err)
+	}
+	if admin != 0 {
+		t.Fatalf("eve org_admin = %d want 0", admin)
+	}
+}
+
