 func (a *deleteTaskAggregate) apply(ctx context.Context, tx DB) error { return a.task.destroy(ctx, tx) }
+
+// freezeProjectAggregate sets every member of a project to viewer.
+type freezeProjectAggregate struct {
+	project *Project
+	members []*Membership // all members of the project, by user ID
+	tasks   []*Task       // the project's tasks
+}
+
+func loadFreezeProject(ctx context.Context, tx DB, projectID string) (*freezeProjectAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	members, err := p.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	tasks, err := p.Tasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &freezeProjectAggregate{project: p, members: members, tasks: tasks}, nil
+}
+
+// validate has nothing to refuse: freezing only removes writer roles, and
+// apply clears the assignees that would then break the model rule.
+func (a *freezeProjectAggregate) validate() error { return nil }
+
+// apply makes every member a viewer and unassigns every task, because after the
+// freeze no member is a contributor or manager, so no task may keep an assignee.
+// It returns the members as they are after the change.
+func (a *freezeProjectAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for _, m := range a.members {
+		if err := m.setRole(ctx, tx, RoleViewer); err != nil {
+			return nil, err
+		}
+	}
+	for _, t := range a.tasks {
+		if t.AssigneeID == "" {
+			continue
+		}
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	return a.members, nil
+}
