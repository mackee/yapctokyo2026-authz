@@ -0,0 +1,138 @@
+package main
+
+import (
+	"encoding/json"
+	"reflect"
+	"testing"
+)
+
+// Freezing a project: POST /projects/{pid}/freeze sets every member's role to
+// viewer (managers included) and returns the members as [{"userId","role"}].
+// Afterwards nobody can change the project's tasks.
+
+func decodeMembers(t *testing.T, body string) []map[string]string {
+	t.Helper()
+	var members []map[string]string
+	if err := json.Unmarshal([]byte(body), &members); err != nil {
+		t.Fatalf("response is not a member list: %v: %s", err, body)
+	}
+	return members
+}
+
+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"archived", "ann", "legacy", 409},
+		{"missing project", "ann", "nope", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeReturnsMembersAsViewers(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	// web members, ordered by user ID; ann, ivy (managers) and ben, cat (contributors)
+	// and dan (viewer) all become viewers.
+	want := []map[string]string{
+		{"userId": "ann", "role": "viewer"},
+		{"userId": "ben", "role": "viewer"},
+		{"userId": "cat", "role": "viewer"},
+		{"userId": "dan", "role": "viewer"},
+		{"userId": "ivy", "role": "viewer"},
+	}
+	if got := decodeMembers(t, body); !reflect.DeepEqual(got, want) {
+		t.Fatalf("members:\n got  %v\n want %v", got, want)
+	}
+}
+
+func TestFreezeLeavesOtherProjectsAlone(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d: %s", code, body)
+	}
+	// ivy is a manager of ops and must still be one there.
+	if code, body := do(t, h, "POST", "/projects/ops/tasks", "ivy", `{"title":"still open"}`); code != 200 {
+		t.Fatalf("ops write after web freeze: got %d: %s", code, body)
+	}
+	// cat's assignment in ops is untouched.
+	code, body := do(t, h, "GET", "/projects/ops/tasks/t4", "cat", "")
+	if code != 200 {
+		t.Fatalf("get ops task: got %d: %s", code, body)
+	}
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.AssigneeID != "cat" {
+		t.Fatalf("ops task t4 assignee: got %q want %q", task.AssigneeID, "cat")
+	}
+}
+
+func TestFreezeUnassignsTasks(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d: %s", code, body)
+	}
+	// Assignees must be contributors or managers, and nobody is one any more.
+	code, body := do(t, h, "GET", "/projects/web/tasks", "dan", "")
+	if code != 200 {
+		t.Fatalf("list: got %d: %s", code, body)
+	}
+	var tasks []Task
+	json.Unmarshal([]byte(body), &tasks)
+	if len(tasks) != 3 {
+		t.Fatalf("want 3 tasks, got %d", len(tasks))
+	}
+	for _, task := range tasks {
+		if task.AssigneeID != "" {
+			t.Fatalf("task %s still assigned to %q after freeze", task.ID, task.AssigneeID)
+		}
+	}
+}
+
+func TestFrozenProjectTasksCannotChange(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d: %s", code, body)
+	}
+	cases := []struct {
+		name, user, method, path, body string
+		want                           int
+	}{
+		{"create by former manager", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"create by former contributor", "ben", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"edit by former contributor", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`, 403},
+		{"edit by former manager", "ivy", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"assign by former manager", "ann", "PATCH", "/projects/web/tasks/t3", `{"assignee":"cat"}`, 403},
+		{"delete by former manager", "ann", "DELETE", "/projects/web/tasks/t1", "", 403},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, h, c.method, c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+		})
+	}
+	// Reads still work.
+	if code, body := do(t, h, "GET", "/projects/web/tasks/t1", "dan", ""); code != 200 {
+		t.Fatalf("read after freeze: got %d: %s", code, body)
+	}
+}
