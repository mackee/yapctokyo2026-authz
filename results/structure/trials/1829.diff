+// memberResponse is the JSON shape of a project member in the freeze response.
+type memberResponse struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func freezeProject(ctx tanukirpc.Context[*projectRegistry], _ struct{}) ([]memberResponse, error) {
+	reg := ctx.Registry()
+	members, err := model.NewMembershipTable().Freeze(ctx, reg.db, reg.authz)
+	if err != nil {
+		return nil, err
+	}
+	out := make([]memberResponse, 0, len(members))
+	for _, m := range members {
+		out = append(out, memberResponse{UserID: m.UserID, Role: m.Role})
+	}
+	return out, nil
+}
