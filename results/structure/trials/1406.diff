+// moveMemberAggregate moves one member from the source project to the
+// destination project.
+type moveMemberAggregate struct {
+	from     *Membership // the member in the source project
+	dest     *Project
+	existing *Membership // the member in the destination project, if any
+}
+
+func loadMoveMember(ctx context.Context, tx DB, fromID, toID, userID string) (*moveMemberAggregate, error) {
+	from, err := NewMembershipTable().Find(ctx, tx, fromID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "member not found")
+	} else if err != nil {
+		return nil, err
+	}
+	dest, err := NewProjectTable().Find(ctx, tx, toID)
+	if err != nil {
+		return nil, err
+	}
+	a := &moveMemberAggregate{from: from, dest: dest}
+	existing, err := NewMembershipTable().Find(ctx, tx, toID, userID)
+	if err == nil {
+		a.existing = existing
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.existing != nil {
+		return deny(ErrConflict, "user is already a member of the destination project")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	assigned, err := a.from.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, t := range assigned {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.from.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	moved := &Membership{ProjectID: a.dest.ID, UserID: a.from.UserID, Role: a.from.Role}
+	if err := moved.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return moved, nil
+}
+
