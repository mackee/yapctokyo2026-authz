+// allowed to remove the task from its project (CanManage) and to create tasks
+// in the destination (CanWrite, CanAssign for the task's assignee). The task
+// keeps its ID, title, status and assignee; the assignee must be a contributor
+// or manager of the destination, otherwise ErrInvalid.
+func (*TaskTable) Move(ctx context.Context, db DB, authz TaskAuthz, dest ProjectAuthz) (*Task, error) {
+	if err := authz.CanManage(); err != nil {
+		return nil, err
+	}
+	if err := dest.CanWrite(); err != nil {
+		return nil, err
+	}
+	var t *Task
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveTask(ctx, tx, authz.TaskID(), dest.ProjectID())
