+func TestUpdateMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager promotes contributor", "ann", "/projects/web/members/ben", `{"role":"manager"}`, 200},
+		{"manager promotes viewer", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"manager demotes member without tasks", "ann", "/projects/web/members/ivy", `{"role":"viewer"}`, 200},
+		{"manager demotes assignee", "ann", "/projects/web/members/cat", `{"role":"viewer"}`, 400},
+		{"contributor", "ben", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"viewer", "dan", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"org admin", "eve", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"non member", "hal", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"other org", "gus", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"anonymous", "", "/projects/web/members/ben", `{"role":"viewer"}`, 401},
+		{"unknown target user", "ann", "/projects/web/members/zed", `{"role":"viewer"}`, 404},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"invalid role", "ann", "/projects/web/members/dan", `{"role":"owner"}`, 400},
+		{"missing role", "ann", "/projects/web/members/dan", `{}`, 400},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"archived contributor", "ben", "/projects/legacy/members/ann", `{"role":"viewer"}`, 403},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRoleResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200 (%s)", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["userId"] != "dan" || got["role"] != "contributor" || len(got) != 2 {
+		t.Fatalf("got body %s", body)
+	}
+}
+
+func TestUpdateMemberRolePersists(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`); code != 200 {
+		t.Fatalf("promote: got %d (%s)", code, body)
+	}
+	if code, body := do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("promoted member create: got %d (%s)", code, body)
+	}
+	if code, body := do(t, srv, "PUT", "/projects/web/members/ivy", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote: got %d (%s)", code, body)
+	}
+	if code, body := do(t, srv, "POST", "/projects/web/tasks", "ivy", `{"title":"x"}`); code != 403 {
+		t.Fatalf("demoted member create: got %d want 403 (%s)", code, body)
+	}
+}
+
+func TestUpdateMemberRoleRejectedLeavesRoleUnchanged(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "PUT", "/projects/web/members/cat", "ann", `{"role":"viewer"}`); code != 400 {
