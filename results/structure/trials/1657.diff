+// updateMembershipRoleAggregate changes the role of one member of one project.
+type updateMembershipRoleAggregate struct {
+	membership *Membership
+	role       string
+	assigned   []*Task // the member's tasks in the project; loaded when the new role cannot write
+}
+
+func loadUpdateMembershipRole(ctx context.Context, tx DB, projectID, userID, role string) (*updateMembershipRoleAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &updateMembershipRoleAggregate{membership: m, role: role}
+	if !isWriterRole(role) {
+		a.assigned, err = m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+	}
+	return a, nil
+}
+
+func (a *updateMembershipRoleAggregate) validate() error {
+	if !isWriterRole(a.role) && len(a.assigned) > 0 {
+		return deny(ErrInvalid, "assignee must be a contributor or manager of the project: reassign or unassign its tasks first")
+	}
+	return nil
+}
+
+func (a *updateMembershipRoleAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	a.membership.Role = a.role
+	if err := a.membership.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a.membership, nil
+}
