index 3e01344..e884ae5 100644
--- a/internal/model/membership_table.go
+++ b/internal/model/membership_table.go
@@ -2,9 +2,44 @@ package model
 
 import "context"
 
-// MembershipTable reads the memberships table.
+// MembershipTable is the memberships table. Find and List* read rows; UpdateRole
+// is an operation that takes an authorization object (see MembershipAuthz).
 type MembershipTable struct{}
 
+var validRoles = map[string]bool{RoleManager: true, RoleContributor: true, RoleViewer: true}
+
+// MembershipTableUpdateRoleInput is the input of MembershipTable.UpdateRole.
+type MembershipTableUpdateRoleInput struct {
+	Role string
+}
+
+// UpdateRole changes the member's role in the project. It asks the
+// authorization object first, then runs the aggregate (aggregate.go) in a
+// transaction. The returned membership is the member's row after the change.
+func (mt *MembershipTable) UpdateRole(ctx context.Context, db DB, authz MembershipAuthz, in MembershipTableUpdateRoleInput) (*Membership, error) {
+	if err := authz.CanChangeRole(); err != nil {
+		return nil, err
+	}
+	if !validRoles[in.Role] {
+		return nil, deny(ErrInvalid, "invalid role")
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadUpdateMembershipRole(ctx, tx, authz.Project().ProjectID(), authz.UserID(), in.Role)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		m, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
+
 // NewMembershipTable returns the memberships table.
 func NewMembershipTable() *MembershipTable { return &MembershipTable{} }
 
