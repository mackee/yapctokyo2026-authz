+// CanManage returns nil if the actor may manage the project's members: managers
+// only (else ErrForbidden) and not archived (else ErrArchived).
+func (a ProjectAuthz) CanManage() error {
+	if !a.CanRead() || a.role != RoleManager {
+		return deny(ErrForbidden, "only managers may remove members")
+	}
+	if a.archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	return nil
+}
