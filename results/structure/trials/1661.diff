-// MembershipTable reads the memberships table.
+// MembershipTable is the memberships table. Find and List* read rows; Remove
+// is the API operation that takes a member out of a project.
 type MembershipTable struct{}
 
 // NewMembershipTable returns the memberships table.
 func NewMembershipTable() *MembershipTable { return &MembershipTable{} }
 
+// Remove removes the user from the project and unassigns the tasks they held
+// in it, all or nothing. It asks the authorization object whether the actor
+// may manage members first. A user who is not a member is ErrNotFound.
+func (*MembershipTable) Remove(ctx context.Context, db DB, authz ProjectAuthz, userID string) error {
+	if err := authz.CanManage(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveMember(ctx, tx, authz.ProjectID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
+
