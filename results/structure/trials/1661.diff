+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager removes contributor", "ann", "/projects/web/members/ben", 204},
+		{"manager removes viewer", "ann", "/projects/web/members/dan", 204},
+		{"manager removes manager", "ann", "/projects/web/members/ivy", 204},
+		{"contributor", "ben", "/projects/web/members/cat", 403},
+		{"viewer", "dan", "/projects/web/members/ben", 403},
+		{"org admin without role", "eve", "/projects/web/members/ben", 403},
+		{"non member", "hal", "/projects/web/members/ben", 404},
+		{"other org", "gus", "/projects/web/members/ben", 404},
+		{"anonymous", "", "/projects/web/members/ben", 401},
+		{"unknown user", "zed", "/projects/web/members/ben", 401},
+		{"target not a member", "ann", "/projects/web/members/hal", 404},
+		{"target member of another project only", "ivy", "/projects/ops/members/ben", 404},
+		{"missing project", "ann", "/projects/nope/members/ben", 404},
+		{"archived", "ann", "/projects/legacy/members/ben", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveMemberEffects(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "DELETE", "/projects/web/members/ben", "ann", ""); code != 204 {
+		t.Fatalf("remove: got %d %s", code, body)
+	}
+
+	// The removed user can no longer read the project.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("removed member read project: got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 404 {
+		t.Fatalf("removed member create: got %d want 404", code)
+	}
+
+	// Tasks the removed user held in the project are unassigned (the assignee
+	// must stay a member of the task's project).
+	code, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("get t1: got %d", code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "" {
+		t.Fatalf("t1 still assigned to %q", task.AssigneeID)
+	}
+
+	// Other members' tasks in the project are untouched.
+	code, body = do(t, srv, "GET", "/projects/web/tasks/t2", "ann", "")
+	if code != 200 {
+		t.Fatalf("get t2: got %d", code)
+	}
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "cat" {
+		t.Fatalf("t2 assignee = %q, want cat", task.AssigneeID)
+	}
+
+	// Membership in other projects is untouched.
+	if code, _ := do(t, srv, "GET", "/projects/legacy/tasks/t5", "ben", ""); code != 200 {
+		t.Fatalf("ben in legacy after removal from web: got %d want 200", code)
+	}
+
+	// Removing a member again is a 404: they are no longer a member.
+	if code, _ := do(t, srv, "DELETE", "/projects/web/members/ben", "ann", ""); code != 404 {
+		t.Fatalf("second remove: got %d want 404", code)
+	}
+}
