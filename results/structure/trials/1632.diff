+package main
+
+import (
+	"encoding/json"
+	"reflect"
+	"testing"
+)
+
+type freezeMember struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// POST /projects/{pid}/freeze returns the members after the change, sorted by userId.
+func TestFreezeResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got []freezeMember
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("invalid body %q: %v", body, err)
+	}
+	// web members: ann (manager), ben, cat (contributors), dan (viewer), ivy (manager)
+	want := []freezeMember{
+		{"ann", "viewer"},
+		{"ben", "viewer"},
+		{"cat", "viewer"},
+		{"dan", "viewer"},
+		{"ivy", "viewer"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+}
+
+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"second manager", "ivy", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin non member", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+		{"missing project", "ann", "nope", 404},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+// After a freeze nobody can change tasks in the project, including the
+// manager who froze it. Reads still work and the data is untouched.
+func TestFrozenProjectRejectsTaskWrites(t *testing.T) {
+	s := newServer()
+	if code, body := do(t, s, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze got %d want 200: %s", code, body)
+	}
+	cases := []struct {
+		name, user, method, path, body string
+		want                           int
+	}{
+		{"manager create", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"former contributor create", "ben", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"former contributor update own", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`, 403},
+		{"former manager update", "ivy", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"former manager reassign", "ann", "PATCH", "/projects/web/tasks/t3", `{"assignee":"cat"}`, 403},
+		{"former manager delete", "ann", "DELETE", "/projects/web/tasks/t1", "", 403},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, s, c.method, c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+
+	code, body := do(t, s, "GET", "/projects/web/tasks/t1", "ben", "")
+	if code != 200 {
+		t.Fatalf("read after freeze got %d want 200", code)
+	}
+	want := `{"id":"t1","projectId":"web","title":"Fix header","status":"open","assignee":"ben"}`
+	if got := trimNewline(body); got != want {
+		t.Fatalf("task changed by frozen writes:\ngot  %s\nwant %s", got, want)
+	}
+}
+
+// Freezing one project must not change roles in other projects.
+func TestFreezeLeavesOtherProjectsAlone(t *testing.T) {
+	s := newServer()
+	if code, body := do(t, s, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze got %d want 200: %s", code, body)
+	}
+	if code, body := do(t, s, "POST", "/projects/ops/tasks", "cat", `{"title":"x"}`); code != 200 {
+		t.Fatalf("ops contributor create got %d want 200: %s", code, body)
+	}
+	if code, body := do(t, s, "POST", "/projects/ops/tasks", "ivy", `{"title":"x"}`); code != 200 {
+		t.Fatalf("ops manager create got %d want 200: %s", code, body)
+	}
+}
+
+func trimNewline(s string) string {
+	if n := len(s); n > 0 && s[n-1] == '\n' {
+		return s[:n-1]
+	}
+	return s
+}
