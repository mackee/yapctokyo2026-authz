+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"other project manager", "ivy", "ops", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+		{"missing project", "ann", "nope", 404},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeDemotesAllMembers(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []memberRole
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []memberRole{
+		{"ann", "viewer"}, {"ben", "viewer"}, {"cat", "viewer"},
+		{"dan", "viewer"}, {"ivy", "viewer"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("got %v want %v", got, want)
+		}
+	}
+	// Other projects are untouched.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ann", `{"title":"x"}`); code != 403 {
+		t.Fatalf("manager create after freeze: got %d want 403", code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 403 {
+		t.Fatalf("contributor update after freeze: got %d want 403", code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t2", "ann", `{"status":"done"}`); code != 403 {
+		t.Fatalf("manager update after freeze: got %d want 403", code)
+	}
+	if code, _ := do(t, h, "DELETE", "/projects/web/tasks/t1", "ann", ""); code != 403 {
+		t.Fatalf("manager delete after freeze: got %d want 403", code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/ops/tasks/t4", "ivy", `{"status":"done"}`); code != 200 {
+		t.Fatalf("unrelated project write: got %d want 200", code)
+	}
+}
