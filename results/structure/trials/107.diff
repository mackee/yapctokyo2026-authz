+// Claim applies the write rule (readable, contributor or manager, else 403),
+// the archive rule (else 409), and requires the task to be unassigned (else
+// 409). Unlike Edit, it does not require the actor to already be the assignee:
+// taking an unowned task is the point of claiming it.
+func (s *taskScope) Claim() (ClaimTask, error) {
+	err := s.ps.as.a.st.read(func(st *state) error {
+		p, r, t, err := locate(st, s.ps.as.actor, s.ps.pid, s.tid)
+		if err != nil {
+			return err
+		}
+		if !isWriterRole(r) {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if p.archived {
+			return deny(ErrArchived, "project is archived")
+		}
+		if t.assignee.user != "" {
+			return deny(ErrConflict, "task is already assigned")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &claimTask{readTask: readTask{ts: s}}, nil
+}
+
 type readTask struct{ ts *taskScope }
 
 func (t *readTask) View() TaskView {
@@ -432,3 +470,30 @@ func (t *manageTask) Delete() error {
 		return nil
 	})
 }
+
+type claimTask struct{ readTask }
+
+// Claim re-checks the task inside the transaction, so two concurrent claims
+// cannot both succeed: the second one sees the first one's assignee and gets 409.
+func (t *claimTask) Claim() (TaskView, error) {
+	actor := t.ts.ps.as.actor.id
+	var v TaskView
+	err := t.ts.ps.as.a.st.tx(func(s *state) error {
+		cur, ok := s.tasks[t.ts.tid]
+		if !ok || cur.project != t.ts.ps.pid {
+			return deny(ErrNotFound, "not found")
+		}
+		if cur.assignee.user != "" {
+			return deny(ErrConflict, "task is already assigned")
+		}
+		a, err := admit(s, cur.project, actor)
+		if err != nil {
+			return err
+		}
+		cur.assignee = a
+		s.tasks[cur.id] = cur
+		v = cur.view()
+		return nil
+	})
+	return v, err
+}
