@@ -0,0 +1,101 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestClaim(t *testing.T) {
+	// t3 (web) is seeded unassigned; t1 is assigned to ben; t5 is in archived legacy.
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"contributor unassigned", "ben", "/projects/web/tasks/t3", 200},
+		{"manager unassigned", "ann", "/projects/web/tasks/t3", 200},
+		{"already assigned to self", "ben", "/projects/web/tasks/t1", 409},
+		{"already assigned to other", "ann", "/projects/web/tasks/t1", 409},
+		{"viewer", "dan", "/projects/web/tasks/t3", 403},
+		{"org admin without role", "eve", "/projects/web/tasks/t3", 403},
+		{"non member", "hal", "/projects/web/tasks/t3", 404},
+		{"other org", "gus", "/projects/web/tasks/t3", 404},
+		{"anonymous", "", "/projects/web/tasks/t3", 401},
+		{"unknown user", "zed", "/projects/web/tasks/t3", 401},
+		{"missing task", "ann", "/projects/web/tasks/t99", 404},
+		{"task in other project", "ann", "/projects/ops/tasks/t3", 404},
+		{"archived project", "ann", "/projects/legacy/tasks/t5", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path+"/claim", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestClaimReturnsUpdatedTask(t *testing.T) {
+	srv := newServer()
+	code, body := do(t, srv, "POST", "/projects/web/tasks/t3/claim", "ben", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got Task
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t3", ProjectID: "web", Title: "Write copy", Status: "open", Assignee: "ben"}
+	if got != want {
+		t.Fatalf("response: got %+v want %+v", got, want)
+	}
+
+	// The change is persisted: a later read sees the new assignee.
+	code, body = do(t, srv, "GET", "/projects/web/tasks/t3", "ann", "")
+	if code != 200 {
+		t.Fatalf("get: got %d", code)
+	}
+	var read Task
+	if err := json.Unmarshal([]byte(body), &read); err != nil {
+		t.Fatal(err)
+	}
+	if read.Assignee != "ben" {
+		t.Fatalf("after claim, assignee = %q want ben", read.Assignee)
+	}
+}
+
+func TestClaimOnlyOnce(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/projects/web/tasks/t3/claim", "ben", ""); code != 200 {
+		t.Fatalf("first claim: got %d: %s", code, body)
+	}
+	code, body := do(t, srv, "POST", "/projects/web/tasks/t3/claim", "cat", "")
+	if code != 409 {
+		t.Fatalf("second claim: got %d want 409: %s", code, body)
+	}
+	var e map[string]string
+	if err := json.Unmarshal([]byte(body), &e); err != nil || e["error"] == "" {
+		t.Fatalf("want {\"error\":...} body, got %q", body)
+	}
+
+	// The first claimant keeps the task.
+	_, body = do(t, srv, "GET", "/projects/web/tasks/t3", "ann", "")
+	var read Task
+	if err := json.Unmarshal([]byte(body), &read); err != nil {
+		t.Fatal(err)
+	}
+	if read.Assignee != "ben" {
+		t.Fatalf("assignee = %q want ben", read.Assignee)
+	}
+}
+
+func TestClaimThenEditAsAssignee(t *testing.T) {
+	// A contributor who claims a task becomes its assignee and may edit it.
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/projects/web/tasks/t3/claim", "ben", ""); code != 200 {
+		t.Fatalf("claim: got %d: %s", code, body)
+	}
+	if code, body := do(t, srv, "PATCH", "/projects/web/tasks/t3", "ben", `{"status":"done"}`); code != 200 {
+		t.Fatalf("edit: got %d: %s", code, body)
+	}
+}
