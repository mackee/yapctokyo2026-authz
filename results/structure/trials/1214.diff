+// updateMembershipAggregate changes the role of one existing member of a project.
+type updateMembershipAggregate struct {
+	membership *Membership
+	role       string
+}
+
+func loadUpdateMembership(ctx context.Context, tx DB, projectID string, in MembershipTableUpdateRoleInput) (*updateMembershipAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, projectID, in.UserID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	return &updateMembershipAggregate{membership: m, role: in.Role}, nil
+}
+
+func (a *updateMembershipAggregate) validate() error {
+	if !validRoles[a.role] {
+		return deny(ErrInvalid, "role must be manager, contributor or viewer")
+	}
+	return nil
+}
+
+func (a *updateMembershipAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.membership.setRole(ctx, tx, a.role); err != nil {
+		return nil, err
+	}
+	return a.membership, nil
+}
+
