diff --git a/internal/model/membership_table.go b/internal/model/membership_table.go
index 3e01344..98e5c92 100644
--- a/internal/model/membership_table.go
+++ b/internal/model/membership_table.go
@@ -2,12 +2,54 @@ package model
 
 import "context"
 
-// MembershipTable reads the memberships table.
+// MembershipTable is the memberships table.
+//
+// Find and List* read rows. UpdateRole is the API operation: it takes the
+// database (a *sql.DB or a *sql.Tx), the project's authorization object and an
+// input; it asks the authorization object whether the actor may manage members,
+// then runs its aggregate (aggregate.go) in a transaction.
 type MembershipTable struct{}
 
 // NewMembershipTable returns the memberships table.
 func NewMembershipTable() *MembershipTable { return &MembershipTable{} }
 
+// validRoles is the set of project roles a membership may hold.
+var validRoles = map[string]bool{RoleManager: true, RoleContributor: true, RoleViewer: true}
+
+// MembershipTableUpdateRoleInput is the input of MembershipTable.UpdateRole.
+type MembershipTableUpdateRoleInput struct {
+	UserID string
+	Role   string
+}
+
+// UpdateRole changes the role of an existing member of the project. It does
+// not add members: a user who is not a member of the project is ErrNotFound.
+func (mt *MembershipTable) UpdateRole(ctx context.Context, db DB, authz ProjectAuthz, in MembershipTableUpdateRoleInput) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if !validRoles[in.Role] {
+		return nil, deny(ErrInvalid, "role must be manager, contributor or viewer")
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadUpdateMembership(ctx, tx, authz.ProjectID(), in)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if m, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
+
 // Find returns the membership of the user in the project, or ErrNoRows.
 func (*MembershipTable) Find(ctx context.Context, db DB, projectID, userID string) (*Membership, error) {
 	var m Membership
