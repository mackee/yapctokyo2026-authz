 func (a *deleteTaskAggregate) apply(x *tx) { a.task.Destroy(x) }
+
+// moveMemberAggregate moves one member from one project to another, keeping
+// the role. The member's tasks in the source project are unassigned, because
+// an assignee must belong to the task's project.
+type moveMemberAggregate struct {
+	from     projectRecord
+	to       projectRecord
+	member   membershipRecord // from.Membership(user)
+	assigned []taskRecord     // member.AssignedTasks: tasks of from assigned to the member
+}
+
+func loadMoveMember(x *tx, fromID, toID, userID string) (*moveMemberAggregate, error) {
+	from, ok := x.findProject(fromID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	to, ok := x.findProject(toID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	m, ok := from.Membership(x, userID)
+	if !ok {
+		return nil, deny(ErrNotFound, "user is not a member of the project")
+	}
+	if _, ok := to.Membership(x, userID); ok {
+		return nil, deny(ErrConflict, "user is already a member of the destination project")
+	}
+	return &moveMemberAggregate{from: from, to: to, member: m, assigned: m.AssignedTasks(x)}, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.from.Org != a.to.Org {
+		return deny(ErrInvalid, "project members must belong to the project's organization")
+	}
+	switch a.member.Role {
+	case RoleManager, RoleContributor, RoleViewer:
+	default:
+		return deny(ErrInvalid, "invalid role")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(x *tx) MemberView {
+	for _, t := range a.assigned {
+		t.Unassign(x)
+	}
+	a.member.Destroy(x)
+	m := membershipRecord{ProjectID: a.to.ID, UserID: a.member.UserID, Role: a.member.Role}
+	m.save(x)
+	return MemberView{UserID: m.UserID, ProjectID: m.ProjectID, Role: m.Role}
+}
