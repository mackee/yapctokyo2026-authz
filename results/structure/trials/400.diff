+// ManageProject is the manager-only capability for one project's membership.
+type ManageProject interface {
+	WriteProject
+	// MoveMember removes the user from this project and adds them to dest with
+	// the same role. dest must be a ManageProject acquired by the same actor
+	// (so the actor is a manager there too). Tasks the user was assigned to in
+	// this project are unassigned, since an assignee must belong to the task's
+	// project. All-or-nothing.
+	MoveMember(userID string, dest ManageProject) (MemberView, error)
+}
+
+type manageProject struct{ writeProject }
+
+func (p *manageProject) MoveMember(userID string, dest ManageProject) (MemberView, error) {
+	d, ok := dest.(*manageProject)
+	if !ok || d.ps.as.a != p.ps.as.a {
+		return MemberView{}, deny(ErrInvalid, "destination was not acquired by this actor")
+	}
+	toID := d.ps.pid
+	if toID == p.ps.pid {
+		return MemberView{}, deny(ErrInvalid, "destination must be a different project")
+	}
+	var v MemberView
+	err := p.ps.as.a.db.update(func(x *tx) error {
+		agg, err := loadMoveMember(x, p.ps.pid, toID, userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		v = agg.apply(x)
+		return nil
+	})
+	return v, err
+}
