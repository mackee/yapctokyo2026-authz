+// removeMember sends DELETE /projects/{project}/members/{member} as user.
+func removeMember(t *testing.T, h http.Handler, user, project, member string) (int, string) {
+	t.Helper()
+	return do(t, h, "DELETE", "/projects/"+project+"/members/"+member, user, "")
+}
+
+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, project, member string
+		want                        int
+	}{
+		{"manager removes contributor", "ann", "web", "ben", 204},
+		{"manager removes viewer", "ann", "web", "dan", 204},
+		{"contributor", "ben", "web", "cat", 403},
+		{"viewer", "dan", "web", "cat", 403},
+		{"org admin without role", "eve", "web", "cat", 403},
+		{"non member", "hal", "web", "cat", 404},
+		{"other org", "gus", "web", "ben", 404},
+		{"anonymous", "", "web", "ben", 401},
+		{"unknown user", "zed", "web", "ben", 401},
+		{"archived", "ann", "legacy", "ben", 409},
+		{"target not a member", "ann", "web", "hal", 404},
+		{"target only in another project", "ivy", "ops", "ben", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := removeMember(t, newServer(), c.user, c.project, c.member)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveMemberEffects(t *testing.T) {
+	h := newServer()
+	if code, body := removeMember(t, h, "ann", "web", "ben"); code != 204 {
+		t.Fatalf("remove: got %d %s, want 204", code, body)
+	}
+
+	// The removed member can no longer read the project.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("removed member reads project: got %d want 404", code)
+	}
+	// Their memberships in other projects are untouched.
+	if code, _ := do(t, h, "GET", "/projects/legacy/tasks", "ben", ""); code != 200 {
+		t.Fatalf("membership in other project: got %d want 200", code)
+	}
+
+	// Their task in the project is unassigned; other people's tasks are not.
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("get t1: got %d want 200", code)
+	}
+	var t1 Task
+	if err := json.Unmarshal([]byte(body), &t1); err != nil {
+		t.Fatal(err)
+	}
+	if t1.AssigneeID != "" {
+		t.Fatalf("t1 still assigned to %q", t1.AssigneeID)
+	}
+	code, body = do(t, h, "GET", "/projects/web/tasks/t2", "ann", "")
+	var t2 Task
+	if code != 200 || json.Unmarshal([]byte(body), &t2) != nil || t2.AssigneeID != "cat" {
+		t.Fatalf("t2 should stay assigned to cat: got %d %s", code, body)
+	}
+
+	// Removing the same member again is not found.
+	if code, _ := removeMember(t, h, "ann", "web", "ben"); code != 404 {
+		t.Fatalf("second removal: got %d want 404", code)
+	}
+}
