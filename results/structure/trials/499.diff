+func TestRemoveUserFromOrg(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes user without memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"manager is not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"viewer is not org admin", "dan", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"caller in other org", "gus", "/orgs/acme/users/ben", 404},
+		{"org that is not the caller's", "eve", "/orgs/globex/users/gus", 404},
+		{"user of other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveUserFromOrgRemovesAccess(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "DELETE", "/orgs/acme/users/ann", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d %s", code, body)
+	}
+	// ann was a member of web, ops and legacy (archived); all of them are gone.
+	for _, path := range []string{"/projects/web/tasks", "/projects/ops/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, srv, "GET", path, "ann", ""); code != 404 {
+			t.Fatalf("ann GET %s: got %d want 404", path, code)
+		}
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "ann", `{"title":"x"}`); code != 404 {
+		t.Fatalf("ann POST: got %d want 404", code)
+	}
+	// Other members keep their access.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ivy", ""); code != 200 {
+		t.Fatalf("ivy GET web: got %d want 200", code)
+	}
+	// Removing again is a no-op.
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ann", "eve", ""); code != 204 {
+		t.Fatalf("second remove: got %d want 204", code)
+	}
+}
+
+func TestRemoveUserFromOrgIncludesArchivedProjects(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/legacy/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben GET legacy: got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 404 {
+		t.Fatalf("ben PATCH t1: got %d want 404", code)
+	}
+}
+
+func TestRemoveUserFromOrgNeedsOrgAdmin(t *testing.T) {
+	srv := newServer()
+	// ann manages ben's projects but is not an org admin: nothing is removed.
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "ann", ""); code != 403 {
+		t.Fatalf("manager remove: got %d want 403", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks/t1", "ben", ""); code != 200 {
+		t.Fatalf("ben GET t1 after refused removal: got %d want 200", code)
+	}
+}
