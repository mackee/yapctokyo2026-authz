+
+type transferRequest struct {
+	ToOrgID string `json:"toOrgId"`
+}
+
+// transferUser moves a user from the path org to toOrgId. Org admins keep no
+// rights across organizations, so the moved user loses org admin.
+func (s *server) transferUser(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	caller, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if caller == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	orgID := r.PathValue("orgID")
+	if caller.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	if !caller.OrgAdmin {
+		writeError(w, 403, "only org admins may transfer users")
+		return
+	}
+	target, err := findUser(ctx, s.db, r.PathValue("uid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if target == nil || target.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	var req transferRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || req.ToOrgID == "" {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	if req.ToOrgID == orgID {
+		writeError(w, 400, "user is already in that organization")
+		return
+	}
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+	var memberships int
+	if err := tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM memberships m JOIN projects p ON p.id = m.project_id WHERE m.user_id = ? AND p.org_id = ?`,
+		target.ID, orgID).Scan(&memberships); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if memberships > 0 {
+		writeError(w, 409, "user is still a member of projects in this organization")
+		return
+	}
+	if _, err := tx.ExecContext(ctx, `UPDATE users SET org_id = ?, org_admin = 0 WHERE id = ?`, req.ToOrgID, target.ID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, map[string]string{"id": target.ID, "orgId": req.ToOrgID})
+}
diff --git a/transfer_test.go b/transfer_test.go
new file mode 100644
index 0000000..9620a6d
--- /dev/null
+++ b/transfer_test.go
@@ -0,0 +1,71 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+// POST /orgs/{orgID}/users/{uid}/transfer moves a user to another organization.
+// The caller must be an org admin of {orgID}.
+
+func TestTransfer(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin moves a user", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 200},
+		{"ordinary member", "ann", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 403},
+		{"anonymous", "", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown caller", "zed", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 401},
+		{"admin of another org", "eve", "/orgs/globex/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"caller from another org", "gus", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 404},
+		{"user not in the org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"missing toOrgId", "eve", "/orgs/acme/users/hal/transfer", `{}`, 400},
+		{"invalid body", "eve", "/orgs/acme/users/hal/transfer", `not json`, 400},
+		{"same org", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"acme"}`, 400},
+		{"user still in a project of the old org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/hal/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("response is not a JSON object: %v: %s", err, body)
+	}
+	if len(got) != 2 || got["id"] != "hal" || got["orgId"] != "globex" {
+		t.Fatalf(`got %s want {"id":"hal","orgId":"globex"}`, body)
+	}
+}
+
+// After a transfer the user's rights follow the new organization: the moved user
+// can no longer see the old organization's projects, and an org admin who moves
+// away loses the admin rights of the old organization.
+func TestTransferMovesAccess(t *testing.T) {
+	h := newServer()
+
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "eve", ""); code != 200 {
+		t.Fatalf("before transfer: eve reads ops got %d want 200", code)
+	}
+	if code, body := do(t, h, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("eve transfers herself: got %d want 200: %s", code, body)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "eve", ""); code != 404 {
+		t.Fatalf("after transfer: eve reads acme project got %d want 404", code)
+	}
+	if code, _ := do(t, h, "POST", "/orgs/globex/users/gus/transfer", "eve", `{"toOrgId":"acme"}`); code != 403 {
+		t.Fatalf("after transfer: eve is no longer an org admin, got %d want 403", code)
+	}
+}
