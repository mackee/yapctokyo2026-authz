+func TestChangeMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager demotes", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 200},
+		{"manager promotes", "ann", "/projects/web/members/dan", `{"role":"manager"}`, 200},
+		{"manager changes self with another manager", "ann", "/projects/web/members/ann", `{"role":"contributor"}`, 200},
+		{"contributor", "ben", "/projects/web/members/cat", `{"role":"viewer"}`, 403},
+		{"viewer", "dan", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"org admin", "eve", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"non member", "hal", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"other org", "gus", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"anonymous", "", "/projects/web/members/ben", `{"role":"viewer"}`, 401},
+		{"unknown user", "zed", "/projects/web/members/ben", `{"role":"viewer"}`, 401},
+		{"unknown project", "ann", "/projects/nope/members/ben", `{"role":"viewer"}`, 404},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"target member of other project only", "ann", "/projects/web/members/gus", `{"role":"viewer"}`, 404},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"invalid role", "ann", "/projects/web/members/ben", `{"role":"owner"}`, 400},
+		{"empty role", "ann", "/projects/web/members/ben", `{}`, 400},
+		{"bad json", "ann", "/projects/web/members/ben", `nope`, 400},
+		{"demote last manager", "ivy", "/projects/ops/members/ivy", `{"role":"viewer"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestChangeMemberRoleResultAndEffect(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 2 || got["userId"] != "ben" || got["role"] != "viewer" {
+		t.Fatalf("unexpected body %s", body)
+	}
+	// ben is now a viewer: can no longer modify his own task.
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 403 {
+		t.Fatalf("demoted user can still write: %d", code)
+	}
+	// other projects are unaffected.
+	if code, _ := do(t, h, "PATCH", "/projects/legacy/tasks/t5", "ann", `{"status":"done"}`); code != 409 {
+		t.Fatalf("got %d", code)
+	}
+	// promoted user gains manager rights.
+	if code, _ := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"manager"}`); code != 200 {
+		t.Fatal(code)
+	}
+	if code, _ := do(t, h, "DELETE", "/projects/web/tasks/t3", "dan", ""); code != 204 {
+		t.Fatalf("promoted user cannot delete: %d", code)
+	}
+}
