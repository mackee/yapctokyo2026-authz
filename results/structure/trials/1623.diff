index 0000000..3916c63
--- /dev/null
+++ b/org_test.go
@@ -0,0 +1,114 @@
+package main
+
+import "testing"
+
+// DELETE /orgs/{orgID}/users/{uid}: an org admin removes the user from every
+// project of the org (archived ones included) and gets 204.
+
+func TestRemoveOrgUserStatusCodes(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes user without memberships", "eve", "/orgs/acme/users/hal", 204},
+		{"org admin removes unknown user", "eve", "/orgs/acme/users/zed", 404},
+		{"org admin removes user of other org", "eve", "/orgs/acme/users/gus", 404},
+		{"org admin targets unknown org", "eve", "/orgs/nope/users/ben", 404},
+		{"org admin targets other org", "eve", "/orgs/globex/users/gus", 404},
+		{"same org, not admin", "ann", "/orgs/acme/users/ben", 403},
+		{"other org caller", "gus", "/orgs/acme/users/ben", 404},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserRemovesAccess(t *testing.T) {
+	srv := newServer()
+
+	// ben is a contributor of web and legacy (archived).
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("before: ben reads web: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove ben: got %d want 204", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("after: ben reads web: got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/legacy/tasks/t5", "ben", ""); code != 404 {
+		t.Fatalf("after: ben reads archived legacy: got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 404 {
+		t.Fatalf("after: ben creates in web: got %d want 404", code)
+	}
+	// Repeating the removal is harmless.
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove ben again: got %d want 204", code)
+	}
+}
+
+func TestRemoveOrgUserLeavesOthersAlone(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove ben: got %d want 204", code)
+	}
+	cases := []struct {
+		name, user, path string
+	}{
+		{"web manager keeps access", "ann", "/projects/web/tasks"},
+		{"web viewer keeps access", "dan", "/projects/web/tasks"},
+		{"ops contributor keeps access", "cat", "/projects/ops/tasks"},
+		{"other org keeps access", "gus", "/projects/gx/tasks"},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			if code, _ := do(t, srv, "GET", c.path, c.user, ""); code != 200 {
+				t.Fatalf("got %d want 200", code)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserAcrossAllProjects(t *testing.T) {
+	srv := newServer()
+	// ivy is a manager of web and ops.
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ivy", "eve", ""); code != 204 {
+		t.Fatalf("remove ivy: got %d want 204", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "ivy", ""); code != 404 {
+		t.Fatalf("ivy reads ops: got %d want 404", code)
+	}
+	if code, _ := do(t, srv, "PATCH", "/projects/web/tasks/t2", "ivy", `{"status":"done"}`); code != 404 {
+		t.Fatalf("ivy updates web task: got %d want 404", code)
+	}
+
+	// ann is a manager of web and legacy and a viewer of ops; removing her
+	// from every project means all three reads fail.
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ann", "eve", ""); code != 204 {
+		t.Fatalf("remove ann: got %d want 204", code)
+	}
+	for _, path := range []string{"/projects/web/tasks", "/projects/ops/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, srv, "GET", path, "ann", ""); code != 404 {
+			t.Fatalf("ann reads %s: got %d want 404", path, code)
+		}
+	}
+}
+
+func TestRemoveOrgUserRefusedLeavesAccessAlone(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "ann", ""); code != 403 {
+		t.Fatalf("non-admin remove: got %d want 403", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks/t1", "ben", ""); code != 200 {
+		t.Fatalf("ben lost access after refused removal: got %d want 200", code)
+	}
+}
