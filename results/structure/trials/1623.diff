new file mode 100644
index 0000000..faed476
--- /dev/null
+++ b/org.go
@@ -0,0 +1,52 @@
+package main
+
+import "net/http"
+
+// removeOrgUser handles DELETE /orgs/{orgID}/users/{uid}: an org admin removes
+// the user from every project of the org (archived projects included), e.g.
+// when the user leaves the company. The user record itself is kept.
+//
+//   - unknown or missing caller                          -> 401
+//   - caller is in another org (or org is unknown)       -> 404
+//   - caller is in the org but not an org admin          -> 403
+//   - target user is missing or not in the org           -> 404
+//   - otherwise removes all memberships of the user in the org's projects -> 204
+func (s *server) removeOrgUser(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	caller, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if caller == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	orgID := r.PathValue("orgID")
+	if caller.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	if !caller.OrgAdmin {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	target, err := findUser(ctx, s.db, r.PathValue("uid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if target == nil || target.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	if _, err := s.db.ExecContext(ctx,
+		`DELETE FROM memberships
+		 WHERE user_id = ?
+		   AND project_id IN (SELECT id FROM projects WHERE org_id = ?)`,
+		target.ID, orgID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	w.WriteHeader(204)
+}
diff --git a/org_test.go b/org_test.go
