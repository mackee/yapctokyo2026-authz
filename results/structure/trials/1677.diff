+
+// OrgExists reports whether the organization exists. Organizations have no
+// table of their own: one exists when at least one user belongs to it.
+func (*UserTable) OrgExists(ctx context.Context, db DB, orgID string) (bool, error) {
+	var ok bool
+	if err := db.QueryRowContext(ctx, `SELECT EXISTS (SELECT 1 FROM users WHERE org_id = ?)`, orgID).
+		Scan(&ok); err != nil {
+		return false, err
+	}
+	return ok, nil
+}
+
+// UserTableTransferInput is the input of UserTable.Transfer.
+type UserTableTransferInput struct {
+	ToOrgID string
+}
+
+// Transfer moves the user, who must belong to the authorized organization, to
+// another organization. Memberships and assignments in the old organization's
+// projects are removed, and organization admin rights do not carry over.
+func (t *UserTable) Transfer(ctx context.Context, db DB, authz OrgAuthz, userID string, in UserTableTransferInput) (*User, error) {
+	if err := authz.CanTransfer(); err != nil {
+		return nil, err
+	}
+	if in.ToOrgID == "" {
+		return nil, deny(ErrInvalid, "toOrgId must not be empty")
+	}
+	var u *User
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadTransferUser(ctx, tx, authz.Org(), userID, in.ToOrgID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		u, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return u, nil
+}
