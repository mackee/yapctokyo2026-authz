+// setMemberRoleAggregate changes the role of one member of one project.
+type setMemberRoleAggregate struct {
+	membership *Membership
+	assigned   []*Task // the member's tasks in the project
+	in         MembershipTableSetRoleInput
+}
+
+func loadSetMemberRole(ctx context.Context, tx DB, projectID, userID string, in MembershipTableSetRoleInput) (*setMemberRoleAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &setMemberRoleAggregate{membership: m, in: in}
+	if !isWriterRole(in.Role) {
+		a.assigned, err = m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+	}
+	return a, nil
+}
+
+func (a *setMemberRoleAggregate) validate() error {
+	// An assignee must be a contributor or manager of the task's project, so a
+	// member who still has assigned tasks cannot become a viewer.
+	if !isWriterRole(a.in.Role) && len(a.assigned) > 0 {
+		return deny(ErrInvalid, "member has assigned tasks; reassign or unassign them before making them a viewer")
+	}
+	return nil
+}
+
+func (a *setMemberRoleAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.membership.changeRole(ctx, tx, a.in.Role); err != nil {
+		return nil, err
+	}
+	return a.membership, nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
