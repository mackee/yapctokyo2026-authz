 import "context"
 
-// MembershipTable reads the memberships table.
+// MembershipTable is the memberships table.
+//
+// Find and List* read rows. SetRole is the API operation: it takes the
+// database, the project's authorization object and an input; it asks the
+// authorization object whether the actor may change member roles, then runs
+// its aggregate (aggregate.go) in a transaction.
 type MembershipTable struct{}
 
 // NewMembershipTable returns the memberships table.
 func NewMembershipTable() *MembershipTable { return &MembershipTable{} }
 
+// MembershipTableSetRoleInput is the input of MembershipTable.SetRole.
+type MembershipTableSetRoleInput struct {
+	Role string
+}
+
+var validRoles = map[string]bool{RoleManager: true, RoleContributor: true, RoleViewer: true}
+
+// SetRole changes the role of a member of the project, all or nothing.
+func (*MembershipTable) SetRole(ctx context.Context, db DB, authz ProjectAuthz, userID string, in MembershipTableSetRoleInput) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if !validRoles[in.Role] {
+		return nil, deny(ErrInvalid, "invalid role")
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadSetMemberRole(ctx, tx, authz.ProjectID(), userID, in)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if m, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
+
 // Find returns the membership of the user in the project, or ErrNoRows.
 func (*MembershipTable) Find(ctx context.Context, db DB, projectID, userID string) (*Membership, error) {
 	var m Membership
