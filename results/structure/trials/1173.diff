+func TestUpdateMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager changes", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"manager demotes other manager", "ann", "/projects/web/members/ivy", `{"role":"viewer"}`, 200},
+		{"manager demotes self with another manager", "ann", "/projects/web/members/ann", `{"role":"viewer"}`, 200},
+		{"last manager", "ivy", "/projects/ops/members/ivy", `{"role":"contributor"}`, 409},
+		{"contributor", "ben", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"viewer", "dan", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"org admin", "eve", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"non member", "hal", "/projects/web/members/dan", `{"role":"contributor"}`, 404},
+		{"cross org", "gus", "/projects/web/members/dan", `{"role":"contributor"}`, 404},
+		{"anonymous", "", "/projects/web/members/dan", `{"role":"contributor"}`, 401},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"bad role", "ann", "/projects/web/members/dan", `{"role":"owner"}`, 400},
+		{"empty body", "ann", "/projects/web/members/dan", ``, 400},
+		{"target not member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRoleEffects(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got map[string]string
+	json.Unmarshal([]byte(body), &got)
+	if got["userId"] != "ben" || got["role"] != "viewer" {
+		t.Fatalf("bad response %v", got)
+	}
+	// ben can no longer write...
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Fatalf("demoted user can still write: %d", code)
+	}
+	// ...and is unassigned from their tasks.
+	_, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" {
+		t.Fatalf("task still assigned to %q", task.Assignee)
+	}
+	// Promotion takes effect too.
+	if code, _ := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`); code != 200 {
+		t.Fatal(code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("promoted user cannot write: %d", code)
+	}
+}
