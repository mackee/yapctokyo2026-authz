+// moveMemberAggregate moves one member from the source project to the target
+// project, keeping the role.
+type moveMemberAggregate struct {
+	from     *Membership  // the member in the source project
+	to       ProjectAuthz // the actor's authorization in the target project
+	existing *Membership  // the member's membership in the target project, if any
+}
+
+func loadMoveMember(ctx context.Context, tx DB, source ProjectAuthz, in MembershipTableMoveInput) (*moveMemberAggregate, error) {
+	from, err := NewMembershipTable().Find(ctx, tx, source.ProjectID(), in.UserID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if in.ToProjectID == source.ProjectID() {
+		return nil, deny(ErrInvalid, "member is already in the project")
+	}
+	to, err := NewProjectAuthz(ctx, tx, source.Actor(), in.ToProjectID)
+	if err != nil {
+		return nil, err
+	}
+	if err := to.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	existing, err := NewMembershipTable().Find(ctx, tx, in.ToProjectID, in.UserID)
+	if errors.Is(err, ErrNoRows) {
+		existing = nil
+	} else if err != nil {
+		return nil, err
+	}
+	return &moveMemberAggregate{from: from, to: to, existing: existing}, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.existing != nil {
+		return deny(ErrConflict, "member is already in the target project")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	// An assignee must be a member of the task's project, so the member's
+	// tasks in the old project are unassigned before they leave it.
+	assigned, err := a.from.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, t := range assigned {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.from.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	to := &Membership{ProjectID: a.to.ProjectID(), UserID: a.from.UserID, Role: a.from.Role}
+	if err := to.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return to, nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
