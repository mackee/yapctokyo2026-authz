+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager of both moves", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 200},
+		{"manager of source, viewer of target", "ann", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"contributor caller", "ben", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer caller", "dan", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin caller", "eve", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 403},
+		{"non member caller", "hal", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 401},
+		{"unknown source project", "ivy", "/projects/missing/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"source archived", "ann", "/projects/legacy/members/ben/move", `{"toProjectId":"ops"}`, 409},
+		{"target archived", "ann", "/projects/web/members/cat/move", `{"toProjectId":"legacy"}`, 409},
+		{"not a member of source", "ivy", "/projects/web/members/hal/move", `{"toProjectId":"ops"}`, 404},
+		{"same project", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"web"}`, 400},
+		{"already in target", "ivy", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 409},
+		{"target in other org", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"gx"}`, 404},
+		{"target missing", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"missing"}`, 404},
+		{"missing toProjectId", "ivy", "/projects/web/members/ben/move", `{}`, 400},
+		{"malformed body", "ivy", "/projects/web/members/ben/move", `{`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveResponseAndEffects(t *testing.T) {
+	h := newServer()
+
+	code, body := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d want 200 (%s)", code, body)
+	}
+	var got struct {
+		UserID    string `json:"userId"`
+		ProjectID string `json:"projectId"`
+		Role      string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.UserID != "ben" || got.ProjectID != "ops" || got.Role != "contributor" {
+		t.Fatalf("response %+v, want ben/ops/contributor", got)
+	}
+
+	// ben has left web ...
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads web after move: got %d want 404", code)
+	}
+	// ... and joined ops with the same role.
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben reads ops after move: got %d want 200", code)
+	}
+	// ben's task in web is unassigned (an assignee must be a member of the project).
+	code, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("get t1: got %d want 200", code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "" {
+		t.Fatalf("t1 assignee %q after move, want unassigned", task.AssigneeID)
+	}
+	// Tasks of other members are untouched.
+	code, body = do(t, h, "GET", "/projects/web/tasks/t2", "ann", "")
+	if code != 200 || !strings.Contains(body, `"assignee":"cat"`) {
+		t.Fatalf("t2 after move: got %d %s, want cat still assigned", code, body)
+	}
+}
