+func TestFreeze(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeEffects(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got []map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 5 {
+		t.Fatalf("want 5 members, got %v", got)
+	}
+	for _, m := range got {
+		if len(m) != 2 || m["role"] != "viewer" || m["userId"] == "" {
+			t.Fatalf("bad member %v", m)
+		}
+	}
+
+	// Nobody can change tasks any more, managers included.
+	for _, user := range []string{"ann", "ivy", "ben", "cat", "dan"} {
+		if code, _ := do(t, h, "POST", "/projects/web/tasks", user, `{"title":"x"}`); code != 403 {
+			t.Errorf("%s create: got %d want 403", user, code)
+		}
+		if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", user, `{"status":"done"}`); code != 403 {
+			t.Errorf("%s update: got %d want 403", user, code)
+		}
+		if code, _ := do(t, h, "DELETE", "/projects/web/tasks/t1", user, ""); code != 403 {
+			t.Errorf("%s delete: got %d want 403", user, code)
+		}
+		if code, _ := do(t, h, "GET", "/projects/web/tasks", user, ""); code != 200 {
+			t.Errorf("%s list: got %d want 200", user, code)
+		}
+	}
+	// The former manager can no longer freeze again; other projects are untouched.
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 403 {
+		t.Errorf("refreeze: got %d want 403", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/ops/tasks", "ivy", `{"title":"x"}`); code != 200 {
+		t.Errorf("other project: got %d want 200", code)
+	}
+}
