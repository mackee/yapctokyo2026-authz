+// Move moves the user from the project of authz to the project of target, with
+// the same role, and returns the new membership. The actor must be a manager of
+// both projects, neither archived. All or nothing.
+func (*MembershipTable) Move(ctx context.Context, db DB, authz, target ProjectAuthz, userID string) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if err := target.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveMember(ctx, tx, authz.ProjectID(), userID, target.ProjectID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if m, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
