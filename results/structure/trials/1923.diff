+func TestMoveMember(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got struct{ UserID, ProjectID, Role string }
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.UserID != "ben" || got.ProjectID != "ops" || got.Role != "contributor" {
+		t.Fatalf("unexpected response %s", body)
+	}
+	if !strings.Contains(body, `"userId"`) || !strings.Contains(body, `"projectId"`) || !strings.Contains(body, `"role"`) {
+		t.Fatalf("response keys: %s", body)
+	}
+	if r := memberRole(t, h, "web", "ben"); r != "" {
+		t.Fatalf("ben still in web as %s", r)
+	}
+	if r := memberRole(t, h, "ops", "ben"); r != "contributor" {
+		t.Fatalf("ben role in ops = %q", r)
+	}
+	// ben's other membership is untouched.
+	if r := memberRole(t, h, "legacy", "ben"); r != "contributor" {
+		t.Fatalf("ben role in legacy = %q", r)
+	}
+	// t1 (web) was assigned to ben, who is no longer a member: it is unassigned.
+	if a := taskAssignee(t, h, "t1"); a != "" {
+		t.Fatalf("t1 assignee = %q, want unassigned", a)
+	}
+}
+
