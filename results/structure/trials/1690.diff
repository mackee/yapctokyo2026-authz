+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager moves", "ivy", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 200},
+		{"manager moves unassigned", "ann", "/projects/web/tasks/t3", `{"toProjectId":"legacy"}`, 409},
+		{"manager moves unassigned ok", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 200},
+		{"anonymous", "", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 401},
+		{"contributor own task", "cat", "/projects/ops/tasks/t4", `{"toProjectId":"web"}`, 403},
+		{"viewer", "dan", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 403},
+		{"org admin", "eve", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 403},
+		{"non member source", "hal", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 404},
+		{"other org source", "gus", "/projects/web/tasks/t2", `{"toProjectId":"gx"}`, 404},
+		{"cross project task id", "ann", "/projects/web/tasks/t4", `{"toProjectId":"ops"}`, 404},
+		{"archived source", "ann", "/projects/legacy/tasks/t5", `{"toProjectId":"web"}`, 409},
+		{"archived destination", "ann", "/projects/web/tasks/t3", `{"toProjectId":"legacy"}`, 409},
+		{"destination not readable", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"legacy"}`, 404},
+		{"destination other org", "ann", "/projects/web/tasks/t3", `{"toProjectId":"gx"}`, 404},
+		{"destination missing", "ann", "/projects/web/tasks/t3", `{"toProjectId":"nope"}`, 404},
+		{"destination read only", "ann", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 403},
+		{"assignee not in destination", "ivy", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 400},
+		{"same project", "ann", "/projects/web/tasks/t3", `{"toProjectId":"web"}`, 400},
+		{"missing target", "ann", "/projects/web/tasks/t3", `{}`, 400},
+		{"bad body", "ann", "/projects/web/tasks/t3", `nope`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestMoveResult(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got Task
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", Assignee: "cat"}
+	if got != want {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t2", "ivy", ""); code != 404 {
+		t.Fatalf("old location: got %d want 404", code)
+	}
+	code, body = do(t, h, "GET", "/projects/ops/tasks/t2", "ivy", "")
+	if code != 200 {
+		t.Fatalf("new location: got %d", code)
+	}
+	var again Task
+	json.Unmarshal([]byte(body), &again)
+	if again != want {
+		t.Fatalf("persisted %+v want %+v", again, want)
+	}
+}
+
+func TestMoveFailureLeavesTask(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/tasks/t1/move", "ivy", `{"toProjectId":"ops"}`); code != 400 {
+		t.Fatal(code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t1", "ivy", ""); code != 200 {
+		t.Fatalf("task left web: %d", code)
+	}
+}
