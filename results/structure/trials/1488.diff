+// Move moves the task from its project (authz) to the project of to. The actor
+// must be able to edit the task in its project and to write in the target
+// project; the target must be readable (ErrNotFound otherwise). The task keeps
+// its ID, title, status and assignee, so the assignee must be a contributor or
+// manager of the target project.
+func (*TaskTable) Move(ctx context.Context, db DB, authz TaskAuthz, to ProjectAuthz) (*Task, error) {
+	if err := authz.CanEdit(); err != nil {
+		return nil, err
+	}
+	if err := to.CanWrite(); err != nil {
+		return nil, err
+	}
+	if to.ProjectID() == authz.Project().ProjectID() {
+		return nil, deny(ErrInvalid, "task is already in the project")
+	}
+	var t *Task
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveTask(ctx, tx, authz.TaskID(), to.ProjectID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if t, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return t, nil
+}
