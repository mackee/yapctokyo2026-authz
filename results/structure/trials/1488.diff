+
+// moveTask moves the task to another project. The actor must be allowed to edit
+// the task before the target is looked up, so a denied move does not reveal
+// whether the target project exists. An unreadable target is 404.
+func moveTask(ctx tanukirpc.Context[*taskRegistry], req moveRequest) (*Task, error) {
+	reg := ctx.Registry()
+	if err := reg.authz.CanEdit(); err != nil {
+		return nil, err
+	}
+	to, err := model.NewProjectAuthz(ctx, reg.db, reg.authz.Project().Actor(), req.ToProjectID)
+	if err != nil {
+		return nil, err
+	}
+	return model.NewTaskTable().Move(ctx, reg.db, reg.authz, to)
+}
