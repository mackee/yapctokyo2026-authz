+type moveRequest struct {
+	ToProjectID string `json:"toProjectId"`
+}
+
+type moveResponse struct {
+	UserID    string `json:"userId"`
+	ProjectID string `json:"projectId"`
+	Role      string `json:"role"`
+}
+
+// moveMember moves a member to another project, keeping the role. The caller
+// must be a manager of both projects. Tasks of the moved user in the source
+// project become unassigned. Mirrors moveOutcome/moveMember in spec/taskboard.qnt.
+func (s *server) moveMember(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	// readable reports whether the user can read the project (not found, other
+	// org and not a member all look the same).
+	readable := func(id string) (*project, string, bool, error) {
+		p, err := findProject(ctx, s.db, id)
+		if err != nil || p == nil || p.OrgID != user.OrgID {
+			return nil, "", false, err
+		}
+		role, err := findRole(ctx, s.db, p.ID, user.ID)
+		if err != nil || (role == "" && !user.OrgAdmin) {
+			return nil, "", false, err
+		}
+		return p, role, true, nil
+	}
+	src, role, ok, err := readable(r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if !ok {
+		writeError(w, 404, "not found")
+		return
+	}
+	memberID := r.PathValue("uid")
+	memberRole, err := findRole(ctx, s.db, src.ID, memberID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if memberRole == "" {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if src.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req moveRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	dest, destRole, ok, err := readable(req.ToProjectID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if !ok {
+		writeError(w, 404, "not found")
+		return
+	}
+	if destRole != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if dest.ID == src.ID {
+		writeError(w, 400, "destination must be a different project")
+		return
+	}
+	if dest.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	existing, err := findRole(ctx, s.db, dest.ID, memberID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if existing != "" {
+		writeError(w, 409, "user is already a member of the destination project")
+		return
+	}
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+	if _, err := tx.ExecContext(ctx, `DELETE FROM memberships WHERE project_id = ? AND user_id = ?`, src.ID, memberID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if _, err := tx.ExecContext(ctx, `INSERT INTO memberships (project_id, user_id, role) VALUES (?, ?, ?)`, dest.ID, memberID, memberRole); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if _, err := tx.ExecContext(ctx, `UPDATE tasks SET assignee = '' WHERE project_id = ? AND assignee = ?`, src.ID, memberID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, moveResponse{UserID: memberID, ProjectID: dest.ID, Role: memberRole})
+}
