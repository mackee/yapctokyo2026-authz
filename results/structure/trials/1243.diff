+// moveMemberAggregate moves one member of the source project to the target
+// project, keeping the role.
+type moveMemberAggregate struct {
+	source       *Membership // the member in the source project
+	user         *User
+	target       *Project
+	targetMember *Membership // the member's membership in the target project; nil if none
+}
+
+func loadMoveMember(ctx context.Context, tx DB, sourceProjectID, userID, toProjectID string) (*moveMemberAggregate, error) {
+	src, err := NewMembershipTable().Find(ctx, tx, sourceProjectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "member not found")
+	} else if err != nil {
+		return nil, err
+	}
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if err != nil {
+		return nil, err
+	}
+	tgt, err := NewProjectTable().Find(ctx, tx, toProjectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveMemberAggregate{source: src, user: u, target: tgt}
+	m, err := tgt.Membership(ctx, tx, userID)
+	if err == nil {
+		a.targetMember = m
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.user.Org != a.target.Org {
+		return deny(ErrInvalid, "member must belong to the target project's organization")
+	}
+	if a.targetMember != nil {
+		return deny(ErrConflict, "already a member of the target project")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.source.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	m := &Membership{ProjectID: a.target.ID, UserID: a.user.ID, Role: a.source.Role}
+	if err := m.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
