+// MembershipTableMoveInput is the input of MembershipTable.Move.
+type MembershipTableMoveInput struct {
+	UserID      string
+	ToProjectID string
+}
+
+// Move moves a member out of the authorization object's project into another
+// project, keeping the role. The actor must be a manager of both projects, and
+// neither may be archived. The move is all or nothing.
+func (*MembershipTable) Move(ctx context.Context, db DB, authz ProjectAuthz, in MembershipTableMoveInput) (*Membership, error) {
+	if in.ToProjectID == authz.ProjectID() {
+		return nil, deny(ErrInvalid, "member is already in the project")
+	}
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	target, err := NewProjectAuthz(ctx, db, authz.Actor(), in.ToProjectID)
+	if err != nil {
+		return nil, err
+	}
+	if err := target.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveMember(ctx, tx, authz.ProjectID(), in.UserID, in.ToProjectID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		m, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
