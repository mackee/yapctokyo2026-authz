+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"contributor own task", "ben", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"viewer", "dan", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"manager into viewer project", "ann", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 403},
+		{"assignee not in destination", "ivy", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 400},
+		{"same project", "ivy", "/projects/web/tasks/t2", `{"toProjectId":"web"}`, 400},
+		{"empty destination", "ivy", "/projects/web/tasks/t2", `{"toProjectId":""}`, 400},
+		{"missing destination", "ivy", "/projects/web/tasks/t2", `{}`, 400},
+		{"archived destination", "ann", "/projects/web/tasks/t2", `{"toProjectId":"legacy"}`, 409},
+		{"archived source", "ann", "/projects/legacy/tasks/t5", `{"toProjectId":"web"}`, 409},
+		{"unknown destination", "ivy", "/projects/web/tasks/t2", `{"toProjectId":"nope"}`, 404},
+		{"destination not readable", "ivy", "/projects/web/tasks/t2", `{"toProjectId":"legacy"}`, 404},
+		{"cross project id", "ivy", "/projects/ops/tasks/t1", `{"toProjectId":"web"}`, 404},
+		{"cross org destination", "gus", "/projects/gx/tasks/t6", `{"toProjectId":"web"}`, 404},
+		{"anonymous", "", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 401},
+		{"manager moves", "ivy", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsFields(t *testing.T) {
+	srv := newServer()
+	code, body := do(t, srv, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var moved Task
+	if err := json.Unmarshal([]byte(body), &moved); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", AssigneeID: "cat"}
+	if moved != want {
+		t.Fatalf("moved task = %+v, want %+v", moved, want)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks/t2", "ivy", ""); code != 404 {
+		t.Fatalf("old project still serves task: got %d", code)
+	}
+	code, body = do(t, srv, "GET", "/projects/ops/tasks/t2", "ivy", "")
+	if code != 200 {
+		t.Fatalf("new project: got %d body=%s", code, body)
+	}
+}
