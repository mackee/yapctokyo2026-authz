+func TestFreeze(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"manager of another project", "ivy", "ops", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"unknown project", "ann", "nope", 404},
+		{"archived", "ann", "legacy", 409},
+		{"anonymous", "", "web", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got []struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("decode %q: %v", body, err)
+	}
+	// web members in seed data: ann (manager), ben, cat (contributors), dan (viewer), ivy (manager).
+	want := []struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}{
+		{"ann", "viewer"}, {"ben", "viewer"}, {"cat", "viewer"}, {"dan", "viewer"}, {"ivy", "viewer"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %d members, want %d: %s", len(got), len(want), body)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("member %d: got %+v want %+v", i, got[i], want[i])
+		}
+	}
+}
+
+func TestFreezeBlocksTaskWrites(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d: %s", code, body)
+	}
+
+	cases := []struct {
+		name, method, path, user, body string
+		want                           int
+	}{
+		{"contributor own task", "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`, 403},
+		{"contributor other task", "PATCH", "/projects/web/tasks/t2", "cat", `{"status":"done"}`, 403},
+		{"manager edit", "PATCH", "/projects/web/tasks/t2", "ann", `{"status":"done"}`, 403},
+		{"manager reassign", "PATCH", "/projects/web/tasks/t2", "ivy", `{"assignee":"ben"}`, 403},
+		{"manager delete", "DELETE", "/projects/web/tasks/t1", "ann", "", 403},
+		{"contributor create", "POST", "/projects/web/tasks", "ben", `{"title":"x"}`, 403},
+		{"manager create", "POST", "/projects/web/tasks", "ivy", `{"title":"x"}`, 403},
+		{"second freeze", "POST", "/projects/web/freeze", "ann", "", 403},
+		{"read still works", "GET", "/projects/web/tasks/t1", "ben", "", 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, srv, c.method, c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+		})
+	}
+
+	// Nothing changed: t1 is still open and assigned to ben.
+	_, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.Status != "open" || task.Assignee != "ben" {
+		t.Fatalf("task changed after freeze: %+v", task)
+	}
+}
+
+func TestFreezeLeavesOtherProjectsWritable(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d: %s", code, body)
+	}
+	// ivy was a manager of web and is now a viewer there, but still a manager of ops.
+	if code, body := do(t, srv, "PATCH", "/projects/ops/tasks/t4", "ivy", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ops write: got %d: %s", code, body)
+	}
+	if code, _ := do(t, srv, "PATCH", "/projects/web/tasks/t2", "ivy", `{"status":"done"}`); code != 403 {
+		t.Fatalf("web write: got %d want 403", code)
+	}
+}
