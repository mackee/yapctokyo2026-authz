+// ManageProject is the manager-only capability for one project.
+type ManageProject interface {
+	ID() string
+	// Freeze sets every member of the project to viewer, managers included.
+	// Viewers cannot write, so no task in the project can be changed
+	// afterwards. It returns the members after the change, sorted by user ID.
+	// Once frozen nobody is a manager, so a second freeze is 403.
+	Freeze() ([]MemberView, error)
+}
+
+type manageProject struct {
+	ps *projectScope
+}
+
+func (p *manageProject) ID() string { return p.ps.pid }
+
+func (p *manageProject) Freeze() ([]MemberView, error) {
+	var out []MemberView
+	err := p.ps.as.a.db.update(func(x *tx) error {
+		agg, err := loadFreezeProject(x, p.ps.pid)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		members := agg.save(x)
+		out = make([]MemberView, 0, len(members))
+		for _, m := range members {
+			out = append(out, MemberView{UserID: m.UserID, Role: m.Role})
+		}
+		return nil
+	})
+	return out, err
+}
+
