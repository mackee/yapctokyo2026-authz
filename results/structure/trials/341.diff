+// freezeProjectAggregate sets every member of one project to viewer.
+type freezeProjectAggregate struct {
+	members []membershipRecord
+}
+
+func loadFreezeProject(x *tx, projectID string) (*freezeProjectAggregate, error) {
+	if _, ok := x.findProject(projectID); !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	return &freezeProjectAggregate{members: x.membershipsOf(projectID)}, nil
+}
+
+// validate: viewer is a valid project role, so there is nothing to check.
+func (a *freezeProjectAggregate) validate() error { return nil }
+
+func (a *freezeProjectAggregate) save(x *tx) []membershipRecord {
+	for i := range a.members {
+		a.members[i].Role = RoleViewer
+		a.members[i].save(x)
+	}
+	return a.members
+}
+
