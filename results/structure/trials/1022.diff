+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ann", 204},
+		{"manager not admin", "ann", "/orgs/acme/users/ben", 403},
+		{"contributor", "ben", "/orgs/acme/users/cat", 403},
+		{"anonymous", "", "/orgs/acme/users/ann", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ann", 401},
+		{"other org caller", "gus", "/orgs/acme/users/ann", 404},
+		{"admin of other org path", "eve", "/orgs/globex/users/gus", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserRemovesAllMemberships(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "GET", "/projects/legacy/tasks", "ann", ""); code != 200 {
+		t.Fatalf("precondition: got %d", code)
+	}
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ann", "eve", ""); code != 204 {
+		t.Fatalf("got %d", code)
+	}
+	for _, p := range []string{"web", "ops", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ann", ""); code != 404 {
+			t.Fatalf("project %s: got %d want 404", p, code)
+		}
+	}
+	// other members are untouched
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben lost access: %d", code)
+	}
+}
