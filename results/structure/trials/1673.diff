+// transferUserAggregate moves one user to another organization.
+type transferUserAggregate struct {
+	user  *User
+	toOrg string
+	// memberships of the user in projects of the user's current organization.
+	// They must be empty: a project's members belong to the project's organization.
+	oldOrgMemberships []*Membership
+}
+
+func loadTransferUser(ctx context.Context, tx DB, fromOrg, userID, toOrg string) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != fromOrg {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	a := &transferUserAggregate{user: u, toOrg: toOrg}
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, m := range ms {
+		p, err := m.Project(ctx, tx)
+		if errors.Is(err, ErrNoRows) {
+			continue
+		} else if err != nil {
+			return nil, err
+		}
+		if p.Org == u.Org {
+			a.oldOrgMemberships = append(a.oldOrgMemberships, m)
+		}
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if a.toOrg == a.user.Org {
+		return deny(ErrInvalid, "user already belongs to that organization")
+	}
+	if len(a.oldOrgMemberships) > 0 {
+		return deny(ErrInvalid, "user is still a member of projects in the current organization")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	if err := a.user.transferTo(ctx, tx, a.toOrg); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
