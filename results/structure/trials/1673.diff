+// Seed facts used below: hal is an acme user with no memberships; ben has
+// memberships in acme projects; eve is an acme org admin; gus is a globex user.
+
+func TestTransferUser(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin transfers user without memberships", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 200},
+		{"user still in projects of old org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 400},
+		{"same org", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"acme"}`, 400},
+		{"missing target", "eve", "/orgs/acme/users/hal/transfer", `{}`, 400},
+		{"empty target", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":""}`, 400},
+		{"malformed body", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":`, 400},
+		{"manager is not org admin", "ann", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 403},
+		{"contributor is not org admin", "ben", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 403},
+		{"caller in another org", "gus", "/orgs/acme/users/hal/transfer", `{"toOrgId":"acme"}`, 404},
+		{"path org is not caller's org", "eve", "/orgs/globex/users/hal/transfer", `{"toOrgId":"acme"}`, 404},
+		{"user in another org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"anonymous", "", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/hal/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got map[string]any
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 2 || got["id"] != "hal" || got["orgId"] != "globex" {
+		t.Fatalf("got body %s, want {\"id\":\"hal\",\"orgId\":\"globex\"}", body)
+	}
+}
+
+func TestTransferEffects(t *testing.T) {
+	t.Run("transferred user leaves the old org", func(t *testing.T) {
+		srv := newServer()
+		if code, _ := do(t, srv, "POST", "/orgs/acme/users/hal/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+			t.Fatalf("transfer got %d want 200", code)
+		}
+		if code, _ := do(t, srv, "POST", "/orgs/acme/users/hal/transfer", "eve", `{"toOrgId":"globex"}`); code != 404 {
+			t.Fatalf("second transfer from acme got %d want 404", code)
+		}
+	})
+
+	t.Run("org admin flag is not carried to the new org", func(t *testing.T) {
+		srv := newServer()
+		if code, _ := do(t, srv, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+			t.Fatalf("transfer got %d want 200", code)
+		}
+		// gx is a globex project eve is not a member of; as a globex org admin she could read it.
+		if code, _ := do(t, srv, "GET", "/projects/gx/tasks", "eve", ""); code != 404 {
+			t.Fatalf("read gx got %d want 404", code)
+		}
+	})
+
+	t.Run("a rejected transfer changes nothing", func(t *testing.T) {
+		srv := newServer()
+		if code, _ := do(t, srv, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 400 {
+			t.Fatalf("transfer got %d want 400", code)
+		}
+		if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+			t.Fatalf("ben reads web got %d want 200", code)
+		}
+	})
+}
