+
+type moveRequest struct {
+	ToProjectID string `json:"toProjectId"`
+}
+
+// moveMember removes a member from the path project and adds them to the
+// destination project with the same role. The caller must be a manager of both.
+func (s *server) moveMember(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role, err := findRole(ctx, s.db, project.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req moveRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || req.ToProjectID == "" {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	if req.ToProjectID == project.ID {
+		writeError(w, 400, "destination must be a different project")
+		return
+	}
+	dest, err := findProject(ctx, s.db, req.ToProjectID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if dest == nil || dest.OrgID != user.OrgID {
+		writeError(w, 404, "destination project not found")
+		return
+	}
+	destRole, err := findRole(ctx, s.db, dest.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if destRole != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if dest.Archived {
+		writeError(w, 409, "destination project is archived")
+		return
+	}
+	memberID := r.PathValue("uid")
+	memberRole, err := findRole(ctx, s.db, project.ID, memberID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if memberRole == "" {
+		writeError(w, 404, "member not found")
+		return
+	}
+	existing, err := findRole(ctx, s.db, dest.ID, memberID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if existing != "" {
+		writeError(w, 409, "user is already a member of the destination project")
+		return
+	}
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+	if _, err := tx.ExecContext(ctx, `DELETE FROM memberships WHERE project_id = ? AND user_id = ?`, project.ID, memberID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if _, err := tx.ExecContext(ctx, `INSERT INTO memberships (project_id, user_id, role) VALUES (?, ?, ?)`, dest.ID, memberID, memberRole); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, map[string]string{"userId": memberID, "projectId": dest.ID, "role": memberRole})
+}
diff --git a/move_test.go b/move_test.go
new file mode 100644
index 0000000..93f473e
--- /dev/null
+++ b/move_test.go
@@ -0,0 +1,109 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"testing"
+)
+
+// POST /projects/{pid}/members/{uid}/move  {"toProjectId": "..."}
+//
+// Removes the user from the path project and adds them to the destination
+// project with the same role. The caller must be a manager of both projects.
+
+func TestMoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager of both moves contributor", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 200},
+		{"manager of both moves viewer", "ivy", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 200},
+		{"contributor caller", "ben", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer caller", "dan", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"manager of source only", "ann", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin caller", "eve", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"non member caller", "hal", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"other org caller", "gus", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 401},
+		{"unknown caller", "zed", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 401},
+		{"user not in source", "ivy", "/projects/web/members/hal/move", `{"toProjectId":"ops"}`, 404},
+		{"user already in destination", "ivy", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 409},
+		{"destination missing", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"nope"}`, 404},
+		{"destination in other org", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"gx"}`, 404},
+		{"same project", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"web"}`, 400},
+		{"empty destination", "ivy", "/projects/web/members/ben/move", `{"toProjectId":""}`, 400},
+		{"invalid body", "ivy", "/projects/web/members/ben/move", `not json`, 400},
+		{"archived destination", "ann", "/projects/web/members/cat/move", `{"toProjectId":"legacy"}`, 409},
+		{"archived source", "ann", "/projects/legacy/members/ben/move", `{"toProjectId":"web"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveResponseBody(t *testing.T) {
+	cases := []struct {
+		name, path, body string
+		want             map[string]string
+	}{
+		{"contributor keeps role", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`,
+			map[string]string{"userId": "ben", "projectId": "ops", "role": "contributor"}},
+		{"viewer keeps role", "/projects/web/members/dan/move", `{"toProjectId":"ops"}`,
+			map[string]string{"userId": "dan", "projectId": "ops", "role": "viewer"}},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, "ivy", c.body)
+			if code != http.StatusOK {
+				t.Fatalf("got %d want 200 (body %s)", code, body)
+			}
+			var got map[string]string
+			if err := json.Unmarshal([]byte(body), &got); err != nil {
+				t.Fatalf("invalid JSON %q: %v", body, err)
+			}
+			if len(got) != len(c.want) {
+				t.Fatalf("got fields %v want %v", got, c.want)
+			}
+			for k, v := range c.want {
+				if got[k] != v {
+					t.Fatalf("field %s: got %q want %q (body %s)", k, got[k], v, body)
+				}
+			}
+		})
+	}
+}
+
+func TestMoveChangesMembership(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`); code != 200 {
+		t.Fatalf("move: got %d want 200 (body %s)", code, body)
+	}
+	// ben is no longer a member of web, so web is not readable by ben.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reading web after move: got %d want 404", code)
+	}
+	// ben is now a member of ops, so ops is readable by ben.
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben reading ops after move: got %d want 200", code)
+	}
+	// Other members of web are untouched.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat reading web after move: got %d want 200", code)
+	}
+}
+
+func TestMoveFailureLeavesMembershipUnchanged(t *testing.T) {
+	h := newServer()
+	// cat is already in ops, so the move is refused as a conflict.
+	if code, _ := do(t, h, "POST", "/projects/web/members/cat/move", "ivy", `{"toProjectId":"ops"}`); code != 409 {
+		t.Fatalf("move: got %d want 409", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat lost web membership after refused move: got %d want 200", code)
+	}
+}
