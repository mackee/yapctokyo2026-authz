+// CanMove returns nil if the actor may move the task to the destination
+// project: manager in both projects (else ErrForbidden) and neither archived
+// (else ErrArchived).
+func (a TaskAuthz) CanMove(dest ProjectAuthz) error {
+	if !a.CanRead() || !dest.CanRead() || a.project.role != RoleManager || dest.role != RoleManager {
+		return deny(ErrForbidden, "only managers of both projects may move tasks")
+	}
+	if a.project.archived || dest.archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	return nil
+}
