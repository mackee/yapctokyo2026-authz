+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"admin removes", "eve", "/orgs/acme/users/ann", 204},
+		{"non admin", "ann", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"other org caller", "gus", "/orgs/acme/users/ben", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserRevokesAccess(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ann", "eve", ""); code != 204 {
+		t.Fatalf("got %d", code)
+	}
+	// ann can no longer authenticate or act.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ann", ""); code != 401 {
+		t.Fatalf("removed user got %d want 401", code)
+	}
+	// other members keep access.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("other member got %d want 200", code)
+	}
+	// repeating the removal is a 404.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ann", "eve", ""); code != 404 {
+		t.Fatalf("repeat got %d want 404", code)
+	}
+}
+
+func TestRemoveOrgUserDropsMemberships(t *testing.T) {
+	s := &server{}
+	db, err := openSeededDB()
+	if err != nil {
+		t.Fatal(err)
+	}
+	s.db = db
+	mux := http.NewServeMux()
+	mux.HandleFunc("DELETE /orgs/{orgID}/users/{uid}", s.removeOrgUser)
+	if code, _ := do(t, mux, "DELETE", "/orgs/acme/users/ann", "eve", ""); code != 204 {
+		t.Fatalf("got %d", code)
+	}
+	var n int
+	if err := db.QueryRow(`SELECT COUNT(*) FROM memberships WHERE user_id = 'ann'`).Scan(&n); err != nil {
+		t.Fatal(err)
+	}
+	if n != 0 {
+		t.Fatalf("ann still has %d memberships", n)
+	}
+	if err := db.QueryRow(`SELECT COUNT(*) FROM memberships WHERE user_id = 'ben'`).Scan(&n); err != nil {
+		t.Fatal(err)
+	}
+	if n != 2 {
+		t.Fatalf("ben should keep 2 memberships, has %d", n)
+	}
+}
