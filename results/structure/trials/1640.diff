+
+type Member struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+type updateMembersRequest struct {
+	Roles map[string]string `json:"roles"`
+}
+
+func validRole(role string) bool {
+	return role == RoleManager || role == RoleContributor || role == RoleViewer
+}
+
+// updateMembers changes several members' roles at once. Either every change
+// applies or none does. On success it returns the project's full member list.
+func (s *server) updateMembers(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role, err := findRole(ctx, s.db, project.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "only managers may change member roles")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req updateMembersRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || len(req.Roles) == 0 {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	for _, newRole := range req.Roles {
+		if !validRole(newRole) {
+			writeError(w, 400, "invalid role")
+			return
+		}
+	}
+
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+	for userID, newRole := range req.Roles {
+		var current string
+		err := tx.QueryRowContext(ctx, `SELECT role FROM memberships WHERE project_id = ? AND user_id = ?`, project.ID, userID).Scan(&current)
+		if errors.Is(err, sql.ErrNoRows) {
+			writeError(w, 400, "user is not a member of the project: "+userID)
+			return
+		}
+		if err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+		if _, err := tx.ExecContext(ctx, `UPDATE memberships SET role = ? WHERE project_id = ? AND user_id = ?`, newRole, project.ID, userID); err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+	}
+	rows, err := tx.QueryContext(ctx, `SELECT user_id, role FROM memberships WHERE project_id = ? ORDER BY user_id`, project.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	members := []Member{}
+	for rows.Next() {
+		var m Member
+		if err := rows.Scan(&m.UserID, &m.Role); err != nil {
+			rows.Close()
+			writeError(w, 500, "internal error")
+			return
+		}
+		members = append(members, m)
+	}
+	rows.Close()
+	if err := rows.Err(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, members)
+}
diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..da4b3f3
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,125 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"reflect"
+	"testing"
+)
+
+type memberJSON struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// webMembersSeed is the member list of project "web" in the seed data, sorted by userId.
+var webMembersSeed = []memberJSON{
+	{"ann", "manager"},
+	{"ben", "contributor"},
+	{"cat", "contributor"},
+	{"dan", "viewer"},
+	{"ivy", "manager"},
+}
+
+func decodeMembers(t *testing.T, body string) []memberJSON {
+	t.Helper()
+	var got []memberJSON
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("response is not a member list: %v; body=%s", err, body)
+	}
+	return got
+}
+
+func TestUpdateMembersBulk(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann",
+		`{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != http.StatusOK {
+		t.Fatalf("got %d want 200; body=%s", code, body)
+	}
+	want := []memberJSON{
+		{"ann", "manager"},
+		{"ben", "viewer"},
+		{"cat", "contributor"},
+		{"dan", "contributor"},
+		{"ivy", "manager"},
+	}
+	if got := decodeMembers(t, body); !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+}
+
+func TestUpdateMembersPersists(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "PUT", "/projects/web/members", "ann",
+		`{"roles":{"ben":"viewer","dan":"contributor"}}`); code != http.StatusOK {
+		t.Fatalf("PUT got %d want 200; body=%s", code, body)
+	}
+	// ben is now a viewer, so may not create tasks.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != http.StatusForbidden {
+		t.Fatalf("demoted ben: got %d want 403", code)
+	}
+	// dan is now a contributor, so may create tasks.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != http.StatusOK {
+		t.Fatalf("promoted dan: got %d want 200", code)
+	}
+}
+
+func TestUpdateMembersAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"anonymous", "", "web", `{"roles":{"ben":"viewer"}}`, 401},
+		{"unknown user", "zed", "web", `{"roles":{"ben":"viewer"}}`, 401},
+		{"missing project", "ann", "nope", `{"roles":{"ben":"viewer"}}`, 404},
+		{"other org project", "gus", "web", `{"roles":{"ben":"viewer"}}`, 404},
+		{"non member", "hal", "web", `{"roles":{"ben":"viewer"}}`, 404},
+		{"contributor", "ben", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d; body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestUpdateMembersInvalidIsAllOrNothing(t *testing.T) {
+	cases := []struct {
+		name, body string
+	}{
+		{"invalid role", `{"roles":{"ben":"viewer","cat":"owner"}}`},
+		{"target not a member", `{"roles":{"ben":"viewer","hal":"manager"}}`},
+		{"target in another org", `{"roles":{"ben":"viewer","gus":"manager"}}`},
+		{"empty roles", `{"roles":{}}`},
+		{"missing roles", `{}`},
+		{"malformed json", `{"roles":`},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			code, body := do(t, h, "PUT", "/projects/web/members", "ann", c.body)
+			if code != http.StatusBadRequest {
+				t.Fatalf("got %d want 400; body=%s", code, body)
+			}
+			// Nothing may have changed: ben is still a contributor, so may still create tasks.
+			if code, body := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != http.StatusOK {
+				t.Fatalf("ben after failed update: got %d want 200; body=%s", code, body)
+			}
+			// And the member list is unchanged.
+			code, body = do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"cat":"contributor"}}`)
+			if code != http.StatusOK {
+				t.Fatalf("no-op PUT got %d want 200; body=%s", code, body)
+			}
+			if got := decodeMembers(t, body); !reflect.DeepEqual(got, webMembersSeed) {
+				t.Fatalf("members changed after failed update: got %+v want %+v", got, webMembersSeed)
+			}
+		})
+	}
+}
