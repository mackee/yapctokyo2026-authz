+// After a freeze nobody can change the project's tasks, managers included; reads
+// still work, and other projects are not affected.
+func TestFreezeBlocksWrites(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze got %d body=%s", code, body)
+	}
+	cases := []struct {
+		name, user, method, path, body string
+		want                           int
+	}{
+		{"frozen manager creates", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"frozen manager updates", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"frozen manager deletes", "ann", "DELETE", "/projects/web/tasks/t1", "", 403},
+		{"frozen contributor updates own", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`, 403},
+		{"frozen other manager creates", "ivy", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"frozen manager cannot refreeze", "ann", "POST", "/projects/web/freeze", "", 403},
+		{"frozen read still works", "dan", "GET", "/projects/web/tasks/t1", "", 200},
+		{"other project unaffected", "cat", "PATCH", "/projects/ops/tasks/t4", `{"title":"y"}`, 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, srv, c.method, c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
