+package main
+
+import "testing"
+
+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes member without projects", "eve", "/orgs/acme/users/hal", 204},
+		{"non admin", "ann", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"other org caller", "gus", "/orgs/acme/users/ben", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"target in another org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ben", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func countRows(t *testing.T, h *appHandler, query string, args ...any) int {
+	t.Helper()
+	var n int
+	if err := h.db.QueryRow(query, args...).Scan(&n); err != nil {
+		t.Fatal(err)
+	}
+	return n
+}
+
+func TestRemoveOrgUserDropsAllMemberships(t *testing.T) {
+	h := newServer()
+	// ben is in web (active) and legacy (archived).
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("got %d want 204", code)
+	}
+	app := h.(*appHandler)
+	if n := countRows(t, app, `SELECT COUNT(*) FROM memberships WHERE user_id = 'ben'`); n != 0 {
+		t.Fatalf("ben still has %d memberships", n)
+	}
+	// Other members are untouched.
+	if n := countRows(t, app, `SELECT COUNT(*) FROM memberships WHERE user_id = 'ann'`); n != 3 {
+		t.Fatalf("ann has %d memberships, want 3", n)
+	}
+	// The removed user can no longer read the projects.
+	for _, p := range []string{"web", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ben", ""); code != 404 {
+			t.Fatalf("ben reading %s: got %d want 404", p, code)
+		}
+	}
+}
+
+// Tasks assigned to the removed user must not keep pointing at a non-member
+// (model rule: an assignee is a contributor or manager of the task's project),
+// including tasks in archived projects. Tasks themselves are kept.
+func TestRemoveOrgUserUnassignsTasks(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("got %d want 204", code)
+	}
+	app := h.(*appHandler)
+	if n := countRows(t, app, `SELECT COUNT(*) FROM tasks WHERE assignee = 'ben'`); n != 0 {
+		t.Fatalf("%d tasks still assigned to ben", n)
+	}
+	for _, id := range []string{"t1", "t5"} { // web and legacy (archived)
+		if n := countRows(t, app, `SELECT COUNT(*) FROM tasks WHERE id = ? AND assignee = ''`, id); n != 1 {
+			t.Fatalf("task %s should still exist, unassigned", id)
+		}
+	}
+	// Other people's assignments are untouched.
+	if n := countRows(t, app, `SELECT COUNT(*) FROM tasks WHERE id = 't2' AND assignee = 'cat'`); n != 1 {
+		t.Fatal("t2 assignment of cat changed")
+	}
+}
+
+func TestRemoveOrgUserOtherOrgUntouched(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/gus", "eve", ""); code != 404 {
+		t.Fatalf("got %d want 404", code)
+	}
+	app := h.(*appHandler)
+	if n := countRows(t, app, `SELECT COUNT(*) FROM memberships WHERE user_id = 'gus'`); n != 1 {
+		t.Fatal("gus membership changed")
+	}
+	if n := countRows(t, app, `SELECT COUNT(*) FROM tasks WHERE assignee = 'gus'`); n != 1 {
+		t.Fatal("gus task changed")
+	}
+}
+
+func TestRemoveOrgUserDeniedChangesNothing(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "ann", ""); code != 403 {
+		t.Fatalf("got %d want 403", code)
+	}
+	app := h.(*appHandler)
+	if n := countRows(t, app, `SELECT COUNT(*) FROM memberships WHERE user_id = 'ben'`); n != 2 {
+		t.Fatal("ben memberships changed by a denied request")
+	}
+}
