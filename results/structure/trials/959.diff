+// setRolesAggregate changes the roles of several members of one project.
+type setRolesAggregate struct {
+	members  []*Membership     // the members to change, ordered by user ID
+	newRoles map[string]string // by user ID
+	assigned map[string]int    // number of tasks assigned to each member in the project
+}
+
+func loadSetRoles(ctx context.Context, tx DB, projectID string, in MembershipTableSetRolesInput) (*setRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	ids := make([]string, 0, len(in.Roles))
+	for id := range in.Roles {
+		ids = append(ids, id)
+	}
+	sort.Strings(ids)
+	a := &setRolesAggregate{newRoles: in.Roles, assigned: map[string]int{}}
+	for _, id := range ids {
+		m, err := p.Membership(ctx, tx, id)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "user "+id+" is not a member of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		tasks, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.assigned[id] = len(tasks)
+		a.members = append(a.members, m)
+	}
+	return a, nil
+}
+
+func (a *setRolesAggregate) validate() error {
+	for _, m := range a.members {
+		role := a.newRoles[m.UserID]
+		switch role {
+		case RoleManager, RoleContributor, RoleViewer:
+		default:
+			return deny(ErrInvalid, "invalid role for "+m.UserID)
+		}
+		if !isWriterRole(role) && a.assigned[m.UserID] > 0 {
+			return deny(ErrInvalid, m.UserID+" has assigned tasks and must stay a contributor or manager")
+		}
+	}
+	return nil
+}
+
+func (a *setRolesAggregate) apply(ctx context.Context, tx DB) error {
+	for _, m := range a.members {
+		if err := m.setRole(ctx, tx, a.newRoles[m.UserID]); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
