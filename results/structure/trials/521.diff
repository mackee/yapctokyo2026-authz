+package model
+
+import "context"
+
+// OrgTable answers questions about organizations. There is no organizations
+// table: an organization exists when some user or project belongs to it.
+type OrgTable struct{}
+
+// NewOrgTable returns the organizations table.
+func NewOrgTable() *OrgTable { return &OrgTable{} }
+
+// Exists reports whether an organization with the ID exists.
+func (*OrgTable) Exists(ctx context.Context, db DB, id string) (bool, error) {
+	found := false
+	if err := db.view(ctx, func(x *Tx) error {
+		for _, u := range x.t.users {
+			if u.Org == id {
+				found = true
+				return nil
+			}
+		}
+		for _, p := range x.t.projects {
+			if p.Org == id {
+				found = true
+				return nil
+			}
+		}
+		return nil
+	}); err != nil {
+		return false, err
+	}
+	return found, nil
+}
