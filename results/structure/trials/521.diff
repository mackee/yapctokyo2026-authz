+// Transfer moves the user out of the organization of the authorization object
+// into another organization (for example a sister company). Only org admins of
+// the user's current organization may do it. The user's memberships in that
+// organization's projects are removed; see transferUserAggregate.
+func (*UserTable) Transfer(ctx context.Context, db DB, authz OrgAuthz, userID string, in UserTableTransferInput) (*User, error) {
+	if err := authz.CanAdmin(); err != nil {
+		return nil, err
+	}
+	if in.ToOrgID == "" {
+		return nil, deny(ErrInvalid, "toOrgId must not be empty")
+	}
+	var u *User
+	if err := db.update(ctx, func(x *Tx) error {
+		agg, err := loadTransferUser(ctx, x, authz.OrgID(), userID, in.ToOrgID)
+		if err != nil {
+			return err
+		}
+		if u, err = agg.apply(ctx, x); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return u, nil
+}
