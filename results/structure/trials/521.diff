+// transferUserAggregate moves one user from one organization to another. The
+// user's memberships in the old organization's projects are removed, and the
+// tasks assigned to the user in those projects are unassigned, so the model
+// rules keep holding once the user is no longer in that organization.
+type transferUserAggregate struct {
+	user        *User
+	toOrg       string
+	memberships []*Membership // the user's memberships in projects of the old organization
+	tasks       []*Task       // the user's assigned tasks in projects of the old organization
+}
+
+func loadTransferUser(ctx context.Context, x *Tx, fromOrg, userID, toOrg string) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, x, userID)
+	if errors.Is(err, ErrNoRows) || (err == nil && u.Org != fromOrg) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if toOrg == fromOrg {
+		return nil, deny(ErrInvalid, "user already belongs to that organization")
+	}
+	exists, err := NewOrgTable().Exists(ctx, x, toOrg)
+	if err != nil {
+		return nil, err
+	}
+	if !exists {
+		return nil, deny(ErrInvalid, "unknown organization")
+	}
+	a := &transferUserAggregate{user: u, toOrg: toOrg}
+	memberships, err := u.Memberships(ctx, x)
+	if err != nil {
+		return nil, err
+	}
+	for _, m := range memberships {
+		p, err := m.Project(ctx, x)
+		if err != nil {
+			return nil, err
+		}
+		if p.Org == fromOrg {
+			a.memberships = append(a.memberships, m)
+		}
+	}
+	tasks, err := u.AssignedTasks(ctx, x)
+	if err != nil {
+		return nil, err
+	}
+	for _, t := range tasks {
+		p, err := t.Project(ctx, x)
+		if err != nil {
+			return nil, err
+		}
+		if p.Org == fromOrg {
+			a.tasks = append(a.tasks, t)
+		}
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, x *Tx) (*User, error) {
+	for _, m := range a.memberships {
+		if err := m.remove(ctx, x); err != nil {
+			return nil, err
+		}
+	}
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, x); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.user.moveTo(ctx, x, a.toOrg); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
+
