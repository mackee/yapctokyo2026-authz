+func TestUpdateMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, project, uid, body string
+		want                           int
+	}{
+		{"manager promotes viewer", "ann", "web", "dan", `{"role":"contributor"}`, 200},
+		{"manager promotes contributor", "ann", "web", "ben", `{"role":"manager"}`, 200},
+		{"manager sets same role", "ann", "web", "ben", `{"role":"contributor"}`, 200},
+		{"another manager changes manager", "ivy", "web", "ann", `{"role":"viewer"}`, 200},
+		{"demote with assigned task", "ann", "web", "ben", `{"role":"viewer"}`, 400},
+		{"contributor caller", "ben", "web", "dan", `{"role":"manager"}`, 403},
+		{"viewer caller", "dan", "web", "cat", `{"role":"viewer"}`, 403},
+		{"org admin caller", "eve", "web", "ben", `{"role":"viewer"}`, 403},
+		{"non member caller", "hal", "web", "ben", `{"role":"viewer"}`, 404},
+		{"other org caller", "gus", "web", "ben", `{"role":"viewer"}`, 404},
+		{"anonymous", "", "web", "ben", `{"role":"viewer"}`, 401},
+		{"archived", "ann", "legacy", "ben", `{"role":"viewer"}`, 409},
+		{"target not a member", "ann", "web", "hal", `{"role":"contributor"}`, 404},
+		{"target unknown user", "ann", "web", "zed", `{"role":"contributor"}`, 404},
+		{"unknown project", "ann", "nope", "ben", `{"role":"viewer"}`, 404},
+		{"invalid role", "ann", "web", "ben", `{"role":"owner"}`, 400},
+		{"missing role", "ann", "web", "ben", `{}`, 400},
+		{"malformed body", "ann", "web", "ben", `{`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			path := "/projects/" + c.project + "/members/" + c.uid
+			code, _ := do(t, newServer(), "PUT", path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRoleResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["userId"] != "dan" || got["role"] != "contributor" || len(got) != 2 {
+		t.Fatalf("got %s", body)
+	}
+}
+
+func TestUpdateMemberRolePersists(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`); code != 200 {
+		t.Fatalf("promote: got %d: %s", code, body)
+	}
+	// dan can write now that they are a contributor.
+	if code, body := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("create as promoted member: got %d: %s", code, body)
+	}
+	// and can no longer once demoted back to viewer.
+	if code, body := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote: got %d: %s", code, body)
+	}
+	if code, body := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"y"}`); code != 403 {
+		t.Fatalf("create as demoted member: got %d want 403: %s", code, body)
+	}
+}
+
+func TestDemoteAfterUnassigning(t *testing.T) {
+	h := newServer()
+	// ben holds t1; the viewer demotion is refused until the task is unassigned.
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 400 {
+		t.Fatalf("demote with task: got %d want 400", code)
+	}
+	if code, body := do(t, h, "PATCH", "/projects/web/tasks/t1", "ann", `{"assignee":""}`); code != 200 {
+		t.Fatalf("unassign: got %d: %s", code, body)
+	}
+	if code, body := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote after unassign: got %d: %s", code, body)
+	}
+}
