+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestChangeRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager demotes contributor", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 200},
+		{"manager promotes viewer", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"manager changes other manager", "ann", "/projects/web/members/ivy", `{"role":"contributor"}`, 200},
+		{"manager changes self when another manager exists", "ann", "/projects/web/members/ann", `{"role":"contributor"}`, 200},
+		{"same role is ok", "ann", "/projects/web/members/ben", `{"role":"contributor"}`, 200},
+		{"contributor", "ben", "/projects/web/members/cat", `{"role":"viewer"}`, 403},
+		{"viewer", "dan", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"org admin", "eve", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"non member", "hal", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"other org", "gus", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"anonymous", "", "/projects/web/members/ben", `{"role":"viewer"}`, 401},
+		{"unknown user", "zed", "/projects/web/members/ben", `{"role":"viewer"}`, 401},
+		{"missing project", "ann", "/projects/nope/members/ben", `{"role":"viewer"}`, 404},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"target member of other project only", "ann", "/projects/web/members/gus", `{"role":"viewer"}`, 404},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"invalid role", "ann", "/projects/web/members/ben", `{"role":"admin"}`, 400},
+		{"empty role", "ann", "/projects/web/members/ben", `{"role":""}`, 400},
+		{"missing role", "ann", "/projects/web/members/ben", `{}`, 400},
+		{"bad json", "ann", "/projects/web/members/ben", `nope`, 400},
+		{"last manager cannot be demoted", "ann", "/projects/legacy/members/ann", `{"role":"viewer"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestChangeRoleResponseAndEffect(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["userId"] != "dan" || got["role"] != "contributor" || len(got) != 2 {
+		t.Fatalf("unexpected body %s", body)
+	}
+	// dan can now write.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("promoted user cannot create tasks: %d", code)
+	}
+	// and the role is scoped to the project: dan is still not in ops.
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "dan", ""); code != 404 {
+		t.Fatalf("role leaked to other project: %d", code)
+	}
+}
+
+func TestDemoteLosesWriteAccess(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "PUT", "/projects/web/members/cat", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatal(code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "cat", `{"title":"x"}`); code != 403 {
+		t.Fatalf("demoted user can still write: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("demoted user lost read access: %d", code)
+	}
+	// cat's role in ops is untouched.
+	if code, _ := do(t, h, "POST", "/projects/ops/tasks", "cat", `{"title":"x"}`); code != 200 {
+		t.Fatalf("other project affected: %d", code)
+	}
+}
+
+// A viewer cannot be an assignee (see the model rules), so demoting a user to
+// viewer unassigns their tasks in that project only.
+func TestDemoteToViewerUnassignsTasks(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "PUT", "/projects/web/members/cat", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatal(code, body)
+	}
+	_, body := do(t, h, "GET", "/projects/web/tasks/t2", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" {
+		t.Fatalf("t2 still assigned to %q", task.Assignee)
+	}
+	// cat's task in ops stays assigned.
+	_, body = do(t, h, "GET", "/projects/ops/tasks/t4", "ann", "")
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "cat" {
+		t.Fatalf("t4 assignee = %q, want cat", task.Assignee)
+	}
+	// Other people's tasks are untouched.
+	_, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "ben" {
+		t.Fatalf("t1 assignee = %q, want ben", task.Assignee)
+	}
+}
+
+func TestDemoteToContributorKeepsTasks(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ann", "ann", `{"role":"contributor"}`); code != 200 {
+		t.Fatal("setup")
+	}
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ben", "ivy", `{"role":"manager"}`); code != 200 {
+		t.Fatal("promote")
+	}
+	_, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "ben" {
+		t.Fatalf("assignee = %q, want ben", task.Assignee)
+	}
+}
+
+func TestDemotedManagerLosesManagerPowers(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ivy", "ann", `{"role":"contributor"}`); code != 200 {
+		t.Fatal("setup")
+	}
+	if code, _ := do(t, h, "PUT", "/projects/web/members/dan", "ivy", `{"role":"contributor"}`); code != 403 {
+		t.Fatalf("demoted manager can still change roles: %d", code)
+	}
+	if code, _ := do(t, h, "DELETE", "/projects/web/tasks/t3", "ivy", ""); code != 403 {
+		t.Fatalf("demoted manager can still delete: %d", code)
+	}
+}
