+    else if (not(canRead(u, p))) 404
+    else if (not(ROLES.contains(r))) 400
+    else if (roleOf(p, u) != "manager") 403
+    else if (projects.get(p).archived) 409
+    else if (roleOf(p, target) == "") 404
+    else if (r == "viewer" and hasAssignedTask(p, target)) 400
+    else 200
+
+  def hasAssignedTask(p: ProjectId, u: UserId): bool =
+    tasks.keys().exists(t => tasks.get(t).project == p and tasks.get(t).assignee == u)
