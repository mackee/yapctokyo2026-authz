+func TestUpdateMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager demotes", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 200},
+		{"manager promotes", "ann", "/projects/web/members/dan", `{"role":"manager"}`, 200},
+		{"manager changes self", "ann", "/projects/web/members/ann", `{"role":"contributor"}`, 200},
+		{"contributor forbidden", "ben", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"viewer forbidden", "dan", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"org admin forbidden", "eve", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"manager of other project", "ann", "/projects/ops/members/cat", `{"role":"viewer"}`, 403},
+		{"non member", "hal", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"other org", "gus", "/projects/web/members/ben", `{"role":"viewer"}`, 404},
+		{"target not member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"unknown project", "ann", "/projects/nope/members/ben", `{"role":"viewer"}`, 404},
+		{"anonymous", "", "/projects/web/members/ben", `{"role":"viewer"}`, 401},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"invalid role", "ann", "/projects/web/members/ben", `{"role":"boss"}`, 400},
+		{"missing role", "ann", "/projects/web/members/ben", `{}`, 400},
+		{"bad json", "ann", "/projects/web/members/ben", `nope`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRoleEffect(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got map[string]string
+	json.Unmarshal([]byte(body), &got)
+	if got["userId"] != "ben" || got["role"] != "viewer" {
+		t.Fatalf("bad response %v", got)
+	}
+	// ben is now a viewer: can no longer write.
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 403 {
+		t.Fatalf("demoted user write got %d want 403", code)
+	}
+	// dan promoted to manager can delete.
+	do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"manager"}`)
+	if code, _ := do(t, h, "DELETE", "/projects/web/tasks/t3", "dan", ""); code != 204 {
+		t.Fatalf("promoted user delete got %d want 204", code)
+	}
+}
