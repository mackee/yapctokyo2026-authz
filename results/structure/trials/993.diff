+type transferRequest struct {
+	ToOrgID string `json:"toOrgId"`
+}
+
+type transferResponse struct {
+	ID    string `json:"id"`
+	OrgID string `json:"orgId"`
+}
+
+// transferUser moves a user from the path org to toOrgId. Memberships and task
+// assignments are left as they are; they stop being reachable because access
+// checks require the project's org to match the user's org.
+func (s *server) transferUser(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	caller, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if caller == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	orgID := r.PathValue("orgID")
+	if caller.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	if !caller.OrgAdmin {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	var req transferRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || req.ToOrgID == "" {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	if req.ToOrgID == orgID {
+		writeError(w, 400, "user is already in that organization")
+		return
+	}
+	var orgCount int
+	if err := s.db.QueryRowContext(ctx, `SELECT COUNT(*) FROM orgs WHERE id = ?`, req.ToOrgID).Scan(&orgCount); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if orgCount == 0 {
+		writeError(w, 400, "unknown target organization")
+		return
+	}
+	target, err := findUser(ctx, s.db, r.PathValue("uid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if target == nil || target.OrgID != orgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	// The org_id guard in WHERE makes a concurrent transfer fail instead of
+	// silently overwriting it.
+	res, err := s.db.ExecContext(ctx, `UPDATE users SET org_id = ?, org_admin = 0 WHERE id = ? AND org_id = ?`,
+		req.ToOrgID, target.ID, orgID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	n, err := res.RowsAffected()
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if n == 0 {
+		writeError(w, 409, "user was modified concurrently")
+		return
+	}
+	writeJSON(w, 200, transferResponse{ID: target.ID, OrgID: req.ToOrgID})
+}
