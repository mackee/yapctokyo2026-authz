+
+type memberRequest struct {
+	Role string `json:"role"`
+}
+
+type memberResponse struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func (s *server) updateMember(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role, err := findRole(ctx, s.db, project.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req memberRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	if req.Role != RoleManager && req.Role != RoleContributor && req.Role != RoleViewer {
+		writeError(w, 400, "invalid role")
+		return
+	}
+	targetID := r.PathValue("uid")
+	targetRole, err := findRole(ctx, s.db, project.ID, targetID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if targetRole == "" {
+		writeError(w, 404, "not found")
+		return
+	}
+	// Assignees must be contributors or managers, so a viewer may not hold tasks.
+	if req.Role == RoleViewer {
+		var assigned int
+		if err := s.db.QueryRowContext(ctx, `SELECT COUNT(*) FROM tasks WHERE project_id = ? AND assignee = ?`, project.ID, targetID).Scan(&assigned); err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+		if assigned > 0 {
+			writeError(w, 400, "member is assigned to tasks in this project; reassign them first")
+			return
+		}
+	}
+	if _, err := s.db.ExecContext(ctx, `UPDATE memberships SET role = ? WHERE project_id = ? AND user_id = ?`,
+		req.Role, project.ID, targetID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, memberResponse{UserID: targetID, Role: req.Role})
+}
diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..a12253c
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,118 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestUpdateMember(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager promotes viewer", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"manager promotes to manager", "ann", "/projects/web/members/dan", `{"role":"manager"}`, 200},
+		{"manager demotes unassigned member", "ann", "/projects/web/members/ivy", `{"role":"viewer"}`, 200},
+		{"contributor caller", "ben", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"viewer caller", "dan", "/projects/web/members/ivy", `{"role":"contributor"}`, 403},
+		{"org admin caller", "eve", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"non member caller", "hal", "/projects/web/members/dan", `{"role":"contributor"}`, 404},
+		{"other org caller", "gus", "/projects/web/members/dan", `{"role":"contributor"}`, 404},
+		{"anonymous", "", "/projects/web/members/dan", `{"role":"contributor"}`, 401},
+		{"unknown user", "zed", "/projects/web/members/dan", `{"role":"contributor"}`, 401},
+		{"unknown project", "ann", "/projects/nope/members/dan", `{"role":"contributor"}`, 404},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"invalid role", "ann", "/projects/web/members/dan", `{"role":"owner"}`, 400},
+		{"missing role", "ann", "/projects/web/members/dan", `{}`, 400},
+		{"invalid body", "ann", "/projects/web/members/dan", `not json`, 400},
+		{"demote assignee", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 400},
+		{"demote another assignee", "ann", "/projects/web/members/cat", `{"role":"viewer"}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["userId"] != "dan" || got["role"] != "contributor" || len(got) != 2 {
+		t.Fatalf("unexpected body %s", body)
+	}
+}
+
+// A promotion takes effect: the user can now write.
+func TestUpdateMemberPromotionGrantsWrite(t *testing.T) {
+	s := newServer()
+	if code, _ := do(t, s, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 403 {
+		t.Fatalf("before: got %d want 403", code)
+	}
+	if code, _ := do(t, s, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`); code != 200 {
+		t.Fatalf("promote: got %d want 200", code)
+	}
+	if code, _ := do(t, s, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("after: got %d want 200", code)
+	}
+}
+
+// A demotion takes effect: the user loses write access.
+func TestUpdateMemberDemotionRevokesWrite(t *testing.T) {
+	s := newServer()
+	if code, _ := do(t, s, "POST", "/projects/web/tasks", "ivy", `{"title":"x"}`); code != 200 {
+		t.Fatalf("before: got %d want 200", code)
+	}
+	if code, _ := do(t, s, "PUT", "/projects/web/members/ivy", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote: got %d want 200", code)
+	}
+	if code, _ := do(t, s, "POST", "/projects/web/tasks", "ivy", `{"title":"y"}`); code != 403 {
+		t.Fatalf("after: got %d want 403", code)
+	}
+}
+
+// A rejected demotion changes nothing: ben keeps the role and the task.
+func TestUpdateMemberRejectedDemotionIsNoop(t *testing.T) {
+	s := newServer()
+	if code, _ := do(t, s, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 400 {
+		t.Fatalf("demote: got %d want 400", code)
+	}
+	if code, _ := do(t, s, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ben still contributor: got %d want 200", code)
+	}
+}
+
+// Once the assignee is reassigned, the demotion is allowed.
+func TestUpdateMemberDemoteAfterReassign(t *testing.T) {
+	s := newServer()
+	if code, _ := do(t, s, "PATCH", "/projects/web/tasks/t1", "ann", `{"assignee":"ann"}`); code != 200 {
+		t.Fatalf("reassign: got %d want 200", code)
+	}
+	if code, _ := do(t, s, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote: got %d want 200", code)
+	}
+}
+
+// A role change applies to one project only: ivy is manager of web and ops.
+func TestUpdateMemberScopedToProject(t *testing.T) {
+	s := newServer()
+	if code, _ := do(t, s, "PUT", "/projects/web/members/ivy", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote in web: got %d want 200", code)
+	}
+	if code, _ := do(t, s, "PUT", "/projects/ops/members/ann", "ivy", `{"role":"contributor"}`); code != 200 {
+		t.Fatalf("ivy still manager of ops: got %d want 200", code)
+	}
+	if code, _ := do(t, s, "PUT", "/projects/web/members/ann", "ivy", `{"role":"contributor"}`); code != 403 {
+		t.Fatalf("ivy is viewer of web: got %d want 403", code)
+	}
+}
