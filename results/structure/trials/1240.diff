+func TestUpdateMembers(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager promotes viewer", "ann", "web", `{"roles":{"dan":"contributor"}}`, 200},
+		{"manager demotes member without tasks", "ann", "web", `{"roles":{"ivy":"viewer"}}`, 200},
+		{"demote member with assigned task", "ann", "web", `{"roles":{"ben":"viewer"}}`, 400},
+		{"batch with one assigned demotion", "ann", "web", `{"roles":{"dan":"contributor","ben":"viewer"}}`, 400},
+		{"non member target", "ann", "web", `{"roles":{"dan":"contributor","hal":"viewer"}}`, 400},
+		{"other org target", "ann", "web", `{"roles":{"gus":"viewer"}}`, 400},
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"unknown user", "zed", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"archived contributor", "ben", "legacy", `{"roles":{"ben":"viewer"}}`, 403},
+		{"invalid role", "ann", "web", `{"roles":{"dan":"owner"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"bad json", "ann", "web", `{"roles":`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMembersResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann",
+		`{"roles":{"ivy":"contributor","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []Member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []Member{
+		{UserID: "ann", Role: "manager"},
+		{UserID: "ben", Role: "contributor"},
+		{UserID: "cat", Role: "contributor"},
+		{UserID: "dan", Role: "contributor"},
+		{UserID: "ivy", Role: "contributor"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %d members want %d: %s", len(got), len(want), body)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("member %d: got %+v want %+v", i, got[i], want[i])
+		}
+	}
+}
+
+func TestUpdateMembersAllOrNothing(t *testing.T) {
+	srv := newServer()
+
+	// One non-member in the batch: nothing changes, including dan.
+	if code, body := do(t, srv, "PUT", "/projects/web/members", "ann",
+		`{"roles":{"dan":"contributor","hal":"viewer"}}`); code != 400 {
+		t.Fatalf("non-member batch: got %d: %s", code, body)
+	}
+	// One assigned demotion in the batch: nothing changes, including dan.
+	if code, body := do(t, srv, "PUT", "/projects/web/members", "ann",
+		`{"roles":{"dan":"contributor","ben":"viewer"}}`); code != 400 {
+		t.Fatalf("assigned demotion batch: got %d: %s", code, body)
+	}
+
+	// A valid request afterwards shows the full list; dan is still a viewer.
+	code, body := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"ivy":"viewer"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []Member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	roles := map[string]string{}
+	for _, m := range got {
+		roles[m.UserID] = m.Role
+	}
+	if roles["dan"] != "viewer" || roles["ben"] != "contributor" || roles["ivy"] != "viewer" {
+		t.Fatalf("roles changed by a rejected batch: %v", roles)
+	}
+}
