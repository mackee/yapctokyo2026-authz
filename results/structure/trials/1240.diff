+// updateRolesAggregate changes the roles of several members of one project.
+type updateRolesAggregate struct {
+	changes []roleChange
+}
+
+// roleChange is one member's new role. assigned holds the tasks of the
+// project assigned to the member, loaded for the rule in validate.
+type roleChange struct {
+	member   *Membership
+	role     string
+	assigned []*Task
+}
+
+// loadUpdateRoles loads each named member of the project. Every user named
+// must already be a member; changes are applied in user ID order.
+func loadUpdateRoles(ctx context.Context, tx DB, projectID string, in MembershipTableUpdateRolesInput) (*updateRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	userIDs := make([]string, 0, len(in.Roles))
+	for userID := range in.Roles {
+		userIDs = append(userIDs, userID)
+	}
+	sort.Strings(userIDs)
+	a := &updateRolesAggregate{}
+	for _, userID := range userIDs {
+		m, err := p.Membership(ctx, tx, userID)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "roles must name members of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		c := roleChange{member: m, role: in.Roles[userID]}
+		if !isWriterRole(c.role) {
+			c.assigned, err = m.AssignedTasks(ctx, tx)
+			if err != nil {
+				return nil, err
+			}
+		}
+		a.changes = append(a.changes, c)
+	}
+	return a, nil
+}
+
+func (a *updateRolesAggregate) validate() error {
+	for _, c := range a.changes {
+		// An assignee is a contributor or manager of the task's project, so a
+		// member who keeps tasks assigned cannot become a viewer.
+		if !isWriterRole(c.role) && len(c.assigned) > 0 {
+			return deny(ErrInvalid, "member has tasks assigned in the project and must stay a contributor or manager")
+		}
+	}
+	return nil
+}
+
+func (a *updateRolesAggregate) apply(ctx context.Context, tx DB) error {
+	for _, c := range a.changes {
+		if err := c.member.setRole(ctx, tx, c.role); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
