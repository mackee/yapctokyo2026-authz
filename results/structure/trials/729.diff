+// moveTaskAggregate moves one task to another project. The task keeps its ID,
+// title, status and assignee, so the assignee must be a contributor or manager
+// of the destination project.
+type moveTaskAggregate struct {
+	task     *Task
+	dst      *Project
+	assignee *Membership // dst.Membership(task's assignee); nil when unassigned or not a member
+}
+
+func loadMoveTask(ctx context.Context, tx DB, taskID, toProjectID string) (*moveTaskAggregate, error) {
+	t, err := NewTaskTable().Find(ctx, tx, taskID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	dst, err := NewProjectTable().Find(ctx, tx, toProjectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveTaskAggregate{task: t, dst: dst}
+	if t.AssigneeID != "" {
+		m, err := dst.Membership(ctx, tx, t.AssigneeID)
+		if err != nil && !errors.Is(err, ErrNoRows) {
+			return nil, err
+		}
+		a.assignee = m
+	}
+	return a, nil
+}
+
+func (a *moveTaskAggregate) validate() error {
+	if a.task.AssigneeID != "" && (a.assignee == nil || !isWriterRole(a.assignee.Role)) {
+		return deny(ErrInvalid, "assignee must be a contributor or manager of the project")
+	}
+	return nil
+}
+
+func (a *moveTaskAggregate) apply(ctx context.Context, tx DB) (*Task, error) {
+	if err := a.task.moveTo(ctx, tx, a.dst.ID); err != nil {
+		return nil, err
+	}
+	return a.task, nil
+}
+
 // deleteTaskAggregate removes one task.
