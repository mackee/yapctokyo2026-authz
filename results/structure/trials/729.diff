index 89224a1..c2d37d3 100644
--- a/internal/model/authz.go
+++ b/internal/model/authz.go
@@ -121,6 +121,30 @@ func (a TaskAuthz) CanManage() error {
 	return nil
 }
 
+// CanMoveTo returns nil if the actor may move the task to the project dst
+// (built by NewProjectAuthz). The actor must be a contributor or manager in
+// both projects and the task must be assigned to the actor, or the actor must
+// be a manager in both projects (any task). Otherwise ErrForbidden. Either
+// project being archived is ErrArchived (checked after the role rules).
+func (a TaskAuthz) CanMoveTo(dst ProjectAuthz) error {
+	if !a.CanRead() || !dst.CanRead() {
+		return deny(ErrNotFound, "not found")
+	}
+	src := a.project.role
+	bothWriters := isWriterRole(src) && isWriterRole(dst.role)
+	bothManagers := src == RoleManager && dst.role == RoleManager
+	if !bothManagers && !(bothWriters && a.isAssignee) {
+		return deny(ErrForbidden, "tasks can be moved only by managers of both projects, or by contributors of both projects for tasks assigned to themselves")
+	}
+	if a.project.archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	if dst.archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	return nil
+}
