diff --git a/move_test.go b/move_test.go
new file mode 100644
index 0000000..d1654a2
--- /dev/null
+++ b/move_test.go
@@ -0,0 +1,83 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		// contributors: both projects, own task only
+		{"contributor both, not own task", "cat", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 403},
+		{"contributor not member of destination", "ben", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 404},
+
+		// managers: a manager must be a manager in both projects to move any task
+		{"manager src, viewer dst", "ann", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer src", "ann", "/projects/ops/tasks/t4/move", `{"toProjectId":"web"}`, 403},
+		{"org admin without roles", "eve", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 403},
+
+		// destination checks
+		{"destination missing", "ann", "/projects/web/tasks/t1/move", `{"toProjectId":"nope"}`, 404},
+		{"destination in other org", "ann", "/projects/web/tasks/t1/move", `{"toProjectId":"gx"}`, 404},
+		{"destination archived", "ben", "/projects/web/tasks/t1/move", `{"toProjectId":"legacy"}`, 409},
+		{"source archived", "ben", "/projects/legacy/tasks/t5/move", `{"toProjectId":"web"}`, 409},
+
+		// the assignee must be a contributor or manager of the destination
+		{"assignee not member of destination", "ivy", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 400},
+
+		// malformed or meaningless requests
+		{"missing toProjectId", "ann", "/projects/web/tasks/t1/move", `{}`, 400},
+		{"same project", "ann", "/projects/web/tasks/t1/move", `{"toProjectId":"web"}`, 400},
+		{"task in another project", "ann", "/projects/web/tasks/t4/move", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsTask(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d body=%s", code, body)
+	}
+	var moved Task
+	if err := json.Unmarshal([]byte(body), &moved); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", AssigneeID: "cat"}
+	if moved != want {
+		t.Fatalf("moved task = %+v, want %+v", moved, want)
+	}
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks/t2", "ivy", ""); code != 200 {
+		t.Fatalf("task not readable in destination: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t2", "ivy", ""); code != 404 {
+		t.Fatalf("task still readable in source: %d", code)
+	}
+}
+
+func TestMoveDenialChangesNothing(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/tasks/t1/move", "ivy", `{"toProjectId":"ops"}`); code != 400 {
+		t.Fatalf("want 400, got %d", code)
+	}
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d", code)
+	}
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.ProjectID != "web" || task.AssigneeID != "ben" {
+		t.Fatalf("task changed by rejected move: %+v", task)
+	}
+}
