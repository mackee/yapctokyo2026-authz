diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..83904c6
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,90 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"testing"
+)
+
+func TestUpdateMemberRoles(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager changes roles", "ann", "/projects/web/members", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 200},
+		{"contributor forbidden", "ben", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer forbidden", "dan", "/projects/web/members", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin forbidden", "eve", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "/projects/web/members", `{"roles":{"dan":"contributor"}}`, 401},
+		{"archived", "ann", "/projects/legacy/members", `{"roles":{"ben":"viewer"}}`, 409},
+		{"target not a member", "ann", "/projects/web/members", `{"roles":{"ben":"viewer","hal":"viewer"}}`, 400},
+		{"invalid role", "ann", "/projects/web/members", `{"roles":{"ben":"owner"}}`, 400},
+		{"empty roles", "ann", "/projects/web/members", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "/projects/web/members", `{}`, 400},
+		{"bad json", "ann", "/projects/web/members", `{`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRolesResult(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]string{"ann": "manager", "ben": "viewer", "cat": "contributor", "dan": "contributor", "ivy": "manager"}
+	if len(got) != len(want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	for _, m := range got {
+		if want[m["userId"]] != m["role"] {
+			t.Fatalf("got %v want %v", got, want)
+		}
+	}
+
+	// ben was demoted to viewer: unassigned from t1 (an assignee must be a writer).
+	_, task := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var tk Task
+	if err := json.Unmarshal([]byte(task), &tk); err != nil {
+		t.Fatal(err)
+	}
+	if tk.AssigneeID != "" {
+		t.Fatalf("t1 still assigned to %q", tk.AssigneeID)
+	}
+	// dan can now write.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x","assignee":"dan"}`); code != http.StatusOK {
+		t.Fatalf("dan create got %d", code)
+	}
+}
+
+func TestUpdateMemberRolesAllOrNothing(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","hal":"viewer"}}`); code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	// ben keeps contributor role and his task.
+	_, task := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var tk Task
+	if err := json.Unmarshal([]byte(task), &tk); err != nil {
+		t.Fatal(err)
+	}
+	if tk.AssigneeID != "ben" {
+		t.Fatalf("t1 assignee %q, want ben", tk.AssigneeID)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"doing"}`); code != 200 {
+		t.Fatalf("ben patch got %d, want 200", code)
+	}
+}
