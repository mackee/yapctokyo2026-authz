+func TestFreezeAuthz(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager", "ivy", "/projects/web/freeze", 200},
+		{"contributor", "ben", "/projects/web/freeze", 403},
+		{"viewer", "dan", "/projects/web/freeze", 403},
+		{"org admin", "eve", "/projects/web/freeze", 403},
+		{"non member", "hal", "/projects/web/freeze", 404},
+		{"other org", "gus", "/projects/web/freeze", 404},
+		{"anonymous", "", "/projects/web/freeze", 401},
+		{"unknown project", "ann", "/projects/nope/freeze", 404},
+		{"archived", "ann", "/projects/legacy/freeze", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	want := `[{"userId":"ann","role":"viewer"},{"userId":"ben","role":"viewer"},{"userId":"cat","role":"viewer"},{"userId":"dan","role":"viewer"},{"userId":"ivy","role":"viewer"}]`
+	if got := strings.TrimSpace(body); got != want {
+		t.Fatalf("body\n got %s\nwant %s", got, want)
+	}
+}
+
+func TestFreezeBlocksTaskWrites(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d: %s", code, body)
+	}
+	cases := []struct {
+		name, user, method, path, body string
+	}{
+		{"former manager create", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"former manager edit", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"former manager delete", "ann", "DELETE", "/projects/web/tasks/t1", ""},
+		{"second manager edit", "ivy", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"former contributor edit own", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"former contributor create", "cat", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"org admin create", "eve", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"freeze again", "ann", "POST", "/projects/web/freeze", ""},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, srv, c.method, c.path, c.user, c.body)
+			if code != 403 {
+				t.Fatalf("got %d want 403", code)
+			}
+		})
+	}
+
+	// Reads still work, and the task is unchanged.
+	code, body := do(t, srv, "GET", "/projects/web/tasks/t2", "dan", "")
+	if code != 200 {
+		t.Fatalf("read: got %d", code)
+	}
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Status != "doing" {
+		t.Fatalf("task status changed to %q", task.Status)
+	}
+}
+
