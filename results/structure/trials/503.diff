+// memberRole is one member of a project in the freeze response.
+type memberRole struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// freezeProject makes every member of the project a viewer, so no one can
+// change its tasks. It returns the members after the change.
+func freezeProject(ctx tanukirpc.Context[*projectRegistry], _ struct{}) ([]memberRole, error) {
+	reg := ctx.Registry()
+	ms, err := model.NewProjectTable().Freeze(ctx, reg.db, reg.authz)
+	if err != nil {
+		return nil, err
+	}
+	out := make([]memberRole, 0, len(ms))
+	for _, m := range ms {
+		out = append(out, memberRole{UserID: m.UserID, Role: m.Role})
+	}
+	return out, nil
+}
