+type moveRequest struct {
+	ToProjectID string `json:"toProjectId"`
+}
+
+// moveTask moves a task from the path project to toProjectId. The task keeps its
+// ID, title, status and assignee.
+func (s *server) moveTask(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project, err := findProject(ctx, s.db, r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role, err := findRole(ctx, s.db, project.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	task, err := findTask(ctx, s.db, r.PathValue("tid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if task == nil || task.ProjectID != project.ID {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req moveRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || req.ToProjectID == "" {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	if req.ToProjectID == project.ID {
+		writeError(w, 400, "task is already in that project")
+		return
+	}
+	target, err := findProject(ctx, s.db, req.ToProjectID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if target == nil || target.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	targetRole, err := findRole(ctx, s.db, target.ID, user.ID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if targetRole == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if targetRole != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if target.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	if task.Assignee != "" {
+		assigneeRole, err := findRole(ctx, s.db, target.ID, task.Assignee)
+		if err != nil {
+			writeError(w, 500, "internal error")
+			return
+		}
+		if assigneeRole != RoleManager && assigneeRole != RoleContributor {
+			writeError(w, 409, "assignee must be a contributor or manager of the target project")
+			return
+		}
+	}
+	if _, err := s.db.ExecContext(ctx, `UPDATE tasks SET project_id = ? WHERE id = ?`, target.ID, task.ID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	task.ProjectID = target.ID
+	writeJSON(w, 200, task)
+}
