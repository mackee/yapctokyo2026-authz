+type moveRequest struct {
+	ToProjectID string `json:"toProjectId"`
+}
+
+// moveMember acquires the source capability first, so authorization on the
+// source project takes precedence over body errors; the destination is then
+// acquired from the body's toProjectId, under the same rules.
+func moveMember(ctx tanukirpc.Context[*projectRegistry], _ struct{}) (*capability.MemberView, error) {
+	src, err := ctx.Registry().scope.Manage()
+	if err != nil {
+		return nil, err
+	}
+	var req moveRequest
+	if err := decodeBody(ctx.Request(), &req); err != nil || req.ToProjectID == "" {
+		return nil, errInvalidBody
+	}
+	dst, err := ctx.Registry().scope.Actor().Project(req.ToProjectID).Manage()
+	if err != nil {
+		return nil, err
+	}
+	v, err := src.MoveMember(chi.URLParam(ctx.Request(), "uid"), dst)
+	if err != nil {
+		return nil, err
+	}
+	return &v, nil
+}
