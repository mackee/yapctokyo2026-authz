+// ManageProject may change the membership of one project. Only managers of a
+// non-archived project hold it.
+type ManageProject interface {
+	ReadProject
+	// MoveMember moves a member of this project to dst, another project the
+	// actor manages, keeping the member's role. Fails with 404 if userID is not
+	// a member here, 409 if already a member of dst. The member's tasks in this
+	// project are unassigned, since they are no longer members of it.
+	MoveMember(userID string, dst ManageProject) (MemberView, error)
+}
+
+// MemberView is the public representation of a project membership.
+type MemberView struct {
+	UserID    string `json:"userId"`
+	ProjectID string `json:"projectId"`
+	Role      string `json:"role"`
+}
+
+type manageProject struct{ readProject }
+
+func (p *manageProject) MoveMember(userID string, dst ManageProject) (MemberView, error) {
+	to, ok := dst.(*manageProject)
+	if !ok || to.ps.as.a.st != p.ps.as.a.st {
+		return MemberView{}, deny(ErrInvalid, "destination must be a project the actor manages")
+	}
+	src, dstID := p.ps.pid, to.ps.pid
+	if src == dstID {
+		return MemberView{}, deny(ErrInvalid, "destination must be a different project")
+	}
+	var v MemberView
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		role, ok := s.members[src][userID]
+		if !ok {
+			return deny(ErrNotFound, "not found")
+		}
+		if _, ok := s.members[dstID][userID]; ok {
+			return deny(ErrConflict, "user is already a member of the destination project")
+		}
+		for id, t := range s.tasks {
+			if t.project == src && t.assignee.user == userID {
+				t.assignee = Assignee{project: src}
+				s.tasks[id] = t
+			}
+		}
+		delete(s.members[src], userID)
+		if s.members[dstID] == nil {
+			s.members[dstID] = map[string]string{}
+		}
+		s.members[dstID][userID] = role
+		v = MemberView{UserID: userID, ProjectID: dstID, Role: role}
+		return nil
+	})
+	return v, err
+}
