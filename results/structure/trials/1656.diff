diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..98370e0
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,91 @@
+package main
+
+import (
+	"encoding/json"
+	"reflect"
+	"testing"
+)
+
+// PUT /projects/{pid}/members/{uid} with {"role":...} changes the member's role
+// in the project and answers {"userId","role"}.
+
+func TestUpdateMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, project, uid, body string
+		want                           int
+	}{
+		{"manager promotes contributor", "ann", "web", "ben", `{"role":"manager"}`, 200},
+		{"manager promotes viewer", "ann", "web", "dan", `{"role":"contributor"}`, 200},
+		{"same role", "ann", "web", "ben", `{"role":"contributor"}`, 200},
+		{"manager demotes member without tasks", "ann", "web", "ivy", `{"role":"viewer"}`, 200},
+		{"demote assignee rejected", "ann", "web", "ben", `{"role":"viewer"}`, 400},
+		{"contributor actor", "ben", "web", "cat", `{"role":"viewer"}`, 403},
+		{"viewer actor", "dan", "web", "ivy", `{"role":"viewer"}`, 403},
+		{"org admin actor", "eve", "web", "ben", `{"role":"viewer"}`, 403},
+		{"non member actor", "hal", "web", "ben", `{"role":"viewer"}`, 404},
+		{"other org actor", "gus", "web", "ben", `{"role":"viewer"}`, 404},
+		{"anonymous", "", "web", "ben", `{"role":"viewer"}`, 401},
+		{"unknown user", "zed", "web", "ben", `{"role":"viewer"}`, 401},
+		{"missing project", "ann", "nope", "ben", `{"role":"viewer"}`, 404},
+		{"target not a member", "ann", "web", "hal", `{"role":"viewer"}`, 404},
+		{"archived", "ann", "legacy", "ben", `{"role":"viewer"}`, 409},
+		{"unknown role", "ann", "web", "ben", `{"role":"owner"}`, 400},
+		{"missing role", "ann", "web", "ben", `{}`, 400},
+		{"bad json", "ann", "web", "ben", `{"role":`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members/"+c.uid, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRoleResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members/ben", "ann", `{"role":"manager"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("bad json %q: %v", body, err)
+	}
+	want := map[string]string{"userId": "ben", "role": "manager"}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+}
+
+func TestUpdateMemberRoleTakesEffect(t *testing.T) {
+	t.Run("promoted viewer can create tasks", func(t *testing.T) {
+		srv := newServer()
+		if code, _ := do(t, srv, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`); code != 200 {
+			t.Fatalf("role change: got %d want 200", code)
+		}
+		if code, _ := do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+			t.Fatalf("create after promotion: got %d want 200", code)
+		}
+	})
+
+	t.Run("demoted manager loses write access", func(t *testing.T) {
+		srv := newServer()
+		if code, _ := do(t, srv, "PUT", "/projects/web/members/ivy", "ann", `{"role":"viewer"}`); code != 200 {
+			t.Fatalf("role change: got %d want 200", code)
+		}
+		if code, _ := do(t, srv, "PATCH", "/projects/web/tasks/t3", "ivy", `{"status":"done"}`); code != 403 {
+			t.Fatalf("patch after demotion: got %d want 403", code)
+		}
+	})
+
+	t.Run("rejected demotion changes nothing", func(t *testing.T) {
+		srv := newServer()
+		if code, _ := do(t, srv, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 400 {
+			t.Fatalf("role change: got %d want 400", code)
+		}
+		if code, _ := do(t, srv, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 200 {
+			t.Fatalf("patch after rejected demotion: got %d want 200", code)
+		}
+	})
+}
