+// updateMembershipAggregate changes the role of one member of one project.
+type updateMembershipAggregate struct {
+	membership *Membership
+	in         MembershipTableUpdateInput
+	tasks      []*Task // the member's tasks in the project
+}
+
+func loadUpdateMembership(ctx context.Context, tx DB, projectID, userID string, in MembershipTableUpdateInput) (*updateMembershipAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	tasks, err := m.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &updateMembershipAggregate{membership: m, in: in, tasks: tasks}, nil
+}
+
+// validate rejects a demotion to viewer while the member is assigned tasks in
+// the project: an assignee must be a contributor or manager.
+func (a *updateMembershipAggregate) validate() error {
+	if !isWriterRole(a.in.Role) && len(a.tasks) > 0 {
+		return deny(ErrInvalid, "member is assigned tasks in the project and must stay a contributor or manager")
+	}
+	return nil
+}
+
+func (a *updateMembershipAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.membership.setRole(ctx, tx, a.in.Role); err != nil {
+		return nil, err
+	}
+	return a.membership, nil
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task *Task
