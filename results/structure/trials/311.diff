+// ManageProject may change member roles in one project.
+type ManageProject interface {
+	ID() string
+	// SetRoles changes the roles of the given members (userID -> role) as one
+	// all-or-nothing write and returns the project's members afterwards, sorted
+	// by user ID. An empty map, an unknown role, or a user who is not a member
+	// is 400, and nothing changes. A member demoted to viewer loses the
+	// assignment of their tasks in this project, so the invariant that
+	// assignees are writers still holds.
+	SetRoles(roles map[string]string) ([]MemberView, error)
+}
+
+type manageProject struct{ ps *projectScope }
+
+func (p *manageProject) ID() string { return p.ps.pid }
+
+func (p *manageProject) SetRoles(roles map[string]string) ([]MemberView, error) {
+	if len(roles) == 0 {
+		return nil, deny(ErrInvalid, "roles must not be empty")
+	}
+	uids := make([]string, 0, len(roles))
+	for uid := range roles {
+		uids = append(uids, uid)
+	}
+	sort.Strings(uids)
+
+	var out []MemberView
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		members := s.members[p.ps.pid]
+		for _, uid := range uids {
+			if _, ok := members[uid]; !ok {
+				return deny(ErrInvalid, fmt.Sprintf("%s is not a member of the project", uid))
+			}
+			if !validRole(roles[uid]) {
+				return deny(ErrInvalid, fmt.Sprintf("invalid role for %s", uid))
+			}
+		}
+		for _, uid := range uids {
+			members[uid] = roles[uid]
+		}
+		s.unassignNonWriters(p.ps.pid)
+		out = s.membersOf(p.ps.pid)
+		return nil
+	})
+	return out, err
+}
+
