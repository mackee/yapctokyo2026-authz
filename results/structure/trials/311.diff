 func isWriterRole(role string) bool { return role == RoleManager || role == RoleContributor }
 
+func validRole(role string) bool {
+	return role == RoleManager || role == RoleContributor || role == RoleViewer
+}
+
+// membersOf lists the members of a project sorted by user ID.
+func (s *state) membersOf(projectID string) []MemberView {
+	out := []MemberView{}
+	for uid, role := range s.members[projectID] {
+		out = append(out, MemberView{UserID: uid, Role: role})
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].UserID < out[j].UserID })
+	return out
+}
+
+// unassignNonWriters clears the assignee of every task in the project whose
+// assignee is no longer a contributor or manager.
+func (s *state) unassignNonWriters(projectID string) {
+	for id, t := range s.tasks {
+		if t.project == projectID && t.assignee.user != "" && !isWriterRole(s.role(projectID, t.assignee.user)) {
+			t.assignee = Assignee{project: projectID}
+			s.tasks[id] = t
+		}
+	}
+}
