+func TestSetRolesIsAllOrNothing(t *testing.T) {
+	h := newServer()
+
+	// dan is a viewer; the valid half of a failed batch must not be applied.
+	code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","hal":"viewer"}}`)
+	if code != 400 {
+		t.Fatalf("mixed batch: got %d want 400", code)
+	}
+	code, _ = do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`)
+	if code != 403 {
+		t.Fatalf("dan should still be a viewer after failed batch: got %d", code)
+	}
+
+	code, _ = do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","ben":"owner"}}`)
+	if code != 400 {
+		t.Fatalf("invalid role batch: got %d want 400", code)
+	}
+	code, _ = do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`)
+	if code != 403 {
+		t.Fatalf("dan should still be a viewer after invalid-role batch: got %d", code)
+	}
+
+	code, _ = do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("valid batch: got %d", code)
+	}
+	code, _ = do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`)
+	if code != 201 {
+		t.Fatalf("dan should be a contributor now: got %d", code)
+	}
+}
+
+func TestSetRolesDemotedMemberLosesAssignments(t *testing.T) {
+	h := newServer()
+
+	// ben is assigned t1 as a contributor. Demoting him to viewer succeeds and
+	// clears the assignment, so no task is left with a non-writer assignee.
+	code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d", code)
+	}
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d", code)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.Assignee != "" {
+		t.Fatalf("t1 still assigned to %q", task.Assignee)
+	}
+	// Other assignments in the project are untouched.
+	code, body = do(t, h, "GET", "/projects/web/tasks/t2", "ann", "")
+	if code != 200 || !strings.Contains(body, `"assignee":"cat"`) {
+		t.Fatalf("t2 changed: %d %s", code, body)
+	}
+}
