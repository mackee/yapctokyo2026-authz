+func (p *manageProject) ChangeRole(userID, role string) (MemberView, error) {
+	var v MemberView
+	err := p.ps.as.a.db.update(func(x *tx) error {
+		agg, err := loadChangeRole(x, p.ps.pid, userID, role)
