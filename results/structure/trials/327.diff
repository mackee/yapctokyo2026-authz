diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..1f572c4
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,83 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestChangeRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager promotes viewer", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"manager sets own role", "ann", "/projects/web/members/ann", `{"role":"manager"}`, 200},
+		{"manager demotes unassigned manager", "ann", "/projects/web/members/ivy", `{"role":"contributor"}`, 200},
+		{"contributor", "ben", "/projects/web/members/cat", `{"role":"viewer"}`, 403},
+		{"viewer", "dan", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"org admin", "eve", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"non member", "hal", "/projects/web/members/dan", `{"role":"contributor"}`, 404},
+		{"other org", "gus", "/projects/web/members/dan", `{"role":"contributor"}`, 404},
+		{"anonymous", "", "/projects/web/members/dan", `{"role":"contributor"}`, 401},
+		{"unknown target", "ann", "/projects/web/members/hal", `{"role":"contributor"}`, 404},
+		{"manager demotes self without tasks", "ann", "/projects/web/members/ann", `{"role":"viewer"}`, 200},
+		{"invalid role", "ann", "/projects/web/members/dan", `{"role":"owner"}`, 400},
+		{"missing role", "ann", "/projects/web/members/dan", `{}`, 400},
+		{"malformed body", "ann", "/projects/web/members/dan", `not json`, 400},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"assignee with tasks to viewer", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestChangeRoleResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.UserID != "dan" || got.Role != "contributor" {
+		t.Fatalf("got %+v", got)
+	}
+}
+
+// TestChangeRoleTakesEffect checks that a role change is visible to later
+// requests, and that a rejected change leaves the role as it was.
+func TestChangeRoleTakesEffect(t *testing.T) {
+	srv := newServer()
+	steps := []struct {
+		name, user, method, path, body string
+		want                           int
+	}{
+		{"viewer cannot create", "dan", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"manager promotes viewer", "ann", "PUT", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"promoted user can create", "dan", "POST", "/projects/web/tasks", `{"title":"x"}`, 201},
+		{"demoting assignee is rejected", "ann", "PUT", "/projects/web/members/ben", `{"role":"viewer"}`, 400},
+		{"rejected demotion changed nothing", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`, 200},
+		{"manager unassigns task", "ann", "PATCH", "/projects/web/tasks/t1", `{"assignee":""}`, 200},
+		{"demotion now allowed", "ann", "PUT", "/projects/web/members/ben", `{"role":"viewer"}`, 200},
+		{"demoted user cannot edit", "ben", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"demoted user cannot create", "ben", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+	}
+	for _, s := range steps {
+		t.Run(s.name, func(t *testing.T) {
+			code, body := do(t, srv, s.method, s.path, s.user, s.body)
+			if code != s.want {
+				t.Fatalf("got %d want %d: %s", code, s.want, body)
+			}
+		})
+	}
+}
