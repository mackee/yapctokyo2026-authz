+// changeRoleAggregate sets the role of one member of one project.
+type changeRoleAggregate struct {
+	member   membershipRecord
+	newRole  string
+	assigned []taskRecord // the member's tasks in this project
+}
+
+func loadChangeRole(x *tx, projectID, userID, role string) (*changeRoleAggregate, error) {
+	m, ok := x.findMembership(projectID, userID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	return &changeRoleAggregate{
+		member:   m,
+		newRole:  role,
+		assigned: x.tasksAssignedIn(projectID, userID),
+	}, nil
+}
+
+func (a *changeRoleAggregate) validate() error {
+	if !validRoles[a.newRole] {
+		return deny(ErrInvalid, "role must be manager, contributor or viewer")
+	}
+	if !isWriterRole(a.newRole) && len(a.assigned) > 0 {
+		return deny(ErrInvalid, "member still has tasks assigned in this project; reassign or unassign them first")
+	}
+	return nil
+}
+
+func (a *changeRoleAggregate) save(x *tx) MemberView {
+	a.member.Role = a.newRole
+	a.member.save(x)
+	return MemberView{UserID: a.member.UserID, Role: a.member.Role}
+}
+
