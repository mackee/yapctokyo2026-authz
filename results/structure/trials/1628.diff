+type memberRole struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func TestFreeze(t *testing.T) {
+	t.Run("manager freezes; all members become viewers", func(t *testing.T) {
+		h := newServer()
+		code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+		if code != 200 {
+			t.Fatalf("got %d want 200: %s", code, body)
+		}
+		var got []memberRole
+		if err := json.Unmarshal([]byte(body), &got); err != nil {
+			t.Fatalf("bad body %q: %v", body, err)
+		}
+		want := []memberRole{
+			{"ann", "viewer"}, {"ben", "viewer"}, {"cat", "viewer"}, {"dan", "viewer"}, {"ivy", "viewer"},
+		}
+		if !reflect.DeepEqual(got, want) {
+			t.Fatalf("got %+v want %+v", got, want)
+		}
+	})
+
+	t.Run("freeze is idempotent", func(t *testing.T) {
+		h := newServer()
+		code1, body1 := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+		code2, body2 := do(t, h, "POST", "/projects/web/freeze", "ivy", "")
+		if code1 != 200 || code2 != 200 {
+			t.Fatalf("got %d and %d, want 200 and 200", code1, code2)
+		}
+		if body1 != body2 {
+			t.Fatalf("bodies differ: %q vs %q", body1, body2)
+		}
+	})
+
+	t.Run("nobody can change tasks after freeze", func(t *testing.T) {
+		h := newServer()
+		if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+			t.Fatalf("freeze got %d: %s", code, body)
+		}
+		cases := []struct {
+			name, user, method, path, body string
+			want                           int
+		}{
+			{"former manager patch", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+			{"former manager reassign", "ivy", "PATCH", "/projects/web/tasks/t1", `{"assignee":"cat"}`, 403},
+			{"former contributor own task", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`, 403},
+			{"former contributor create", "cat", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+			{"former manager delete", "ann", "DELETE", "/projects/web/tasks/t1", "", 403},
+		}
+		for _, c := range cases {
+			t.Run(c.name, func(t *testing.T) {
+				code, _ := do(t, h, c.method, c.path, c.user, c.body)
+				if code != c.want {
+					t.Fatalf("got %d want %d", code, c.want)
+				}
+			})
+		}
+		code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ben", "")
+		if code != 200 || !strings.Contains(body, `"status":"open"`) {
+			t.Fatalf("task t1 should be readable and unchanged, got %d: %s", code, body)
+		}
+	})
+
+	t.Run("only the frozen project is affected", func(t *testing.T) {
+		h := newServer()
+		if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+			t.Fatalf("freeze got %d: %s", code, body)
+		}
+		if code, body := do(t, h, "POST", "/projects/ops/tasks", "cat", `{"title":"x"}`); code != 200 {
+			t.Fatalf("ops create got %d want 200: %s", code, body)
+		}
+	})
+
+	t.Run("non-managers and ineligible callers cannot freeze", func(t *testing.T) {
+		cases := []struct {
+			name, user, project string
+			want                int
+		}{
+			{"contributor", "ben", "web", 403},
+			{"viewer", "dan", "web", 403},
+			{"org admin", "eve", "web", 403},
+			{"non member", "hal", "web", 404},
+			{"other org", "gus", "web", 404},
+			{"anonymous", "", "web", 401},
+			{"unknown user", "zed", "web", 401},
+			{"missing project", "ann", "nope", 404},
+			{"archived", "ann", "legacy", 409},
+		}
+		for _, c := range cases {
+			t.Run(c.name, func(t *testing.T) {
+				code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+				if code != c.want {
+					t.Fatalf("got %d want %d", code, c.want)
+				}
+			})
+		}
+	})
+
+	t.Run("failed freeze leaves roles unchanged", func(t *testing.T) {
+		h := newServer()
+		if code, _ := do(t, h, "POST", "/projects/web/freeze", "ben", ""); code != 403 {
+			t.Fatalf("freeze by contributor got %d want 403", code)
+		}
+		if code, body := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 200 {
+			t.Fatalf("ben should still be a contributor, got %d: %s", code, body)
+		}
+	})
+}
