+// MembershipAuthz is what the actor may do with one member of one project.
+type MembershipAuthz struct {
+	project ProjectAuthz
+	userID  string
+}
+
+// Project returns the project-level authorization the membership object came from.
+func (a MembershipAuthz) Project() ProjectAuthz { return a.project }
+
+// UserID returns the member the object is bound to.
+func (a MembershipAuthz) UserID() string { return a.userID }
+
+// CanRemove returns nil if the actor may remove the member from the project:
+// managers only (else ErrForbidden) and not archived (else ErrArchived).
+func (a MembershipAuthz) CanRemove() error {
+	if !a.project.CanRead() || a.project.role != RoleManager {
+		return deny(ErrForbidden, "only managers may remove members")
+	}
+	if a.project.archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	return nil
+}
