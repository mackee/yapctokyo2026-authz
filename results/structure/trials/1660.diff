+// Delete removes the member from the project.
+func (*MembershipTable) Delete(ctx context.Context, db DB, authz MembershipAuthz) error {
+	if err := authz.CanRemove(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveMember(ctx, tx, authz.Project().ProjectID(), authz.UserID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
