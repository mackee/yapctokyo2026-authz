+// NewMembershipAuthz builds the actor's authorization object for one member of
+// the project. The user must be a member of the project; otherwise ErrNotFound.
+func NewMembershipAuthz(ctx context.Context, db DB, pa ProjectAuthz, userID string) (MembershipAuthz, error) {
+	if !pa.CanRead() {
+		return MembershipAuthz{}, deny(ErrNotFound, "not found")
+	}
+	m, err := NewMembershipTable().Find(ctx, db, pa.project, userID)
+	if errors.Is(err, ErrNoRows) {
+		return MembershipAuthz{}, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return MembershipAuthz{}, err
+	}
+	return MembershipAuthz{project: pa, userID: m.UserID}, nil
+}
