+// updateMembershipRoleAggregate changes the role of one member of a project.
+type updateMembershipRoleAggregate struct {
+	membership *Membership // the member, found through project.Membership
+	role       string
+}
+
+func loadUpdateMembershipRole(ctx context.Context, tx DB, projectID string, in MembershipTableUpdateRoleInput) (*updateMembershipRoleAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	m, err := p.Membership(ctx, tx, in.UserID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "member not found")
+	} else if err != nil {
+		return nil, err
+	}
+	return &updateMembershipRoleAggregate{membership: m, role: in.Role}, nil
+}
+
+func (a *updateMembershipRoleAggregate) validate() error { return nil }
+
+func (a *updateMembershipRoleAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.membership.setRole(ctx, tx, a.role); err != nil {
+		return nil, err
+	}
+	return a.membership, nil
+}
