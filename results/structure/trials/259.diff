+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben", 204},
+		{"user without projects", "eve", "/orgs/acme/users/hal", 204},
+		{"manager not admin", "ann", "/orgs/acme/users/ben", 403},
+		{"other org admin", "gus", "/orgs/acme/users/ben", 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed", 404},
+		{"user of other org", "eve", "/orgs/acme/users/gus", 404},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatal(code)
+	}
+	// ben lost access to every project, including the archived one.
+	for _, pid := range []string{"web", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+pid+"/tasks", "ben", ""); code != 404 {
+			t.Fatalf("%s: got %d want 404", pid, code)
+		}
+	}
+	// his tasks were unassigned; other members are untouched.
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatal(code)
+	}
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" {
+		t.Fatalf("t1 still assigned to %q", task.Assignee)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat lost access: %d", code)
+	}
+	// a second removal is idempotent-safe only for org members: ben is still one.
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("repeat: got %d", code)
+	}
+}
