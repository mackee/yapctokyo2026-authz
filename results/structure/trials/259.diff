 func (s *actorScope) Actor() Actor { return s.actor }
+func (s *actorScope) Org(orgID string) OrgScope {
+	return &orgScope{as: s, oid: orgID}
+}
+
+// OrgScope is bound to one actor and one organization ID. It grants nothing by
+// itself; call Manage to acquire a capability.
+type OrgScope interface {
+	Manage() (ManageOrg, error)
+}
+
+// ManageOrg is the org-admin capability for one organization.
+type ManageOrg interface {
+	// RemoveUser offboards a user: they are removed from every project of the
+	// organization and unassigned from the tasks they held there. The user
+	// must belong to the organization (else 404).
+	RemoveUser(userID string) error
+}
+
+type orgScope struct {
+	as  *actorScope
+	oid string
+}
+
+// Manage applies the org admin rule: the organization is the actor's own
+// (else 404) and the actor is an org admin of it (else 403).
+func (s *orgScope) Manage() (ManageOrg, error) {
+	act := s.as.actor
+	if act.org != s.oid {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if !act.orgAdmin {
+		return nil, deny(ErrForbidden, "forbidden")
+	}
+	return &manageOrg{os: s}, nil
+}
+
+type manageOrg struct{ os *orgScope }
+
+func (o *manageOrg) RemoveUser(userID string) error {
+	return o.os.as.a.st.tx(func(s *state) error {
+		u, ok := s.users[userID]
+		if !ok || u.org != o.os.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		for pid, m := range s.members {
+			if s.projects[pid].org == o.os.oid {
+				delete(m, userID)
+			}
+		}
+		// Tasks held by the user, including those in archived projects, must be
+		// released: an assignee has to be a contributor or manager.
+		for id, t := range s.tasks {
+			if t.assignee.user == userID {
+				t.assignee = Assignee{project: t.project}
+				s.tasks[id] = t
+			}
+		}
+		return nil
+	})
+}
 func (s *actorScope) Project(projectID string) ProjectScope {
 	return &projectScope{as: s, pid: projectID}
