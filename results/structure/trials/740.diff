+func TestDeleteMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"contributor removes", "ben", "/projects/web/members/cat", 403},
+		{"viewer removes", "dan", "/projects/web/members/ben", 403},
+		{"org admin removes", "eve", "/projects/web/members/ben", 403},
+		{"non member removes", "hal", "/projects/web/members/ben", 404},
+		{"other org removes", "gus", "/projects/web/members/ben", 404},
+		{"anonymous", "", "/projects/web/members/ben", 401},
+		{"unknown user", "zed", "/projects/web/members/ben", 401},
+		{"target not a member", "ann", "/projects/web/members/hal", 404},
+		{"target missing project", "ann", "/projects/nope/members/ben", 404},
+		{"archived", "ann", "/projects/legacy/members/ben", 409},
+		{"archived, contributor", "ben", "/projects/legacy/members/ben", 403},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
