+// deleteMemberAggregate removes one member from a project. The member's tasks
+// in the project are unassigned first, so no task keeps an assignee who is no
+// longer a member of the task's project.
+type deleteMemberAggregate struct {
+	membership *Membership
+	tasks      []*Task // the member's tasks in the project
+}
+
+func loadDeleteMember(ctx context.Context, tx DB, projectID, userID string) (*deleteMemberAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	tasks, err := m.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &deleteMemberAggregate{membership: m, tasks: tasks}, nil
+}
+
+func (a *deleteMemberAggregate) validate() error { return nil }
+
+func (a *deleteMemberAggregate) apply(ctx context.Context, tx DB) error {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return err
+		}
+	}
+	return a.membership.destroy(ctx, tx)
+}
