+++ b/offboard_test.go
@@ -0,0 +1,96 @@
+package main
+
+import (
+	"net/http"
+	"testing"
+)
+
+func TestRemoveUserFromOrg(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes user without projects", "eve", "/orgs/acme/users/hal", 204},
+		{"non admin", "ann", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"admin of another org's path", "eve", "/orgs/globex/users/gus", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ben", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+		{"target in another org", "eve", "/orgs/acme/users/gus", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveUserDropsAllMemberships(t *testing.T) {
+	h := newServer()
+	// ann is in web, ops and legacy (archived).
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ann", "eve", ""); code != 204 {
+		t.Fatalf("got %d want 204", code)
+	}
+	app := h.(*appHandler)
+	var n int
+	if err := app.db.QueryRow(`SELECT COUNT(*) FROM memberships WHERE user_id = 'ann'`).Scan(&n); err != nil {
+		t.Fatal(err)
+	}
+	if n != 0 {
+		t.Fatalf("ann still has %d memberships", n)
+	}
+	// Other members are untouched.
+	if err := app.db.QueryRow(`SELECT COUNT(*) FROM memberships WHERE user_id IN ('ben','cat','dan','ivy','gus')`).Scan(&n); err != nil {
+		t.Fatal(err)
+	}
+	if n != 8 {
+		t.Fatalf("other memberships changed: %d, want 8", n)
+	}
+	// The former member can no longer read the projects.
+	for _, p := range []string{"web", "ops", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ann", ""); code != http.StatusNotFound {
+			t.Fatalf("project %s: got %d want 404", p, code)
+		}
+	}
+}
+
+// Tasks assigned to the removed user must not stay assigned to a non-member
+// (checked by the model rules in do()); they become unassigned.
+func TestRemoveUserUnassignsTheirTasks(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("got %d want 204", code)
+	}
+	app := h.(*appHandler)
+	for _, id := range []string{"t1", "t5"} { // t5 is in the archived project
+		var assignee string
+		if err := app.db.QueryRow(`SELECT assignee FROM tasks WHERE id = ?`, id).Scan(&assignee); err != nil {
+			t.Fatal(err)
+		}
+		if assignee != "" {
+			t.Fatalf("task %s still assigned to %q", id, assignee)
+		}
+	}
+	// Tasks of other users are untouched.
+	var assignee string
+	if err := app.db.QueryRow(`SELECT assignee FROM tasks WHERE id = 't2'`).Scan(&assignee); err != nil {
+		t.Fatal(err)
+	}
+	if assignee != "cat" {
+		t.Fatalf("t2 assignee = %q, want cat", assignee)
+	}
+}
+
+func TestRemoveUserIsRepeatable(t *testing.T) {
+	h := newServer()
+	for i := 0; i < 2; i++ {
+		if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+			t.Fatalf("attempt %d: got %d want 204", i, code)
+		}
+	}
+}
