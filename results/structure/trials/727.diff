+// moveTaskAggregate moves one task to another project. The task keeps its
+// assignee, which must be a contributor or manager of the destination.
+type moveTaskAggregate struct {
+	task      *Task
+	toProject string
+	assignee  *Membership // the assignee's membership in the destination; nil when unassigned
+}
+
+func loadMoveTask(ctx context.Context, tx DB, taskID, toProjectID string) (*moveTaskAggregate, error) {
+	t, err := NewTaskTable().Find(ctx, tx, taskID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveTaskAggregate{task: t, toProject: toProjectID}
+	if t.AssigneeID != "" {
+		m, err := NewMembershipTable().Find(ctx, tx, toProjectID, t.AssigneeID)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "assignee must be a contributor or manager of the destination project")
+		} else if err != nil {
+			return nil, err
+		}
+		a.assignee = m
+	}
+	return a, nil
+}
+
+func (a *moveTaskAggregate) validate() error {
+	if a.assignee != nil && !isWriterRole(a.assignee.Role) {
+		return deny(ErrInvalid, "assignee must be a contributor or manager of the destination project")
+	}
+	return nil
+}
+
+func (a *moveTaskAggregate) apply(ctx context.Context, tx DB) (*Task, error) {
+	if err := a.task.moveTo(ctx, tx, a.toProject); err != nil {
+		return nil, err
+	}
+	return a.task, nil
+}
