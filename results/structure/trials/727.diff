+// TaskTableMoveInput is the input of TaskTable.Move.
+type TaskTableMoveInput struct {
+	ToProjectID string
+}
+
+// Move moves the task to another project, keeping its ID, title, status and
+// assignee. The destination is read through the actor's authorization in the
+// same transaction: a destination the actor cannot read is 404.
+func (*TaskTable) Move(ctx context.Context, db DB, authz TaskAuthz, in TaskTableMoveInput) (*Task, error) {
+	var t *Task
+	if err := inTx(ctx, db, func(tx DB) error {
+		dst, err := NewProjectAuthz(ctx, tx, authz.Project().Actor(), in.ToProjectID)
+		if err != nil {
+			return err
+		}
+		if err := authz.CanMoveTo(dst); err != nil {
+			return err
+		}
+		if in.ToProjectID == authz.Project().ProjectID() {
+			return deny(ErrInvalid, "task is already in that project")
+		}
+		agg, err := loadMoveTask(ctx, tx, authz.TaskID(), dst.ProjectID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if t, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return t, nil
+}
