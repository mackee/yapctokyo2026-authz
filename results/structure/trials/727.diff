+// CanMoveTo returns nil if the actor may move the task to the project dst
+// (built by NewProjectAuthz for the actor). The actor must be a contributor or
+// manager in both projects (else ErrForbidden), and either a manager in both or
+// the task's assignee (else ErrForbidden). Neither project may be archived
+// (else ErrArchived). Call it after dst has been built.
+func (a TaskAuthz) CanMoveTo(dst ProjectAuthz) error {
+	if !a.CanRead() || !isWriterRole(a.project.role) || !isWriterRole(dst.role) {
+		return deny(ErrForbidden, "forbidden")
+	}
+	bothManagers := a.project.role == RoleManager && dst.role == RoleManager
+	if !bothManagers && !a.isAssignee {
+		return deny(ErrForbidden, "only managers in both projects may move tasks they are not assigned to")
+	}
+	if a.project.archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	if dst.archived {
+		return deny(ErrArchived, "destination project is archived")
+	}
+	return nil
+}
