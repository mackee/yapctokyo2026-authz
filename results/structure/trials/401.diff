+// TaskTableMoveInput is the input of TaskTable.Move.
+type TaskTableMoveInput struct {
+	ToProjectID string
+}
+
+// Move moves the task to another project. The ID, title, status and assignee
+// are kept. The actor must be a manager of the task's project (as for Delete)
+// and a contributor or manager of the destination. The assignee must still be
+// a contributor or manager of the destination, or the move is rejected.
+func (tt *TaskTable) Move(ctx context.Context, db DB, authz TaskAuthz, in TaskTableMoveInput) (*Task, error) {
+	if err := authz.CanManage(); err != nil {
+		return nil, err
+	}
+	from := authz.Project().ProjectID()
+	if in.ToProjectID == from {
+		return nil, deny(ErrInvalid, "task is already in that project")
+	}
+	dest, err := NewProjectAuthz(ctx, db, authz.Project().Actor(), in.ToProjectID)
+	if err != nil {
+		return nil, err
+	}
+	if err := dest.CanWrite(); err != nil {
+		return nil, err
+	}
+	var t *Task
+	if err := db.update(ctx, func(x *Tx) error {
+		agg, err := loadMoveTask(ctx, x, authz.TaskID(), from, in.ToProjectID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if t, err = agg.apply(ctx, x); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return t, nil
+}
