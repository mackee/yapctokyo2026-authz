+// moveTaskAggregate moves one task from its project to another.
+type moveTaskAggregate struct {
+	task     *Task
+	dest     *Project
+	assignee *Membership // the assignee's membership in dest; nil when unassigned
+}
+
+func loadMoveTask(ctx context.Context, x *Tx, taskID, fromProjectID, toProjectID string) (*moveTaskAggregate, error) {
+	t, err := NewTaskTable().Find(ctx, x, taskID)
+	if errors.Is(err, ErrNoRows) || (err == nil && t.ProjectID != fromProjectID) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	dest, err := NewProjectTable().Find(ctx, x, toProjectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveTaskAggregate{task: t, dest: dest}
+	if t.AssigneeID != "" {
+		m, err := dest.Membership(ctx, x, t.AssigneeID)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "assignee must be a contributor or manager of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		a.assignee = m
+	}
+	return a, nil
+}
+
+func (a *moveTaskAggregate) validate() error {
+	if a.assignee != nil && !isWriterRole(a.assignee.Role) {
+		return deny(ErrInvalid, "assignee must be a contributor or manager of the project")
+	}
+	return nil
+}
+
+func (a *moveTaskAggregate) apply(ctx context.Context, x *Tx) (*Task, error) {
+	if err := a.task.moveTo(ctx, x, a.dest); err != nil {
+		return nil, err
+	}
+	return a.task, nil
+}
