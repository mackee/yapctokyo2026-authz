diff --git a/move_test.go b/move_test.go
new file mode 100644
index 0000000..3696555
--- /dev/null
+++ b/move_test.go
@@ -0,0 +1,98 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager of both", "ivy", "/projects/web/tasks/t2", `{"toProjectId":"ops"}`, 200},
+		{"unassigned task", "ivy", "/projects/web/tasks/t3", `{"toProjectId":"ops"}`, 200},
+		{"destination viewer", "ann", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"contributor source", "ben", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"viewer source", "dan", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"org admin", "eve", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 403},
+		{"non member", "hal", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 404},
+		{"other org", "gus", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 401},
+		{"cross project id", "ivy", "/projects/ops/tasks/t1", `{"toProjectId":"web"}`, 404},
+		{"archived source", "ann", "/projects/legacy/tasks/t5", `{"toProjectId":"web"}`, 409},
+		{"archived destination", "ann", "/projects/web/tasks/t1", `{"toProjectId":"legacy"}`, 409},
+		{"unknown destination", "ivy", "/projects/web/tasks/t2", `{"toProjectId":"nope"}`, 404},
+		{"other org destination", "ivy", "/projects/web/tasks/t2", `{"toProjectId":"gx"}`, 404},
+		{"same project", "ivy", "/projects/web/tasks/t2", `{"toProjectId":"web"}`, 400},
+		{"assignee not in destination", "ivy", "/projects/web/tasks/t1", `{"toProjectId":"ops"}`, 400},
+		{"missing destination", "ivy", "/projects/web/tasks/t2", `{}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsFields(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got Task
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", AssigneeID: "cat"}
+	if got != want {
+		t.Fatalf("got %+v want %+v", got, want)
+	}
+
+	// The move is visible to later requests: gone from web, present in ops.
+	_, web := do(t, h, "GET", "/projects/web/tasks", "ann", "")
+	var webTasks []Task
+	json.Unmarshal([]byte(web), &webTasks)
+	if len(webTasks) != 2 {
+		t.Fatalf("web: want 2 tasks, got %d", len(webTasks))
+	}
+	_, ops := do(t, h, "GET", "/projects/ops/tasks", "ann", "")
+	var opsTasks []Task
+	json.Unmarshal([]byte(ops), &opsTasks)
+	found := false
+	for _, task := range opsTasks {
+		if task.ID == "t2" {
+			found = true
+			if task != want {
+				t.Fatalf("ops listing: got %+v want %+v", task, want)
+			}
+		}
+	}
+	if !found {
+		t.Fatal("t2 missing from ops")
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t2", "ivy", ""); code != 404 {
+		t.Fatalf("old path: got %d want 404", code)
+	}
+}
+
+func TestMoveRejectedLeavesTaskInPlace(t *testing.T) {
+	h := newServer()
+	// t1 is assigned to ben, who is not a member of ops.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks/t1/move", "ivy", `{"toProjectId":"ops"}`); code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ben", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+	var got Task
+	json.Unmarshal([]byte(body), &got)
+	if got.ProjectID != "web" || got.AssigneeID != "ben" {
+		t.Fatalf("task changed after rejected move: %+v", got)
+	}
+}
