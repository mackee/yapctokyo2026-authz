+// TaskTableMoveInput is the input of TaskTable.Move.
+type TaskTableMoveInput struct {
+	ToProjectID string
+}
+
+// Move moves the task to another project, keeping its ID, title, status and
+// assignee. The actor must be a manager of the task's project (CanManage) and a
+// contributor or manager of the destination (CanWrite); a destination the actor
+// cannot read is ErrNotFound. The assignee must be a contributor or manager of
+// the destination, else ErrInvalid.
+func (*TaskTable) Move(ctx context.Context, db DB, authz TaskAuthz, in TaskTableMoveInput) (*Task, error) {
+	if err := authz.CanManage(); err != nil {
+		return nil, err
+	}
+	var t *Task
+	if err := inTx(ctx, db, func(tx DB) error {
+		dest, err := NewProjectAuthz(ctx, tx, authz.project.actor, in.ToProjectID)
+		if err != nil {
+			return err
+		}
+		if err := dest.CanWrite(); err != nil {
+			return err
+		}
+		agg, err := loadMoveTask(ctx, tx, authz.TaskID(), dest.ProjectID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		t, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return t, nil
+}
