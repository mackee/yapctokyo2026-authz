+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager moves", "ivy", "/projects/web/tasks/t2/move", `{"toProjectId":"ops"}`, 200},
+		{"viewer in destination", "ann", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 403}, // ann is only a viewer in ops
+		{"assignee not in destination", "ivy", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 400},
+		{"contributor", "cat", "/projects/web/tasks/t2/move", `{"toProjectId":"ops"}`, 403},
+		{"viewer", "dan", "/projects/web/tasks/t2/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin", "eve", "/projects/web/tasks/t2/move", `{"toProjectId":"ops"}`, 403},
+		{"non member of source", "hal", "/projects/web/tasks/t2/move", `{"toProjectId":"ops"}`, 404},
+		{"destination missing", "ivy", "/projects/web/tasks/t2/move", `{"toProjectId":"nope"}`, 404},
+		{"destination other org", "ann", "/projects/web/tasks/t2/move", `{"toProjectId":"gx"}`, 404},
+		{"destination archived", "ann", "/projects/web/tasks/t3/move", `{"toProjectId":"legacy"}`, 409},
+		{"source archived", "ann", "/projects/legacy/tasks/t5/move", `{"toProjectId":"web"}`, 409},
+		{"same project", "ann", "/projects/web/tasks/t2/move", `{"toProjectId":"web"}`, 400},
+		{"missing destination", "ann", "/projects/web/tasks/t2/move", `{}`, 400},
+		{"cross project id", "ivy", "/projects/web/tasks/t4/move", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/tasks/t2/move", `{"toProjectId":"ops"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsTask(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var moved Task
+	if err := json.Unmarshal([]byte(body), &moved); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", AssigneeID: "cat"}
+	if moved != want {
+		t.Fatalf("got %+v want %+v", moved, want)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t2", "ivy", ""); code != 404 {
+		t.Fatalf("task still in source project: %d", code)
+	}
+	code, body = do(t, h, "GET", "/projects/ops/tasks/t2", "ivy", "")
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got Task
+	json.Unmarshal([]byte(body), &got)
+	if got != want {
+		t.Fatalf("stored %+v want %+v", got, want)
+	}
+}
+
+func TestMoveUnassigned(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/tasks/t3/move", "ivy", `{"toProjectId":"ops"}`)
