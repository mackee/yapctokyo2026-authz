+// Freeze freezes the project: every member becomes a viewer, so nobody can
+// change its tasks. It asks the authorization object first (managers only, not
+// archived), then changes all memberships in one transaction. It returns the
+// members after the change, ordered by user ID.
+func (*ProjectTable) Freeze(ctx context.Context, db DB, authz ProjectAuthz) ([]*Membership, error) {
+	if err := authz.CanFreeze(); err != nil {
+		return nil, err
+	}
+	var members []*Membership
+	if err := db.update(ctx, func(x *Tx) error {
+		agg, err := loadFreezeProject(ctx, x, authz.ProjectID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if members, err = agg.apply(ctx, x); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return members, nil
+}
