+// freezeMember is one entry of the freeze response.
+type freezeMember struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func freezeProject(ctx tanukirpc.Context[*projectRegistry], _ struct{}) ([]freezeMember, error) {
+	reg := ctx.Registry()
+	ms, err := model.NewProjectTable().Freeze(ctx, reg.db, reg.authz)
+	if err != nil {
+		return nil, err
+	}
+	out := make([]freezeMember, 0, len(ms))
+	for _, m := range ms {
+		out = append(out, freezeMember{UserID: m.UserID, Role: m.Role})
+	}
+	return out, nil
+}
