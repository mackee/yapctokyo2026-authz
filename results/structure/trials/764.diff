+type moveMemberRequest struct {
+	ToProjectID string `json:"toProjectId" validate:"required"`
+}
+
+type moveMemberResponse struct {
+	UserID    string `json:"userId"`
+	ProjectID string `json:"projectId"`
+	Role      string `json:"role"`
+}
+
+// moveMember moves the member {uid} from {pid} to toProjectId. The destination
+// is an authorization object of its own, built for the same actor.
+func moveMember(ctx tanukirpc.Context[*projectRegistry], req moveMemberRequest) (*moveMemberResponse, error) {
+	reg := ctx.Registry()
+	to, err := model.NewProjectAuthz(ctx, reg.db, reg.authz.Actor(), req.ToProjectID)
+	if err != nil {
+		return nil, err
+	}
+	m, err := model.NewMembershipTable().Move(ctx, reg.db, reg.authz, to, chi.URLParam(ctx.Request(), "uid"))
+	if err != nil {
+		return nil, err
+	}
+	return &moveMemberResponse{UserID: m.UserID, ProjectID: m.ProjectID, Role: m.Role}, nil
+}
