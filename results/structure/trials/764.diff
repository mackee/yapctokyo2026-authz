+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestMoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager of both", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 200},
+		{"source manager, viewer of destination", "ann", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"contributor", "ben", "/projects/web/members/dan/move", `{"toProjectId":"legacy"}`, 403},
+		{"viewer", "ann", "/projects/ops/members/cat/move", `{"toProjectId":"web"}`, 403},
+		{"org admin without role", "eve", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 403},
+		{"non member of source", "hal", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"other org", "gus", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 404},
+		{"destination in other org", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"gx"}`, 404},
+		{"destination not readable", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"legacy"}`, 404},
+		{"destination does not exist", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"nope"}`, 404},
+		{"user not in source", "ivy", "/projects/web/members/hal/move", `{"toProjectId":"ops"}`, 404},
+		{"unknown user in path", "ivy", "/projects/web/members/zed/move", `{"toProjectId":"ops"}`, 404},
+		{"archived destination", "ann", "/projects/web/members/cat/move", `{"toProjectId":"legacy"}`, 409},
+		{"archived source", "ann", "/projects/legacy/members/ben/move", `{"toProjectId":"web"}`, 409},
+		{"already in destination", "ivy", "/projects/web/members/cat/move", `{"toProjectId":"ops"}`, 400},
+		{"same project", "ivy", "/projects/web/members/ben/move", `{"toProjectId":"web"}`, 400},
+		{"missing toProjectId", "ivy", "/projects/web/members/ben/move", `{}`, 400},
+		{"empty toProjectId", "ivy", "/projects/web/members/ben/move", `{"toProjectId":""}`, 400},
+		{"anonymous", "", "/projects/web/members/ben/move", `{"toProjectId":"ops"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestMoveMemberResponseKeepsRole(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/projects/web/members/dan/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got struct {
+		UserID    string `json:"userId"`
+		ProjectID string `json:"projectId"`
+		Role      string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.UserID != "dan" || got.ProjectID != "ops" || got.Role != "viewer" {
+		t.Fatalf("got %+v", got)
+	}
+}
+
+func TestMoveMemberEffects(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`); code != 200 {
+		t.Fatalf("move: got %d body=%s", code, body)
+	}
+
+	// ben left web: no access there any more.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben in web after move: got %d want 404", code)
+	}
+	// ben joined ops.
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben in ops after move: got %d want 200", code)
+	}
+	// ben's task in web (t1) is now unassigned, and the rest of web is untouched.
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("t1: got %d body=%s", code, body)
+	}
+	var task Task
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "" || task.Status != "open" || task.Title != "Fix header" {
+		t.Fatalf("t1 after move: %+v", task)
+	}
+	code, body = do(t, h, "GET", "/projects/web/tasks/t2", "ann", "")
+	if code != 200 {
+		t.Fatalf("t2: got %d body=%s", code, body)
+	}
+	if err := json.Unmarshal([]byte(body), &task); err != nil {
+		t.Fatal(err)
+	}
+	if task.AssigneeID != "cat" {
+		t.Fatalf("t2 assignee changed: %+v", task)
+	}
+	// Moving the member again is now a source-side miss.
+	if code, _ := do(t, h, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`); code != 404 {
+		t.Fatalf("second move: got %d want 404", code)
+	}
+}
