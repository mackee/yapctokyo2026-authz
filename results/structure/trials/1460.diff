+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, project, target string
+		want                        int
+	}{
+		{"manager removes contributor", "ann", "web", "ben", 204},
+		{"manager removes viewer", "ann", "web", "dan", 204},
+		{"contributor cannot remove", "ben", "web", "cat", 403},
+		{"viewer cannot remove", "dan", "web", "ben", 403},
+		{"org admin cannot remove", "eve", "web", "ben", 403},
+		{"non member caller", "hal", "web", "ben", 404},
+		{"other org caller", "gus", "web", "ben", 404},
+		{"anonymous", "", "web", "ben", 401},
+		{"unknown project", "ann", "nope", "ben", 404},
+		{"target not a member", "ann", "web", "hal", 404},
+		{"target member of other project only", "ann", "ops", "ben", 404},
+		{"archived", "ann", "legacy", "ben", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", "/projects/"+c.project+"/members/"+c.target, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveMemberUnassignsTasksAndRevokesAccess(t *testing.T) {
+	srv := newServer()
+	app := srv.(*appHandler)
+
+	if code, _ := do(t, srv, "DELETE", "/projects/web/members/ben", "ann", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+
+	var members int
+	if err := app.db.QueryRow(`SELECT COUNT(*) FROM memberships WHERE project_id = 'web' AND user_id = 'ben'`).Scan(&members); err != nil {
+		t.Fatal(err)
+	}
+	if members != 0 {
+		t.Fatalf("ben is still a member of web")
+	}
+	var assignee string
+	if err := app.db.QueryRow(`SELECT assignee FROM tasks WHERE id = 't1'`).Scan(&assignee); err != nil {
+		t.Fatal(err)
+	}
+	if assignee != "" {
+		t.Fatalf("t1 still assigned to %q, want unassigned", assignee)
+	}
+	// Tasks in other projects are not touched.
+	if err := app.db.QueryRow(`SELECT assignee FROM tasks WHERE id = 't5'`).Scan(&assignee); err != nil {
+		t.Fatal(err)
+	}
+	if assignee != "ben" {
+		t.Fatalf("t5 in legacy changed to %q, want ben", assignee)
+	}
+
+	// ben can no longer read the project.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("removed member read: got %d want 404", code)
+	}
+	// Removing again is a 404, because the user is no longer a member.
+	if code, _ := do(t, srv, "DELETE", "/projects/web/members/ben", "ann", ""); code != 404 {
+		t.Fatalf("second remove: got %d want 404", code)
+	}
+}
