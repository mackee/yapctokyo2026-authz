--- /dev/null
+++ b/internal/capability/move_test.go
@@ -0,0 +1,42 @@
+package capability
+
+import (
+	"errors"
+	"testing"
+)
+
+// Seed data has no user who is a manager of a source project and a contributor
+// of a destination project, so the destination-contributor rule is tested here
+// by adding that membership directly.
+func TestMoveContributorDestinationOnlyOwnTasks(t *testing.T) {
+	a := New()
+	// ivy: manager of web; make her a contributor of ops.
+	a.db.cur.members["ops"]["ivy"] = RoleContributor
+
+	actor, err := a.Authenticate("ivy")
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	// t2 is assigned to cat: a contributor may not bring it in.
+	m, err := actor.Project("web").Task("t2").Manage()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := m.MoveTo("ops"); !errors.Is(err, ErrForbidden) {
+		t.Fatalf("move of task assigned to someone else: got %v, want forbidden", err)
+	}
+
+	// t3 is unassigned: a contributor may bring it in, and it stays unassigned.
+	m, err = actor.Project("web").Task("t3").Manage()
+	if err != nil {
+		t.Fatal(err)
+	}
+	v, err := m.MoveTo("ops")
+	if err != nil {
+		t.Fatalf("move of unassigned task: %v", err)
+	}
+	if v.ProjectID != "ops" || v.Assignee != "" || v.ID != "t3" {
+		t.Fatalf("moved task = %+v", v)
+	}
+}
