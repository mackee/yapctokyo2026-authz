+func (t *manageTask) MoveTo(toProjectID string) (TaskView, error) {
+	if toProjectID == "" {
+		return TaskView{}, deny(ErrInvalid, "toProjectId is required")
+	}
+	if toProjectID == t.ts.ps.pid {
+		return TaskView{}, deny(ErrInvalid, "task is already in that project")
+	}
+	dst, err := t.ts.ps.as.Project(toProjectID).Write()
+	if err != nil {
+		return TaskView{}, err
+	}
+	var v TaskView
+	err = t.ts.ps.as.a.db.update(func(x *tx) error {
+		agg, err := loadMoveTask(x, t.ts.ps.pid, t.ts.tid, toProjectID, t.ts.ps.as.actor.id, dst.Role())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		v = agg.apply(x)
+		return nil
+	})
+	return v, err
+}
