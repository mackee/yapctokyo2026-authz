+// moveTaskAggregate moves one task from one project to another. The task keeps
+// its ID, title, status and assignee.
+type moveTaskAggregate struct {
+	task     taskRecord
+	to       projectRecord
+	assignee *membershipRecord // to.Membership(task assignee); nil when unassigned
+	actorID  string
+	toRole   string // the actor's role in the destination project
+}
+
+func loadMoveTask(x *tx, fromProjectID, taskID, toProjectID, actorID, toRole string) (*moveTaskAggregate, error) {
+	t, ok := x.findTask(taskID)
+	if !ok || t.ProjectID != fromProjectID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	to, ok := x.findProject(toProjectID)
+	if !ok {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	a := &moveTaskAggregate{task: t, to: to, actorID: actorID, toRole: toRole}
+	if t.AssigneeID != "" {
+		m, ok := to.Membership(x, t.AssigneeID)
+		if ok {
+			a.assignee = &m
+		}
+	}
+	return a, nil
+}
+
+func (a *moveTaskAggregate) validate() error {
+	if a.task.AssigneeID != "" && (a.assignee == nil || !isWriterRole(a.assignee.Role)) {
+		return deny(ErrInvalid, "assignee must be a contributor or manager of the destination project")
+	}
+	if a.toRole == RoleContributor && a.task.AssigneeID != "" && a.task.AssigneeID != a.actorID {
+		return deny(ErrForbidden, "contributors may only move tasks assigned to themselves")
+	}
+	return nil
+}
+
+func (a *moveTaskAggregate) apply(x *tx) TaskView {
+	t := a.task
+	t.MoveToProject(x, a.to.ID)
+	return t.view()
+}
+
 // deleteTaskAggregate removes one task.
 type deleteTaskAggregate struct {
 	task taskRecord
