diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..cde152e
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,83 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+// DELETE /projects/{pid}/members/{uid} removes the user from the project.
+// Managers only; a removed member's tasks in the project become unassigned.
+
+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager removes contributor", "ann", "/projects/web/members/ben", 204},
+		{"manager removes viewer", "ann", "/projects/web/members/dan", 204},
+		{"manager removes manager", "ann", "/projects/web/members/ivy", 204},
+		{"contributor", "ben", "/projects/web/members/cat", 403},
+		{"viewer", "dan", "/projects/web/members/ben", 403},
+		{"org admin without role", "eve", "/projects/web/members/ben", 403},
+		{"non member", "hal", "/projects/web/members/ben", 404},
+		{"other org", "gus", "/projects/web/members/ben", 404},
+		{"anonymous", "", "/projects/web/members/ben", 401},
+		{"unknown user", "zed", "/projects/web/members/ben", 401},
+		{"target not a member", "ann", "/projects/web/members/hal", 404},
+		{"archived", "ann", "/projects/legacy/members/ben", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveMemberEffects(t *testing.T) {
+	app := newServer()
+
+	if code, _ := do(t, app, "DELETE", "/projects/web/members/ben", "ann", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+
+	// The removed member can no longer read the project.
+	if code, _ := do(t, app, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("removed member reads project: got %d want 404", code)
+	}
+	// Their membership in another project is untouched.
+	if code, _ := do(t, app, "GET", "/projects/legacy/tasks", "ben", ""); code != 200 {
+		t.Fatalf("membership elsewhere: got %d want 200", code)
+	}
+
+	// Their task in the project is kept but unassigned; other members' tasks are unchanged.
+	code, body := do(t, app, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("get t1: got %d want 200", code)
+	}
+	var t1 Task
+	if err := json.Unmarshal([]byte(body), &t1); err != nil {
+		t.Fatal(err)
+	}
+	if t1.AssigneeID != "" {
+		t.Fatalf("t1 still assigned to %q", t1.AssigneeID)
+	}
+	code, body = do(t, app, "GET", "/projects/web/tasks/t2", "ann", "")
+	if code != 200 {
+		t.Fatalf("get t2: got %d want 200", code)
+	}
+	var t2 Task
+	if err := json.Unmarshal([]byte(body), &t2); err != nil {
+		t.Fatal(err)
+	}
+	if t2.AssigneeID != "cat" {
+		t.Fatalf("t2 assignee changed to %q, want cat", t2.AssigneeID)
+	}
+
+	// Removing them again: they are no longer a member.
+	if code, _ := do(t, app, "DELETE", "/projects/web/members/ben", "ann", ""); code != 404 {
+		t.Fatalf("second remove: got %d want 404", code)
+	}
+}
