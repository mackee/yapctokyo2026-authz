+func TestUpdateMembersAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager changes roles", "ann", "web", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"ben":"viewer"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"ben":"viewer"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"ben":"viewer"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"ben":"viewer"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"ben":"viewer"}}`, 401},
+		{"unknown user", "zed", "web", `{"roles":{"ben":"viewer"}}`, 401},
+		{"unknown project", "ann", "nope", `{"roles":{"ben":"viewer"}}`, 404},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"invalid role", "ann", "web", `{"roles":{"ben":"owner"}}`, 400},
+		{"target not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"target in other project", "ann", "web", `{"roles":{"gus":"viewer"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"malformed body", "ann", "web", `nope`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMembersResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []struct{ UserID, Role string }{
+		{"ann", "manager"}, {"ben", "viewer"}, {"cat", "contributor"}, {"dan", "contributor"}, {"ivy", "manager"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %d members, want %d: %s", len(got), len(want), body)
+	}
+	for i := range want {
+		if got[i].UserID != want[i].UserID || got[i].Role != want[i].Role {
+			t.Fatalf("member %d: got %+v want %+v", i, got[i], want[i])
+		}
+	}
+}
+
+func TestUpdateMembersTakesEffect(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer"}}`); code != 200 {
+		t.Fatalf("change: got %d: %s", code, body)
+	}
+	// ben was a contributor; as a viewer the create must now be refused.
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Fatalf("ben after demotion: got %d want 403", code)
+	}
+}
+
+func TestUpdateMembersAllOrNothing(t *testing.T) {
+	srv := newServer()
+	// ben is valid, hal is not a member: the whole batch must be refused.
+	if code, _ := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","hal":"viewer"}}`); code != 400 {
+		t.Fatalf("non-member in batch: got %d want 400", code)
+	}
+	// dan is valid, ben's role is invalid: nothing may change.
+	if code, _ := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","ben":"owner"}}`); code != 400 {
+		t.Fatalf("invalid role in batch: got %d want 400", code)
+	}
+	// ben is still a contributor and dan still a viewer.
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 200 {
+		t.Fatalf("ben after failed batch: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 403 {
+		t.Fatalf("dan after failed batch: got %d want 403", code)
+	}
+}
