+		{"non member", "hal", "/projects/web/tasks/t1/comments", `{"body":"hi"}`, 404},
+		{"other org", "gus", "/projects/web/tasks/t1/comments", `{"body":"hi"}`, 404},
+		{"anonymous", "", "/projects/web/tasks/t1/comments", `{"body":"hi"}`, 401},
+		{"unknown user", "zed", "/projects/web/tasks/t1/comments", `{"body":"hi"}`, 401},
