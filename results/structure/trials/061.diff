+	do(t, srv, "POST", "/projects/web/tasks/t1/comments", "ann", `{"body":"second"}`)
+	do(t, srv, "POST", "/projects/web/tasks/t2/comments", "ann", `{"body":"other task"}`)
+
+	code, body := do(t, srv, "GET", "/projects/web/tasks/t1/comments", "dan", "")
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
