+func (s *server) listComments(w http.ResponseWriter, r *http.Request) {
+	s.store.mu.Lock()
+	defer s.store.mu.Unlock()
+
+	user := s.store.User(r.Header.Get("X-User"))
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project := s.store.visibleProject(user, r.PathValue("pid"))
+	if project == nil {
+		writeError(w, 404, "not found")
+		return
+	}
+	task := s.store.Task(r.PathValue("tid"))
+	if task == nil || task.ProjectID != project.ID {
+		writeError(w, 404, "not found")
+		return
+	}
+	comments := s.store.CommentsOnTask(task.ID)
+	if comments == nil {
+		comments = []*Comment{}
+	}
+	writeJSON(w, 200, comments)
+}
+
+type commentRequest struct {
+	Body string `json:"body"`
+}
+
+func (s *server) createComment(w http.ResponseWriter, r *http.Request) {
+	s.store.mu.Lock()
+	defer s.store.mu.Unlock()
+
+	user := s.store.User(r.Header.Get("X-User"))
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project := s.store.visibleProject(user, r.PathValue("pid"))
+	if project == nil {
+		writeError(w, 404, "not found")
+		return
+	}
+	task := s.store.Task(r.PathValue("tid"))
+	if task == nil || task.ProjectID != project.ID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role := s.store.Role(project.ID, user.ID)
+	if role != RoleManager && role != RoleContributor && role != RoleViewer {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req commentRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || strings.TrimSpace(req.Body) == "" {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	comment := &Comment{
+		ID:     s.store.NewCommentID(),
+		TaskID: task.ID,
+		Author: user.ID,
+		Body:   req.Body,
+	}
+	s.store.PutComment(comment)
+	writeJSON(w, 201, comment)
+}
+
+func (s *server) getComment(w http.ResponseWriter, r *http.Request) {
+	s.store.mu.Lock()
+	defer s.store.mu.Unlock()
+
+	user := s.store.User(r.Header.Get("X-User"))
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	comment := s.store.Comment(r.PathValue("cid"))
+	if comment == nil {
+		writeError(w, 404, "not found")
+		return
+	}
+	// The comment is visible exactly when its task's project is visible.
+	task := s.store.Task(comment.TaskID)
+	if task == nil || s.store.visibleProject(user, task.ProjectID) == nil {
+		writeError(w, 404, "not found")
+		return
+	}
+	writeJSON(w, 200, comment)
+}
