diff --git a/transfer_test.go b/transfer_test.go
new file mode 100644
index 0000000..fc18a6f
--- /dev/null
+++ b/transfer_test.go
@@ -0,0 +1,99 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestTransfer(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		// who may transfer: org admins of the user's organization
+		{"org admin transfers", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 200},
+		{"member of the org", "ann", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 403},
+		{"project manager of the org", "ivy", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 403},
+		{"other org's user", "gus", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 404},
+		{"anonymous", "", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown actor", "zed", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 401},
+
+		// which user: must belong to the organization in the path
+		{"user missing", "eve", "/orgs/acme/users/nobody/transfer", `{"toOrgId":"globex"}`, 404},
+		{"user in another org", "eve", "/orgs/globex/users/hal/transfer", `{"toOrgId":"acme"}`, 404},
+		{"org in path is not the actor's", "gus", "/orgs/acme/users/ann/transfer", `{"toOrgId":"globex"}`, 404},
+
+		// body
+		{"missing toOrgId", "eve", "/orgs/acme/users/hal/transfer", `{}`, 400},
+		{"unknown target org", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"initech"}`, 400},
+		{"same org", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"acme"}`, 400},
+
+		// membership rule: a user cannot stay a member of another org's project
+		{"member of projects in the old org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 409},
+		{"member of projects, manager", "eve", "/orgs/acme/users/ann/transfer", `{"toOrgId":"globex"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/hal/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got struct {
+		ID    string `json:"id"`
+		OrgID string `json:"orgId"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.ID != "hal" || got.OrgID != "globex" {
+		t.Fatalf("got %+v body=%s", got, body)
+	}
+}
+
+// The transferred user moves with the organization: they lose access to the
+// old organization's projects, and an org admin does not keep admin rights in
+// the new organization.
+func TestTransferMovesAccess(t *testing.T) {
+	srv := newServer()
+
+	// eve is an acme org admin; before the transfer she reads acme's ops project.
+	if code, body := do(t, srv, "GET", "/projects/ops/tasks", "eve", ""); code != 200 {
+		t.Fatalf("before: got %d body=%s", code, body)
+	}
+	if code, body := do(t, srv, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: got %d body=%s", code, body)
+	}
+
+	// eve no longer belongs to acme, so she is outside its organization.
+	if code, body := do(t, srv, "GET", "/projects/ops/tasks", "eve", ""); code != 404 {
+		t.Fatalf("old org: got %d body=%s", code, body)
+	}
+	// In globex she is not an org admin any more, so gx (no membership) is unreadable.
+	if code, body := do(t, srv, "GET", "/projects/gx/tasks", "eve", ""); code != 404 {
+		t.Fatalf("new org admin right kept: got %d body=%s", code, body)
+	}
+	// And she cannot transfer anyone else; the transfer needs org admin rights.
+	if code, body := do(t, srv, "POST", "/orgs/acme/users/ann/transfer", "eve", `{"toOrgId":"globex"}`); code != 404 {
+		t.Fatalf("transfer by former admin: got %d body=%s", code, body)
+	}
+}
+
+// A refused transfer changes nothing.
+func TestTransferRefusedLeavesUserAlone(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 409 {
+		t.Fatalf("transfer: got %d body=%s", code, body)
+	}
+	if code, body := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben lost access after refused transfer: got %d body=%s", code, body)
+	}
+}
