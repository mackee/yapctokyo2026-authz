+// userTransformer authenticates the caller and builds the actor's authorization
+// object for {uid} in {orgID}. A user outside that organization stops here (404).
+func userTransformer(conn *sql.DB) tanukirpc.Transformer[*rootRegistry, *userRegistry] {
+	return tanukirpc.NewTransformer(func(ctx tanukirpc.Context[*rootRegistry]) (*userRegistry, error) {
+		actor, err := model.Authenticate(ctx, conn, ctx.Request().Header.Get("X-User"))
+		if err != nil {
+			return nil, err
+		}
+		authz, err := model.NewUserAuthz(ctx, conn, actor, chi.URLParam(ctx.Request(), "orgID"), chi.URLParam(ctx.Request(), "uid"))
+		if err != nil {
+			return nil, err
+		}
+		return &userRegistry{db: conn, authz: authz}, nil
+	})
+}
