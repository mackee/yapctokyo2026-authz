 )
 
 // Aggregates: one per operation. An aggregate is built inside the transaction
@@ -144,3 +145,56 @@ func loadDeleteTask(ctx context.Context, tx DB, taskID string) (*deleteTaskAggre
 func (a *deleteTaskAggregate) validate() error { return nil }
 
 func (a *deleteTaskAggregate) apply(ctx context.Context, tx DB) error { return a.task.destroy(ctx, tx) }
+
+// transferUserAggregate moves one user to another organization.
+type transferUserAggregate struct {
+	user     *User
+	toOrg    string
+	blocking []string // IDs of the projects outside toOrg the user is a member of
+}
+
+func loadTransferUser(ctx context.Context, tx DB, userID, toOrg string) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	exists, err := NewUserTable().OrgExists(ctx, tx, toOrg)
+	if err != nil {
+		return nil, err
+	}
+	if !exists {
+		return nil, deny(ErrInvalid, "organization does not exist")
+	}
+	a := &transferUserAggregate{user: u, toOrg: toOrg}
+	memberships, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, m := range memberships {
+		p, err := m.Project(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		if p.Org != toOrg {
+			a.blocking = append(a.blocking, p.ID)
+		}
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if len(a.blocking) > 0 {
+		return deny(ErrConflict, "user is still a member of projects outside the target organization ("+
+			strings.Join(a.blocking, ", ")+"); remove those memberships first")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	if err := a.user.moveTo(ctx, tx, a.toOrg); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
