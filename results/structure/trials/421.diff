+// Member is the JSON shape of a project member in the freeze response.
+type Member struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// freezeProject moves every member of the project to the viewer role and
+// returns the members after the change.
+func freezeProject(ctx tanukirpc.Context[*projectRegistry], _ struct{}) ([]Member, error) {
+	reg := ctx.Registry()
+	ms, err := model.NewProjectTable().Freeze(ctx, reg.db, reg.authz)
+	if err != nil {
+		return nil, err
+	}
+	out := make([]Member, 0, len(ms))
+	for _, m := range ms {
+		out = append(out, Member{UserID: m.UserID, Role: m.Role})
+	}
+	return out, nil
+}
