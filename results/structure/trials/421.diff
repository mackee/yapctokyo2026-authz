 import "context"
 
-// ProjectTable reads the projects table.
+// ProjectTable reads the projects table and runs the project operations.
 type ProjectTable struct{}
 
 // NewProjectTable returns the projects table.
 func NewProjectTable() *ProjectTable { return &ProjectTable{} }
 
+// Freeze changes every member of the project to the viewer role, all or
+// nothing, and returns the members after the change (ordered by user ID). Only
+// managers may freeze (see ProjectAuthz.CanFreeze). Freezing an already frozen
+// project changes nothing and returns the same list.
+//
+// Because writes need the contributor or manager role, a frozen project rejects
+// every task change: create, update and delete.
+func (*ProjectTable) Freeze(ctx context.Context, db DB, authz ProjectAuthz) ([]*Membership, error) {
+	if err := authz.CanFreeze(); err != nil {
+		return nil, err
+	}
+	var members []*Membership
+	if err := db.update(ctx, func(x *Tx) error {
+		agg, err := loadFreezeProject(ctx, x, authz.ProjectID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		members, err = agg.apply(ctx, x)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return members, nil
+}
