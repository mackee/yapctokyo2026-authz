+// Manage applies the manager rule: readable, manager role (else 403), not
+// archived (else 409).
+func (s *projectScope) Manage() (ManageProject, error) {
+	err := s.as.a.st.read(func(st *state) error {
+		p, r, err := readable(st, s.as.actor, s.pid)
+		if err != nil {
+			return err
+		}
+		if r != RoleManager {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if p.archived {
+			return deny(ErrArchived, "project is archived")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &manageProject{readProject: readProject{ps: s}}, nil
+}
+
 // ---- project capabilities ----------------------------------------------------
 
+// ManageProject is the manager-only capability for one project's membership.
+type ManageProject interface {
+	ReadProject
+	// RemoveMember removes a user from the project (404 if not a member).
+	// Tasks assigned to that user become unassigned.
+	RemoveMember(userID string) error
+}
+
+type manageProject struct{ readProject }
+
+func (p *manageProject) RemoveMember(userID string) error {
+	return p.ps.as.a.st.tx(func(s *state) error {
+		if s.role(p.ps.pid, userID) == "" {
+			return deny(ErrNotFound, "not found")
+		}
+		delete(s.members[p.ps.pid], userID)
+		for id, t := range s.tasks {
+			if t.project == p.ps.pid && t.assignee.user == userID {
+				t.assignee = Assignee{project: t.project}
+				s.tasks[id] = t
+			}
+		}
+		return nil
+	})
+}
