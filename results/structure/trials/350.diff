+// ---- user capabilities ---------------------------------------------------------
+
+// UserView is the public representation of a user.
+type UserView struct {
+	ID    string `json:"id"`
+	OrgID string `json:"orgId"`
+}
+
+// TransferUser may move one user to another organization. The move drops the
+// user's memberships in projects they leave, unassigns their tasks there, and
+// clears their org-admin rights.
+type TransferUser interface {
+	// To moves the user to the organization orgID. An unknown organization or
+	// the user's current organization is 400.
+	To(orgID string) (UserView, error)
+}
+
+type transferUser struct{ us *userScope }
+
+func (t *transferUser) To(orgID string) (UserView, error) {
+	var v UserView
+	err := t.us.os.as.a.db.update(func(x *tx) error {
+		agg, err := loadTransferUser(x, t.us.uid, t.us.os.oid, orgID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		v = agg.save(x)
+		return nil
+	})
+	return v, err
+}
+
