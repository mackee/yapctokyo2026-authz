+// transferUserAggregate moves one user from their organization to another.
+// It loads the user, the target organization, and the user's memberships and
+// task assignments in the projects the user leaves. It keeps the rules that
+// the move touches: members belong to their project's organization, assignees
+// are members of the task's project, and org-admin rights are per organization.
+type transferUserAggregate struct {
+	user        userRecord
+	toOrg       orgRecord
+	memberships []membershipRecord // memberships in projects outside the target organization (removed)
+	tasks       []taskRecord       // tasks assigned to the user in those projects (unassigned)
+}
+
+func loadTransferUser(x *tx, userID, fromOrg, toOrgID string) (*transferUserAggregate, error) {
+	u, ok := x.findUser(userID)
+	if !ok || u.Org != fromOrg {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	o, ok := x.findOrg(toOrgID)
+	if !ok {
+		return nil, deny(ErrInvalid, "unknown organization")
+	}
+	a := &transferUserAggregate{user: u, toOrg: o}
+	left := map[string]bool{}
+	for _, m := range x.membershipsOfUser(userID) {
+		if p, ok := x.findProject(m.ProjectID); ok && p.Org == o.ID {
+			continue
+		}
+		a.memberships = append(a.memberships, m)
+		left[m.ProjectID] = true
+	}
+	for _, t := range x.tasksAssignedTo(userID) {
+		if left[t.ProjectID] {
+			a.tasks = append(a.tasks, t)
+		}
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if a.user.Org == a.toOrg.ID {
+		return deny(ErrInvalid, "user already belongs to that organization")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) save(x *tx) UserView {
+	a.user.Org = a.toOrg.ID
+	a.user.OrgAdmin = false
+	a.user.save(x)
+	for _, m := range a.memberships {
+		m.destroy(x)
+	}
+	for _, t := range a.tasks {
+		t.AssigneeID = ""
+		t.save(x)
+	}
+	return UserView{ID: a.user.ID, OrgID: a.user.Org}
+}
+
