+func TestSetMemberRoles(t *testing.T) {
+	ok := `{"roles":{"ben":"viewer","dan":"contributor"}}`
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager", "ann", "web", ok, 200},
+		{"manager sets manager", "ivy", "ops", `{"roles":{"cat":"manager"}}`, 200},
+		{"contributor", "ben", "web", ok, 403},
+		{"viewer", "dan", "web", ok, 403},
+		{"manager of other project", "ann", "ops", ok, 403},
+		{"org admin", "eve", "web", ok, 403},
+		{"non member", "hal", "web", ok, 404},
+		{"other org", "gus", "web", ok, 404},
+		{"anonymous", "", "web", ok, 401},
+		{"unknown user", "zed", "web", ok, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"invalid role", "ann", "web", `{"roles":{"ben":"owner"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"malformed body", "ann", "web", `{"roles":`, 400},
+		{"target not a member", "ann", "web", `{"roles":{"ben":"viewer","hal":"viewer"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestSetMemberRolesResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got []memberRole
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []memberRole{
+		{"ann", "manager"}, {"ben", "viewer"}, {"cat", "contributor"},
+		{"dan", "contributor"}, {"ivy", "manager"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %d members want %d: %s", len(got), len(want), body)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("member %d: got %+v want %+v", i, got[i], want[i])
+		}
+	}
+}
+
+func TestSetMemberRolesIsAllOrNothing(t *testing.T) {
+	db, err := openSeededDB()
+	if err != nil {
+		t.Fatal(err)
+	}
+	s := &server{db: db}
+	// ben is a valid target, hal is not a member: the whole batch must fail.
+	req := httptest.NewRequest("PUT", "/projects/web/members", strings.NewReader(`{"roles":{"ben":"viewer","hal":"viewer"}}`))
+	req.Header.Set("X-User", "ann")
+	req.SetPathValue("pid", "web")
+	w := httptest.NewRecorder()
+	s.setMemberRoles(w, req)
+	if w.Code != 400 {
+		t.Fatalf("got %d want 400 body=%s", w.Code, w.Body.String())
+	}
+	var role string
+	if err := db.QueryRow(`SELECT role FROM memberships WHERE project_id = 'web' AND user_id = 'ben'`).Scan(&role); err != nil {
+		t.Fatal(err)
+	}
+	if role != "contributor" {
+		t.Fatalf("ben's role changed to %q despite the failed batch", role)
+	}
+}
