+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"other manager", "ivy", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+		{"missing project", "ann", "nope", 404},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeDemotesEveryone(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var members []frozenMember
+	if err := json.Unmarshal([]byte(body), &members); err != nil {
+		t.Fatalf("bad body %q: %v", body, err)
+	}
+	want := []string{"ann", "ben", "cat", "dan", "ivy"}
+	if len(members) != len(want) {
+		t.Fatalf("got %v want users %v", members, want)
+	}
+	for i, m := range members {
+		if m.UserID != want[i] || m.Role != "viewer" {
+			t.Fatalf("member %d = %+v, want %s as viewer", i, m, want[i])
+		}
+	}
+	// The roles are really stored, not only reported.
+	for _, u := range want {
+		if code, _ := do(t, h, "GET", "/projects/web/tasks", u, ""); code != 200 {
+			t.Fatalf("%s can no longer read the frozen project: %d", u, code)
+		}
+	}
+}
+
+func TestFreezeMakesProjectReadOnly(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatal(code)
+	}
+	cases := []struct {
+		name, user, method, path, body string
+	}{
+		{"manager creates", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"other manager creates", "ivy", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"contributor creates", "ben", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"manager updates", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"contributor updates own", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"manager deletes", "ann", "DELETE", "/projects/web/tasks/t1", ""},
+		{"manager freezes again", "ann", "POST", "/projects/web/freeze", ""},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			if code, _ := do(t, h, c.method, c.path, c.user, c.body); code != 403 {
+				t.Fatalf("got %d want 403", code)
+			}
+		})
+	}
+	// Frozen tasks are still there and readable.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t1", "ben", ""); code != 200 {
+		t.Fatalf("task t1 gone after freeze: %d", code)
+	}
+}
+
+func TestFreezeLeavesOtherProjectsAlone(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatal(code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/ops/tasks", "ivy", `{"title":"x"}`); code != 200 {
+		t.Fatalf("manager of another project lost write access: %d", code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`); code != 200 {
+		t.Fatalf("contributor of another project lost write access: %d", code)
+	}
+}
