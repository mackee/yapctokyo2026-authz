+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"other manager", "ivy", "ops", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"viewer in ops", "ann", "ops", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown project", "ann", "nope", 404},
+		{"archived", "ann", "legacy", 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResponse(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got []map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err, body)
+	}
+	users := []string{"ann", "ben", "cat", "dan", "ivy"}
+	if len(got) != len(users) {
+		t.Fatalf("want %d members, got %v", len(users), got)
+	}
+	for i, m := range got {
+		if len(m) != 2 || m["userId"] != users[i] || m["role"] != "viewer" {
+			t.Fatalf("member %d: %v", i, m)
+		}
+	}
+
+	// The manager is a viewer now, so nobody can freeze (or unfreeze) again.
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 403 {
+		t.Fatalf("second freeze: got %d want 403", code)
+	}
+}
+
+func TestFreezeBlocksTaskChanges(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatal(code, body)
+	}
+	cases := []struct {
+		name, method, user, path, body string
+	}{
+		{"manager creates", "POST", "ann", "/projects/web/tasks", `{"title":"x"}`},
+		{"other manager creates", "POST", "ivy", "/projects/web/tasks", `{"title":"x"}`},
+		{"contributor creates", "POST", "ben", "/projects/web/tasks", `{"title":"x"}`},
+		{"manager updates", "PATCH", "ann", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"contributor updates own", "PATCH", "ben", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"manager deletes", "DELETE", "ann", "/projects/web/tasks/t1", ""},
+		{"other manager deletes", "DELETE", "ivy", "/projects/web/tasks/t3", ""},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			if code, _ := do(t, h, c.method, c.path, c.user, c.body); code != 403 {
+				t.Fatalf("got %d want 403", code)
+			}
+		})
+	}
+
+	// Frozen tasks are untouched and still readable by every member.
+	code, body := do(t, h, "GET", "/projects/web/tasks", "dan", "")
+	if code != 200 {
+		t.Fatal(code)
+	}
+	var tasks []Task
+	json.Unmarshal([]byte(body), &tasks)
+	if len(tasks) != 3 || tasks[0].Status != "open" || tasks[0].AssigneeID != "ben" {
+		t.Fatalf("tasks changed: %+v", tasks)
+	}
+}
+
