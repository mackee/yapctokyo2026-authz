+type addMemberRequest struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func (s *server) addMember(w http.ResponseWriter, r *http.Request) {
+	s.store.mu.Lock()
+	defer s.store.mu.Unlock()
+
+	user := s.store.User(r.Header.Get("X-User"))
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	project := s.store.Project(r.PathValue("pid"))
+	if project == nil || project.OrgID != user.OrgID {
+		writeError(w, 404, "not found")
+		return
+	}
+	role := s.store.Role(project.ID, user.ID)
+	if role == "" && !user.OrgAdmin {
+		writeError(w, 404, "not found")
+		return
+	}
+	if role != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if project.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	var req addMemberRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || req.UserID == "" {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	if !validRoles[req.Role] {
+		writeError(w, 400, "invalid role")
+		return
+	}
+	target := s.store.User(req.UserID)
+	if target == nil || target.OrgID != project.OrgID {
+		writeError(w, 400, "user must belong to the project's organization")
+		return
+	}
+	if s.store.Role(project.ID, target.ID) != "" {
+		writeError(w, 409, "user is already a member")
+		return
+	}
+	s.store.AddMember(project.ID, target.ID, req.Role)
+	writeJSON(w, 201, addMemberRequest{UserID: target.ID, Role: req.Role})
+}
+
