+// changeMemberRoleAggregate changes the role of one project member.
+type changeMemberRoleAggregate struct {
+	membership *Membership
+	assigned   []*Task // membership.AssignedTasks: tasks that rely on a writer role
+	role       string
+}
+
+func loadChangeMemberRole(ctx context.Context, tx DB, projectID, userID, role string) (*changeMemberRoleAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	m, err := p.Membership(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	assigned, err := m.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &changeMemberRoleAggregate{membership: m, assigned: assigned, role: role}, nil
+}
+
+func (a *changeMemberRoleAggregate) validate() error {
+	if a.role != RoleManager && a.role != RoleContributor && a.role != RoleViewer {
+		return deny(ErrInvalid, "invalid role")
+	}
+	if !isWriterRole(a.role) && len(a.assigned) > 0 {
+		return deny(ErrInvalid, "member has assigned tasks; reassign them before making the member a viewer")
+	}
+	return nil
+}
+
+func (a *changeMemberRoleAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.membership.changeRole(ctx, tx, a.role); err != nil {
+		return nil, err
+	}
+	return a.membership, nil
+}
