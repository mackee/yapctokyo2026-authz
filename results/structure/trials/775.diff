+func TestUpdateMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager promotes", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"contributor", "ben", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"viewer", "dan", "/projects/web/members/dan", `{"role":"manager"}`, 403},
+		{"org admin", "eve", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"manager of other project", "ivy", "/projects/legacy/members/ben", `{"role":"viewer"}`, 404},
+		{"viewer in ops is not manager", "ann", "/projects/ops/members/cat", `{"role":"viewer"}`, 403},
+		{"non member actor", "hal", "/projects/web/members/dan", `{"role":"manager"}`, 404},
+		{"other org", "gus", "/projects/web/members/dan", `{"role":"manager"}`, 404},
+		{"anonymous", "", "/projects/web/members/dan", `{"role":"manager"}`, 401},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"invalid role", "ann", "/projects/web/members/dan", `{"role":"boss"}`, 400},
+		{"missing role", "ann", "/projects/web/members/dan", `{}`, 400},
+		{"demote with assigned tasks", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRoleEffect(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got struct{ UserID, Role string }
+	if err := json.Unmarshal([]byte(body), &got); err != nil || got.UserID != "dan" || got.Role != "contributor" {
+		t.Fatalf("unexpected response %s", body)
+	}
+	if !strings.Contains(body, `"userId"`) || !strings.Contains(body, `"role"`) {
+		t.Fatalf("bad JSON keys: %s", body)
+	}
+	// dan can now create tasks.
+	if code, body := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("promoted dan create: %d %s", code, body)
+	}
+	// Demoting a manager takes effect: ivy can no longer delete.
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ivy", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatal(code)
+	}
+	if code, _ := do(t, h, "DELETE", "/projects/web/tasks/t3", "ivy", ""); code != 403 {
+		t.Fatalf("demoted ivy delete: %d", code)
+	}
+}
