+// frozenMember is the JSON shape of a membership in the freeze response.
+type frozenMember struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func freezeProject(ctx tanukirpc.Context[*projectRegistry], _ struct{}) ([]frozenMember, error) {
+	reg := ctx.Registry()
+	ms, err := model.NewProjectTable().Freeze(ctx, reg.db, reg.authz)
+	if err != nil {
+		return nil, err
+	}
+	out := make([]frozenMember, 0, len(ms))
+	for _, m := range ms {
+		out = append(out, frozenMember{UserID: m.UserID, Role: m.Role})
+	}
+	return out, nil
+}
