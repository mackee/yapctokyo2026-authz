--- /dev/null
+++ b/freeze_test.go
@@ -0,0 +1,76 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestFreeze(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got []map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 5 {
+		t.Fatalf("want 5 members, got %s", body)
+	}
+	for _, m := range got {
+		if m["role"] != "viewer" || m["userId"] == "" {
+			t.Fatalf("bad member %v", m)
+		}
+	}
+
+	// nobody can modify tasks afterwards, including the former manager.
+	for _, c := range []struct{ user, method, path, body string }{
+		{"ann", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"ann", "DELETE", "/projects/web/tasks/t1", ""},
+		{"ann", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"ivy", "POST", "/projects/web/freeze", ""},
+	} {
+		if code, body := do(t, h, c.method, c.path, c.user, c.body); code != 403 {
+			t.Fatalf("%s %s as %s: got %d want 403 body=%s", c.method, c.path, c.user, code, body)
+		}
+	}
+	// reads still work; other projects are unaffected.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ann", ""); code != 200 {
+		t.Fatalf("read after freeze: %d", code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/ops/tasks/t4", "cat", `{"title":"y"}`); code != 200 {
+		t.Fatalf("other project affected: %d", code)
+	}
+}
+
+func TestFreezeDenied(t *testing.T) {
+	for _, c := range []struct {
+		name, user, path string
+		want             int
+	}{
+		{"contributor", "ben", "/projects/web/freeze", 403},
+		{"viewer", "dan", "/projects/web/freeze", 403},
+		{"org admin", "eve", "/projects/web/freeze", 403},
+		{"manager of another project", "ivy", "/projects/legacy/freeze", 404},
+		{"non-member", "hal", "/projects/web/freeze", 404},
+		{"other org", "gus", "/projects/web/freeze", 404},
+		{"unknown user", "nobody", "/projects/web/freeze", 401},
+		{"no user", "", "/projects/web/freeze", 401},
+		{"archived", "ann", "/projects/legacy/freeze", 409},
+		{"missing project", "ann", "/projects/nope/freeze", 404},
+	} {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			code, body := do(t, h, "POST", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+			// a denied freeze changes nothing.
+			if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 200 {
+				t.Fatalf("denied freeze changed roles: %d", code)
+			}
+		})
+	}
+}
