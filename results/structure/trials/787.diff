 // NewProjectTable returns the projects table.
 func NewProjectTable() *ProjectTable { return &ProjectTable{} }
 
+// Freeze makes every member of the project a viewer (managers included) and
+// returns the resulting memberships, all in one transaction.
+func (*ProjectTable) Freeze(ctx context.Context, db DB, authz ProjectAuthz) ([]*Membership, error) {
+	if err := authz.CanFreeze(); err != nil {
+		return nil, err
+	}
+	var ms []*Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		p, err := NewProjectTable().Find(ctx, tx, authz.ProjectID())
+		if err != nil {
+			return err
+		}
+		if ms, err = p.Memberships(ctx, tx); err != nil {
+			return err
+		}
+		for _, m := range ms {
+			if err := m.demote(ctx, tx); err != nil {
+				return err
+			}
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return ms, nil
+}
