 	return fmt.Sprintf("t%d", s.nextID)
 }
 
+// OrgExists reports whether any user or project belongs to the organization.
+// Organizations have no table of their own, so this is the closest check.
+func (s *Store) OrgExists(orgID string) bool {
+	for _, u := range s.users {
+		if u.OrgID == orgID {
+			return true
+		}
+	}
+	for _, p := range s.projects {
+		if p.OrgID == orgID {
+			return true
+		}
+	}
+	return false
+}
+
+// TransferUser moves u into toOrg. Project memberships in projects outside
+// toOrg are dropped so that nothing from the old organization survives a move,
+// including on a later move back. Org-admin rights are org-scoped and are not
+// carried over. Task assignments are left as they are.
+func (s *Store) TransferUser(u *User, toOrg string) {
+	for projectID, roles := range s.members {
+		if p := s.projects[projectID]; p == nil || p.OrgID != toOrg {
+			delete(roles, u.ID)
+		}
+	}
+	u.OrgID = toOrg
+	u.OrgAdmin = false
+}
+
 func (s *Store) PutTask(t *Task) { s.tasks[t.ID] = t }
 
 func (s *Store) DeleteTask(id string) { delete(s.tasks, id) }
