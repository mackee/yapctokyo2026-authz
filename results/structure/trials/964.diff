+// Move moves the user's membership from the authz project to dest, keeping the
+// role. The actor must be a manager of both projects.
+func (*MembershipTable) Move(ctx context.Context, db DB, authz, dest ProjectAuthz, userID string) (*Membership, error) {
+	if err := authz.CanMoveMembers(dest); err != nil {
+		return nil, err
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveMember(ctx, tx, authz.ProjectID(), userID, dest.ProjectID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		m, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
