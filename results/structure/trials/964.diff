+// CanMoveMembers returns nil if the actor may move a member from this project
+// to dest: manager in both (else ErrForbidden), and neither archived (else
+// ErrArchived).
+func (a ProjectAuthz) CanMoveMembers(dest ProjectAuthz) error {
+	if !a.CanRead() || !dest.CanRead() || a.role != RoleManager || dest.role != RoleManager {
+		return deny(ErrForbidden, "only managers of both projects may move members")
+	}
+	if a.archived || dest.archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	return nil
+}
