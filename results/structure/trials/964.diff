+// moveMemberAggregate moves one membership from one project to another,
+// keeping the role. Tasks the member had in the source project are unassigned,
+// since the member can no longer be their assignee.
+type moveMemberAggregate struct {
+	from  *Membership
+	dest  *Project
+	user  *User
+	tasks []*Task     // from.AssignedTasks
+	exist *Membership // dest.Membership(user), when already a member
+}
+
+func loadMoveMember(ctx context.Context, tx DB, fromProjectID, userID, destProjectID string) (*moveMemberAggregate, error) {
+	if fromProjectID == destProjectID {
+		return nil, deny(ErrInvalid, "destination must be a different project")
+	}
+	from, err := NewMembershipTable().Find(ctx, tx, fromProjectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	dest, err := NewProjectTable().Find(ctx, tx, destProjectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	u, err := from.User(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	a := &moveMemberAggregate{from: from, dest: dest, user: u}
+	if a.tasks, err = from.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	m, err := dest.Membership(ctx, tx, userID)
+	if err == nil {
+		a.exist = m
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.user.Org != a.dest.Org {
+		return deny(ErrInvalid, "member must belong to the destination project's organization")
+	}
+	if a.exist != nil {
+		return deny(ErrInvalid, "user is already a member of the destination project")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.from.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	moved := &Membership{ProjectID: a.dest.ID, UserID: a.from.UserID, Role: a.from.Role}
+	if err := moved.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return moved, nil
+}
+
