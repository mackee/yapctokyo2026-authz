@@ -0,0 +1,79 @@
+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+// POST /orgs/{orgID}/users/{uid}/transfer moves a user to another organization.
+// Only an org admin of the source organization may do it.
+
+func TestTransferAccess(t *testing.T) {
+	cases := []struct {
+		name, user, org, uid, body string
+		want                       int
+	}{
+		{"org admin transfers user", "eve", "acme", "ben", `{"toOrgId":"globex"}`, 200},
+		{"member of org is not admin", "ann", "acme", "ben", `{"toOrgId":"globex"}`, 403},
+		{"caller in other org", "gus", "acme", "ben", `{"toOrgId":"globex"}`, 404},
+		{"anonymous", "", "acme", "ben", `{"toOrgId":"globex"}`, 401},
+		{"unknown user caller", "zed", "acme", "ben", `{"toOrgId":"globex"}`, 401},
+		{"unknown target user", "eve", "acme", "zed", `{"toOrgId":"globex"}`, 404},
+		{"target user in other org", "eve", "acme", "gus", `{"toOrgId":"acme"}`, 404},
+		{"unknown destination org", "eve", "acme", "ben", `{"toOrgId":"nowhere"}`, 400},
+		{"same organization", "eve", "acme", "ben", `{"toOrgId":"acme"}`, 400},
+		{"missing toOrgId", "eve", "acme", "ben", `{}`, 400},
+		{"malformed body", "eve", "acme", "ben", `{`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/orgs/"+c.org+"/users/"+c.uid+"/transfer", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+	if body != `{"id":"ben","orgId":"globex"}`+"\n" {
+		t.Fatalf("unexpected body %q", body)
+	}
+}
+
+func TestTransferRevokesOldOrgAccess(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer got %d want 200", code)
+	}
+	// ben was a contributor in acme's web project; that membership is gone.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("old project read got %d want 404", code)
+	}
+	// ben's task t1 in web is unassigned now (the assignee must be a member).
+	code, body := do(t, srv, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("get task got %d want 200", code)
+	}
+	if !strings.Contains(body, `"assignee":""`) {
+		t.Fatalf("task t1 still assigned: %s", body)
+	}
+}
+
+func TestTransferDropsOrgAdminRights(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "eve", ""); code != 200 {
+		t.Fatalf("before transfer got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer got %d want 200", code)
+	}
+	// eve is no longer an acme org admin, so acme's projects are not readable.
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "eve", ""); code != 404 {
+		t.Fatalf("after transfer got %d want 404", code)
+	}
+}
