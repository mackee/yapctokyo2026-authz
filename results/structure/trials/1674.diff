+// transferUserAggregate moves one user to another organization. The user's
+// memberships in projects outside the destination organization go with them,
+// and so do the assignments of the user's tasks in those projects, since an
+// assignee must be a member of the task's project.
+type transferUserAggregate struct {
+	user        *User
+	toOrg       *Org
+	memberships []*Membership // memberships to remove
+	unassigned  []*Task       // tasks to unassign
+}
+
+func loadTransferUser(ctx context.Context, tx DB, fromOrgID string, in UserTableTransferInput) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, in.UserID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != fromOrgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	dst, err := NewOrgTable().Find(ctx, tx, in.ToOrgID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "destination organization does not exist")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &transferUserAggregate{user: u, toOrg: dst}
+
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	removed := map[string]bool{}
+	for _, m := range ms {
+		p, err := m.Project(ctx, tx)
+		if err != nil && !errors.Is(err, ErrNoRows) {
+			return nil, err
+		}
+		if err == nil && p.Org == dst.ID {
+			continue
+		}
+		a.memberships = append(a.memberships, m)
+		removed[m.ProjectID] = true
+	}
+
+	ts, err := u.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, t := range ts {
+		if removed[t.ProjectID] {
+			a.unassigned = append(a.unassigned, t)
+		}
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if a.toOrg.ID == a.user.Org {
+		return deny(ErrInvalid, "user already belongs to the organization")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	for _, t := range a.unassigned {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.user.moveTo(ctx, tx, a.toOrg.ID); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
