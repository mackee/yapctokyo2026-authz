--- /dev/null
+++ b/offboard_test.go
@@ -0,0 +1,63 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes", "eve", "/orgs/acme/users/ben", 204},
+		{"user without projects", "eve", "/orgs/acme/users/hal", 204},
+		{"manager forbidden", "ann", "/orgs/acme/users/ben", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"other org", "eve", "/orgs/globex/users/gus", 404},
+		{"user of other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	// ben was a member of web and legacy; he can no longer read either.
+	for _, p := range []string{"web", "legacy"} {
+		if code, _ := do(t, h, "GET", "/projects/"+p+"/tasks", "ben", ""); code != 404 {
+			t.Fatalf("ben still reads %s: %d", p, code)
+		}
+	}
+	// His tasks are unassigned; others are untouched.
+	code, body := do(t, h, "GET", "/projects/web/tasks", "ann", "")
+	if code != 200 {
+		t.Fatal(code)
+	}
+	var tasks []Task
+	if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+		t.Fatal(err)
+	}
+	for _, task := range tasks {
+		if task.AssigneeID == "ben" {
+			t.Fatalf("task %s still assigned to ben", task.ID)
+		}
+		if task.ID == "t2" && task.AssigneeID != "cat" {
+			t.Fatalf("t2 assignee changed: %q", task.AssigneeID)
+		}
+	}
+	// Other members keep access.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat lost access: %d", code)
+	}
+}
