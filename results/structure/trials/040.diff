+// SetAllRoles gives every member of the project the same role.
+func (s *Store) SetAllRoles(projectID, role string) {
+	for userID := range s.members[projectID] {
+		s.members[projectID][userID] = role
+	}
+}
+
+// Members returns the project's memberships sorted by user ID.
+func (s *Store) Members(projectID string) []Member {
+	out := []Member{}
+	for userID, role := range s.members[projectID] {
+		out = append(out, Member{UserID: userID, Role: role})
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].UserID < out[j].UserID })
+	return out
+}
