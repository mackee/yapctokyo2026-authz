+  // PUT /projects/{pid}/members {"roles": {user: role, ...}}
+  // Manager-only bulk role change. All-or-nothing: every listed user must be a
+  // current member of the project and every role must be a valid role, and the
+  // map must not be empty (400 otherwise).
+  def membersOutcome(u: UserId, p: ProjectId, roles: UserId -> Role): int =
+    if (not(userExists(u))) 401
+    else if (not(canRead(u, p))) 404
+    else if (roleOf(p, u) != "manager") 403
+    else if (projects.get(p).archived) 409
+    else if (roles.keys().size() == 0) 400
+    else if (roles.keys().exists(x => not(ROLES.contains(roles.get(x))) or roleOf(p, x) == "")) 400
+    else 200
+
+  // Role of x in p after applying a role change.
+  def newRoleOf(p: ProjectId, x: UserId, roles: UserId -> Role): Role =
+    if (roles.keys().contains(x)) roles.get(x) else roleOf(p, x)
+
   // ---- actions -------------------------------------------------------------
 
   action unchanged = all {
@@ -164,6 +181,23 @@ module taskboard {
