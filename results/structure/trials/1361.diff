+  // A member demoted to viewer can no longer be an assignee, so their tasks in
+  // the project become unassigned (keeps inv_assigneeIsWriter).
+  action changeMembers(u: UserId, p: ProjectId, roles: UserId -> Role): bool =
+    if (membersOutcome(u, p, roles) == 200) all {
+      members' = members.keys().mapBy(k =>
+        if (k._1 == p) newRoleOf(p, k._2, roles) else members.get(k)),
+      tasks' = tasks.keys().mapBy(t => {
+        val x = tasks.get(t)
+        if (x.project == p and x.assignee != "" and newRoleOf(p, x.assignee, roles) == "viewer")
+          { ...x, assignee: "" }
+        else x
+      }),
+      nextTask' = nextTask,
+      users' = users,
+      projects' = projects,
+    } else unchanged
+
