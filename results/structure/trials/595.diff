+// transferUserAggregate moves one user to another organization. Project
+// members must belong to the project's organization and assignees must be
+// members, so the user leaves every project outside the new organization and
+// the tasks assigned to them there become unassigned. Org admin rights do not
+// carry over.
+type transferUserAggregate struct {
+	user      *User
+	toOrg     string
+	orgExists bool
+	leaving   []*Membership // memberships in projects outside toOrg
+}
+
+func loadTransferUser(ctx context.Context, tx DB, fromOrg, userID, toOrg string) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != fromOrg {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	a := &transferUserAggregate{user: u, toOrg: toOrg}
+	if a.orgExists, err = NewUserTable().OrgExists(ctx, tx, toOrg); err != nil {
+		return nil, err
+	}
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, m := range ms {
+		p, err := m.Project(ctx, tx)
+		if errors.Is(err, ErrNoRows) {
+			a.leaving = append(a.leaving, m)
+			continue
+		} else if err != nil {
+			return nil, err
+		}
+		if p.Org != toOrg {
+			a.leaving = append(a.leaving, m)
+		}
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if a.toOrg == a.user.Org {
+		return deny(ErrInvalid, "user already belongs to that organization")
+	}
+	if !a.orgExists {
+		return deny(ErrInvalid, "unknown organization")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	for _, m := range a.leaving {
+		tasks, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		for _, t := range tasks {
+			if err := t.unassign(ctx, tx); err != nil {
+				return nil, err
+			}
+		}
+		if err := m.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.user.moveTo(ctx, tx, a.toOrg); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
+
