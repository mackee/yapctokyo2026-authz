+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager removes contributor", "ann", "/projects/web/members/ben", 204},
+		{"manager removes viewer", "ann", "/projects/web/members/dan", 204},
+		{"contributor", "ben", "/projects/web/members/cat", 403},
+		{"viewer", "dan", "/projects/web/members/cat", 403},
+		{"org admin", "eve", "/projects/web/members/ben", 403},
+		{"non member", "hal", "/projects/web/members/ben", 404},
+		{"other org", "gus", "/projects/web/members/ben", 404},
+		{"anonymous", "", "/projects/web/members/ben", 401},
+		{"unknown user", "zed", "/projects/web/members/ben", 401},
+		{"target not a member", "ann", "/projects/web/members/hal", 404},
+		{"target in other project", "ann", "/projects/web/members/gus", 404},
+		{"target unknown", "ann", "/projects/web/members/zed", 404},
+		{"archived", "ann", "/projects/legacy/members/ben", 409},
+		{"missing project", "ann", "/projects/missing/members/ben", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveMemberUnassignsOnlyThatProject(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "DELETE", "/projects/web/members/ben", "ann", ""); code != 204 {
+		t.Fatalf("remove: got %d %s", code, body)
+	}
+
+	// ben is no longer a member of web: he can no longer read it.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads web after removal: got %d want 404", code)
+	}
+
+	// ben's task in web is unassigned; other assignees are untouched.
+	assignee := func(path string) string {
+		t.Helper()
+		code, body := do(t, srv, "GET", path, "ann", "")
+		if code != 200 {
+			t.Fatalf("GET %s: got %d", path, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		return task.AssigneeID
+	}
+	if got := assignee("/projects/web/tasks/t1"); got != "" {
+		t.Fatalf("t1 assignee = %q, want unassigned", got)
+	}
+	if got := assignee("/projects/web/tasks/t2"); got != "cat" {
+		t.Fatalf("t2 assignee = %q, want cat", got)
+	}
+
+	// ben's membership in legacy and his task there are unchanged.
+	if got := assignee("/projects/legacy/tasks/t5"); got != "ben" {
+		t.Fatalf("t5 assignee = %q, want ben", got)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/legacy/tasks", "ben", ""); code != 200 {
+		t.Fatalf("ben reads legacy after removal from web: got %d", code)
+	}
+}
