-// MembershipTable reads the memberships table.
+// MembershipTable is the memberships table.
+//
+// Find and List* read rows. Delete is the API operation that removes a member
+// from a project; it takes the database, the project's authorization object
+// and the member's user ID, asks the authorization object whether the actor may
+// remove members, then runs removeMemberAggregate (aggregate.go) in a transaction.
 type MembershipTable struct{}
 
 // NewMembershipTable returns the memberships table.
 func NewMembershipTable() *MembershipTable { return &MembershipTable{} }
 
+// Delete removes userID from the project. The target must be a member
+// (ErrNotFound otherwise); the actor must be a manager (ErrForbidden) and the
+// project must not be archived (ErrArchived).
+func (mt *MembershipTable) Delete(ctx context.Context, db DB, authz ProjectAuthz, userID string) error {
+	return inTx(ctx, db, func(tx DB) error {
+		m, err := mt.Find(ctx, tx, authz.ProjectID(), userID)
+		if errors.Is(err, ErrNoRows) {
+			return deny(ErrNotFound, "not found")
+		} else if err != nil {
+			return err
+		}
+		if err := authz.CanManageMembers(); err != nil {
+			return err
+		}
+		agg, err := loadRemoveMember(ctx, tx, m)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
+
