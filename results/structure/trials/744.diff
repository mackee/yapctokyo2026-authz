+// RemoveFromOrganization removes the user from every project of the
+// organization, all or nothing: the user's memberships in those projects are
+// deleted and the tasks the user holds there are unassigned. The actor must be
+// an org admin of the organization (else ErrForbidden), and the user must belong
+// to it (else ErrNotFound). Archived projects are not checked, so archiving
+// never blocks removing access. A user with no memberships there succeeds.
+func (*UserTable) RemoveFromOrganization(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanManageMembers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveOrgUser(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
