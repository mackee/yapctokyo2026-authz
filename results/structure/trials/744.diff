+func TestRemoveOrgUserEffects(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("got %d want 204 body=%s", code, body)
+	}
+
+	// ben is out of every acme project, including the archived one.
+	for _, path := range []string{"/projects/web/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, srv, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("GET %s as ben: got %d want 404", path, code)
+		}
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 404 {
+		t.Fatalf("POST as ben: got %d want 404", code)
+	}
+
+	// Other members keep their access.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ann", ""); code != 200 {
+		t.Fatalf("ann lost access: got %d", code)
+	}
+
+	// Tasks ben held are unassigned, not left pointing at a non-member.
+	for _, path := range []string{"/projects/web/tasks/t1", "/projects/legacy/tasks/t5"} {
+		code, body := do(t, srv, "GET", path, "ann", "")
+		if code != 200 {
+			t.Fatalf("GET %s: got %d", path, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.AssigneeID != "" {
+			t.Fatalf("%s still assigned to %q", path, task.AssigneeID)
+		}
+	}
+
+	// Tasks in projects ben was never in are untouched.
+	if code, body := do(t, srv, "GET", "/projects/ops/tasks/t4", "ann", ""); code != 200 || !strings.Contains(body, `"assignee":"cat"`) {
+		t.Fatalf("ops task changed: %d %s", code, body)
+	}
+}
