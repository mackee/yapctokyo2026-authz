 func (a *deleteTaskAggregate) apply(ctx context.Context, tx DB) error { return a.task.destroy(ctx, tx) }
+
+// removeOrgUserAggregate removes one user from the projects of an organization.
+// Its memberships in those projects are deleted, and the tasks it holds there
+// are unassigned, so no task is left assigned to a non-member (the assignee
+// rule in the model rules above).
+type removeOrgUserAggregate struct {
+	memberships []*Membership // the user's memberships in the organization's projects
+	tasks       []*Task       // the tasks assigned to the user in the organization's projects
+}
+
+func loadRemoveOrgUser(ctx context.Context, tx DB, orgID, userID string) (*removeOrgUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != orgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	a := &removeOrgUserAggregate{}
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, m := range ms {
+		ok, err := projectInOrg(ctx, tx, m.ProjectID, orgID)
+		if err != nil {
+			return nil, err
+		}
+		if ok {
+			a.memberships = append(a.memberships, m)
+		}
+	}
+	ts, err := u.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, t := range ts {
+		ok, err := projectInOrg(ctx, tx, t.ProjectID, orgID)
+		if err != nil {
+			return nil, err
+		}
+		if ok {
+			a.tasks = append(a.tasks, t)
+		}
+	}
+	return a, nil
+}
+
+func (a *removeOrgUserAggregate) validate() error { return nil }
+
+func (a *removeOrgUserAggregate) apply(ctx context.Context, tx DB) error {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// projectInOrg reports whether the project exists and belongs to the organization.
+func projectInOrg(ctx context.Context, tx DB, projectID, orgID string) (bool, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return false, nil
+	} else if err != nil {
+		return false, err
+	}
+	return p.Org == orgID, nil
+}
