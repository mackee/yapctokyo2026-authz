+// Move moves the member userID from the project of from to the project
+// toProjectID, with the same role. The target project must be readable by the
+// actor (else ErrNotFound). Managers of both projects only. The member's tasks
+// in the source project are unassigned, all or nothing.
+func (*MembershipTable) Move(ctx context.Context, db DB, from ProjectAuthz, toProjectID, userID string) (*Membership, error) {
+	if toProjectID == from.ProjectID() {
+		return nil, deny(ErrInvalid, "target project must differ from the source project")
+	}
+	to, err := NewProjectAuthz(ctx, db, from.Actor(), toProjectID)
+	if err != nil {
+		return nil, err
+	}
+	if err := from.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if err := to.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var moved *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveMember(ctx, tx, from.ProjectID(), toProjectID, userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		moved, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return moved, nil
+}
