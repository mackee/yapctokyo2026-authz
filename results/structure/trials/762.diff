+// moveMemberAggregate moves one member from the source project to the target
+// project with the same role.
+type moveMemberAggregate struct {
+	member *Membership // the member's row in the source project
+	from   *Project
+	to     *Project
+	user   *User
+	tasks  []*Task // the source project's tasks assigned to the member
+}
+
+func loadMoveMember(ctx context.Context, tx DB, fromID, toID, userID string) (*moveMemberAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, fromID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "member not found")
+	} else if err != nil {
+		return nil, err
+	}
+	from, err := NewProjectTable().Find(ctx, tx, fromID)
+	if err != nil {
+		return nil, err
+	}
+	to, err := NewProjectTable().Find(ctx, tx, toID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if err != nil {
+		return nil, err
+	}
+	if _, err := NewMembershipTable().Find(ctx, tx, toID, userID); err == nil {
+		return nil, deny(ErrInvalid, "user is already a member of the target project")
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	tasks, err := m.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &moveMemberAggregate{member: m, from: from, to: to, user: u, tasks: tasks}, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.user.Org != a.to.Org {
+		return deny(ErrInvalid, "member must belong to the target project's organization")
+	}
+	return nil
+}
+
+// apply unassigns the member's tasks in the source project (the member is no
+// longer a member there, and an assignee must be a member of the task's
+// project), removes the source membership and adds the target membership.
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.member.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	moved := &Membership{ProjectID: a.to.ID, UserID: a.member.UserID, Role: a.member.Role}
+	if err := moved.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return moved, nil
+}
+
