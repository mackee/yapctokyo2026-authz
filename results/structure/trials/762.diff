diff --git a/move_test.go b/move_test.go
new file mode 100644
index 0000000..3c84ab1
--- /dev/null
+++ b/move_test.go
@@ -0,0 +1,82 @@
+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestMoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, project, uid, body string
+		want                           int
+	}{
+		{"anonymous", "", "web", "ben", `{"toProjectId":"ops"}`, 401},
+		{"unknown user", "zed", "web", "ben", `{"toProjectId":"ops"}`, 401},
+		{"bad body", "ivy", "web", "ben", `not json`, 400},
+		{"missing target", "ivy", "web", "ben", `{}`, 400},
+		{"same project", "ivy", "web", "ben", `{"toProjectId":"web"}`, 400},
+		{"non member of source", "ivy", "web", "hal", `{"toProjectId":"ops"}`, 404},
+		{"target missing", "ivy", "web", "ben", `{"toProjectId":"nope"}`, 404},
+		{"target not readable", "ivy", "web", "ben", `{"toProjectId":"legacy"}`, 404},
+		{"target other org", "ivy", "web", "ben", `{"toProjectId":"gx"}`, 404},
+		{"manager of both", "ivy", "web", "ben", `{"toProjectId":"ops"}`, 200},
+		{"manager of source, viewer of target", "ann", "web", "cat", `{"toProjectId":"ops"}`, 403},
+		{"contributor of source, readable target", "ben", "web", "cat", `{"toProjectId":"legacy"}`, 403},
+		{"contributor of source, unreadable target", "ben", "web", "cat", `{"toProjectId":"ops"}`, 404},
+		{"viewer of source, unreadable target", "dan", "web", "ben", `{"toProjectId":"ops"}`, 404},
+		{"org admin", "eve", "web", "cat", `{"toProjectId":"ops"}`, 403},
+		{"already member of target", "ivy", "web", "cat", `{"toProjectId":"ops"}`, 400},
+		{"target archived", "ann", "web", "cat", `{"toProjectId":"legacy"}`, 409},
+		{"source archived", "ann", "legacy", "ben", `{"toProjectId":"ops"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", "/projects/"+c.project+"/members/"+c.uid+"/move", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestMoveMemberEffects(t *testing.T) {
+	srv := newServer()
+
+	code, body := do(t, srv, "POST", "/projects/web/members/ben/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("move: got %d body=%s", code, body)
+	}
+	if want := `{"userId":"ben","projectId":"ops","role":"contributor"}`; strings.TrimSpace(body) != want {
+		t.Fatalf("response: got %s want %s", body, want)
+	}
+
+	// ben is no longer a member of web...
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads web after move: got %d want 404", code)
+	}
+	// ...and is a contributor of ops now: can write there, and only own tasks.
+	if code, body := do(t, srv, "POST", "/projects/ops/tasks", "ben", `{"title":"x","assignee":"ben"}`); code != 200 {
+		t.Fatalf("ben creates in ops: got %d body=%s", code, body)
+	}
+
+	// ben's task in web is unassigned; other people's tasks are untouched.
+	code, body = do(t, srv, "GET", "/projects/web/tasks/t1", "ivy", "")
+	if code != 200 || !strings.Contains(body, `"assignee":""`) {
+		t.Fatalf("t1 after move: got %d body=%s, want unassigned", code, body)
+	}
+	code, body = do(t, srv, "GET", "/projects/web/tasks/t2", "ivy", "")
+	if code != 200 || !strings.Contains(body, `"assignee":"cat"`) {
+		t.Fatalf("t2 after move: got %d body=%s, want assignee cat", code, body)
+	}
+}
+
+func TestMoveMemberRefusedLeavesMembershipAlone(t *testing.T) {
+	srv := newServer()
+
+	if code, body := do(t, srv, "POST", "/projects/web/members/cat/move", "ann", `{"toProjectId":"ops"}`); code != 403 {
+		t.Fatalf("move: got %d body=%s want 403", code, body)
+	}
+	if code, body := do(t, srv, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat reads web after refused move: got %d body=%s want 200", code, body)
+	}
+}
