+type moveRequest struct {
+	ToProjectID string `json:"toProjectId"`
+}
+
+// moveMember moves a member to another project, keeping the role. The caller
+// must be a manager of both projects. Tasks of the source project assigned to
+// the member become unassigned (assignees must be writers of their project).
+func (s *server) moveMember(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user, err := findUser(ctx, s.db, r.Header.Get("X-User"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if user == nil {
+		writeError(w, 401, "unauthenticated")
+		return
+	}
+	// readable returns the project if the caller may read it, else nil, plus the caller's role.
+	readable := func(id string) (*project, string, error) {
+		p, err := findProject(ctx, s.db, id)
+		if err != nil || p == nil || p.OrgID != user.OrgID {
+			return nil, "", err
+		}
+		role, err := findRole(ctx, s.db, p.ID, user.ID)
+		if err != nil {
+			return nil, "", err
+		}
+		if role == "" && !user.OrgAdmin {
+			return nil, "", nil
+		}
+		return p, role, nil
+	}
+	src, srcRole, err := readable(r.PathValue("pid"))
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if src == nil {
+		writeError(w, 404, "not found")
+		return
+	}
+	memberID := r.PathValue("uid")
+	memberRole, err := findRole(ctx, s.db, src.ID, memberID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if memberRole == "" {
+		writeError(w, 404, "not found")
+		return
+	}
+	var req moveRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || req.ToProjectID == "" {
+		writeError(w, 400, "invalid request body")
+		return
+	}
+	dest, destRole, err := readable(req.ToProjectID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if dest == nil {
+		writeError(w, 404, "not found")
+		return
+	}
+	if srcRole != RoleManager || destRole != RoleManager {
+		writeError(w, 403, "forbidden")
+		return
+	}
+	if src.ID == dest.ID {
+		writeError(w, 400, "source and destination are the same project")
+		return
+	}
+	if src.Archived || dest.Archived {
+		writeError(w, 409, "project is archived")
+		return
+	}
+	existing, err := findRole(ctx, s.db, dest.ID, memberID)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if existing != "" {
+		writeError(w, 409, "user is already a member of the destination project")
+		return
+	}
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	defer tx.Rollback()
+	if _, err := tx.ExecContext(ctx, `DELETE FROM memberships WHERE project_id = ? AND user_id = ?`, src.ID, memberID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if _, err := tx.ExecContext(ctx, `INSERT INTO memberships (project_id, user_id, role) VALUES (?, ?, ?)`, dest.ID, memberID, memberRole); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if _, err := tx.ExecContext(ctx, `UPDATE tasks SET assignee = '' WHERE project_id = ? AND assignee = ?`, src.ID, memberID); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	if err := tx.Commit(); err != nil {
+		writeError(w, 500, "internal error")
+		return
+	}
+	writeJSON(w, 200, map[string]string{"userId": memberID, "projectId": dest.ID, "role": memberRole})
+}
