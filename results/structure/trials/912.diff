@@ -17,3 +17,49 @@ func (*UserTable) Find(ctx context.Context, db DB, id string) (*User, error) {
 	}
 	return &u, nil
 }
+
+// OrgExists reports whether the organization exists. There is no organizations
+// table: an organization exists when at least one user belongs to it.
+func (*UserTable) OrgExists(ctx context.Context, db DB, orgID string) (bool, error) {
+	var n int
+	if err := db.QueryRowContext(ctx, `SELECT COUNT(*) FROM users WHERE org_id = ?`, orgID).Scan(&n); err != nil {
+		return false, err
+	}
+	return n > 0, nil
+}
+
+// ---- operations -----------------------------------------------------------------------
+
+// Transfer moves the user from the authorization object's organization to
+// toOrg, all or nothing. Only org admins of that organization may do it. The
+// user must belong to the organization, and must not be a member of any
+// project (project members belong to the project's organization). The user
+// loses org admin rights, which are per organization.
+func (ut *UserTable) Transfer(ctx context.Context, db DB, authz OrgAuthz, userID, toOrg string) (*User, error) {
+	if err := authz.CanTransferUsers(); err != nil {
+		return nil, err
+	}
+	if toOrg == "" {
+		return nil, deny(ErrInvalid, "toOrgId must not be empty")
+	}
+	if toOrg == authz.OrgID() {
+		return nil, deny(ErrInvalid, "user already belongs to this organization")
+	}
+	var u *User
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadTransferUser(ctx, tx, authz.OrgID(), userID, toOrg)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if u, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return u, nil
+}
