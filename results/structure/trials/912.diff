+// transferUserAggregate moves one user to another organization.
+type transferUserAggregate struct {
+	user         *User
+	toOrg        string
+	memberships  []*Membership // the user's project memberships; must be none
+	targetExists bool
+}
+
+func loadTransferUser(ctx context.Context, tx DB, fromOrg, userID, toOrg string) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != fromOrg {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	exists, err := NewUserTable().OrgExists(ctx, tx, toOrg)
+	if err != nil {
+		return nil, err
+	}
+	return &transferUserAggregate{user: u, toOrg: toOrg, memberships: ms, targetExists: exists}, nil
+}
+
+func (a *transferUserAggregate) validate() error {
+	if !a.targetExists {
+		return deny(ErrInvalid, "target organization does not exist")
+	}
+	if len(a.memberships) > 0 {
+		return deny(ErrInvalid, "user is a project member; remove the memberships before transferring")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	a.user.Org = a.toOrg
+	a.user.OrgAdmin = false
+	if err := a.user.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
+
