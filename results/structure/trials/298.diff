+// ---- organization capabilities -----------------------------------------------
+
+type orgScope struct {
+	as  *actorScope
+	oid string
+}
+
+func (s *orgScope) ID() string { return s.oid }
+
+// Manage applies the organization rule: the actor must belong to the
+// organization (else 404), and must be an org admin of it (else 403).
+func (s *orgScope) Manage() (ManageOrg, error) {
+	act := s.as.actor
+	if act.org != s.oid {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if !act.orgAdmin {
+		return nil, deny(ErrForbidden, "forbidden")
+	}
+	return &manageOrg{os: s}, nil
+}
+
+// ManageOrg may administer one organization: currently, removing a user from
+// every project of that organization.
+type ManageOrg interface {
+	// RemoveUser removes the user from all projects of the organization. Tasks
+	// the user was assigned to in those projects become unassigned. The user
+	// is not deleted and keeps any other membership, such as the organization
+	// itself. A user who is not a user of the organization is 404.
+	RemoveUser(userID string) error
+}
+
+type manageOrg struct{ os *orgScope }
+
+func (o *manageOrg) RemoveUser(userID string) error {
+	return o.os.as.a.st.tx(func(s *state) error {
+		u, ok := s.users[userID]
+		if !ok || u.org != o.os.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		for pid, m := range s.members {
+			if s.projects[pid].org != o.os.oid {
+				continue
+			}
+			delete(m, userID)
+		}
+		for tid, t := range s.tasks {
+			if s.projects[t.project].org != o.os.oid || t.assignee.user != userID {
+				continue
+			}
+			t.assignee = Assignee{project: t.project}
+			s.tasks[tid] = t
+		}
+		return nil
+	})
+}
+
