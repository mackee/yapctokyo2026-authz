+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin again (idempotent)", "eve", "/orgs/acme/users/dan", 204},
+		{"project manager is not org admin", "ann", "/orgs/acme/users/ben", 403},
+		{"contributor", "ben", "/orgs/acme/users/cat", 403},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+		{"admin of other org", "gus", "/orgs/acme/users/ben", 404},
+		{"org admin on other org", "eve", "/orgs/globex/users/gus", 404},
+		{"user of other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ben", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d %s", code, body)
+	}
+
+	// ben is gone from every acme project, including the archived one.
+	for _, path := range []string{"/projects/web/tasks", "/projects/legacy/tasks"} {
+		if code, _ := do(t, h, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("ben GET %s: got %d want 404", path, code)
+		}
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t1", "ben", ""); code != 404 {
+		t.Fatalf("ben GET t1: got %d want 404", code)
+	}
+
+	// ben's task in web is unassigned; the other task assignments are untouched.
+	code, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	if code != 200 {
+		t.Fatalf("ann GET t1: got %d", code)
+	}
+	var v Task
+	if err := json.Unmarshal([]byte(body), &v); err != nil {
+		t.Fatal(err)
+	}
+	if v.Assignee != "" {
+		t.Fatalf("t1 assignee = %q, want unassigned", v.Assignee)
+	}
+	code, body = do(t, h, "GET", "/projects/web/tasks/t2", "ann", "")
+	if code != 200 || !strings.Contains(body, `"assignee":"cat"`) {
+		t.Fatalf("t2 changed: %d %s", code, body)
+	}
+
+	// Removal also covers the archived project: ben's task there is unassigned.
+	code, body = do(t, h, "GET", "/projects/legacy/tasks/t5", "ann", "")
+	if code != 200 || !strings.Contains(body, `"assignee":""`) {
+		t.Fatalf("legacy t5: %d %s", code, body)
+	}
+
+	// Other users' memberships are unaffected.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t2", "cat", ""); code != 200 {
+		t.Fatalf("cat lost access: %d", code)
+	}
+
+	// The user still exists, so a write as ben is refused as a non-member, not a 401.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 404 {
+		t.Fatalf("ben POST: got %d want 404", code)
+	}
+}
