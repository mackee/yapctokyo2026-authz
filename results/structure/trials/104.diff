+func TestHandover(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager", "ann", "/projects/web/members/ben/handover", `{"to":"cat"}`, 200},
+		{"contributor", "ben", "/projects/web/members/cat/handover", `{"to":"ben"}`, 403},
+		{"viewer", "dan", "/projects/web/members/ben/handover", `{"to":"cat"}`, 403},
+		{"org admin", "eve", "/projects/web/members/ben/handover", `{"to":"cat"}`, 403},
+		{"non member", "hal", "/projects/web/members/ben/handover", `{"to":"cat"}`, 404},
+		{"other org", "gus", "/projects/web/members/ben/handover", `{"to":"cat"}`, 404},
+		{"anonymous", "", "/projects/web/members/ben/handover", `{"to":"cat"}`, 401},
+		{"archived", "ann", "/projects/legacy/members/ben/handover", `{"to":"ann"}`, 409},
+		{"to viewer", "ann", "/projects/web/members/ben/handover", `{"to":"dan"}`, 400},
+		{"to non member", "ann", "/projects/web/members/ben/handover", `{"to":"hal"}`, 400},
+		{"to other org", "ann", "/projects/web/members/ben/handover", `{"to":"gus"}`, 400},
+		{"to unknown", "ann", "/projects/web/members/ben/handover", `{"to":"zed"}`, 400},
+		{"to empty", "ann", "/projects/web/members/ben/handover", `{"to":""}`, 400},
+		{"no body", "ann", "/projects/web/members/ben/handover", ``, 400},
+		{"no tasks", "ann", "/projects/web/members/dan/handover", `{"to":"cat"}`, 200},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestHandoverMovesTasks(t *testing.T) {
+	srv := newServer()
+
+	// Give cat a second task in web, plus keep the existing unassigned t3 and
+	// cat's ops task t4 as bystanders.
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "ann", `{"title":"extra","assignee":"cat"}`); code != 201 {
+		t.Fatalf("setup create: %d", code)
+	}
+
+	code, body := do(t, srv, "POST", "/projects/web/members/cat/handover", "ann", `{"to":"ben"}`)
+	if code != 200 {
+		t.Fatalf("handover: %d %s", code, body)
+	}
+	var moved []Task
+	if err := json.Unmarshal([]byte(body), &moved); err != nil {
+		t.Fatal(err)
+	}
+	if len(moved) != 2 || moved[0].ID != "t2" || moved[1].ID != "t7" {
+		t.Fatalf("moved = %+v, want t2 and t7", moved)
+	}
+	for _, task := range moved {
+		if task.Assignee != "ben" || task.ProjectID != "web" {
+			t.Fatalf("task %s not handed over: %+v", task.ID, task)
+		}
+	}
+
+	// The change is visible through the normal read path.
+	_, body = do(t, srv, "GET", "/projects/web/tasks", "ann", "")
+	var tasks []Task
+	json.Unmarshal([]byte(body), &tasks)
+	got := map[string]string{}
+	for _, task := range tasks {
+		got[task.ID] = task.Assignee
+	}
+	want := map[string]string{"t1": "ben", "t2": "ben", "t3": "", "t7": "ben"}
+	for id, assignee := range want {
+		if got[id] != assignee {
+			t.Fatalf("task %s assignee = %q, want %q", id, got[id], assignee)
+		}
+	}
+
+	// Other projects are untouched.
+	_, body = do(t, srv, "GET", "/projects/ops/tasks/t4", "ann", "")
+	var t4 Task
+	json.Unmarshal([]byte(body), &t4)
+	if t4.Assignee != "cat" {
+		t.Fatalf("ops task t4 assignee = %q, want cat", t4.Assignee)
+	}
+
+	// Nothing left to hand over: empty array, not null.
+	code, body = do(t, srv, "POST", "/projects/web/members/cat/handover", "ann", `{"to":"ben"}`)
+	if code != 200 || body != "[]\n" {
+		t.Fatalf("second handover: %d %q, want 200 []", code, body)
+	}
+}
+
