+// Manage applies the manager rule: readable, manager (else 403; org admins
+// without a project role are 403 too), not archived (else 409).
+func (s *projectScope) Manage() (ManageProject, error) {
+	var role string
+	err := s.as.a.st.read(func(st *state) error {
+		p, r, err := readable(st, s.as.actor, s.pid)
+		if err != nil {
+			return err
+		}
+		if r != RoleManager {
+			return deny(ErrForbidden, "forbidden")
+		}
+		if p.archived {
+			return deny(ErrArchived, "project is archived")
+		}
+		role = r
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &manageProject{writeProject{readProject: readProject{ps: s}, role: role}}, nil
+}
