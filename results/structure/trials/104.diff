+	if err != nil {
+		return nil, err
+	}
+	var req handoverRequest
+	if err := decodeBody(ctx.Request(), &req); err != nil || req.To == "" {
+		return nil, errInvalidBody
+	}
+	return p.Handover(chi.URLParam(ctx.Request(), "uid"), req.To)
