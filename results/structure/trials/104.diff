+
+func (p *manageProject) Handover(fromUser, toUser string) ([]TaskView, error) {
+	if toUser == "" {
+		return nil, deny(ErrInvalid, "to is required")
+	}
+	out := []TaskView{}
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		a, err := admit(s, p.ps.pid, toUser)
+		if err != nil {
+			return err
+		}
+		out = []TaskView{}
+		for id, t := range s.tasks {
+			// An empty fromUser must never match unassigned tasks.
+			if t.project != p.ps.pid || fromUser == "" || t.assignee.user != fromUser {
+				continue
+			}
+			t.assignee = a
+			s.tasks[id] = t
+			out = append(out, t.view())
+		}
+		sort.Slice(out, func(i, j int) bool { return out[i].ID < out[j].ID })
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return out, nil
+}
