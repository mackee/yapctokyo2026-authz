+// MembershipTableUpdateRolesInput is the input of MembershipTable.UpdateRoles.
+// Roles maps user ID -> new role.
+type MembershipTableUpdateRolesInput struct {
+	Roles map[string]string
+}
+
+// UpdateRoles changes the roles of several members of the project, all or
+// nothing. Every user in Roles must be a member of the project and every role
+// must be valid; otherwise nothing changes. It returns the project's members
+// after the change, ordered by user ID.
+func (*MembershipTable) UpdateRoles(ctx context.Context, db DB, authz ProjectAuthz, in MembershipTableUpdateRolesInput) ([]*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if len(in.Roles) == 0 {
+		return nil, deny(ErrInvalid, "roles must not be empty")
+	}
+	for _, role := range in.Roles {
+		if !isValidRole(role) {
+			return nil, deny(ErrInvalid, "role must be manager, contributor or viewer")
+		}
+	}
+	var out []*Membership
+	if err := db.update(ctx, func(x *Tx) error {
+		agg, err := loadUpdateMemberRoles(ctx, x, authz.ProjectID(), in)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		out, err = agg.apply(ctx, x)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
