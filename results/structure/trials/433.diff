+// updateMemberRolesAggregate changes the roles of several members of one project.
+type updateMemberRolesAggregate struct {
+	projectID string
+	members   []*Membership // the members named in in.Roles, ordered by user ID
+	in        MembershipTableUpdateRolesInput
+}
+
+func loadUpdateMemberRoles(ctx context.Context, x *Tx, projectID string, in MembershipTableUpdateRolesInput) (*updateMemberRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, x, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	userIDs := make([]string, 0, len(in.Roles))
+	for uid := range in.Roles {
+		userIDs = append(userIDs, uid)
+	}
+	sort.Strings(userIDs)
+	a := &updateMemberRolesAggregate{projectID: projectID, in: in}
+	for _, uid := range userIDs {
+		m, err := p.Membership(ctx, x, uid)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, uid+" is not a member of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		a.members = append(a.members, m)
+	}
+	return a, nil
+}
+
+func (a *updateMemberRolesAggregate) validate() error { return nil }
+
+// apply changes the roles and returns the project's members after the change.
+func (a *updateMemberRolesAggregate) apply(ctx context.Context, x *Tx) ([]*Membership, error) {
+	for _, m := range a.members {
+		if err := m.setRole(ctx, x, a.in.Roles[m.UserID]); err != nil {
+			return nil, err
+		}
+	}
+	return NewMembershipTable().ListByProject(ctx, x, a.projectID)
+}
+
