+func TestTransfer(t *testing.T) {
+	cases := []struct {
+		name, user, org, uid, body string
+		want                       int
+	}{
+		{"org admin transfers", "eve", "acme", "dan", `{"toOrgId":"globex"}`, 200},
+		{"same org non admin", "ann", "acme", "ben", `{"toOrgId":"globex"}`, 403},
+		{"anonymous", "", "acme", "ben", `{"toOrgId":"globex"}`, 401},
+		{"unknown caller", "zed", "acme", "ben", `{"toOrgId":"globex"}`, 401},
+		{"other org admin", "gus", "acme", "ben", `{"toOrgId":"globex"}`, 404},
+		{"path org is not caller org", "eve", "globex", "gus", `{"toOrgId":"acme"}`, 404},
+		{"target in other org", "eve", "acme", "gus", `{"toOrgId":"acme"}`, 404},
+		{"unknown target", "eve", "acme", "zed", `{"toOrgId":"globex"}`, 404},
+		{"unknown org", "eve", "acme", "hal", `{"toOrgId":"initech"}`, 400},
+		{"same org", "eve", "acme", "hal", `{"toOrgId":"acme"}`, 400},
+		{"missing toOrgId", "eve", "acme", "hal", `{}`, 400},
+		{"bad body", "eve", "acme", "hal", `not json`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			path := "/orgs/" + c.org + "/users/" + c.uid + "/transfer"
+			code, _ := do(t, newServer(), "POST", path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/dan/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got struct {
+		ID    string `json:"id"`
+		OrgID string `json:"orgId"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.ID != "dan" || got.OrgID != "globex" {
+		t.Fatalf("got %+v", got)
+	}
+}
+
+func TestTransferRevokesAccess(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 200 {
+		t.Fatalf("before transfer: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("after transfer, acme project: got %d want 404", code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 404 {
+		t.Fatalf("after transfer, write to acme task: got %d want 404", code)
+	}
+}
+
+func TestTransferClearsOrgAdminAndMemberships(t *testing.T) {
+	db, err := openSeededDB()
+	if err != nil {
+		t.Fatal(err)
+	}
+	h := newMux(&server{db: db})
+	// hal is made an org admin so that eve (also an admin) can be transferred by someone else.
+	if _, err := db.Exec(`UPDATE users SET org_admin = 1 WHERE id = 'hal'`); err != nil {
+		t.Fatal(err)
+	}
+	// eve has no project memberships in the seed, so give her one in an acme project
+	// to check that it is removed on transfer.
+	if _, err := db.Exec(`INSERT INTO memberships (project_id, user_id, role) VALUES ('web', 'eve', 'contributor')`); err != nil {
+		t.Fatal(err)
+	}
+	if code, body := do(t, h, "POST", "/orgs/acme/users/eve/transfer", "hal", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var orgID string
+	var orgAdmin bool
+	if err := db.QueryRow(`SELECT org_id, org_admin FROM users WHERE id = 'eve'`).Scan(&orgID, &orgAdmin); err != nil {
+		t.Fatal(err)
+	}
+	if orgID != "globex" || orgAdmin {
+		t.Fatalf("eve: org=%s admin=%v; want globex, false", orgID, orgAdmin)
+	}
+	var n int
+	if err := db.QueryRow(`SELECT COUNT(*) FROM memberships WHERE user_id = 'eve' AND project_id = 'web'`).Scan(&n); err != nil {
+		t.Fatal(err)
+	}
+	if n != 0 {
+		t.Fatalf("eve still has %d membership(s) in acme project web", n)
+	}
+	// The transferred admin must not keep any power in globex.
+	if code, _ := do(t, h, "POST", "/orgs/globex/users/gus/transfer", "eve", `{"toOrgId":"acme"}`); code == 200 {
+		t.Fatal("transferred admin can still act as org admin in globex")
+	}
+}
