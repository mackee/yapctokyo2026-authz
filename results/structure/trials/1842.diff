diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..815e1a7
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,140 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"testing"
+)
+
+// wireMember is the JSON shape the members endpoint must return.
+type wireMember struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// roleOf reads a member's role straight from the database behind h.
+func roleOf(t *testing.T, h http.Handler, projectID, userID string) string {
+	t.Helper()
+	var role string
+	if err := h.(*appHandler).db.QueryRow(
+		`SELECT role FROM memberships WHERE project_id = ? AND user_id = ?`, projectID, userID).Scan(&role); err != nil {
+		t.Fatalf("roleOf %s/%s: %v", projectID, userID, err)
+	}
+	return role
+}
+
+// assigneeOf reads a task's assignee straight from the database behind h ("" means unassigned).
+func assigneeOf(t *testing.T, h http.Handler, taskID string) string {
+	t.Helper()
+	var assignee string
+	if err := h.(*appHandler).db.QueryRow(`SELECT assignee FROM tasks WHERE id = ?`, taskID).Scan(&assignee); err != nil {
+		t.Fatalf("assigneeOf %s: %v", taskID, err)
+	}
+	return assignee
+}
+
+func TestUpdateMembersAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager", "ann", "web", `{"roles":{"ben":"viewer"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"ben":"viewer"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"ben":"viewer"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"ben":"viewer"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"ben":"viewer"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"ben":"viewer"}}`, 401},
+		{"unknown user", "zed", "web", `{"roles":{"ben":"viewer"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"unknown project", "ann", "nope", `{"roles":{"ben":"viewer"}}`, 404},
+		{"target in other org", "ann", "web", `{"roles":{"gus":"viewer"}}`, 400},
+		{"target not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"target unknown", "ann", "web", `{"roles":{"zed":"viewer"}}`, 400},
+		{"bad role", "ann", "web", `{"roles":{"ben":"owner"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"no roles field", "ann", "web", `{}`, 400},
+		{"malformed json", "ann", "web", `{"roles":`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMembersResponse(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got []wireMember
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatalf("decode %q: %v", body, err)
+	}
+	// The whole member list after the change, ordered by user ID.
+	want := []wireMember{
+		{UserID: "ann", Role: "manager"},
+		{UserID: "ben", Role: "viewer"},
+		{UserID: "cat", Role: "contributor"},
+		{UserID: "dan", Role: "contributor"},
+		{UserID: "ivy", Role: "manager"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %d members, want %d: %s", len(got), len(want), body)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("member %d: got %+v want %+v (body %s)", i, got[i], want[i], body)
+		}
+	}
+	if roleOf(t, h, "web", "ben") != "viewer" || roleOf(t, h, "web", "dan") != "contributor" {
+		t.Fatal("roles were not stored")
+	}
+}
+
+func TestUpdateMembersIsAllOrNothing(t *testing.T) {
+	h := newServer()
+	// ben is a valid target; hal is not a member, so the whole request must fail.
+	code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","hal":"viewer"}}`)
+	if code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	if roleOf(t, h, "web", "ben") != "contributor" {
+		t.Fatal("ben's role changed although the request failed")
+	}
+	if assigneeOf(t, h, "t1") != "ben" {
+		t.Fatal("t1 was unassigned although the request failed")
+	}
+}
+
+func TestUpdateMembersDemotedAssigneeIsUnassigned(t *testing.T) {
+	h := newServer()
+	// t1 is assigned to ben, a contributor. Viewers may not be assignees, so
+	// demoting ben unassigns his tasks in the project, in the same change.
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer"}}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	if assigneeOf(t, h, "t1") != "" {
+		t.Fatal("t1 is still assigned to a viewer")
+	}
+	if assigneeOf(t, h, "t2") != "cat" {
+		t.Fatal("a task of another member was changed")
+	}
+}
+
+func TestUpdateMembersPromotion(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ivy", `{"roles":{"dan":"manager"}}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	if roleOf(t, h, "web", "dan") != "manager" {
+		t.Fatal("dan was not promoted")
+	}
+}
