+// updateRolesAggregate changes the roles of several members of one project, all
+// or nothing.
+type updateRolesAggregate struct {
+	project *Project
+	changes []roleChange // ordered by user ID
+}
+
+type roleChange struct {
+	member *Membership
+	role   string
+}
+
+func loadUpdateRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*updateRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if err != nil {
+		return nil, err
+	}
+	userIDs := make([]string, 0, len(roles))
+	for id := range roles {
+		userIDs = append(userIDs, id)
+	}
+	sort.Strings(userIDs)
+	a := &updateRolesAggregate{project: p}
+	for _, id := range userIDs {
+		m, err := p.Membership(ctx, tx, id)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "user "+id+" is not a member of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		a.changes = append(a.changes, roleChange{member: m, role: roles[id]})
+	}
+	return a, nil
+}
+
+func (a *updateRolesAggregate) validate() error {
+	for _, c := range a.changes {
+		if !isValidRole(c.role) {
+			return deny(ErrInvalid, "invalid role "+c.role)
+		}
+	}
+	return nil
+}
+
+func (a *updateRolesAggregate) apply(ctx context.Context, tx DB) error {
+	for _, c := range a.changes {
+		if !isWriterRole(c.role) {
+			// Viewers may not be assignees: unassign the member's tasks in this
+			// project before the role changes.
+			tasks, err := c.member.AssignedTasks(ctx, tx)
+			if err != nil {
+				return err
+			}
+			for _, t := range tasks {
+				if err := t.unassign(ctx, tx); err != nil {
+					return err
+				}
+			}
+		}
+		if err := c.member.changeRole(ctx, tx, c.role); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
