+func TestUpdateMemberRoles(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","ivy":"viewer"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var members []map[string]string
+	if err := json.Unmarshal([]byte(body), &members); err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]string{"ann": "manager", "ben": "contributor", "cat": "contributor", "dan": "contributor", "ivy": "viewer"}
+	if len(members) != len(want) {
+		t.Fatalf("got %v", members)
+	}
+	for _, m := range members {
+		if want[m["userId"]] != m["role"] {
+			t.Fatalf("member %v, want role %s", m, want[m["userId"]])
+		}
+	}
+}
+
+func TestUpdateMemberRolesRejected(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"invalid role", "ann", "web", `{"roles":{"dan":"contributor","ivy":"boss"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"not a member", "ann", "web", `{"roles":{"dan":"contributor","hal":"viewer"}}`, 400},
+		{"other org user", "ann", "web", `{"roles":{"dan":"contributor","gus":"viewer"}}`, 400},
+		{"demote assignee", "ann", "web", `{"roles":{"dan":"contributor","ben":"viewer"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			code, _ := do(t, h, "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+			// all or nothing: nothing changed
+			if r := roleOf(t, h, "web", "dan"); r != "viewer" {
+				t.Fatalf("dan's role changed to %s", r)
+			}
+			if r := roleOf(t, h, "web", "ben"); r != "contributor" {
+				t.Fatalf("ben's role changed to %s", r)
+			}
+		})
+	}
+}
