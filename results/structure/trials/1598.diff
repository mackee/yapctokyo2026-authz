+func roleOf(t *testing.T, h http.Handler, project, user string) string {
+	t.Helper()
+	var role string
+	if err := h.(*appHandler).db.QueryRow(
+		`SELECT role FROM memberships WHERE project_id = ? AND user_id = ?`, project, user).Scan(&role); err != nil {
+		t.Fatal(err)
+	}
+	return role
+}
