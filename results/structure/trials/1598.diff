+// changeRolesAggregate changes the roles of several members of one project.
+type changeRolesAggregate struct {
+	project *Project
+	targets []*Membership // the members to change, ordered by user ID
+	roles   map[string]string
+}
+
+func loadChangeRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*changeRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	members, err := p.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	a := &changeRolesAggregate{project: p, roles: roles}
+	found := 0
+	for _, m := range members {
+		if _, ok := roles[m.UserID]; ok {
+			a.targets = append(a.targets, m)
+			found++
+		}
+	}
+	if found != len(roles) {
+		return nil, deny(ErrInvalid, "every user must be a member of the project")
+	}
+	return a, nil
+}
+
+func (a *changeRolesAggregate) validate(ctx context.Context, tx DB) error {
+	for _, m := range a.targets {
+		role := a.roles[m.UserID]
+		if !isValidRole(role) {
+			return deny(ErrInvalid, "role must be manager, contributor or viewer")
+		}
+		if !isWriterRole(role) {
+			tasks, err := m.AssignedTasks(ctx, tx)
+			if err != nil {
+				return err
+			}
+			if len(tasks) > 0 {
+				return deny(ErrInvalid, "member "+m.UserID+" has assigned tasks and must stay a contributor or manager")
+			}
+		}
+	}
+	return nil
+}
+
+func (a *changeRolesAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for _, m := range a.targets {
+		if err := m.changeRole(ctx, tx, a.roles[m.UserID]); err != nil {
+			return nil, err
+		}
+	}
+	return a.project.Memberships(ctx, tx)
+}
+
