+type moveRequest struct {
+	ToProjectID string `json:"toProjectId"`
+}
+
+func moveTask(ctx tanukirpc.Context[*taskRegistry], _ struct{}) (*Task, error) {
+	// Managers of the source project only. Authorization comes before the body.
+	t, err := ctx.Registry().scope.Manage()
+	if err != nil {
+		return nil, err
+	}
+	var req moveRequest
+	if err := decodeBody(ctx.Request(), &req); err != nil || req.ToProjectID == "" {
+		return nil, errInvalidBody
+	}
+	// The destination is reached through the same actor, so it is checked
+	// against the caller's own access to that project.
+	dest, err := ctx.Registry().scope.Project().Actor().Project(req.ToProjectID).Write()
+	if err != nil {
+		return nil, err
+	}
+	v, err := t.MoveTo(dest)
+	if err != nil {
+		return nil, err
+	}
+	return &v, nil
+}
