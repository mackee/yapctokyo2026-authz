+func (t *manageTask) MoveTo(dest WriteProject) (TaskView, error) {
+	to, ok := dest.(*writeProject)
+	if !ok || to.ps.as.actor.id != t.ts.ps.as.actor.id {
+		return TaskView{}, deny(ErrInvalid, "destination was not acquired by this actor")
+	}
+	if to.ps.pid == t.ts.ps.pid {
+		return TaskView{}, deny(ErrInvalid, "task is already in that project")
+	}
+	var v TaskView
+	err := t.ts.ps.as.a.st.tx(func(s *state) error {
+		cur, ok := s.tasks[t.ts.tid]
+		if !ok {
+			return deny(ErrNotFound, "not found")
+		}
+		a, err := admit(s, to.ps.pid, cur.assignee.user)
+		if err != nil {
+			return err
+		}
+		cur.project = to.ps.pid
+		cur.assignee = a
+		s.tasks[cur.id] = cur
+		v = cur.view()
+		return nil
+	})
+	return v, err
+}
