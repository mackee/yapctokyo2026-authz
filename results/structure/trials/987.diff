+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"archived", "ann", "legacy", 409},
+		{"unknown user", "zed", "web", 401},
+		{"anonymous", "", "web", 401},
+		{"missing project", "ann", "nope", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeDemotesMembersAndBlocksWrites(t *testing.T) {
+	srv := newServer()
+
+	code, body := do(t, srv, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("freeze: got %d body=%s", code, body)
+	}
+	var members []memberRole
+	if err := json.Unmarshal([]byte(body), &members); err != nil {
+		t.Fatal(err)
+	}
+	want := []memberRole{
+		{"ann", "viewer"}, {"ben", "viewer"}, {"cat", "viewer"}, {"dan", "viewer"}, {"ivy", "viewer"},
+	}
+	if len(members) != len(want) {
+		t.Fatalf("members = %+v, want %+v", members, want)
+	}
+	for i := range want {
+		if members[i] != want[i] {
+			t.Fatalf("members[%d] = %+v, want %+v", i, members[i], want[i])
+		}
+	}
+
+	// Nobody can modify the project's tasks any more.
+	writes := []struct {
+		name, user, method, path, body string
+	}{
+		{"former manager patches", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"former manager creates", "ivy", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"former manager deletes", "ann", "DELETE", "/projects/web/tasks/t1", ""},
+		{"former contributor patches own", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"former contributor creates", "cat", "POST", "/projects/web/tasks", `{"title":"x"}`},
+	}
+	for _, c := range writes {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, srv, c.method, c.path, c.user, c.body)
+			if code != 403 {
+				t.Fatalf("got %d want 403 body=%s", code, body)
+			}
+		})
+	}
+
+	// Reads still work, and the project is no longer freezable by its old managers.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks", "ann", ""); code != 200 {
+		t.Fatalf("read after freeze: got %d want 200", code)
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != 403 {
+		t.Fatalf("second freeze: got %d want 403", code)
+	}
+
+	// Other projects are untouched.
+	if code, _ := do(t, srv, "PATCH", "/projects/ops/tasks/t4", "ivy", `{"status":"done"}`); code != 200 {
+		t.Fatalf("other project write: got %d want 200", code)
+	}
+}
