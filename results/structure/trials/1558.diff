+++ b/members_test.go
@@ -0,0 +1,93 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func memberRoles(t *testing.T, body string) map[string]string {
+	t.Helper()
+	var ms []member
+	if err := json.Unmarshal([]byte(body), &ms); err != nil {
+		t.Fatal(err, body)
+	}
+	m := map[string]string{}
+	for _, x := range ms {
+		m[x.UserID] = x.Role
+	}
+	return m
+}
+
+func TestUpdateMemberRoles(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	got := memberRoles(t, body)
+	if len(got) != 5 || got["ben"] != "viewer" || got["dan"] != "contributor" || got["ann"] != "manager" {
+		t.Fatalf("unexpected members: %v", got)
+	}
+	// ben was assigned t1; demotion must unassign it (model rules are checked by do()).
+	_, body = do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "" {
+		t.Fatalf("t1 still assigned to %q", task.Assignee)
+	}
+}
+
+func TestUpdateMemberRolesErrors(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"anonymous", "", "web", `{"roles":{"ben":"viewer"}}`, 401},
+		{"contributor", "ben", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"cat":"viewer"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"cat":"viewer"}}`, 404},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"bad json", "ann", "web", `nope`, 400},
+		{"empty", "ann", "web", `{"roles":{}}`, 400},
+		{"bad role", "ann", "web", `{"roles":{"ben":"boss"}}`, 400},
+		{"non member target", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"other org target", "ann", "web", `{"roles":{"gus":"viewer"}}`, 400},
+		{"no manager left", "ann", "web", `{"roles":{"ann":"viewer","ivy":"contributor"}}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			code, body := do(t, h, "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d (%s)", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRolesAllOrNothing(t *testing.T) {
+	h := newServer()
+	// ben is valid, hal is not a member: nothing may change.
+	code, _ := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","hal":"viewer"}}`)
+	if code != 400 {
+		t.Fatal(code)
+	}
+	// Last-manager failure after earlier changes were applied must roll back too.
+	code, _ = do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","ann":"viewer","ivy":"viewer"}}`)
+	if code != 409 {
+		t.Fatal(code)
+	}
+	_, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "ben" {
+		t.Fatalf("t1 assignee changed to %q", task.Assignee)
+	}
+	// ben is still a contributor, so can still create tasks.
+	code, _ = do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`)
+	if code != 200 {
+		t.Fatalf("ben lost his role: %d", code)
+	}
+}
