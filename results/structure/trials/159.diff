+type moveRequest struct {
+	ToProjectID string `json:"toProjectId"`
+}
+
+func moveMember(ctx tanukirpc.Context[*projectRegistry], _ struct{}) (*capability.Membership, error) {
+	src, err := ctx.Registry().scope.Manage()
+	if err != nil {
+		return nil, err
+	}
+	var req moveRequest
+	if err := decodeBody(ctx.Request(), &req); err != nil || req.ToProjectID == "" {
+		return nil, errInvalidBody
+	}
+	dst, err := ctx.Registry().scope.Actor().Project(req.ToProjectID).Manage()
+	if err != nil {
+		return nil, err
+	}
+	m, err := src.MoveMemberTo(chi.URLParam(ctx.Request(), "uid"), dst)
+	if err != nil {
+		return nil, err
+	}
+	return &m, nil
+}
