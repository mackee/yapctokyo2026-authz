+// Membership is a user's role in one project.
+type Membership struct {
+	UserID    string `json:"userId"`
+	ProjectID string `json:"projectId"`
+	Role      string `json:"role"`
+}
+
+// ManageProject may change the membership of one project. Only managers hold it.
+type ManageProject interface {
+	WriteProject
+	// MoveMemberTo removes userID from this project and adds them to dest with
+	// the same role. The user's tasks in this project are unassigned, since they
+	// are no longer a member. Both projects must be acquired with Manage, so the
+	// caller is a manager of both. Atomic: nothing changes on error.
+	MoveMemberTo(userID string, dest ManageProject) (Membership, error)
+}
+
+type manageProject struct{ writeProject }
+
+func (p *manageProject) MoveMemberTo(userID string, dest ManageProject) (Membership, error) {
+	// dest must be a capability acquired through Manage, not a foreign value.
+	d, ok := dest.(*manageProject)
+	if !ok {
+		return Membership{}, deny(ErrForbidden, "forbidden")
+	}
+	src, to := p.ps.pid, d.ps.pid
+	if src == to {
+		return Membership{}, deny(ErrInvalid, "source and destination projects are the same")
+	}
+	var m Membership
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		role, ok := s.members[src][userID]
+		if !ok {
+			return deny(ErrNotFound, "not found")
+		}
+		if _, ok := s.members[to][userID]; ok {
+			return deny(ErrConflict, "user is already a member of the destination project")
+		}
+		delete(s.members[src], userID)
+		if s.members[to] == nil {
+			s.members[to] = map[string]string{}
+		}
+		s.members[to][userID] = role
+		for id, t := range s.tasks {
+			if t.project == src && t.assignee.user == userID {
+				t.assignee = Assignee{project: src}
+				s.tasks[id] = t
+			}
+		}
+		m = Membership{UserID: userID, ProjectID: to, Role: role}
+		return nil
+	})
+	if err != nil {
+		return Membership{}, err
+	}
+	return m, nil
+}
+
