+// setRolesAggregate changes the roles of several members of one project.
+type setRolesAggregate struct {
+	project  *Project
+	members  []*Membership // the members to change, ordered by user ID
+	roles    []string      // roles[i] is the new role of members[i]
+	assigned [][]*Task     // assigned[i] is the tasks assigned to members[i] in the project
+}
+
+func loadSetRoles(ctx context.Context, tx DB, projectID string, in MembershipTableSetRolesInput) (*setRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	userIDs := make([]string, 0, len(in.Roles))
+	for id := range in.Roles {
+		userIDs = append(userIDs, id)
+	}
+	sort.Strings(userIDs)
+	a := &setRolesAggregate{project: p}
+	for _, id := range userIDs {
+		m, err := p.Membership(ctx, tx, id)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "user "+id+" is not a member of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		tasks, err := m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		a.members = append(a.members, m)
+		a.roles = append(a.roles, in.Roles[id])
+		a.assigned = append(a.assigned, tasks)
+	}
+	return a, nil
+}
+
+func (a *setRolesAggregate) validate() error {
+	for i, m := range a.members {
+		if !isWriterRole(a.roles[i]) && len(a.assigned[i]) > 0 {
+			return deny(ErrInvalid, "user "+m.UserID+" has assigned tasks and must stay a contributor or manager")
+		}
+	}
+	return nil
+}
+
+func (a *setRolesAggregate) apply(ctx context.Context, tx DB) error {
+	for i, m := range a.members {
+		if err := m.setRole(ctx, tx, a.roles[i]); err != nil {
+			return err
+		}
+	}
+	return nil
+}
