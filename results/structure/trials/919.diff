+// setMemberRolesRequest maps user IDs to their new project roles. The role
+// values are checked here, before any access decision.
+type setMemberRolesRequest struct {
+	Roles map[string]string `json:"roles" validate:"required,dive,oneof=manager contributor viewer"`
+}
+
+// memberRole is the JSON shape of one project member in the setMemberRoles response.
+type memberRole struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func setMemberRoles(ctx tanukirpc.Context[*projectRegistry], req setMemberRolesRequest) ([]memberRole, error) {
+	reg := ctx.Registry()
+	members, err := model.NewMembershipTable().SetRoles(ctx, reg.db, reg.authz, model.MembershipTableSetRolesInput{Roles: req.Roles})
+	if err != nil {
+		return nil, err
+	}
+	out := make([]memberRole, 0, len(members))
+	for _, m := range members {
+		out = append(out, memberRole{UserID: m.UserID, Role: m.Role})
+	}
+	return out, nil
+}
