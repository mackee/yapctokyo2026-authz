+func TestSetMemberRoles(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager promotes viewer", "ann", "web", `{"roles":{"dan":"contributor"}}`, 200},
+		{"manager demotes unassigned", "ann", "web", `{"roles":{"ivy":"contributor"}}`, 200},
+		{"manager demotes assignee", "ann", "web", `{"roles":{"ben":"viewer"}}`, 400},
+		{"manager batch with one bad", "ann", "web", `{"roles":{"dan":"contributor","ben":"viewer"}}`, 400},
+		{"unknown user", "ann", "web", `{"roles":{"zed":"viewer"}}`, 400},
+		{"not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"invalid role", "ann", "web", `{"roles":{"dan":"admin"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"malformed body", "ann", "web", `{`, 400},
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer invalid role", "dan", "web", `{"roles":{"dan":"admin"}}`, 400},
+		{"org admin", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"manager of other project", "ann", "ops", `{"roles":{"cat":"viewer"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"contributor"}}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMemberRolesResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members", "ann", `{"roles":{"ivy":"contributor","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}{
+		{"ann", "manager"}, {"ben", "contributor"}, {"cat", "contributor"},
+		{"dan", "contributor"}, {"ivy", "contributor"},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %s", body)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("member %d: got %+v want %+v (body %s)", i, got[i], want[i], body)
+		}
+	}
+}
+
+func TestSetMemberRolesAllOrNothing(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","ben":"viewer"}}`); code != 400 {
+		t.Fatalf("got %d want 400", code)
+	}
+	// A later successful call shows the state: dan must still be a viewer.
+	code, body := do(t, srv, "PUT", "/projects/web/members", "ann", `{"roles":{"ivy":"manager"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	if want := `{"userId":"dan","role":"viewer"}`; !strings.Contains(body, want) {
+		t.Fatalf("dan's role changed by a rejected batch: %s", body)
+	}
+	if want := `{"userId":"ben","role":"contributor"}`; !strings.Contains(body, want) {
+		t.Fatalf("ben's role changed by a rejected batch: %s", body)
+	}
+}
