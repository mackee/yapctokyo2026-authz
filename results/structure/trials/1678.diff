+// ---- member roles -----------------------------------------------------------------
+
+type member struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+// webMembers is the seed membership of the web project, ordered by user ID.
+var webMembers = []member{
+	{"ann", "manager"}, {"ben", "contributor"}, {"cat", "contributor"}, {"dan", "viewer"}, {"ivy", "manager"},
+}
+
+// webRoles reads the web members' roles with a no-op change by ann (a manager),
+// which answers with the member list.
+func webRoles(t *testing.T, h http.Handler) []member {
+	t.Helper()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ann":"manager"}}`)
+	if code != 200 {
+		t.Fatalf("read back: got %d: %s", code, body)
+	}
+	var got []member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	return got
+}
+
+func TestSetMemberRolesChangesRoles(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ivy":"contributor","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got []member
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []member{{"ann", "manager"}, {"ben", "contributor"}, {"cat", "contributor"}, {"dan", "contributor"}, {"ivy", "contributor"}}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("response = %v, want %v", got, want)
+	}
+	if after := webRoles(t, h); !reflect.DeepEqual(after, want) {
+		t.Fatalf("stored roles = %v, want %v", after, want)
+	}
+}
+
+func TestSetMemberRoles(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager changes", "ann", "web", `{"roles":{"ivy":"viewer"}}`, 200},
+		{"contributor caller", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer caller", "dan", "web", `{"roles":{"ivy":"viewer"}}`, 403},
+		{"org admin caller", "eve", "web", `{"roles":{"ivy":"viewer"}}`, 403},
+		{"non member caller", "hal", "web", `{"roles":{"ivy":"viewer"}}`, 404},
+		{"other org caller", "gus", "web", `{"roles":{"ivy":"viewer"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"ivy":"viewer"}}`, 401},
+		{"unknown user", "zed", "web", `{"roles":{"ivy":"viewer"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"bad role", "ann", "web", `{"roles":{"dan":"owner"}}`, 400},
+		{"bad json", "ann", "web", `{"roles":`, 400},
+		{"non member target", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"demote assignee", "ann", "web", `{"roles":{"ben":"viewer"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMemberRolesIsAllOrNothing(t *testing.T) {
+	cases := []struct{ name, body string }{
+		// dan could become a contributor, but ben holds t1 and cannot become a viewer.
+		{"one assignee demotion", `{"roles":{"dan":"contributor","ben":"viewer"}}`},
+		// dan could become a contributor, but hal is not a member.
+		{"one non member", `{"roles":{"dan":"contributor","hal":"viewer"}}`},
+		// dan could become a contributor, but nope is not a role.
+		{"one bad role", `{"roles":{"dan":"contributor","ivy":"nope"}}`},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			code, body := do(t, h, "PUT", "/projects/web/members", "ann", c.body)
+			if code != 400 {
+				t.Fatalf("got %d want 400: %s", code, body)
+			}
+			if got := webRoles(t, h); !reflect.DeepEqual(got, webMembers) {
+				t.Fatalf("roles changed despite the error: %v", got)
+			}
+		})
+	}
+}
