+// MembershipTableSetRolesInput is the input of MembershipTable.SetRoles.
+type MembershipTableSetRolesInput struct {
+	Roles map[string]string // user ID -> new role
+}
+
+// SetRoles changes the roles of the named members of the project, all or
+// nothing, and returns the project's members after the change (ordered by
+// user ID). It asks the authorization object first (CanManageMembers).
+func (mt *MembershipTable) SetRoles(ctx context.Context, db DB, authz ProjectAuthz, in MembershipTableSetRolesInput) ([]*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if len(in.Roles) == 0 {
+		return nil, deny(ErrInvalid, "roles must not be empty")
+	}
+	for _, role := range in.Roles {
+		if !isRole(role) {
+			return nil, deny(ErrInvalid, "invalid role")
+		}
+	}
+	var out []*Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadSetRoles(ctx, tx, authz.ProjectID(), in.Roles)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if err := agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		out, err = agg.project.Memberships(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
