+// setRolesAggregate changes the roles of several members of one project.
+type setRolesAggregate struct {
+	project *Project
+	changes []roleChange // ordered by user ID
+}
+
+// roleChange is one member's new role. assignedTasks is how many tasks of the
+// project are assigned to the member; it is loaded only for a non-writer role.
+type roleChange struct {
+	member        *Membership
+	role          string
+	assignedTasks int
+}
+
+func loadSetRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*setRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if err != nil {
+		return nil, err
+	}
+	a := &setRolesAggregate{project: p}
+	for _, userID := range slices.Sorted(maps.Keys(roles)) {
+		m, err := p.Membership(ctx, tx, userID)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrInvalid, "user "+userID+" is not a member of the project")
+		} else if err != nil {
+			return nil, err
+		}
+		c := roleChange{member: m, role: roles[userID]}
+		if !isWriterRole(c.role) {
+			tasks, err := m.AssignedTasks(ctx, tx)
+			if err != nil {
+				return nil, err
+			}
+			c.assignedTasks = len(tasks)
+		}
+		a.changes = append(a.changes, c)
+	}
+	return a, nil
+}
+
+func (a *setRolesAggregate) validate() error {
+	for _, c := range a.changes {
+		if !isWriterRole(c.role) && c.assignedTasks > 0 {
+			return deny(ErrInvalid, "user "+c.member.UserID+" is assigned tasks and must stay a contributor or manager")
+		}
+	}
+	return nil
+}
+
+func (a *setRolesAggregate) apply(ctx context.Context, tx DB) error {
+	for _, c := range a.changes {
+		if err := c.member.setRole(ctx, tx, c.role); err != nil {
+			return err
+		}
+	}
+	return nil
+}
