+// OrgAuthz is what the actor may do in one organization (their own).
+type OrgAuthz struct {
+	actor Actor
+	org   string
+}
+
+// Actor returns the authenticated actor.
+func (a OrgAuthz) Actor() Actor { return a.actor }
+
+// OrgID returns the organization the object is bound to.
+func (a OrgAuthz) OrgID() string { return a.org }
+
+// CanRead reports whether the actor belongs to the organization. NewOrgAuthz
+// only returns objects that can read.
+func (a OrgAuthz) CanRead() bool { return a.org != "" && a.actor.org == a.org }
+
+// UserAuthz is what the actor may do with one user of the organization.
+type UserAuthz struct {
+	org  OrgAuthz
+	user string
+}
+
+// Org returns the organization-level authorization the user object came from.
+func (a UserAuthz) Org() OrgAuthz { return a.org }
+
+// UserID returns the user the object is bound to.
+func (a UserAuthz) UserID() string { return a.user }
+
+// CanRead reports whether the actor may see the user (same organization).
+func (a UserAuthz) CanRead() bool { return a.user != "" && a.org.CanRead() }
+
+// CanTransfer returns nil if the actor may move the user to another
+// organization: org admins only (else ErrForbidden).
+func (a UserAuthz) CanTransfer() error {
+	if !a.CanRead() || !a.org.actor.orgAdmin {
+		return deny(ErrForbidden, "only organization admins may transfer users")
+	}
+	return nil
+}
+
 // ---- building authorization objects -------------------------------------------------
 
+// NewOrgAuthz builds the actor's authorization object for one organization.
+// The actor must belong to it; otherwise ErrNotFound.
+func NewOrgAuthz(act Actor, orgID string) (OrgAuthz, error) {
+	if orgID == "" || act.org != orgID {
+		return OrgAuthz{}, deny(ErrNotFound, "not found")
+	}
+	return OrgAuthz{actor: act, org: orgID}, nil
+}
+
+// NewUserAuthz builds the actor's authorization object for one user. The user
+// must belong to the organization; otherwise ErrNotFound.
+func NewUserAuthz(ctx context.Context, db DB, oa OrgAuthz, userID string) (UserAuthz, error) {
+	if !oa.CanRead() {
+		return UserAuthz{}, deny(ErrNotFound, "not found")
+	}
+	u, err := NewUserTable().Find(ctx, db, userID)
+	if errors.Is(err, ErrNoRows) {
+		return UserAuthz{}, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return UserAuthz{}, err
+	}
+	if u.Org != oa.org {
+		return UserAuthz{}, deny(ErrNotFound, "not found")
+	}
+	return UserAuthz{org: oa, user: u.ID}, nil
+}
