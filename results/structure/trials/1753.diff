+// orgTransformer authenticates the caller and builds the actor's authorization
+// object for {oid}. Other organizations stop here (404).
+func orgTransformer(conn *sql.DB) tanukirpc.Transformer[*rootRegistry, *orgRegistry] {
+	return tanukirpc.NewTransformer(func(ctx tanukirpc.Context[*rootRegistry]) (*orgRegistry, error) {
+		actor, err := model.Authenticate(ctx, conn, ctx.Request().Header.Get("X-User"))
+		if err != nil {
+			return nil, err
+		}
+		authz, err := model.NewOrgAuthz(actor, chi.URLParam(ctx.Request(), "oid"))
+		if err != nil {
+			return nil, err
+		}
+		return &orgRegistry{db: conn, authz: authz}, nil
+	})
+}
+
+// userTransformer builds the actor's authorization object for {uid}. A user
+// outside the organization stops here (404).
+func userTransformer() tanukirpc.Transformer[*orgRegistry, *userRegistry] {
+	return tanukirpc.NewTransformer(func(ctx tanukirpc.Context[*orgRegistry]) (*userRegistry, error) {
+		reg := ctx.Registry()
+		authz, err := model.NewUserAuthz(ctx, reg.db, reg.authz, chi.URLParam(ctx.Request(), "uid"))
+		if err != nil {
+			return nil, err
+		}
+		return &userRegistry{db: reg.db, authz: authz}, nil
+	})
+}
