+// transferUserAggregate moves one user to another organization. To keep the
+// model rules (members belong to their project's organization, assignees are
+// members), the user leaves every project and their tasks become unassigned.
+type transferUserAggregate struct {
+	user        *User
+	toOrg       string
+	memberships []*Membership // user.Memberships
+	tasks       []*Task       // user.AssignedTasks
+}
+
+func loadTransferUser(ctx context.Context, tx DB, userID, toOrg string) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &transferUserAggregate{user: u, toOrg: toOrg}
+	if a.memberships, err = u.Memberships(ctx, tx); err != nil {
+		return nil, err
+	}
+	if a.tasks, err = u.AssignedTasks(ctx, tx); err != nil {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *transferUserAggregate) validate(ctx context.Context, tx DB) error {
+	if a.toOrg == "" || a.toOrg == a.user.Org {
+		return deny(ErrInvalid, "target organization must differ from the current one")
+	}
+	ok, err := NewUserTable().OrgExists(ctx, tx, a.toOrg)
+	if err != nil {
+		return err
+	}
+	if !ok {
+		return deny(ErrInvalid, "target organization does not exist")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.user.moveToOrg(ctx, tx, a.toOrg); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
+
