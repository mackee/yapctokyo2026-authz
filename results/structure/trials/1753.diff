--- /dev/null
+++ b/transfer_test.go
@@ -0,0 +1,133 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func transferPath(org, uid string) string { return "/orgs/" + org + "/users/" + uid + "/transfer" }
+
+func TestTransferStatus(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin", "eve", transferPath("acme", "hal"), `{"toOrgId":"globex"}`, 200},
+		{"org admin moves member with roles", "eve", transferPath("acme", "ann"), `{"toOrgId":"globex"}`, 200},
+		{"not an org admin", "ann", transferPath("acme", "hal"), `{"toOrgId":"globex"}`, 403},
+		{"anonymous", "", transferPath("acme", "hal"), `{"toOrgId":"globex"}`, 401},
+		{"unknown caller", "zed", transferPath("acme", "hal"), `{"toOrgId":"globex"}`, 401},
+		{"caller from another org", "gus", transferPath("acme", "hal"), `{"toOrgId":"globex"}`, 404},
+		{"unknown org", "eve", transferPath("nowhere", "hal"), `{"toOrgId":"globex"}`, 404},
+		{"user not in the org", "eve", transferPath("acme", "gus"), `{"toOrgId":"globex"}`, 404},
+		{"unknown user", "eve", transferPath("acme", "nobody"), `{"toOrgId":"globex"}`, 404},
+		{"unknown target org", "eve", transferPath("acme", "hal"), `{"toOrgId":"nowhere"}`, 400},
+		{"same org", "eve", transferPath("acme", "hal"), `{"toOrgId":"acme"}`, 400},
+		{"empty target", "eve", transferPath("acme", "hal"), `{"toOrgId":""}`, 400},
+		{"missing target", "eve", transferPath("acme", "hal"), `{}`, 400},
+		{"malformed body", "eve", transferPath("acme", "hal"), `{`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d (%s)", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", transferPath("acme", "hal"), "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatal(code, body)
+	}
+	var got struct{ ID, OrgID string }
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.ID != "hal" || got.OrgID != "globex" {
+		t.Fatalf("got %+v", got)
+	}
+	var raw map[string]any
+	json.Unmarshal([]byte(body), &raw)
+	if _, ok := raw["id"]; !ok {
+		t.Fatalf("want lower-case keys id/orgId: %s", body)
+	}
+	if _, ok := raw["orgId"]; !ok {
+		t.Fatalf("want lower-case keys id/orgId: %s", body)
+	}
+}
+
+// The user really changes organization: the old organization no longer sees them
+// (the transfer is persisted, and the user is authenticated into the new org).
+func TestTransferMovesUser(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", transferPath("acme", "hal"), "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatal(code, body)
+	}
+	// hal is no longer in acme, so acme's admin cannot transfer hal again.
+	if code, _ := do(t, h, "POST", transferPath("acme", "hal"), "eve", `{"toOrgId":"globex"}`); code != 404 {
+		t.Fatalf("second transfer from acme: got %d want 404", code)
+	}
+	// hal is in globex now: hal cannot read acme projects.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "hal", ""); code != 404 {
+		t.Fatalf("got %d want 404", code)
+	}
+}
+
+// Model rules must still hold after a transfer: project members belong to the
+// project's organization and assignees are members of the task's project.
+func TestTransferKeepsModelRules(t *testing.T) {
+	h := newServer()
+	// ben: contributor of web and legacy, assignee of t1 (web) and t5 (legacy).
+	if code, body := do(t, h, "POST", transferPath("acme", "ben"), "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatal(code, body)
+	}
+	// ben lost access to the old organization's projects.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t1", "ben", ""); code != 404 {
+		t.Fatalf("ben still reads web: got %d", code)
+	}
+	// ben no longer holds membership in web: ann cannot assign them.
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t3", "ann", `{"assignee":"ben"}`); code != 400 {
+		t.Fatalf("assigning transferred user: got %d want 400", code)
+	}
+	// tasks that were assigned to ben are unassigned.
+	for _, c := range []struct{ project, tid string }{{"web", "t1"}, {"legacy", "t5"}} {
+		code, body := do(t, h, "GET", "/projects/"+c.project+"/tasks/"+c.tid, "ann", "")
+		if code != 200 {
+			t.Fatal(code, body)
+		}
+		var task Task
+		json.Unmarshal([]byte(body), &task)
+		if task.AssigneeID != "" {
+			t.Fatalf("task %s still assigned to %q", c.tid, task.AssigneeID)
+		}
+	}
+	// tasks of other members are untouched.
+	code, body := do(t, h, "GET", "/projects/web/tasks/t2", "ann", "")
+	var t2 Task
+	json.Unmarshal([]byte(body), &t2)
+	if code != 200 || t2.AssigneeID != "cat" {
+		t.Fatalf("t2 changed: %d %s", code, body)
+	}
+	// ben does not leak into the new organization's projects.
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads gx without membership: got %d", code)
+	}
+}
+
+// Org admin rights belong to one organization: a transferred admin is an
+// ordinary user in the new organization.
+func TestTransferDropsOrgAdmin(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", transferPath("acme", "eve"), "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatal(code, body)
+	}
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "eve", ""); code != 404 {
+		t.Fatalf("transferred admin reads gx: got %d want 404", code)
+	}
+	if code, _ := do(t, h, "POST", transferPath("globex", "gus"), "eve", `{"toOrgId":"acme"}`); code != 403 {
+		t.Fatalf("transferred admin acts as globex admin: got %d want 403", code)
+	}
+}
