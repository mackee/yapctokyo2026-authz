+// UpdateRoles changes the roles of the named members of the project, all or
+// nothing. roles maps a user ID to its new role. It returns the project's
+// members after the change, ordered by user ID. Any member that is not in the
+// project, or whose new role would leave a task assigned to them as a viewer,
+// fails the whole call (ErrNotFound / ErrInvalid) and nothing changes.
+func (mt *MembershipTable) UpdateRoles(ctx context.Context, db DB, authz ProjectAuthz, roles map[string]string) ([]*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if len(roles) == 0 {
+		return nil, deny(ErrInvalid, "roles must not be empty")
+	}
+	for _, role := range roles {
+		if !isProjectRole(role) {
+			return nil, deny(ErrInvalid, "invalid role: "+role)
+		}
+	}
+	var out []*Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadUpdateRoles(ctx, tx, authz.ProjectID(), roles)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		out, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
