@@ -0,0 +1,120 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"reflect"
+	"testing"
+)
+
+// memberRoles reads the roles of the project's memberships straight from the
+// database, so a test can see whether a failed request changed anything.
+func memberRoles(t *testing.T, h http.Handler, projectID string) map[string]string {
+	t.Helper()
+	app := h.(*appHandler)
+	rows, err := app.db.Query(`SELECT user_id, role FROM memberships WHERE project_id = ?`, projectID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer rows.Close()
+	out := map[string]string{}
+	for rows.Next() {
+		var userID, role string
+		if err := rows.Scan(&userID, &role); err != nil {
+			t.Fatal(err)
+		}
+		out[userID] = role
+	}
+	if err := rows.Err(); err != nil {
+		t.Fatal(err)
+	}
+	return out
+}
+
+func TestUpdateMembers(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager changes roles", "ann", "web", `{"roles":{"dan":"contributor","ivy":"viewer"}}`, 200},
+		{"manager demotes unassigned member", "ann", "web", `{"roles":{"ivy":"viewer"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"dan":"contributor"}}`, 401},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"target not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 404},
+		{"target in another project only", "ann", "web", `{"roles":{"gus":"viewer"}}`, 404},
+		{"invalid role", "ann", "web", `{"roles":{"dan":"owner"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"malformed body", "ann", "web", `{"roles":`, 400},
+		{"assignee demoted to viewer", "ann", "web", `{"roles":{"ben":"viewer"}}`, 400},
+		{"assignee demotion blocks the batch", "ann", "web", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMembersResponseAndPersistence(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"dan":"contributor","ivy":"viewer"}}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+
+	var got []map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []map[string]string{
+		{"userId": "ann", "role": "manager"},
+		{"userId": "ben", "role": "contributor"},
+		{"userId": "cat", "role": "contributor"},
+		{"userId": "dan", "role": "contributor"},
+		{"userId": "ivy", "role": "viewer"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("response:\n got %v\nwant %v", got, want)
+	}
+
+	roles := memberRoles(t, h, "web")
+	if roles["dan"] != "contributor" || roles["ivy"] != "viewer" {
+		t.Fatalf("roles not persisted: %v", roles)
+	}
+	if roles["ann"] != "manager" || roles["ben"] != "contributor" || roles["cat"] != "contributor" {
+		t.Fatalf("unrelated roles changed: %v", roles)
+	}
+}
+
+func TestUpdateMembersIsAllOrNothing(t *testing.T) {
+	cases := []struct {
+		name, body string
+		want       int
+	}{
+		// dan's change is valid on its own; the second entry is not.
+		{"unknown member in the batch", `{"roles":{"dan":"contributor","hal":"viewer"}}`, 404},
+		{"assignee in the batch", `{"roles":{"dan":"contributor","ben":"viewer"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			before := memberRoles(t, h, "web")
+			code, _ := do(t, h, "PUT", "/projects/web/members", "ann", c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+			if after := memberRoles(t, h, "web"); !reflect.DeepEqual(before, after) {
+				t.Fatalf("failed request changed roles:\nbefore %v\n after %v", before, after)
+			}
+		})
+	}
+}
