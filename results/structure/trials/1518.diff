+// updateRolesAggregate changes the roles of several members of one project, all
+// or nothing.
+type updateRolesAggregate struct {
+	projectID string
+	roles     map[string]string // user ID -> new role
+	members   []*Membership     // the memberships named in roles, ordered by user ID
+	assigned  map[string]int    // user ID -> tasks assigned to them in the project, for members whose new role is not a writer role
+}
+
+func loadUpdateRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*updateRolesAggregate, error) {
+	userIDs := make([]string, 0, len(roles))
+	for userID := range roles {
+		userIDs = append(userIDs, userID)
+	}
+	sort.Strings(userIDs)
+
+	a := &updateRolesAggregate{projectID: projectID, roles: roles, assigned: map[string]int{}}
+	for _, userID := range userIDs {
+		m, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+		if errors.Is(err, ErrNoRows) {
+			return nil, deny(ErrNotFound, "member not found: "+userID)
+		} else if err != nil {
+			return nil, err
+		}
+		a.members = append(a.members, m)
+		if !isWriterRole(roles[userID]) {
+			ts, err := m.AssignedTasks(ctx, tx)
+			if err != nil {
+				return nil, err
+			}
+			a.assigned[userID] = len(ts)
+		}
+	}
+	return a, nil
+}
+
+func (a *updateRolesAggregate) validate() error {
+	for _, m := range a.members {
+		if n := a.assigned[m.UserID]; n > 0 {
+			return deny(ErrInvalid, fmt.Sprintf("%s has %d task(s) assigned in the project and must stay a contributor or manager", m.UserID, n))
+		}
+	}
+	return nil
+}
+
+func (a *updateRolesAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for _, m := range a.members {
+		if err := m.setRole(ctx, tx, a.roles[m.UserID]); err != nil {
+			return nil, err
+		}
+	}
+	return NewMembershipTable().ListByProject(ctx, tx, a.projectID)
+}
+
