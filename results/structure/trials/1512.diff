@@ -144,3 +144,53 @@ func loadDeleteTask(ctx context.Context, tx DB, taskID string) (*deleteTaskAggre
 func (a *deleteTaskAggregate) validate() error { return nil }
 
 func (a *deleteTaskAggregate) apply(ctx context.Context, tx DB) error { return a.task.destroy(ctx, tx) }
+
+// freezeProjectAggregate freezes one project: its members become viewers and
+// its tasks lose their assignees.
+type freezeProjectAggregate struct {
+	project *Project
+	members []*Membership // project.Memberships
+	tasks   []*Task       // project.Tasks
+}
+
+func loadFreezeProject(ctx context.Context, tx DB, projectID string) (*freezeProjectAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	members, err := p.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	tasks, err := p.Tasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &freezeProjectAggregate{project: p, members: members, tasks: tasks}, nil
+}
+
+// validate: the rule "an assignee is a contributor or manager" holds after
+// apply, because apply unassigns every task; nothing else can break.
+func (a *freezeProjectAggregate) validate() error { return nil }
+
+func (a *freezeProjectAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for _, m := range a.members {
+		if m.Role == RoleViewer {
+			continue
+		}
+		if err := m.changeRole(ctx, tx, RoleViewer); err != nil {
+			return nil, err
+		}
+	}
+	for _, t := range a.tasks {
+		if t.AssigneeID == "" {
+			continue
+		}
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	return a.members, nil
+}
