@@ -0,0 +1,110 @@
+package main
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+type memberRoleJSON struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"manager of another project", "ivy", "ops", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"archived", "ann", "legacy", 409},
+		{"unknown project", "ann", "nope", 404},
+		{"anonymous", "", "web", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeResponseAndEffect(t *testing.T) {
+	h := newServer()
+
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("freeze: got %d want 200: %s", code, body)
+	}
+	var members []memberRoleJSON
+	if err := json.Unmarshal([]byte(body), &members); err != nil {
+		t.Fatalf("freeze body %q: %v", body, err)
+	}
+	// Every member of web, managers included, is now a viewer; ordered by user ID.
+	want := []memberRoleJSON{
+		{"ann", "viewer"}, {"ben", "viewer"}, {"cat", "viewer"}, {"dan", "viewer"}, {"ivy", "viewer"},
+	}
+	if len(members) != len(want) {
+		t.Fatalf("freeze body %q: got %d members, want %d", body, len(members), len(want))
+	}
+	for i := range want {
+		if members[i] != want[i] {
+			t.Fatalf("member %d: got %+v want %+v", i, members[i], want[i])
+		}
+	}
+
+	// t1 was assigned to ben, who is a viewer now, so the task is unassigned.
+	if _, body := do(t, h, "GET", "/projects/web/tasks/t1", "dan", ""); !strings.Contains(body, `"assignee":""`) {
+		t.Fatalf("t1 should be unassigned after freeze: %s", body)
+	}
+
+	// Nobody can change the project's tasks any more.
+	writes := []struct {
+		name, method, user, path, body string
+	}{
+		{"manager create", "POST", "ann", "/projects/web/tasks", `{"title":"x"}`},
+		{"manager patch", "PATCH", "ann", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"manager delete", "DELETE", "ann", "/projects/web/tasks/t1", ""},
+		{"contributor patch", "PATCH", "ben", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"contributor create", "POST", "cat", "/projects/web/tasks", `{"title":"x","assignee":"cat"}`},
+		{"second freeze", "POST", "ann", "/projects/web/freeze", ""},
+	}
+	for _, w := range writes {
+		t.Run(w.name, func(t *testing.T) {
+			if code, _ := do(t, h, w.method, w.path, w.user, w.body); code != 403 {
+				t.Fatalf("got %d want 403", code)
+			}
+		})
+	}
+
+	// Reads still work.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "dan", ""); code != 200 {
+		t.Fatalf("list after freeze: got %d want 200", code)
+	}
+}
+
+func TestFreezeLeavesOtherProjectsAlone(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/ops/freeze", "ivy", ""); code != 200 {
+		t.Fatalf("freeze ops: got %d want 200: %s", code, body)
+	}
+	// t4 in ops was assigned to cat; it is unassigned now.
+	if _, body := do(t, h, "GET", "/projects/ops/tasks/t4", "ivy", ""); !strings.Contains(body, `"assignee":""`) {
+		t.Fatalf("t4 should be unassigned after freezing ops: %s", body)
+	}
+	// web is not frozen: its manager can still write, and its assignments stay.
+	if code, body := do(t, h, "POST", "/projects/web/tasks", "ann", `{"title":"x"}`); code != 200 {
+		t.Fatalf("web create after freezing ops: got %d want 200: %s", code, body)
+	}
+	if _, body := do(t, h, "GET", "/projects/web/tasks/t1", "ann", ""); !strings.Contains(body, `"assignee":"ben"`) {
+		t.Fatalf("web t1 should keep its assignee: %s", body)
+	}
+}
