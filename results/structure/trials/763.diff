+// ---- operations -----------------------------------------------------------------------
+
+// MembershipTableMoveInput is the input of MembershipTable.Move.
+type MembershipTableMoveInput struct {
+	UserID      string
+	ToProjectID string
+}
+
+// Move moves a member from the authorized project to another project, keeping
+// the role. The actor must manage both projects. The member's tasks in the
+// source project are unassigned, since they would otherwise be assigned to a
+// non-member. A member already in the destination is a conflict.
+func (*MembershipTable) Move(ctx context.Context, db DB, authz ProjectAuthz, in MembershipTableMoveInput) (*Membership, error) {
+	if !authz.CanRead() {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if in.ToProjectID == authz.ProjectID() {
+		return nil, deny(ErrInvalid, "destination must be a different project")
+	}
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	dest, err := NewProjectAuthz(ctx, db, authz.Actor(), in.ToProjectID)
+	if err != nil {
+		return nil, err
+	}
+	if err := dest.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveMember(ctx, tx, authz.ProjectID(), in)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		m, err = agg.apply(ctx, tx)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
