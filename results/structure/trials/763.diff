+		t.Fatalf("cat in ops after conflict: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "cat", ""); code != 200 {
+		t.Fatalf("cat in web after conflict: got %d want 200", code)
+	}
+}
