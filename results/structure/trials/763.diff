+// moveMemberAggregate moves one member from the source project to the
+// destination project.
+type moveMemberAggregate struct {
+	source   *Project
+	dest     *Project
+	member   *Membership // the user's membership in the source project
+	existing *Membership // the user's membership in the destination project, if any
+}
+
+func loadMoveMember(ctx context.Context, tx DB, sourceID string, in MembershipTableMoveInput) (*moveMemberAggregate, error) {
+	src, err := NewProjectTable().Find(ctx, tx, sourceID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	dest, err := NewProjectTable().Find(ctx, tx, in.ToProjectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	m, err := src.Membership(ctx, tx, in.UserID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &moveMemberAggregate{source: src, dest: dest, member: m}
+	existing, err := dest.Membership(ctx, tx, in.UserID)
+	if err == nil {
+		a.existing = existing
+	} else if !errors.Is(err, ErrNoRows) {
+		return nil, err
+	}
+	return a, nil
+}
+
+func (a *moveMemberAggregate) validate() error {
+	if a.dest.Org != a.source.Org {
+		return deny(ErrInvalid, "members must stay in the project's organization")
+	}
+	if a.existing != nil {
+		return deny(ErrConflict, "user is already a member of the destination project")
+	}
+	return nil
+}
+
+func (a *moveMemberAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	tasks, err := a.member.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, t := range tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	if err := a.member.destroy(ctx, tx); err != nil {
+		return nil, err
+	}
+	m := &Membership{ProjectID: a.dest.ID, UserID: a.member.UserID, Role: a.member.Role}
+	if err := m.save(ctx, tx); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
+
