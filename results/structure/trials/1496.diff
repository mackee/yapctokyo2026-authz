+// setMemberRoleAggregate changes the role of one member of one project.
+type setMemberRoleAggregate struct {
+	membership    *Membership
+	role          string
+	assignedTasks []*Task // the member's tasks in the project; they need a writer role
+}
+
+func loadSetMemberRole(ctx context.Context, tx DB, projectID, userID, role string) (*setMemberRoleAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	m, err := p.Membership(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "member not found")
+	} else if err != nil {
+		return nil, err
+	}
+	tasks, err := m.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &setMemberRoleAggregate{membership: m, role: role, assignedTasks: tasks}, nil
+}
+
+func (a *setMemberRoleAggregate) validate() error {
+	if !isWriterRole(a.role) && len(a.assignedTasks) > 0 {
+		return deny(ErrInvalid, "member has tasks assigned in the project; reassign them before making them a viewer")
+	}
+	return nil
+}
+
+func (a *setMemberRoleAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.membership.setRole(ctx, tx, a.role); err != nil {
+		return nil, err
+	}
+	return a.membership, nil
+}
+
