+// ---- operations -----------------------------------------------------------------------
+
+// MembershipTableUpdateInput is the input of MembershipTable.Update.
+type MembershipTableUpdateInput struct {
+	Role string // manager, contributor or viewer
+}
+
+// Update changes the role of a member of the project, all or nothing. Only
+// managers may do it. A member with tasks assigned in the project cannot become
+// a viewer, since assignees must be contributors or managers.
+func (*MembershipTable) Update(ctx context.Context, db DB, authz ProjectAuthz, userID string, in MembershipTableUpdateInput) (*Membership, error) {
+	if err := authz.CanManageMembers(); err != nil {
+		return nil, err
+	}
+	if !isValidRole(in.Role) {
+		return nil, deny(ErrInvalid, "role must be manager, contributor or viewer")
+	}
+	var m *Membership
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadSetMemberRole(ctx, tx, authz.ProjectID(), userID, in.Role)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if m, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
