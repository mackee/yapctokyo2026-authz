index 0000000..d69c320
--- /dev/null
+++ b/member_test.go
@@ -0,0 +1,74 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestUpdateMember(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager promotes", "ann", "/projects/web/members/ben", `{"role":"manager"}`, 200},
+		{"manager keeps role", "ann", "/projects/web/members/cat", `{"role":"contributor"}`, 200},
+		{"manager demotes member without tasks", "ann", "/projects/web/members/ivy", `{"role":"viewer"}`, 200},
+		{"manager demotes member with assigned task", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 400},
+		{"contributor", "ben", "/projects/web/members/cat", `{"role":"manager"}`, 403},
+		{"contributor self promote", "ben", "/projects/web/members/ben", `{"role":"manager"}`, 403},
+		{"viewer", "dan", "/projects/web/members/ben", `{"role":"manager"}`, 403},
+		{"manager of other project only", "ann", "/projects/ops/members/cat", `{"role":"viewer"}`, 403},
+		{"org admin", "eve", "/projects/web/members/ben", `{"role":"manager"}`, 403},
+		{"non member", "hal", "/projects/web/members/ben", `{"role":"manager"}`, 404},
+		{"other org", "gus", "/projects/web/members/ben", `{"role":"manager"}`, 404},
+		{"anonymous", "", "/projects/web/members/ben", `{"role":"manager"}`, 401},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"target in other org", "ann", "/projects/web/members/gus", `{"role":"viewer"}`, 404},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"unknown role", "ann", "/projects/web/members/ben", `{"role":"owner"}`, 400},
+		{"missing role", "ann", "/projects/web/members/ben", `{}`, 400},
+		{"bad json", "ann", "/projects/web/members/ben", `{"role":`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members/ivy", "ann", `{"role":"viewer"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 2 || got["userId"] != "ivy" || got["role"] != "viewer" {
+		t.Fatalf("got body %s", body)
+	}
+}
+
+func TestUpdateMemberChangesAccess(t *testing.T) {
+	h := newServer()
+
+	// ben is promoted to manager, so may now delete a task assigned to someone else.
+	if code, body := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"manager"}`); code != 200 {
+		t.Fatalf("promote: got %d: %s", code, body)
+	}
+	if code, _ := do(t, h, "DELETE", "/projects/web/tasks/t2", "ben", ""); code != 204 {
+		t.Fatalf("promoted manager delete: got %d want 204", code)
+	}
+
+	// ivy is demoted to viewer, so may no longer edit tasks.
+	if code, body := do(t, h, "PUT", "/projects/web/members/ivy", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote: got %d: %s", code, body)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t3", "ivy", `{"status":"done"}`); code != 403 {
+		t.Fatalf("demoted viewer patch: got %d want 403", code)
+	}
+}
