+func TestSetMemberRoles(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager", "ann", "/projects/web/members", `{"roles":{"ben":"viewer"}}`, 200},
+		{"contributor", "ben", "/projects/web/members", `{"roles":{"cat":"viewer"}}`, 403},
+		{"viewer", "dan", "/projects/web/members", `{"roles":{"cat":"viewer"}}`, 403},
+		{"org admin", "eve", "/projects/web/members", `{"roles":{"cat":"viewer"}}`, 403},
+		{"non member", "hal", "/projects/web/members", `{"roles":{"cat":"viewer"}}`, 404},
+		{"other org", "gus", "/projects/web/members", `{"roles":{"cat":"viewer"}}`, 404},
+		{"anonymous", "", "/projects/web/members", `{"roles":{"cat":"viewer"}}`, 401},
+		{"archived", "ann", "/projects/legacy/members", `{"roles":{"ben":"viewer"}}`, 409},
+		{"target not a member", "ann", "/projects/web/members", `{"roles":{"hal":"viewer"}}`, 400},
+		{"target in other project", "ann", "/projects/web/members", `{"roles":{"ann":"viewer","gus":"viewer"}}`, 400},
+		{"invalid role", "ann", "/projects/web/members", `{"roles":{"ben":"owner"}}`, 400},
+		{"empty roles", "ann", "/projects/web/members", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "/projects/web/members", `{}`, 400},
+		{"malformed body", "ann", "/projects/web/members", `{"roles":`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetMemberRolesApplies(t *testing.T) {
+	srv := newServer()
+	code, body := do(t, srv, "PUT", "/projects/web/members", "ann",
+		`{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var members []Member
+	if err := json.Unmarshal([]byte(body), &members); err != nil {
+		t.Fatal(err)
+	}
+	want := []Member{
+		{UserID: "ann", Role: "manager"},
+		{UserID: "ben", Role: "viewer"},
+		{UserID: "cat", Role: "contributor"},
+		{UserID: "dan", Role: "contributor"},
+		{UserID: "ivy", Role: "manager"},
+	}
+	if len(members) != len(want) {
+		t.Fatalf("got %d members want %d: %s", len(members), len(want), body)
+	}
+	for i := range want {
+		if members[i] != want[i] {
+			t.Fatalf("member %d: got %+v want %+v", i, members[i], want[i])
+		}
+	}
+
+	// The new roles take effect for later requests.
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Fatalf("demoted ben create: got %d want 403", code)
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 201 {
+		t.Fatalf("promoted dan create: got %d want 201", code)
+	}
+}
+
+func TestSetMemberRolesIsAllOrNothing(t *testing.T) {
+	srv := newServer()
+	cases := []string{
+		// one valid change and one target that is not a member
+		`{"roles":{"ben":"viewer","hal":"viewer"}}`,
+		// one valid change and one invalid role
+		`{"roles":{"ben":"viewer","cat":"owner"}}`,
+	}
+	for _, body := range cases {
+		if code, _ := do(t, srv, "PUT", "/projects/web/members", "ann", body); code != 400 {
+			t.Fatalf("%s: got %d want 400", body, code)
+		}
+	}
+	// Nothing changed: ben can still create, and dan is still only a viewer.
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 201 {
+		t.Fatalf("ben create after failed change: got %d want 201", code)
+	}
+	if code, _ := do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 403 {
+		t.Fatalf("dan create after failed change: got %d want 403", code)
+	}
+}
