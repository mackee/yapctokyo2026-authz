+++ b/internal/capability/aggregate.go
@@ -10,6 +10,51 @@ package capability
 //   - an assignee is a contributor or manager of the task's project
 //   - project members are users of the project's organization, with a valid role
 
+import "sort"
+
+// setRolesAggregate changes the roles of existing members of one project.
+type setRolesAggregate struct {
+	projectID string
+	changes   []membershipRecord // the members with their new roles, sorted by user ID
+}
+
+func loadSetRoles(x *tx, projectID string, roles map[string]string) (*setRolesAggregate, error) {
+	userIDs := make([]string, 0, len(roles))
+	for uid := range roles {
+		userIDs = append(userIDs, uid)
+	}
+	sort.Strings(userIDs)
+
+	a := &setRolesAggregate{projectID: projectID}
+	for _, uid := range userIDs {
+		if _, ok := x.findMembership(projectID, uid); !ok {
+			return nil, deny(ErrInvalid, "user "+uid+" is not a member of the project")
+		}
+		a.changes = append(a.changes, membershipRecord{ProjectID: projectID, UserID: uid, Role: roles[uid]})
+	}
+	return a, nil
+}
+
+func (a *setRolesAggregate) validate() error {
+	for _, m := range a.changes {
+		if !isValidRole(m.Role) {
+			return deny(ErrInvalid, "invalid role for user "+m.UserID)
+		}
+	}
+	return nil
+}
+
+func (a *setRolesAggregate) save(x *tx) []MemberView {
+	for _, m := range a.changes {
+		m.save(x)
+	}
+	out := []MemberView{}
+	for _, m := range x.membershipsOf(a.projectID) {
+		out = append(out, m.view())
+	}
+	return out
+}
+
