+func TestUpdateMemberRoles(t *testing.T) {
+	const path = "/projects/web/members"
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager changes roles", "ann", path, `{"roles":{"ben":"viewer","dan":"contributor"}}`, 200},
+		{"contributor forbidden", "ben", path, `{"roles":{"dan":"contributor"}}`, 403},
+		{"viewer forbidden", "dan", path, `{"roles":{"dan":"manager"}}`, 403},
+		{"org admin forbidden", "eve", path, `{"roles":{"dan":"contributor"}}`, 403},
+		{"non member", "hal", path, `{"roles":{"dan":"contributor"}}`, 404},
+		{"anonymous", "", path, `{"roles":{"dan":"contributor"}}`, 401},
+		{"archived", "ann", "/projects/legacy/members", `{"roles":{"ben":"viewer"}}`, 409},
+		{"invalid role", "ann", path, `{"roles":{"dan":"boss"}}`, 400},
+		{"empty roles", "ann", path, `{"roles":{}}`, 400},
+		{"missing roles", "ann", path, `{}`, 400},
+		{"non member target", "ann", path, `{"roles":{"hal":"viewer"}}`, 400},
+		{"last manager", "ann", path, `{"roles":{"ann":"viewer","ivy":"viewer"}}`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "PUT", c.project, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+
+	t.Run("result and unassign", func(t *testing.T) {
+		h := newServer()
+		code, body := do(t, h, "PUT", path, "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+		if code != 200 {
+			t.Fatal(code, body)
+		}
+		var got []map[string]string
+		if err := json.Unmarshal([]byte(body), &got); err != nil {
+			t.Fatal(err)
+		}
+		want := map[string]string{"ann": "manager", "ben": "viewer", "cat": "contributor", "dan": "contributor", "ivy": "manager"}
+		if len(got) != len(want) {
+			t.Fatalf("got %v", got)
+		}
+		for _, m := range got {
+			if want[m["userId"]] != m["role"] {
+				t.Fatalf("got %v", got)
+			}
+		}
+		_, task := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+		if !strings.Contains(task, `"assignee":""`) {
+			t.Fatalf("t1 should be unassigned: %s", task)
+		}
+	})
+
+	t.Run("all or nothing", func(t *testing.T) {
+		h := newServer()
+		if code, _ := do(t, h, "PUT", path, "ann", `{"roles":{"dan":"contributor","hal":"viewer"}}`); code != 400 {
+			t.Fatal(code)
+		}
+		_, body := do(t, h, "PUT", path, "ann", `{"roles":{"dan":"viewer"}}`)
+		if !strings.Contains(body, `{"userId":"dan","role":"viewer"}`) {
+			t.Fatalf("dan changed: %s", body)
+		}
+	})
+}
