 }
 
+// updateRolesAggregate changes the roles of several members of one project.
+type updateRolesAggregate struct {
+	members  []*Membership      // the members being changed, ordered by user ID
+	roles    map[string]string  // user ID -> new role
+	assigned map[string][]*Task // user ID -> tasks assigned to them in the project
+	managers int                // managers of the project after the change
+}
+
+func loadUpdateRoles(ctx context.Context, tx DB, projectID string, roles map[string]string) (*updateRolesAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrInvalid, "project must exist")
+	} else if err != nil {
+		return nil, err
+	}
+	all, err := p.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	a := &updateRolesAggregate{roles: roles, assigned: map[string][]*Task{}}
+	for _, m := range all { // ordered by user ID
+		role := m.Role
+		if nr, ok := roles[m.UserID]; ok {
+			a.members = append(a.members, m)
+			tasks, err := m.AssignedTasks(ctx, tx)
+			if err != nil {
+				return nil, err
+			}
+			a.assigned[m.UserID] = tasks
+			role = nr
+		}
+		if role == RoleManager {
+			a.managers++
+		}
+	}
+	if len(a.members) != len(roles) {
+		return nil, deny(ErrInvalid, "every user must be a member of the project")
+	}
+	return a, nil
+}
+
+func (a *updateRolesAggregate) validate() error {
+	for _, m := range a.members {
+		role := a.roles[m.UserID]
+		switch role {
+		case RoleManager, RoleContributor, RoleViewer:
+		default:
+			return deny(ErrInvalid, "role must be manager, contributor or viewer")
+		}
+	}
+	if a.managers == 0 {
+		return deny(ErrInvalid, "the project must keep at least one manager")
+	}
+	return nil
+}
+
+func (a *updateRolesAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	var projectID string
+	for _, m := range a.members {
+		projectID = m.ProjectID
+		role := a.roles[m.UserID]
+		if err := m.setRole(ctx, tx, role); err != nil {
+			return nil, err
+		}
+		// An assignee must be a contributor or manager: a member who is no
+		// longer one has their tasks unassigned.
+		if !isWriterRole(role) {
+			for _, t := range a.assigned[m.UserID] {
+				if err := t.unassign(ctx, tx); err != nil {
+					return nil, err
+				}
+			}
+		}
+	}
+	return NewMembershipTable().ListByProject(ctx, tx, projectID)
+}
