 func (a *deleteTaskAggregate) validate() error { return nil }
 
 func (a *deleteTaskAggregate) apply(ctx context.Context, tx DB) error { return a.task.destroy(ctx, tx) }
+
+// transferUserAggregate moves one user from the organization of the path to
+// another organization.
+type transferUserAggregate struct {
+	user     *User
+	toOrg    string
+	blocking []*Project // projects of the user's current organization the user is a member of
+}
+
+func loadTransferUser(ctx context.Context, tx DB, orgID string, in UserTableTransferInput) (*transferUserAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, in.UserID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != orgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	if in.ToOrgID == u.Org {
+		return nil, deny(ErrInvalid, "user is already in that organization")
+	}
+	ms, err := u.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	a := &transferUserAggregate{user: u, toOrg: in.ToOrgID}
+	for _, m := range ms {
+		p, err := m.Project(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+		if p.Org == u.Org {
+			a.blocking = append(a.blocking, p)
+		}
+	}
+	return a, nil
+}
+
+// validate: project members must belong to the project's organization, so a
+// user who is still a member of a project in the current organization cannot
+// move. Removing those memberships is not part of this operation.
+func (a *transferUserAggregate) validate() error {
+	if len(a.blocking) > 0 {
+		return deny(ErrConflict, "user is a member of projects in the current organization")
+	}
+	return nil
+}
+
+func (a *transferUserAggregate) apply(ctx context.Context, tx DB) (*User, error) {
+	if err := a.user.moveTo(ctx, tx, a.toOrg); err != nil {
+		return nil, err
+	}
+	return a.user, nil
+}
