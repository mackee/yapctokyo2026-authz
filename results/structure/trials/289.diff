+// ManageProject may change member roles in one project.
+type ManageProject interface {
+	ReadProject
+	// SetMemberRole changes the role of an existing member of this project.
+	// A user who is not a member is 404, an unknown role is 400, and a change
+	// that would leave a task assigned to a non-writer is 400 (nothing changes).
+	SetMemberRole(userID, role string) (MemberView, error)
+}
+
+// MemberView is the public representation of a project membership.
+type MemberView struct {
+	UserID string `json:"userId"`
+	Role   string `json:"role"`
+}
+
+type manageProject struct {
+	readProject
+}
+
+func (p *manageProject) SetMemberRole(userID, role string) (MemberView, error) {
+	if !validRole(role) {
+		return MemberView{}, deny(ErrInvalid, "role must be manager, contributor or viewer")
+	}
+	var v MemberView
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		if _, ok := s.members[p.ps.pid][userID]; !ok {
+			return deny(ErrNotFound, "member not found")
+		}
+		s.members[p.ps.pid][userID] = role
+		v = MemberView{UserID: userID, Role: role}
+		return nil
+	})
+	return v, err
+}
+
 type readProject struct{ ps *projectScope }
 
 func (p *readProject) ID() string { return p.ps.pid }
