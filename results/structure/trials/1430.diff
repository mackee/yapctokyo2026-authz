+}
+
+func TestFreeze(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("freeze: got %d: %s", code, body)
+	}
+	var members []map[string]string
+	if err := json.Unmarshal([]byte(body), &members); err != nil {
+		t.Fatal(err)
+	}
+	got := map[string]string{}
+	for _, m := range members {
+		if len(m) != 2 {
+			t.Fatalf("unexpected member shape %v", m)
+		}
+		got[m["userId"]] = m["role"]
+	}
+	want := map[string]string{"ann": "viewer", "ben": "viewer", "cat": "viewer", "dan": "viewer", "ivy": "viewer"}
+	if len(got) != len(want) {
+		t.Fatalf("got members %v want %v", got, want)
+	}
+	for u, r := range want {
+		if got[u] != r {
+			t.Fatalf("got members %v want %v", got, want)
+		}
+	}
+
+	// Nobody can change the project's tasks any more, managers included.
+	for _, u := range []string{"ann", "ben", "cat", "dan", "ivy", "eve"} {
+		if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", u, `{"status":"done"}`); code != 403 {
+			t.Fatalf("%s patch: got %d want 403", u, code)
+		}
+		if code, _ := do(t, h, "POST", "/projects/web/tasks", u, `{"title":"x"}`); code != 403 {
+			t.Fatalf("%s create: got %d want 403", u, code)
+		}
+		if code, _ := do(t, h, "DELETE", "/projects/web/tasks/t1", u, ""); code != 403 {
+			t.Fatalf("%s delete: got %d want 403", u, code)
+		}
+	}
+	// A second freeze is refused: the caller is no longer a manager.
+	if code, _ := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != 403 {
+		t.Fatalf("second freeze: got %d want 403", code)
+	}
+
+	// Reads still work, and the tasks are unassigned (assignees must be writers).
+	code, body = do(t, h, "GET", "/projects/web/tasks", "dan", "")
+	if code != 200 {
+		t.Fatal(code)
+	}
+	var tasks []Task
+	if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+		t.Fatal(err)
+	}
+	if len(tasks) != 3 {
+		t.Fatalf("want 3 tasks, got %d", len(tasks))
+	}
+	for _, task := range tasks {
+		if task.AssigneeID != "" || task.Status == "" {
+			t.Fatalf("task %s after freeze: %+v", task.ID, task)
+		}
+	}
+
+	// Other projects are untouched.
+	if code, _ := do(t, h, "PATCH", "/projects/ops/tasks/t4", "cat", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ops patch: got %d want 200", code)
+	}
+	code, body = do(t, h, "GET", "/projects/ops/tasks/t4", "cat", "")
+	if code != 200 || !strings.Contains(body, `"assignee":"cat"`) {
+		t.Fatalf("ops task changed: %d %s", code, body)
+	}
+}
