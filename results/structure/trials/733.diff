+func TestSetMemberRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"contributor cannot change roles", "ben", "/projects/web/members/cat", `{"role":"viewer"}`, 403},
+		{"contributor cannot promote self", "ben", "/projects/web/members/ben", `{"role":"manager"}`, 403},
+		{"viewer", "dan", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"org admin is not a manager", "eve", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"non member", "hal", "/projects/web/members/dan", `{"role":"contributor"}`, 404},
+		{"other org", "gus", "/projects/web/members/dan", `{"role":"contributor"}`, 404},
+		{"anonymous", "", "/projects/web/members/dan", `{"role":"contributor"}`, 401},
+		{"unknown user", "zed", "/projects/web/members/dan", `{"role":"contributor"}`, 401},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"viewer"}`, 404},
+		{"target in other org", "ann", "/projects/web/members/gus", `{"role":"viewer"}`, 404},
+		{"unknown role", "ann", "/projects/web/members/dan", `{"role":"owner"}`, 400},
+		{"missing role", "ann", "/projects/web/members/dan", `{}`, 400},
+		{"malformed body", "ann", "/projects/web/members/dan", `{`, 400},
+		{"demote assignee", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 400},
+		{"archived", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestSetMemberRoleResponseAndEffect(t *testing.T) {
+	srv := newServer()
+	code, body := do(t, srv, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["userId"] != "dan" || got["role"] != "contributor" {
+		t.Fatalf("body=%s", body)
+	}
+	// dan can now write.
+	if code, body := do(t, srv, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("promoted dan: got %d body=%s", code, body)
+	}
+
+	// Demoting ivy (no assigned tasks in web) takes effect immediately.
+	if code, body := do(t, srv, "PUT", "/projects/web/members/ivy", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote ivy: got %d body=%s", code, body)
+	}
+	if code, body := do(t, srv, "POST", "/projects/web/tasks", "ivy", `{"title":"x"}`); code != 403 {
+		t.Fatalf("demoted ivy: got %d body=%s", code, body)
+	}
+	// ...and the demoted user can still read.
+	if code, body := do(t, srv, "GET", "/projects/web/tasks", "ivy", ""); code != 200 {
+		t.Fatalf("demoted ivy read: got %d body=%s", code, body)
+	}
+}
