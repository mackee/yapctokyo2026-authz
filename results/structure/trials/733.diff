+// setRoleAggregate changes one member's role in one project.
+type setRoleAggregate struct {
+	member   *Membership
+	role     string
+	assigned []*Task // the member's tasks in the project; checked when demoting to a non-assignee role
+}
+
+func loadSetRole(ctx context.Context, tx DB, projectID, userID, role string) (*setRoleAggregate, error) {
+	m, err := NewMembershipTable().Find(ctx, tx, projectID, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "member not found")
+	} else if err != nil {
+		return nil, err
+	}
+	a := &setRoleAggregate{member: m, role: role}
+	if !isWriterRole(role) {
+		a.assigned, err = m.AssignedTasks(ctx, tx)
+		if err != nil {
+			return nil, err
+		}
+	}
+	return a, nil
+}
+
+func (a *setRoleAggregate) validate() error {
+	if !isWriterRole(a.role) && len(a.assigned) > 0 {
+		return deny(ErrInvalid, "member is assigned tasks in the project; reassign them before making them a viewer")
+	}
+	return nil
+}
+
+func (a *setRoleAggregate) apply(ctx context.Context, tx DB) (*Membership, error) {
+	if err := a.member.changeRole(ctx, tx, a.role); err != nil {
+		return nil, err
+	}
+	return a.member, nil
+}
+
