+// removeFromOrgAggregate removes one user from the organization's projects.
+type removeFromOrgAggregate struct {
+	user        *User
+	memberships []*Membership // the user's memberships in the organization's projects
+	tasks       []*Task       // the tasks assigned to the user in those projects
+}
+
+func loadRemoveFromOrg(ctx context.Context, tx DB, orgID, userID string) (*removeFromOrgAggregate, error) {
+	u, err := NewUserTable().Find(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	if u.Org != orgID {
+		return nil, deny(ErrNotFound, "not found")
+	}
+	ms, err := u.MembershipsInOrg(ctx, tx, orgID)
+	if err != nil {
+		return nil, err
+	}
+	ts, err := u.AssignedTasksInOrg(ctx, tx, orgID)
+	if err != nil {
+		return nil, err
+	}
+	return &removeFromOrgAggregate{user: u, memberships: ms, tasks: ts}, nil
+}
+
+func (a *removeFromOrgAggregate) validate() error { return nil }
+
+func (a *removeFromOrgAggregate) apply(ctx context.Context, tx DB) error {
+	// Unassign first, so that no task is left with an assignee who is not a member.
+	for _, t := range a.tasks {
+		if err := t.unassign(ctx, tx); err != nil {
+			return err
+		}
+	}
+	for _, m := range a.memberships {
+		if err := m.destroy(ctx, tx); err != nil {
+			return err
+		}
+	}
+	return nil
+}
