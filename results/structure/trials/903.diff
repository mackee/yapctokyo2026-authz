+// RemoveFromOrg removes the user from every project of the organization
+// (the user's memberships there), for example when they leave the company.
+// The user's tasks in those projects are unassigned, so no task keeps an
+// assignee who is no longer a member. The user row itself is kept. Org admins
+// of the organization only. Removing a user who is not in any of its projects
+// succeeds; a user who is not in the organization is ErrNotFound.
+func (*UserTable) RemoveFromOrg(ctx context.Context, db DB, authz OrgAuthz, userID string) error {
+	if err := authz.CanManageMembers(); err != nil {
+		return err
+	}
+	return inTx(ctx, db, func(tx DB) error {
+		agg, err := loadRemoveFromOrg(ctx, tx, authz.OrgID(), userID)
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		return agg.apply(ctx, tx)
+	})
+}
