+// CanManageMembers returns nil if the actor may change members' roles:
+// managers only (else ErrForbidden) and not archived (else ErrArchived).
+func (a ProjectAuthz) CanManageMembers() error {
+	if !a.CanRead() || a.role != RoleManager {
+		return deny(ErrForbidden, "only managers may change member roles")
+	}
+	if a.archived {
+		return deny(ErrArchived, "project is archived")
+	}
+	return nil
+}
