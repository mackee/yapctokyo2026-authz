--- /dev/null
+++ b/internal/model/freeze_test.go
@@ -0,0 +1,56 @@
+package model
+
+import (
+	"context"
+	"errors"
+	"testing"
+)
+
+// A frozen project refuses task writes even for a user whose role would
+// otherwise allow them. Freezing normally demotes the members too, so this
+// guard is what keeps the invariant if a writer role ever exists in a frozen
+// project.
+func TestFrozenProjectRefusesWritesWhateverTheRole(t *testing.T) {
+	ctx := context.Background()
+	db, err := Open()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := db.ExecContext(ctx, `UPDATE projects SET frozen = 1 WHERE id = 'web'`); err != nil {
+		t.Fatal(err)
+	}
+
+	ben := Actor{id: "ben", org: "acme"} // contributor of web, assignee of t1
+	ann := Actor{id: "ann", org: "acme"} // manager of web
+
+	pa, err := NewProjectAuthz(ctx, db, ben, "web")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := pa.CanWrite(); !errors.Is(err, ErrFrozen) {
+		t.Fatalf("CanWrite: got %v, want ErrFrozen", err)
+	}
+	ta, err := NewTaskAuthz(ctx, db, pa, "t1")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := ta.CanEdit(); !errors.Is(err, ErrFrozen) {
+		t.Fatalf("CanEdit: got %v, want ErrFrozen", err)
+	}
+
+	pa, err = NewProjectAuthz(ctx, db, ann, "web")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ta, err = NewTaskAuthz(ctx, db, pa, "t2")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := ta.CanManage(); !errors.Is(err, ErrFrozen) {
+		t.Fatalf("CanManage: got %v, want ErrFrozen", err)
+	}
+	// Freezing again stays allowed for a manager.
+	if err := pa.CanFreeze(); err != nil {
+		t.Fatalf("CanFreeze on frozen project: got %v, want nil", err)
+	}
+}
