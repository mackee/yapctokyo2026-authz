+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"manager of other project", "ivy", "ops", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"anonymous", "", "web", 401},
+		{"unknown user", "zed", "web", 401},
+		{"archived", "ann", "legacy", 409},
+		{"missing project", "ann", "nope", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeMembers(t *testing.T) {
+	srv := newServer()
+	code, body := do(t, srv, "POST", "/projects/web/freeze", "ann", "")
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got []struct {
+		UserID string `json:"userId"`
+		Role   string `json:"role"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := []string{"ann", "ben", "cat", "dan", "ivy"}
+	if len(got) != len(want) {
+		t.Fatalf("members %s", body)
+	}
+	for i, m := range got {
+		if m.UserID != want[i] || m.Role != "viewer" {
+			t.Fatalf("member %d = %+v, want {%s viewer}; body=%s", i, m, want[i], body)
+		}
+	}
+
+	// Ann was demoted, so she can no longer freeze the project again.
+	if code, again := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != 403 {
+		t.Fatalf("second freeze by former manager: got %d body=%s, want 403", code, again)
+	}
+}
+
+func TestFreezeLocksTasks(t *testing.T) {
+	srv := newServer()
+	if code, body := do(t, srv, "POST", "/projects/web/freeze", "ann", ""); code != 200 {
+		t.Fatalf("freeze: got %d body=%s", code, body)
+	}
+
+	cases := []struct {
+		name, user, method, path, body string
+		want                           int
+	}{
+		{"former manager patches", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`, 403},
+		{"former manager reassigns", "ann", "PATCH", "/projects/web/tasks/t2", `{"assignee":"ben"}`, 403},
+		{"former manager creates", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"former manager deletes", "ann", "DELETE", "/projects/web/tasks/t1", "", 403},
+		{"former contributor patches own", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`, 403},
+		{"former contributor creates", "cat", "POST", "/projects/web/tasks", `{"title":"x"}`, 403},
+		{"other manager patches", "ivy", "PATCH", "/projects/web/tasks/t3", `{"title":"y"}`, 403},
+		{"reads still work", "dan", "GET", "/projects/web/tasks/t1", "", 200},
