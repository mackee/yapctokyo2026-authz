+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"reflect"
+	"testing"
+)
+
+func TestFreezeAccess(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                int
+	}{
+		{"manager", "ann", "web", 200},
+		{"contributor", "ben", "web", 403},
+		{"viewer", "dan", "web", 403},
+		{"org admin", "eve", "web", 403},
+		{"non member", "hal", "web", 404},
+		{"other org", "gus", "web", 404},
+		{"unknown project", "ann", "nope", 404},
+		{"archived", "ann", "legacy", 409},
+		{"anonymous", "", "web", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeReturnsMembersAsViewers(t *testing.T) {
+	cases := []struct {
+		name, user, project string
+		want                []freezeMember
+	}{
+		{
+			// web members: ann (manager), ben, cat (contributors), dan (viewer), ivy (manager)
+			name: "web", user: "ann", project: "web",
+			want: []freezeMember{
+				{"ann", "viewer"}, {"ben", "viewer"}, {"cat", "viewer"}, {"dan", "viewer"}, {"ivy", "viewer"},
+			},
+		},
+		{
+			// ops members: ann (viewer), cat (contributor), ivy (manager)
+			name: "ops by its other manager", user: "ivy", project: "ops",
+			want: []freezeMember{
+				{"ann", "viewer"}, {"cat", "viewer"}, {"ivy", "viewer"},
+			},
+		},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", "/projects/"+c.project+"/freeze", c.user, "")
+			if code != http.StatusOK {
+				t.Fatalf("got %d want 200: %s", code, body)
+			}
+			var got []freezeMember
+			if err := json.Unmarshal([]byte(body), &got); err != nil {
+				t.Fatalf("response is not a member list: %v: %s", err, body)
+			}
+			if !reflect.DeepEqual(got, c.want) {
+				t.Fatalf("got %+v want %+v", got, c.want)
+			}
+		})
+	}
+}
+
+func TestFreezeStopsTaskWrites(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != http.StatusOK {
+		t.Fatalf("freeze: got %d want 200: %s", code, body)
+	}
+	cases := []struct {
+		name, user, method, path, body string
+	}{
+		{"former manager edits", "ann", "PATCH", "/projects/web/tasks/t2", `{"status":"done"}`},
+		{"other manager edits", "ivy", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"former contributor edits", "ben", "PATCH", "/projects/web/tasks/t1", `{"status":"done"}`},
+		{"former manager creates", "ann", "POST", "/projects/web/tasks", `{"title":"x"}`},
+		{"former manager deletes", "ann", "DELETE", "/projects/web/tasks/t3", ""},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, h, c.method, c.path, c.user, c.body)
+			if code != http.StatusForbidden {
+				t.Fatalf("got %d want 403: %s", code, body)
+			}
+		})
+	}
+	// Reads still work.
+	if code, body := do(t, h, "GET", "/projects/web/tasks", "dan", ""); code != http.StatusOK {
+		t.Fatalf("read after freeze: got %d want 200: %s", code, body)
+	}
+}
+
+func TestFreezeUnassignsTasks(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != http.StatusOK {
+		t.Fatalf("freeze: got %d want 200: %s", code, body)
+	}
+	code, body := do(t, h, "GET", "/projects/web/tasks", "dan", "")
+	if code != http.StatusOK {
+		t.Fatalf("list: got %d want 200: %s", code, body)
+	}
+	var tasks []Task
+	if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+		t.Fatal(err)
+	}
+	// Assignees of t1 (ben) and t2 (cat) are no longer contributors or managers,
+	// so the model rule "an assignee is a contributor or manager" forces them clear.
+	for _, task := range tasks {
+		if task.AssigneeID != "" {
+			t.Fatalf("task %s still assigned to %s after freeze", task.ID, task.AssigneeID)
+		}
+	}
+}
+
+func TestFreezeOnlyAffectsThatProject(t *testing.T) {
+	h := newServer()
+	if code, body := do(t, h, "POST", "/projects/web/freeze", "ann", ""); code != http.StatusOK {
+		t.Fatalf("freeze: got %d want 200: %s", code, body)
+	}
+	// ivy is still a manager of ops, which is not frozen.
+	if code, body := do(t, h, "PATCH", "/projects/ops/tasks/t4", "ivy", `{"status":"done"}`); code != http.StatusOK {
+		t.Fatalf("ops edit after web freeze: got %d want 200: %s", code, body)
+	}
+}
