 func (a *deleteTaskAggregate) apply(ctx context.Context, tx DB) error { return a.task.destroy(ctx, tx) }
+
+// freezeProjectAggregate freezes one project: every member becomes a viewer, and
+// the tasks assigned to anyone are unassigned. Once no member is a contributor
+// or manager, an assignee would break the model rule, so the assignments go.
+type freezeProjectAggregate struct {
+	project *Project
+	members []*Membership // project.Memberships, ordered by user ID
+}
+
+func loadFreezeProject(ctx context.Context, tx DB, projectID string) (*freezeProjectAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if err != nil {
+		return nil, err
+	}
+	ms, err := p.Memberships(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &freezeProjectAggregate{project: p, members: ms}, nil
+}
+
+func (a *freezeProjectAggregate) validate() error { return nil }
+
+func (a *freezeProjectAggregate) apply(ctx context.Context, tx DB) ([]*Membership, error) {
+	for _, m := range a.members {
+		if m.Role == RoleViewer {
+			continue
+		}
+		if err := m.setRole(ctx, tx, RoleViewer); err != nil {
+			return nil, err
+		}
+	}
+	tasks, err := a.project.Tasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	for _, t := range tasks {
+		if t.AssigneeID == "" {
+			continue
+		}
+		if err := t.unassign(ctx, tx); err != nil {
+			return nil, err
+		}
+	}
+	return a.members, nil
+}
