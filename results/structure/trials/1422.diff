+func TestRemoveMember(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"manager removes", "ann", "/projects/web/members/ben", 204},
+		{"manager removes self", "ann", "/projects/web/members/ann", 204},
+		{"not a member", "ann", "/projects/web/members/hal", 404},
+		{"unknown user id", "ann", "/projects/web/members/zed", 404},
+		{"contributor", "ben", "/projects/web/members/cat", 403},
+		{"viewer", "dan", "/projects/web/members/cat", 403},
+		{"org admin", "eve", "/projects/web/members/ben", 403},
+		{"non member", "hal", "/projects/web/members/ben", 404},
+		{"other org", "gus", "/projects/web/members/ben", 404},
+		{"missing project", "ann", "/projects/nope/members/ben", 404},
+		{"archived", "ann", "/projects/legacy/members/ben", 409},
+		{"anonymous", "", "/projects/web/members/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveMemberEffects(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 204 {
+		t.Fatalf("remove: %d", code)
+	}
+	// The removed member can no longer read the project.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("removed member read: got %d want 404", code)
+	}
+	// Their task in the project is unassigned; others keep their assignee.
+	code, body := do(t, h, "GET", "/projects/web/tasks", "ann", "")
+	if code != 200 {
+		t.Fatal(code)
+	}
+	var tasks []Task
+	if err := json.Unmarshal([]byte(body), &tasks); err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]string{"t1": "", "t2": "cat", "t3": ""}
+	for _, task := range tasks {
+		if task.AssigneeID != want[task.ID] {
+			t.Fatalf("task %s assignee %q want %q", task.ID, task.AssigneeID, want[task.ID])
+		}
+	}
+	// Memberships and tasks in other projects are untouched.
+	if code, _ := do(t, h, "GET", "/projects/legacy/tasks/t5", "ben", ""); code != 200 {
+		t.Fatalf("other project membership: %d", code)
+	}
+	if code, body := do(t, h, "GET", "/projects/legacy/tasks/t5", "ben", ""); code == 200 && !strings.Contains(body, `"assignee":"ben"`) {
+		t.Fatalf("other project task changed: %s", body)
+	}
+	// Removing again: no longer a member.
+	if code, _ := do(t, h, "DELETE", "/projects/web/members/ben", "ann", ""); code != 404 {
+		t.Fatalf("second remove: got %d want 404", code)
+	}
+}
