+// removeMemberAggregate removes one member from a project. The tasks of the
+// project assigned to that member become unassigned, so that an assignee is
+// always a contributor or manager of the task's project.
+type removeMemberAggregate struct {
+	membership *Membership
+	assigned   []*Task // membership.AssignedTasks
+}
+
+func loadRemoveMember(ctx context.Context, tx DB, projectID, userID string) (*removeMemberAggregate, error) {
+	p, err := NewProjectTable().Find(ctx, tx, projectID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	m, err := p.Membership(ctx, tx, userID)
+	if errors.Is(err, ErrNoRows) {
+		return nil, deny(ErrNotFound, "not found")
+	} else if err != nil {
+		return nil, err
+	}
+	tasks, err := m.AssignedTasks(ctx, tx)
+	if err != nil {
+		return nil, err
+	}
+	return &removeMemberAggregate{membership: m, assigned: tasks}, nil
+}
+
+func (a *removeMemberAggregate) validate() error { return nil }
+
+func (a *removeMemberAggregate) apply(ctx context.Context, tx DB) error {
+	for _, t := range a.assigned {
+		if err := t.unassign(ctx, tx); err != nil {
+			return err
+		}
+	}
+	return a.membership.destroy(ctx, tx)
+}
+
