+// Move moves the task from its project (authz) into the project toProjectID.
+// The actor must be a manager of the source project (not archived) and a
+// contributor or manager of the destination (not archived). The destination is
+// looked up only after the source check, so a caller who may not move the task
+// learns nothing about the destination. The task keeps its ID, title, status
+// and assignee.
+func (*TaskTable) Move(ctx context.Context, db DB, authz TaskAuthz, toProjectID string) (*Task, error) {
+	if err := authz.CanManage(); err != nil {
+		return nil, err
+	}
+	to, err := NewProjectAuthz(ctx, db, authz.Project().Actor(), toProjectID)
+	if err != nil {
+		return nil, err
+	}
+	if err := to.CanWrite(); err != nil {
+		return nil, err
+	}
+	if to.ProjectID() == authz.Project().ProjectID() {
+		return nil, deny(ErrInvalid, "task is already in the project")
+	}
+	var t *Task
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveTask(ctx, tx, authz.TaskID(), to.ProjectID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if t, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return t, nil
+}
