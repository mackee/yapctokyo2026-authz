+func TestMove(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager moves unassigned", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 200},
+		{"manager moves task of dest contributor", "ivy", "/projects/web/tasks/t2/move", `{"toProjectId":"ops"}`, 200},
+		{"assignee not writer in dest", "ivy", "/projects/web/tasks/t1/move", `{"toProjectId":"ops"}`, 400},
+		{"dest viewer", "ann", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 403},
+		{"source contributor", "ben", "/projects/web/tasks/t2/move", `{"toProjectId":"ops"}`, 403},
+		{"source viewer", "dan", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 403},
+		{"org admin not member", "eve", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 403},
+		{"non member", "hal", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 404},
+		{"other org", "gus", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 404},
+		{"anonymous", "", "/projects/web/tasks/t3/move", `{"toProjectId":"ops"}`, 401},
+		{"missing source project", "ivy", "/projects/missing/tasks/t3/move", `{"toProjectId":"ops"}`, 404},
+		{"task in other project", "ivy", "/projects/web/tasks/t4/move", `{"toProjectId":"ops"}`, 404},
+		{"missing dest project", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"missing"}`, 404},
+		{"dest in other org", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"gx"}`, 404},
+		{"dest not readable", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"legacy"}`, 404},
+		{"same project", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":"web"}`, 400},
+		{"empty dest", "ivy", "/projects/web/tasks/t3/move", `{}`, 400},
+		{"bad body", "ivy", "/projects/web/tasks/t3/move", `{"toProjectId":`, 400},
+		{"archived source", "ann", "/projects/legacy/tasks/t5/move", `{"toProjectId":"web"}`, 409},
+		{"archived dest", "ann", "/projects/web/tasks/t3/move", `{"toProjectId":"legacy"}`, 409},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestMoveKeepsTaskFields(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/projects/web/tasks/t2/move", "ivy", `{"toProjectId":"ops"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got Task
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := Task{ID: "t2", ProjectID: "ops", Title: "Update footer", Status: "doing", Assignee: "cat"}
+	if got != want {
+		t.Fatalf("response: got %+v want %+v", got, want)
+	}
+
+	if code, _ := do(t, h, "GET", "/projects/ops/tasks/t2", "ivy", ""); code != 200 {
+		t.Fatalf("moved task not in dest: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t2", "ivy", ""); code != 404 {
+		t.Fatalf("moved task still in source: %d", code)
+	}
+	code, body = do(t, h, "GET", "/projects/ops/tasks", "ivy", "")
+	if code != 200 || !strings.Contains(body, `"id":"t2"`) {
+		t.Fatalf("list of dest misses task: %d %s", code, body)
+	}
+}
+
+func TestMoveAsContributorInDestination(t *testing.T) {
+	db, err := openSeededDB()
+	if err != nil {
+		t.Fatal(err)
+	}
+	// ivy stays manager of web but becomes a contributor of ops.
+	if _, err := db.Exec(`UPDATE memberships SET role = 'contributor' WHERE project_id = 'ops' AND user_id = 'ivy'`); err != nil {
+		t.Fatal(err)
+	}
+	h := newHandler(db)
+	cases := []struct {
+		name, path string
+		want       int
+	}{
+		{"unassigned task", "/projects/web/tasks/t3/move", 200},
+		{"assigned to another writer", "/projects/web/tasks/t2/move", 403},
+		{"assignee not writer in dest", "/projects/web/tasks/t1/move", 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, h, "POST", c.path, "ivy", `{"toProjectId":"ops"}`)
+			if code != c.want {
+				t.Fatalf("got %d want %d: %s", code, c.want, body)
+			}
+		})
+	}
+}
