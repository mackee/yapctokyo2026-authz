+// OrgAuthz is what the actor may do in one organization.
+type OrgAuthz struct {
+	actor Actor
+	org   string
+}
+
+// OrgID returns the organization the object is bound to.
+func (a OrgAuthz) OrgID() string { return a.org }
+
+// CanRead reports whether the actor belongs to the organization.
+// NewOrgAuthz only returns objects that can read.
+func (a OrgAuthz) CanRead() bool { return a.org != "" }
+
+// CanRemoveUser returns nil if the actor may remove users from the
+// organization: org admins only (else ErrForbidden).
+func (a OrgAuthz) CanRemoveUser() error {
+	if !a.CanRead() || !a.actor.orgAdmin {
+		return deny(ErrForbidden, "forbidden")
+	}
+	return nil
+}
