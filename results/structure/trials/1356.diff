+func TestTransferErrors(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"anonymous", "", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 401},
+		{"admin of other org", "eve", "/orgs/globex/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"non admin", "ann", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 403},
+		{"user in other org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"globex"}`, 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"same org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"acme"}`, 400},
+		{"unknown org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":"initech"}`, 400},
+		{"empty org", "eve", "/orgs/acme/users/ben/transfer", `{"toOrgId":""}`, 400},
+		{"bad body", "eve", "/orgs/acme/users/ben/transfer", `nope`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := newServer()
+			code, _ := do(t, h, "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+			// A rejected transfer changes nothing.
+			if code, _ := do(t, h, "GET", "/projects/web/tasks/t1", "ben", ""); code != 200 {
+				t.Fatalf("ben lost access after rejected transfer: %d", code)
+			}
+		})
+	}
+}
+
+func TestTransfer(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["id"] != "ben" || got["orgId"] != "globex" || len(got) != 2 {
+		t.Fatalf("unexpected body %s", body)
+	}
+	// ben left acme: no longer a member there, and cannot see acme projects.
+	if code, _ := do(t, h, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben reads acme project: %d", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "ben", ""); code != 404 {
+		t.Fatalf("ben has no membership in gx, got %d", code)
+	}
+	// Tasks assigned to ben became unassigned (t1 in web, t5 in legacy).
+	_, b := do(t, h, "GET", "/projects/web/tasks/t1", "ann", "")
+	var task Task
+	json.Unmarshal([]byte(b), &task)
+	if task.Assignee != "" {
+		t.Fatalf("t1 still assigned to %q", task.Assignee)
+	}
+	// The acme admin no longer owns ben.
+	if code, _ := do(t, h, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 404 {
+		t.Fatalf("second transfer got %d", code)
+	}
+}
+
+func TestTransferDropsOrgAdmin(t *testing.T) {
+	h := newServer()
+	if code, _ := do(t, h, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("got %d", code)
+	}
+	// eve is no longer an admin of globex: no read access to gx without membership.
+	if code, _ := do(t, h, "GET", "/projects/gx/tasks", "eve", ""); code != 404 {
+		t.Fatalf("eve keeps org admin rights: %d", code)
+	}
+}
