+// Move moves the task from the project of authz to the project of to. The task
+// keeps its ID, title, status and assignee. The caller must be able to edit the
+// task in its project (authz) and to write in the destination (to); the
+// destination is readable by the caller because the caller built to with
+// NewProjectAuthz.
+func (*TaskTable) Move(ctx context.Context, db DB, authz TaskAuthz, to ProjectAuthz) (*Task, error) {
+	if to.ProjectID() == authz.Project().ProjectID() {
+		return nil, deny(ErrInvalid, "task is already in the project")
+	}
+	if err := authz.CanEdit(); err != nil {
+		return nil, err
+	}
+	if err := to.CanWrite(); err != nil {
+		return nil, err
+	}
+	var t *Task
+	if err := inTx(ctx, db, func(tx DB) error {
+		agg, err := loadMoveTask(ctx, tx, authz.TaskID(), to.ProjectID())
+		if err != nil {
+			return err
+		}
+		if err := agg.validate(); err != nil {
+			return err
+		}
+		if t, err = agg.apply(ctx, tx); err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return t, nil
+}
