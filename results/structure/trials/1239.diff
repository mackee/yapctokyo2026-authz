+
+// webMembersSeed is the seed membership of project web, as the API returns it.
+const webMembersSeed = `[{"userId":"ann","role":"manager"},{"userId":"ben","role":"contributor"},{"userId":"cat","role":"contributor"},{"userId":"dan","role":"viewer"},{"userId":"ivy","role":"manager"}]`
+
+func TestUpdateMemberRoles(t *testing.T) {
+	cases := []struct {
+		name, user, project, body string
+		want                      int
+	}{
+		{"manager", "ann", "web", `{"roles":{"ben":"viewer","dan":"contributor"}}`, 200},
+		{"manager sets same role", "ann", "web", `{"roles":{"cat":"contributor"}}`, 200},
+		{"manager of another project", "ivy", "ops", `{"roles":{"cat":"viewer"}}`, 200},
+		{"contributor", "ben", "web", `{"roles":{"cat":"viewer"}}`, 403},
+		{"viewer", "dan", "web", `{"roles":{"ben":"viewer"}}`, 403},
+		{"org admin", "eve", "web", `{"roles":{"ben":"viewer"}}`, 403},
+		{"non member", "hal", "web", `{"roles":{"ben":"viewer"}}`, 404},
+		{"other org", "gus", "web", `{"roles":{"ben":"viewer"}}`, 404},
+		{"anonymous", "", "web", `{"roles":{"ben":"viewer"}}`, 401},
+		{"unknown project", "ann", "nope", `{"roles":{"ben":"viewer"}}`, 404},
+		{"archived", "ann", "legacy", `{"roles":{"ben":"viewer"}}`, 409},
+		{"not a member", "ann", "web", `{"roles":{"hal":"viewer"}}`, 400},
+		{"invalid role", "ann", "web", `{"roles":{"ben":"admin"}}`, 400},
+		{"empty roles", "ann", "web", `{"roles":{}}`, 400},
+		{"missing roles", "ann", "web", `{}`, 400},
+		{"bad json", "ann", "web", `{"roles":`, 400},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", "/projects/"+c.project+"/members", c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestUpdateMemberRolesResponse(t *testing.T) {
+	h := newServer()
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","dan":"contributor"}}`)
+	if code != 200 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	want := `[{"userId":"ann","role":"manager"},{"userId":"ben","role":"viewer"},{"userId":"cat","role":"contributor"},{"userId":"dan","role":"contributor"},{"userId":"ivy","role":"manager"}]`
+	if strings.TrimSpace(body) != want {
+		t.Fatalf("got %s want %s", body, want)
+	}
+	// The change is stored: ben is a viewer now, so creating a task is forbidden.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 403 {
+		t.Fatalf("ben after demotion: got %d want 403", code)
+	}
+	// dan, promoted to contributor, can create one.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 200 {
+		t.Fatalf("dan after promotion: got %d want 200", code)
+	}
+}
+
+func TestUpdateMemberRolesAllOrNothing(t *testing.T) {
+	h := newServer()
+	// ben can be changed, but hal is not a member: nothing may change.
+	code, body := do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"ben":"viewer","hal":"viewer"}}`)
+	if code != 400 {
+		t.Fatalf("got %d: %s", code, body)
+	}
+	// A no-op change returns the members as they are now.
+	code, body = do(t, h, "PUT", "/projects/web/members", "ann", `{"roles":{"cat":"contributor"}}`)
+	if code != 200 || strings.TrimSpace(body) != webMembersSeed {
+		t.Fatalf("got %d %s; want 200 %s", code, body, webMembersSeed)
+	}
+	// ben is still a contributor, so creating a task still works.
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "ben", `{"title":"x"}`); code != 200 {
+		t.Fatalf("ben after failed change: got %d want 200", code)
+	}
+}
