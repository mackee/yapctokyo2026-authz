+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes", "eve", "/orgs/acme/users/ann", 204},
+		{"org admin removes non member", "eve", "/orgs/acme/users/hal", 204},
+		{"contributor", "ben", "/orgs/acme/users/cat", 403},
+		{"viewer", "dan", "/orgs/acme/users/cat", 403},
+		{"manager of projects, not org admin", "ivy", "/orgs/acme/users/cat", 403},
+		{"anonymous", "", "/orgs/acme/users/cat", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/cat", 401},
+		{"caller in other org", "gus", "/orgs/acme/users/ann", 404},
+		{"other org path", "eve", "/orgs/globex/users/gus", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ann", 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed", 404},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+
+	t.Run("removes from all projects of the org", func(t *testing.T) {
+		h := newServer()
+		if code, body := do(t, h, "DELETE", "/orgs/acme/users/ann", "eve", ""); code != 204 {
+			t.Fatalf("delete: got %d %s", code, body)
+		}
+		// ann was a member of web (manager), ops (viewer) and legacy (archived, manager).
+		for _, pid := range []string{"web", "ops", "legacy"} {
+			if code, _ := do(t, h, "GET", "/projects/"+pid+"/tasks", "ann", ""); code != 404 {
+				t.Fatalf("ann still reads %s: got %d", pid, code)
+			}
+		}
+		// Other members keep their access.
+		if code, _ := do(t, h, "GET", "/projects/web/tasks", "ivy", ""); code != 200 {
+			t.Fatalf("ivy lost web: got %d", code)
+		}
+		if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 200 {
+			t.Fatalf("ben lost write on own task: got %d", code)
+		}
+	})
+
+	t.Run("archived project membership removed too", func(t *testing.T) {
+		h := newServer()
+		if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+			t.Fatalf("delete: got %d", code)
+		}
+		if code, _ := do(t, h, "GET", "/projects/legacy/tasks/t5", "ann", ""); code != 200 {
+			t.Fatalf("ann lost legacy read: got %d", code)
+		}
+		if code, _ := do(t, h, "GET", "/projects/legacy/tasks", "ben", ""); code != 404 {
+			t.Fatalf("ben still reads legacy: got %d", code)
+		}
+	})
+
+	t.Run("other org untouched", func(t *testing.T) {
+		h := newServer()
+		do(t, h, "DELETE", "/orgs/acme/users/gus", "eve", "")
+		if code, _ := do(t, h, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+			t.Fatalf("gus lost gx: got %d", code)
+		}
+	})
+
+	t.Run("repeat is 204", func(t *testing.T) {
+		h := newServer()
+		for i := 0; i < 2; i++ {
+			if code, _ := do(t, h, "DELETE", "/orgs/acme/users/ann", "eve", ""); code != 204 {
+				t.Fatalf("attempt %d: got %d", i, code)
+			}
+		}
+	})
+}
