@@ -0,0 +1,82 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestTransferAccess(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"org admin transfers user", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 200},
+		{"member cannot transfer", "ben", "/orgs/acme/users/cat/transfer", `{"toOrgId":"globex"}`, 403},
+		{"manager cannot transfer", "ann", "/orgs/acme/users/cat/transfer", `{"toOrgId":"globex"}`, 403},
+		{"other org admin cannot transfer", "gus", "/orgs/acme/users/ben/transfer", `{"toOrgId":"globex"}`, 404},
+		{"path org is not caller org", "eve", "/orgs/globex/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"target in other org", "eve", "/orgs/acme/users/gus/transfer", `{"toOrgId":"acme"}`, 404},
+		{"unknown target", "eve", "/orgs/acme/users/zed/transfer", `{"toOrgId":"globex"}`, 404},
+		{"unknown target org", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"initech"}`, 400},
+		{"same org", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":"acme"}`, 409},
+		{"missing toOrgId", "eve", "/orgs/acme/users/hal/transfer", `{}`, 400},
+		{"malformed body", "eve", "/orgs/acme/users/hal/transfer", `{"toOrgId":`, 400},
+		{"anonymous", "", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 401},
+		{"unknown caller", "zed", "/orgs/acme/users/hal/transfer", `{"toOrgId":"globex"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, body := do(t, newServer(), "POST", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d body=%s", code, c.want, body)
+			}
+		})
+	}
+}
+
+func TestTransferResponse(t *testing.T) {
+	code, body := do(t, newServer(), "POST", "/orgs/acme/users/hal/transfer", "eve", `{"toOrgId":"globex"}`)
+	if code != 200 {
+		t.Fatalf("got %d body=%s", code, body)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["id"] != "hal" || got["orgId"] != "globex" {
+		t.Fatalf("unexpected body %s", body)
+	}
+}
+
+// After a transfer the user is in the new org: they lose access to the old
+// org's projects and gain access to the new org's projects.
+func TestTransferChangesAccess(t *testing.T) {
+	s := newServer()
+	if code, body := do(t, s, "POST", "/orgs/acme/users/ben/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer got %d body=%s", code, body)
+	}
+	if code, _ := do(t, s, "GET", "/projects/web/tasks", "ben", ""); code != 404 {
+		t.Fatalf("old org project: got %d want 404", code)
+	}
+	if code, _ := do(t, s, "GET", "/projects/gx/tasks", "ben", ""); code != 404 {
+		t.Fatalf("new org project as non-member: got %d want 404", code)
+	}
+	if code, _ := do(t, s, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatalf("new org member reads own project: got %d want 200", code)
+	}
+}
+
+// Org admin rights do not follow the user into the new organization.
+func TestTransferClearsOrgAdmin(t *testing.T) {
+	s := newServer()
+	if code, body := do(t, s, "POST", "/orgs/acme/users/eve/transfer", "eve", `{"toOrgId":"globex"}`); code != 200 {
+		t.Fatalf("transfer got %d body=%s", code, body)
+	}
+	// As a globex org admin eve could list gx; now she is an ordinary user with no role there.
+	if code, _ := do(t, s, "GET", "/projects/gx/tasks", "eve", ""); code != 404 {
+		t.Fatalf("got %d want 404", code)
+	}
+	if code, _ := do(t, s, "POST", "/orgs/globex/users/gus/transfer", "eve", `{"toOrgId":"acme"}`); code != 403 {
+		t.Fatalf("got %d want 403", code)
+	}
+}
