--- /dev/null
+++ b/org_test.go
@@ -0,0 +1,117 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestRemoveOrgUser(t *testing.T) {
+	cases := []struct {
+		name, user, path string
+		want             int
+	}{
+		{"org admin removes member", "eve", "/orgs/acme/users/ben", 204},
+		{"org admin removes manager", "eve", "/orgs/acme/users/ivy", 204},
+		{"org admin removes not-yet-member user", "eve", "/orgs/acme/users/hal", 204},
+		{"member cannot remove", "ann", "/orgs/acme/users/ben", 403},
+		{"viewer cannot remove", "dan", "/orgs/acme/users/ben", 403},
+		{"other org admin", "gus", "/orgs/acme/users/ben", 404},
+		{"user of other org", "eve", "/orgs/acme/users/gus", 404},
+		{"unknown user", "eve", "/orgs/acme/users/zed", 404},
+		{"unknown org", "eve", "/orgs/nope/users/ben", 404},
+		{"anonymous", "", "/orgs/acme/users/ben", 401},
+		{"unknown caller", "zed", "/orgs/acme/users/ben", 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "DELETE", c.path, c.user, "")
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestRemoveOrgUserTwiceIs404(t *testing.T) {
+	srv := newServer()
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("first remove: got %d want 204", code)
+	}
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 404 {
+		t.Fatalf("second remove: got %d want 404", code)
+	}
+}
+
+func TestRemoveOrgUserEffects(t *testing.T) {
+	srv := newServer()
+
+	// ben is a contributor in web (assigned t1) and in legacy (assigned t5).
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+
+	// ben loses access to every project of the org.
+	for _, path := range []string{"/projects/web/tasks", "/projects/legacy/tasks", "/projects/web/tasks/t1"} {
+		if code, _ := do(t, srv, "GET", path, "ben", ""); code != 404 {
+			t.Fatalf("ben GET %s: got %d want 404", path, code)
+		}
+	}
+
+	// ben's tasks stay, but are unassigned.
+	for _, c := range []struct{ path, id string }{
+		{"/projects/web/tasks/t1", "t1"},
+		{"/projects/legacy/tasks/t5", "t5"},
+	} {
+		code, body := do(t, srv, "GET", c.path, "ann", "")
+		if code != 200 {
+			t.Fatalf("ann GET %s: got %d want 200", c.path, code)
+		}
+		var task Task
+		if err := json.Unmarshal([]byte(body), &task); err != nil {
+			t.Fatal(err)
+		}
+		if task.ID != c.id || task.Assignee != "" {
+			t.Fatalf("%s: got %+v, want unassigned", c.path, task)
+		}
+	}
+
+	// Other members are untouched.
+	if code, _ := do(t, srv, "GET", "/projects/web/tasks/t2", "cat", ""); code != 200 {
+		t.Fatalf("cat GET t2: got %d want 200", code)
+	}
+	var task Task
+	_, body := do(t, srv, "GET", "/projects/web/tasks/t2", "ann", "")
+	json.Unmarshal([]byte(body), &task)
+	if task.Assignee != "cat" {
+		t.Fatalf("t2 assignee changed to %q", task.Assignee)
+	}
+}
+
+func TestRemoveOrgUserWithoutOrgAccess(t *testing.T) {
+	srv := newServer()
+
+	// Removing ben must not touch the globex project or the other org.
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 204 {
+		t.Fatalf("remove: got %d want 204", code)
+	}
+	if code, _ := do(t, srv, "GET", "/projects/gx/tasks", "gus", ""); code != 200 {
+		t.Fatalf("gus GET gx: got %d want 200", code)
+	}
+}
+
+func TestRemovedOrgAdminLosesOrgAccess(t *testing.T) {
+	srv := newServer()
+
+	// eve is the only org admin; she can remove herself.
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/eve", "eve", ""); code != 204 {
+		t.Fatalf("self remove: got %d want 204", code)
+	}
+	// She no longer reads org projects she has no membership in...
+	if code, _ := do(t, srv, "GET", "/projects/ops/tasks", "eve", ""); code != 404 {
+		t.Fatalf("eve GET ops: got %d want 404", code)
+	}
+	// ...and can no longer administer the org.
+	if code, _ := do(t, srv, "DELETE", "/orgs/acme/users/ben", "eve", ""); code != 404 {
+		t.Fatalf("eve remove ben: got %d want 404", code)
+	}
+}
