+// ---- org capabilities --------------------------------------------------------
+
+type orgScope struct {
+	as  *actorScope
+	oid string
+}
+
+// ManageOrg is the org-admin capability for one organization.
+type ManageOrg interface {
+	// RemoveUser takes a user out of the organization (e.g. on offboarding):
+	// the user is removed from every project of the organization, their tasks
+	// there are unassigned, and they lose org membership and org-admin rights.
+	// The user must be a member of this organization (else 404).
+	RemoveUser(userID string) error
+}
+
+// Manage applies the org rule: the organization must be the actor's own (else
+// 404), and the actor must be an org admin (else 403).
+func (s *orgScope) Manage() (ManageOrg, error) {
+	err := s.as.a.st.read(func(st *state) error {
+		if s.oid != s.as.actor.org {
+			return deny(ErrNotFound, "not found")
+		}
+		if !s.as.actor.orgAdmin {
+			return deny(ErrForbidden, "forbidden")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &manageOrg{os: s}, nil
+}
+
+type manageOrg struct{ os *orgScope }
+
+func (o *manageOrg) RemoveUser(userID string) error {
+	return o.os.as.a.st.tx(func(s *state) error {
+		u, ok := s.users[userID]
+		if !ok || u.org != o.os.oid {
+			return deny(ErrNotFound, "not found")
+		}
+		orgProjects := map[string]bool{}
+		for pid, p := range s.projects {
+			if p.org == o.os.oid {
+				orgProjects[pid] = true
+			}
+		}
+		for pid := range orgProjects {
+			delete(s.members[pid], userID)
+		}
+		for id, t := range s.tasks {
+			if t.assignee.user == userID && orgProjects[t.project] {
+				t.assignee = Assignee{project: t.project}
+				s.tasks[id] = t
+			}
+		}
+		u.org = ""
+		u.orgAdmin = false
+		s.users[userID] = u
+		return nil
+	})
+}
+
