diff --git a/members_test.go b/members_test.go
new file mode 100644
index 0000000..cf26189
--- /dev/null
+++ b/members_test.go
@@ -0,0 +1,97 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestSetRole(t *testing.T) {
+	cases := []struct {
+		name, user, path, body string
+		want                   int
+	}{
+		{"manager promotes viewer", "ann", "/projects/web/members/dan", `{"role":"contributor"}`, 200},
+		{"manager demotes unassigned manager", "ann", "/projects/web/members/ivy", `{"role":"viewer"}`, 200},
+		{"manager demotes member with tasks", "ann", "/projects/web/members/ben", `{"role":"viewer"}`, 409},
+		{"manager promotes member with tasks to manager", "ann", "/projects/web/members/ben", `{"role":"manager"}`, 200},
+		{"contributor cannot change roles", "ben", "/projects/web/members/dan", `{"role":"contributor"}`, 403},
+		{"contributor cannot demote self", "ben", "/projects/web/members/ben", `{"role":"viewer"}`, 403},
+		{"viewer cannot change roles", "dan", "/projects/web/members/ivy", `{"role":"viewer"}`, 403},
+		{"org admin cannot change roles", "eve", "/projects/web/members/ivy", `{"role":"viewer"}`, 403},
+		{"non member project", "hal", "/projects/web/members/ivy", `{"role":"viewer"}`, 404},
+		{"other org", "gus", "/projects/web/members/ivy", `{"role":"viewer"}`, 404},
+		{"missing project", "ann", "/projects/nope/members/ivy", `{"role":"viewer"}`, 404},
+		{"target not a member", "ann", "/projects/web/members/hal", `{"role":"contributor"}`, 404},
+		{"target member of another project only", "ivy", "/projects/ops/members/ben", `{"role":"viewer"}`, 404},
+		{"manager of ops is viewer on web", "ann", "/projects/ops/members/cat", `{"role":"viewer"}`, 403},
+		{"target in another org", "ann", "/projects/web/members/gus", `{"role":"contributor"}`, 404},
+		{"invalid role", "ann", "/projects/web/members/dan", `{"role":"owner"}`, 400},
+		{"empty role", "ann", "/projects/web/members/dan", `{"role":""}`, 400},
+		{"missing role", "ann", "/projects/web/members/dan", `{}`, 400},
+		{"malformed body", "ann", "/projects/web/members/dan", `not json`, 400},
+		{"archived project", "ann", "/projects/legacy/members/ben", `{"role":"viewer"}`, 409},
+		{"anonymous", "", "/projects/web/members/dan", `{"role":"contributor"}`, 401},
+		{"unknown user", "zed", "/projects/web/members/dan", `{"role":"contributor"}`, 401},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			code, _ := do(t, newServer(), "PUT", c.path, c.user, c.body)
+			if code != c.want {
+				t.Fatalf("got %d want %d", code, c.want)
+			}
+		})
+	}
+}
+
+func TestSetRoleResponse(t *testing.T) {
+	code, body := do(t, newServer(), "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`)
+	if code != 200 {
+		t.Fatalf("got %d want 200", code)
+	}
+	var got map[string]string
+	if err := json.Unmarshal([]byte(body), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["userId"] != "dan" || got["role"] != "contributor" || len(got) != 2 {
+		t.Fatalf("unexpected body %s", body)
+	}
+}
+
+// TestSetRoleTakesEffect checks that a role change alters what the member can
+// do afterwards, and that a refused change leaves the data untouched.
+func TestSetRoleTakesEffect(t *testing.T) {
+	h := newServer()
+
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 403 {
+		t.Fatalf("viewer create: got %d want 403", code)
+	}
+	if code, _ := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"contributor"}`); code != 200 {
+		t.Fatalf("promote: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 201 {
+		t.Fatalf("promoted create: got %d want 201", code)
+	}
+	if code, _ := do(t, h, "PUT", "/projects/web/members/dan", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "POST", "/projects/web/tasks", "dan", `{"title":"x"}`); code != 403 {
+		t.Fatalf("demoted create: got %d want 403", code)
+	}
+
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ben", "ann", `{"role":"viewer"}`); code != 409 {
+		t.Fatalf("demote with tasks: got %d want 409", code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t1", "ben", `{"status":"done"}`); code != 200 {
+		t.Fatalf("ben after refused demotion: got %d want 200", code)
+	}
+
+	if code, _ := do(t, h, "PUT", "/projects/web/members/ivy", "ann", `{"role":"viewer"}`); code != 200 {
+		t.Fatalf("demote unassigned manager: got %d want 200", code)
+	}
+	if code, _ := do(t, h, "PATCH", "/projects/web/tasks/t3", "ivy", `{"status":"done"}`); code != 403 {
+		t.Fatalf("ivy after demotion: got %d want 403", code)
+	}
+	if code, _ := do(t, h, "GET", "/projects/web/tasks/t3", "ivy", ""); code != 200 {
+		t.Fatalf("ivy read after demotion: got %d want 200", code)
+	}
+}
