+}
+
+// ManageProject may change the roles of the members of one project.
+type ManageProject interface {
+	ReadProject
+	// SetRole changes an existing member's role. A user who is not a member of
+	// this project is 404; an unknown role is 400. Demoting a user to viewer is
+	// 409 while that user is assigned to a task in this project, because viewers
+	// cannot hold assignments; reassign those tasks first.
+	SetRole(userID, role string) (Membership, error)
+}
+
+type manageProject struct{ readProject }
+
+func (p *manageProject) SetRole(userID, role string) (Membership, error) {
+	if !isValidRole(role) {
+		return Membership{}, deny(ErrInvalid, "role must be manager, contributor or viewer")
+	}
+	var m Membership
+	err := p.ps.as.a.st.tx(func(s *state) error {
+		pid := p.ps.pid
+		if _, ok := s.members[pid][userID]; !ok {
+			return deny(ErrNotFound, "member not found")
+		}
+		if role == RoleViewer {
+			for _, t := range s.tasks {
+				if t.project == pid && t.assignee.user == userID {
+					return deny(ErrConflict, "member has tasks assigned in this project; reassign them first")
+				}
+			}
+		}
+		s.members[pid][userID] = role
+		m = Membership{UserID: userID, Role: role}
+		return nil
+	})
+	return m, err
+}
