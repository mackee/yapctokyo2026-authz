{
  "permissions": {
    "allow": [
      "Bash(/opt/homebrew/bin/go test:*)",
      "Bash(/opt/homebrew/bin/go build:*)",
      "Bash(/opt/homebrew/bin/go vet:*)",
      "Bash(/opt/homebrew/bin/go version)",
      "Bash(/opt/homebrew/bin/gofmt:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git log:*)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(find .:*)",
      "Bash(grep:*)"
    ],
    "deny": [
      "WebFetch",
      "WebSearch",
      "Agent"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": false,
    "filesystem": {
      "denyRead": [],
      "allowRead": [],
      "allowWrite": [],
      "denyWrite": []
    },
    "network": {
      "allowedDomains": []
    }
  },
  "env": {
    "GOTOOLCHAIN": "local",
    "GOPROXY": "off",
    "GOCACHE": null,
    "GOTMPDIR": null,
    "GOENV": "off",
    "GIT_CONFIG_GLOBAL": null,
    "GIT_CONFIG_NOSYSTEM": "1",
    "SECURITY_GUIDANCE_DISABLE": "1",
    "ENABLE_CODE_SECURITY_REVIEW": "0"
  }
}
