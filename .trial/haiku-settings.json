{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(go test:*)",
      "Bash(go build:*)",
      "Bash(go vet:*)",
      "Bash(go run:*)",
      "Bash(gofmt:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(ls)",
      "Bash(pwd)",
      "Bash(/opt/homebrew/bin/go test:*)",
      "Bash(/opt/homebrew/bin/go build:*)",
      "Bash(/opt/homebrew/bin/go vet:*)",
      "Bash(/opt/homebrew/bin/go version)",
      "Bash(/opt/homebrew/bin/gofmt:*)",
      "Bash(echo:*)",
      "Bash(tail:*)",
      "Bash(head:*)"
    ],
    "deny": [
      "Read(~/.claude/**)",
      "WebFetch",
      "WebSearch",
      "Agent"
    ]
  },
  "env": {
    "GOTOOLCHAIN": "local",
    "GOFLAGS": "-mod=mod",
    "GOPROXY": "off"
  }
}
